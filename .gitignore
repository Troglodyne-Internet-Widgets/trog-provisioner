*.swp
*.swo
*.swn

# Configuration lives in /etc/trog-provisioner now, not here -- see Trog::Config.
# These are the names it used to go by in the checkout; kept ignored so an old
# working copy, or a habit, cannot commit an installation's addresses or its
# password database.
ipmap.cfg
recipes.yaml
recipes.d/
secrets.kdbx
hypervisors.conf
vendor/

# Build leavings
MYMETA*
Makefile
pm_to_blib
blib/
cover_db/
.build
# What `dzil build` leaves at the root: the dist named in dist.ini, at its
# version, as a directory and as a tarball.  Anchored and version-shaped rather
# than a bare Provisioner-Recipe-* glob, which matches at any depth and so also
# swallowed t/Provisioner-Recipe-vm.t and its neighbours -- silently, which is
# how two test files went missing from a merged PR.
/Provisioner-Recipe-[0-9]*/
/Provisioner-Recipe-[0-9]*.tar.gz
/trog-provisioner-[0-9]*/
/trog-provisioner-[0-9]*.tar.gz

# Robot foo
.claude/worktrees
