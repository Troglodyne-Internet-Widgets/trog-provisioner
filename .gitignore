*.swp
*.swo
*.swn

# Configuration lives in /etc/trog-provisioner now, not here -- see Trog::Config.
# These are the names it used to go by in the checkout; kept ignored so an old
# working copy, or a habit, cannot commit an installation's addresses or its
# password database.
ipmap.cfg
recipes.yaml
recipes.d/
secrets.kdbx
hypervisors.conf
vendor/

# Build leavings
MYMETA*
Makefile
pm_to_blib
blib/
cover_db/
.build
# Anchored, because dzil builds these at the root and an unanchored glob also
# matches t/Provisioner-Recipe-vm.t and its neighbours -- which is how two test
# files went missing from a merged PR without anything saying so.
/Provisioner-Recipe-*
/trog-provisioner-*

# Robot foo
.claude/worktrees
