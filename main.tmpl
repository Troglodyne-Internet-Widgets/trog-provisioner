terraform {
    required_version = ">= 0.12"
    required_providers {
        libvirt = {
            source = "dmacvicar/libvirt"
            version = "0.9.1"
        }
    }
}

provider "libvirt" {
    uri = "%LIBVIRT_URI%"
}

%LIBVIRT_POOL_IMPORT%

resource "libvirt_pool" "tf_disks" {
    name = "tf_disks"
    type = "dir"
    target = {
        path = "%POOLPATH%"
    }
    lifecycle {
        prevent_destroy = true

        # The provider does not report target back when it imports an existing
        # pool -- state ends up with target = null however the pool is actually
        # configured.  Terraform then sees null -> {path=...}, storage pools
        # cannot be updated, so it plans a replacement, and prevent_destroy
        # refuses it: a standoff nothing gets out of.  target is only read when
        # the pool is created anyway, so there is nothing here worth diffing.
        ignore_changes = [ target ]
    }
}

%BASE_IMAGE_IMPORT%

resource "libvirt_volume" "image_base" {
  name = "baseimage-qcow2"
  pool = libvirt_pool.tf_disks.name
  create = {
      content = {
          url = "%CLOUDIMG%"
      }
  }
  target = {
    format = {
        type = "qcow2"
    }
  }
  lifecycle {
      prevent_destroy = true

      # create says where to fetch the image from, and is read once, when the
      # volume is made.  An imported volume reports neither it nor target back,
      # so leaving them in the diff plans a replacement of the base image every
      # single run -- which prevent_destroy then refuses.
      ignore_changes = [ create, target ]
  }
  depends_on = [libvirt_pool.tf_disks]
}
