#!/bin/bash

# Put the salvaged state of a recipe back where the service reads it.  The
# salvage is the state that bin/new_config copied off the old guest.
#
# remote_files is a round trip, and this script is the leg on the guest.
# bin/new_config fetches what a recipe names off the running guest.  The data
# target puts it under $install_dir/$domain.  This script moves it to where the
# service reads it.  The fragment of the recipe calls this script before it
# starts the service.
#
#     restore_state <salvaged> <destination> [owner[:group]] [mode]
#
# It declines (does nothing and exits 0) in three cases.  Each case is normal
# and is not an error:
#
#   - Nothing was salvaged.  A guest that is built for the first time has no
#     earlier guest to take anything from.
#
#   - The salvage is empty.  Either the service wrote nothing yet, or the fetch
#     failed.  In both cases, a restore of nothing over something does harm.
#     bin/new_config asks the old guest which case it was, and bin/provision
#     refuses to rebuild over the second.
#
#   - The destination already has content.  This case is the important one.
#     A new provision of a running guest fetches its live state minutes
#     earlier.  If that fetch was partial, a restore replaces the real state
#     with the part that the fetch could read.  The guest keeps what it has,
#     and the copy stays in the domain directory for somebody to examine.
#
# So a restore is for a rebuilt guest, and it does nothing on a live one.  If
# the package of a recipe fills the destination before the fragment runs, the
# recipe must stop the service and empty the destination first.  If not, this
# script finds content there and declines.

set -euo pipefail

SALVAGED="${1:?usage: restore_state <salvaged> <destination> [owner[:group]] [mode]}"
DESTINATION="${2:?usage: restore_state <salvaged> <destination> [owner[:group]] [mode]}"
OWNER="${3:-}"
MODE="${4:-}"

has_content() {
    local path="$1"
    [ -e "$path" ] || return 1
    if [ -d "$path" ]; then
        [ -n "$(find "$path" -mindepth 1 -print -quit 2>/dev/null)" ]
    else
        [ -s "$path" ]
    fi
}

if [ ! -e "$SALVAGED" ]; then
    echo "restore_state: nothing salvaged at $SALVAGED, leaving $DESTINATION alone"
    exit 0
fi

if ! has_content "$SALVAGED"; then
    echo "restore_state: $SALVAGED is empty -- the fetch found nothing it could read; leaving $DESTINATION alone" >&2
    exit 0
fi

if has_content "$DESTINATION"; then
    echo "restore_state: $DESTINATION already has state in it, keeping it; $SALVAGED left where it is"
    exit 0
fi

# If both are directories, copy the contents and not the directory itself.
# `mv src dst` on an existing directory puts src inside dst.  The restore then
# lands at, for example, /var/lib/redis/redis, and the service starts empty.
#
# Keep the mode and owner that the recipe gave the destination.  `cp -a src/.
# dst/` also copies the attributes of src onto dst.  The salvage comes from a
# domain directory that the data target owns, so dst becomes 0755 root:root.
# A destination made 2750 dovecot:admin then loses its setgid bit, and the next
# salvage needs that bit to read the store.  The contents keep their salvaged
# modes.
if [ -d "$SALVAGED" ] && [ -d "$DESTINATION" ]; then
    dest_mode="$(stat -c '%a' "$DESTINATION")"
    dest_owner="$(stat -c '%u:%g' "$DESTINATION")"
    cp -a "$SALVAGED/." "$DESTINATION/"
    chmod "$dest_mode" "$DESTINATION"
    chown "$dest_owner" "$DESTINATION"
    rm -rf "${SALVAGED:?}"
else
    mkdir -p "$(dirname "$DESTINATION")"
    mv "$SALVAGED" "$DESTINATION"
fi

# Try the chown, but do not require it.  The data target runs before every
# recipe target, so the owner account often does not exist yet.  A later package
# or useradd makes it.  For example, gogs makes its own account in its own
# target.  The recipe chowns again after the account exists, and this chown only
# covers the common case.  A failure here must not abort the target for a
# problem that a later target fixes.
if [ -n "$OWNER" ] && ! chown -R "$OWNER" "$DESTINATION" 2>/dev/null; then
    echo "restore_state: no $OWNER on this guest yet, so $DESTINATION stays root's until the recipe gives it away" >&2
fi

[ -n "$MODE" ] && chmod -R "$MODE" "$DESTINATION"

echo "restore_state: restored $DESTINATION"
exit 0
