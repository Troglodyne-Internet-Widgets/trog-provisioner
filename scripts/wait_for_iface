#!/bin/bash
# Usage: wait_for_iface <interface> <timeout_seconds>
#
# Wait until the interface exists.  Exit 124 if it does not exist after
# timeout_seconds, which is 30 by default.
IFACE="${1:?Usage: wait_for_iface <interface> <timeout_seconds>}"
TIMEOUT="${2:-30}"

# Export IFACE, and do not pass it as a word after the -c string.  That word
# becomes $0 of the inner shell, not a variable.
export IFACE

# `ip link show <iface>` exits non-zero when the interface does not exist.
timeout "$TIMEOUT" bash -c 'until ip link show "$IFACE" >/dev/null 2>&1; do sleep 1; done'
