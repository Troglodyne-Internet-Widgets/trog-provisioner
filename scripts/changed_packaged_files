#!/usr/bin/perl

package Trog::ChangedPackagedFiles;

use 5.014;

use strict;
use warnings FATAL => 'all';

use File::Basename ();
use File::Glob     ();
use File::Temp     ();
use IPC::Open3     ();
use List::Util     ();

=head1 NAME

changed_packaged_files - report each file of a package that changed since the
last run, unless a recipe changed it on purpose

=head1 SYNOPSIS

    changed_packaged_files

=head1 DESCRIPTION

Cron runs this every half hour, and mails what it prints.  It asks the package
manager which of its files differ from the package, with C<debsums -c> on a
guest with dpkg and C<rpm -Va> elsewhere.  It prints each file that differs now
and did not differ at its last run.  A file that returns to what the package
holds drops out, so it is reported again if it changes again.

A recipe that changes a packaged file on purpose lists it in a file of
F</etc/changed_packaged_files.d>, one absolute path to a line.  A C<#> starts a
comment, and a file whose name starts with a dot is skipped.  A listed file is
never reported.

=head2 What debsums says on its standard error

=over 4

=item * C<missing file>, C<can't open> and C<can't check> name a file that
cannot be verified.  It is reported as changed.

=item * C<no md5sums for> names a package that has no checksums to compare.
Nothing can be checked, and it would say so at every run, so it is ignored.

=item * Anything else means that the check stopped before the last package.
debsums dies, for example, when dpkg removes a package while it runs.  Then the
run changes nothing, because the packages that it did not reach would drop out
of the state and be reported again at the next run.  A check that stops at two
runs in a row is reported, because then it is not a race with dpkg.

=back

On a guest without dpkg, any line on the standard error of rpm means the same
as the last case.

The first run records what already differs, and prints it.  The cron recipe
runs it once at the end of a build for that reason, so that its mail does not
go out.

=head1 FUNCTIONS

=head2 $exit = main()

Prints a warning and the new changes, and returns 0.  Dies when the check
stopped at this run and the last, or when it cannot write its state.

=cut

# Only the test sets these, to point the script at files of its own.
our $STATE_DIR    = '/root';
our $EXPECTED_DIR = '/etc/changed_packaged_files.d';
our $DPKG_STATUS  = '/var/lib/dpkg/status';

# The messages of debsums that name a file it could not verify, up to the path.
my $UNREADABLE = qr/can't \s+ (?:open|check) \s+ \S+ \s+ file/x;
my $UNVERIFIED = qr/\Adebsums: \s+ (?:missing \s+ file | $UNREADABLE) \s+/x;

# A line of rpm -V up to the path: the attributes or "missing", then the type
# of the file when it has one.
my $RPM_ATTRIBUTES = qr/\A (?:missing | [.?SM5DLUGTPF]{8,9}) \s+ (?:[cdglr] \s+)?/x;

sub main {
    my $state   = "$STATE_DIR/changed_packaged_files.log";
    my $stopped = "$STATE_DIR/changed_packaged_files.stopped";

    my $dpkg = -e $DPKG_STATUS;
    my ( $changed, $error ) = $dpkg ? debsums() : rpm_verify();
    if ( defined $error ) {
        my $again = -e $stopped;
        write_state( $stopped, $error );
        die "The check of the packaged files stopped at this run and the last:\n$error\n" if $again;
        return 0;
    }
    unlink $stopped;

    my %expected = map       { $_ => 1 } expected();
    my @now      = sort grep { !$expected{$_} } List::Util::uniq(@$changed);

    my %seen;
    if ( open my $in, '<', $state ) {
        chomp( my @lines = <$in> );
        %seen = map { $_ => 1 } @lines;
        close $in or die "Cannot close $state: $!\n";
    }
    write_state( $state, @now );

    my @new = grep { !$seen{$_} } @now;
    return 0 unless @new;

    my $hint =
      $dpkg
      ? "The packages to reinstall:\n  debsums -c | xargs -rd '\\n' -- dpkg -S | cut -d : -f 1 | sort -u\n"
      : "The packages to reinstall:\n  rpm -qf FILE\n";
    print "DANGER: New changes to packaged files!  Check them against the audit logs.\n", map( { "$_\n" } @new ), $hint,
      "A recipe that changes a packaged file on purpose lists it in $EXPECTED_DIR.\n";
    return 0;
}

=head2 ($changed, $error) = debsums()

The files that C<debsums -c> reports, with the files that its standard error
names as missing or unreadable.  C<$error> is undef, or the lines of the
standard error that say the check stopped.

=cut

sub debsums {
    my ( $out, $err, $status ) = run(qw{debsums -c});

    my ( @changed, @error );
    foreach my $line (@$err) {
        if ( $line =~ m/$UNVERIFIED (\/.*?) \s+ \(/x ) {
            push @changed, $1;
        }
        elsif ( $line !~ m/\Adebsums: \s+ no \s+ md5sums \s+ for \s/x ) {
            push @error, $line;
        }
    }

    # Exit status 1 and 2 say that something did not verify.  A higher one
    # says that it died, and so does a signal.
    push @error, "debsums exited with status $status" if $status & 0x7f || $status >> 8 > 3;
    return ( [ @$out, @changed ], @error ? join( "\n", @error ) : undef );
}

=head2 ($changed, $error) = rpm_verify()

The files that C<rpm -Va> reports.  C<$error> is undef, or the standard error
of rpm when it wrote any.

=cut

sub rpm_verify {
    my ( $out, $err ) = run(qw{rpm -Va});

    # rpm exits 1 when any file did not verify, so the status says nothing.
    my @changed = map { m/$RPM_ATTRIBUTES (\/.*) \z/x ? $1 : () } @$out;
    return ( \@changed, @$err ? join( "\n", @$err ) : undef );
}

=head2 @paths = expected()

The paths that the files in F</etc/changed_packaged_files.d> list.  A file
whose name starts with a dot is not read, because a glob skips it.

=cut

sub expected {
    my @paths;
    foreach my $file ( File::Glob::bsd_glob("$EXPECTED_DIR/*") ) {
        open my $in, '<', $file or die "Cannot read $file: $!\n";
        while ( my $line = <$in> ) {
            $line =~ s/[#].*//s;
            $line =~ s/\A\s+|\s+\z//g;
            push @paths, $line if $line ne q{};
        }
        close $in or die "Cannot close $file: $!\n";
    }
    return @paths;
}

=head2 (\@out, \@err, $status) = run(@command)

The lines that C<@command> writes to its standard output and its standard
error, without their newlines, and its wait status.  The standard error goes
through a file, so that neither stream can fill and stall the other.

=cut

sub run {
    my (@command) = @_;

    my $err = File::Temp->new();
    my $pid = IPC::Open3::open3( my $in, my $from, '>&' . fileno($err), @command );
    close $in or die "Cannot close the input of @command: $!\n";
    chomp( my @out = <$from> );
    waitpid( $pid, 0 );
    my $status = $?;

    seek( $err, 0, 0 ) or die "Cannot read the errors of @command: $!\n";
    chomp( my @err = <$err> );
    return ( \@out, \@err, $status );
}

=head2 write_state($path, @lines)

Replaces C<$path> with C<@lines>, through a file beside it, so that a run that
dies leaves the last state whole.

=cut

sub write_state {
    my ( $path, @lines ) = @_;

    my $tmp = File::Temp->new( DIR => File::Basename::dirname($path), UNLINK => 0 );
    print {$tmp} map { "$_\n" } @lines;
    close $tmp              or die "Cannot write $tmp: $!\n";
    rename( "$tmp", $path ) or die "Cannot replace $path: $!\n";
    return;
}

exit main() unless caller;

1;
