#!/bin/bash
# Reboot if the system says that it needs a reboot.
#
#     reboot_if_needed [SWITCH]
#
# With SWITCH, hold reboots while that file exists, so an operator touches it
# to hold them and removes it to let them happen.
#
# Never reboot while a build runs.  setup.sh puts a file for its domain in
# NO_REBOOT_DIR before it starts and removes it when it ends, however it ends.
# A reboot in the middle cuts the makefile off and leaves a half-built guest.
# /run is emptied at boot, so a flag cannot outlive the build that placed it.
#
# REBOOT_REQUIRED and NO_REBOOT_DIR name other files than the real ones, for
# the test of this script.

SWITCH=$1
REBOOT_REQUIRED=${REBOOT_REQUIRED:-/var/run/reboot-required}
NO_REBOOT_DIR=${NO_REBOOT_DIR:-/run/provisioner/no-reboot}

[ -f "$REBOOT_REQUIRED" ] || exit 0

if [ -n "$SWITCH" ] && [ -e "$SWITCH" ]; then
    exit 0
fi

if [ -n "$(ls -A "$NO_REBOOT_DIR" 2>/dev/null)" ]; then
    exit 0
fi

reboot now
