#!/usr/bin/perl

package ZoneSyncer;

use 5.014;

use strict;
use warnings FATAL => 'all';

use List::Util qw{any};
use JSON       qw{decode_json};
use Net::DNS::ZoneFile;
use Config::Simple;
use Getopt::Long qw{GetOptionsFromArray};

=head1 synczones

=head2 SYNOPSIS

    synczones --driver powerdns --config /etc/synczones.conf zonefile.zone

=head2 DESCRIPTION

Make the records at one or more DNS providers match one or more zonefiles.
The script uses the lexicon command to list, create, update and delete the
records.

=head2 OPTIONS

=over 4

=item --driver NAME

The lexicon provider to sync to, for example C<powerdns>.  Give it one time for
each provider.  At least one is required.

=item --config FILE

A L<Config::Simple> file with one block for each driver.  A block can set
C<auth_username>, C<auth_token> and C<server>.  The default is
F</etc/synczones.conf>.

=item --dryrun

Print each create, update and delete command and do not run it.  The script
still runs the list commands.

=item --quiet

Do not print progress.  C<--dryrun> still prints its commands.

=back

The script dies if you give no zonefile or no driver, if a zonefile does not
exist, or if a lexicon command fails.

=cut

# The record types that zonediff() knows how to compare.  The list is not
# complete.
my @record_types = qw{SOA A AAAA MX CNAME TXT SRV CAA};

my %d2o = (
    powerdns => 'pdns-server',
);

sub main {
    my (@args) = @_;

    my @drivers;
    my ( $cfile, $dryrun, $quiet );
    GetOptionsFromArray(
        \@args,
        'driver=s@' => \@drivers,
        'config=s'  => \$cfile,
        'dryrun'    => \$dryrun,
        'quiet'     => \$quiet,
    );

    die "Must pass at least one zonefile" unless @args;
    die "Must pass at least one --driver" unless @drivers;

    $cfile //= '/etc/synczones.conf';
    my $config = Config::Simple->new($cfile);
    my %dconf  = $config->vars();

    # TODO check perms on config aren't group/world readable and owned by root

    foreach my $zone (@args) {
        die "No such zonefile $zone" unless -f $zone;    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- existence, to name the missing file rather than fail obscurely on the read
        my $zf    = Net::DNS::ZoneFile->new($zone);
        my @zones = $zf->read;
        my %zhash = map {
            my $rt = $_;
            $rt => [ grep { uc( $_->type() ) eq $rt } @zones ]
        } @record_types;
        my $origin = $zf->origin;
        $origin =~ s/\.$//;
        foreach my $driver (@drivers) {
            my @preamble = ( "lexicon", $driver );
            push( @preamble, '--auth-username=' . qq{'$dconf{"$driver.auth_username"}'} ) if $dconf{"$driver.auth_username"};
            push( @preamble, '--auth-token=' . qq{'$dconf{"$driver.auth_token"}'} )       if $dconf{"$driver.auth_token"};
            push( @preamble, qw{--output=JSON} );

            # A driver that needs a server address takes it with the option
            # that %d2o names.
            push( @preamble, "--$d2o{$driver}=" . qq{'$dconf{"$driver.server"}'} ) if $dconf{"$driver.server"};

            my $lexicon = join( ' ', @preamble );
            foreach my $type (@record_types) {
                my $listcmd = "$lexicon list $origin $type";
                print "Scanning for existing $type records for $origin on $driver..." unless $quiet;
                my $result = qx{$listcmd};
                die "command failed." if $?;
                print "Done.\n" unless $quiet;

                my $decoded = decode_json($result);
                my %crud    = zonediff( $zhash{$type}, $decoded );
                foreach my $action ( keys(%crud) ) {
                    my $nr_changes = scalar( @{ $crud{$action} } );
                    print "Found $nr_changes $type $action\n" unless $quiet;
                    foreach my $to_do ( @{ $crud{$action} } ) {
                        my @cmd_suffix;
                        my $content = $to_do->{content};
                        my $ttl     = $to_do->{ttl};
                        my $name    = $to_do->{name};
                        my $ident   = $to_do->{id};
                        push( @cmd_suffix, "--identifier '$ident'" ) if $action ne 'create';
                        push( @cmd_suffix, "--ttl $ttl" )            if $action ne 'delete';
                        push( @cmd_suffix, "--name '$name'" )        if $action ne 'delete';
                        push( @cmd_suffix, "--content '$content'" )  if $action ne 'delete';
                        my $suffix = join( ' ', @cmd_suffix ) // '';
                        my $do_cmd = qq{$lexicon $action $origin $type $suffix};

                        if ($dryrun) {
                            print "$do_cmd\n";
                            next;
                        }
                        my $out = qx($do_cmd);
                        die "Failure reported:\n$do_cmd\n\n$out" if $?;
                    }
                    print "Done with $nr_changes $type $action\n" if $nr_changes && !$quiet;
                }
            }
        }
    }

    return 0;
}

exit main(@ARGV) unless caller;

=head2 zonediff

    my %crud = zonediff( \@records_from_zonefile, \@records_at_provider );

Takes the zonefile records of one type, as L<Net::DNS::RR> objects, and the
provider records of that type, as the hashes that C<lexicon list> returns.
Both array references are changed: the first is emptied.

Returns a list of three pairs, C<update>, C<create> and C<delete>, each an array
reference.  An C<update> or C<create> item is a hash with C<content>, C<name>,
C<id> and C<ttl>.  A C<delete> item is a provider record.

An SOA record is updated in place.  Every other type is deleted and created.
Dies with "Cannot attempt to do two updates" when a third SOA record comes.

=cut

sub zonediff {
    my ( $zones_from_file, $zones_actual ) = @_;

    my @to_update;
    my @to_create;
    my @to_delete;
  OUTER: while ( my $to_sync = shift @$zones_from_file ) {
        my $raw = $to_sync->plain;
        my $update_id;

        # Render each provider record four ways: as it arrived, with a trailing
        # dot, in quotes, and without quotes.  A provider can return any of
        # them for one zonefile record.  The /r leaves content as it arrived.
        @$zones_actual = map {
            my $s     = $_;
            my $dquot = $_->{content} =~ s/"//gr;
            $s->{plain} = "$_->{name}. $_->{ttl} IN $_->{type} $_->{content}";
            $s->{pdot}  = "$s->{plain}.";
            $s->{pquot} = qq|$_->{name}. $_->{ttl} IN $_->{type} "$_->{content}"|;
            $s->{dquot} = qq|$_->{name}. $_->{ttl} IN $_->{type} $dquot|;
            $s
        } @$zones_actual;

        # Look at each provider record one time.  A record that does not match
        # goes to the back of the list.
        for ( 1 .. scalar(@$zones_actual) ) {
            my $pmatch = shift @$zones_actual;

            # An update needs the provider identifier for this name and type,
            # and the content does not have to match.
            $update_id //= $pmatch->{id}
              if lc( $pmatch->{name} ) eq lc( $to_sync->owner ) && uc( $pmatch->{type} ) eq uc( $to_sync->type );

            # The provider already has this record, so there is nothing to do.
            if ( any { $_ eq $raw } ( $pmatch->{plain}, $pmatch->{pdot}, $pmatch->{pquot}, $pmatch->{dquot} ) ) {
                $update_id = $pmatch->{id};
                next OUTER;
            }

            push( @$zones_actual, $pmatch );
        }

        # A zone has exactly one SOA, so it gets an update.  NS is not in
        # @record_types, so zonediff never sees it.
        my $do_update = any { $to_sync->type eq $_ } qw{SOA NS};

        # For any other type, delete the provider records that did not match
        # and create the record from the zonefile.
        push( @to_delete, @$zones_actual ) unless $do_update;
        my $ref2push = $do_update ? \@to_update : \@to_create;

        die "Cannot attempt to do two updates to " . $to_sync->type() . " records." if $do_update && @to_update > 1;
        push( @$ref2push, { content => $to_sync->rdstring, name => $to_sync->owner, id => $update_id, ttl => $to_sync->ttl } );
    }
    return ( update => \@to_update, create => \@to_create, delete => \@to_delete );
}

