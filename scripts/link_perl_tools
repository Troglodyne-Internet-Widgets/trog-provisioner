#!/bin/bash

# link_perl_tools USER
#
# Point an account's bin at the tools of the perl the perl recipe built, and
# /root/bin at the ones scripts/cpan_install needs to find it by.
#
# Run at the end of the perl recipe's target, after everything it installs:
# a link is made only for a tool that is there, so linking before the installs
# meant dzil and starman got theirs on the next provision rather than this one.

CLIENT=$1
[ -n "$CLIENT" ] || { echo "usage: link_perl_tools USER" >&2; exit 2; }

# Where the perls are and where cpan_install looks, both settable so that
# t/link_perl_tools.t can point this at a tree of its own.
PERLS=${LINK_PERL_TOOLS_PERLS:-/opt/perl5}
ROOT_BIN=${LINK_PERL_TOOLS_ROOT_BIN:-/root/bin}

BUILT=$(ls -1d "$PERLS"/*/bin 2>/dev/null | tail -n1)
if [ -z "$BUILT" ]; then
    echo "link_perl_tools: nothing built under $PERLS, so there is nothing to link" >&2
    exit 1
fi

CLIENT_HOMEDIR=$(getent passwd "$CLIENT" | cut -d: -f6)
if [ -z "$CLIENT_HOMEDIR" ]; then
    echo "link_perl_tools: no such account '$CLIENT'" >&2
    exit 255
fi

# Named, because "Can't get client's homedir!" says neither which account nor
# which directory, and the answer is usually that the account is not the one the
# domain meant: a service user has the domain directory as its home and that is
# made by the service_user target, but an account like www-data has /var/www,
# which only exists if something else created it.
if [ ! -d "$CLIENT_HOMEDIR" ]; then
    echo "link_perl_tools: home directory '$CLIENT_HOMEDIR' for '$CLIENT' does not exist" >&2
    exit 255
fi

mkdir -p "$CLIENT_HOMEDIR/bin" "$ROOT_BIN"

# Guarded on the target existing rather than on the link being absent.  A link
# to nothing is worse than no link: it satisfies -e, so anything checking for
# the tool finds it and then fails at the point of use -- which is what yath and
# dzil were on every guest that ran the perl recipe.
link_tool() {
    [ -e "$BUILT/$1" ] || return 0
    [ -L "$2/$1" ] && return 0
    ln -s "$BUILT/$1" "$2/$1"
}

for tool in perl prove yath dzil cpanm starman perlcritic perltidy nytprofmerge nytprofhtml; do
    link_tool "$tool" "$CLIENT_HOMEDIR/bin"
done
for tool in perl cpanm; do
    link_tool "$tool" "$ROOT_BIN"
done
exit 0
