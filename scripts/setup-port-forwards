#!/bin/bash
# Write the port forwards into the before.rules file of ufw, as a *nat table.
#
# Each run rewrites the block between two markers and does not add a second one.
# iptables-restore refuses a table that is declared twice, and then ufw fails to
# start.
set -eu

RULES=/etc/ufw/before.rules
BEGIN='# BEGIN trog-provisioner port forwards'
END='# END trog-provisioner port forwards'

[ -f "$RULES" ] || { echo "setup-port-forwards: no $RULES" >&2; exit 1; }

# Remove every block that an earlier run wrote.
sed -i "\|^$BEGIN\$|,\|^$END\$|d" "$RULES"

# No forwards is valid, and the old block is already gone.
if [ "$#" -eq 0 ]; then
    exit 0
fi

block="$BEGIN\n*nat\n:POSTROUTING ACCEPT [0:0]\n"
for portmap in "$@"; do
    FROM=${portmap%%=*}
    TO=${portmap##*=}
    echo "Forwarding port $FROM to $TO"
    block="$block-A PREROUTING -p tcp --dport $FROM -j REDIRECT --to-port $TO\n"
done
block="${block}COMMIT\n$END"

# Put the block before the filter table, which is where a nat table must go.
awk -v b="$block" '/^\*filter/ && !seen { print b; seen = 1 } { print }' "$RULES" > "$RULES.new"
mv "$RULES.new" "$RULES"
