#!/bin/bash
# Port forwards, written into ufw's before.rules as a *nat table.
#
# Rewritten between two markers on each run, rather than inserted again.  This
# used to sed a fresh *nat block in ahead of *filter every time, so a second
# provision left two of them in the file -- and iptables-restore refuses a table
# declared twice, which means ufw fails to start on a guest that was working
# until it was provisioned again.
set -eu

RULES=/etc/ufw/before.rules
BEGIN='# BEGIN trog-provisioner port forwards'
END='# END trog-provisioner port forwards'

[ -f "$RULES" ] || { echo "setup-port-forwards: no $RULES" >&2; exit 1; }

# Take out whatever was put there last time, however many times it was put.
sed -i "\|^$BEGIN\$|,\|^$END\$|d" "$RULES"

# No forwards is a valid answer, and by here the old block is gone.
if [ "$#" -eq 0 ]; then
    exit 0
fi

block="$BEGIN\n*nat\n:POSTROUTING ACCEPT [0:0]\n"
for portmap in "$@"; do
    FROM=${portmap%%=*}
    TO=${portmap##*=}
    echo "Forwarding port $FROM to $TO"
    block="$block-A PREROUTING -p tcp --dport $FROM -j REDIRECT --to-port $TO\n"
done
block="${block}COMMIT\n$END"

# Ahead of the filter table, which is where a nat table has to be.
awk -v b="$block" '/^\*filter/ && !seen { print b; seen = 1 } { print }' "$RULES" > "$RULES.new"
mv "$RULES.new" "$RULES"
