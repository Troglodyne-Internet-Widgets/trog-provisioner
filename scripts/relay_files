#!/usr/bin/perl

package Trog::RelayFiles;

use 5.014;

use strict;
use warnings FATAL => 'all';

use Cwd                    ();
use Data::Validate::Domain ();
use Fcntl                  qw{:flock};
use File::Basename         ();
use File::Temp             ();
use IPC::Open3             ();
use MIME::Base64           ();
use Socket                 ();
use Time::HiRes            ();

=head1 relay_files

=head2 SYNOPSIS

    require( File::Basename::dirname( Cwd::abs_path(__FILE__) ) . '/relay_files' );

    my $lock = Trog::RelayFiles::lock_dir( $dir, 'nginxrelay_client' );
    Trog::RelayFiles::write_file( "$dir/$domain.map", $content );

=head2 DESCRIPTION

What F<scripts/nginxrelay_client> and F<scripts/mailrelay_client> share: each
keeps the registrations of other guests in files of one directory, which a
service reads, and issues the keys that those guests send their bans with.  This runs under the system perl of the guest, which has no
Provisioner libraries, so the two load it from beside themselves.  It runs
nothing on its own.

=head2 dns_name($name)

True when C<$name> is a name of the DNS in lower case.  Each one goes into a
file that a service reads.

=cut

sub dns_name {
    my ($name) = @_;

    # is_domain also takes capitals and a final dot, so those are refused
    # here: the name goes into a file, a path and the arguments of a command,
    # and must have one spelling.
    return 0 unless defined $name && $name =~ m/\A[[:lower:][:digit:].-]*[[:lower:][:digit:]-]\z/a;
    return defined Data::Validate::Domain::is_domain( $name, { domain_disable_tld_validation => 1 } ) ? 1 : 0;
}

=head2 upstream($upstream)

True when C<$upstream> is an IPv4 address and a port, such as
C<192.0.2.10:8443>.

=cut

sub upstream {
    my ($upstream) = @_;

    return 0 unless defined $upstream && $upstream =~ m/\A([^:]+):([[:digit:]]{1,5})\z/a;
    my ( $address, $port ) = ( $1, $2 );
    return defined Socket::inet_pton( Socket::AF_INET(), $address ) && $port >= 1 && $port <= 65535 ? 1 : 0;
}

=head2 ($output, $ok) = run([\%opts,] @command)

Runs C<@command>, a list, so that no shell reads it.  Returns its output and
whether it succeeded.  The output holds its standard error as well, so that
nothing but what a client prints on purpose reaches the output of the client:
F<bin/provision> reads it over ssh on a pty, which joins the two streams.
C<< { input => $text } >> first gives the command its standard input.  This is
the one thing that a test of a client stands in for.

=cut

sub run {
    my (@command) = @_;
    my $opts = ref $command[0] eq 'HASH' ? shift @command : {};

    my $pid = IPC::Open3::open3( my $in, my $out, undef, @command );
    print {$in} $opts->{input} // q{};
    close $in or die "Could not close the input of @command: $!\n";
    my $output = do { local $/ = undef; <$out> }
      // q{};
    waitpid( $pid, 0 );

    return ( $output, $? == 0 ? 1 : 0 );
}

=head2 read_file($file)

The content of C<$file>, or undef where there is no file.

=cut

sub read_file {
    my ($file) = @_;

    open( my $fh, '<', $file ) or return;
    my $content = do { local $/ = undef; <$fh> };
    close $fh or die "Cannot read $file: $!\n";
    return $content;
}

=head2 write_file($file, $content, $mode, $group)

Replaces C<$file> with C<$content>, through a file beside it, so that a service
never reads half of it, or removes C<$file> when C<$content> is undef.  The
file is 0644, or C<$mode> and the group C<$group>.

=cut

sub write_file {
    my ( $file, $content, $mode, $group ) = @_;

    if ( !defined $content ) {
        unlink $file or $!{ENOENT} or die "Cannot remove $file: $!\n";
        return;
    }

    # open keeps the mode of a file that exists, such as one a failed run left.
    unlink "$file.new";
    my $umask  = umask oct 22;
    my $opened = open( my $fh, '>', "$file.new" );
    umask $umask;
    $opened or die "Cannot write $file.new: $!\n";
    print {$fh} $content;
    close $fh or die "Cannot write $file.new: $!\n";

    if ( defined $mode ) {
        chmod( $mode, "$file.new" ) or die "Cannot chmod $file.new: $!\n";
    }
    if ( defined $group ) {
        my $gid = getgrnam($group) // die "There is no group $group for $file\n";
        chown( -1, $gid, "$file.new" ) or die "Cannot chown $file.new: $!\n";
    }
    rename( "$file.new", $file ) or die "Cannot replace $file: $!\n";
    return;
}

=head2 $lock = lock_dir($dir, $client)

Locks C<$dir> until the caller closes C<$lock>, so that two guests that
register at one time do not both take a name.  It waits up to C<$LOCK_WAIT>
seconds for another run of C<$client>, and then dies, naming the file.

=cut

# The lock is held only while a client runs a few short commands, so a longer
# wait is a hang.
our $LOCK_WAIT = 60;

sub lock_dir {
    my ( $dir, $client ) = @_;
    my $lock = "$dir/.lock";
    open( my $fh, '>>', $lock ) or die "Cannot open $lock: $!\n";

    my $until = Time::HiRes::time() + $LOCK_WAIT;
    while ( !flock( $fh, LOCK_EX | LOCK_NB ) ) {
        die "Cannot lock $lock: $!\n" unless $!{EWOULDBLOCK};
        die "Another registration or release held $lock for all of the $LOCK_WAIT seconds that this one waited, so it is probably stuck.  ps -o pid,etime,args -C $client shows it.\n"
          if Time::HiRes::time() >= $until;
        Time::HiRes::sleep(0.2);
    }
    return $fh;
}

=head2 $key = issue_ban_key($dir, $domain, $address, $set)

Makes a new ed25519 key for C<$domain>, and returns the private half in base64
on one line.  The public half goes into C<$dir/$domain.ban.pub>, and then into
C<$dir/authorized_keys.root>, which sshd reads beside the keys of root.  It can
run only F<scripts/relay_ban> for C<$set> and C<$domain>, and only from
C<$address>, the IPv4 address of the guest of C<$domain>.  It replaces the key
that C<$domain> had.  See L<Provisioner::RelayRecipe/Bans>.

Dies, and leaves the old key, when C<ssh-keygen> fails.

=cut

# Beside this file, as every script of the provisioner is.
our $RELAY_BAN = File::Basename::dirname( Cwd::abs_path(__FILE__) ) . '/relay_ban';

sub issue_ban_key {
    my ( $dir, $domain, $address, $set ) = @_;
    return issue_key( $dir, $domain, $address, 'ban', "$RELAY_BAN $set $domain" );
}

=head2 revoke_ban_key($dir, $domain)

Removes the key of C<$domain> that C<issue_ban_key> made.  It can be gone
already.

=cut

sub revoke_ban_key {
    my ( $dir, $domain ) = @_;
    return revoke_key( $dir, $domain, 'ban' );
}

=head2 $key = issue_key($dir, $domain, $address, $kind, $command)

Makes a new ed25519 key for C<$domain>, and returns the private half in base64
on one line.  The public half goes into C<$dir/$domain.$kind.pub>, and then into
C<$dir/authorized_keys.root>.  It can run only C<$command>, and only from
C<$address>.  It replaces the key of that C<$kind> that C<$domain> had.
C<$kind> is one of C<@KEY_KINDS>.  C<issue_ban_key> is the usual caller.

Dies, and leaves the old key, when C<ssh-keygen> fails.

=cut

# Each kind of key that a relay issues, and so each file that sshd takes.
our @KEY_KINDS = qw{ban media};

sub issue_key {
    my ( $dir, $domain, $address, $kind, $command ) = @_;
    my %known = map { $_ => 1 } @KEY_KINDS;
    die "There is no kind of key $kind\n" unless $known{$kind};

    my $keys = File::Temp::tempdir( CLEANUP => 1 );
    ## no critic (PreferredBinaries) -- this runs under the system perl of the relay, which has no Provisioner::Utils
    my ( $said, $ok ) = run( qw{ssh-keygen -q -t ed25519 -N}, q{}, '-C', "$kind of $domain", '-f', "$keys/key" );
    ## use critic
    die "Could not make the key of $domain: $said\n" unless $ok;

    write_file( "$dir/$domain.$kind.pub", qq{restrict,from="$address",command="$command" } . read_file("$keys/key.pub") );
    write_authorized_keys($dir);
    return MIME::Base64::encode_base64( read_file("$keys/key"), q{} );
}

=head2 revoke_key($dir, $domain, $kind)

Removes the key of C<$kind> of C<$domain> that C<issue_key> made.  It can be
gone already.

=cut

sub revoke_key {
    my ( $dir, $domain, $kind ) = @_;
    write_file( "$dir/$domain.$kind.pub", undef );
    write_authorized_keys($dir);
    return;
}

# The keys of every domain, in the one file of $dir that sshd reads for root.
# Only a line that restricts its key, so that a bare key never logs in as root.
sub write_authorized_keys {
    my ($dir) = @_;
    my @lines = grep { m/\Arestrict,/ } map { split( m/^/m, read_file($_) // q{} ) } sort map { glob("$dir/*.$_.pub") } @KEY_KINDS;
    write_file( "$dir/authorized_keys.root", join( q{}, @lines ) );
    return;
}

1;
