#!/usr/bin/perl

package Trog::MailRelayClient;

use 5.014;

use strict;
use warnings FATAL => 'all';

use Cwd            ();
use File::Basename ();
use Crypt::PRNG    ();
use List::Util     qw{any};

BEGIN { require( File::Basename::dirname( Cwd::abs_path(__FILE__) ) . '/relay_files' ) }

=head1 mailrelay_client

=head2 SYNOPSIS

    mailrelay_client register DOMAIN ADDRESS
    mailrelay_client register-clients DOMAIN IMAPS SUBMISSIONS POP3S NAME [NAME ...]
    mailrelay_client release DOMAIN

=head2 DESCRIPTION

Runs as root on a guest that runs L<Provisioner::Recipe::mailrelay>, for
another guest whose C<mail.relay.host> names this one.

C<register> lets the guest of DOMAIN send its mail out through this guest.  It
makes a new password for the login DOMAIN, keeps only its hash, and prints the
password on one line.  The relay takes mail from that login only with a sender
in DOMAIN.  dovecot makes the hash, with its C<ARGON2ID> scheme.  It also makes
this guest relay the mail for DOMAIN that comes in from the internet to
ADDRESS, the IPv4 address of the guest, on port 25.  It replaces what DOMAIN
registered before.  See L<Provisioner::Recipe::mailrelay/Mail out> and
L<Provisioner::Recipe::mailrelay/Mail in>.

C<register-clients> sends the mail clients of DOMAIN to its guest.  A TLS
connection on 993, 465 or 995 whose SNI name is a NAME goes to IMAPS,
SUBMISSIONS or POP3S, with the PROXY protocol.  Each of those is an IPv4
address and a port, such as C<192.0.2.10:10993>.  It refuses a NAME that
another domain registered.  If C<nginx -t> refuses the result, it puts the old
files of DOMAIN back.  Then it issues DOMAIN the key that its guest sends its
bans with, and prints the private half in base64 on one line.  The key runs only
F<relay_ban> for DOMAIN and the set C<mailrelay-bans>, and only from the
address of IMAPS.  See L<Provisioner::Recipe::mailrelay/Mail clients>.

C<release> removes all of it: the login, the relay, the routes of the clients
and the key.  Any of it can be gone already.

Each one waits up to a minute for another C<register> or C<release> to
finish, and then gives up and says which file is locked.

It exits 0 when it did that.  When a step fails, it says which, and exits
with another status.

=cut

my $USAGE = "usage: mailrelay_client register DOMAIN ADDRESS
" . "       mailrelay_client register-clients DOMAIN IMAPS SUBMISSIONS POP3S NAME [NAME ...]
" . "       mailrelay_client release DOMAIN
";

our $RELAY_D = '/etc/postfix/mailrelay.d';

# The files of the mail of $domain, by the table that each goes into: the hash
# of its login and the senders it owns, for mail out, and its domain, where
# that goes, and its recipients, for mail in.
my @TABLES = qw{passwd senders relay_domains transport recipients};

sub files_of {
    my ($domain) = @_;
    return map { $_ => "$RELAY_D/$domain.mail.$_" } @TABLES;
}

our $BAN_SET = 'mailrelay-bans';

# The services of the mail clients, in the order of the arguments of
# register-clients.  nginx reads the map of each, $domain.$service.map.
my @SERVICES = qw{imaps submissions pop3s};

sub maps_of {
    my ($domain) = @_;
    return map { $_ => "$RELAY_D/$domain.$_.map" } @SERVICES;
}

# Each name that a domain other than $domain registered, mapped to that domain.
sub names_of_others {
    my ($domain) = @_;

    my %holder;
    foreach my $map ( glob("$RELAY_D/*.imaps.map") ) {
        my ($other) = $map =~ m{/([^/]+)[.]imaps[.]map\z};
        next if $other eq $domain;
        $holder{$_} = $other foreach map { m/\A(\S+)\s/ ? $1 : () } split m/\n/, Trog::RelayFiles::read_file($map) // q{};
    }
    return %holder;
}

sub reload_nginx {
    my ( $said, $ok ) = Trog::RelayFiles::run(qw{systemctl reload nginx});
    die "nginx did not reload: $said\n" unless $ok;
    return;
}

# The group that dovecot reads the hashes as.
our $DOVECOT_GROUP = 'dovecot';

# The tables of every domain, in the files that dovecot and postfix read.
sub write_tables {
    foreach my $kind (@TABLES) {
        my $content = join( q{}, map { Trog::RelayFiles::read_file($_) // q{} } sort glob("$RELAY_D/*.mail.$kind") );
        Trog::RelayFiles::write_file( "$RELAY_D/mail.$kind", $content, $kind eq 'passwd' ? ( oct 640, $DOVECOT_GROUP ) : () );
    }
    return;
}

# The hash of $password that dovecot reads, made by dovecot itself, because the
# CryptX of the system perl is too old for Argon2.  setsid, because doveadm
# reads a password from the terminal when it has one, and bin/provision runs
# this on a pty.  It asks twice, so it gets the password twice.
sub hash_password {
    my ($password) = @_;
    my ( $hash, $ok ) = Trog::RelayFiles::run( { input => "$password\n$password\n" }, qw{setsid --wait doveadm pw -s ARGON2ID} );
    die "doveadm could not hash the password: $hash\n" unless $ok && $hash =~ m/\A(\{ARGON2ID\}\S+)\s*\z/;
    return $1;
}

sub reload_postfix {
    my ( $said, $ok ) = Trog::RelayFiles::run(qw{systemctl reload postfix});
    die "postfix did not reload: $said\n" unless $ok;
    return;
}

sub lock_relay {
    return Trog::RelayFiles::lock_dir( $RELAY_D, 'mailrelay_client' );
}

sub register {
    my ( $domain, $address ) = @_;

    my $lock     = lock_relay();
    my %file     = files_of($domain);
    my $password = Crypt::PRNG::random_bytes_hex(24);

    Trog::RelayFiles::write_file( $file{passwd},        "$domain:" . hash_password($password) . "\n", oct 600 );
    Trog::RelayFiles::write_file( $file{senders},       "\@$domain $domain\n" );
    Trog::RelayFiles::write_file( $file{relay_domains}, "$domain OK\n" );
    Trog::RelayFiles::write_file( $file{transport},     "$domain smtp:[$address]:25\n" );

    # The guest takes mail for any address in its domain, which its catchall
    # delivers.  So the relay takes every recipient there too.
    Trog::RelayFiles::write_file( $file{recipients}, "\@$domain OK\n" );
    write_tables();
    reload_postfix();

    print "$password\n";
    close $lock or die "Cannot unlock $RELAY_D: $!\n";
    return 0;
}

sub register_clients {
    my ( $domain, $upstreams, @names ) = @_;

    my $lock   = lock_relay();
    my %holder = names_of_others($domain);
    my @taken  = grep { defined $holder{$_} } @names;
    die join( q{}, map { "$_ is registered to $holder{$_}\n" } @taken ) . "So $domain cannot register it.  Release it there first.\n" if @taken;

    my %map = maps_of($domain);
    my %old = map { $_ => scalar Trog::RelayFiles::read_file( $map{$_} ) } @SERVICES;
    foreach my $service (@SERVICES) {
        Trog::RelayFiles::write_file( $map{$service}, join( q{}, map { "$_ $upstreams->{$service};\n" } @names ) );
    }

    my ( $said, $ok ) = Trog::RelayFiles::run(qw{nginx -t});
    if ( !$ok ) {
        Trog::RelayFiles::write_file( $map{$_}, $old{$_} ) foreach @SERVICES;
        die "nginx refused what $domain registered, so it keeps what it had: $said\n";
    }

    my ($address) = split( m/:/, $upstreams->{imaps} );
    my $key = Trog::RelayFiles::issue_ban_key( $RELAY_D, $domain, $address, $BAN_SET );
    reload_nginx();

    print $key;
    close $lock or die "Cannot unlock $RELAY_D: $!\n";
    return 0;
}

sub release {
    my ($domain) = @_;

    my $lock = lock_relay();
    my %file = ( files_of($domain), maps_of($domain) );
    Trog::RelayFiles::write_file( $_, undef ) foreach values %file;
    write_tables();
    Trog::RelayFiles::revoke_ban_key( $RELAY_D, $domain );

    # A service that is not up reads the files when it starts.
    foreach my $reload ( \&reload_postfix, \&reload_nginx ) {
        my $err = do {
            local $@;
            eval { $reload->(); 1 } ? undef : $@;
        };
        warn $err if defined $err;
    }
    close $lock or die "Cannot unlock $RELAY_D: $!\n";
    return 0;
}

sub main {
    my ( $command, $domain, @args ) = @_;

    die $USAGE unless defined $command && Trog::RelayFiles::dns_name($domain);

    if ( $command eq 'register' ) {
        my ( $address, @rest ) = @args;
        die $USAGE if @rest || !defined $address || !Trog::RelayFiles::upstream("$address:25");
        return register( $domain, $address );
    }
    if ( $command eq 'register-clients' ) {
        my ( @upstreams, @names );
        ( @upstreams[ 0 .. $#SERVICES ], @names ) = @args;
        die $USAGE if !@names || any { !Trog::RelayFiles::upstream( $_ // q{} ) } @upstreams;
        die $USAGE if any            { !Trog::RelayFiles::dns_name($_) } @names;
        my %upstream;
        @upstream{@SERVICES} = @upstreams;
        return register_clients( $domain, \%upstream, @names );
    }
    return release($domain) if $command eq 'release' && !@args;
    die $USAGE;
}

exit main(@ARGV) unless caller;

1;
