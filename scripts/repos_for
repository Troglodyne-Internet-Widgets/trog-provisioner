#!/usr/bin/perl

package Trog::repogetter;

use 5.014;

use strict;
use warnings FATAL => 'all';

use File::pushd  qw{pushd};
use Getopt::Long qw{GetOptionsFromArray};
use JSON::PP     ();
use Pithub;

my $USAGE = "usage: repos_for [--reset] API_URL ENTITY [ENTITY ...] < token_file\n";

=head1 NAME

repos_for - clone every repository that an API lists for each entity

=head1 SYNOPSIS

    repos_for [--reset] API_URL ENTITY [ENTITY ...] < token_file

The API token comes on stdin.  C<--reset> discards the cache and asks the API
again.

=head1 FUNCTIONS

=head2 $path = cache_file()

Returns the path of the file that keeps the answers from an api_url between
runs.

=cut

# JSON::PP and not JSON, because this runs on the system perl of a guest.  The
# admincode recipe installs only libpithub-perl and git, and JSON::PP is core
# since 5.014.
sub cache_file { return "$ENV{HOME}/.repos_for.json" }

sub main {
    my @args = @_;

    my $reset;
    GetOptionsFromArray( \@args, 'reset' => \$reset ) or die $USAGE;

    my ( $api_url, @entities ) = @args;
    die $USAGE unless $api_url && @entities;

    # From stdin and not argv, because ps shows argv to every user on the guest.
    my $token = <STDIN>;    ## no critic (InputOutput::ProhibitExplicitStdin) -- <> reads the files named in argv, and argv here holds the url and the entities
    chomp $token if defined $token;
    die "No API token on stdin.\n" unless $token;

    my $path  = cache_file();
    my $cache = $reset ? {} : read_cache($path);

    my $fetched = 0;
    foreach my $entity (@entities) {

        # Key by the entity as well as by the url, so each entity gets its own
        # answer.
        next if exists $cache->{$api_url}{$entity};

        # Record the entity before its rows, so an entity with no repositories
        # still counts as fetched.  Without this, the guard above cannot tell
        # "has no repositories" from "never fetched".
        $cache->{$api_url}{$entity} //= {};

        foreach my $row ( repos_of( $api_url, $entity, $token ) ) {
            $cache->{$api_url}{$entity}{ $row->{name} } = {
                clone_url      => $row->{clone_url},
                ssh_url        => $row->{ssh_url},
                default_branch => $row->{default_branch},
            };
        }
        $fetched++;
    }

    write_cache( $path, $cache ) if $fetched;

    my $failures = 0;
    foreach my $entity (@entities) {
        my $repos = $cache->{$api_url}{$entity} // {};
        foreach my $repo ( sort keys %$repos ) {
            $failures += clone( $repo, $repos->{$repo} );
        }
    }

    return $failures ? 1 : 0;
}

=head2 @rows = repos_of($api_url, $entity, $token)

Returns the repositories that C<$api_url> lists for C<$entity>, as the rows
that Pithub gives back, from every page.  It is a named sub for the same reason
as C<run>: a test replaces it and does not have to mock Pithub.

=cut

sub repos_of {
    my ( $api_url, $entity, $token ) = @_;

    my $ph = Pithub->new(
        user    => $entity,
        api_uri => $api_url,
        token   => $token,
    );

    my $result = $ph->repos->list();
    $result->auto_pagination(1);

    my @rows;
    while ( my $row = $result->next ) {
        push @rows, $row;
    }

    return @rows;
}

=head2 $failures = clone($repo, $robj)

Clones one repository into the directory C<$repo> under the current directory.
C<$robj> is its cache entry, with C<clone_url> and C<ssh_url>.  It clones over
https and sets the origin to the ssh url.  If that clone fails, it clones over
ssh.

Returns the number of failures, 0 or 1, and does not die.  So one repository
that nobody can reach does not stop the others.  A C<$repo> that is not a plain
directory name is a failure.  A C<$repo> directory that exists already is left
alone and returns 0, because somebody can have work in it.

=cut

sub clone {
    my ( $repo, $robj ) = @_;

    # The name comes from the API and becomes a path, so it must be one plain
    # directory name.
    unless ( $repo =~ m{\A\w[\w.-]*\z}a ) {
        warn "Skipping '$repo': not a plain directory name\n";
        return 1;
    }

    return 0 if -d $repo;

    print "Cloning $repo...\n";
    if ( run( qw{git clone}, $robj->{clone_url}, $repo ) ) {
        my $dir = pushd($repo);
        print "Rewriting origin in $repo...\n";
        return run( qw{git remote set-url origin}, $robj->{ssh_url} ) ? 0 : 1;
    }

    # The admin can have a key in their skel for a host that refuses https.  A
    # clone over ssh already has the ssh origin.
    print "Retrying $repo over ssh...\n";
    return run( qw{git clone}, $robj->{ssh_url}, $repo ) ? 0 : 1;
}

=head2 $ok = run(@cmd)

Runs C<@cmd> with C<system()>.  Returns 1 when the command exits 0, and 0 if not.
It is a named sub so that a test can replace it.

=cut

sub run {
    my @cmd = @_;

    return system(@cmd) == 0 ? 1 : 0;
}

sub read_cache {
    my ($path) = @_;

    return {} unless -f $path;    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- whether there is a cache at all, because no cache is the normal first run

    open my $fh, '<', $path or die "Cannot read $path: $!\n";
    my $json = do { local $/; <$fh> };
    close $fh or die "Cannot close $path: $!\n";

    # A cache that does not parse counts as no cache.  It holds only API answers,
    # so its loss costs one round trip.
    my $cache = eval { JSON::PP->new->utf8->decode($json) };

    return ref $cache eq 'HASH' ? $cache : {};
}

sub write_cache {
    my ( $path, $cache ) = @_;

    my $json = JSON::PP->new->utf8->canonical;

    open my $fh, '>', $path or die "Cannot write $path: $!\n";
    print {$fh} $json->encode($cache);
    close $fh or die "Cannot close $path: $!\n";

    return;
}

exit main(@ARGV) unless caller;
