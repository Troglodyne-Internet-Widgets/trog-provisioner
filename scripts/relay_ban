#!/usr/bin/perl

package Trog::RelayBan;

use 5.014;

use strict;
use warnings FATAL => 'all';

use List::Util ();

=head1 relay_ban

=head2 SYNOPSIS

In the line of the F<authorized_keys.root> of a relay that its client writes for
a domain, such as F<scripts/nginxrelay_client>:

    restrict,from="ADDRESS",command="relay_ban SET DOMAIN" ssh-ed25519 ...

What the guest of DOMAIN sends over ssh with that key:

    ban IP SECONDS
    unban IP
    check IP

=head2 DESCRIPTION

Runs as root on a guest that runs a relay, as the forced command of the key that
the relay issued to DOMAIN.  sshd puts what the guest asked for in
C<SSH_ORIGINAL_COMMAND>.  See L<Provisioner::RelayRecipe/Bans>.

SET is the ipset of the relay, such as C<nginxrelay-bans>.  C<ban> adds IP to
SET for SECONDS, and the relay drops what IP sends to the ports that it
proxies.  A SECONDS of 0 or less bans until
an C<unban>, as fail2ban means by a C<bantime> of -1.  A ban of IP that is
already there takes the new time.  C<unban> removes IP from the set, and an IP
that is not there is no error.  C<check> exits 0 when IP is in the set, and 1
when it is not.

Each set is shared by every domain behind the relay, because the relay cannot
tell which guest a connection is for before nginx reads its first bytes.  So a
domain can unban an address that another domain banned.

IP is an IPv4 address, because the relay proxies IPv4 only.  Each ban and unban
goes to syslog with DOMAIN.  It exits 2 for a request that it does not take,
and 3 when ipset fails.

=cut

# The longest timeout that ipset takes.
our $MAX_SECONDS = 2_147_483;

my $USAGE = "usage: ban IP SECONDS | unban IP | check IP\n";

sub ipv4 {
    my ($ip) = @_;
    my $octet = qr/[[:digit:]]{1,3}/;
    return 0 unless defined $ip && $ip =~ m/\A$octet(?:[.]$octet){3}\z/;
    return ( grep { $_ > 255 } split( m/[.]/, $ip ) ) ? 0 : 1;
}

# Every command this runs, as the one thing a test stands in for.  A list, so
# no shell reads it.  Answers whether it succeeded.
sub run {
    my (@command) = @_;
    return system(@command) == 0 ? 1 : 0;
}

sub ipset {
    my (@args) = @_;
    return run( 'ipset', @args );
}

sub logged {
    my ( $domain, $what ) = @_;
    run( qw{logger -t relay_ban}, "$domain: $what" );
    return;
}

sub main {
    my ( $set, $domain, $request ) = @_;

    die "relay_ban runs as the forced command of a key, which names the set and the domain\n"
      if ( $set // q{} ) !~ m/\A[[:lower:]]+-bans\z/ || ( $domain // q{} ) eq q{};
    my ( $verb, $ip, $seconds, @rest ) = split( q{ }, $request // q{} );

    if ( @rest || !ipv4($ip) ) {
        print {*STDERR} $USAGE;
        return 2;
    }

    if ( $verb eq 'check' && !defined $seconds ) {
        return ipset( qw{-quiet test}, $set, $ip ) ? 0 : 1;
    }

    if ( $verb eq 'unban' && !defined $seconds ) {
        return 3 unless ipset( qw{-exist del}, $set, $ip );
        logged( $domain, "unban $ip" );
        return 0;
    }

    if ( $verb eq 'ban' && defined $seconds && $seconds =~ m/\A-?[[:digit:]]+\z/ ) {
        my $timeout = $seconds <= 0 ? 0 : List::Util::min( $seconds, $MAX_SECONDS );
        return 3 unless ipset( qw{-exist add}, $set, $ip, timeout => $timeout );
        logged( $domain, "ban $ip for " . ( $timeout ? "$timeout seconds" : 'good' ) );
        return 0;
    }

    print {*STDERR} $USAGE;
    return 2;
}

exit main( @ARGV[ 0, 1 ], $ENV{SSH_ORIGINAL_COMMAND} ) unless caller;

1;
