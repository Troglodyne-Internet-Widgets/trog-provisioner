#!/usr/bin/env perl

use strict;
use warnings;

use File::Copy;
use Config::Simple;

=head1 configure_pdns

=head2 SYNOPSIS

    configure_pdns

=head2 DESCRIPTION

Point the PowerDNS unit at the spool directory it keeps its data in.

=cut
my $service_file = "/usr/lib/systemd/system/pdns.service";
die "Can't find service file $service_file" unless -f $service_file;

my $cfg = Config::Simple->new($service_file);

$cfg->param("Service.WorkingDirectory", "/var/spool/powerdns");
# No --chroot.  It was passed with no value at all, which is not a flag
# pdns_server takes -- and every path this recipe configures is absolute and
# outside any chroot anyway: the sqlite database at
# /var/spool/powerdns/zones.db and the API socket at
# /var/spool/powerdns/api.sock would both have to be rewritten relative to the
# root for chrooting to mean anything.  WorkingDirectory already points there.
my $invocation = "/usr/sbin/pdns_server --guardian=no --daemon=no --logging-facility=1 --log-timestamp=yes --write-pid=no";
$cfg->param("Service.ExecStart", $invocation);

File::Copy::copy($service_file, "$service_file.bak");
$cfg->save();
