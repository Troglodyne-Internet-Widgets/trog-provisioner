#!/usr/bin/env perl

use strict;
use warnings;

use File::Copy;
use Config::Simple;

=head1 configure_pdns

=head2 SYNOPSIS

    configure_pdns

=head2 DESCRIPTION

Point the PowerDNS unit at the spool directory it chroots into.

=cut
my $service_file = "/usr/lib/systemd/system/pdns.service";
die "Can't find service file $service_file" unless -f $service_file;

my $cfg = Config::Simple->new($service_file);

$cfg->param("Service.WorkingDirectory", "/var/spool/powerdns");
# --chroot with the directory it chroots to.  It was passed bare, which is not
# something pdns_server accepts -- "Unable to convert presentation address" and
# an exit before it logs anywhere.  Everything it opens afterwards is named
# relative to this root: the sqlite database, the API socket and the control
# socket are all configured as paths inside it, so on the host they land under
# /var/spool/powerdns where the rest of the recipe expects them.
my $chroot     = '/var/spool/powerdns';
my $invocation = "/usr/sbin/pdns_server --guardian=no --daemon=no --logging-facility=1 --log-timestamp=yes --write-pid=no --chroot=$chroot";
$cfg->param("Service.ExecStart", $invocation);

File::Copy::copy($service_file, "$service_file.bak");
$cfg->save();
