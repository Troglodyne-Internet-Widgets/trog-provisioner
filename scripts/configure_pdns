#!/usr/bin/perl

use 5.014;

use strict;
use warnings FATAL => 'all';

use File::Copy;
use Config::Simple;

=head1 configure_pdns

=head2 SYNOPSIS

    configure_pdns

=head2 DESCRIPTION

Point the PowerDNS unit at the spool directory it chroots into.

=cut

my $service_file = "/usr/lib/systemd/system/pdns.service";
die "Can't find service file $service_file" unless -f $service_file;    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- asking whether the unit is there, not gating access to it

my $cfg = Config::Simple->new($service_file);

$cfg->param( "Service.WorkingDirectory", "/var/spool/powerdns" );

# --chroot must name the directory.  pdns names the sqlite database, the API
# socket and the control socket relative to this root.  So on the host they are
# under /var/spool/powerdns, where the rest of the recipe expects them.
my $chroot     = '/var/spool/powerdns';
my $invocation = "/usr/sbin/pdns_server --guardian=no --daemon=no --logging-facility=1 --log-timestamp=yes --write-pid=no --chroot=$chroot";
$cfg->param( "Service.ExecStart", $invocation );

# Run as root, because chroot(2) needs CAP_SYS_CHROOT and the packaged unit
# uses User=pdns.  If pdns_server starts as pdns, it cannot enter the chroot.
# It then looks for /zones.db and /api.sock in the real root and exits with no
# clear cause.  After it enters the chroot, pdns drops to the user and group
# that pdns.global.tt names.
$cfg->param( "Service.User",  "root" );
$cfg->param( "Service.Group", "root" );

# The packaged unit sets three more things that stop a chrooted pdns.  None of
# the errors names its cause.
#
# The packaged bounding set is CAP_NET_BIND_SERVICE and CAP_CHOWN, which leaves
# root without CAP_SYS_CHROOT, with the result above.  CAP_SETUID and
# CAP_SETGID let pdns drop its privileges after it enters the chroot.
my $caps = "CAP_NET_BIND_SERVICE CAP_CHOWN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID";
$cfg->param( "Service.CapabilityBoundingSet", $caps );

# The ambient set decides the capabilities that the process starts with, so it
# gets the same set.  Without it, pdns cannot drop its privileges and logs
# "Unable to set effective user id to 109: Operation not permitted" each second.
$cfg->param( "Service.AmbientCapabilities", $caps );

# chroot(2) is in the @mount group of systemd, and the packaged unit denies that
# group.  seccomp then kills the call, and the service says only "signal=SYS".
# This list is the packaged one without @mount.
$cfg->param( "Service.SystemCallFilter", "~ \@clock \@debug \@module \@raw-io \@reboot \@swap \@cpu-emulation \@obsolete" );

# Type=notify does not work with a chroot, because the notify socket is outside
# it.  pdns refuses to chroot with "Unable to chroot when running from systemd.
# Please disable chroot= or set the 'Type' for this service to 'simple'".
$cfg->param( "Service.Type", "simple" );

File::Copy::copy( $service_file, "$service_file.bak" );
$cfg->save();
