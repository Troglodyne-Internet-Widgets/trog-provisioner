#!/bin/bash
# Usage: verify_disk_queue <scheduler> <read_ahead_kb> <sysfs queue dir>...
#
# Report each disk whose scheduler or read-ahead is not what the udev rule asked
# for.  If the running kernel has no module for a scheduler, the write fails,
# and only the udev log shows it.
#
# A difference is not fatal, because the next boot with a kernel that has the
# scheduler applies the rule.  The script always exits 0.  The provisioning
# test for diskqueue makes sure that the end state is correct.

WANT_SCHEDULER="${1:?Usage: verify_disk_queue <scheduler> <read_ahead_kb> <queue dir>...}"
WANT_READAHEAD="${2:?Usage: verify_disk_queue <scheduler> <read_ahead_kb> <queue dir>...}"
shift 2

for queue in "$@"; do
    # Skip an unmatched glob, which arrives as itself, and a partition, which
    # has no queue of its own.
    [ -e "$queue/scheduler" ] || continue
    disk=$(basename "$(dirname "$queue")")

    # The file reads `[none] mq-deadline` when the kernel offers a choice, and
    # `none` when it does not.  Both forms mean that the kernel took it.
    scheduler=$(cat "$queue/scheduler")
    case "$scheduler" in
        *"[$WANT_SCHEDULER]"*) ;;
        "$WANT_SCHEDULER") ;;
        *) echo "diskqueue: $disk is on '$scheduler' rather than $WANT_SCHEDULER; the udev rule is in place and the next boot will apply it" ;;
    esac

    readahead=$(cat "$queue/read_ahead_kb")
    [ "$readahead" = "$WANT_READAHEAD" ] ||
        echo "diskqueue: $disk reads ahead ${readahead}KiB rather than the ${WANT_READAHEAD}KiB it was given"
done

exit 0
