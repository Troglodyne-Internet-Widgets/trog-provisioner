#!/bin/bash
# Write per-service connection rate limits into ufw's before.rules.
#
# Each argument is a PORT=HITS pair or an EXEMPT=CIDR pair.  HITS is the number
# of new connections one source can open to PORT in a second.  If a source opens
# more, the rule drops the connection.  A source in an EXEMPT network is never
# dropped.
#
# PORT can carry a protocol as PORT/PROTO, spelled the way a ufw application
# profile spells it.  A bare port means tcp.
#
# The exemptions implement admin_networks.  A person who administers the guest
# is not limited, and every other source meets the limit.
#
# ufw's own `limit` is six connections in thirty seconds, and ufw hardcodes it.
# That is too low for a web server.  It is also too low for ssh on this fleet,
# because automation opens the ssh connections, not a person.  So
# setup-ufw-rules allows each profile and limits none of them.  The rules this script writes are the only limits.
#
# The rules go in before.rules, in a chain of our own, not in user.rules.  ufw
# owns user.rules and rewrites it when a rule changes.  The ufw-user-limit
# chains that ufw defines there do not exist yet when ufw reads before.rules.
set -eu

RULES=/etc/ufw/before.rules
BEGIN='# BEGIN trog-provisioner rate limits'
END='# END trog-provisioner rate limits'

# The limits go in a chain of our own, which ufw-before-input jumps into.
#
# RETURN leaves the current chain.  The last rule of ufw-before-input jumps to
# ufw-user-input, which holds every `ufw allow`.  An exemption in
# ufw-before-input itself returns past those allow rules, and the default deny
# drops the packet.  From our own chain, RETURN goes back to ufw-before-input,
# which continues to ufw-user-input.
CHAIN=trog-ratelimit

[ -f "$RULES" ] || { echo "setup-ufw-ratelimits: no $RULES" >&2; exit 1; }

# Remove every block that an earlier run wrote.
sed -i "\|^$BEGIN\$|,\|^$END\$|d" "$RULES"

if [ "$#" -eq 0 ]; then
    exit 0
fi

block="$BEGIN\n"

# Declare the chain and jump into it before you add rules to it.
# iptables-restore reads this file in order.  A jump to a chain that it has not
# seen yet is an error, and the error aborts the whole table.
block="$block:$CHAIN - [0:0]\n"
block="$block-A ufw-before-input -j $CHAIN\n"

# Write the exemptions first.  iptables uses the first rule that matches, so an
# exempt source must return before a limit counts it.
for pair in "$@"; do
    case "$pair" in
        EXEMPT=*) ;;
        *) continue ;;
    esac
    net=${pair##*=}
    echo "Never rate limiting $net"
    block="$block-A $CHAIN -s $net -j RETURN\n"
done

for pair in "$@"; do
    case "$pair" in
        EXEMPT=*) continue ;;
    esac
    spec=${pair%%=*}
    hits=${pair##*=}
    port=${spec%%/*}
    proto=tcp
    case "$spec" in
        */*) proto=${spec##*/} ;;
    esac
    echo "Rate limiting $proto port $port at $hits new connections a second"
    # hashlimit, not recent.  `-m recent --hitcount N` cannot go above
    # xt_recent's ip_pkt_list_tot, which is 20 by default.  A rule over that
    # cap makes iptables-restore reject all of before.rules.
    #
    # hashlimit takes any rate and keeps its own table for each source.  Each
    # port and protocol gets a separate table, or they share their counts.
    # 53/tcp and 53/udp are different services.
    #
    # For udp, ctstate NEW is weaker than for tcp.  udp has no handshake, so NEW
    # is the first packet of a flow that conntrack has not seen recently.  That
    # is still the correct thing to count, because a reflection flood is new
    # flows.  But a udp rate is not the same as a tcp rate.
    block="$block-A $CHAIN -p $proto --dport $port -m conntrack --ctstate NEW -m hashlimit --hashlimit-above $hits/sec --hashlimit-burst $hits --hashlimit-mode srcip --hashlimit-name trog$proto$port -j DROP\n"
done
block="$block$END"

# Put the block at the end of the filter table, not at the start.  ufw's own
# rules before it accept loopback and established traffic.  At the start, the
# limits count both.
awk -v b="$block" '
    /^\*filter/                  { infilter = 1 }
    infilter && /^COMMIT/        { print b; infilter = 0 }
                                 { print }
' "$RULES" > "$RULES.new"
mv "$RULES.new" "$RULES"
