#!/usr/bin/perl

package Trog::Script::CpanInstall;

use 5.014;

use strict;
use warnings FATAL => 'all';

use Cwd          ();
use Getopt::Long ();

=head1 cpan_install

=head2 SYNOPSIS

    cpan_install [--notest] install SPEC [SPEC ...]
    cpan_install [--notest] installdeps DIR
    cpan_install [--notest] dzil DIR
    cpan_install [--notest] pin PKGCONFIG_PACKAGE MODULE

=head2 DESCRIPTION

How what recipes install from CPAN reaches the perl the C<perl> recipe built:
that recipe's target calls this once for each step of its C<cpan_deps>, and the
verbs are the steps' -- see L<Provisioner::Recipe::perl>:

=over 4

=item * C<install> -- anything cpanm takes in place of a module name.

=item * C<installdeps> -- what the distribution in C<DIR> says it needs.

=item * C<dzil> -- what C<dzil authordeps> and then C<dzil listdeps> say is
missing in C<DIR>, in that order, because C<dist.ini> names plugins and dzil
cannot read it to answer the second until the first are installed.  A dzil that
fails fails the step, rather than reading as nothing missing.

=item * C<pin> -- C<MODULE> at the version pkg-config reports for
C<PKGCONFIG_PACKAGE>, asked when this runs.  C<Sys::Virt> is why: it has to
match the C<libvirt> it builds against.

=back

=head3 Which perl

The newest under F</opt/perl5>, looked for each time this runs rather than
written into the task, because that perl's path is its version and the version
is whatever was current the day the guest was built.  Its cpanm, Module::Build
and Dist::Zilla are there because F<build_latest_perl.sh> put them there before
anything called this.

Written for the system perl, which is what runs it.

=head3 Which release

The one the mirror's own F<02packages.details.txt.gz> names: cpanm is run with
C<--mirror-only>, so a module is looked up in the index of the mirror it is
then fetched from.  Left to itself cpanm asks cpanmetadb, a separate service
that can name a release the mirror no longer has -- and cpanm reports that fetch
as C<OK> and fails on unpacking the empty file.  A mirror's index can be behind,
but does not name a file that mirror is missing.

Except for a request the index cannot answer.  It names only the newest release
of each module, so a spec that rules the newest out -- C<Module@version>, which
is what C<pin> asks for, or a requirement with C<==>, C<!=> or C<< < >> in it --
is resolved through MetaCPAN as before, and so is everything else on that cpanm
command line.

=head3 Whose checkout

A C<dzil> directory is a checkout a recipe made and handed to its service user,
and this runs as root, so the git that dzil's plugins run while answering
C<listdeps> refuses it as a repository owned by somebody else.  That directory
is trusted as a C<safe.directory> for the dzil commands asked of it and nothing
else: as git's command-scope configuration, in C<GIT_CONFIG_COUNT> and its
pairs, rather than written into anybody's F<.gitconfig>.

=cut

# Where the perl recipe builds.  A variable so that t/cpan_install.t can point
# this at a tree of its own.
our $PERL_ROOT = '/opt/perl5';

my $USAGE = "usage: cpan_install [--notest] install|installdeps|dzil|pin ARGS\n";

sub main {
    my @args = @_;

    my %opt;
    Getopt::Long::GetOptionsFromArray( \@args, \%opt, 'notest' )
      or return usage();

    my ( $verb, @rest ) = @args;
    return usage() unless defined $verb;

    my $bin   = perl_bin();
    my @cpanm = ( "$bin/cpanm", ( $opt{notest} ? '--notest' : () ) );

    my $rc = 0;
    if ( $verb eq 'install' && @rest ) {
        $rc = run_in( undef, @cpanm, mirror_only(@rest), @rest );
    }
    elsif ( $verb eq 'installdeps' && @rest == 1 ) {
        $rc = run_in( undef, @cpanm, mirror_only(), '--installdeps', $rest[0] );
    }
    elsif ( $verb eq 'dzil' && @rest == 1 ) {
        my ($dir) = @rest;

        # See "Whose checkout" above.
        local @ENV{qw{GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0}} = ( 1, 'safe.directory', $dir );
        foreach my $which (qw{authordeps listdeps}) {
            my ( $failed, @said ) = capture_in( $dir, "$bin/dzil", $which, '--missing' );
            if ($failed) {
                print {*STDERR} "cpan_install: dzil $which --missing exited $failed in $dir, so what it needs is not known\n";
                return $failed;
            }
            my @missing = grep { length } map { s/\s+\z//r } @said;
            next unless @missing;
            $rc = run_in( undef, @cpanm, mirror_only(@missing), @missing ) and last;
        }
    }
    elsif ( $verb eq 'pin' && @rest == 2 ) {
        my ( $package, $module ) = @rest;
        my ( $failed,  @said )   = capture_in( undef, 'pkg-config', '--modversion', $package );
        my ($version) = map { s/\s+\z//r } @said;
        if ( $failed || !defined $version || !length $version ) {
            print {*STDERR} "cpan_install: pkg-config knows no $package, so there is no $module version to pin\n";
            return 1;
        }
        my $spec = "$module\@$version";
        $rc = run_in( undef, @cpanm, mirror_only($spec), $spec );
    }
    else {
        return usage();
    }
    return $rc;
}

# --mirror-only, unless one of the specs needs a release older than the newest,
# which the mirror index does not list: see "Which release" above.
sub mirror_only {
    my @specs = @_;
    return ( grep { m{\@|~.*(?:<|!=|==)}aa } @specs ) ? () : ('--mirror-only');
}

sub usage {
    print {*STDERR} $USAGE;
    return 2;
}

# The bin directory of the perl to install into: the newest built under
# PERL_ROOT, which is how every other consumer on a guest finds it too.
sub perl_bin {
    my @built = sort glob("$PERL_ROOT/*/bin");
    die "cpan_install: nothing is built under $PERL_ROOT, so there is no perl to install into.  The perl recipe builds one; is it on this guest?\n"
      unless @built;
    return $built[-1];
}

# The two ways this touches anything outside itself, so that a test can stand
# in for both.  run_in answers with the exit code, capture_in with the exit code
# and then the lines.
sub run_in {
    my ( $dir, @cmd ) = @_;

    my $was = Cwd::getcwd();
    chdir $dir or die "cpan_install: cannot enter $dir: $!\n" if defined $dir;
    print "cpan_install: @cmd\n";
    system(@cmd);
    my $rc = exit_code($?);
    chdir $was if defined $dir;
    return $rc;
}

sub capture_in {
    my ( $dir, @cmd ) = @_;

    my $was = Cwd::getcwd();
    chdir $dir                 or die "cpan_install: cannot enter $dir: $!\n" if defined $dir;
    open( my $fh, '-|', @cmd ) or die "cpan_install: cannot run $cmd[0]: $!\n";                  ## no critic (ProhibitPipeOpen) -- reading what the child said is the whole point of this sub
    my @lines = <$fh>;

    # Unchecked on purpose: closing a pipe reports false whenever the child
    # exited nonzero, which is the outcome this sub exists to hand back rather
    # than die on.  The status it set is read out of $? on the next line.
    close $fh;    ## no critic (InputOutput::RequireCheckedSyscalls)
    my $rc = exit_code($?);
    chdir $was if defined $dir;
    return ( $rc, @lines );
}

# A finished child's $? as an exit code, the way a shell reports one: 127 for a
# command that never ran, and 128 plus the signal for one a signal killed --
# which $? >> 8 alone reports as a success.
sub exit_code {
    my ($status) = @_;

    return 127                     if $status == -1;
    return 128 + ( $status & 127 ) if $status & 127;
    return $status >> 8;
}

exit main(@ARGV) unless caller;

1;
