#!/usr/bin/perl

package Trog::Script::CpanInstall;

use 5.014;

use strict;
use warnings FATAL => 'all';

use Cwd          ();
use Getopt::Long ();

=head1 cpan_install

=head2 SYNOPSIS

    cpan_install [--notest] install SPEC [SPEC ...]
    cpan_install [--notest] installdeps DIR
    cpan_install [--notest] dzil DIR
    cpan_install [--notest] pin PKGCONFIG_PACKAGE MODULE
    cpan_install test DIR

=head2 DESCRIPTION

This script installs what recipes ask for from CPAN into the perl that the
C<perl> recipe built, and runs a checkout's tests against that perl.  The target of that recipe calls it once for each step of
its C<cpan_deps>.  The verbs are the names of those steps, and
L<Provisioner::Recipe::perl> documents them.

=over 4

=item * C<install> installs anything that cpm or cpanm takes in place of a
module name.  See L</Which installer>.

=item * C<installdeps> installs what the distribution in C<DIR> says it needs.

=item * C<dzil> installs what C<dzil authordeps> and then C<dzil listdeps> say
is missing in C<DIR>.  The order is necessary.  F<dist.ini> names plugins, and
dzil cannot read it to answer C<listdeps> until those plugins are installed.  If
dzil fails, the step fails.  A failure does not count as nothing missing.

=item * C<pin> installs C<MODULE> at the version that pkg-config reports for
C<PKGCONFIG_PACKAGE> when this runs.  C<Sys::Virt> is the reason for this verb.
Its version must match the C<libvirt> that it builds against.

=item * C<test> runs the tests in F<DIR/t> with the C<prove> of that perl, from
C<DIR> and with C<-l>.  It is here, and not in the caller, because only this
script knows which perl the dependencies went into.  A C<prove> from C<PATH>
is the system perl's, which has none of them.

=back

=head3 Which perl

The script uses the perl that F</opt/perl5/current> points at, which is the one
F<build_latest_perl.sh> built and the one the C<version> of the perl recipe
names.  A guest can hold more than one perl: a rebuild with another version
builds beside the first, because the path of a perl contains its version.

Without that link the script takes the newest perl under F</opt/perl5>, which
is what it always did, and is the same perl on a guest that has only one.

F<build_latest_perl.sh> installs cpanm into the perl it built, and then calls
this script for Module::Build and Dist::Zilla.

The system perl runs this script, so the script is written for it.

=head3 Which installer

cpm installs everything it can, because it builds several distributions at
once.  cpanm builds one at a time, and a perl with the dependencies of a web
application under it spent most of its build waiting on cpanm.

cpm cannot resolve a spec that excludes the newest release of a module, such as
C<< Moo~< 3 >>.  So cpanm installs each spec that can exclude it:
C<Module@version>, which is what C<pin> asks for, or a requirement that
contains C<==>, C<!=> or C<< < >>.  Those go first, in one run of cpanm, and
then cpm installs the rest.  If cpm fails, cpanm tries the same install again.
See C<cpm_then_cpanm>.  A pin such as the one for C<Sys::Virt> then comes
before anything that resolves dependencies, as it did when cpanm installed
everything.

The first time the script needs cpm, it installs C<App::cpm> with cpanm.  So
this script stays the one thing on a guest that gets modules from CPAN.

=head3 Which release

The script installs the release that the F<02packages.details.txt.gz> of the
mirror names.  cpm resolves through that index alone, with C<--resolver
02packages> and C<--no-default-resolvers>, and cpanm through it with
C<--mirror-only>.  Otherwise both ask cpanmetadb, which is a separate service.
cpanmetadb can name a release that the mirror no longer has.  cpanm then
reports that download as C<OK> and fails when it unpacks the empty file.  The
index of a mirror can be out of date, but it does not name a file that the
mirror does not have.

The specs that go to cpanm are the exception.  The index names only the newest
release of each module, so cpanm resolves those through MetaCPAN, without
C<--mirror-only>.

=head3 Whose checkout

A C<dzil> directory is a checkout that a recipe made and gave to its service
user.  This script runs as root.  When dzil plugins run git to answer
C<listdeps>, git refuses the checkout because another user owns it.  The script
trusts that directory as a C<safe.directory> only for the dzil commands it
runs there.  It sets this in the command-scope configuration of git, through
C<GIT_CONFIG_COUNT> and its pairs.  It does not write to any F<.gitconfig>.

=cut

# A variable, not a constant, so that t/cpan_install.t can point it at its own
# tree.
our $PERL_ROOT = '/opt/perl5';

# The mirror whose index says which release to install.
our $MIRROR = 'https://www.cpan.org';

my $USAGE = "usage: cpan_install [--notest] install|installdeps|dzil|pin|test ARGS\n";

sub main {
    my @args = @_;

    my %opt;
    Getopt::Long::GetOptionsFromArray( \@args, \%opt, 'notest' )
      or return usage();

    my ( $verb, @rest ) = @args;
    return usage() unless defined $verb;

    my $bin = perl_bin();

    my $rc = 0;
    if ( $verb eq 'install' && @rest ) {
        $rc = install_specs( $bin, \%opt, @rest );
    }
    elsif ( $verb eq 'installdeps' && @rest == 1 ) {

        # With no module named, cpm reads what the distribution in the
        # directory needs.  Its default also reads the develop phase, which
        # cpanm --installdeps leaves out, and which only an author needs.
        $rc = ensure_cpm($bin) || cpm_then_cpanm(
            $rest[0],
            [ cpm( $bin, \%opt ),   '--top-level-phase', 'configure,build,test,runtime' ],
            [ cpanm( $bin, \%opt ), qw{--mirror-only --installdeps .} ],
        );
    }
    elsif ( $verb eq 'dzil' && @rest == 1 ) {
        my ($dir) = @rest;

        # See "Whose checkout" above.
        local @ENV{qw{GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0}} = ( 1, 'safe.directory', $dir );
        foreach my $which (qw{authordeps listdeps}) {
            my ( $failed, @said ) = capture_in( $dir, "$bin/dzil", $which, '--missing' );
            if ($failed) {
                print {*STDERR} "cpan_install: dzil $which --missing exited $failed in $dir, so what it needs is not known\n";
                return $failed;
            }
            my @missing = grep { $_ } map { s/\s+\z//r } @said;
            next unless @missing;
            $rc = install_specs( $bin, \%opt, @missing ) and last;
        }
    }
    elsif ( $verb eq 'pin' && @rest == 2 ) {
        my ( $package, $module ) = @rest;
        my ( $failed,  @said )   = capture_in( undef, 'pkg-config', '--modversion', $package );
        my ($version) = map { s/\s+\z//r } @said;
        if ( $failed || !$version ) {
            print {*STDERR} "cpan_install: pkg-config knows no $package, so there is no $module version to pin\n";
            return 1;
        }
        $rc = install_specs( $bin, \%opt, "$module\@$version" );
    }
    elsif ( $verb eq 'test' && @rest == 1 ) {
        $rc = run_in( $rest[0], "$bin/prove", '-lvm', 't' );
    }
    else {
        return usage();
    }
    return $rc;
}

=head2 $rc = install_specs($bin, \%opt, @specs)

Installs C<@specs> into the perl in C<$bin>: with cpanm, each spec that can
exclude the newest release, and then with cpm, the others.  Returns the exit
code of the first install that fails, or 0.  See L</Which installer>.

=cut

sub install_specs {
    my ( $bin, $opt, @specs ) = @_;

    my @older  = grep { excludes_newest($_) } @specs;
    my @newest = grep { !excludes_newest($_) } @specs;

    if (@older) {
        my $rc = run_in( undef, cpanm( $bin, $opt ), @older );
        return $rc if $rc;
    }
    return 0 if !@newest;
    return ensure_cpm($bin) || cpm_then_cpanm( undef, [ cpm( $bin, $opt ), @newest ], [ cpanm( $bin, $opt ), '--mirror-only', @newest ] );
}

=head2 $rc = cpm_then_cpanm($dir, \@cpm, \@cpanm)

Runs C<@cpm> in C<$dir>, and C<@cpanm> there only if cpm fails.  Returns the
exit code of the last command that ran.

cpm builds every distribution before it installs any.  While it builds, a
distribution can load only what the distributions it depends on say they need.
Some distributions load a module that they do not declare, for example
C<Encode::Base2N> needs C<Alien::cmake3> through C<XS::libpanda>, and cpm fails
there.  cpanm installs each distribution as soon as it builds it, so the
undeclared module is installed by then.  C<--final-install all> has already
installed everything that cpm built, so cpanm has only the rest to do.

=cut

sub cpm_then_cpanm {
    my ( $dir, $cpm, $cpanm ) = @_;
    my $rc = run_in( $dir, @$cpm ) or return 0;
    print "cpan_install: cpm exited $rc, so cpanm tries the same, installing each distribution as it builds it\n";
    return run_in( $dir, @$cpanm );
}

=head2 @cmd = cpanm($bin, \%opt)

The cpanm of the perl in C<$bin>, without the specs, with C<--notest> when
C<$opt{notest}>.

=cut

sub cpanm {
    my ( $bin, $opt ) = @_;
    return ( "$bin/cpanm", ( $opt->{notest} ? '--notest' : () ) );
}

=head2 $bool = excludes_newest($spec)

Whether C<$spec> can ask for a release other than the newest: a C<Module@version>,
or a requirement with C<==>, C<!=> or C<< < >> in it.  The index of a mirror
names only the newest release.

=cut

sub excludes_newest {
    my ($spec) = @_;
    return $spec =~ m{\@|~.*(?:<|!=|==)}aa ? 1 : 0;
}

=head2 @flags = mirror_only(@specs)

Returns C<--mirror-only>, or an empty list if one of C<@specs> excludes the
newest release.  cpanm takes the flags, where F<bin/new_config> writes the line
of the makefile that installs C<testdeps> with the cpanm of the system.  See
L</Which release>.

=cut

sub mirror_only {
    my @specs = @_;
    return ( grep { excludes_newest($_) } @specs ) ? () : ('--mirror-only');
}

=head2 @cmd = cpm($bin, \%opt)

The cpm command that installs into the perl in C<$bin>, without the specs.
Tests run unless C<$opt{notest}>, because cpm skips them unless asked.  The log
of a build that fails goes to the output, where the setup log keeps it.  cpm
installs every distribution that it built, not only the runtime dependencies of
what was asked for, so that a fallback to cpanm finds them installed.

=cut

sub cpm {
    my ( $bin, $opt ) = @_;
    return (
        "$bin/perl",          "$bin/cpm", qw{install --global --final-install all --no-color --progress plain --show-build-log-on-failure --resolver},
        "02packages,$MIRROR", '--no-default-resolvers', ( $opt->{notest} ? () : '--test' ),
    );
}

=head2 $rc = ensure_cpm($bin)

Installs C<App::cpm> into the perl in C<$bin> with cpanm, unless that perl has
cpm already.  Returns the exit code of cpanm, or 0.

=cut

sub ensure_cpm {
    my ($bin) = @_;
    return 0 if -e "$bin/cpm";
    return run_in( undef, "$bin/cpanm", qw{--notest --mirror-only App::cpm} );
}

sub usage {
    print {*STDERR} $USAGE;
    return 2;
}

=head2 $dir = perl_bin()

Returns the F<bin> directory of the perl to install into: the one that
C<$PERL_ROOT/current> points at, or the newest under C<$PERL_ROOT> when there
is no such link.  See L</Which perl>.  Dies if no perl is built there.

=cut

sub perl_bin {
    my $named = "$PERL_ROOT/current/bin";
    return $named if -d $named;

    my @built = sort grep { index( $_, "$PERL_ROOT/current/" ) != 0 } glob("$PERL_ROOT/*/bin");
    die "cpan_install: nothing is built under $PERL_ROOT, so there is no perl to install into.  The perl recipe builds one; is it on this guest?\n"
      unless @built;
    return $built[-1];
}

=head2 $rc = run_in($dir, @cmd)

Runs C<@cmd> in C<$dir>, or in the current directory if C<$dir> is undef.
Returns its exit code, as C<exit_code> gives it.  Dies if it cannot enter
C<$dir>.

This sub and C<capture_in> are the only ways the script touches anything
outside itself, so that a test can replace both.

=cut

sub run_in {
    my ( $dir, @cmd ) = @_;

    my $was = Cwd::getcwd();
    chdir $dir or die "cpan_install: cannot enter $dir: $!\n" if defined $dir;
    print "cpan_install: @cmd\n";
    system(@cmd);
    my $rc = exit_code($?);
    chdir $was if defined $dir;
    return $rc;
}

=head2 ($rc, @lines) = capture_in($dir, @cmd)

Runs C<@cmd> in C<$dir>, or in the current directory if C<$dir> is undef.
Returns its exit code, and then the lines it wrote to standard output.  Dies if
it cannot enter C<$dir> or cannot start C<@cmd>.

=cut

sub capture_in {
    my ( $dir, @cmd ) = @_;

    my $was = Cwd::getcwd();
    chdir $dir                 or die "cpan_install: cannot enter $dir: $!\n" if defined $dir;
    open( my $fh, '-|', @cmd ) or die "cpan_install: cannot run $cmd[0]: $!\n";                  ## no critic (ProhibitPipeOpen) -- reading what the child said is the whole point of this sub
    my @lines = <$fh>;

    # Unchecked, because close is false for any nonzero exit, which this sub
    # returns instead of dying on.
    close $fh;    ## no critic (InputOutput::RequireCheckedSyscalls)
    my $rc = exit_code($?);
    chdir $was if defined $dir;
    return ( $rc, @lines );
}

=head2 $rc = exit_code($status)

Returns the C<$?> of a finished child as a shell reports it.  A command that
did not run gives 127.  A command that a signal killed gives 128 plus the signal
number, because C<<< $? >> 8 >>> alone reports that as success.

=cut

sub exit_code {
    my ($status) = @_;

    return 127                     if $status == -1;
    return 128 + ( $status & 127 ) if $status & 127;
    return $status >> 8;
}

exit main(@ARGV) unless caller;

1;
