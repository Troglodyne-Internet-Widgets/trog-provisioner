#!/usr/bin/perl

use 5.014;

use strict;
use warnings FATAL => 'all';

=head1 setup-ufw-rules

=head2 SYNOPSIS

    setup-ufw-rules [--dry-run]

=head2 DESCRIPTION

Reset ufw and allow every application profile that C<ufw app list> shows, in
and out.  A recipe declares a profile to say that this guest uses a port.  The
default denies outgoing traffic, so the C<allow out> is the only rule that lets
the guest send on that port.

With C<--dry-run>, ufw prints the reset, the defaults and the profile rules and
does not apply them.  The script still deletes old limits and applies the fixed
port ranges.

This script does not rate limit.  See C<setup-ufw-ratelimits>, which gets the
limits and the networks that are exempt from them.

=cut

my $DRY_RUN = ( grep { $_ eq '--dry-run' } @ARGV ) ? 1 : 0;

my $list = qx{ufw app list};
my @apps = split( /\n/, $list );
shift @apps;
s/^\s+// for @apps;

# --force, because `ufw reset` prompts, and a provision has no terminal.
# Without it, the reset reads EOF and aborts.
#
# The reset also restores /etc/ufw/before.rules from /usr/share/ufw.
# setup-port-forwards, setup-ufw-ratelimits and setup-masquerade write to that
# file, so they must run after this script.  templates/makefile.tt explains
# the order.
my @rules = (
    [qw{--force reset}],
    [qw{enable}],
    [qw{default deny outgoing}],
    [qw{default deny incoming}],
);

# Allow, and do not limit.  setup-ufw-ratelimits writes the limits and
# explains why ufw's own `limit` is not used.

foreach my $app (@apps) {

    # Delete any limit that an older provision left on this profile.  ufw keys
    # a rule on its action and its ports, so an allow does not replace a limit.
    # Usually there is no limit, and the delete fails.
    system( qw{ufw --force delete limit in},  $app );
    system( qw{ufw --force delete limit out}, $app );

    push( @rules, [ "allow", "out", $app ] );
    push( @rules, [ "allow", "in",  $app ] );
}

@rules = map { unshift( @{$_}, '--dry-run' ); $_ } @rules if $DRY_RUN;
@rules = map { unshift( @{$_}, 'ufw' );       $_ } @rules;

foreach my $rule (@rules) {
    system(@$rule);
}

# Allow the ports that Linux gives to outgoing connections, so that the guest
# can use outgoing ssh and similar.
system(qw{ufw allow out 32768:61000/tcp});
system(qw{ufw allow out 32768:61000/udp});
system(qw{ufw allow in 32768:61000/tcp});
system(qw{ufw allow in 32768:61000/udp});

# Allow DHCP for IPv4 and IPv6.
system(qw{ufw allow out 67:68/udp});
system(qw{ufw allow in 67:68/udp});
system(qw{ufw allow out 546:547/udp});
system(qw{ufw allow in 546:547/udp});
