#!/usr/bin/perl

package Trog::Script::SetupMasquerade;

use 5.014;

use strict;
use warnings FATAL => 'all';

=head1 setup-masquerade

=head2 SYNOPSIS

    setup-masquerade 10.8.0.0/24=eth0 [10.9.0.0/24 ...]

=head2 DESCRIPTION

Edits C</etc/ufw/before.rules> so that the guest forwards and masquerades a VPN
subnet, for each C<SUBNET> or C<SUBNET=INTERFACE> given.  A second run with the
same arguments changes nothing.

It writes two rules, because either one alone routes nothing.  A packet from a
VPN client goes through routing, then the filter FORWARD chain, and then nat
POSTROUTING.  So if the forward policy is DROP, no packet gets to a MASQUERADE
rule.  Ubuntu ships C</etc/default/ufw> with C<DEFAULT_FORWARD_POLICY="DROP">,
and every guest here has that file.  So this writes:

=over 4

=item * C<*nat> POSTROUTING MASQUERADE, so the traffic of a client leaves with
the address of the guest.

=item * C<*filter> C<ufw-before-forward> ACCEPTs for the subnet, so the traffic
gets that far.  One goes out of the subnet, and one comes back into it for
connections that are already established.

=back

The forward ACCEPTs name the subnet.  The script does not set
C<DEFAULT_FORWARD_POLICY="ACCEPT">, because then the guest routes anything for
anybody.  It is a VPN, not a router.

If you do not give C<INTERFACE>, the script uses the interface of the default
route of the guest.  It asks the guest when it writes the rule.  The name is a
fact about the guest, for example C<ens3>, C<enp1s0> or C<eth0>, and the
configuration on the hypervisor cannot know it.  If the guest has no default
route, the script dies and does not skip the rule.

The app rules of ufw cannot express either kind of rule.  So, as
C<setup-port-forwards> does, this script edits C</etc/ufw/before.rules> between
markers.  A second run replaces what the first run wrote and does not add to
it.  So a subnet that changed does not leave its old rules behind.  The script
also removes a MASQUERADE rule for a named subnet that is B<not> between the
markers, so the file does not hold two.  It leaves masquerades for other
subnets alone.

If the C<ufw> service is active, the script applies the rules with
C<ufw reload>.

=cut

# The file that ufw reads its rules from.  It is our, so a test can point it at
# a file that is not the firewall of the test machine.
our $FILE = '/etc/ufw/before.rules';

# The MASQUERADE rules go in a chain of our own and not straight into
# POSTROUTING.  ufw reloads with `iptables-restore --noflush`, which flushes a
# user chain that the input declares but never a built-in chain.  So each reload
# adds another copy of a rule in POSTROUTING, but replaces a rule in our chain.
our $NAT_CHAIN = 'trog-nat';

my %MARKS = (
    nat    => [ '# BEGIN trog-provisioner masquerade',     '# END trog-provisioner masquerade' ],
    filter => [ '# BEGIN trog-provisioner vpn forwarding', '# END trog-provisioner vpn forwarding' ],
);

# $text without the block that the last run wrote between the markers for
# $which (nat or filter), wherever it is in the file.
my $drop_block = sub {
    my ( $text,  $which ) = @_;
    my ( $begin, $end )   = @{ $MARKS{$which} };

    $text =~ s/^\Q$begin\E\n.*?^\Q$end\E\n//ms;
    return $text;
};

# $text with @rules between the markers for $table, directly before the COMMIT
# of that table, so that the loopback, ICMP and conntrack rules of ufw come
# first.  Undef if $text has no such table: the caller decides what that means.
my $insert_before_commit = sub {
    my ( $text, $table, @rules ) = @_;
    my ( $begin, $end ) = @{ $MARKS{$table} };

    my @out;
    my ( $inside, $done ) = ( 0, 0 );
    foreach my $line ( split( /\n/, $text, -1 ) ) {
        $inside = 1 if $line =~ m/^[*]\Q$table\E\b/;
        if ( $inside && !$done && $line eq 'COMMIT' ) {
            push( @out, $begin, @rules, $end );
            ( $inside, $done ) = ( 0, 1 );
        }
        push( @out, $line );
    }

    return unless $done;
    return join( "\n", @out );
};

exit main(@ARGV) unless caller;

sub main {
    my (@args) = @_;
    return 0 unless @args;

    open( my $fh, '<', $FILE ) or die "Cannot read $FILE: $!\n";
    my $content = do { local $/; <$fh> };
    close($fh) or die "Cannot close $FILE: $!\n";

    my ( @nat, @filter, @subnets );
    foreach my $arg (@args) {
        my ( $subnet, $iface ) = split( /=/, $arg, 2 );
        die "Bad arg '$arg' (expected SUBNET/MASK or SUBNET/MASK=INTERFACE)\n"
          unless $subnet;

        # The interface of the default route.  A guest can have more than one,
        # for example a NAT management interface and a bridged one, and ip
        # lists them in the order that the kernel picks them, so the first one
        # is the route that traffic takes.
        if ( !$iface ) {
            my ($route) = grep { m/\bdev\s+\S+/ } split( /\n/, qx{ip -4 route show default 2>/dev/null} );
            ($iface) = ( $route // q{} ) =~ m{\bdev\s+(\S+)};

            die "No interface given and this guest has no default route to infer one from; name one in the recipe's 'interface'\n"
              unless $iface;
        }

        push( @subnets, $subnet );
        push( @nat,     "-A $NAT_CHAIN -s $subnet -o $iface -j MASQUERADE" );

        # Not bound to the interface, as the MASQUERADE rule is.  Traffic from
        # one client to another on the same VPN goes back out the tun device.
        # A rule that names the egress interface drops that traffic.
        push( @filter, "-A ufw-before-forward -s $subnet -j ACCEPT" );

        # The return path.  The before.rules of ufw already accepts
        # RELATED,ESTABLISHED for everything, so this rule adds nothing today.
        # It keeps the pair complete if ufw stops shipping that line.
        push( @filter, "-A ufw-before-forward -d $subnet -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT" );
    }

    my $original = $content;

    # The forward ACCEPTs of the last run, replaced by these, in the *filter
    # table that the before.rules of ufw declares.
    $content = $drop_block->( $content, 'filter' );
    if (@filter) {
        $content = $insert_before_commit->( $content, 'filter', @filter );
        die "Found no *filter block to add forwarding rules to in $FILE\n" unless defined $content;
    }

    # The MASQUERADE rules of the last run, replaced by these.  Also each rule
    # for one of these subnets that is straight in POSTROUTING, where an older
    # version of this script wrote it.  Only these subnets, so a masquerade
    # that somebody added by hand for another subnet stays.
    $content = $drop_block->( $content, 'nat' );
    foreach my $subnet (@subnets) {
        $content =~ s{^-A POSTROUTING -s \Q$subnet\E -o \S+ -j MASQUERADE\n}{}mg;
    }

    if (@nat) {

        # The jump is the only rule that must be in POSTROUTING, and there is
        # one jump for all subnets.
        my @rules  = ( "-A POSTROUTING -j $NAT_CHAIN", @nat );
        my $placed = $insert_before_commit->( $content, 'nat', @rules );

        # iptables-restore reads a table from top to bottom and refuses a rule
        # that names a chain it did not see declared, so the declaration goes
        # directly under *nat.  Once, because it refuses a chain declared twice
        # in one table, and then ufw does not start.
        if ( defined $placed ) {
            $placed =~ s/^([*]nat\n)/$1:$NAT_CHAIN - [0:0]\n/m unless $placed =~ m/^:\Q$NAT_CHAIN\E /m;
            $content = $placed;
        }

        # ufw does not ship a *nat table, so make one directly before the
        # *filter table, which is where a nat table must go.  Never a second
        # one: iptables-restore refuses a table declared twice.
        else {
            my ( $begin, $end ) = @{ $MARKS{nat} };
            my $block = "*nat\n" . ":POSTROUTING ACCEPT [0:0]\n" . ":$NAT_CHAIN - [0:0]\n" . join( "\n", $begin, @rules, $end ) . "\n" . "COMMIT\n\n";

            $content .= "\n$block" unless $content =~ s/^([*]filter\b)/$block$1/m;
        }
    }

    return 0 if $content eq $original;

    open( my $out, '>', $FILE ) or die "Cannot write $FILE: $!\n";
    print {$out} $content;
    close($out) or die "Cannot write $FILE: $!\n";

    print 'Wrote ' . scalar(@nat) . ' masquerade and ' . scalar(@filter) . " forwarding rule(s) to $FILE\n";

    # A reload only if ufw is active, and a failed one is a warning, not the
    # end of the run.
    my $status = qx{ufw status 2>/dev/null};
    if ( $status =~ m/Status:\s*active/ ) {
        system( 'ufw', 'reload' ) == 0 or warn "ufw reload failed: $?\n";
    }

    return 0;
}

1;
