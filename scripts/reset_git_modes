#!/bin/bash

# Put back the file modes that git tracks, in a checkout, and touch nothing else.
#
#     reset_git_modes <checkout>
#
# The data target of a guest that was built before it used u=rwX,g=rX,o= made
# every file executable.  The salvage keeps that, and the rsync brings it back
# onto the next guest.  git tracks the execute bit, so each file that git
# records as 100644 then shows as modified, though no content changed.
#
# `git checkout -- .` would fix the modes, and would also throw away every
# change of content.  A checkout of a recipe is the live site, and somebody
# edits it.  So this script resets only a file whose mode is the whole
# difference: it hashes the file, and when that is the blob that the index
# holds, it sets the mode that the index records.  A file with a change of
# content stays as it is, whatever its mode.
#
# It declines (does nothing and exits 0) when the directory is absent, is not
# a checkout, or is clean.  A first build has no checkout until the fragment
# clones one, and a clone has the right modes.

set -uo pipefail

CHECKOUT="${1:?usage: reset_git_modes <checkout>}"

[ -e "$CHECKOUT/.git" ] || exit 0

# root runs this over files that another account owns, so git needs the
# directory marked safe, and a HOME to read.  Neither is written to the
# configuration of an account.
export HOME="${HOME:-$CHECKOUT}"
GIT=(git -c "safe.directory=$CHECKOUT" -C "$CHECKOUT")

# --raw -z gives  :<old mode> <new mode> <old blob> <new blob> <status> NUL <path> NUL
# The old side is the index, so the old mode is the one to put back.
"${GIT[@]}" diff --raw --no-abbrev -z --diff-filter=M 2>/dev/null | while IFS=' ' read -r -d '' meta; do
    IFS= read -r -d '' path || break
    read -r old_mode new_mode old_blob _ <<<"$meta"
    old_mode="${old_mode:1}"
    case "$old_mode/$new_mode" in
        100644/100755 | 100755/100644) ;;
        *) continue ;;
    esac
    [ "$("${GIT[@]}" hash-object -- "$path" 2>/dev/null)" = "$old_blob" ] || continue
    if [ "$old_mode" = 100755 ]; then
        chmod u+x,g+x -- "$CHECKOUT/$path"
    else
        chmod a-x -- "$CHECKOUT/$path"
    fi
done

exit 0
