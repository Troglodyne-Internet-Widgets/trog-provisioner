#!/usr/bin/perl

package Trog::EdgeClient;

use 5.014;

use strict;
use warnings FATAL => 'all';

use Cwd            ();
use Fcntl          qw{:flock};
use File::Basename ();
use File::Temp     ();
use IPC::Open3     ();
use List::Util     qw{any};
use MIME::Base64   ();

=head1 edge_client

=head2 SYNOPSIS

    edge_client register DOMAIN TLS_UPSTREAM HTTP_UPSTREAM NAME [NAME ...]
    edge_client release DOMAIN

=head2 DESCRIPTION

Runs as root on an edge guest, for another guest whose C<nginx> names this one
as its C<edge>.  See L<Provisioner::Recipe::edge>.

C<register> sends each NAME to DOMAIN: a TLS connection by its SNI name to
TLS_UPSTREAM, and a plain HTTP request by its C<Host> header to HTTP_UPSTREAM.
An upstream is an IPv4 address and a port, such as C<192.0.2.10:8443>.  It
replaces what DOMAIN registered before.  It refuses a NAME that another domain
registered, because nginx would send that name to only one of them.  If
C<nginx -t> refuses the result, it puts the old files of DOMAIN back.

Then it makes a new key for DOMAIN, and prints the private half in base64 on
one line, after all of that worked.  The guest of DOMAIN pushes its bans to
this guest with that key.  The public half goes into
F<authorized_keys.root>, which sshd reads beside the keys of root.  It can run
only F<edge_ban> for DOMAIN, and only from the address of TLS_UPSTREAM, which
is the address of the guest.  See F<scripts/edge_ban>.

C<release> removes everything that DOMAIN registered, its key included.  Any of
it can be gone already.

It exits 0 when it did that.  When a step fails, it says which, and exits
with another status.

=cut

my $USAGE = "usage: edge_client register DOMAIN TLS_UPSTREAM HTTP_UPSTREAM NAME [NAME ...]
" . "       edge_client release DOMAIN
";

our $EDGE_D = '/etc/nginx/edge.d';

# Beside this script, as every script of the provisioner is.
our $EDGE_BAN = File::Basename::dirname( Cwd::abs_path(__FILE__) ) . '/edge_ban';

# A name of the DNS, in lower case.  Each one goes into a file that nginx reads.
sub dns_name {
    my ($name) = @_;
    return defined $name && $name =~ m/\A[[:lower:][:digit:]-]+(?:[.][[:lower:][:digit:]-]+)+\z/ ? 1 : 0;
}

sub upstream {
    my ($upstream) = @_;
    my $octet = qr/[[:digit:]]{1,3}/;
    return defined $upstream && $upstream =~ m/\A$octet(?:[.]$octet){3}:[[:digit:]]{1,5}\z/ ? 1 : 0;
}

# Every command this runs, as the one thing a test stands in for.  A list, so
# no shell reads it.  Answers the output and whether it succeeded.  The output
# holds its standard error as well, so that nothing but the key reaches the
# output of this script: bin/provision reads it over ssh on a pty, which joins
# the two streams.
sub run {
    my (@command) = @_;

    my $pid = IPC::Open3::open3( my $in, my $out, undef, @command );
    close $in or die "Could not close the input of @command: $!\n";
    my $output = do { local $/ = undef; <$out> }
      // q{};
    waitpid( $pid, 0 );

    return ( $output, $? == 0 ? 1 : 0 );
}

# The files of $domain: the map of each port, and the public half of its key.
sub files_of {
    my ($domain) = @_;
    return ( tls => "$EDGE_D/$domain.tls.map", http => "$EDGE_D/$domain.http.map", key => "$EDGE_D/$domain.ban.pub" );
}

# The content of $file, or undef where there is no file.
sub read_file {
    my ($file) = @_;

    open( my $fh, '<', $file ) or return;
    my $content = do { local $/ = undef; <$fh> };
    close $fh or die "Cannot read $file: $!\n";
    return $content;
}

# Replaces $file with $content, through a file beside it, so that nginx never
# reads half of it, or removes $file when $content is undef.
sub write_file {
    my ( $file, $content ) = @_;

    if ( !defined $content ) {
        unlink $file or $!{ENOENT} or die "Cannot remove $file: $!\n";
        return;
    }

    # open keeps the mode of a file that exists, such as one a failed run left.
    unlink "$file.new";
    my $umask  = umask oct 22;
    my $opened = open( my $fh, '>', "$file.new" );
    umask $umask;
    $opened or die "Cannot write $file.new: $!\n";
    print {$fh} $content;
    close $fh                    or die "Cannot write $file.new: $!\n";
    rename( "$file.new", $file ) or die "Cannot replace $file: $!\n";
    return;
}

# The keys of every domain, in the one file that sshd reads for root.  Only a
# line that restricts its key, so that a bare key never logs in as root.
sub write_authorized_keys {
    my @lines = grep { m/\Arestrict,/ } map { split( m/^/m, read_file($_) // q{} ) } sort glob("$EDGE_D/*.ban.pub");
    write_file( "$EDGE_D/authorized_keys.root", join( q{}, @lines ) );
    return;
}

# Held until the caller closes it, so that two guests that register at one
# time do not both take a name.
sub lock_edge {
    my $lock = "$EDGE_D/.lock";
    open( my $fh, '>>', $lock ) or die "Cannot open $lock: $!\n";
    flock( $fh, LOCK_EX )       or die "Cannot lock $lock: $!\n";
    return $fh;
}

# Each name that a domain other than $domain registered, mapped to that domain.
sub names_of_others {
    my ($domain) = @_;

    my %holder;
    foreach my $map ( glob("$EDGE_D/*.tls.map") ) {
        my ($other) = $map =~ m{/([^/]+)[.]tls[.]map\z};
        next if $other eq $domain;
        $holder{$_} = $other foreach map { m/\A(\S+)\s/ ? $1 : () } split m/\n/, read_file($map) // q{};
    }
    return %holder;
}

sub reload_nginx {
    my ( $said, $ok ) = run(qw{systemctl reload nginx});
    die "nginx did not reload: $said\n" unless $ok;
    return;
}

sub register {
    my ( $domain, $tls, $http, @names ) = @_;

    my $lock   = lock_edge();
    my %holder = names_of_others($domain);
    my @taken  = grep { defined $holder{$_} } @names;
    die join( q{}, map { "$_ is registered to $holder{$_}\n" } @taken ) . "So $domain cannot register it.  Release it there first.\n" if @taken;

    my $dir = File::Temp::tempdir( CLEANUP => 1 );
    ## no critic (PreferredBinaries) -- this runs under the system perl of the edge, which has no Provisioner::Utils
    my ( $said, $ok ) = run( qw{ssh-keygen -q -t ed25519 -N}, q{}, '-C', "bans of $domain", '-f', "$dir/key" );
    ## use critic
    die "Could not make the key of $domain: $said\n" unless $ok;

    my %file = files_of($domain);
    my %old  = map { $_ => scalar read_file( $file{$_} ) } qw{tls http};
    write_file( $file{tls},  join( q{}, map { "$_ $tls;\n" } @names ) );
    write_file( $file{http}, join( q{}, map { "$_ $http;\n" } @names ) );

    ( $said, $ok ) = run(qw{nginx -t});
    if ( !$ok ) {
        write_file( $file{$_}, $old{$_} ) foreach qw{tls http};
        die "nginx refused what $domain registered, so it keeps what it had: $said\n";
    }

    my ($address) = split( m/:/, $tls );
    write_file( $file{key}, qq{restrict,from="$address",command="$EDGE_BAN $domain" } . read_file("$dir/key.pub") );
    write_authorized_keys();
    reload_nginx();

    print MIME::Base64::encode_base64( read_file("$dir/key"), q{} );
    close $lock or die "Cannot unlock $EDGE_D: $!\n";
    return 0;
}

sub release {
    my ($domain) = @_;

    my $lock = lock_edge();
    my %file = files_of($domain);
    write_file( $_, undef ) foreach values %file;
    write_authorized_keys();

    # An nginx that is not up reads the files when it starts.
    my $err = do {
        local $@;
        eval { reload_nginx(); 1 } ? undef : $@;
    };
    warn $err if defined $err;
    close $lock or die "Cannot unlock $EDGE_D: $!\n";
    return 0;
}

sub main {
    my ( $command, $domain, @args ) = @_;

    die $USAGE unless defined $command && dns_name($domain);

    if ( $command eq 'register' ) {
        my ( $tls, $http, @names ) = @args;
        die $USAGE unless upstream($tls) && upstream($http) && @names;
        die $USAGE if any { !dns_name($_) } @names;
        return register( $domain, $tls, $http, @names );
    }
    return release($domain) if $command eq 'release' && !@args;
    die $USAGE;
}

exit main(@ARGV) unless caller;

1;
