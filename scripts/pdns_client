#!/usr/bin/perl

package Trog::PdnsClient;

use 5.014;

use strict;
use warnings FATAL => 'all';

use IPC::Open3 ();
use List::Util qw{any};

=head1 pdns_client

=head2 SYNOPSIS

    pdns_client issue NAME NAMESERVER
    pdns_client release NAME
    pdns_client forwards
    pdns_client grant ZONE CLIENT NAME [NAME ...]
    pdns_client revoke ZONE CLIENT

=head2 DESCRIPTION

Runs as root on a pdns guest, for another guest that names this one as the
C<authority> of its registrar.  See L<Provisioner::Recipe::registrar>.

C<issue> deletes the zone NAME and the token labeled NAME, if a build before
this one made them.  Then it makes the zone through the API on its socket, with
NAMESERVER as its nameserver, and a token that can write NAME and every name
below it.  It has the recursor of this guest forward NAME to the
authoritative server, with a negative trust anchor, as it does the zone of the
domain.  It prints the token, and only after all of that worked.  So each
build of the other guest starts from an empty zone, and its old token stops
working.

The recursor needs the forward for a NAME outside the zone of this guest.
Without it, the recursor asks the internet for NAME, and under a reserved TLD
the internet has no such name.  The CA of this guest checks a challenge through
the recursor, so it never finds the challenge of the other guest, and the
order of the certificate never ends.

C<release> deletes the zone and the token, and the forward.  Any of them can be
gone already.

C<forwards> writes the forward and the trust anchor of each zone in the
database.  Each zone keeps one of each, however often it runs.  The build of this guest
runs it before it starts the recursor, because the database comes back from the
salvage of the guest before it, and the recursor configuration does not.

C<grant> is for a zone that this guest builds itself, because an account of
the registrar names it as the C<authority> of that zone.  Several guests can
serve names in one such zone, so it leaves the zone alone.  It replaces the
token of CLIENT in ZONE with one that can write the C<A> and C<CNAME> records
of each NAME, and the C<TXT> record of its C<_acme-challenge>, and nothing
else.  It prints the token.  It refuses a NAME outside ZONE, and a ZONE that
this guest does not hold.

C<revoke> deletes the token of CLIENT in ZONE.  It can be gone already.

It exits 0 when it did that, and 1 when a step failed, after it says which.

=cut

my $USAGE = "usage: pdns_client issue NAME NAMESERVER
" . "       pdns_client release NAME
" . "       pdns_client forwards
" . "       pdns_client grant ZONE CLIENT NAME [NAME ...]
" . "       pdns_client revoke ZONE CLIENT
";

our $API_SOCKET = '/var/spool/powerdns/api.sock';
our $API_CONF   = '/etc/powerdns/pdns.d/api.conf';
our @ACL        = qw{runuser -u pdns -- /opt/perl5/current/bin/perl /opt/perl5/current/bin/pdns-acl};
our $ZONES_DB   = '/var/spool/powerdns/zones.db';
our $FORWARDS   = '/etc/powerdns/forward-zones';
our $ANCHORS    = '/etc/powerdns/recursor.lua';
our $AUTH       = '127.0.0.1:2500';

# A name of the DNS, in lower case.  Each one goes into the path of a request
# and into the arguments of pdns-acl.
sub dns_name {
    my ($name) = @_;
    return defined $name && $name =~ m/\A[[:lower:][:digit:]-]+(?:[.][[:lower:][:digit:]-]+)+\z/ ? 1 : 0;
}

# Every command this runs, as the one thing a test stands in for.  A list, so
# no shell reads it.  $input goes to its standard input.  Answers the output and
# whether it succeeded.  The output holds its standard error as well, so that
# nothing but the token reaches the output of this script: bin/provision reads
# it over ssh on a pty, which joins the two streams.
sub run {
    my ( $command, $input ) = @_;

    my $pid = IPC::Open3::open3( my $in, my $out, undef, @{$command} );
    print {$in} $input // q{};
    close $in or die "Could not give @{$command} its input: $!\n";
    my $output = do { local $/ = undef; <$out> }
      // q{};
    waitpid( $pid, 0 );

    return ( $output, $? == 0 ? 1 : 0 );
}

# The key of the API, which only root can read on this guest.
sub api_key {
    open( my $fh, '<', $API_CONF ) or die "Cannot read $API_CONF: $!\n";
    my @lines = <$fh>;
    close $fh or die "Cannot read $API_CONF: $!\n";

    foreach my $line (@lines) {
        return $1 if $line =~ m/\Aapi-key=(\S+)/;
    }
    die "$API_CONF names no api-key\n";
}

# A request to the API on its socket.  The key goes to curl on its standard
# input, so it is not on a command line, which every user of the guest can read.
sub api {
    my ( $method, $path, $body ) = @_;

    my @curl = ( qw{curl -sf --unix-socket}, $API_SOCKET, qw{-H @- -X}, $method );
    push( @curl, '--data', $body ) if defined $body;
    push( @curl, "http://localhost/api/v1/servers/localhost/$path" );

    return run( \@curl, 'X-API-Key: ' . api_key() . "\n" );
}

sub acl {
    my (@args) = @_;
    return run( [ @ACL, @args ] );
}

# The lines of $file, or none where there is no file.
sub lines_of {
    my ($file) = @_;

    open( my $fh, '<', $file ) or return ();
    my @lines = <$fh>;
    close $fh or die "Cannot read $file: $!\n";
    chomp @lines;
    return @lines;
}

# Replaces $file with @lines, through a file beside it, so that the recursor
# never reads half of it.  The file is 644, and keeps its owner and group.
sub write_lines {
    my ( $file, @lines ) = @_;

    my ( $uid, $gid ) = ( stat $file )[ 4, 5 ];

    # open keeps the mode of a file that exists, such as one a failed run left.
    unlink "$file.new";
    my $umask  = umask oct 22;
    my $opened = open( my $fh, '>', "$file.new" );
    umask $umask;
    $opened or die "Cannot write $file.new: $!\n";
    print {$fh} map { "$_\n" } @lines;
    close $fh                        or die "Cannot write $file.new: $!\n";
    chown( $uid, $gid, "$file.new" ) or die "Cannot set the owner of $file.new: $!\n" if defined $uid;
    rename( "$file.new", $file )     or die "Cannot replace $file: $!\n";
    return;
}

# Has the recursor forward $name to the authoritative server, with a negative
# trust anchor, or not.  One of each, in the form of the lines of the zone of
# the domain.  A forward of $name elsewhere, which forward_zones writes, stays.
sub set_forwarded {
    my ( $name, $on ) = @_;

    my $forward  = "$name=$AUTH";
    my @forwards = grep { $_ ne $forward } lines_of($FORWARDS);
    write_lines( $FORWARDS, @forwards, $on ? $forward : () );

    my @anchors = grep { index( $_, qq{addNTA("$name"} ) != 0 } lines_of($ANCHORS);
    write_lines( $ANCHORS, @anchors, $on ? qq{addNTA("$name", "unsigned zone, served by the authoritative half on $AUTH")} : () );
    return;
}

# The running recursor reads both files again.
sub reload_recursor {
    foreach my $what (qw{reload-zones reload-lua-config}) {
        my ( $said, $ok ) = run( [ 'rec_control', $what ] );
        die "The recursor did not $what: $said\n" unless $ok;
    }
    return;
}

sub forwards {
    my ( $names, $ok ) = run( [ 'sqlite3', '-batch', $ZONES_DB, 'SELECT name FROM domains' ] );
    die "Could not read the zones of $ZONES_DB: $names\n" unless $ok;

    my %held = map { $_ => 1 } grep { dns_name($_) } map { lc s/[.]\z//r } split m/\n/, $names;
    set_forwarded( $_, 1 ) foreach sort keys %held;
    return 0;
}

# The zone and the token, which either can be gone already.
sub drop {
    my ($name) = @_;

    acl( qw{token remove}, $name );
    api( 'DELETE', "zones/$name." );
    return;
}

sub release {
    my ($name) = @_;

    drop($name);
    set_forwarded( $name, 0 );

    # A recursor that is not up reads the files when it starts.
    my $err = do {
        local $@;
        eval { reload_recursor(); 1 } ? undef : $@;
    };
    warn $err if defined $err;
    return 0;
}

sub issue {
    my ( $name, $nameserver ) = @_;

    drop($name);

    my ( $said, $ok ) = api( 'POST', 'zones', qq[{"name": "$name.", "kind": "Native", "nameservers": ["$nameserver."]}] );
    die "Could not make the zone $name: $said\n" unless $ok;

    my $token;
    ( $token, $ok ) = acl( qw{token add}, $name, '--zone', "$name.", '--name', "$name.", '--write' );
    die "Could not make the token of $name: $token\n" unless $ok;

    ( $said, $ok ) = acl( qw{grant add}, $name, '--zone', "$name.", '--name', "*.$name.", '--write' );
    die "Could not let the token of $name write the names below it: $said\n" unless $ok;

    set_forwarded( $name, 1 );
    reload_recursor();

    print $token;
    return 0;
}

# The label of the token of $client in $zone.  One per pair, so that two
# clients of one zone do not replace the token of each other.
sub label_of {
    my ( $zone, $client ) = @_;
    return "$zone for $client";
}

sub revoke {
    my ( $zone, $client ) = @_;

    acl( qw{token remove}, label_of( $zone, $client ) );
    return 0;
}

sub grant {
    my ( $zone, $client, @names ) = @_;

    my @outside = grep { $_ ne $zone && !m/[.]\Q$zone\E\z/ } @names;
    die "Not in the zone $zone: @outside\n" if @outside;

    my ( $said, $ok ) = api( 'GET', "zones/$zone." );
    die "This guest holds no zone $zone.  It builds each zone that an account of the registrar names it the authority of: $said\n" unless $ok;

    revoke( $zone, $client );
    my $label = label_of( $zone, $client );

    my @grants = map { ( [ "$_.", qw{--type A --type CNAME} ], [ "_acme-challenge.$_.", qw{--type TXT} ] ) } @names;
    my ( $first, @rest ) = @grants;

    my $token;
    ( $token, $ok ) = acl( qw{token add}, $label, '--zone', "$zone.", '--name', @{$first}, '--write' );
    die "Could not make the token of $client in $zone: $token\n" unless $ok;

    foreach my $grant (@rest) {
        ( $said, $ok ) = acl( qw{grant add}, $label, '--zone', "$zone.", '--name', @{$grant}, '--write' );
        die "Could not let the token of $client write $grant->[0] in $zone: $said\n" unless $ok;
    }

    print $token;
    return 0;
}

sub main {
    my ( $command, @args ) = @_;

    die $USAGE unless defined $command;
    die $USAGE if any { !dns_name($_) } @args;

    return issue(@args)   if $command eq 'issue'    && @args == 2;
    return release(@args) if $command eq 'release'  && @args == 1;
    return forwards()     if $command eq 'forwards' && !@args;
    return grant(@args)   if $command eq 'grant'    && @args >= 3;
    return revoke(@args)  if $command eq 'revoke'   && @args == 2;
    die $USAGE;
}

exit main(@ARGV) unless caller;

1;
