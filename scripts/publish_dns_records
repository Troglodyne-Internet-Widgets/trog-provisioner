#!/usr/bin/perl

package Trog::PublishDNSRecords;

use 5.014;

use strict;
use warnings FATAL => 'all';

use JSON::PP     ();
use Getopt::Long qw{GetOptionsFromArray};

my $USAGE = "usage: publish_dns_records [--dryrun] [--shortcut PATH] [--addressed NAME ...] [--records PATH] DOMAIN ADDRESS [ALIAS ...]\n" . "       publish_dns_records [--dryrun] --shortcut PATH --alias-of TARGET NAME [NAME ...]\n" . "       publish_dns_records [--dryrun] --shortcut PATH --delegate ZONE NAMESERVER [ADDRESS]\n";

# The shortcut Provisioner::Recipe::lexicon installs for this domain, which
# already carries the provider holding the zone and the credential for it.
# Asking it rather than assembling a lexicon invocation here is what keeps the
# credential in one place: this runs the same file an operator runs by hand.
sub shortcut_for {
    my ($domain) = @_;

    return "/opt/lexicon/$domain";
}

# One argument, safe to hand a shell.  Everything below is interpolated into a
# command line, and an alias or an address is the sort of thing that arrives
# from a configuration file rather than from this program.
sub quoted {
    my ($value) = @_;

    $value =~ s/'/'\\''/g;

    return "'$value'";
}

# Every command this runs, as the one thing a test stands in for.  Answers the
# output and whether it succeeded, rather than letting each caller read $?.
sub run {
    my ($command) = @_;

    my $output = qx{$command 2>&1};

    return ( $output, $? == 0 ? 1 : 0 );
}

# A name or a target as a provider compares it: some answer with the trailing
# dot and some without, and DNS ignores case.
sub canonical {
    my ($value) = @_;

    return lc( $value // q{} ) =~ s/[.]+\z//r;
}

# The text of a TXT record, which some providers answer with in quotes.  Case
# matters in it, unlike in a name.
sub unquoted {
    my ($value) = @_;

    return ( $value // q{} ) =~ s/\A"(.*)"\z/$1/sr;
}

# Whether two contents of a record of $type say the same.
sub same_content {
    my ( $type, $one, $other ) = @_;

    return unquoted($one) eq unquoted($other) if $type eq 'TXT';
    return canonical($one) eq canonical($other);
}

# What the provider already holds of this type, as a list of rows.
#
# An empty list is an answer -- a zone with no records of the type -- and a
# command that failed is not, so the two are told apart before anything is
# published over the difference.
sub existing {
    my ( $shortcut, $type ) = @_;

    my ( $output, $ok ) = run( join ' ', quoted($shortcut), 'list', $type, '--output=JSON' );
    die "Could not ask the provider what $type records it has:\n$output" unless $ok;

    my $rows = eval { JSON::PP->new->decode($output) };
    die "The provider answered with something that is not JSON:\n$output" unless ref $rows eq 'ARRAY';

    return @{$rows};
}

# Whichever of those rows is this name, if the provider has one.
sub held_for {
    my ( $rows, $name ) = @_;

    my ($held) = grep { canonical( $_->{name} ) eq canonical($name) } @{$rows};

    return $held;
}

# One record, put where the provider can serve it, without taking anything away.
#
# Absent, it is created.  Present with different content, it is updated through
# the identifier the provider gave it.  Present and already right, nothing is
# sent: a run that changes nothing is the ordinary case on a guest rebuilt from
# the same configuration.
#
# Named arguments because all but one of them is a bare string, and a row of
# those at a call site says nothing about which is the name and which the thing
# it should answer with.
sub publish {
    my (%opts) = @_;

    my ( $held, $type, $name, $content ) = @opts{qw{held type name content}};

    if ( $held && same_content( $type, $held->{content}, $content ) ) {
        print "$type $name is already $content\n";
        return 0;
    }

    my @command = ( quoted( $opts{shortcut} ) );
    push @command, $held ? 'update' : 'create';
    push @command, $type;
    push @command, '--name=' . quoted($name);
    push @command, '--content=' . quoted($content);
    push @command, '--identifier=' . quoted( $held->{id} ) if $held && defined $held->{id};

    my $command = join ' ', @command;

    if ( $opts{dryrun} ) {
        print "[DRY RUN] $command\n";
        return 0;
    }

    print +( $held ? 'Updating' : 'Creating' ) . " $type $name -> $content\n";
    my ( $output, $ok ) = run($command);

    # Warned rather than fatal, and counted: one record the provider refused
    # should not stop the rest of them going up, and the caller wants to know
    # that something did not.
    warn "Could not publish $type $name:\n$output" unless $ok;

    return $ok ? 0 : 1;
}

# The records of a domain, by type and name: the address, and one alias for
# each name, pointing at the name that holds the address.  Each addressed name
# holds the address too, because it is the target of an NS, an MX or an SRV,
# which must not be a CNAME.
sub records {
    my ( $addressed, $domain, $address, @aliases ) = @_;
    die $USAGE unless $domain && $address;

    return (
        A     => { map { $_ => $address } $domain, @{$addressed} },
        CNAME => { map { $_ => $domain } @aliases },
    );
}

# Names of another zone, each as an alias of a target outside it, by type and
# name.  No address, because the target holds that in its own zone.  The target
# with its trailing dot, because lexicon qualifies a CNAME target without one
# into the zone that it writes.
sub aliases_of {
    my ( $target, @names ) = @_;
    die $USAGE unless $target && @names;
    return ( CNAME => { map { $_ => ( $target =~ s/[.]*\z/./r ) } @names } );
}

# The delegation of a zone, by type and name, for the zone above it: the
# nameserver that holds it, and the address of the nameserver where it is
# inside the zone, because a resolver cannot find it otherwise.  The nameserver
# with its trailing dot, because lexicon qualifies only a CNAME, and PowerDNS
# refuses the target of an NS that is not qualified.
sub delegation {
    my ( $zone, $nameserver, $address, @extra ) = @_;
    die $USAGE if !$zone || !$nameserver || @extra;

    return (
        NS => { $zone => ( $nameserver =~ s/[.]*\z/./r ) },
        A  => { $address ? ( $nameserver => $address ) : () },
    );
}

# The record of the other type that a name holds, where publishing $type there
# would put a CNAME beside another record.  Only A and CNAME are asked about,
# because those are the two types that this writes at a name it does not own.
sub clash {
    my ( $held, $type, $name ) = @_;
    my %other = ( A => 'CNAME', CNAME => 'A' );
    my $other = $other{$type}                      // return;
    my $row   = held_for( $held->($other), $name ) // return;
    return { type => $other, content => $row->{content} // q{}, id => $row->{id} };
}

# Whether the clash is a CNAME of $domain where an A record of $domain is
# wanted: an alias that an earlier build published, before the name was to
# hold the address.  Only that one is replaced, because it answers with the
# same address.
sub replaceable {
    my ( $clash, $type, $domain ) = @_;
    return defined $domain && $type eq 'A' && $clash->{type} eq 'CNAME' && canonical( $clash->{content} ) eq canonical($domain);
}

# Takes that alias away.  Answers whether it is gone.
sub unalias {
    my (%opts) = @_;

    my ( $clash, $name ) = @opts{qw{clash name}};
    my @command = ( quoted( $opts{shortcut} ), qw{delete CNAME}, '--name=' . quoted($name), '--content=' . quoted( $clash->{content} ) );
    push @command, '--identifier=' . quoted( $clash->{id} ) if defined $clash->{id};
    my $command = join ' ', @command;

    if ( $opts{dryrun} ) {
        print "[DRY RUN] $command\n";
        return 1;
    }

    print "Deleting CNAME $name -> $clash->{content}, because $name holds the address now\n";
    my ( $output, $ok ) = run($command);
    warn "Could not delete CNAME $name:\n$output" unless $ok;
    return $ok;
}

# The records other than names, out of a file or out of each .json file of a
# directory, in the order of their names.  The registrar writes one file, and a
# recipe that makes a record on the guest, as mail makes its DKIM key, writes
# another beside it.
sub records_at {
    my ($path) = @_;

    return read_records($path) unless -d $path;
    return map { read_records($_) } sort glob("$path/*.json");
}

# The records in one file: a list of type, name, content and an optional match.
sub read_records {
    my ($file) = @_;

    open( my $fh, '<', $file ) or die "Cannot read the records in $file: $!\n";
    my $text = do { local $/; <$fh> };
    close $fh or die "Cannot close $file: $!\n";

    my $records = eval { JSON::PP->new->decode($text) };
    die "$file holds no list of records\n" unless ref $records eq 'ARRAY';
    return @{$records};
}

# Why a record of $type does not go up at $name, which the provider holds as
# $clash.
sub refusal {
    my ( $type, $name, $clash ) = @_;
    return "Refusing to publish $type $name: the provider holds $name as $clash->{type} $clash->{content}, and a name with a CNAME holds no other record.\n";
}

# Which row of the provider is the record of the recipe: the row with the same
# content, or else the first row whose content starts with the match of the
# record.  A record without a match owns only a row with the same content, and
# an empty match owns every row of its type at its name.
sub owned_row {
    my ( $rows, $record ) = @_;

    my @here = grep { canonical( $_->{name} ) eq canonical( $record->{name} ) } @{$rows};
    my ($same) = grep { same_content( $record->{type}, $_->{content}, $record->{content} ) } @here;
    return $same if $same || !defined $record->{match};

    my ($ours) = grep { index( unquoted( $_->{content} ), $record->{match} ) == 0 } @here;
    return $ours;
}

sub main {
    my @args = @_;

    my ( $dryrun, $shortcut, $delegate, @addressed, $alias_of, $records );
    GetOptionsFromArray( \@args, 'dryrun' => \$dryrun, 'shortcut=s' => \$shortcut, 'delegate' => \$delegate, 'addressed=s' => \@addressed, 'alias-of=s' => \$alias_of, 'records=s' => \$records ) or die $USAGE;
    die $USAGE if ( $delegate || defined $alias_of ) && ( !$shortcut || @addressed || defined $records );
    die $USAGE if $delegate                          && defined $alias_of;

    my %wanted = $delegate ? delegation(@args) : defined $alias_of ? aliases_of( $alias_of, @args ) : records( \@addressed, @args );
    my $owner  = ( $delegate || defined $alias_of ) ? undef : $args[0];
    $shortcut //= shortcut_for( $args[0] );

    ## no critic (ValuesAndExpressions::ProhibitFiletest_rwxRWX) -- whether the shortcut is there to run is the thing being decided, and saying so beats a shell error
    die "No lexicon shortcut at $shortcut.\n" . "Provisioner::Recipe::lexicon installs it, and this needs the credential in it.\n"
      unless -x $shortcut;

    # Once per type rather than once per record.  Every list is a round trip
    # to whoever holds the zone, and asking again between two aliases would
    # decide about them against two different answers.
    my %held;
    my $held = sub {
        my ($type) = @_;
        return $held{$type} //= [ existing( $shortcut, $type ) ];
    };

    my $failures = 0;
    foreach my $type ( sort keys %wanted ) {
        next unless %{ $wanted{$type} };

        foreach my $name ( sort keys %{ $wanted{$type} } ) {
            if ( my $clash = clash( $held, $type, $name ) ) {
                if ( !replaceable( $clash, $type, $owner ) ) {
                    warn refusal( $type, $name, $clash );
                    $failures++;
                    next;
                }
                if ( !unalias( shortcut => $shortcut, clash => $clash, name => $name, dryrun => $dryrun ) ) {
                    $failures++;
                    next;
                }
            }
            $failures += publish(
                shortcut => $shortcut,
                held     => held_for( $held->($type), $name ),
                type     => $type,
                name     => $name,
                content  => $wanted{$type}{$name},
                dryrun   => $dryrun,
            );
        }
    }

    foreach my $record ( defined $records ? records_at($records) : () ) {
        my ( $type, $name ) = @{$record}{qw{type name}};
        if ( my $alias = held_for( $held->('CNAME'), $name ) ) {
            warn refusal( $type, $name, { type => 'CNAME', content => $alias->{content} // q{} } );
            $failures++;
            next;
        }
        $failures += publish(
            shortcut => $shortcut,
            held     => owned_row( $held->($type), $record ),
            type     => $type,
            name     => $name,
            content  => $record->{content},
            dryrun   => $dryrun,
        );
    }

    return $failures ? 1 : 0;
}

exit main(@ARGV) unless caller;
