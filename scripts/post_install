#!/bin/bash
# Run the work that the recipes deferred, and report each task that fails.
#
# Every task runs, because a stop at the first failure leaves the deferred work
# of later recipes undone.  The exit code gives the result at the end.
# The queue.  Only a test puts it somewhere else.
QUEUE=${POST_INSTALL_QUEUE:-/root/post_install.sh}

[ -s "$QUEUE" ] || exit 0

# Each line is the slot of the target that queued it, a tab, and the task.
# Run the tasks by slot, and in the order they were queued within one slot.  A
# line with no slot runs after all of them.  queue_postrun_task says why.
ORDERED=$(mktemp)
awk -F'\t' '{ if ($0 ~ /^[0-9]+\t/) { slot = $1; sub(/^[0-9]+\t/, "") } else { slot = 999999 } printf "%d\t%d\t%s\n", slot, NR, $0 }' "$QUEUE" \
    | sort -t "$(printf '\t')" -k1,1n -k2,2n | cut -f3- > "$ORDERED"

rc=0
while IFS= read -r task; do
    [ -n "$task" ] || continue
    echo "postrun: $task"
    # Close stdin.  The loop reads the queue on stdin and bash -c inherits it.
    # A task that reads stdin, for example cpanm, then eats the rest of the
    # queue, and no error shows.  Deferred work has no input to read.
    if ! bash -c "$task" < /dev/null; then
        echo "postrun FAILED: $task" >&2
        rc=1
    fi
done < "$ORDERED"
rm -f -- "$ORDERED"

[ "$rc" -eq 0 ] || echo "postrun: some deferred work failed; see above" >&2

# Move the queue aside, because queue_postrun_task appends to it.  If the queue
# stays, the next makefile run does these tasks again on top of its own.
#
# Do this whatever the tasks did.  If the queue stays after a failure, the next
# run replays all of it and does not retry only the failed part.  The failed
# lines stay in the copy, and the exit code below reports the failure.
mv -- "$QUEUE" "$QUEUE.ran_at_$(date +%Y%m%d-%H%M%S)"

exit "$rc"
