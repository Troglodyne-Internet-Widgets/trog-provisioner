#!/bin/bash
# Run the work the recipes deferred, and say so when it does not work.
#
# This used to be `bash /root/post_install.sh`, which reports nothing: a service
# that would not start printed its failure into the log and the provision still
# exited 0.  Every task runs, because stopping at the first would leave later
# recipes' deferred work undone, and the exit code is the answer at the end.
# The queue, which is only ever anywhere else under test.
QUEUE=${POST_INSTALL_QUEUE:-/root/post_install.sh}

[ -s "$QUEUE" ] || exit 0

rc=0
while IFS= read -r task; do
    [ -n "$task" ] || continue
    echo "postrun: $task"
    # stdin closed, or the task reads the queue.  This loop is fed the task list
    # on stdin and bash -c inherits it, so anything that reads -- cpanm pulling
    # a distribution's dependencies is the one that did it -- swallows every
    # line after itself and the loop ends at end of input.  No error, no failed
    # task, just deferred work that silently stops happening: on a tcms guest
    # that was the service never being built or started, and ufw never being
    # reloaded, so the firewall the guest ran was not the one configured for it.
    #
    # Deferred work has nowhere to read input from anyway.
    if ! bash -c "$task" < /dev/null; then
        echo "postrun FAILED: $task" >&2
        rc=1
    fi
done < "$QUEUE"

[ "$rc" -eq 0 ] || echo "postrun: some deferred work failed; see above" >&2

# Moved aside now that it has run, rather than left for the next run to replay.
# queue_postrun_task appends, and nothing emptied this, so a makefile run on a
# guest that had already had one ran every earlier run's deferred work again --
# service starts, CPAN installs, snapshots.  Most are idempotent; some are not,
# and all of them cost time.
#
# After the loop, never before: the loop reads the queue with `done < "$QUEUE"`
# and the descriptor stays open across the rename, so what is running now runs
# to the end of what it was given.
#
# Whatever the tasks did, including when one of them failed.  A failed run that
# left the queue where it was would replay the whole of it next time, which is
# the thing being fixed; the lines are still in the copy, and the exit code
# below is what carries the failure on.
mv -- "$QUEUE" "$QUEUE.ran_at_$(date +%Y%m%d-%H%M%S)"

exit "$rc"
