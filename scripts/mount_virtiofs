#!/bin/bash
# Mount a virtiofs share from the hypervisor, as a systemd mount + automount.
set -eu

TARGET=${1:?usage: mount_virtiofs <device-key> <mountpoint> <type>}
LINK_NAME=${2:?usage: mount_virtiofs <device-key> <mountpoint> <type>}
TYPE=${3:-virtiofs}

[ -f /root/devices.map ] || { echo "mount_virtiofs: no /root/devices.map" >&2; exit 1; }

ACTUAL_TARGET=$(grep "^$TARGET" /root/devices.map | awk -F '=' '{print $2}')
[ -n "$ACTUAL_TARGET" ] || {
    echo "mount_virtiofs: no device for '$TARGET' in /root/devices.map" >&2
    exit 1
}

# systemd-escape, not a pair of seds.  A mount unit has to be named for its
# mountpoint the way systemd escapes it, and the sed here replaced only the
# first slash -- so /opt/domains/share/data became "opt-domains/share/data",
# which is not a unit name at all.  Anything one level deep worked and anything
# deeper did not.
MNTFILE="/usr/lib/systemd/system/$(systemd-escape -p --suffix=mount "$LINK_NAME")"
AUTOMNTFILE="/usr/lib/systemd/system/$(systemd-escape -p --suffix=automount "$LINK_NAME")"

mkdir -p "$LINK_NAME"

# Written, not appended.  These were built with >>, so provisioning a guest a
# second time left a unit file with two of every section in it.
cat > "$MNTFILE" <<UNIT
[Unit]
Description=Shared dir from HV
After=multi-user.target

[Mount]
What=$ACTUAL_TARGET
Where=$LINK_NAME
Type=$TYPE

[Install]
WantedBy=multi-user.target
UNIT

cat > "$AUTOMNTFILE" <<UNIT
[Unit]
Description=Automount $LINK_NAME
ConditionPathExists=$LINK_NAME

[Automount]
Where=$LINK_NAME
TimeoutIdleSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable "$(basename "$MNTFILE")"
systemctl start "$(basename "$MNTFILE")"
