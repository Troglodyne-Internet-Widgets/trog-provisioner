#!/bin/bash
# While this guest provisions, send its downloads to the fetch cache of the
# fleet.  Afterwards, send them upstream again.  This is the half of
# Provisioner::Recipe::fetchcache that runs on the guest, and its perldoc has
# the full account.
#
#   fetch_via_cache on ADDRESS AUTHORITY HOST...
#   fetch_via_cache off
#
# "on" trusts AUTHORITY, the certificate that signs the certificate of the
# cache.  Then it asks the cache for each HOST by name, over TLS.  Only the
# hosts that the cache answers for go into /etc/hosts.  If the cache is down,
# or does not fetch from a host, that host stays upstream.  "off" removes the
# hosts and the authority.
#
# Exits zero whatever the cache does.  A cache saves build time and outages,
# and it must never make a build fail.

HOSTS_FILE=${FETCH_VIA_CACHE_HOSTS:-/etc/hosts}
ANCHOR=${FETCH_VIA_CACHE_ANCHOR:-/usr/local/share/ca-certificates/trog-fetchcache.crt}
FIRST='# BEGIN trog fetchcache'
LAST='# END trog fetchcache'

forget() {
    sed -i "/^$FIRST\$/,/^$LAST\$/d" "$HOSTS_FILE"
}

usage() {
    echo "usage: fetch_via_cache on ADDRESS AUTHORITY HOST... | off" >&2
    exit 2
}

case "$1" in
on)
    address=$2
    authority=$3
    [ -n "$address" ] && [ -f "$authority" ] || usage
    shift 3

    install -m 0644 "$authority" "$ANCHOR" && update-ca-certificates >/dev/null

    # Replaced, not added to, so that a second make run does not add them twice.
    forget
    answered=()
    for host in "$@"; do
        if curl -fsS -o /dev/null --max-time 5 --resolve "$host:443:$address" --cacert "$authority" "https://$host/fetchcache-status"; then
            answered+=("$host")
        else
            echo "fetch_via_cache: $address does not answer for $host, so it comes from upstream" >&2
        fi
    done

    if [ ${#answered[@]} -gt 0 ]; then
        {
            echo "$FIRST"
            for host in "${answered[@]}"; do printf '%s\t%s\n' "$address" "$host"; done
            echo "$LAST"
        } >>"$HOSTS_FILE"
    fi
    echo "fetch_via_cache: through the cache at $address: ${answered[*]:-nothing}"
    ;;
off)
    forget
    rm -f "$ANCHOR" && update-ca-certificates >/dev/null
    echo "fetch_via_cache: every host goes upstream again"
    ;;
*)
    usage
    ;;
esac
exit 0
