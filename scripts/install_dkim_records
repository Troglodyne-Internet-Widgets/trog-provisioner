#!/bin/bash

# Make a DKIM record for a domain and install it into the pdns server for that
# domain.

# One sqlite database holds every zone that the pdns recipe serves on this guest.
ZONES_DB=/var/spool/powerdns/zones.db
KEY=/etc/opendkim/keys/$1/default.private

# Do nothing if pdns is not installed.
[[ ! -f $ZONES_DB ]] && exit 0;

# Do nothing if the DKIM key is not there.
[[ ! -f $KEY ]] && exit 0;

DKIM_KEY=$(openssl rsa -in "$KEY" -pubout 2>/dev/null | sed "1,1d;$ d;" | sed -z "s/\n//g")

if [ -z "$DKIM_KEY" ]
then
	echo "Can't extract public key from private dkim key for $1."
	exit 1;
fi

DKIM_RECORD="v=DKIM1; h=sha256; k=rsa; t=y; p=$DKIM_KEY"

echo "Installing DKIM Key:"
echo "$DKIM_RECORD"

# The values go into SQL string literals, so a single quote in one is doubled.
DOMAIN_SQL=${1//\'/\'\'}
RECORD_SQL=${DKIM_RECORD//\'/\'\'}

# Delete, then insert.  The records table has no unique key on name and type,
# so an insert never replaces a record that is already there.
for SELECTOR in default mail
do
	NAME_SQL="$SELECTOR._domainkey.$DOMAIN_SQL"
	sqlite3 "$ZONES_DB" <<SQL || exit 1
BEGIN;
DELETE FROM records WHERE name='$NAME_SQL' AND type='TXT';
INSERT INTO records (domain_id, name, type, content, ttl, prio, disabled)
    SELECT id, '$NAME_SQL', 'TXT', '$RECORD_SQL', 300, 0, 0 FROM domains WHERE name='$DOMAIN_SQL';
COMMIT;
SQL
done

systemctl restart pdns

# TODO: Move the registrar code below into a separate recipe that does all the
# DNS work with the registrar.  Until then, it does not run.
exit 0;
# If the domain has a lexicon shortcut, update the records at the registrar.
[ -x "/opt/lexicon/$1" ] || exit 0;

EXISTING_RECORDS=$(/opt/lexicon/$1 list TXT)
if echo "$EXISTING_RECORDS" | grep -q "mail._domainkey.$1."
then
	/opt/lexicon/$1 update TXT --name="mail._domainkey.$1." --content="$DKIM_RECORD"
else
	/opt/lexicon/$1 create TXT --name="mail._domainkey.$1." --content="$DKIM_RECORD"
fi

if echo "$EXISTING_RECORDS" | grep -q "default._domainkey.$1."
then
	/opt/lexicon/$1 update TXT --name="default._domainkey.$1." --content="$DKIM_RECORD"
else
	/opt/lexicon/$1 create TXT --name="default._domainkey.$1." --content="$DKIM_RECORD"
fi
