#!/usr/bin/env perl

package Trog::Bin::Restore;

use strict;
use warnings;

use FindBin;
use lib "$FindBin::Bin/../lib";
use Config::Simple;
use File::Which qw{which};
use Getopt::Long qw{GetOptionsFromArray};
use Net::EmptyPort;
use Net::OpenSSH::More;
use Trog::HV();

# The hypervisor holding the domain.  Defaults to this machine.
our $hv;

sub hv {
    $hv //= Trog::HV->new();
    return $hv;
}

sub usage {
    return "Usage: $0 [--latest|--oldest|--name SNAP] [--domaindir DIR] [--connect URI] DOMAIN\n";
}

sub main {
    my @args = @_;

    my ($latest, $oldest, $name, $domain_dir, $uri);
    GetOptionsFromArray(\@args,
        'latest'      => \$latest,
        'oldest'      => \$oldest,
        'name=s'      => \$name,
        'domaindir=s' => \$domain_dir,
        'connect=s'   => \$uri,
    );
    $domain_dir //= '/opt/domains';

    my $domain = shift @args;
    die usage() unless $domain;
    die "virsh not installed\n" unless which('virsh');

    my $modes = grep { defined $_ } ($latest, $oldest, $name);
    die usage() unless $modes == 1;

    # We need to know which hypervisor to ask about snapshots before we ask, so
    # peek at provision.conf now.  An explicit --connect wins over what it says.
    # The file being mandatory is enforced further down, where it always was.
    my $cfile = "$domain_dir/$domain/provision.conf";
    $hv = Trog::HV->from_config((-f $cfile ? Config::Simple->new($cfile) : undef), uri => $uri);
    print "Restoring on hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    my @snaps = _virsh_snap_list($domain);
    die "No snapshots found for $domain\n" unless @snaps;

    my $snapname;
    if ($latest) {
        $snapname = $snaps[-1];
    } elsif ($oldest) {
        $snapname = $snaps[0];
    } else {
        $snapname = $name;
        die "Snapshot '$snapname' not found for $domain\n"
            unless grep { $_ eq $snapname } @snaps;
    }

    print "Reverting $domain to snapshot '$snapname'...\n";
    my $rc = _virsh_snap_revert($domain, $snapname);
    die "Failed to revert $domain to '$snapname'\n" if $rc;

    print "Revert complete. Verifying SSH connectivity...\n";

    die "No provision.conf found at $cfile\n" unless -f $cfile;
    my $config = Config::Simple->new($cfile);
    my $user   = $config->param('admin_user') // 'root';
    my $ips    = $config->param('ips');
    my ($ip)   = ref $ips ? @$ips : split /[\s,]+/, ($ips // '');
    die "Could not determine IP for $domain from provision.conf\n" unless $ip;

    wait_for_ssh($user, "$domain_dir/$domain/key.rsa", $ip);
    print "SSH verified. $domain is up at $ip.\n";
    return 0;
}

sub _virsh_snap_list {
    my ($domain) = @_;
    my @names = split(/\n/, hv()->virsh_pipe(['snapshot-list', '--name', $domain], '2>/dev/null') // '');
    chomp @names;
    return grep { length $_ } @names;
}

sub _virsh_snap_revert {
    my ($domain, $snapname) = @_;
    return hv()->virsh_system('snapshot-revert', '--snapshotname', $snapname, '--running', $domain);
}

sub wait_for_ssh {
    my ($user, $key, $ip) = @_;
    print "Waiting for $ip:22 to come live...\n";
    my $wait   = 300;
    my $ssh_up = Net::EmptyPort::wait_port({ host => $ip, port => 22, max_wait => $wait });
    die "SSH port never came up after $wait seconds!" unless $ssh_up;
    my $ssh = Net::OpenSSH::More->new(host => $ip, user => $user, key_path => $key);
    die "Could not establish SSH connection as $user!" unless $ssh;
    return $ssh;
}

main(@ARGV) unless caller;
1;
