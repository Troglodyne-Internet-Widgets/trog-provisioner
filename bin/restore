#!/usr/bin/env perl

package Trog::Bin::Restore;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aasx';
use FindBin::libs;
use Config::Simple;
use Getopt::Long qw{GetOptionsFromArray};
use List::Util   qw{any};
use Pod::Usage   qw{pod2usage};
use Trog::Guest();
use Trog::HV();
use Trog::Hypervisors();

=head1 NAME

restore - revert a provisioned VM to one of its snapshots

=head1 SYNOPSIS

    restore [--latest|--oldest|--name SNAP] [OPTIONS] DOMAIN

    restore --latest vm.example.com
    restore --name before-upgrade --hypervisor hv1 vm.example.com

=head1 OPTIONS

Exactly one of B<--latest>, B<--oldest> or B<--name> is required.

=over 4

=item B<--latest>

Revert to the newest snapshot.

=item B<--oldest>

Revert to the oldest snapshot.

=item B<--name> SNAP

Revert to the named snapshot.

=item B<--domaindir> DIR

The directory that holds one directory for each domain.  The default is
F</opt/domains>.

=item B<--hypervisor> NAME

The name of a hypervisor in F<hypervisors.conf>, when you know which one holds
the domain.  With this option, the command does not do the search that
C<--hvconf> describes.  It dies when the file does not name it, and says which
names it has.

=item B<--hvconf> FILE

The file that defines the fleet.  The default is
F</etc/trog-provisioner/hypervisors.conf>.  If the file exists, the command asks
each hypervisor in it for this guest.  It reverts the guest on the hypervisor
that has it.

=back

=head1 DESCRIPTION

Reverts the domain and leaves it running.  Then it waits until SSH connects at
the address that F<provision.conf> gives for the domain.  Thus a revert that
gives a VM you cannot reach is a failure, not a success.

=cut

sub main {
    my @args = @_;

    my ( $latest, $oldest, $name, $domain_dir, $hv_name, $hvconf );
    GetOptionsFromArray(
        \@args,
        'latest'       => \$latest,
        'oldest'       => \$oldest,
        'name=s'       => \$name,
        'domaindir=s'  => \$domain_dir,
        'hypervisor=s' => \$hv_name,
        'hvconf=s'     => \$hvconf,
    );

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    my $modes = grep { defined $_ } ( $latest, $oldest, $name );
    pod2usage(
        -exitval => 2, -verbose => 1, -input => __FILE__,
        -message => 'Pass exactly one of --latest, --oldest or --name'
    ) unless $modes == 1;

    # Read provision.conf before anything is reverted, because without it there
    # is no user or address to reach the guest at afterwards.  Without a fleet,
    # it also names the hypervisor.
    $domain_dir //= Trog::HV->default_domain_dir;
    my $cfile  = "$domain_dir/$domain/provision.conf";
    my $config = eval { Config::Simple->new($cfile) }
      or die "No provision.conf to read at $cfile: $Config::Simple::errstr\n";

    my $hv = Trog::Hypervisors->find(
        $domain,
        hypervisor => $hv_name,
        hvconf     => $hvconf,
        domain_dir => $domain_dir,
        config     => $config,
    );
    print "Restoring on hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    my @snaps = $hv->snapshot_names($domain);
    die "No snapshots found for $domain\n" unless @snaps;

    my $snapname;
    if ($latest) {
        $snapname = $snaps[-1];
    }
    elsif ($oldest) {
        $snapname = $snaps[0];
    }
    else {
        $snapname = $name;
        die "Snapshot '$snapname' not found for $domain\n"
          unless any { $_ eq $snapname } @snaps;
    }

    print "Reverting $domain to snapshot '$snapname'...\n";
    die "Failed to revert $domain to '$snapname'\n" unless $hv->revert_snapshot( $domain, $snapname );

    print "Revert complete. Verifying SSH connectivity...\n";

    my $user = $config->param('admin_user') // 'root';
    my $ips  = $config->param('ips');
    my ($ip) = ref $ips ? @$ips : split /[\s,]+/, ( $ips // '' );
    die "Could not determine IP for $domain from provision.conf\n" unless $ip;

    Trog::Guest->new(
        name     => $domain, host => $ip, user => $user,
        key_path => Trog::Guest->key_path( $domain, "$domain_dir/$domain/key.rsa" )
    )->wait_for_ssh();

    print "SSH verified. $domain is up at $ip.\n";
    return 0;
}

main(@ARGV) unless caller;
1;
