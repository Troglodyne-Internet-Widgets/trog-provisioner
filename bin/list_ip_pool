#!/usr/bin/env perl

package Provisioner::Bin::list_ip_pool;

#ABSTRACT: Display static IP pool status.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Provisioner::Cookbook();
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};
use Trog::Config();
use Trog::Hypervisors();
use Cpanel::JSON::XS;
use List::Util qw{any};

use Provisioner::IPPool;

=head1 USAGE

    list_ip_pool [--recipes=file] [--available] [--assigned] [--json]

Shows the status of the static IP pool, one bin at a time.  It lists the IPs
of each bin that are assigned and the IPs that are available.  With C<--json>,
it prints one object, with a key for each bin.  L<Provisioner::IPPool/BINS> says
what a bin is.

Each network has a C<guests> bin of its own, which the blocks of its
hypervisors in F<hypervisors.conf> name.  It shows as C<guests:> and the names
of those blocks, for example C<guests:hv1,hv2>.

For a bin with C<via>, it first asks that server which addresses it gave to its
clients, because a client can get one by hand.  That needs the key of the
server, so it can ask for the password of the store.  If the server cannot be
asked, it warns and shows that bin as the database has it.

=head2 Where the pool is written

The block of a hypervisor in F<hypervisors.conf> names the C<guests> bin of its
network, with its gateway:

    [hv1]
    gateway        = 192.0.2.254

    # Every address of the pool.
    pool_addresses = 192.0.2.10, 192.0.2.11, 192.0.2.12

    # Or one or more CIDR blocks.
    pool_cidr      = 192.0.2.0/24, 10.0.0.0/28

You can use both keys.  A bin is the addresses list and the addresses of each
CIDR block together.  The other bins belong to no hypervisor, and the
C<ip_pool> of the C<_global> of C<_base> in F<recipes.yaml> names them, each
with the same two keys:

    _base:
      _global:
        ip_pool:
          bins:
            vpnclients:
              cidr: 10.8.0.128/25

The assigned IPs come from the address database of L<Provisioner::IPPool>.  An
IP in the pool that is not in the database is available for a new guest.

=cut

sub main {
    my @args = @_;

    my $rfile = Trog::Config->path('recipes.yaml');
    my ( $assigned, $available, $json, $help );

    GetOptionsFromArray(
        \@args,
        'recipes=s' => \$rfile,
        'assigned'  => \$assigned,
        'available' => \$available,
        'json'      => \$json,
        'help'      => \$help,
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    # Without --assigned or --available, show both.
    ( $assigned, $available ) = ( 1, 1 ) if !$assigned && !$available;

    my $globals = Provisioner::Cookbook->base_globals( Provisioner::Cookbook->configuration($rfile) );
    my $pool    = { bins => ( $globals->{ip_pool} // {} )->{bins} // {} };
    my %bins    = ( guest_bins(), Provisioner::IPPool::bins($pool) );

    unless (%bins) {

        # This tells the reader what to type, so a file and line number from
        # warn do not help them.
        ## no critic (ProhibitPrintSTDERR)
        print {*STDERR} <<"GUIDANCE";
No hypervisor in hypervisors.conf names a pool, and $rfile names no bins.
Name the pool of a hypervisor in its block, like:

  [hv1]
  gateway        = 192.0.2.254
  pool_addresses = 192.0.2.10, 192.0.2.11, 192.0.2.12

  OR

  [hv1]
  gateway        = 192.0.2.254
  pool_cidr      = 192.0.2.0/24

GUIDANCE
        ## use critic
        return 1;
    }

    my %ips = map { $_ => [ Provisioner::IPPool::pool_ips( $bins{$_} ) ] } keys %bins;

    unless ( any { @$_ } values %ips ) {
        print {*STDERR} "The pool names no address that could be parsed.\n";    ## no critic (ProhibitPrintSTDERR)
        return 1;
    }

    # The database is the record that bin/new_config assigns from.  The first
    # call fills it from the hypervisors, so an empty database does not show
    # every IP as available.
    Provisioner::IPPool::ensure_seeded();
    foreach my $bin ( grep { defined $bins{$_}{via} } sort keys %bins ) {
        eval { Provisioner::IPPool::refresh_via( $pool, $bin ); 1 }
          or warn "The bin $bin shows only what ips.db knows, which misses any address that its server gave out by hand: $@";
    }
    my %taken = %{ Provisioner::IPPool::taken() };

    my %out;
    foreach my $bin ( sort keys %ips ) {
        my @pool_ips  = @{ $ips{$bin} };
        my @available = grep { !$taken{$_} } @pool_ips;
        my %assigned  = map  { $_ => $taken{$_} } grep { $taken{$_} } @pool_ips;

        if ($json) {
            $out{$bin}{available} = \@available if $available;
            $out{$bin}{assigned}  = \%assigned  if $assigned;
            next;
        }

        printf "Bin %s:  %d total, %d assigned, %d available\n\n",
          $bin, scalar(@pool_ips), scalar( keys %assigned ), scalar(@available);

        if ( %assigned && $assigned ) {
            print "Assigned:\n" . join( q{}, map { sprintf "  %-20s %s\n", $_, $assigned{$_} } grep { $assigned{$_} } @pool_ips ) . "\n";
        }

        if (@available) {
            print "Available:\n" . join( q{}, map { sprintf "  %s\n", $_ } @available ) . "\n" if $available;
        }
        else {
            print "Bin exhausted:  no IPs available.\n\n";
        }
    }

    print Cpanel::JSON::XS::encode_json( \%out ) if $json;

    # This is the exit status of the process, so it must be explicit.
    return 0;
}

=head2 %bins = guest_bins()

The C<guests> bin of each network, as L<Provisioner::IPPool/guest_pools> finds
them, by its label: C<guests:> and the names of the hypervisors that share it.

=cut

sub guest_bins {
    my %pools = Provisioner::IPPool::guest_pools( Trog::Hypervisors->load( Trog::Hypervisors->default_path() ) );

    my %by_network;
    foreach my $name ( sort keys %pools ) {
        my $network = Provisioner::IPPool::network_of( $pools{$name} );
        push( @{ $by_network{$network}{names} }, $name );
        $by_network{$network}{pool} = $pools{$name};
    }
    return map { "$Provisioner::IPPool::GUESTS:" . join( q{,}, @{ $_->{names} } ) => $_->{pool} } values %by_network;
}

exit main(@ARGV) unless caller;

1;
