#!/usr/bin/env perl

package Provisioner::Bin::list_ip_pool;

#ABSTRACT: Display static IP pool status.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Provisioner::Cookbook();
use Getopt::Long qw{GetOptionsFromArray};
use Trog::Config();
use Cpanel::JSON::XS;

use Provisioner::IPPool;

=head1 USAGE

    list_ip_pool [--recipes=file] [--available] [--assigned] [--json]

Shows the status of the static IP pool.  It lists the IPs that are assigned to
guests and the IPs that are available.

=head2 Where the pool is written

Add an C<ip_pool> to the C<_global> of C<_base> in F<recipes.yaml>:

    _base:
      _global:
        ip_pool:
          # Every address of the pool.
          addresses: [192.168.1.10, 192.168.1.11, 192.168.1.12]

          # Or one or more CIDR blocks, separated by spaces.
          cidr: 192.168.1.0/24 10.0.0.0/28

You can use both keys.  The pool is the addresses list and the addresses of
each CIDR block together.

The assigned IPs come from the address database of L<Provisioner::IPPool>.  An
IP in the pool that is not in the database is available for a new guest.

=cut

sub main {
    my @args = @_;

    my $rfile = Trog::Config->path('recipes.yaml');
    my ( $assigned, $available, $json );

    GetOptionsFromArray(
        \@args,
        'recipes=s' => \$rfile,
        'assigned'  => \$assigned,
        'available' => \$available,
        'json'      => \$json,
    );

    # Without --assigned or --available, show both.
    ( $assigned, $available ) = ( 1, 1 ) if !$assigned && !$available;

    my $globals = Provisioner::Cookbook->globals( undef, Provisioner::Cookbook->configuration($rfile) );
    my $pool    = $globals->{ip_pool} // {};

    unless ( keys %$pool ) {

        # This tells the reader what to type, so a file and line number from
        # warn do not help them.
        ## no critic (ProhibitPrintSTDERR)
        print {*STDERR} <<"GUIDANCE";
No ip_pool in the _global of _base in $rfile
Add one like:

  _base:
    _global:
      ip_pool:
        addresses: [192.168.1.10, 192.168.1.11, 192.168.1.12]

  OR

  _base:
    _global:
      ip_pool:
        cidr: 192.168.1.0/24

GUIDANCE
        ## use critic
        return 1;
    }

    my @pool_ips = Provisioner::IPPool::pool_ips($pool);

    unless (@pool_ips) {
        print {*STDERR} "ip_pool section found but no IPs could be parsed.\n";    ## no critic (ProhibitPrintSTDERR)
        return 1;
    }

    # The database is the record that bin/new_config assigns from.  The first
    # call fills it from the hypervisors, so an empty database does not show
    # every IP as available.
    Provisioner::IPPool::ensure_seeded( $pool, $globals->{gateway} );
    my %assigned = %{ Provisioner::IPPool::taken() };

    my @available = grep { !$assigned{$_} } @pool_ips;
    my @used      = grep { $assigned{$_} } @pool_ips;

    if ($json) {
        my $out = {};
        $out->{available} = \@available if $available;
        $out->{assigned}  = \%assigned  if $assigned;
        print Cpanel::JSON::XS::encode_json($out);
        return 0;
    }

    printf "IP Pool:  %d total, %d assigned, %d available\n\n",
      scalar(@pool_ips), scalar(@used), scalar(@available);

    if ( @used && $assigned ) {
        print "Assigned:\n" . join( q{}, map { sprintf "  %-20s %s\n", $_, $assigned{$_} } @used ) . "\n";
    }

    if (@available) {
        if ($available) {
            print "Available:\n" . join( q{}, map { sprintf "  %s\n", $_ } @available );
        }
    }
    else {
        print "Pool exhausted:  no IPs available.\n";
    }

    # This is the exit status of the process, so it must be explicit.
    return 0;
}

exit main(@ARGV) unless caller;

1;
