#!/usr/bin/env perl

package Provisioner::Bin::forget_secret;

#ABSTRACT: Take one secret out of the store the recipes read from.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Provisioner::Cookbook();
use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();

=head1 USAGE

    forget_secret --group GROUP --title TITLE [--secrets FILE] [--force]

Remove C<GROUP/TITLE> from the secret store.  The whole entry goes: an entry
with its password taken out still says what the password was for.

C<--secrets> defaults to F<secrets.kdbx> in the configuration directory.  The
passphrase prompt reads standard input, so you can pipe the passphrase in when
nobody is at a terminal.

=head2 WHAT IT REFUSES

A secret that this installation still asks for.  C<bin/new_config> reads the
configuration and every recipe of every domain to work out which references a
provision needs, and deleting one of those means the next provision generates a
new value -- for a key that something outside this machine has been told about,
that is the difference between a guest that works and one that does not.

C<--force> deletes it anyway, for a reference that is wanted no longer because
the recipe that read it is gone.

=head2 WHAT IT DOES NOT DO

It does not remove the group, even when the group is left with nothing in it.
The groups are the operator's filing.

It does not rotate anything.  Whatever authenticated with the secret goes on
authenticating with it until somebody changes it at the far end.

=head1 SUBROUTINES

=head2 $rc = main(@args)

Removes the entry.  Returns 0, 1 if the reference is still wanted, or 2 for a
usage error.

=cut

sub main {
    my @args = @_;

    my ( $group, $title, $store, $force, $help );
    GetOptionsFromArray(
        \@args,
        'group=s'   => \$group,
        'title=s'   => \$title,
        'secrets=s' => \$store,
        'force'     => \$force,
        'help'      => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    $store //= Trog::Config->path('secrets.kdbx');

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need --group and --title' )
      unless $group && $title;

    my $ref = "secret:$group/$title/password";

    unless ($force) {

        # The field is not part of the question.  An entry holds the password
        # and the username of one thing, and this deletes the entry.
        my ($asked) = grep { m{\Asecret:\Q$group\E/\Q$title\E/} } Provisioner::Cookbook->secret_references();
        if ($asked) {
            warn "This installation still asks for $asked.\n" . "The next provision of what reads it would generate a new value, which whatever\n" . "trusts the old one has never been told about.  Take it out of the configuration\n" . "first, or pass --force if the recipe that read it is gone.\n";
            return 1;
        }
    }

    my $password = Trog::Credentials->prompt( 'Enter password:', 'keepass' );

    my @gone = Trog::Secrets->forget( $store, $password, $ref );

    unless (@gone) {
        print "Nothing called $group/$title in $store, so there is nothing to remove.\n";
        return 0;
    }

    print "Removed $group/$title from $store\n";
    return 0;
}

exit main(@ARGV) unless caller;

1;
