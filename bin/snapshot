#!/usr/bin/env perl

package Trog::Bin::Snapshot;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aasx';
use FindBin::libs;
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};
use Trog::Hypervisors();

=head1 NAME

snapshot - take a snapshot of a provisioned VM

=head1 SYNOPSIS

    snapshot [OPTIONS] DOMAIN

    snapshot vm.example.com
    snapshot --name before-upgrade --connect qemu+ssh://root@hv1.example.net/system vm.example.com
    snapshot --disk-only --name before-upgrade vm.example.com

=head1 OPTIONS

=over 4

=item B<--name> NAME

What to call the snapshot.  Left to libvirt, which names it after the current
time, if you don't say.

=item B<--disk-only>

Snapshot the disk alone, without the guest's memory.

This B<stops the guest, and leaves it stopped>, because a disk-only snapshot is
the only kind libvirt will take of a domain that is not running -- and it will
not take one of a domain that is.  Start it again yourself when the snapshot is
done.

Worth the interruption when the memory is what you do not want: a full system
snapshot writes the whole of the guest's RAM into the image, which is slow and
large, and reverting to one resumes the guest mid-flight rather than booting it.

=item B<--connect> URI

The libvirt connection string of the hypervisor holding the domain.  Skips the
search described under C<--hvconf> and goes straight there.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.  Only used
to find F<hypervisors.conf>.

=item B<--hvconf> FILE

The fleet definition.  Defaults to F</etc/trog-provisioner/hypervisors.conf>.
When it exists, every hypervisor in it is asked whether it has this guest, and
the one that does is the one we snapshot.

=back

=head1 DESCRIPTION

Takes an atomic snapshot and then checks that libvirt actually made one, by
confirming the domain's current snapshot changed.  Dies if it didn't, since a
snapshot command that quietly did nothing is worse than one that failed.

A running guest is snapshotted whole, memory and all, so reverting puts it back
exactly as it was.  C<--disk-only> takes the disk by itself instead, which means
stopping the guest first and leaving it stopped.  A guest that is already off
has no memory to capture and is snapshotted as it is.

=cut

sub main {
    my @args = @_;

    my ( $name, $uri, $domain_dir, $hvconf, $disk_only );
    GetOptionsFromArray(
        \@args,
        'name=s'      => \$name,
        'connect=s'   => \$uri,
        'domaindir=s' => \$domain_dir,
        'hvconf=s'    => \$hvconf,
        'disk-only'   => \$disk_only,
    );

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    my $hv = Trog::Hypervisors->find(
        $domain,
        uri => $uri, hvconf => $hvconf, domain_dir => $domain_dir
    );

    my $before = $hv->snapshot_current_name($domain);

    # Said before the snapshot rather than after it, because it is the guest
    # going away that an operator wants warning of, and this can take a while.
    my $going_down = $disk_only ? "Stopping $domain first, and leaving it stopped: a disk-only snapshot is not something libvirt will take of a running guest.\n" : q{};
    print "Creating snapshot for $domain...\n" . $going_down;

    my $took = $hv->create_snapshot( $domain, $name, disk_only => !!$disk_only );
    die "Failed to create snapshot for $domain\n" unless $took;

    my $after = $hv->snapshot_current_name($domain);
    die "No current snapshot found after create\n" unless defined $after && length $after;

    die "Current snapshot unchanged after create (still '$after') -- snapshot may not have been created\n"
      if defined $before && $before eq $after;

    my $still_down = $disk_only ? "$domain is still shut down; start it when you are ready.\n" : q{};
    print "Snapshot '$after' created and verified as current.\n" . $still_down;
    return 0;
}

main(@ARGV) unless caller;
1;
