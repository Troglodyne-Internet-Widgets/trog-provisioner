#!/usr/bin/env perl

package Trog::Bin::Snapshot;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aasx';
use FindBin::libs;
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};
use Trog::Hypervisors();

=head1 NAME

snapshot - take a snapshot of a provisioned VM

=head1 SYNOPSIS

    snapshot [OPTIONS] DOMAIN

    snapshot vm.example.com
    snapshot --name before-upgrade --hypervisor hv1 vm.example.com
    snapshot --disk-only --name before-upgrade vm.example.com

=head1 OPTIONS

=over 4

=item B<--name> NAME

The name of the snapshot.  If you do not give one, libvirt names it after the
current time.

=item B<--disk-only>

Take a snapshot of the disk only, without the memory of the guest.

This option B<stops the guest>.  libvirt takes a disk-only snapshot of a domain
only when the domain is not running.  If the guest was running, the command
starts it again after the snapshot.  It does this also when libvirt refuses the
snapshot.

Use this option when you do not want the memory.  A full system snapshot writes
all of the RAM of the guest into the image, which is slow and large.  A revert
to it resumes the guest where it stopped, and does not boot it.

=item B<--hypervisor> NAME

The name of a hypervisor in F<hypervisors.conf>, when you know which one holds
the domain.  With this option, the command does not do the search that
C<--hvconf> describes.  It dies when the file does not name it, and says which
names it has.

=item B<--domaindir> DIR

The directory that holds one directory for each domain.  The default is
F</opt/domains>.  The command gives it to the hypervisor, but a snapshot does
not read from it.

=item B<--hvconf> FILE

The file that defines the fleet.  The default is
F</etc/trog-provisioner/hypervisors.conf>.  If the file exists, the command asks
each hypervisor in it for this guest.  It takes the snapshot on the hypervisor
that has it.

=back

=head1 DESCRIPTION

Takes an atomic snapshot.  Then it makes sure that libvirt made one: the
current snapshot of the domain must change.  If it does not change, the command
dies.  A snapshot command that does nothing and says nothing is worse than one
that fails.

The snapshot of a running guest includes its memory, so a revert puts the guest
back as it was.  C<--disk-only> takes only the disk, and stops and starts the
guest to do it.  A guest that is off has no memory to save.  The command takes
its snapshot as it is, and leaves it off.

=cut

sub main {
    my @args = @_;

    my ( $name, $hv_name, $domain_dir, $hvconf, $disk_only );
    GetOptionsFromArray(
        \@args,
        'name=s'       => \$name,
        'hypervisor=s' => \$hv_name,
        'domaindir=s'  => \$domain_dir,
        'hvconf=s'     => \$hvconf,
        'disk-only'    => \$disk_only,
    );

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    my $hv = Trog::Hypervisors->find(
        $domain,
        hypervisor => $hv_name, hvconf => $hvconf, domain_dir => $domain_dir
    );

    my $before = $hv->snapshot_current_name($domain);

    # Print this before the snapshot, because the operator needs a warning that
    # the guest stops, and the snapshot can take a long time.
    my $going_down = $disk_only ? "Stopping $domain for this: a disk-only snapshot is not one libvirt will take of a running guest.  It goes back the way it was found afterwards.\n" : q{};
    print "Creating snapshot for $domain...\n" . $going_down;

    my $took = $hv->create_snapshot( $domain, $name, disk_only => !!$disk_only );
    die "Failed to create snapshot for $domain\n" unless $took;

    my $after = $hv->snapshot_current_name($domain);
    die "No current snapshot found after create\n" unless $after;

    die "Current snapshot unchanged after create (still '$after') -- snapshot may not have been created\n"
      if defined $before && $before eq $after;

    my $put_back = $disk_only ? "$domain is back the way it was found.\n" : q{};
    print "Snapshot '$after' created and verified as current.\n" . $put_back;
    return 0;
}

main(@ARGV) unless caller;
1;
