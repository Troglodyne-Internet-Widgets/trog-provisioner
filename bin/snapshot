#!/usr/bin/env perl

package Trog::Bin::Snapshot;

use strict;
use warnings FATAL => 'all';

use FindBin::libs;
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage qw{pod2usage};
use Trog::HV();

=head1 NAME

snapshot - take a live snapshot of a provisioned VM

=head1 SYNOPSIS

    snapshot [OPTIONS] DOMAIN

    snapshot vm.example.com
    snapshot --name before-upgrade --connect qemu+ssh://root@hv1.example.net/system vm.example.com

=head1 OPTIONS

=over 4

=item B<--name> NAME

What to call the snapshot.  Left to libvirt, which names it after the current
time, if you don't say.

=item B<--connect> URI

The libvirt connection string of the hypervisor holding the domain.  Defaults to
whatever libvirt itself would pick, i.e. this machine.

=back

=head1 DESCRIPTION

Takes an atomic live snapshot and then checks that libvirt actually made one, by
confirming the domain's current snapshot changed.  Dies if it didn't, since a
snapshot command that quietly did nothing is worse than one that failed.

=cut

sub main {
    my @args = @_;

    my ($name, $uri);
    GetOptionsFromArray(\@args,
        'name=s'    => \$name,
        'connect=s' => \$uri,
    );

    my $domain = shift @args;
    pod2usage(-exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed')
      unless $domain;

    my $hv = Trog::HV->new(uri => $uri);

    my $before = $hv->snapshot_current_name($domain);

    print "Creating snapshot for $domain...\n";
    die "Failed to create snapshot for $domain\n" unless $hv->create_snapshot($domain, $name);

    my $after = $hv->snapshot_current_name($domain);
    die "No current snapshot found after create\n" unless defined $after && length $after;

    die "Current snapshot unchanged after create (still '$after') — snapshot may not have been created\n"
      if defined $before && $before eq $after;

    print "Snapshot '$after' created and verified as current.\n";
    return 0;
}

main(@ARGV) unless caller;
1;
