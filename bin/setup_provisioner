sub _apt_install {
    my @pkgs    = @_;
    my @missing = grep { !which($_) } @pkgs;
    return 1 unless @missing;
    print "Installing: @missing\n";
    local $ENV{DEBIAN_FRONTEND} = 'noninteractive';
    system('apt-get', 'install', '-y', @missing) == 0
        or do { warn "apt-get install failed for @missing\n"; return 0 };
    return 1;
}

# Returns the virbr0 subnet in CIDR notation (e.g. 192.168.122.0/24).
sub _get_virbr0_subnet {
    my $out = `ip -4 addr show virbr0 2>/dev/null`;
    if ($out =~ /inet\s+(\d+\.\d+\.\d+)\.\d+\/(\d+)/) {
        return "$1.0/$2";
    }
    return '192.168.122.0/24';
}

sub _get_virbr0_ip {
    my $out = `ip -4 addr show virbr0 2>/dev/null`;
    return $1 if $out =~ /inet\s+([\d.]+)/;
    return '192.168.122.1';
}

exit main(@ARGV) unless caller;
1;
