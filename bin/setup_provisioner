# Ensure rsyslog is configured to ingest logs from VMs over TCP/UDP.
sub setup_rsyslog {
    die "/etc/rsyslog.conf does not exist, unsupported configuration" unless -f '/etc/rsyslog.conf';
    my $rs_conf = read_text('/etc/rsyslog.conf');

    my @must_have;
    foreach my $type (qw{imudp imtcp}) {
        push(@must_have, qq{module(load="$type")}, qq{input(type="$type" port="514")});
    }

    my $changed;
    foreach my $subj (@must_have) {
        if ($rs_conf !~ m/^\s*\Q$subj\E\s*$/m) {
            $rs_conf = "$subj\n" . $rs_conf;
            $changed = 1;
        }
    }
    if ($changed) {
        write_text('/etc/rsyslog.conf', $rs_conf);
        system(qw{systemctl restart rsyslog});
    }
    return 1;
}

# Enable auditd locally and configure it to receive remote audit logs from guests.
sub setup_auditd {
    _apt_install('auditd', 'audispd-plugins') or return 0;

    my $auditd_conf = '/etc/audit/auditd.conf';
    die "$auditd_conf does not exist" unless -f $auditd_conf;

    my $conf = read_text($auditd_conf);
    my $changed;
    if ($conf !~ m/^\s*tcp_listen_port\s*=/m) {
        $conf .= "\ntcp_listen_port = 60\n";
        $changed = 1;
    } elsif ($conf !~ m/^\s*tcp_listen_port\s*=\s*60\b/m) {
        $conf =~ s/^(\s*tcp_listen_port\s*=\s*)\d+$/${1}60/m;
        $changed = 1;
    }
    if ($changed) {
        write_text($auditd_conf, $conf);
    }

    system(qw{systemctl enable --now auditd});
    system(qw{systemctl restart auditd});
    return 1;
}

# TODO: setup tcms based virtual machine manager (qaportal3)
sub setup_management_interface {
1;
}

# Configure the firewall to allow rsyslog (514) and auditd-remote (60) only
# from the internal VM subnet (virbr0), blocking access from external networks.
sub setup_firewall {
    _apt_install('ufw') or return 0;

    my $subnet = _get_virbr0_subnet();

    for my $port (514, 60) {
        for my $proto (qw{tcp udp}) {
            system("ufw allow from $subnet to any port $port proto $proto comment 'allow VM log ingest'");
            system("ufw deny to any port $port proto $proto comment 'block external log ingest'");
        }
    }

    local $ENV{DEBIAN_FRONTEND} = 'noninteractive';
    system(qw{ufw --force enable});
    return 1;
}

# TODO: setup relevant local fail2ban rules
