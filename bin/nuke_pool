#!/usr/bin/env perl

package Trog::Bin::NukePool;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aasx';
use FindBin::libs;
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};
use Trog::HV();
use Trog::Hypervisors();

=head1 NAME

nuke_pool - tear down a hypervisor's storage pool and everything in it

=head1 SYNOPSIS

    nuke_pool [OPTIONS]

    nuke_pool
    nuke_pool --connect qemu+ssh://root@hv1.example.net/system

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor that holds the pool.  The
default is the hypervisor that libvirt picks, which is this machine.

=item B<--hypervisor> NAME

The name of a hypervisor in F<hypervisors.conf>, instead of a connection
string.  This option does not search for a guest, because a storage pool
belongs to a machine and not to a guest.

=item B<--hvconf> FILE

The fleet definition.  Defaults to F</etc/trog-provisioner/hypervisors.conf>.

=item B<--pool> NAME

The pool to nuke.  The default is the C<pool_name> of the hypervisor.  That is
C<tf_disks>, unless F<hypervisors.conf> gives a different name.

=item B<--poolpath> DIR

The directory on the hypervisor that holds the files of the pool.  The default
is the C<pool_path> in the configuration of the hypervisor.  If there is none,
it is the directory that libvirt gives for the pool.  If libvirt gives none, it
is F</opt/terraform/disks>.

=back

=head1 DESCRIPTION

Removes the directory of the pool from the hypervisor.  Then it stops, deletes
and undefines the pool.  Every guest disk on the hypervisor is in that
directory, so this deletes the disks of all the guests.

=cut

sub main {
    my @args = @_;

    my ( $uri, $pool, $pool_path, $name, $hvconf, $domain_dir );
    GetOptionsFromArray(
        \@args,
        'connect=s'    => \$uri,
        'pool=s'       => \$pool,
        'poolpath=s'   => \$pool_path,
        'hypervisor=s' => \$name,
        'hvconf=s'     => \$hvconf,
        'domaindir=s'  => \$domain_dir,
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );

    pod2usage(
        -exitval => 2, -verbose => 1, -input => __FILE__,
        -message => 'Pass --connect or --hypervisor, not both'
    ) if $uri && $name;

    my $hv;
    if ($name) {
        my $fleet = Trog::Hypervisors->load( $hvconf // Trog::Hypervisors->default_path );
        die "No hypervisors are configured, so --hypervisor has nothing to name\n"
          unless $fleet->configured;
        $hv = $fleet->hypervisor($name)->activate();
    }
    else {
        $hv = Trog::HV->new( uri => $uri, pool_path => $pool_path );
    }
    $hv->{pool_path} = $pool_path if defined $pool_path;
    $hv->nuke_pool( $pool // $hv->pool_name );
    return 0;
}

exit main(@ARGV) unless caller;

1;
