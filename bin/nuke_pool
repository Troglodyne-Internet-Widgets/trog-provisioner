#!/usr/bin/env perl

package Trog::Bin::NukePool;

use strict;
use warnings;

use FindBin();
use FindBin::libs;
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage qw{pod2usage};
use Trog::HV();

=head1 NAME

nuke_pool - tear down the tf_disks storage pool because terraform is braindead

=head1 SYNOPSIS

    nuke_pool [OPTIONS]

    nuke_pool
    nuke_pool --connect qemu+ssh://root@hv1.example.net/system

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor holding the pool.  Defaults to
whatever libvirt itself would pick, i.e. this machine.

=item B<--pool> NAME

Which pool to nuke.  Defaults to C<tf_disks>.

=item B<--poolpath> DIR

Where that pool's backing store lives on the hypervisor.  Defaults to
F</opt/terraform/disks>.

=back

=head1 DESCRIPTION

Removes the pool's directory from the hypervisor and then stops, deletes and
undefines the pool itself.  Terraform gets itself into states nothing else will
get it out of; this is that.

=cut

sub main {
    my @args = @_;

    my ($uri, $pool, $pool_path);
    GetOptionsFromArray(\@args,
        'connect=s'  => \$uri,
        'pool=s'     => \$pool,
        'poolpath=s' => \$pool_path,
    ) or pod2usage(-exitval => 2, -verbose => 1, -input => __FILE__);

    my $hv = Trog::HV->new(uri => $uri, pool_path => $pool_path);
    $hv->nuke_pool($pool // 'tf_disks');
    return 0;
}

exit main(@ARGV) unless caller;

1;
