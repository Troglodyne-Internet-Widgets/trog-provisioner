#!/usr/bin/env perl

package Provisioner::Bin::reseed_ips;

#ABSTRACT: Ask the hypervisors again when the address database is out of date.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Config::Simple;
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Trog::Config();
use Provisioner::IPPool();

=head1 USAGE

    reseed_ips [--dryrun] [--prune] [--ipmap=file]

Ask each hypervisor again, and make F<ips.db> agree with the addresses that are
in use now.

Seeding (the first sweep that fills F<ips.db>) usually occurs one time for each
hypervisor.  The database then remembers the result, because a sweep takes time
and a fleet does not change often.  But if you build, move or destroy a guest by
hand, the database is then wrong.  Run this command to tell the tool to look
again.

    $ bin/reseed_ips --dryrun
    $ bin/reseed_ips

=head2 WHAT IT REBUILDS, AND WHAT IT LEAVES ALONE

Reservations are B<derived>.  They are the hypervisors, the gateways, and any
other address that answered on the network.  A reservation records what the
sweep found, not a decision that a person made.  So this command removes the
reservations and makes them again.  An address that no longer answers becomes
free.  A new address that answers becomes taken.

This command does B<not> change assignments.  An assignment is a decision: a
domain uses the address, or a build is about to use it.  A guest that is off
during the sweep does not show that its address is free.  To give that address
to a different guest is the failure that this database prevents.

Thus a usual run only adds assignments.  It adds one for each guest on a
hypervisor that the database did not know about.

=head2 --prune

Also remove the assignment of each domain that no hypervisor runs.

This option can take an address away from a domain.  Thus it is not the
default, and it prints what it removed.  Use it when the database holds domains
that do not exist now.  This occurs when a person destroys a guest without
C<bin/destroy>.  C<bin/destroy> is the only command that releases an address
by itself.

It needs F<hypervisors.conf>, and refuses to run without it, because with no
fleet nothing can say which guests run.

A domain that has a configuration but no build also has no hypervisor that
runs it.  This command cannot tell the two apart.  If you assigned addresses
before you provisioned, C<--prune> removes those assignments.

=head2 --dryrun

Do all the work inside a transaction, print what changes, and then roll the
transaction back.  The command asks the hypervisors, but it writes nothing.

=cut

sub main {
    my @args = @_;

    my $cfile = Trog::Config->path('ipmap.cfg');
    my ( $dryrun, $prune, $help );
    GetOptionsFromArray(
        \@args,
        'ipmap=s' => \$cfile,
        'dryrun'  => \$dryrun,
        'prune'   => \$prune,
        'help'    => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    my $c = Config::Simple->new($cfile);
    die "$Config::Simple::errstr\n" unless $c;
    my $pool = $c->param( -block => 'ip_pool' ) // {};

    my $db     = Provisioner::IPPool::dbh();
    my %before = %{ Provisioner::IPPool::taken() };

    # All of it or none of it.  A reseed that stops halfway leaves no
    # reservations, and then the database says that the gateway is free.
    $db->do('BEGIN IMMEDIATE');

    my $ok = eval {
        Provisioner::IPPool::forget_seeding();
        Provisioner::IPPool::clear_reservations();
        Provisioner::IPPool::ensure_seeded($pool);
        prune_absent( \%before ) if $prune;
        1;
    };

    unless ($ok) {
        my $err = $@ || "reseed failed\n";
        eval { $db->do('ROLLBACK') };    ## no critic (ErrorHandling::RequireCheckingReturnValueOfEval) -- the failure worth reporting is $err, not a rollback of it that could not run
        die $err;
    }

    my %after = %{ Provisioner::IPPool::taken() };

    # Read the result before the rollback, because the rollback removes it.
    $db->do( $dryrun ? 'ROLLBACK' : 'COMMIT' );

    report( \%before, \%after, $dryrun );
    return 0;
}

=head2 prune_absent($before)

Releases the address of each domain in C<$before> that no hypervisor runs.
C<$before> is the hashref that C<Provisioner::IPPool::taken> returns.  It skips
the C<hv:>, C<gateway:> and C<insitu:> reservations.  Returns how many it
released.

Dies when no hypervisors are configured, because then nothing can say which
guests run, and every assignment would go.

=cut

sub prune_absent {
    my ($before) = @_;

    require Trog::Hypervisors;
    my $fleet = Trog::Hypervisors->load( Trog::Hypervisors->default_path() );
    die "--prune needs hypervisors.conf: with no fleet, nothing can say which guests are running, and every assignment would be released.\n"
      unless $fleet->configured;

    my %running;
    foreach my $name ( $fleet->names ) {
        $running{$_} = 1 for $fleet->hypervisor($name)->guest_names;
    }

    my $gone = 0;
    foreach my $domain ( sort values %$before ) {
        next if $domain =~ m/\A(?:hv|gateway|insitu):/;
        next if $running{$domain};

        Provisioner::IPPool::release($domain);
        $gone++;
    }

    return $gone;
}

=head2 report($before, $after, $dryrun)

Prints each address that changed, and then a summary line.  C<$before> and
C<$after> are hash references from C<Provisioner::IPPool::taken>.  Returns 0.

=cut

sub report {
    my ( $before, $after, $dryrun ) = @_;

    my $would   = $dryrun ? 'would be ' : q{};
    my @added   = grep { !$before->{$_} } sort keys %$after;
    my @removed = grep { !$after->{$_} } sort keys %$before;
    my @moved   = grep { $before->{$_} && $after->{$_} && $before->{$_} ne $after->{$_} } sort keys %$after;

    my $summary = join(
        q{},
        ( map { sprintf "  %-18s %s\n", $_, "${would}recorded as $after->{$_}" } @added ),
        ( map { sprintf "  %-18s %s\n", $_, "${would}freed (was $before->{$_})" } @removed ),
        ( map { sprintf "  %-18s %s\n", $_, "${would}now $after->{$_}, was $before->{$_}" } @moved ),
    );

    $summary .= sprintf(
        "%s: %d added, %d freed, %d changed hands; %d addresses spoken for\n",
        ( $dryrun ? 'Nothing written' : 'Reseeded' ),
        scalar @added, scalar @removed, scalar @moved, scalar keys %$after
    );

    print $summary;

    return 0;
}

exit main(@ARGV) unless caller;

1;
