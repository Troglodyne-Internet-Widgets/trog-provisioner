#!/usr/bin/env perl

package Trog::Bin::QualifySiteData;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aasx';
use FindBin::libs;
use Getopt::Long qw{GetOptionsFromArray};
use Trog::Config();
use Pod::Usage qw{pod2usage};
use File::Slurper();
use File::Slurper::Temp();
use File::Copy();

=head1 NAME

qualify_site_data - spell out the short domain names in an older ipmap.cfg and recipes.d

=head1 SYNOPSIS

    qualify_site_data --tld troglodyne.net [--ipmap ipmap.cfg] [--recipes recipes.d] [--dryrun]

=head1 OPTIONS

=over 4

=item B<--tld> DOMAIN

The parent domain that the old format appended to every short name.  This
option is required.  The program removes the setting, so it cannot find the
value later.

=item B<--ipmap> FILE

The default is F<ipmap.cfg> in the configuration directory.  See L<Trog::Config>.

=item B<--recipes> DIR

The default is F<recipes.d> in the current directory.

=item B<--dryrun>

Show what changes, but do not change anything.

=back

=head1 DESCRIPTION

In the old format, a domain had one of two forms.  A short name got the C<tld>
of the global section appended.  A domain under a different parent was fully
qualified, and the configuration called it an "addon".  Now every domain is
written in full, as the file names in F<recipes.d> already are.

This program does the rename one time.  It qualifies these names:

=over 4

=item *

Every unqualified key in the C<[ips]> and C<[aliases]> blocks.

=item *

Every unqualified alias value.

=item *

The top-level key of each recipe file.

=back

It removes the C<[addons]> block and the C<tld> setting, which have no use now.

Before it writes a file, it copies the file to F<.bak>.  A key that contains a
dot is treated as qualified and does not change.

=cut

sub main {
    my @args = @_;

    my ( $tld, $ipmap, $recipes, $dryrun );
    GetOptionsFromArray(
        \@args,
        'tld=s'     => \$tld,
        'ipmap=s'   => \$ipmap,
        'recipes=s' => \$recipes,
        'dryrun'    => \$dryrun,
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );

    pod2usage(
        -exitval => 2, -verbose => 1, -input => __FILE__,
        -message => 'Pass --tld, the parent domain that used to be appended'
    ) unless $tld;

    $ipmap   //= Trog::Config->path('ipmap.cfg');
    $recipes //= 'recipes.d';

    qualify_ipmap( $ipmap, $tld, $dryrun );
    qualify_recipes( $recipes, $tld, $dryrun );

    print $dryrun ? "\nDry run; nothing was written.\n" : "\nDone.\n";
    return 0;
}

sub qualify_ipmap {
    my ( $path, $tld, $dryrun ) = @_;

    # Read it without a -f test first.  The file can change after the test, and
    # -f does not show whether we can read it.
    my $text = eval { File::Slurper::read_text($path) };
    return 0 unless defined $text;

    my @lines = split( m/\n/, $text, -1 );
    my ( $block, @out, $changed ) = ('');

    # A short name and a qualified name, such as `mysql` and
    # `mysql.troglodyne.net`, can be one machine with two addresses.  After the
    # rename they are one key, and one address is lost.  Refuse, because only a
    # person can know which address is live.
    my %claims;
    my $current = '';
    foreach my $line (@lines) {
        $current = $1 if $line =~ m/\A\s*\[(\w+)\]/;
        next unless $current eq 'ips';
        next unless $line =~ m/\A\s*([^=\s]+)\s*=\s*(\N*?)\s*\z/;
        my ( $key, $value ) = ( $1, $2 );
        push @{ $claims{ index( $key, q{.} ) >= 0 ? $key : "$key.$tld" } }, "$key = $value";
    }

    my @collisions = grep { @{ $claims{$_} } > 1 } sort keys %claims;
    die "Qualifying $path would collapse these into one entry each:\n" . join(
        '',
        map {
            "  $_\n" . join( '', map { "      $_\n" } @{ $claims{$_} } )
        } @collisions
      )
      . "\nOne address per domain.  Delete whichever is not the live one and run this again.\n"
      if @collisions;

    foreach my $line (@lines) {
        if ( $line =~ m/\A\s*\[(\w+)\]/ ) {
            $block = $1;

            # Every domain is fully qualified now, so [addons] has no use.
            if ( $block eq 'addons' ) {
                print "Dropping the [addons] block\n";
                $changed = 1;
            }
            push @out, $line unless $block eq 'addons';
            next;
        }
        next if $block eq 'addons';

        if ( $block eq 'global' && $line =~ m/\A\s*tld\s*=/ ) {
            print "Dropping tld= from [global]\n";
            $changed = 1;
            next;
        }

        if ( ( $block eq 'ips' || $block eq 'aliases' ) && $line =~ m/\A(\s*)([^=\s]+)(\s*=\s*)(\N*)\z/ ) {
            my ( $lead, $key, $eq, $value ) = ( $1, $2, $3, $4 );
            my $new_key = index( $key, q{.} ) >= 0 ? $key : "$key.$tld";

            # Alias values are domains too.
            my @values    = map { index( $_, q{.} ) >= 0 ? $_ : "$_.$tld" } split( /\s*,\s*/, $value );
            my $new_value = join( ', ', @values );

            if ( "$new_key$new_value" ne "$key$value" ) {
                print "  $key -> $new_key\n" if $new_key ne $key;
                $changed = 1;
            }
            push @out, "$lead$new_key$eq$new_value";
            next;
        }

        push @out, $line;
    }

    return print "$path is already fully qualified\n" unless $changed;
    return 1 if $dryrun;

    File::Copy::copy( $path, "$path.bak" ) or die "Could not back up $path: $!\n";
    File::Slurper::Temp::write_text( $path, join( "\n", @out ) );
    print "Rewrote $path (old copy at $path.bak)\n";
    return 1;
}

sub qualify_recipes {
    my ( $dir, $tld, $dryrun ) = @_;
    return 0 unless -d $dir;

    foreach my $file ( sort glob("$dir/*.yaml") ) {
        my $text = File::Slurper::read_text($file);

        # The top-level key is the domain; everything under it is indented.
        my $changed = 0;
        my @out     = map {
            my $line = $_;
            if ( $line =~ m/\A([\w-]+):\s*\z/ && $1 ne '_base' && $1 ne '_shared' ) {
                print "  $file: $1 -> $1.$tld\n";
                $changed = 1;
                "$1.$tld:";
            }
            else { $line }
        } split( m/\n/, $text, -1 );

        next unless $changed;
        next if $dryrun;

        File::Copy::copy( $file, "$file.bak" ) or die "Could not back up $file: $!\n";
        File::Slurper::Temp::write_text( $file, join( "\n", @out ) );
        print "Rewrote $file (old copy at $file.bak)\n";
    }
    return 1;
}

exit main(@ARGV) unless caller;

1;
