#!/usr/bin/env perl

package Trog::Bin::DebugBoot;

#ABSTRACT: Watch a guest boot, and stop it at the boot menu when it will not.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use File::Slurper::Temp();
use File::Temp();
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Trog::HV();
use Trog::Hypervisors();

# What this tool produces, a file name or a port, goes to stdout for capture.
# Messages to the operator go to stderr with print and not warn, and each one
# carries a no critic.  An error dies.

=head1 NAME

debug_boot - watch a guest boot, and stop it at the boot menu when it will not

=head1 SYNOPSIS

    bin/debug_boot --console vm.test  # restart it, capture the whole boot as text
    bin/debug_boot --fetch   vm.test  # read the capture again without restarting
    bin/debug_boot --hold    vm.test  # restart it and stop at the boot menu
    bin/debug_boot --shot    vm.test  # what is on the screen right now
    bin/debug_boot --vnc     vm.test  # how to get a VNC session to it
    bin/debug_boot --keys    vm.test KEY_ESC KEY_DOWN KEY_ENTER
    bin/debug_boot --restore vm.test  # put the domain and the disk back

    bin/debug_boot --cat    vm.test /var/log/cloud-init.log   # off its disk
    bin/debug_boot --ls     vm.test /etc/netplan
    bin/debug_boot --single vm.test   # boot it single-user, no keystrokes involved

=head1 DESCRIPTION

A guest that provisions and then fails keeps logs on itself, and you can read
them.  A guest that never boots keeps nothing: no lease, no ssh, and no log.
C<bin/provision> can only tell you that it never asked for an address.

This tool is for that case.  It works on a guest that ran for a year and does
not come back from a reboot.  It also works on a guest that never came up.

=head2 Start with --console

C<--console> is the most useful action.  It connects the serial port of the
guest to a file on the hypervisor and restarts the guest.  Then it gives you
each line that the kernel and systemd printed, as text in a file that you can
grep.  A hang is the last line before the silence.

A screenshot of the 80x25 console shows only the last page of a boot.

C<--console> restarts the guest, because it cannot read the output of a boot
that already happened.  Do not use it on a guest that you cannot restart.

=head2 --hold, when you need to be in there

C<--hold> turns on the boot menu of the firmware with a timeout, and restarts
the guest.  The guest then stops at the menu and does not boot past the thing
that you want to change.  Then C<--vnc> tells you how to open a session, and
C<--keys> sends keystrokes.  That is the same as holding ESC by hand, and about
as reliable.

If the hypervisor has libguestfs, use C<--single> instead.  C<bin/preflight>
tells you if it has.  C<--single> writes C<single> onto the kernel command line
in the grub.cfg of the guest.  The guest then comes up in rescue mode without
help.  There is no short window to catch and there are no keystrokes to get
right.

=head2 Reading the disk without booting at all

C<--cat> and C<--ls> read the filesystem of the guest while it is off.  Use them
to read the cloud-init log of a guest that never got an address, or to see the
netplan that it got.  Both need libguestfs on the hypervisor.

If the guest is running, they do not stop it, and they read it anyway.
libguestfs opens the disk read-only for them.  That is safe, but what they read
can be out of date.  C<--single> writes to the disk, so the guest must be off.

=head2 Putting it back

C<--console> and C<--hold> change the definition of the domain.  C<--single>
changes the grub.cfg on the disk of the guest.  C<--restore> undoes all three,
but it undoes the disk change only when the guest is off.  Restart the guest
after C<--restore>.  If you destroy the domain after you debug it, you do not
need C<--restore>.

=head1 OPTIONS

=over 4

=item B<--console>, B<--fetch>, B<--hold>, B<--shot>, B<--vnc>, B<--keys>, B<--restore>

=item B<--cat> PATH, B<--ls> PATH, B<--single>

Give one.  See the synopsis.  If you give more than one, the first in this list
is the one that runs.

=item B<--wait> SECONDS

How long C<--console> lets the guest boot before it reads the console.  Default
45.

=item B<--timeout> MS

How long the boot menu waits, with C<--hold>.  Default 30000.

=item B<--into> FILE

Where C<--console>, C<--fetch>, C<--shot> and C<--cat> write what they read.
Each one prints the path.  C<--shot> defaults to a file in F</tmp> named for
the domain.  The others default to a new temporary file.

=item B<--connect> URI, B<--hvconf> FILE

The hypervisor that has the guest.  Without C<--connect>, this asks the fleet in
C<--hvconf>, or in the default fleet file, which hypervisor has the guest.

=back

=cut

our $LOG_DIR = '/tmp';

# How much of a screenshot to take off the libvirt stream at a time.
our $STREAM_CHUNK = 65_536;

# A screenshot's file extension, by the MIME type libvirt reports for it.
my %EXTENSION = ( 'image/png' => 'png', 'image/x-portable-pixmap' => 'ppm' );

sub main {
    my @args = @_;

    my %opt = ( wait => 45, timeout => 30000 );
    GetOptionsFromArray(
        \@args, \%opt,
        qw{console fetch hold shot vnc keys restore cat ls single
          wait=i timeout=i into=s connect=s hvconf=s help}
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $opt{help};

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    my ($action) = grep { $opt{$_} } qw{console fetch hold shot vnc keys restore cat ls single};
    pod2usage(
        -exitval => 2, -verbose => 1, -input => __FILE__,
        -message => 'Pick one of --console --fetch --hold --shot --vnc --keys --restore --cat --ls --single'
    ) unless $action;

    my $hv = hypervisor( $domain, $opt{connect}, $opt{hvconf} );

    return console( $hv, $domain, \%opt )           if $action eq 'console';
    return fetch( $hv, $domain, \%opt )             if $action eq 'fetch';
    return hold( $hv, $domain, \%opt )              if $action eq 'hold';
    return shot( $hv, $domain, \%opt )              if $action eq 'shot';
    return vnc( $hv, $domain )                      if $action eq 'vnc';
    return keys_to( $hv, $domain, @args )           if $action eq 'keys';
    return guest_cat( $hv, $domain, \@args, \%opt ) if $action eq 'cat';
    return guest_ls( $hv, $domain, \@args )         if $action eq 'ls';
    return single( $hv, $domain )                   if $action eq 'single';
    return restore( $hv, $domain );
}

sub hypervisor {
    my ( $domain, $uri, $hvconf ) = @_;

    return Trog::HV->new( uri => $uri ) if $uri;

    my $fleet = Trog::Hypervisors->load( $hvconf // Trog::Hypervisors->default_path() );
    return Trog::HV->new() unless $fleet->configured;

    return $fleet->hosting($domain)
      || die "No hypervisor in the fleet has $domain.\n" . "Pass --connect if it is somewhere the fleet does not list.\n";
}

sub log_path { return "$LOG_DIR/$_[0]-console.log" }

# --- Reshaping the domain ------------------------------------------------------
# Both of these edit the persistent definition and restart the guest, because
# the output of a boot that already happened cannot be read again.
sub console {
    my ( $hv, $domain, $opt ) = @_;

    my $xml = definition( $hv, $domain );
    my $log = log_path($domain);

    die "$domain already logs its console to a file; --fetch reads it,\n" . "and --restore puts it back.\n"
      if index( $xml, q{<serial type='file'} ) >= 0;

    # libvirt writes the serial output directly to this file.  Nothing must hold
    # a pty open, and the capture starts at the first line of the firmware.
    $xml =~ s{<serial[ ]type='pty'>}{<serial type='file'><source path='$log'/>}
      or die "$domain has no pty serial port to redirect.\n";

    redefine( $hv, $domain, $xml );
    restart( $hv, $domain );

    print {*STDERR} "Letting it boot for $opt->{wait}s...\n";    ## no critic (ProhibitPrintSTDERR)
    sleep $opt->{wait};

    return fetch( $hv, $domain, $opt );
}

sub hold {
    my ( $hv, $domain, $opt ) = @_;

    my $xml = definition( $hv, $domain );
    $xml =~ s{<os>}{<os><bootmenu enable='yes' timeout='$opt->{timeout}'/>}
      if index( $xml, '<bootmenu' ) < 0;

    redefine( $hv, $domain, $xml );
    restart( $hv, $domain );

    printf {*STDERR} "%s is holding at the boot menu for %ds.\n", $domain, $opt->{timeout} / 1000;    ## no critic (ProhibitPrintSTDERR)
    return vnc( $hv, $domain );
}

sub restore {
    my ( $hv, $domain ) = @_;

    my $xml = definition( $hv, $domain );
    my $log = log_path($domain);

    # libvirt reformats the XML and puts <source> on a line of its own.  The
    # match is on the log path, because that is the part that is ours.
    $xml =~ s{<serial[ ]type='file'>\s*<source[ ]path='\Q$log\E'\s*/>}{<serial type='pty'>};
    $xml =~ s{<bootmenu[^>]*/>}{};

    redefine( $hv, $domain, $xml );

    # Undo --single on the disk too, but only when the guest is off.  A write
    # to the disk of a running guest corrupts it.
    my $dom = eval { $hv->vmm->get_domain_by_name($domain) };
    if ( $dom && !$dom->is_active() ) {
        my ( undef, $rc ) = guest_tool(
            $hv,  'virt-edit', '-d', $domain, '/boot/grub/grub.cfg',
            '-e', 's/^([ \t]*linux[ \t]+[^\n]*?)[ \t]+single[ \t]*$/$1/m'
        );
        print {*STDERR} "Took single back off the kernel command line.\n" unless $rc;    ## no critic (ProhibitPrintSTDERR)
    }

    print {*STDERR} "Restored $domain; restart it for that to take effect.\n";           ## no critic (ProhibitPrintSTDERR)
    return 0;
}

# --- Reading it back -----------------------------------------------------------
sub fetch {
    my ( $hv, $domain, $opt ) = @_;

    my $log = log_path($domain);

    # sudo, because libvirt writes the file as root.
    my $content = $hv->capture_cmd("sudo cat '$log'");
    unless ($content) {
        print {*STDERR} "Nothing at $log on the hypervisor.\n" . "Was this started with --console?\n";    ## no critic (ProhibitPrintSTDERR)
        return 1;
    }

    my $into = $opt->{into} // File::Temp->new(
        TEMPLATE => "trog-console-$domain-XXXX",
        TMPDIR   => 1, SUFFIX => '.log', UNLINK => 0
    )->filename;
    File::Slurper::Temp::write_text( $into, $content );

    my @lines = split m/\n/, $content;
    ## no critic (ProhibitPrintSTDERR)
    print {*STDERR} sprintf( "%d lines of console. The last of them:\n\n", scalar @lines ) . join( q{}, map { "  $_\n" } @lines[ -8 .. -1 ] ) . "\nA hang is the last line before the silence.\n\n";
    ## use critic

    print "$into\n";
    return 0;
}

=head1 SUBROUTINES

=head2 shot($hv, $domain, \%opt)

Take a screenshot of the console of C<$domain> as it is now.  libvirt streams
the image to this process.  Writes it to C<< $opt->{into} >>, or to the path
that C<screen_file> gives, and prints that path.  Returns 0.

Dies if there is no such domain, or if libvirt cannot take the screenshot.

=cut

sub shot {
    my ( $hv, $domain, $opt ) = @_;

    my $vmm = $hv->vmm;
    my $dom = eval { $vmm->get_domain_by_name($domain) }
      or die "No domain called $domain on " . $hv->describe . "\n";

    my $stream = $vmm->new_stream(0);
    my $mime   = eval { $dom->screenshot( $stream, 0 ) }
      or die "Could not screenshot $domain.\n";

    my $image = q{};
    while (1) {
        my $chunk;
        last if $stream->recv( $chunk, $STREAM_CHUNK ) <= 0;
        $image .= $chunk;
    }
    $stream->finish();

    my $into = $opt->{into} // screen_file( $domain, $mime );
    File::Slurper::Temp::write_binary( $into, $image );

    print {*STDERR} "Console of $domain as it is right now.\n";    ## no critic (ProhibitPrintSTDERR)
    print "$into\n";
    return 0;
}

=head2 $path = screen_file($domain, $mime)

The default path in F</tmp> for a screenshot of C<$domain>.  The extension comes
from C<$mime>, the MIME type that libvirt reports: F<.png>, F<.ppm>, or F<.img>
for any other type.  On libvirt 10.0.0, qemu sends C<image/png>.

=cut

sub screen_file {
    my ( $domain, $mime ) = @_;
    return "/tmp/$domain-screen." . ( $EXTENSION{ $mime // q{} } // 'img' );
}

sub vnc {
    my ( $hv, $domain ) = @_;

    my $dom = eval { $hv->vmm->get_domain_by_name($domain) }
      or die "No domain called $domain on " . $hv->describe . "\n";

    my $vnc = vnc_port( $dom->get_xml_description() )
      or die "$domain has no display to connect to.\n";

    # The display listens on the loopback of the hypervisor, so the operator
    # needs an ssh tunnel to it.
    ## no critic (ProhibitPrintSTDERR)
    my $through = $hv->ssh_target // 'localhost';
    print {*STDERR} <<"TUNNEL";
$domain has VNC on port $vnc, on the hypervisor's loopback.

  ssh -N -L $vnc:127.0.0.1:$vnc $through
  then point a VNC client at 127.0.0.1:$vnc

TUNNEL
    ## use critic

    print "$vnc\n";
    return 0;
}

=head2 $port = vnc_port($xml)

The port of the VNC display in C<$xml>, the live definition of a domain.
Returns undef if there is no VNC display with a port.  A display with
C<autoport='yes'> has C<port='-1'> until the domain runs, and that also returns
undef.

=cut

sub vnc_port {
    my ($xml) = @_;

    foreach my $graphics ( $xml =~ m{<graphics\b[^>]*>}g ) {
        next if index( $graphics, q{type='vnc'} ) < 0;
        my ($port) = $graphics =~ m{\bport='(-?\d+)'};
        return $port if defined $port && $port > 0;
    }

    return undef;
}

sub keys_to {
    my ( $hv, $domain, @keys ) = @_;

    @keys = qw{KEY_ESC} unless @keys;
    print {*STDERR} "Sending @keys to $domain\n";    ## no critic (ProhibitPrintSTDERR)

    # virsh, because Sys::Virt::Domain::send_key takes only numeric keycodes.
    # The table that maps a name like KEY_ESC to a keycode is inside virsh, and
    # Sys::Virt cannot reach it.
    $hv->run_cmd( qw{virsh -c qemu:///system send-key}, $domain, qw{--holdtime 100}, @keys ) == 0
      or die "Could not send @keys to $domain.\n";

    return 0;
}

# --- Reading and writing the disk ----------------------------------------------
# All of these need libguestfs on the hypervisor.  bin/preflight reports if it
# is there.
sub guest_tool {
    my ( $hv, $tool, @args ) = @_;

    my $out = $hv->capture_cmd( join ' ', 'sudo', $tool, map { _shq($_) } @args );
    my $rc  = $? >> 8;

    die "$tool is not on " . $hv->describe . ".\n" . "  sudo apt install libguestfs-tools\n" if $rc == 127;

    return ( $out, $rc );
}

sub _shq {
    my ($word) = @_;
    $word =~ s/'/'\\''/g;
    return "'$word'";
}

sub guest_cat {
    my ( $hv, $domain, $args, $opt ) = @_;

    my $path = shift @$args
      or die "--cat wants a path on the guest: --cat $domain /var/log/cloud-init.log\n";

    my ( $content, $rc ) = guest_tool( $hv, 'virt-cat', '-d', $domain, $path );
    die "Could not read $path out of $domain.\n$content" if $rc;

    my $into = $opt->{into} // File::Temp->new(
        TEMPLATE => 'trog-guestfile-XXXX',
        TMPDIR   => 1, UNLINK => 0
    )->filename;
    File::Slurper::Temp::write_text( $into, $content );

    printf {*STDERR} "%s:%s -- %d bytes, read off the disk\n", $domain, $path, length $content;    ## no critic (ProhibitPrintSTDERR)
    print "$into\n";
    return 0;
}

sub guest_ls {
    my ( $hv, $domain, $args ) = @_;

    my $path = shift @$args // '/';
    my ( $out, $rc ) = guest_tool( $hv, qw{virt-ls -l -d}, $domain, $path );
    die "Could not list $path in $domain.\n$out" if $rc;

    print $out;
    return 0;
}

=head2 single($hv, $domain)

Add C<single> to the kernel command line of each C<linux> line in the
F</boot/grub/grub.cfg> of the guest.  Then start the guest and print how to
reach its VNC display.  Each menu entry gets it, because this cannot choose the
entry that boots.  Returns 0.

Dies if there is no such domain, if the guest is running, if C<virt-edit> fails,
or if the guest has no VNC display.

=cut

sub single {
    my ( $hv, $domain ) = @_;

    my $dom = $hv->vmm->get_domain_by_name($domain)
      or die "No domain called $domain on " . $hv->describe . "\n";

    # A write to the disk of a running guest corrupts it.  libguestfs also
    # refuses, but this message is clearer than its error.
    die "$domain is running.  Stop it before writing to its disk:\n" . "  virsh -c " . $hv->uri . " destroy $domain\n" if $dom->is_active();

    # [ \t] and [^\n], never \s or ., because virt-edit gives the expression a
    # line with its newline.  A trailing \s* eats the newline and joins the
    # next line on.  In grub.cfg that is the initrd line, and the guest then
    # does not boot.
    my ( $out, $rc ) = guest_tool(
        $hv,  'virt-edit', '-d', $domain, '/boot/grub/grub.cfg',
        '-e', 's/^([ \t]*linux[ \t]+\S+[^\n]*?)([ \t]+single)?[ \t]*$/$1 single/m'
    );
    die "Could not put single on the kernel command line of $domain.\n$out" if $rc;

    $dom->create();
    print {*STDERR} "$domain is booting single-user.  Undo it with --restore.\n\n";    ## no critic (ProhibitPrintSTDERR)

    return vnc( $hv, $domain );
}

# --- Talking to libvirt --------------------------------------------------------
sub definition {
    my ( $hv, $domain ) = @_;

    my $dom = eval { $hv->vmm->get_domain_by_name($domain) }
      or die "No domain called $domain on " . $hv->describe . "\n";

    # Inactive, so this returns the definition and not the runtime state.  The
    # runtime state has allocated ptys and aliases that libvirt cannot define.
    return $dom->get_xml_description( Sys::Virt::Domain::XML_INACTIVE() );
}

sub redefine {
    my ( $hv, $domain, $xml ) = @_;
    $hv->vmm->define_domain($xml);
    return 1;
}

sub restart {
    my ( $hv, $domain ) = @_;

    my $dom = $hv->vmm->get_domain_by_name($domain);
    $dom->destroy() if $dom->is_active();
    sleep 2;
    $dom = $hv->vmm->get_domain_by_name($domain);
    $dom->create();

    print {*STDERR} "Restarted $domain\n";    ## no critic (ProhibitPrintSTDERR)
    return 1;
}

exit main(@ARGV) unless caller;

1;
