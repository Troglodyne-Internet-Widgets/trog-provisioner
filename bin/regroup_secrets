#!/usr/bin/env perl

package Provisioner::Bin::regroup_secrets;

#ABSTRACT: Move each secret this tooling wrote into the group its reference names.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use List::Util   qw{any};
use Pod::Usage   qw{pod2usage};

use File::KeePass::KDBX();

use Provisioner::Cookbook();
use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();

=head1 USAGE

    regroup_secrets [--secrets FILE] [--dryrun]

Move each entry that this tooling wrote into the group that its reference
names.  Run it once, after upgrading to a version of L<Trog::Secrets> that
reads by group.

C<--dryrun> opens the store, says what it would move and writes nothing.

=head1 DESCRIPTION

A reference says which group holds a secret:

    secret:registrar/easydns_token/password

L<Trog::Secrets> used to pass that group to C<File::KeePass::KDBX> in a query
key the shim does not answer to, so the group was silently dropped.  Every
entry this tooling wrote landed in the root group instead, and every read
matched on the title alone -- which worked until one title existed twice, and
then every lookup of that title died naming neither of them.

Reads are by group now.  An entry that the old code left in the root group is
therefore an entry that the new code cannot find, and a reference it cannot
find is one that C<bin/new_config> generates a fresh value for: a new guest
key, a new bot key, a new registration secret.  This moves them first, so that
nothing is regenerated.

An entry an operator filed by hand is already where its reference says, and
this leaves it alone.

=head2 WHAT IT MOVES

Only an entry whose reference this installation asks for, which
L<Provisioner::Cookbook/secret_references> answers, and only when the group
that reference names does not hold it already.

It moves the whole entry, with every field, and then removes the one it copied
from.  A title that appears more than once outside the target group is left
where it is and named in the report: nothing here can tell which of them is the
one a guest was built with, and moving the wrong one is worse than moving
neither.

=head1 SUBROUTINES

=head2 $rc = main(@args)

Moves what it can and prints what it did.  Returns 0, or 1 when it left
something it could not place.

=cut

sub main {
    my @args = @_;

    my ( $store, $dryrun, $help );
    GetOptionsFromArray(
        \@args,
        'secrets=s' => \$store,
        'dryrun'    => \$dryrun,
        'help'      => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    $store //= Trog::Config->path('secrets.kdbx');

    my @refs = Provisioner::Cookbook->secret_references();
    unless (@refs) {
        print "This installation asks the store for nothing, so there is nothing to move.\n";
        return 0;
    }

    my $password = Trog::Credentials->prompt( 'Enter password:', 'keepass' );

    # Held from the load to the save, because a provision can seal a key meanwhile.
    return Trog::Secrets->locked(
        $store,
        sub {
            my $kdbx = File::KeePass::KDBX->load_db( $store, $password )
              or die "Could not open $store\n";
            $kdbx->unlock() or die "Could not unlock $store\n";

            my ( @moved, @kept, @ambiguous, @missing, @copies );
            foreach my $ref (@refs) {
                my ( $group, $title ) = Trog::Secrets->parse($ref);

                my $target = $kdbx->find_group( { title => $group } );
                if ( $target && any { ( $_->{title} // q{} ) eq $title } @{ $target->{entries} // [] } ) {
                    push( @kept, $ref );

                    # Where the reference points is settled, so this moves nothing.
                    # It is still worth saying: a second copy of a private key is a
                    # second place it can be read from.
                    my @elsewhere = strays_for( $kdbx, $title, $target );
                    push( @copies, "$ref (a copy is also in " . join( ', ', map { $_->{path} } @elsewhere ) . ')' ) if @elsewhere;
                    next;
                }

                my @strays = strays_for( $kdbx, $title, $target );
                unless (@strays) {
                    push( @missing, $ref );
                    next;
                }

                if ( @strays > 1 ) {
                    push( @ambiguous, "$ref (in " . join( ', ', map { $_->{path} } @strays ) . ')' );
                    next;
                }

                push( @moved, $ref );
                next if $dryrun;

                $target //= $kdbx->add_group( { title => $group } );
                my $stray = $strays[0]{entry};

                # Copied field by field rather than handed over whole, because the
                # entry carries its place in the database with it.
                my %fields = map { $_ => $stray->{$_} } grep { defined $stray->{$_} } qw{title username password url comment};
                $kdbx->add_entry( { %fields, group => $target } );
                $kdbx->delete_entry( { id => $stray->{id} } );
            }

            report( $store, $dryrun, moved => \@moved, kept => \@kept, ambiguous => \@ambiguous, missing => \@missing, copies => \@copies );

            if ( @moved && !$dryrun ) {
                $kdbx->save_db( $store, $password );
                $kdbx->lock();

                # Read back through the interface that a provision uses, because the
                # point of the move is that those reads find these entries.
                my %check  = map { $_ => $_ } @moved;
                my %held   = Trog::Secrets->lookup( $store, $password, %check );
                my @unheld = grep { !defined $held{$_} } @moved;
                die "$store did not come back holding " . join( ', ', @unheld ) . "\n" if @unheld;

                print "\nEach one reads back from its group.\n";
            }
            else {
                $kdbx->lock();
            }

            return @ambiguous ? 1 : 0;
        }
    );
}

=head2 @strays = strays_for($kdbx, $title, $target)

Every entry called C<$title> that is not in C<$target>, as a hash of the entry
and the path of the group holding it.

=cut

sub strays_for {
    my ( $kdbx, $title, $target ) = @_;

    my @strays;
    my $walk;
    $walk = sub {
        my ( $groups, $path ) = @_;

        foreach my $group ( @{ $groups // [] } ) {
            my $here = $path ? "$path/$group->{title}" : ( $group->{title} // q{} );

            foreach my $entry ( @{ $group->{entries} // [] } ) {
                next unless ( $entry->{title} // q{} ) eq $title;
                next if $target && $group->{id} && $target->{id} && $group->{id} eq $target->{id};

                push( @strays, { entry => $entry, path => $here } );
            }

            $walk->( $group->{groups}, $here );
        }

        return;
    };
    $walk->( $kdbx->groups, q{} );

    return @strays;
}

=head2 report($store, $dryrun, \%outcome)

Prints what happened, in the order somebody reads it: what moved, what was
already right, what could not be placed, and what the store does not hold at
all.  C<%outcome> holds those lists, keyed C<moved>, C<kept>, C<ambiguous>,
C<missing> and C<copies>.  Returns 1.

=cut

sub report {
    my ( $store, $dryrun, %outcome ) = @_;

    my $said = $dryrun ? "Dry run against $store; nothing is written.\n\n" : "In $store:\n\n";

    $said .= @{ $outcome{moved} } ? "Moved into the group its reference names:\n" . as_list( $outcome{moved} ) . "\n" : "Nothing to move.\n\n";
    $said .= 'Already in the right group: ' . scalar @{ $outcome{kept} } . "\n" if @{ $outcome{kept} };

    $said .= "\nLeft alone, because more than one entry answers to the name:\n" . as_list( $outcome{ambiguous} ) . "Delete the one that is not wanted, with bin/forget_secret or KeePassXC, and run this again.\n"
      if @{ $outcome{ambiguous} };

    $said .= "\nAlso held somewhere else, which nothing reads now:\n" . as_list( $outcome{copies} ) . "bin/forget_secret removes one, once you are sure the one that is read is right.\n"
      if @{ $outcome{copies} };

    $said .= "\nNot in the store at all, which is what a first provision generates:\n" . as_list( $outcome{missing} ) . "\nIf one of those is a key something outside this machine trusts, put it in\n" . "before the next provision, with bin/add_secret.\n"
      if @{ $outcome{missing} };

    print $said;
    return 1;
}

=head2 $text = as_list($refs)

The references in C<$refs>, one indented line each.

=cut

sub as_list {
    my ($refs) = @_;
    return join( q{}, map { "  $_\n" } @$refs );
}

exit main(@ARGV) unless caller;

1;
