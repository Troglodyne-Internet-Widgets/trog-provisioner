#!/usr/bin/env perl

package Trog::Bin::GuestKey;

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use File::Copy();
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage;

use FindBin::libs;

use Trog::Guest();
use Trog::HV();

=head1 NAME

guest_key - give out the key that opens a guest.

=head1 USAGE

    guest_key DOMAIN [--out FILE]

=head1 DESCRIPTION

The private half of the key of a guest is in the secret store, not in the
domain directory.  See L<Trog::Guest>.  The tools that provision, restore or
query a guest get the key from the store without help, so they do not need
this.

Use it when you must hold the key yourself: for an ssh by hand, an rsync that
this tool does not do, or a debugging session.

    bin/guest_key --out /tmp/vm.key vm.example.com
    ssh -i /tmp/vm.key admin@vm.example.com

Without C<--out>, it writes the key to a private temporary file and prints the
path, not the key.  That file belongs to this process and is deleted when the
process exits.  Thus a command substitution does not work.  The shell runs
guest_key to the end before ssh starts, and by then the file is gone.  Without
C<--out>, it is for a caller that reads the path and opens the file in the same
process, as everything in lib/ does.  If the domain directory still has
F<key.rsa>, it prints the path of that file instead.

C<--out> writes the key to a path that you choose and keeps it there.  That puts
a copy of the credential for the machine back on a disk, which the store is
there to prevent.  The option exists because sometimes you need it, and a
warning tells you so.

=head1 OPTIONS

=over 4

=item B<--out> FILE

Write the key to FILE and keep it there, not in a temporary file.  The file
gets mode 0600.  If FILE already exists, guest_key refuses.

=back

=cut

sub main {
    my @args = @_;

    my ( $out, $help );
    GetOptionsFromArray(
        \@args,
        'out=s' => \$out,
        'help'  => \$help,
    ) or pod2usage( -exitval => 2 );
    pod2usage( -exitval => 0, -verbose => 2 ) if $help;

    my $domain = shift @args or pod2usage( -exitval => 2, -message => "Which domain?\n" );

    # A domain not provisioned since its key was sealed still keeps it here.
    my $on_disk = Trog::HV->new()->domain_dir . "/$domain/key.rsa";
    my $path    = Trog::Guest->key_path( $domain, $on_disk );

    die "No key for $domain, in the store or at $on_disk.\n" . "A domain that has never been provisioned has none yet.\n"
      unless defined $path;

    return _print($path) unless defined $out;

    # Refuse, do not overwrite: a file here is usually an old copy that nobody
    # removed.
    die "$out is already there.  Move it aside, or pick another name.\n" if -e $out;

    File::Copy::copy( $path, $out ) or die "Could not write $out: $!\n";
    chmod 0600, $out or die "Could not make $out private: $!\n";

    warn "$out is the way in to $domain, and it will stay there until you remove it.\n";
    return _print($out);
}

sub _print { print "$_[0]\n"; return 0 }

exit main(@ARGV) unless caller;

1;
