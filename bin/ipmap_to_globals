#!/usr/bin/env perl

package Trog::Bin::IpmapToGlobals;

#ABSTRACT: Move the settings of an older ipmap.cfg into the _global of recipes.yaml.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Config::Simple();
use File::Copy();
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};
use YAML::XS();

use File::Slurper();
use File::Slurper::Temp();
use Provisioner::Cookbook();
use Provisioner::Utils();
use Trog::Config();

=head1 NAME

ipmap_to_globals - move the settings of an older ipmap.cfg into recipes.yaml

=head1 SYNOPSIS

    ipmap_to_globals [--ipmap FILE] [--recipes FILE] [--dryrun]

=head1 OPTIONS

=over 4

=item B<--ipmap> FILE

The file to read.  The default is F<ipmap.cfg> in the configuration directory.
See L<Trog::Config>.

=item B<--recipes> FILE

The file to write into.  The default is F<recipes.yaml> beside it.

=item B<--dryrun>

Print what would change, and write nothing.

=back

=head1 DESCRIPTION

An installation used to describe a guest in two files.  F<recipes.yaml> held
what recipes share, in the C<_global> of C<_base>, and F<ipmap.cfg> held who
administers a guest, how it reaches the network, and where its addresses come
from.  Nothing distinguished the two lists.  They are one list now, in
F<recipes.yaml>, and L<Provisioner::Cookbook/global_schema> declares it.

This program does that move, once, for an installation that has the older file.
It reads these blocks:

=over 4

=item * C<[global]> becomes the C<_global> of C<_base>, key for key.  A key that
nothing declares stays behind, and the report names it.  C<resolvers> and
C<gateway> are two: the block of each hypervisor in F<hypervisors.conf> names
them now.  See L<Provisioner::Cookbook/declared_globals>.

=item * C<[ip_pool]> stays behind, and the report names it.  It is the pool of
the guests of a network, and the block of each hypervisor on that network names
it now, as C<pool_addresses> and C<pool_cidr>.  See L<Trog::HV/guest_pool>.

=item * C<[nameservers]> stays behind, and the report names it.  A zone that a
pdns guest holds names only the C<ns1> of that guest.

=item * C<[aliases]> is per domain: each name becomes C<aliases> in the
C<_global> of that domain.

=back

C<[ips]> is not moved.  Addresses live in F<ips.db>, which
L<Provisioner::IPPool> owns, and nothing has read C<[ips]> since
C<bin/assign_ip> took over handing them out.

A key that F<recipes.yaml> already sets is left alone, and named in the report.
The file is copied to F<recipes.yaml.bak> before it is written.  This does not
delete F<ipmap.cfg>: nothing reads it afterwards, and deleting somebody's
configuration is not this program's decision.

=head1 SUBROUTINES

=head2 $rc = main(@args)

Runs the move.  Returns 0, or 2 for a usage error.

=cut

sub main {
    my @args = @_;

    my ( $ipmap, $recipes, $dryrun, $help );
    GetOptionsFromArray(
        \@args,
        'ipmap=s'   => \$ipmap,
        'recipes=s' => \$recipes,
        'dryrun'    => \$dryrun,
        'help'      => \$help,
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    $ipmap   //= Trog::Config->path('ipmap.cfg');
    $recipes //= Trog::Config->path('recipes.yaml');

    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- whether there is anything to move
    die "There is no $ipmap to move; this installation has nothing to do here.\n" unless -f $ipmap;

    my $from = Config::Simple->new($ipmap) or die "Could not read $ipmap: $Config::Simple::errstr\n";
    my $into = -f $recipes ? YAML::XS::LoadFile($recipes) : {};
    $into = {} unless ref $into eq 'HASH';

    my ( $moved, $kept, $dropped ) = move_into( $from, $into );

    unless (@$moved) {
        print "Nothing in $ipmap is missing from $recipes.\n";
        return 0;
    }

    my $report = "From $ipmap into $recipes:\n" . join( q{}, map { "  $_\n" } @$moved );
    $report .= "\nLeft as $recipes already has it:\n" . join( q{}, map { "  $_\n" } @$kept )                    if @$kept;
    $report .= "\nLeft out, because recipes.yaml does not take it:\n" . join( q{}, map { "  $_\n" } @$dropped ) if @$dropped;
    print $report;

    if ($dryrun) {
        print "\nDry run; nothing was written.\n";
        return 0;
    }

    File::Copy::copy( $recipes, "$recipes.bak" ) or die "Could not back $recipes up: $!\n"
      if -f $recipes;
    File::Slurper::Temp::write_text( $recipes, YAML::XS::Dump($into) );

    print "\nWrote $recipes, with the old copy at $recipes.bak.\n" . "Nothing reads $ipmap now.\n";
    return 0;
}

=head2 (\@moved, \@kept, \@dropped) = move_into($from, $into)

Folds the blocks of C<$from>, a L<Config::Simple>, into C<$into>, the
configuration as YAML gives it.  Changes C<$into> in place.  Returns what it
moved, what it left because C<$into> already said it, and what it left because
F<recipes.yaml> does not take it, all as lines to print.

=cut

sub move_into {
    my ( $from, $into ) = @_;

    my ( @moved, @kept, @dropped );
    my $global   = $into->{_base}{_global} //= {};
    my %declared = map { $_ => 1 } Provisioner::Cookbook->declared_globals;

    my $said = $from->param( -block => 'global' ) // {};
    foreach my $key ( sort keys %$said ) {
        if ( !$declared{$key} ) {
            push( @dropped, "[global] $key" );
            next;
        }

        if ( exists $global->{$key} ) {
            push( @kept, "_base._global.$key" );
            next;
        }

        $global->{$key} = $said->{$key};
        push( @moved, "[global] $key -> _base._global.$key" );
    }

    push( @dropped, '[ip_pool], which is pool_addresses and pool_cidr in the block of each hypervisor in hypervisors.conf' )
      if %{ $from->param( -block => 'ip_pool' ) // {} };

    push( @dropped, '[nameservers], because a zone of a pdns guest names only its own ns1' )
      if %{ $from->param( -block => 'nameservers' ) // {} };

    my $aliases = $from->param( -block => 'aliases' ) // {};
    foreach my $domain ( sort keys %$aliases ) {
        my $own = $into->{$domain}{_global} //= {};

        if ( exists $own->{aliases} ) {
            push( @kept, "$domain._global.aliases" );
            next;
        }

        $own->{aliases} = Provisioner::Utils::coerce_arrayref( $aliases->{$domain} );
        push( @moved, "[aliases] $domain -> $domain._global.aliases" );
    }

    return ( \@moved, \@kept, \@dropped );
}

exit main(@ARGV) unless caller;

1;
