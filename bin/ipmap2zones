#!/usr/bin/env perl

#ABSTRACT: generate a zonefile for a configured guest

package Trog::Provisioner::IPMap2Zones;

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use Time::HiRes qw{time};
use FindBin;
use FindBin::libs;

use Text::Xslate;
use Text::Xslate::Bridge::TT2;
use Net::IP;
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};
use Provisioner::Cookbook();
use Trog::Config();
use Provisioner::IPPool();
use File::Slurper::Temp;

=head1 NAME

ipmap2zones - write a zone file for each guest you name

=head1 SYNOPSIS

    ipmap2zones [--recipes=file] [--output-dir=dir] DOMAIN [DOMAIN ...]

=head1 DESCRIPTION

Generates BIND-style zone files, one file for each domain that you name.  The
addresses come from the address database of L<Provisioner::IPPool>.  The
administrator's email and the aliases come from the C<_global> of
F<recipes.yaml>.

It writes each file as C<domain.zone> in the current directory, or in the
directory that --output-dir names.

It renders C<templates/files/pdns.zone.tt>, the template that the pdns recipe
installs.  The output is not always the same as what the recipe installs,
because it has no extra records.

At least one domain must be named: a zone carries the names its recipes declare
(see L<Provisioner::Recipe/subdomains>), so the answer differs per domain.

=head1 OPTIONS

=over 4

=item --recipes=FILE

Path to F<recipes.yaml>.  The default is the one in the configuration
directory.  See L<Trog::Config>.

=item --output-dir=DIR

Directory to write zone files into.  The default is the current directory.  The
directory must already exist.

=back

=cut

sub main {
    my @args = @_;

    my ( $rfile, $output_dir, $help );
    GetOptionsFromArray(
        \@args,
        'recipes=s'    => \$rfile,
        'output-dir=s' => \$output_dir,
        'help'         => \$help,
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    $rfile      //= Trog::Config->path('recipes.yaml');
    $output_dir //= '.';

    die "Output directory $output_dir does not exist\n" unless -d $output_dir;

    my $rconf       = Provisioner::Cookbook->configuration($rfile);
    my $global_conf = Provisioner::Cookbook->base_globals($rconf);
    my $ip_conf     = Provisioner::IPPool::assignments();
    my $alias_conf  = Provisioner::Cookbook->alias_map($rconf);

    my @domains = @args;
    die "Name at least one domain to generate a zone for.  See ipmap2zones --help.\n" unless @domains;

    my $template_dir = "$FindBin::Bin/../templates";
    my $tt           = Text::Xslate->new(
        {
            path     => [$template_dir],
            syntax   => 'TTerse',
            module   => [qw{Text::Xslate::Bridge::TT2}],
            function => {
                reverse_ip => Text::Xslate::html_builder(
                    sub {
                        my $ip = shift;
                        return Net::IP->new($ip)->reverse_ip();
                    }
                ),
                email_for_dns => Text::Xslate::html_builder(
                    sub {
                        my $email = shift;
                        $email =~ tr/@/./;
                        return $email;
                    }
                ),
            },
        }
    );

    foreach my $domain (@domains) {
        die "No address for '$domain' in " . Provisioner::IPPool::db_path() . "\n"
          unless $ip_conf->{$domain};

        my @recipes    = recipes_for($domain);
        my $configured = Provisioner::Cookbook->domain_config($domain);

        # The names that the recipes hand whatever holds the zone: see
        # served_names in Provisioner::Recipe.  Each recipe gets its own
        # configuration, because some names come from it, such as the
        # public_names of nginx.
        my @hostnames = map { Provisioner::Cookbook->load($_)->served_names( %{ ref $configured->{$_} eq 'HASH' ? $configured->{$_} : {} }, domain => $domain ) } @recipes;

        my $registrar = Provisioner::Cookbook->load('registrar');
        my %vars      = (
            domain         => $domain,
            ipmap          => $ip_conf,
            domain_aliases => [ $registrar->zone_aliases( domain => $domain, aliases => $alias_conf, hostnames => \@hostnames, modules => \@recipes ) ],
            address_names  => [ $registrar->zone_address_names( domain => $domain, modules => \@recipes ) ],
            zone_records   => [ $registrar->zone_records( domain => $domain, modules => \@recipes ) ],
            admin_email    => $global_conf->{admin_email},
            serial         => int time,
            extra_records  => '',
        );

        my $zone    = $tt->render( 'files/pdns.zone.tt', \%vars );
        my $outfile = "$output_dir/$domain.zone";
        File::Slurper::Temp::write_binary( $outfile, $zone );
        print "Wrote $outfile\n";
    }

    return 0;
}

# What recipes.d names, rather than a depsolved list: there is no depsolver here,
# so a name belonging to a dependency is in the zone bin/new_config writes and
# not necessarily in this one.  An unknown recipe is skipped rather than fatal --
# reporting it belongs to whatever reads the configuration for real.
sub recipes_for {
    my ($domain) = @_;

    my $configured = Provisioner::Cookbook->domain_config($domain);

    my @recipes = grep { Provisioner::Cookbook->has($_) } sort keys %$configured;

    return @recipes;
}

exit main(@ARGV) unless caller;
