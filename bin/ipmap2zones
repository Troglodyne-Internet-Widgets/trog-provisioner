#!/usr/bin/env perl

#ABSTRACT: generate a zonefile for the configured guests

package Trog::Provisioner::IPMap2Zones;

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin;
use FindBin::libs;

use Config::Simple;
use Text::Xslate;
use Text::Xslate::Bridge::TT2;
use Net::IP;
use List::Util   qw{uniq};
use Getopt::Long qw{GetOptionsFromArray};
use Trog::Config();
use Provisioner::IPPool();
use File::Slurper::Temp;

=head1 NAME

ipmap2zones - write a zone file for each guest that has an address

=head1 SYNOPSIS

    ipmap2zones [--ipmap=file] [--output-dir=dir] [domain ...]

=head1 DESCRIPTION

Generates BIND-style zone files, one file for each domain.  The addresses come from
the address database of L<Provisioner::IPPool>.  The administrator's email,
the aliases and the name servers come from ipmap.cfg.

With no domain arguments, it generates a zone file for each domain that has an
address in the database.  It writes each file as C<domain.zone> in the current
directory, or in the directory that --output-dir names.

It renders C<templates/files/pdns.zone.tt>, the template that the pdns recipe
installs.  The output is not always the same as what the recipe installs, because
it has no extra records and no records for other recipes, such as matrix.

=head1 OPTIONS

=over 4

=item --ipmap=FILE

Path to ipmap.cfg.  The default is F<ipmap.cfg> in the configuration directory.
See L<Trog::Config>.

=item --output-dir=DIR

Directory to write zone files into.  The default is the current directory.  The
directory must already exist.

=back

=cut

sub main {
    my @args = @_;

    my ( $cfile, $output_dir );
    GetOptionsFromArray(
        \@args,
        'ipmap=s'      => \$cfile,
        'output-dir=s' => \$output_dir,
    );

    $cfile      //= Trog::Config->path('ipmap.cfg');
    $output_dir //= '.';

    die "Output directory $output_dir does not exist\n" unless -d $output_dir;

    my $c = Config::Simple->new($cfile);
    die "$Config::Simple::errstr\n" unless $c;
    my $global_conf = $c->param( -block => 'global' );
    my $ip_conf     = Provisioner::IPPool::assignments();
    my $alias_conf  = $c->param( -block => 'aliases' )     // {};
    my $ns_conf     = $c->param( -block => 'nameservers' ) // {};

    die "Must set admin_email in global section of $cfile\n"
      unless $global_conf->{admin_email};

    my @domains = @args ? @args : sort keys(%$ip_conf);
    die "No domain has an address in " . Provisioner::IPPool::db_path() . "\n" unless @domains;

    my $template_dir = "$FindBin::Bin/../templates";
    my $tt           = Text::Xslate->new(
        {
            path     => [$template_dir],
            syntax   => 'TTerse',
            module   => [qw{Text::Xslate::Bridge::TT2}],
            function => { _formatters() },
        }
    );

    foreach my $domain (@domains) {
        die "No address for '$domain' in " . Provisioner::IPPool::db_path() . "\n"
          unless $ip_conf->{$domain};

        my $aliases = _coerce_arrayref( $alias_conf->{$domain} );
        push( @$aliases, "www.$domain", "mail.$domain" );
        $alias_conf->{$domain} = [ uniq @$aliases ];

        my %vars = (
            domain        => $domain,
            ipmap         => $ip_conf,
            aliases       => $alias_conf,
            nameservers   => $ns_conf,
            admin_email   => $global_conf->{admin_email},
            serial        => time(),
            extra_records => '',
            modules       => [],
        );

        my $zone    = $tt->render( 'files/pdns.zone.tt', \%vars );
        my $outfile = "$output_dir/$domain.zone";
        File::Slurper::Temp::write_binary( $outfile, $zone );
        print "Wrote $outfile\n";
    }

    return 0;
}

sub _formatters {
    return (
        reverse_ip => Text::Xslate::html_builder(
            sub {
                my $ip = shift;
                return Net::IP->new($ip)->reverse_ip();
            }
        ),
        email_for_dns => Text::Xslate::html_builder(
            sub {
                my $email = shift;
                $email =~ tr/@/./;
                return $email;
            }
        ),
    );
}

sub _coerce_arrayref {
    my ($input) = @_;
    return [] unless $input;
    return ref $input eq 'ARRAY' ? $input : [$input];
}

exit main(@ARGV) unless caller;
