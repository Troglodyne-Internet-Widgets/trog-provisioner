#!/usr/bin/env perl

package Trog::Bin::NewGuest;

#ABSTRACT: Write the configuration for a guest running the recipes you name.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aa';

use FindBin::libs;

use File::Basename();
use File::Path qw{make_path};
use File::Slurper();
use File::Slurper::Temp();
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage qw{pod2usage};
use UUID::Tiny qw{create_uuid_as_string UUID_V4};
use YAML::XS();

use Provisioner::Cookbook();
use Trog::Config();

=head1 NAME

new_guest - write the configuration for a guest running the recipes you name

=head1 SYNOPSIS

    bin/new_guest nginx mariadb
    bin/new_guest --hostname scratch.test ntp ufw
    bin/new_guest --stdout --all nginxproxy

=head1 OPTIONS

=over 4

=item B<--hostname> FQDN

What to call it.  Defaults to a fresh UUID under C<.test>, which is a name
nobody else has and a TLD reserved for exactly this (RFC 2606).

=item B<--memory> MB, B<--cpus> N, B<--size> BYTES

What to ask the hypervisor for.  Defaults are 8092MB, 4 CPUs, 20GB, which is
what the domains here actually run with.  These are what placement reads to
decide where the guest fits, so a guest that needs less can say so here.

They used to default to 2048MB and 2 CPUs.  A domain carrying the perl recipe
builds perl from source and then installs Perl::Critic, Devel::NYTProf and
starman with their test suites, and in 2GB that thrashes rather than fails --
no error, no OOM, just everything taking hours, with the fork-heavy tests
worst.  Scaffolding a guest that cannot comfortably build what it is being
asked to build is a poor default.

=item B<--user> NAME

The service account the recipes install things as.  Left out by default, which
is the right answer for a scratch guest and wrong for anything that runs a
service as itself.

=item B<--all>

Write out every field each recipe accepts, not just the ones it requires.  The
full menu, for when you are going to edit the file anyway.

=item B<--output> FILE

Where to write.  Defaults to F<recipes.d/E<lt>hostnameE<gt>.yaml> under the
configuration directory -- see L<Trog::Config>.

=item B<--stdout>

Print it instead of writing it.

=item B<--force>

Overwrite a file that is already there.  Without this, an existing file is an
error, because the usual reason to hit one is a hostname collision.

=back

=head1 DESCRIPTION

Turns C<bin/new_guest nginx mariadb> into a domain configuration that
C<bin/new_config> and C<bin/provision> will accept.

Each recipe's C<args()> says what it takes and what it will assume, so the
smallest configuration that could work is derivable without asking: fields the
recipe requires get their default if it has one and C<CHANGEME> if it does not,
and fields it does not require are left out so that the recipe's own defaults
keep applying instead of being frozen into this file today.

What is left to do is printed at the end, and it is the honest list: a
C<CHANGEME> reaching C<bin/new_config> stops it, naming the keys, rather than
provisioning something half-configured.

F<bin/recipes> is the other half of this -- it lists the recipes and dumps what
each one accepts.

=cut

our $DEFAULT_TLD = 'test';

sub main {
    my @args = @_;

    my ($hostname, $memory, $cpus, $size, $user, $all, $output, $stdout, $force, $help);
    GetOptionsFromArray(\@args,
        'hostname=s' => \$hostname,
        'memory=i'   => \$memory,
        'cpus=i'     => \$cpus,
        'size=s'     => \$size,
        'user=s'     => \$user,
        'all'        => \$all,
        'output=s'   => \$output,
        'stdout'     => \$stdout,
        'force'      => \$force,
        'help'       => \$help,
    );

    pod2usage(-exitval => 0, -verbose => 2, -input => __FILE__) if $help;
    pod2usage(-exitval => 2, -verbose => 1, -input => __FILE__,
        -message => 'Name at least one recipe') unless @args;

    my @recipes = unique(@args);

    # Every one of them, before writing anything: finding out about the second
    # typo after the file is on disk is worse than finding out about both now.
    my @unknown = grep { !Provisioner::Cookbook->has($_) } @recipes;
    die "No recipe named " . join(', ', map { "'$_'" } @unknown) . ".\n"
      . "Try `bin/recipes` for the ones there are.\n" if @unknown;

    $hostname //= default_hostname();
    die "'$hostname' is not a fully qualified domain name.\n"
      . "Domains are spelled out in full, here as in ipmap.cfg and recipes.d.\n"
      unless $hostname =~ m/\A[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+\z/i;

    my ($config, @todo) = build($hostname, \@recipes, {
        all    => $all,
        memory => $memory,
        cpus   => $cpus,
        size   => $size,
        user   => $user,
        base   => base_config(),
    });

    my $yaml = YAML::XS::Dump($config);

    if ($stdout) {
        print $yaml;
        report($hostname, undef, \@recipes, \@todo);
        return 0;
    }

    $output //= Trog::Config->path("recipes.d/$hostname.yaml");
    if (!$force && readable($output)) {
        die "$output is already there.\n"
          . "Pick another --hostname, or pass --force if you meant to replace it.\n";
    }

    make_path(File::Basename::dirname($output));
    File::Slurper::Temp::write_text($output, $yaml);

    report($hostname, $output, \@recipes, \@todo);
    return 0;
}

# A name nobody else has, under the TLD reserved for exactly this (RFC 2606).
sub default_hostname {
    return lc(create_uuid_as_string(UUID_V4)) . ".$DEFAULT_TLD";
}

sub unique {
    my (@in) = @_;
    my %seen;
    return grep { !$seen{$_}++ } @in;
}

sub readable {
    my ($path) = @_;
    open(my $fh, '<', $path) or return 0;
    close $fh;
    return 1;
}

# The _base block of recipes.yaml, which every domain gets merged on top of --
# or rather underneath, since the merge is STORAGE_PRECEDENT and _base wins.
# Whatever it configures, this does not need to.
sub base_config {
    my $path = Trog::Config->path('recipes.yaml');

    my $text = eval { File::Slurper::read_binary($path) };
    return {} unless defined $text;

    my $config = eval { YAML::XS::Load($text) };
    return {} unless ref $config eq 'HASH' && ref $config->{_base} eq 'HASH';

    return $config->{_base};
}

# The domain block: what the hypervisor is being asked for, then one entry per
# recipe.
sub build {
    my ($hostname, $recipes, $opts) = @_;

    my %global = (
        memory => $opts->{memory} // 8092,
        cpus   => $opts->{cpus}   // 4,
        size   => $opts->{size}   // 20 * 1024 * 1024 * 1024,
    );
    $global{user} = $opts->{user} if defined $opts->{user};

    my $base = $opts->{base} // {};

    # Every domain has a data recipe whether it asked for one or not --
    # new_config requires it, being how the guest gets its payload at all.  If
    # _base configures it, which is the usual arrangement, leave it alone.
    my @wanted = @$recipes;
    push @wanted, 'data' unless grep { $_ eq 'data' } @wanted or exists $base->{data};

    my %domain = (_global => \%global);
    my @todo;
    foreach my $recipe (@wanted) {
        my ($config, @needed) = Provisioner::Cookbook->scaffold($recipe,
            all      => $opts->{all},
            provided => $base->{$recipe},
        );
        $domain{$recipe} = $config;
        push @todo, @needed;
    }

    return ({ $hostname => \%domain }, @todo);
}

sub report {
    my ($hostname, $output, $recipes, $todo) = @_;

    # The document goes to stdout and this goes to stderr, so that --stdout can
    # be redirected into a file without any of this ending up in it.  Flush
    # first or the two arrive interleaved on a terminal.
    STDOUT->flush();

    print {*STDERR} "\n";
    print {*STDERR} "Wrote $output\n" if defined $output;
    print {*STDERR} sprintf("%s: %d recipe%s (%s)\n",
        $hostname, scalar @$recipes, (@$recipes == 1 ? '' : 's'), join(', ', @$recipes));

    if (@$todo) {
        print {*STDERR} "\nFill these in before provisioning:\n";
        print {*STDERR} "  $_\n" for @$todo;
        print {*STDERR} "\nA CHANGEME left in place fails validation naming the key,\n"
          . "so nothing gets provisioned half-configured.\n";
    }
    else {
        print {*STDERR} "\nNothing to fill in.\n";
    }

    print {*STDERR} "\nThen:\n  bin/provision $hostname\n";
    return;
}

exit main(@ARGV) unless caller;

1;
