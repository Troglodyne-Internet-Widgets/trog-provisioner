#!/usr/bin/env perl

package Trog::Bin::NewGuest;

#ABSTRACT: Write the configuration for a guest running the recipes you name.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Data::Validate::Domain();
use File::Basename();
use File::Path qw{make_path};
use List::Util qw{any};
use File::Slurper::Temp();
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};
use UUID::Tiny   qw{create_uuid_as_string UUID_V4};
use YAML::XS();

use Provisioner::Cookbook();
use Trog::Config();

=head1 NAME

new_guest - write the configuration for a guest running the recipes you name

=head1 SYNOPSIS

    bin/new_guest nginx mariadb
    bin/new_guest --hostname scratch.test ntp ufw
    bin/new_guest --stdout --all nginxproxy

=head1 OPTIONS

=over 4

=item B<--hostname> FQDN

The name of the guest.  The default is a new UUID under C<.test>.  No other
guest has that name, and RFC 2606 reserves the C<.test> TLD for this use.

=item B<--memory> MB, B<--cpus> N, B<--size> BYTES

The resources to ask the hypervisor for.  Placement reads these to find a
hypervisor with space for the guest.

Each default comes from the C<vm> recipe.  A domain that does not set them gets
the same values.  C<bin/recipes vm> prints them.

=item B<--user> NAME

The service account that the recipes install software as and run services as.
Give one for a scratch guest, as you do for a real domain.  Most recipes expect
a service user.  Without one, C<user> is the admin account.

=item B<--all>

Write every field that each recipe accepts, not only the fields it requires.
Use this when you intend to edit the file.

=item B<--output> FILE

The file to write.  The default is F<recipes.d/E<lt>hostnameE<gt>.yaml> in the
configuration directory.  See L<Trog::Config>.

=item B<--stdout>

Print the configuration instead of writing it to a file.

=item B<--force>

Replace a file that already exists.  Without this flag, an existing file is an
error, because it usually means that two guests have the same hostname.

=back

=head1 DESCRIPTION

Turns C<bin/new_guest nginx mariadb> into a domain configuration that
C<bin/new_config> and C<bin/provision> accept.

The C<args()> of each recipe says which fields it takes and which defaults it
has.  From that, this program writes the smallest configuration that can work:

=over 4

=item *

A required field gets its default.  If it has no default, it gets C<CHANGEME>.

=item *

A field that is not required is left out.  The recipe then applies its own
default, and a later change to that default also applies.

=back

At the end, the program prints the fields that you must fill in.  If
C<bin/new_config> finds a C<CHANGEME>, it stops and names the keys.  It does
not provision a guest that is only partly configured.

F<bin/recipes> lists the recipes and shows the fields that each one accepts.

=cut

our $DEFAULT_TLD = 'test';

sub main {
    my @args = @_;

    my ( $hostname, $memory, $cpus, $size, $user, $all, $output, $stdout, $force, $help );
    GetOptionsFromArray(
        \@args,
        'hostname=s' => \$hostname,
        'memory=i'   => \$memory,
        'cpus=i'     => \$cpus,
        'size=s'     => \$size,
        'user=s'     => \$user,
        'all'        => \$all,
        'output=s'   => \$output,
        'stdout'     => \$stdout,
        'force'      => \$force,
        'help'       => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;
    pod2usage(
        -exitval => 2, -verbose => 1, -input => __FILE__,
        -message => 'Name at least one recipe'
    ) unless @args;

    my @recipes = unique(@args);

    # Report every unknown name before anything is written, not only the first.
    my @unknown = grep { !Provisioner::Cookbook->has($_) } @recipes;
    die "No recipe named " . join( ', ', map { "'$_'" } @unknown ) . ".\n" . "Try `bin/recipes` for the ones there are.\n" if @unknown;

    $hostname //= default_hostname();
    die "'$hostname' is not a fully qualified domain name.\n" . "Domains are spelled out in full, here as in recipes.yaml and recipes.d.\n"
      unless Data::Validate::Domain::is_domain( $hostname, { domain_disable_tld_validation => 1 } );

    my ( $config, @todo ) = build(
        $hostname,
        \@recipes,
        {
            all    => $all,
            memory => $memory,
            cpus   => $cpus,
            size   => $size,
            user   => $user,
            base   => base_config(),
        }
    );

    my $yaml = YAML::XS::Dump($config);

    if ($stdout) {
        print $yaml;
        report( $hostname, undef, \@recipes, \@todo );
        return 0;
    }

    $output //= Trog::Config->path("recipes.d/$hostname.yaml");
    if ( !$force && -e $output ) {
        die "$output is already there.\n" . "Pick another --hostname, or pass --force if you meant to replace it.\n";
    }

    make_path( File::Basename::dirname($output) );
    File::Slurper::Temp::write_text( $output, $yaml );

    report( $hostname, $output, \@recipes, \@todo );
    return 0;
}

=head2 $hostname = default_hostname()

Returns a new lowercase UUID under C<.test>, the TLD that RFC 2606 reserves for
this use.

=cut

sub default_hostname {
    return lc( create_uuid_as_string(UUID_V4) ) . ".$DEFAULT_TLD";
}

sub unique {
    my (@in) = @_;
    my %seen;
    return grep { !$seen{$_}++ } @in;
}

=head2 \%base = base_config()

Returns the C<_base> block of F<recipes.yaml>, with its C<_global>, as
L<Provisioner::Cookbook> reads it.  Every domain gets the values in C<_base>
unless it sets them itself, so the new file does not repeat them.  Dies if the
file does not parse, and if the installation has not said what its guests are
built with.

That refusal is here rather than in F<bin/new_config> alone because a
C<required_recipes> sub reads those settings while this scaffolds: a guest
scaffolded without an C<admin_user> gets files owned by nobody, and nothing
between here and the build says so.

=cut

sub base_config {
    my $conf = Provisioner::Cookbook->configuration();
    my $base = Provisioner::Cookbook->domain_config( undef, $conf );

    $base->{_global} = Provisioner::Cookbook->globals( undef, $conf );
    return $base;
}

=head2 ($config, @todo) = build($hostname, \@recipes, \%opts)

Returns the domain configuration as a hash keyed by C<$hostname>, and the
fields that you must fill in.  The configuration has a C<_global> entry with
the hypervisor resources, then one entry for each recipe.

C<%opts> takes C<all>, C<memory>, C<cpus>, C<size> and C<user> as the options
of the same names, and C<base> as the return of C<base_config>.

=cut

sub build {
    my ( $hostname, $recipes, $opts ) = @_;

    # bin/new_config uses these vm defaults anyway.  They are written out because
    # people read and edit this file.
    my %vm     = Provisioner::Cookbook->defaults('vm');
    my %global = (
        memory => $opts->{memory} // $vm{memory},
        cpus   => $opts->{cpus}   // $vm{cpus},
        size   => $opts->{size}   // $vm{size},
    );
    $global{user} = $opts->{user} if defined $opts->{user};

    my $base = $opts->{base} // {};

    # new_config requires a data recipe in every domain, because it delivers
    # the payload to the guest.  If _base configures it, as usual, skip it.
    my @wanted = @$recipes;
    push @wanted, 'data' unless any { $_ eq 'data' } @wanted or exists $base->{data};

    my %domain = ( _global => \%global );
    my @todo;
    foreach my $recipe (@wanted) {
        my ( $config, @needed ) = Provisioner::Cookbook->scaffold(
            $recipe,
            all      => $opts->{all},
            provided => $base->{$recipe},
        );
        $domain{$recipe} = $config;
        push @todo, @needed;
    }

    # The guest also gets every recipe that these require.  A required recipe
    # can need a field that nothing supplies.  List it now, so new_config does
    # not refuse it later.
    #
    # A required_recipes sub reads the globals, so give them as _global in
    # recipes.yaml has them.
    my ( $deps, @dep_todo ) = Provisioner::Cookbook->scaffold_dependencies(
        \@wanted,
        all           => $opts->{all},
        base          => $base,
        global_config => ref $base->{_global} eq 'HASH' ? $base->{_global} : {},
        domain        => $hostname,
    );
    $domain{$_} = $deps->{$_} for sort keys %$deps;
    push @todo, @dep_todo;

    return ( { $hostname => \%domain }, @todo );
}

sub report {
    my ( $hostname, $output, $recipes, $todo ) = @_;

    # The report goes to stderr, so --stdout can go to a file without it.
    # Flush stdout first, or the two mix on a terminal.
    STDOUT->flush();

    # Not warn, which adds a file and line number to each line of the report.
    ## no critic (ProhibitPrintSTDERR)
    my $summary = "\n";
    $summary .= "Wrote $output\n" if defined $output;
    $summary .= sprintf(
        "%s: %d recipe%s (%s)\n",
        $hostname, scalar @$recipes, ( @$recipes == 1 ? '' : 's' ), join( ', ', @$recipes )
    );
    print {*STDERR} $summary;

    if (@$todo) {
        print {*STDERR} "\nFill these in before provisioning:\n" . join( q{}, map { "  $_\n" } @$todo ) . "\nA CHANGEME left in place fails validation naming the key,\n" . "so nothing gets provisioned half-configured.\n";
    }
    else {
        print {*STDERR} "\nNothing to fill in.\n";
    }

    print {*STDERR} "\nThen:\n  bin/provision $hostname\n";
    ## use critic
    return;
}

exit main(@ARGV) unless caller;

1;
