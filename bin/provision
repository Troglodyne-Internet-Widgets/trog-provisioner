#!/usr/bin/env perl

package Trog::Bin::Provisioner;

use strict;
use warnings FATAL => 'all';

use FindBin();
use FindBin::libs;
use Config::Simple();
use File::Path();
use Trog::HV();
use Trog::Hypervisors();
use File::Slurper();
use File::Copy();
use YAML::XS();
use JSON::PP();
use List::Util qw{any uniq};
use File::Which qw {which};
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage qw{pod2usage};
use Net::OpenSSH::More;
use Net::EmptyPort;
use XML::Twig;
use JSON::MaybeXS;

use Carp::Always;

=head1 NAME

provision - build a VM from a domain directory

=head1 SYNOPSIS

    provision [OPTIONS] DOMAIN

    provision vm.example.com
    provision --connect qemu+ssh://root@hv1.example.net/system vm.example.com

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor to build on.  Bypasses
F<hypervisors.conf> entirely: no placement, no capacity check, build it there.
A remote hypervisor has to be named with an ssh transport
(C<qemu+ssh://user@host/system>), since we need its filesystem as well as its
libvirt.

=item B<--hvconf> FILE

The fleet definition.  Defaults to F<hypervisors.conf> in the domain directory.
When it exists, the hypervisor is chosen from it -- see L<Trog::Hypervisors>.
When it doesn't, the hypervisor is whatever F<provision.conf> and C<--connect>
say, which for most people is still this machine.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.

=item B<--tfdir> DIR

Where terraform's config and state live.  Defaults to F</opt/terraform> for the
default hypervisor, and to a per-hypervisor directory under
F</opt/terraform/hv/> for any other.

=item B<--existing> IP

Layer this domain's configuration onto an already running VM rather than
building a new one.

=item B<--dryrun>

Write out everything that would be applied, but don't apply it.

=back

=head1 DESCRIPTION

Reads F<DOMAIN/provision.conf> and F<DOMAIN/users.yaml> out of the domain
directory, renders the terraform and cloud-init configuration for the domain,
and applies it against the hypervisor.  See L<Trog::HV> for what "the
hypervisor" means when it isn't this machine.

=cut

sub _coerce_array {
    return \@_;
}

#TODO: cpu/gpu passthru accel via techniques such as the following:
# https://github.com/HarbourHeading/KVM-GPU-Passthrough

our $dryrun;

sub main {
    my @args = @_;

    umask 0022;

    my ($reuse, $uri, $domain_dir, $tf_dir, $hvconf);
    GetOptionsFromArray(\@args,
        'existing=s'  => \$reuse,
        'domaindir=s' => \$domain_dir,
        'dryrun'      => \$dryrun,
        'connect=s'   => \$uri,
        'tfdir=s'     => \$tf_dir,
        'hvconf=s'    => \$hvconf,
    );

    my $domain = shift @args;
    pod2usage(-exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed')
      unless $domain;

    # Everything the hypervisor knows about itself comes off provision.conf, so
    # we have to find that the hard way first.
    $domain_dir //= '/opt/domains';
    $domain =~ s/\///g;
    my $cfile = "$domain_dir/$domain/provision.conf";
    die "No such file provision.conf in $domain_dir/$domain/" unless -f $cfile;

    my $udf = "$domain_dir/$domain/users.yaml";
    die "User definition file $domain_dir/$udf not present!" unless -f $udf;

    die "Terraform not installed" unless which('terraform');

    my $config = Config::Simple->new($cfile);
    my $reuser = $config->param('admin_user') // 'root';

    # Figure out which hypervisor we're talking to before we touch anything.
    # Every other sub picks this same object back up with Trog::HV->new().
    my $hv = choose_hypervisor($config, $domain, {
        uri        => $uri,
        domain_dir => $domain_dir,
        tf_dir     => $tf_dir,
        hvconf     => $hvconf,
    });
    print "Provisioning against hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    # Basic setup.  The config/state dir is ours; the disk pool is the HV's.
    File::Path::make_path($hv->tf_config_dir);
    $hv->mkpath_hv($hv->pool_path)
      or die "Could not create storage pool dir " . $hv->pool_path . " on the hypervisor";

    $domain_dir = $hv->domain_dir;
    my $data = "$domain_dir/$domain/data.tar.gz";
    die "No data to host in $domain/" unless -f $data;

    # Start off by fixing a sillyness in virtiofs.  This runs as part of the
    # qemu process, so it has to land on the hypervisor, not on us.
    if (!$hv->file_exists_hv('/usr/libexec/virtiofs-better')) {
        $hv->put_file("$FindBin::Bin/../virtiofs-better", '/usr/libexec/virtiofs-better', sudo => 1)
          or die('Could not copy virtiofs-better to /usr/libexec/virtiofs-better, you may have to do this manually');
        $hv->system_hv(qw{sudo chmod 0755 /usr/libexec/virtiofs-better});
    }

    # Fix the terraform state.
    # We have to do this every time, for every single known domain.
    # This is because there is NO GUARANTEE that the tfstate is in sync with actual libvirt state.
    sync_tf_state_with_libvirt();

    # Now, let's figure out if this has a VM which needs to be built first.
    # In the event reuse is passed, we are just layering configs really.
    my $skey = "$domain_dir/$domain/key.rsa";
    my $depends = $config->param('depends_on');
    if ($depends) {
        print "$domain depends on $depends, provisioning that first...\n";
        my $dcfile = "$domain_dir/$depends/provision.conf";
        die "No such file provision.conf in $domain_dir/$depends/" unless -f $cfile;
        my $dconfig = Config::Simple->new($dcfile);

        #XXX should probably die here if the admin_users differ!

        $skey = "$domain_dir/$depends/key.rsa";
        ($reuser, $reuse) = provision_domain($dconfig, $depends, $reuse, $reuser);
        if (!$dryrun) {
            my $ssh = wait_for_ssh($reuser, $skey, $reuse) or die "$depends never came up";
            wait_for_cloud_init($ssh, $domain);
            wait_for_makefile($ssh, $depends);
        }

    }
    #TODO need to figure out how to apply the cloud-init for the second domain if deps are active
    my ($user, $ip) = provision_domain($config, $domain, $reuse, $reuser, $depends);
    return 0 if $dryrun;

    print "ssh -i $skey $user\@$ip\n";
    my $ssh = wait_for_ssh($user, $skey, $ip) or die "$domain never came up";

	if (-f "$domain_dir/$domain/devices.map") {
		print "Syncing disk map\n";
		my $r = $ssh->sftp->put( "$domain_dir/$domain/devices.map", "devices.map" );
		die "could not sync devices map!" unless $r;
		$ssh->cmd("sudo cp devices.map /root/devices.map");
	}

    wait_for_cloud_init($ssh, $domain);
    wait_for_makefile($ssh, $domain);

    # If we don't do this, any subsequent manual tf plan will explode violently
    sync_tf_state_with_libvirt();

    return 0;
}

# Which hypervisor does this guest belong on?
#
# --connect is the manual override and skips every question below.  Otherwise,
# if there is a hypervisors.conf, it decides: the guest goes where it already
# lives, or where it fits.  With no fleet configured we are back to the old
# behaviour, where provision.conf carried the connection details itself.
sub choose_hypervisor {
    my ($config, $domain, $opts) = @_;

    my %paths = (domain_dir => $opts->{domain_dir}, tf_dir => $opts->{tf_dir});

    return Trog::HV->new(uri => $opts->{uri}, %paths) if $opts->{uri};

    my $fleet = Trog::Hypervisors->load(
        $opts->{hvconf} // Trog::Hypervisors->default_path($opts->{domain_dir}));
    return Trog::HV->from_config($config, %paths) unless $fleet->configured;

    warn "hypervisors.conf decides which hypervisor $domain lands on; the "
      . "libvirt_uri in its provision.conf is ignored\n"
      if $config->param('libvirt_uri');

    my $hv = $fleet->select_for($domain, $config);

    # The command line still outranks the fleet on where *our* files go.
    $hv->{domain_dir} = $opts->{domain_dir} if defined $opts->{domain_dir};
    $hv->{tf_dir}     = $opts->{tf_dir}     if defined $opts->{tf_dir};
    return $hv;
}

sub sync_tf_state_with_libvirt {
    my $statefile  = Trog::HV->new()->tf_config_dir . '/terraform.tfstate';
    return unless -f $statefile;
    my $tf_domains = get_tf_managed_domains($statefile);
    my %volatile   = extract_volatile_libvirt_info($tf_domains);
    #brainwash_tfstate($statefile, %volatile);
}

sub wait_for_cloud_init {
    my ($ssh, $domain, $t) = @_;

    # TODO make configurable
    $t //= '30m';
    print "Waiting up to $t for Cloud-init to finish...\n";
    my $rc = $ssh->cmd_exit_code(qq{sudo timeout $t bash -c 'until grep "Boot configuration complete." /var/log/cloud-init-output.log; do sleep 1; done;'});
    print "Done!\n";
    die "Cloud init reported failure! Investigate machine." if $rc;

    # See if we got a lying exit code above
    my ($raw) = $ssh->cmd("sudo cloud-init analyze dump");
    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1);

    my $parsed = eval {$json->decode($raw) };
    die "cloud-init analyze dump failed to return JSON array!" unless ref $parsed eq 'ARRAY';

    my @failures = grep { ($_->{result} // '') eq "FAIL" } @$parsed;
    foreach my $fail (@failures) {
        my ($module, $mtarget) = split('/', $fail->{name});
        next unless $mtarget;
        my ($stage, $target) = split('-', $mtarget);
        next unless $target;
        print "$target failed during $stage, re-running...\n";
        my $ci_dir = "/var/lib/cloud/instances/$domain";
        # Remove the semaphore that says this was run, then run the needed targets
        $ssh->cmd_exit_code(qw{sudo rm}, "$ci_dir/sem/$stage\_$target");
        my ($out) = $ssh->cmd({ use_persistent_shell => 0 }, qw{sudo cloud-init single --name}, $target);
        print "$out\n\n";
    }
}

sub wait_for_makefile {
    my ($ssh, $domain, $t) = @_;

    # TODO make configurable
    $t //= '30m';

    print "Waiting up to $t for ATD queue to flush...\n";
    my ($out) = $ssh->cmd(qq{sudo timeout $t bash -c 'until [ \$(atq | wc -l) = 0 ]; do sleep 1; done;'});

    print "Waiting up to $t for Makefile payload to start...\n";
    $ssh->cmd_exit_code(qq{sudo timeout $t bash -c 'until [ -f /var/log/$domain.setup.log ]; do sleep 1; done;'});

    print "Waiting up to $t for Makefile payload to finish...\n";
    $ssh->cmd_exit_code(qq{sudo timeout $t bash -c 'while lsof | grep /var/log/$domain.setup.log; do sleep 1; done;'});

    print "Waiting up to $t for any makefile queued ATD jobs to flush...\n";
    ($out) = $ssh->cmd(qq{sudo timeout $t bash -c 'until [ \$(atq | wc -l) = 0 ]; do sleep 1; done;'});

    print "Last log:\n";
    my ($ll) = $ssh->cmd(qq{sudo tail /var/log/$domain.setup.log});
    print "$ll\n";

    print "\nDone!\n";
}

sub provision_domain {
    my ($config, $domain, $reuse, $reuser, $depends) = @_;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain_mongled = $domain;
    $domain_mongled =~ s/\./-/g;

    # Set this to simplify calling conventions
    $config->param('domain', $domain);

    my $nc = mongle_network_configuration($config);
    print "Wrote $nc\n";

    my $ss = mongle_setup_script($config);
    print "Wrote $ss\n";

    my $lc = mongle_logging_config($config);
    print "Wrote $lc\n";

    my $cc = mongle_cloud_init($config);
    print "Wrote $cc\n";

    # Everything the domain dir is going to hold now holds it, so the HV can
    # have its copy.  The guest pulls its payload from there.
    $hv->sync_domain_dir($domain);

    # If the domain is already up, let's find the IP.
    # We can't guarantee we have a static IP, so use the internal.
    my $qdn = $domain;
    $qdn = $depends if $depends;
    $qdn =~ s/\.\S+$//;

    #XXX this can be fooled if you have two VMs, one a subdo of the other
    my $old_ip = $hv->lease_ip('default', $qdn) // 'bogus';

    if ($reuse) {
        my $old_ssh_ip = $hv->guest_ssh_ip($config, $old_ip);
        return ($reuser, $old_ssh_ip) if $dryrun;
        #$old_ip = $reuse;

        # Re-Use the existing VM, and just ship over what we got and run the makefile again.
        my %opts = ( host => $old_ssh_ip );
        $opts{user}     = $reuser;

        # Make sure any existing VMs don't have this domain
        clean_domain_resources($domain,$domain_mongled);
        unlink $hv->tf_config_dir . "/$domain.tf";

        # Try to use the root key if no admin user is passed (this may not work if you locked down the box!)
        # Otherwise we'll use the agent.
        $opts{key_path} = "$domain_dir/$domain/key.rsa";
        $opts{key_path} = "$domain_dir/$depends/key.rsa" if $depends;
        print "Attempting to access Machine\n";
        my $ssh = Net::OpenSSH::More->new(%opts);

        my $output = '';
        print "Installing Updated cloud-init and forcing re-run...\n";
        my $init = $hv->tf_config_dir . "/$domain.cloud_init.cfg";
        my $ci_dir = "/var/lib/cloud/instances/$domain";
        $ssh->sftp->put($init, 'cloud-config.txt');
        # Remove the semaphore that says this was run, then run the needed targets
        $ssh->cmd(qw{sudo rm}, "$ci_dir/sem/cc_package_update_upgrade_install");
        ($output) = $ssh->cmd("sudo cloud-init single --name cc_package_update_upgrade_install -f cloud-config.txt");
        print "$output\n";
        $ssh->cmd(qw{sudo rm}, "$ci_dir/sem/cc_users_groups");
        ($output) = $ssh->cmd("sudo cloud-init single --name cc_users_groups -f cloud-config.txt");
        print "$output\n";

        my $ips  = _coerce_array($config->param('ips'));
        my ($existing_nc) = $ssh->cmd("sudo cat /etc/netplan/50-cloud-init.yaml");
        my $parsed = YAML::XS::Load($existing_nc);

        my $primary_adapter_name = $config->param('bridge_devname');
        die "Could not find primary adapter '$primary_adapter_name' in netplan config!" unless ref $parsed->{network}{ethernets}{$primary_adapter_name} eq 'HASH';

        my $num_ips = scalar(@{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}});
        @{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}} = uniq(@{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}}, map { "$_/24"} @$ips);
        if ($num_ips != scalar(@{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}})) {
            my $encoded = YAML::XS::Dump($parsed);
            my $new_config = "$domain_dir/$domain/network-config-merged.yaml";
            File::Slurper::write_text($new_config, $encoded);
            print "Setting up IP for $domain...\n";
            $ssh->sftp->put($new_config, "network-config-merged.yaml");
            $ssh->cmd("sudo mv network-config-merged.yaml /etc/netplan/50-cloud-init.yaml");
            $ssh->cmd("sudo chmod 0600 /etc/netplan/50-cloud-init.yaml");
            $ssh->cmd("sudo chown root:root /etc/netplan/50-cloud-init.yaml");
            ($output) = $ssh->cmd("sudo netplan apply");
            chomp $output;
            print "$output\n" if $output;
        }

        print "Syncing setup script\n";
        my $res = $ssh->sftp->put( "$domain_dir/$domain/setup.sh", "setup-$domain.sh" );
        $ssh->cmd("chmod +x setup-$domain.sh");
        $ssh->cmd("sudo mv setup-$domain.sh /root");
        print "Scheduling job to run setup script\n";
        ($output) = $ssh->cmd("sudo at now -f /root/setup-$domain.sh");
        print $output;
        print "Done.\n";
        return ($reuser, $old_ssh_ip);
    }

    # TODO move the deletion of unneeded resources above the SSH reuse stuff, remove dependent VMs from conf.
    my $tf = mongle_terraform_template($config);
    print "Wrote $tf\n";

    return ($config->param('admin_user'), $hv->guest_ssh_ip($config, $old_ip)) if $dryrun;

    chdir $hv->tf_config_dir;
    # Figure out if we need to liquidate/respawn/spawn existing stuff
    my $result = 0;
    # If something named this domain exists, but is supposed to depend on something else, destroy it.
    clean_domain_resources($domain,$domain_mongled);

    system(qw{terraform init});
    $result = $? >> 8;
    die "Could not initialize terraform" if $result;

    #XXX Terraform wants ot rebuild everything even if a trivial autoassigned pty port changes
    # As such we need to tell it to only EVER change what we have requested
    system(qw{terraform plan -out tf.plan},  "-target=libvirt_domain.$domain_mongled");
    $result = $? >> 8;
    die "Could not establish terraform execution plan" if $result;

    system(qw{terraform apply tf.plan});
    $result = $? >> 8;
	#XXX the provider is buggy, so we just have to pray
    warn "Terraform cried uncle, but we're going to continue anyways" if $result;

    # If we're not re-using the VM, waste the old DHCP lease, so we don't fill up the table and gum everything up.
    $hv->release_dhcp_lease($old_ip) unless $old_ip eq 'bogus';

    print "Waiting for VM to come live...";
    my $new_ip = '';
    for (1..30) {
        $new_ip = $hv->lease_ip('default', $qdn, exclude => $old_ip);
        last if $new_ip;
        print ".";
        sleep 1;
    }
    die "\nVM never came up!\n" unless $new_ip;

    # Eject the CDROM we used for cloud-init
    $hv->eject_cdrom($domain);

    print "\nAll Done!  The server should be live at $new_ip\n";

    return ($config->param('admin_user'), $hv->guest_ssh_ip($config, $new_ip));
}

sub clean_domain_resources {
    my ($domain,$domain_mongled) = @_;

    #XXX sigh sigh sigh
    # We also have to whack any VM which exists with this name but is shutdown because TF is incapable of fixing this
    my $hv = Trog::HV->new();
    if ($hv->domain_exists($domain)) {
        # Kill it, how frigging hard can it be???
        print "Terminating existing VM $domain via libvirt...\n";
        $hv->annihilate_domain($domain);
    }

    my @exempt = qw{libvirt_volume.image_base libvirt_pool.tf_disks};
    my $resources = qx{terraform state list};
    chomp $resources;
    foreach my $resource (split(/\n/, $resources)) {
        next unless $resource =~ m/\Q$domain_mongled\E/;
        next if any { $_ eq $resource } @exempt;
        print "Terminating $resource\n";
        #XXX terraform has no good means to say "HEY THESE ARE SHARED RESOURCES HANDS OFF!"
        #XXX So we have to instead painstakingly kill everything that isn't.
        #XXX they claim modules are the way to do this, but that appears to be false.
        #XXX Maybe I have to instead make both the shared and vm specific stuff modules? IDK
        system(qw{terraform destroy -auto-approve -target}, $resource) unless any { $_ eq $resource } @exempt;
    }

}

sub wait_for_ssh {
    my ($user, $key, $ip) = @_;
    print "Waiting for $ip:22 to come live...\n";
    my $wait = 300;
    my $ssh_up = Net::EmptyPort::wait_port({ host => $ip, port => 22, max_wait => $wait });
    die "SSH port never came up after $wait seconds!" unless $ssh_up;

    # Make sure we can *actually* SSH in
    my $ssh = Net::OpenSSH::More->new( host => $ip, user => $user, key_path => $key, use_persistent_shell => 0 );
    die "Could not establish SSH connection as $user!" unless $ssh;

    return $ssh;
}

sub mongle_terraform_template {
    my ($config) = @_;

    my $domain = $config->param('domain');
    my $image  = $config->param('image');
    my $disk_size = $config->param('size');
    my $ram_mb = $config->param('memory');
    my $cpus      = $config->param('cpus');

    # These have no sane default, and every one of them goes straight into the
    # terraform template.  Say which one is missing rather than letting the
    # substitution produce a config file that won't parse.
    foreach my $required (
        [image  => $image], [size => $disk_size],
        [memory => $ram_mb], [cpus => $cpus],
    ) {
        my ($key, $value) = @$required;
        die "MUST SET $key in provision.conf for $domain\n"
          unless defined $value && length $value;
    }
    # host-passthrough exposes the bare-metal CPU (incl. AVX/AVX2/etc.) to the
    # guest — required by anything that probes cpuid for vector extensions
    # (e.g. the `claude` CLI bundled v8 snapshot).  Override to host-model,
    # custom, or a specific model name only if you need live migration to a
    # differently-specced HV.
    my $cpu_mode  = $config->param('cpu_mode') // 'host-passthrough';

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $bridge_device = $hv->bridge_device;
    print "Using outbound bridge $bridge_device\n";

    # OK, let's get the UUID of our storage pool IN CASE we are re-using it
    # TODO make this configurable so we can use lvm
    my $libvirt_pool = $hv->pool_uuid('tf_disks');
    my ($import_block, $image_block) = ('', '');
    if ($libvirt_pool) {
        print "Re-Using existing libvirt pool $libvirt_pool\n";
        $import_block = qq|
import {
    to = libvirt_pool.tf_disks
    id = "$libvirt_pool"
}
|;
    }

    my $domain_mongled = $domain;
    $domain_mongled =~ s/\./-/g;

    # The provider needs a real URI even when we let libvirt pick our own.
    my $libvirt_uri = $hv->uri;
    my $pool_path   = $hv->pool_path;

    my %to_mongle = (
        'main.tmpl'   => "main.tf",
        'domain.tmpl' => "$domain.tf",
    );

	# If the user instructs us to attach other disks via disks.txt, we should obey
	my $disks_config = "$domain_dir/$domain/mounts.txt";
	my $attach = ',';
    my $fsmounts = '';
	my $mapper = '';
	if (-f $disks_config) {
		my $disks = File::Slurper::read_text($disks_config);
		my @devnames = 'vdb'..'vdz';
		my (@extra_disks,@filesystems);
        my $order = 2;
		foreach my $diskspec (grep { $_ } split(/\n/, $disks)) {
			my ($pool, $disk) = split(/=/, $diskspec);

            #TODO should allow the user to pass this via diskspec
            my $type = "qcow2";

            # Don't do anything for fuse devices
            next if $pool eq 'fuse';

            # Proper boot order...
            $order++;

			# Attach to the guest IFF the thing exists
			my $dev = shift @devnames;
			die "Ran out of vdnames!" unless $dev;

			# we have to build a mapping file which will end up in /root.
			$mapper .= "$disk=/dev/$dev\n" unless $pool eq 'dir';
            $mapper .= "$disk=$dev\n"      if     $pool eq 'dir';

            if ($pool eq 'raw') {
                # Just use a raw block device
                push(@extra_disks,qq|
		  {
			source = {
                block = {
				    dev = "$disk"
                }
			}
            driver = {
                name = "qemu"
                type = "raw"
            }
			target = {
				dev = "$dev"
				bus = "virtio"
			}
            boot = {
                order = $order
            }
			device = "disk"
            type = "block"
		  }|);
                next;
            }

            #XXX we may have to set binary.path='some_script' which is `virtiofs --inode-file-handles=mandatory $@`
            # Just mount a dir on the HV
            if ($pool eq 'dir') {
                push(@filesystems,qq|
		  {
			source = {
                mount = {
				    dir = "$disk"
                }
			}
            target = {
                dir = "$dev"
            }
            driver = {
                type = "virtiofs"
            }
            boot = {
                order = $order
            }
            binary = {
                path = "/usr/libexec/virtiofs-better"
                open_files = {
                    max = 4092
                }
            }
            access_mode="passthrough"
		  }|);
                next;
            }

            if ($pool eq 'file') {
			    #XXX untested, may not work?
			    push(@extra_disks,qq|
		  {
			source = {
				file = {
					file = "$disk"
				}
			}
			target = {
				dev = "$dev"
				bus = "virtio"
			}
            driver = {
                name = "qemu"
                type = "$type"
            }
            boot = {
                order = $order
            }
			device = "disk"
		  }|);
            }
            # Otherwise just assume we got a pool name
	        push(@extra_disks,qq|
		  {
			source = {
				pool = "$pool"
				volume = "$disk"
			}
			target = {
				dev = "$dev"
				bus = "virtio"
			}
            driver = {
                name = "qemu"
                type = "$type"
            }
            boot = {
                order = $order
            }
			device = "disk"
		  }|);
		}
		$attach   .= join(',', grep { $_ } @extra_disks);
        $fsmounts = "filesystems = [".join(',', grep { $_ } @filesystems)."]";
	}
	# Write /root/devices.map
	File::Slurper::write_text("$domain_dir/$domain/devices.map", $mapper);

    my @files_mongled;
    foreach my $file (keys(%to_mongle)) {
        my $tf_template = File::Slurper::read_text("$FindBin::Bin/../$file");

        $tf_template =~ s/%BRIDGENAME%/$bridge_device/gmx;
        $tf_template =~ s/%REPLACEME%/$domain/gmx;
        $tf_template =~ s/%MONGLED%/$domain_mongled/gmx;
        $tf_template =~ s/%GIGGLEBYTES%/$disk_size/gmx;
        $tf_template =~ s/%MUGUBYTES%/$ram_mb/gmx;
        $tf_template =~ s/%NUMCPUS%/$cpus/gmx;
        $tf_template =~ s/%CPUMODE%/$cpu_mode/gmx;
        $tf_template =~ s/%CLOUDIMG%/$image/gmx;
        $tf_template =~ s/%LIBVIRT_POOL_IMPORT%/$import_block/gmx;
#        $tf_template =~ s/%BASE_IMAGE_IMPORT%/$image_block/gmx;
		$tf_template =~ s/%EXTRADISKS%/$attach/gmx;
        $tf_template =~ s/%FILESYSTEMS%/$fsmounts/gmx;
        $tf_template =~ s/%LIBVIRT_URI%/$libvirt_uri/gmx;
        $tf_template =~ s/%POOLPATH%/$pool_path/gmx;

        my $tfile = $hv->tf_config_dir . "/$to_mongle{$file}";
        File::Slurper::write_text($tfile, $tf_template);
        push(@files_mongled, $tfile);
    }

    #XXX tf plugin should do this automatically, but does not
    $hv->unlink_hv("$pool_path/commoninit.iso");

    return join(', ', @files_mongled);
}

# Slam in the IPs, gw, resolvers
sub mongle_network_configuration {
    my $config = shift;

    my $hv = Trog::HV->new();

    my $domain = $config->param('domain');
    my $ips  = _coerce_array($config->param('ips'));
    my $gw   = $config->param('gateway');
    my $res  = _coerce_array($config->param('resolvers'));
    die "MUST SET gateway in provision.conf when ips are set\n"
      if @$ips && !(defined $gw && length $gw);

    # XXX ugh there is no way to set consistent devnames, fml
    my $dhcp_devname = $config->param('dhcp_devname');
    die "MUST SET dhcp_devname in provision.conf" unless $dhcp_devname;
    my $bridge_devname = $config->param('bridge_devname');
    die "MUST SET bridge_devname in provision.conf" unless $dhcp_devname;

    # We need two adapters, one on virbr0 and another on the bridge.
    # So, we need to figure out:
    # 1. IP of the virbr
    # 2. name of the bridge device.
    # 3. IP of bridge device.

    print "Using libvirt network device " . $hv->virbr_device . "\n";
    print "HV internal IP: " . $hv->virbr_ip . "\n";

    # Stash these in the config object for later use by the clown-config
    $config->param('hv_internal_ip', $hv->virbr_ip);
    $config->param('hv_sshd_port',   $hv->sshd_port);

    # Such an astonishingly tedious format
    my @subnets = map {
        {
            type      => 'static',
            address   => $_,
            gateway   => $gw,
            dns_nameservers => $res,
            dns_search      => [$domain],
        }
    } @$ips;

    # Do DHCP if no IP was supplied
    if (!@subnets) {
        @subnets = (
            {
                type => 'dhcp',
            }
        );
    }

    my $netconf = {
       network => {
            version => 1,
            config  => [
                {
                    type => 'physical',
                    name => $bridge_devname,
                    subnets => \@subnets,
                    gateway4 => $gw,
                    nameservers => {
                        search => [$domain],
                        addresses => $res,
                    }
                },
                {
                    type => 'physical',
                    name => $dhcp_devname,
                    subnets => [
                        {
                            type => 'dhcp',
                        },
                    ],
                },
            ],
       },
    };

    my $cf = $hv->tf_config_dir . "/$domain.network_config.cfg";
    File::Slurper::write_text($cf, YAML::XS::Dump($netconf));
    return $cf;
}

sub inject_admin_key {
    my ($admin_user, $domain, $config, $pubkey) = @_;
    # Don't bother if we aren't setting this up.
    return unless $admin_user;
    return unless ref $config->{users} eq 'ARRAY';

    foreach my $u (@{$config->{users}}) {
        next unless exists $u->{name};
        next unless $u->{name} eq $admin_user;
        $u->{ssh_authorized_keys} //= [];
        push(@{$u->{ssh_authorized_keys}}, $pubkey);
        return;
    }
    return;
}

# Generate and store a new SSH key for the guest, which we will authorize on the HV to grab the data.tar.gz
sub mongle_cloud_init {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain = $config->param('domain');
    my $contactemail = $config->param('contact_email');
    my $hv_ip = $config->param('hv_internal_ip');
    die "MUST SET contact_email in provision.conf for $domain\n"
      unless defined $contactemail && length $contactemail;

    # Generate a new key for the child
    qx{yes | ssh-keygen -t rsa -f $domain_dir/$domain/key.rsa -N ''};
    die "No key generated!" unless -f "$domain_dir/$domain/key.rsa";
    die "No pubkey generated!" unless -f "$domain_dir/$domain/key.rsa.pub";
    chmod 0600, "$domain_dir/$domain/key.rsa";
    chmod 0600, "$domain_dir/$domain/key.rsa.pub";

    # Authorize the key with the transfer user *on the hypervisor* -- that's the
    # box the guest will scp its payload back from.
    my $pubkey = File::Slurper::read_text("$domain_dir/$domain/key.rsa.pub");
    chomp $pubkey;
    $hv->append_line_hv($hv->authorized_keys, $pubkey)
      or die "Could not authorize the key for $domain on the hypervisor";

    my $pkgs = _coerce_array($config->param('packages'));
    # We absolutely must have atd, sendmail and make.
    push(@$pkgs, 'sendmail') unless any { $_ eq 'postfix' } @$pkgs;
    push(@$pkgs, qw{at make});
    @$pkgs = uniq @$pkgs;

    my $udf = "$domain_dir/$domain/users.yaml";
    my $userdefs = YAML::XS::Load(File::Slurper::read_text($udf));

    # Inject the SSH key for access into the admin_user's SSH
    inject_admin_key($config->param('admin_user'), $domain, $userdefs, $pubkey);

    #TODO Figure out apt-secure with the mirror
    $YAML::XS::Boolean = "JSON::PP";
    my $clown_config = {
        runcmd => [
            qq{echo "root:$contactemail\n" > /etc/aliases },
            "at now -f /root/setup.sh",
        ],
        package_update  => !!1,
        package_upgrade => !!1,
        packages => $pkgs,
        apt => {
            primary => [
                {
                    arches => [qw{default}],
                    uri    => "mirror+file:/etc/apt/mirrorlist",
                },
            ],
            security => [
                {
                    arches => [qw{default}],
                    uri    => "mirror+file:/etc/apt/mirrorlist",
                },
            ],
            conf => qq|
Acquire {
    Retries "12";
    Force-IPv4: true;
    AllowInsecureRepositories: true;
}
APT {
    Get {
        Assume-Yes "true";
        Fix-Broken "true";
    }
}|,
        },
        users => $userdefs->{users},
        fqdn => $domain,
        manage_etc_hosts => 'localhost',
        final_message => "Boot configuration complete.",
        # Make sure root can scp to/from the transfer user on the HV, and we start shipping logs.
        write_files => [
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/key.rsa"),
                path        => "/root/.ssh/id_rsa",
                owner       => "root:root",
                permissions => '0600',
                defer       => $JSON::PP::true,
            },
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/key.rsa.pub"),
                path        => "/root/.ssh/id_rsa.pub",
                owner       => "root:root",
                permissions => '0600',
                defer       => $JSON::PP::true,
            },
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/setup.sh"),
                path        => "/root/setup.sh",
                owner       => "root:root",
                permissions => "0775",
                defer       => $JSON::PP::true,
            },
            {
                content     => "http://$hv_ip/ubuntu\tpriority:1\nhttp://archive.ubuntu.com/ubuntu\tpriority:2\nhttp://security.ubuntu.com/ubuntu\tpriority:3\n",
                path        => "/etc/apt/mirrorlist",
                permissions => "0644",
                owner       => "root:root",
                defer       => $JSON::PP::false,
            },
        ],
        rsyslog => {
            install_rsyslog => $JSON::PP::true,
            config_dir => '/etc/rsyslog.d',
            configs => [{
                filename => '10-ship_logs_to_hv.conf',
                content  => File::Slurper::read_text("$domain_dir/$domain/rsyslog.conf"),
             }]
        }
    };
    my $cf = $hv->tf_config_dir . "/$domain.cloud_init.cfg";
    File::Slurper::write_text($cf, "#cloud-config\n".YAML::XS::Dump($clown_config));
    return $cf;
}

sub mongle_setup_script {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain          = $config->param('domain');
    my $hvip            = $config->param('hv_internal_ip');
    my $hv_ssh_port     = $config->param('hv_sshd_port');
    my $pre_make_script = $config->param('pre_make_script');

    my $username = $hv->hv_user();
    die "Could not determine the transfer user on the hypervisor" unless $username;
    chomp $username;

    my $script_template = File::Slurper::read_text("$FindBin::Bin/../setup.tmpl");
    $script_template =~ s/%THISIP%/$hvip/gmx;
    $script_template =~ s/%PORT%/$hv_ssh_port/gmx;
    $script_template =~ s/%DOMAIN%/$domain/gmx;
    $script_template =~ s/%THISDIR%/$domain_dir/gmx;
    $script_template =~ s/%USER%/$username/gmx;
    $script_template =~ s/%PRE_MAKE%/$pre_make_script/gmx if $pre_make_script;

    my $sf = "$domain_dir/$domain/setup.sh";
    File::Slurper::write_text($sf, $script_template);
    return $sf;
}

# Make this VM send its rsyslog to here, or wherever is setup correctly
sub mongle_logging_config {
    my $config = shift;

    print "Connecting to Hypervisor...";
    my $hv         = Trog::HV->new();
    print "OK!\n";
    my $domain_dir = $hv->domain_dir;

    my $domain  = $config->param('domain');
    my $ship_to = $config->param('hv_internal_ip');

    my $local_config_template = File::Slurper::read_text("$FindBin::Bin/../rsyslog.tmpl");
    $local_config_template =~ s/%DOMAIN%/$domain/gmx;

    # The guest ships its logs at the HV, so the collector config goes there too.
    my $lcf = "/etc/rsyslog.d/10-$domain.conf";
    $hv->write_text_hv($lcf, $local_config_template, sudo => 1);
    print "Wrote $lcf\n";

    $hv->put_file("$FindBin::Bin/../rsyslog-logrotate.tmpl", "/etc/logrotate.d/vms.conf", sudo => 1);
    print "Wrote /etc/logrotate.d/vms.conf\n";

    #TODO die if these fail
    $hv->system_hv(qw{sudo systemctl restart rsyslog});
    print "Restarted rsyslogd\n";

    my $config_template = File::Slurper::read_text("$FindBin::Bin/../rsyslog-guest.tmpl");
    $config_template =~ s/%LOGHOST%/$ship_to/gmx;

    my $lf = "$domain_dir/$domain/rsyslog.conf";
    File::Slurper::write_text($lf, $config_template);
    return $lf;
}

sub get_tf_managed_domains {
    my ($statefile) = @_;
    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1);

    my $parsed = $json->decode(File::Slurper::read_text($statefile));

    my @domains;
    foreach my $res (@{$parsed->{resources}}) {
        next unless $res->{type} eq 'libvirt_domain';
        push(@domains, $res->{name});
    }
    return \@domains;
}

sub extract_volatile_libvirt_info {
    my ($domains) = @_;

    my %info;
    my $domain;

    my $extract_console = sub {
        my ($t, $section) = @_;

        my $source = $section->first_child('source');
        my $target  = $section->first_child('target');
        my $name  = $target ? $target->att('type') : '';
        $info{$domain}{$name} = $source->att('path') if $source && $name;
        $section->purge();
    };

    my $extract_graphics = sub {
        my ($t, $section) = @_;
        my $type = $section->att('type');
        $info{$domain}{$type} = $section->att('port');
        $section->purge();
    };

    my $xml = XML::Twig->new(
        twig_roots => {
            'console'  => $extract_console,
            'graphics' => $extract_graphics,
        },
        twig_print_outside_roots => 0,
    );

    my $hv = Trog::HV->new();
    foreach my $mongled (@$domains) {
        $domain = $mongled;
        $domain =~ s/-/\./g;

        # First, see if the domain is up.  If it's not, we don't care.
        next unless $hv->domain_is_running($domain);

        my $raw = $hv->domain_xml($domain) or return ();
        $domain = $mongled;
        $xml->parse($raw);
    }

    return %info;
}

# I AM YURI. YOU WILL OBEY ME.
sub brainwash_tfstate {
    my ($statefile, %opts) = @_;

    my $json = JSON::MaybeXS->new(utf8 => 1, pretty => 1);

    my $parsed = $json->decode(File::Slurper::read_text($statefile));

    foreach my $mongled (keys %opts) {
        foreach my $res (@{$parsed->{resources}}) {
            next unless $res->{type} eq 'libvirt_domain';
            next unless $res->{name} eq $mongled;
            foreach my $instance (@{$res->{instances}}) {
                if (exists $instance->{attributes}{devices}{consoles}) {
                    foreach my $console (@{$instance->{attributes}{devices}{consoles}}) {
                        $console->{source}{pty} = $opts{$mongled}{$console->{target}{type}} if $opts{$mongled}{$console->{target}{type}};
                    }
                }
                if (exists $instance->{attributes}{devices}{graphics}) {
                    foreach my $graphic (@{$instance->{attributes}{devices}{consoles}}) {
                        $graphic->{vnc}{port}   = $opts{$mongled}{vnc}   if $opts{$mongled}{vnc}   && exists $graphic->{vnc};
                        $graphic->{spice}{port} = $opts{$mongled}{spice} if $opts{$mongled}{spice} && exists $graphic->{spice};
                    }
                }
            }
        }
    }
    File::Copy::copy($statefile, "$statefile.bak");
    my $encoded = $json->encode($parsed);
    File::Slurper::write_text($statefile, $encoded);
    print "Overwrote $statefile with current VM socket state, old saved as $statefile.bak\n";
    return 1;
}

exit main(@ARGV) unless caller;

1;
