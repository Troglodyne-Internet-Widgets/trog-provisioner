#!/usr/bin/env perl

package Trog::Bin::Provisioner;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aa';
use FindBin();
use FindBin::libs;
use Config::Simple();
use Trog::HV();
use Trog::Local();
use Trog::Hypervisors();
use Trog::Guest();
use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();
use File::Basename();
use File::Slurper();
use IPC::Run3();
use File::Slurper::Temp();
use YAML::XS();
use Cpanel::JSON::XS();
use List::Util   qw{any uniq};
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Carp::Always;

=head1 NAME

provision - build a VM from a domain directory

=head1 SYNOPSIS

    provision [OPTIONS] DOMAIN

    provision vm.example.com
    provision --connect qemu+ssh://root@hv1.example.net/system vm.example.com

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor to build on.  Bypasses
F<hypervisors.conf> entirely: no placement, no capacity check, build it there.
A remote hypervisor has to be named with an ssh transport
(C<qemu+ssh://user@host/system>), since we need its filesystem as well as its
libvirt.

=item B<--credentials>

Read the passwords this run needs from standard input before anything starts,
rather than asking for them.  For a run with no terminal to ask at: tCMS's
reprovision button, a cron.  See L<Trog::Credentials> for the format.

=item B<--no-config>

Skip generating the domain's configuration, and build from whatever is already
in its directory.  Normally F<bin/new_config> is run first, which is what
writes F<provision.conf> and packs F<data.tar.gz>; pass this when you want to
build exactly what is on disk.

=item B<--recipes> FILE

Handed to F<bin/new_config>.  Defaults to F</etc/trog-provisioner/recipes.yaml>.

=item B<--ipmap> FILE

Handed to F<bin/new_config>.  Defaults to F</etc/trog-provisioner/ipmap.cfg>.

=item B<--hvconf> FILE

The fleet definition.  Defaults to F</etc/trog-provisioner/hypervisors.conf>.
When it exists, the hypervisor is chosen from it -- see L<Trog::Hypervisors>.
When it doesn't, the hypervisor is whatever F<provision.conf> and C<--connect>
say, which for most people is still this machine.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.

=item B<--existing> IP

Layer this domain's configuration onto an already running VM rather than
building a new one.

=item B<--dryrun>

Write out everything that would be applied, but don't apply it.

=back

=head1 DESCRIPTION

Reads F<DOMAIN/provision.conf> and F<DOMAIN/users.yaml> out of the domain
directory, renders the libvirt XML and cloud-init configuration for the domain,
and defines it on the hypervisor.  See L<Trog::HV> for what "the
hypervisor" means when it isn't this machine.

=cut

sub _coerce_array {
    return \@_;
}

#TODO: cpu/gpu passthru accel via techniques such as the following:
# https://github.com/HarbourHeading/KVM-GPU-Passthrough

our $dryrun;

# Open a file, or die saying which one and why.
#
# A -f test is a promise about a moment that has already passed by the time
# anything acts on it, and it cannot tell "not there" from "there but not ours
# to read" -- which is the failure this tool actually hits, running as a user
# that may not own the domain directory.  Opening it answers both questions at
# once, and the answer is still true when the handle is used.
sub _must_read {
    my ( $path, $what ) = @_;
    open( my $fh, '<', $path ) or die "$what: $path ($!)\n";
    return $fh;
}

# The same question where the answer is allowed to be no.

=head2 place_guest_secrets($guest, $domain)

Put the files a recipe reads but must never generate onto the guest, out of the
secret store.

C<bin/new_config> leaves a manifest beside the domain saying where each one goes
and which reference holds it -- the reference, never the value, so that nothing
here is readable out of the domain directory or out of a backup of it.  This
resolves them and writes each file, before the makefile that will read them has
started.

Dies if the store cannot be reached.  A guest whose signing key or equivalent
did not arrive is a guest that will make itself a new identity, which is the
whole thing this exists to stop; better to fail here, where an operator is
watching, than three minutes later on the guest.

=cut

# Once per run, whichever path reached it first.  A guest being re-provisioned
# goes through the reuse branch, which places these and then schedules the
# makefile itself; main places them too, for the guest that was just built.  On
# the reuse path both fire, and the second would rewrite a key the recipe had
# already handed to the service now reading it.
my %PLACED;

sub place_guest_secrets {
    my ( $guest, $domain ) = @_;

    return if $PLACED{$domain}++;

    # The same domain directory bin/destroy purges: whatever hypervisor this run
    # is working with says where it is.
    my $manifest = Trog::HV->new()->domain_dir . "/$domain/guest-secrets.yaml";
    return unless _readable($manifest);

    my $wanted = YAML::XS::Load( File::Slurper::read_binary($manifest) );
    return unless ref $wanted eq 'HASH' && %$wanted;

    my %needed = map { $_ => $wanted->{$_}{ref} } keys %$wanted;
    my %values = Trog::Secrets->read( Trog::Config->path('secrets.kdbx'), Trog::Credentials->prompt( 'Enter password:', 'keepass' ), %needed );

    foreach my $path ( sort keys %$wanted ) {
        my $value = $values{$path};
        die "The secret store had nothing for $wanted->{$path}{ref}, which $domain needs at $path\n"
          unless defined $value && length $value;

        # The directory the recipe will later make: this runs first, so it is not
        # there yet and a write into it would fail.
        my $dir = File::Basename::dirname($path);
        die "Could not make $dir on $domain\n" if $guest->run_sudo( 'mkdir', '-p', $dir );

        $guest->write_text( $path, "$value\n", sudo => 1, mode => $wanted->{$path}{mode} // '0600' )
          or die "Could not place $path on $domain\n";

        # Attempted rather than required: this runs before the makefile, so the
        # account that will own the file usually belongs to a package that is
        # not installed yet.  The mode above is what keeps the secret to itself
        # in the meantime, and the recipe chowns it once the service exists --
        # which is why guest_secrets says the owner is what it ends up as
        # rather than what it lands as.
        my $owner = $wanted->{$path}{owner} // 'root:root';
        warn "$path is root's for now: no $owner on $domain yet, so the recipe has to give it away\n"
          if $guest->run_sudo( 'chown', $owner, $path );

        print "Placed $path on $domain from $wanted->{$path}{ref}\n";
    }

    return 1;
}

sub _readable {
    my ($path) = @_;
    open( my $fh, '<', $path ) or return 0;
    close $fh;
    return 1;
}

sub main {
    my @args = @_;

    ## no critic (Plicease::ProhibitLeadingZeros) -- a file mode, which is octal
    umask 0022;

    my ( $reuse, $uri, $domain_dir, $hvconf, $no_config, $recipes, $ipmap, $credentials );
    GetOptionsFromArray(
        \@args,
        'existing=s'  => \$reuse,
        'domaindir=s' => \$domain_dir,
        'dryrun'      => \$dryrun,
        'connect=s'   => \$uri,
        'hvconf=s'    => \$hvconf,
        'no-config'   => \$no_config,
        'recipes=s'   => \$recipes,
        'ipmap=s'     => \$ipmap,
        'credentials' => \$credentials,
    );

    # Before anything that could want one, and only when asked: see
    # Trog::Credentials, which will not read a handle nobody offered it.
    Trog::Credentials->load() if $credentials;

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    # Everything the hypervisor knows about itself comes off provision.conf, so
    # we have to find that the hard way first.
    $domain_dir //= '/opt/domains';
    $domain =~ s/\///g;

    # Build the domain's configuration first.  It is what writes provision.conf
    # and packs data.tar.gz, and it needs the hypervisor to write either -- so
    # it picks the hypervisor too, and everything after this shares it.
    generate_config(
        $domain,
        {
            domain_dir => $domain_dir,
            recipes    => $recipes,
            ipmap      => $ipmap,
            hvconf     => $hvconf,
            uri        => $uri,
        }
    ) unless $no_config;

    my $cfile = "$domain_dir/$domain/provision.conf";
    close _must_read( $cfile, "No provision.conf for $domain" );

    my $udf = "$domain_dir/$domain/users.yaml";
    close _must_read( $udf, "No users.yaml for $domain" );

    my $config = Config::Simple->new($cfile);
    my $reuser = $config->param('admin_user') // 'root';

    # Figure out which hypervisor we're talking to before we touch anything.
    # Every other sub picks this same object back up with Trog::HV->new().
    my $hv = choose_hypervisor(
        $config, $domain,
        {
            uri        => $uri,
            domain_dir => $domain_dir,
            hvconf     => $hvconf,
        }
    );
    print "Provisioning against hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    # The storage pool is the hypervisor's, and it may not have one yet.
    $hv->mkpath( $hv->pool_path )
      or die "Could not create storage pool dir " . $hv->pool_path . " on the hypervisor";

    $domain_dir = $hv->domain_dir;
    my $data = "$domain_dir/$domain/data.tar.gz";
    close _must_read( $data, "No data to host for $domain" );

    # Start off by fixing a sillyness in virtiofs.  This runs as part of the
    # qemu process, so it has to land on the hypervisor, not on us.
    if ( !$hv->file_exists('/usr/libexec/virtiofs-better') ) {
        $hv->put_file( "$FindBin::Bin/../virtiofs-better", '/usr/libexec/virtiofs-better', sudo => 1 )
          or die('Could not copy virtiofs-better to /usr/libexec/virtiofs-better, you may have to do this manually');
        $hv->run_sudo(qw{chmod 0755 /usr/libexec/virtiofs-better});
    }

    # Now, let's figure out if this has a VM which needs to be built first.
    # In the event reuse is passed, we are just layering configs really.
    my $skey    = "$domain_dir/$domain/key.rsa";
    my $depends = $config->param('depends_on');
    if ($depends) {
        print "$domain depends on $depends, provisioning that first...\n";
        my $dcfile = "$domain_dir/$depends/provision.conf";
        close _must_read( $cfile, "No provision.conf for $depends, which $domain depends on" );
        my $dconfig = Config::Simple->new($dcfile);

        #XXX should probably die here if the admin_users differ!

        $skey = "$domain_dir/$depends/key.rsa";
        ( $reuser, $reuse ) = provision_domain( $dconfig, $depends, $reuse, $reuser );
        if ( !$dryrun ) {
            my $guest = Trog::Guest->new( name => $depends, host => $reuse, user => $reuser, key_path => $skey );
            $guest->wait_for_ssh();
            $guest->wait_for_cloud_init($domain);
            $hv->eject_cdrom($depends);
            $guest->wait_for_makefile($depends);
        }

    }

    #TODO need to figure out how to apply the cloud-init for the second domain if deps are active
    my ( $user, $ip ) = provision_domain( $config, $domain, $reuse, $reuser, $depends );
    return 0 if $dryrun;

    print "ssh -i $skey $user\@$ip\n";
    my $guest = Trog::Guest->new( name => $domain, host => $ip, user => $user, key_path => $skey );
    $guest->wait_for_ssh();

    my $map = "$domain_dir/$domain/devices.map";
    if ( _readable($map) ) {
        print "Syncing disk map\n";
        $guest->put_file( $map, '/root/devices.map', sudo => 1 )
          or die "could not sync devices map!";
    }

    # Before cloud-init has finished, and so well before the makefile it
    # schedules starts: these are what a recipe reads rather than generates.
    place_guest_secrets( $guest, $domain );

    $guest->wait_for_cloud_init($domain);

    # Only now.  The seed ISO has to stay in the drive for as long as cloud-init
    # might want to read it, which is until it says it is finished; pulling it
    # out any earlier leaves the guest with no user, no keys and no netplan, and
    # the pulling-out is only to stop the guest booting off it next time.
    $hv->eject_cdrom($domain);

    $guest->wait_for_makefile($domain);

    return 0;
}

# Run the config generator for this domain, if there is anything for it to
# work from.
#
# The two used to be separate repositories and separate runs: you generated a
# domain's configuration, then provisioned it.  That worked while the generator
# could assume it was running on the hypervisor it was writing about -- it read
# the internal IP and the sshd port off the local machine.  Once the hypervisor
# became a choice, the two halves had to agree on which one, and the only
# honest way for them to agree is to be one program.
sub generate_config {
    my ( $domain, $opts ) = @_;

    my $dir     = $opts->{domain_dir};
    my $recipes = $opts->{recipes} // Trog::Config->path('recipes.yaml');
    my $ipmap   = $opts->{ipmap}   // Trog::Config->path('ipmap.cfg');

    # No site data, nothing to generate: somebody is provisioning from a domain
    # directory they wrote by hand, which is a supported thing to do.
    my $recipe_dir = File::Basename::dirname($recipes) . '/recipes.d';
    unless ( _readable($recipes) || -d $recipe_dir ) {
        print "No recipes at $recipes, building from what is already in $dir/$domain\n";
        return 0;
    }

    print "Generating the configuration for $domain...\n";

    # An explicit --connect settles the hypervisor before the generator gets to
    # choose one; it picks the singleton up from there.
    Trog::HV->new( uri => $opts->{uri}, domain_dir => $dir ) if $opts->{uri};

    push @INC, '.';
    my $generator = File::Basename::dirname(__FILE__) . '/new_config';
    require $generator;    ## no critic (Modules::RequireBarewordIncludes)
    my $result = Trog::Provisioner::Config::Generator::main( '--recipes', $recipes, '--ipmap', $ipmap, $domain );

    die "Could not generate the configuration for $domain\n" if $result;
    return 1;
}

# Which hypervisor does this guest belong on?
#
# --connect is the manual override and skips every question below.  Otherwise,
# if there is a hypervisors.conf, it decides: the guest goes where it already
# lives, or where it fits.  With no fleet configured we are back to the old
# behaviour, where provision.conf carried the connection details itself.
sub choose_hypervisor {
    my ( $config, $domain, $opts ) = @_;

    my %paths = ( domain_dir => $opts->{domain_dir} );

    return Trog::HV->new( uri => $opts->{uri}, %paths ) if $opts->{uri};

    my $fleet = Trog::Hypervisors->load( $opts->{hvconf} // Trog::Hypervisors->default_path );
    return Trog::HV->from_config( $config, %paths ) unless $fleet->configured;

    warn "hypervisors.conf decides which hypervisor $domain lands on; the " . "libvirt_uri in its provision.conf is ignored\n"
      if $config->param('libvirt_uri');

    my $hv = $fleet->select_for( $domain, $config );

    # The command line still outranks the fleet on where *our* files go.
    $hv->{domain_dir} = $opts->{domain_dir} if defined $opts->{domain_dir};
    return $hv;
}

sub provision_domain {
    my ( $config, $domain, $reuse, $reuser, $depends ) = @_;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    # Set this to simplify calling conventions
    $config->param( 'domain', $domain );

    # Order matters here.  The network configuration works out the hypervisor's
    # internal IP and sshd port and stashes them on the config; the setup script
    # needs both; the logging config writes the rsyslog drop-in that cloud-init
    # then reads back in.
    my %seed;
    $seed{'network-config'} = mongle_network_configuration($config);
    print "Wrote the network configuration for $domain\n";

    my $ss = mongle_setup_script($config);
    print "Wrote $ss\n";

    my $lc = mongle_logging_config($config);
    print "Wrote $lc\n";

    $seed{'user-data'} = mongle_cloud_init($config);
    $seed{'meta-data'} = mongle_meta_data($config);
    print "Wrote the cloud-init configuration for $domain\n";

    # If the domain is already up, let's find the IP.
    # We can't guarantee we have a static IP, so use the internal.
    my $qdn = $domain;
    $qdn = $depends if $depends;
    $qdn =~ s/\.\S+$//;

    # By MAC, which is exact: the hostname match this used to do could be
    # fooled by a guest that is a subdomain of another.
    my $nat_mac = $hv->guest_mac( $domain, 0 );
    my $old_ip  = $hv->lease_ip( 'default', mac => $nat_mac ) // 'bogus';

    if ($reuse) {
        my $old_ssh_ip = $hv->guest_ssh_ip( $config, $old_ip );
        return ( $reuser, $old_ssh_ip ) if $dryrun;

        # Re-Use the existing VM, and just ship over what we got and run the makefile again.
        # Try to use the root key if no admin user is passed (this may not work if you locked down the box!)
        # Otherwise we'll use the agent.
        my $key = "$domain_dir/$domain/key.rsa";
        $key = "$domain_dir/$depends/key.rsa" if $depends;

        # Make sure any existing VMs don't have this domain
        clean_domain_resources($domain);

        print "Attempting to access Machine\n";
        my $guest = Trog::Guest->new( name => $domain, host => $old_ssh_ip, user => $reuser, key_path => $key );

        my $output = '';
        print "Installing Updated cloud-init and forcing re-run...\n";
        my $init   = "$domain_dir/$domain/user-data";
        my $ci_dir = "/var/lib/cloud/instances/$domain";
        $guest->put_file( $init, 'cloud-config.txt' ) or die "Could not ship the cloud-init config to $domain";

        # Remove the semaphore that says this was run, then run the needed targets
        $guest->run_sudo( qw{rm}, "$ci_dir/sem/cc_package_update_upgrade_install" );
        print $guest->capture('sudo cloud-init single --name cc_package_update_upgrade_install -f cloud-config.txt') . "\n";
        $guest->run_sudo( qw{rm}, "$ci_dir/sem/cc_users_groups" );
        print $guest->capture('sudo cloud-init single --name cc_users_groups -f cloud-config.txt') . "\n";

        my $ips         = _coerce_array( $config->param('ips') );
        my $existing_nc = $guest->capture('sudo cat /etc/netplan/50-cloud-init.yaml');
        my $parsed      = YAML::XS::Load($existing_nc);

        my $adapter   = primary_adapter( $parsed, $config, $hv->guest_mac( $domain, 1 ) );
        my $addresses = ( $parsed->{network}{ethernets}{$adapter}{addresses} //= [] );

        my $num_ips = scalar @$addresses;
        @$addresses = uniq( @$addresses, map { "$_/24" } @$ips );
        if ( $num_ips != scalar @$addresses ) {
            my $encoded    = YAML::XS::Dump($parsed);
            my $new_config = "$domain_dir/$domain/network-config-merged.yaml";
            File::Slurper::Temp::write_text( $new_config, $encoded );
            print "Setting up IP for $domain...\n";

            # Straight to where it belongs, as root, rather than landing in the
            # home directory and being moved and chmodded afterwards.
            $guest->put_file( $new_config, '/etc/netplan/50-cloud-init.yaml', sudo => 1, mode => '0600' )
              or die "Could not install the netplan config on $domain";
            $output = $guest->capture('sudo netplan apply');
            chomp $output;
            print "$output\n" if $output;
        }

        print "Syncing setup script\n";
        $guest->put_file( "$domain_dir/$domain/setup.sh", "/root/setup-$domain.sh", sudo => 1, mode => '0755' )
          or die "Could not ship the setup script to $domain";
        place_guest_secrets( $guest, $domain );
        print "Scheduling job to run setup script\n";
        print $guest->capture("sudo at now -f /root/setup-$domain.sh");
        print "Done.\n";
        return ( $reuser, $old_ssh_ip );
    }

    # Anything already answering to this name has to go before we define one.
    clean_domain_resources($domain);

    my ( $xml, $file ) = mongle_domain_xml( $config, \%seed );
    print "Wrote $file\n";

    return ( $config->param('admin_user'), $hv->guest_ssh_ip( $config, $old_ip ) ) if $dryrun;

    print "Defining and starting $domain...\n";
    $hv->define_domain($xml);

    # We used to nuke the old lease here, because a rebuilt guest arrived with a
    # freshly generated MAC and so took a second address while the first sat in
    # the table until it expired.  Its MAC is derived from its name now, so it
    # asks for the lease it already had and there is nothing to clean up --
    # which also means we wait for that lease to appear rather than for a
    # different address to.
    # Its MAC is derived from its name, so a rebuilt guest asks for the lease it
    # already had.  That also means the lease is usually already in the table
    # before this guest has finished POSTing -- it is the previous boot's, for
    # the same MAC and the same address.  So this finds the address; it does not
    # establish that anything is running at it.  wait_for_ssh does that.
    print "Looking up the address for $domain...";
    my $new_ip = '';
    for ( 1 .. 30 ) {
        $new_ip = $hv->lease_ip( 'default', mac => $nat_mac );
        last if $new_ip;
        print ".";
        sleep 1;
    }
    die "\n$domain never asked for a lease!\n" unless $new_ip;

    print "\nDefined and started; $domain should come up at $new_ip\n";

    return ( $config->param('admin_user'), $hv->guest_ssh_ip( $config, $new_ip ) );
}

# Which entry in the guest's netplan is the outbound interface?
#
# By MAC, because that is the one thing about an interface we decide and the
# guest cannot disagree with.  cloud-init writes the MAC it matched on into
# netplan, so the entry we want identifies itself; the name it ended up with is
# a consequence and not a handle.  Falling back to the name covers a guest
# built before any of this, whose netplan has no match stanza at all.
sub primary_adapter {
    my ( $netplan, $config, $mac ) = @_;

    my $ethernets = $netplan->{network}{ethernets};
    die "No ethernets at all in the guest's netplan config!\n" unless ref $ethernets eq 'HASH';

    foreach my $name ( sort keys %$ethernets ) {
        my $match = $ethernets->{$name}{match} or next;
        next unless ref $match eq 'HASH' && defined $match->{macaddress};
        return $name if lc $match->{macaddress} eq lc $mac;
    }

    my ( undef, $bridge_slot ) = Trog::HV->new()->nic_slots;
    my $named = $config->param('bridge_devname') // "ens$bridge_slot";
    return $named if ref $ethernets->{$named} eq 'HASH';

    die "Could not find the outbound adapter in the guest's netplan: nothing matches\n" . "$mac, and there is no $named either.  It has: " . join( ', ', sort keys %$ethernets ) . "\n";
}

# Whatever is already answering to this name, gone.
#
# A domain we are about to define cannot share a name with one that already
# exists, and its disk is a fresh overlay on the base image -- keeping the old
# one would hand the new guest the old one's filesystem.  This used to have to
# fight terraform for the privilege; now it asks libvirt.
sub clean_domain_resources {
    my ($domain) = @_;
    my $hv = Trog::HV->new();

    if ( $hv->domain_exists($domain) ) {
        print "Terminating the existing VM $domain\n";
        $hv->annihilate_domain($domain);
    }

    $hv->delete_volume("$domain-qcow2");
    $hv->delete_volume("$domain-cloudinit.iso");
    return 1;
}

# Render the libvirt XML for a domain, and make the disks it refers to.
#
# This used to write terraform HCL.  Terraform's model is that it owns the
# world and may rebuild it; ours is that the hypervisor owns the world and we
# are adding one guest.  Reconciling those cost a state file per hypervisor,
# import blocks, ignore_changes for attributes the provider would not report
# back, and a provider that cannot import a volume at all.  This is less code
# than the machinery that was keeping terraform's opinion at bay.
sub mongle_domain_xml {
    my ( $config, $seed ) = @_;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain    = $config->param('domain');
    my $image     = $config->param('image');
    my $disk_size = $config->param('size');
    my $ram_mb    = $config->param('memory');
    my $cpus      = $config->param('cpus');

    # host-passthrough exposes the bare-metal CPU (incl. AVX/AVX2/etc.) to the
    # guest -- required by anything that probes cpuid for vector extensions
    # (e.g. the `claude` CLI bundled v8 snapshot).  Override to host-model,
    # custom, or a specific model name only if you need live migration to a
    # differently-specced HV.
    my $cpu_mode = $config->param('cpu_mode') // 'host-passthrough';

    # These have no sane default, and every one of them goes into the XML.
    # Say which one is missing rather than producing a domain that won't define.
    foreach my $required (
        [ image  => $image ],  [ size => $disk_size ],
        [ memory => $ram_mb ], [ cpus => $cpus ],
    ) {
        my ( $key, $value ) = @$required;
        die "MUST SET $key in provision.conf for $domain\n" unless defined $value && length $value;
    }

    my $bridge_device = $hv->bridge_device;
    print "Using outbound bridge $bridge_device\n";

    # The pool, the image everything is layered on, and this guest's own disk.
    $hv->pool();
    my $base        = $hv->base_image($image);
    my $disk_volume = "$domain-qcow2";
    $hv->create_disk( $disk_volume, backing => $base, capacity => $disk_size );

    # Worked out once, from what this hypervisor will take, and handed to every
    # disk in the domain.  The metadata cache is the exception: it is a function
    # of how large the image is, so only the disk whose size we know gets one.
    my %tuning = mongle_disk_tuning($config);
    my %qcow2  = $hv->qcow2_tuning($disk_size);
    $tuning{metadata_cache} = $qcow2{metadata_cache};

    my ( $extra_disks, $filesystems ) = mongle_extra_disks( $config, \%tuning );
    my $tpm       = mongle_tpm($hv);
    my $iothreads = mongle_iothreads( $tuning{iothreads} );

    # NoCloud wants all three, and cloud-init will not look at a seed that is
    # missing any of them.
    foreach my $file (qw{user-data meta-data network-config}) {
        die "No $file to build the cloud-init seed for $domain from\n"
          unless defined $seed->{$file} && length $seed->{$file};
    }
    my $cloudinit = $hv->cloudinit_iso( $domain, %$seed );

    my $xml           = File::Slurper::read_text( File::Basename::dirname(__FILE__) . '/../domain.xml.tmpl' );
    my %substitutions = (
        REPLACEME   => $domain,
        MUGUBYTES   => $ram_mb,
        NUMCPUS     => $cpus,
        CPUMODE     => $cpu_mode,
        NATMAC      => $hv->guest_mac( $domain, 0 ),
        BRIDGEMAC   => $hv->guest_mac( $domain, 1 ),
        POOLNAME    => 'tf_disks',
        DISKVOLUME  => $disk_volume,
        CLOUDINIT   => $cloudinit,
        BRIDGENAME  => $bridge_device,
        IOTHREADS   => $iothreads,
        DISKDRIVER  => disk_driver_xml( \%tuning, format => 'qcow2', primary => 1, index => 0 ),
        DISKTUNE    => disk_tune_xml( \%tuning ),
        EXTRADISKS  => $extra_disks,
        FILESYSTEMS => $filesystems,
        TPM         => $tpm,
    );
    $xml =~ s/%$_%/$substitutions{$_}/gmx for keys %substitutions;

    my $file = "$domain_dir/$domain/domain.xml";
    File::Slurper::Temp::write_text( $file, $xml );
    return ( $xml, $file );
}

# A TPM for the guest, when the hypervisor has one to justify it.
#
# swtpm, so the guest's TPM is emulated -- a process per domain, with its state in
# a file on the hypervisor.  See Trog::HV::has_tpm for why that file existing on a
# machine with no hardware TPM of its own means the guest is better off without
# one: a key sealed to a file beside the disk image is sealed to whatever takes
# the disk image.
#
# tpm-crb rather than tpm-tis: crb is the interface a TPM 2.0 is meant to present,
# and what a current guest kernel looks for first.
sub mongle_tpm {
    my ($hv) = @_;

    if ( !$hv->has_tpm ) {
        print "No hardware TPM on the hypervisor, so this guest gets none either\n";
        return '';
    }

    print "Hypervisor has a TPM; giving the guest an emulated one\n";
    return <<'XML';
    <!-- Emulated, and here because the hypervisor has a real one to make the
         state file worth trusting.  See mongle_tpm in bin/provision. -->
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>
XML
}

# How every disk in this domain is driven, worked out once.
#
# Nothing in here is emitted because it is a good idea.  It is emitted because
# Trog::HV::supports says this hypervisor's libvirt will parse it and this
# hypervisor's qemu will implement it -- the fleet is not all one version, and
# the two ways of getting it wrong land in different places.  XML libvirt cannot
# parse is a domain that will not define, which we find out here.  XML libvirt
# parses and hands to a qemu that has never heard of it is a domain that defines
# and then will not start, which we find out somewhere much less convenient.
#
# Every knob has a provision.conf key, and an explicit setting is obeyed as
# written.  See docs/CONFIGURATION.md.
sub mongle_disk_tuning {
    my ($config) = @_;
    my $hv = Trog::HV->new();

    my $iothreads = disk_iothreads( $config, $hv );

    return (
        cache            => disk_cache( $config, $hv ),
        io               => disk_io( $config, $hv ),
        discard          => $hv->supports('discard') ? 1 : 0,
        detect_zeroes    => disk_detect_zeroes( $config, $hv ),
        discard_no_unref => $hv->supports('discard_no_unref') ? 1 : 0,
        iothreads        => $iothreads,
        mapping          => ( $iothreads > 1 && $hv->supports('iothread_mapping') ) ? 1 : 0,
        queues           => disk_queues( $config, $hv ),
        blockio          => disk_blockio( $config, $hv ),
        iotune           => disk_iotune( $config, $hv ),
    );
}

# Config::Simple hands back undef for a key that is not there, and an empty
# string for one that is there with nothing after the '='.  Neither is an answer.
sub _asked {
    my ( $config, $key ) = @_;
    my $value = $config->param($key);
    return undef unless defined $value && length $value;
    return $value;
}

# cache='none' is the only knob here that no version can answer for.
#
# Unset, qemu caches every guest block in the host's page cache as well as the
# guest's own -- so a hypervisor holds two copies of everything, in memory that
# Trog::Hypervisors is not counting when it decides what else fits.  O_DIRECT
# gives that back.  What it costs is the shared base image: every guest is an
# overlay on one file, and writeback means the host caches that file once for
# all of them.  That is a real trade rather than a free win, which is why it is
# a key rather than a constant.
#
# What decides it is whether the pool's filesystem will take an O_DIRECT write,
# since one that will not fails qemu's open and the domain defines cleanly and
# then refuses to start.  That is asked of the filesystem: see
# Trog::HV::pool_takes_direct_io for why naming filesystems does not work.
sub disk_cache {
    my ( $config, $hv ) = @_;

    my $asked = _asked( $config, 'disk_cache' );
    return $asked if $asked;
    return 'none' if $hv->pool_takes_direct_io;

    print "The storage pool, on " . $hv->pool_fstype . ", would not take an O_DIRECT write, so this\n" . "guest gets cache='writeback' rather than a domain that defines and then won't start.\n" . direct_io_advice($hv) . "Set disk_cache in provision.conf to say otherwise.\n";
    return 'writeback';
}

# Which of the two ZFS answers this is, when it is ZFS: a release with no Direct
# I/O at all, or one that has it and a pool or a dataset configured not to use
# it.  An operator can act on either, and can act on neither if all they are
# told is that the filesystem said no.
sub direct_io_advice {
    my ($hv) = @_;
    return '' unless $hv->pool_fstype eq 'zfs';

    my $version = $hv->zfs_version;
    return "The pool is on ZFS and the hypervisor would not say which version; ask it with\n" . "`cat /sys/module/zfs/version`.\n"
      unless defined $version;

    return "OpenZFS is $version here and Direct I/O arrived in 2.3, so this wants an upgrade.\n"
      if _zfs_predates_direct_io($version);

    return "OpenZFS $version has Direct I/O, so it is the pool or the dataset refusing it:\n" . "`zpool get all` for the feature flags, `zfs get direct` for the property.\n";
}

# 2.10 is a later release than 2.3, which a string comparison gets backwards.
sub _zfs_predates_direct_io {
    my ($version) = @_;
    my ( $major, $minor ) = $version =~ m/^(\d+)[.](\d+)/ or return 0;
    return ( ( $major * 1_000 ) + $minor ) < 2_003 ? 1 : 0;
}

# Left to qemu unless asked for: the AIO backend is the one thing on this list
# the domain template used to set and no longer does, and turning it back on
# behind somebody's back is not this function's business.  disk_io=io_uring
# reinstates it, on a hypervisor whose qemu has it.
sub disk_io {
    my ( $config, $hv ) = @_;

    my $asked = _asked( $config, 'disk_io' ) or return undef;
    return $asked unless $asked eq 'io_uring';
    return 'io_uring' if $hv->supports('io_uring');

    print "disk_io=io_uring needs libvirt 6.3 and qemu 5.0; " . $hv->describe . " has older,\n" . "so the disk is left on qemu's own choice of AIO backend.\n";
    return undef;
}

# Off unless asked for, which is a deliberate departure from "turn the discard
# path on".  detect_zeroes='unmap' makes qemu inspect every write for a buffer
# of zeros, on the write path, for the sake of reclaiming space the guest never
# asked to reclaim -- and the guest's weekly fstrim, which discard='unmap' now
# passes through, reclaims what it actually freed without spending anything per
# write.  Worth having on a guest that genuinely writes zeros in bulk; not worth
# it as a default for every guest.
sub disk_detect_zeroes {
    my ( $config, $hv ) = @_;

    my $asked = _asked( $config, 'disk_detect_zeroes' ) or return undef;
    return $asked if $hv->supports('detect_zeroes');

    print "disk_detect_zeroes needs libvirt 2.0; " . $hv->describe . " has older, so it is left off.\n";
    return undef;
}

# One by default: without it, virtio-blk submission runs on qemu's main loop,
# serialised against everything else that loop does.  More than one is only
# worth asking for on a guest with several busy disks, or on a hypervisor new
# enough to spread one disk's queues across them -- see disk_driver_xml.
sub disk_iothreads {
    my ( $config, $hv ) = @_;

    my $asked = _asked( $config, 'disk_iothreads' ) // 1;
    return 0      if $asked <= 0;
    return $asked if $hv->supports('iothread');

    print "disk_iothreads needs libvirt 1.2.8 and qemu 2.1; " . $hv->describe . " has older,\n" . "so this guest's disks stay on qemu's main loop.\n";
    return 0;
}

# One virtqueue per vcpu unless told otherwise.  Recent qemu sizes virtio-blk
# this way itself, so on most of the fleet this says out loud what was already
# happening -- but it has to be said out loud to be mapped across iothreads.
sub disk_queues {
    my ( $config, $hv ) = @_;
    return undef unless $hv->supports('queues');

    my $asked = _asked( $config, 'disk_queues' ) // $config->param('cpus');
    return $asked > 0 ? $asked : undef;
}

# What the guest is told its sectors are.  virtio-blk says 512/512 by default,
# so a guest lays its filesystem out for 512 byte sectors and then does
# read-modify-write against 4K hardware underneath for the life of the disk.
#
# This has to be right before the guest's filesystem is made; setting it on an
# existing guest realigns nothing.  4096 is safe to announce even on a 512n
# device -- the guest merely aligns to a boundary that device does not care
# about -- which is why it is the default rather than something probed.
sub disk_blockio {
    my ( $config, $hv ) = @_;
    return undef unless $hv->supports('blockio');

    return {
        logical  => _asked( $config, 'disk_logical_block_size' )  // 512,
        physical => _asked( $config, 'disk_physical_block_size' ) // 4096,
    };
}

# The limits, in the order libvirt wants them.
my @IOTUNE_KEY = qw{
  total_bytes_sec read_bytes_sec write_bytes_sec
  total_iops_sec  read_iops_sec  write_iops_sec
};

# hypervisors.conf reserves memory, CPUs and disk space, and reserves nothing at
# all of the one resource every guest on a machine is sharing a queue for.  One
# guest running a backup can flatten every other guest in the pool and no
# capacity check will have predicted it.  This is the knob that answers that;
# it is off unless a guest is given limits, because a throttle is a cost and
# only the person who knows the workload can say what it should be.
#
# Unsupported is fatal rather than skipped: every other knob here failing open
# leaves a guest merely untuned, but a throttle silently not applied leaves
# somebody believing in a limit that is not there.
sub disk_iotune {
    my ( $config, $hv ) = @_;

    my %limit = map { $_ => _asked( $config, "disk_$_" ) } @IOTUNE_KEY;
    delete @limit{ grep { !defined $limit{$_} } keys %limit };
    return undef unless %limit;

    die "disk_*_bytes_sec/disk_*_iops_sec need libvirt 0.9.8, and " . $hv->describe . " is older.\n" . "Remove them from provision.conf, or build this guest somewhere that can honour them.\n"
      unless $hv->supports('iotune');

    # libvirt's own rule: a total is a total, and may not be given beside the
    # halves it is the total of.
    foreach my $unit (qw{bytes_sec iops_sec}) {
        next unless $limit{"total_$unit"};
        die "disk_total_$unit cannot be set alongside disk_read_$unit or disk_write_$unit:\n" . "libvirt takes a total or the two halves, never both.\n"
          if $limit{"read_$unit"} || $limit{"write_$unit"};
    }

    return \%limit;
}

# The <driver> for one disk.  %opts is its format and its position among the
# domain's disks; the primary one is the disk that gets the metadata cache and
# the queue mapping, being the one whose size we know and the one that is busy.
sub disk_driver_xml {
    my ( $tuning, %opts ) = @_;

    my $format = $opts{format};
    my @attrs  = ( "name='qemu'", "type='$format'" );

    push @attrs, "cache='$tuning->{cache}'"                 if $tuning->{cache};
    push @attrs, "io='$tuning->{io}'"                       if $tuning->{io};
    push @attrs, "discard='unmap'"                          if $tuning->{discard};
    push @attrs, "detect_zeroes='$tuning->{detect_zeroes}'" if $tuning->{detect_zeroes};
    push @attrs, "queues='$tuning->{queues}'"               if $tuning->{queues};

    # A qcow2 knob, and the extra disks are not all qcow2: on a raw block device
    # there is no cluster to keep the reference to.  What it does buy, on the
    # ones that are, is a guest discard that punches the hole in the host's
    # filesystem without unrefing the cluster in the image -- so the space comes
    # back without the qcow2 fragmenting itself rewriting what it just freed.
    push @attrs, "discard_no_unref='on'" if $tuning->{discard_no_unref} && $format eq 'qcow2';

    # iothread and iothreads are mutually exclusive, and the mapping only goes
    # on the disk it was worked out for.  Everything else gets one iothread out
    # of the pool, round robin, so a guest with several disks spreads them --
    # and with the default pool of one they share it and are still off the main
    # loop, which is the part that mattered.
    my $mapped = $opts{primary} && $tuning->{mapping};
    push @attrs, sprintf( "iothread='%d'", ( ( $opts{index} // 0 ) % $tuning->{iothreads} ) + 1 )
      if $tuning->{iothreads} && !$mapped;

    my @children = disk_driver_children( $tuning, %opts );
    my $attrs    = join( ' ', @attrs );

    return "      <driver $attrs/>\n" unless @children;
    return "      <driver $attrs>\n" . join( '', @children ) . "      </driver>\n";
}

sub disk_driver_children {
    my ( $tuning, %opts ) = @_;
    my @children;

    push @children, "        <metadata_cache><max_size unit='bytes'>$tuning->{metadata_cache}</max_size></metadata_cache>\n"
      if $opts{primary} && $tuning->{metadata_cache};

    # Listed without queue children on purpose: given the iothreads and the
    # queue count, libvirt and qemu distribute the virtqueues between them, and
    # a mapping written out by hand here would only be the same answer with more
    # ways to get it wrong.
    return @children unless $opts{primary} && $tuning->{mapping};

    push @children, "        <iothreads>\n";
    push @children, "          <iothread id='$_'/>\n" for 1 .. $tuning->{iothreads};
    push @children, "        </iothreads>\n";

    return @children;
}

# The disk's own tuning elements, which are siblings of <driver> rather than
# attributes of it.
sub disk_tune_xml {
    my ($tuning) = @_;
    my $xml = '';

    $xml .= sprintf( "      <blockio logical_block_size='%d' physical_block_size='%d'/>\n", $tuning->{blockio}{logical}, $tuning->{blockio}{physical} )
      if $tuning->{blockio};

    return $xml unless $tuning->{iotune};

    $xml .= "      <iotune>\n";
    $xml .= "        <$_>$tuning->{iotune}{$_}</$_>\n" for grep { defined $tuning->{iotune}{$_} } @IOTUNE_KEY;
    $xml .= "      </iotune>\n";

    return $xml;
}

# The domain's iothread pool, or nothing when it has none.
#
# Its own function rather than a conditional in the substitution table: what
# goes in there wants to be a name, so that the table stays a list of what each
# placeholder is filled with rather than a place where one of them is also
# worked out.
sub mongle_iothreads {
    my ($count) = @_;
    return '' unless $count;

    return <<"XML" =~ s/\n\z//r;
  <!-- Threads qemu processes virtio-blk requests on: without any, submission
       runs on qemu's main loop, serialised against everything else that loop
       is doing.  See mongle_disk_tuning below. -->
  <iothreads>$count</iothreads>
XML
}

# Whatever mounts.txt asks for, as libvirt device XML.
#
# Each line is pool=name.  A `raw` pool is a host block device, `dir` is a
# directory shared in over virtiofs, `file` is an image file, and anything else
# is taken as the name of another libvirt pool.  `fuse` is skipped: the guest
# mounts those itself.
sub mongle_extra_disks {
    my ( $config, $tuning ) = @_;

    my $hv         = Trog::HV->new();
    my $domain     = $config->param('domain');
    my $domain_dir = $hv->domain_dir;

    my $spec_file = "$domain_dir/$domain/mounts.txt";
    my ( @disks, @filesystems, $mapper );
    $mapper = '';

    if ( _readable($spec_file) ) {
        my @devnames = ( 'vdb' .. 'vdz' );
        my $order    = 2;
        my $index    = 0;

        foreach my $diskspec ( grep { $_ } split( "\n", File::Slurper::read_text($spec_file) ) ) {
            my ( $pool, $disk ) = split( "=", $diskspec );
            next if $pool eq 'fuse';

            $order++;
            my $dev = shift @devnames or die "Ran out of vdnames!\n";

            # The guest gets a map of what it asked for to where it landed.
            $mapper .= $pool eq 'dir' ? "$disk=$dev\n" : "$disk=/dev/$dev\n";

            if ( $pool eq 'dir' ) {

                # virtiofs-better is `virtiofsd --inode-file-handles=mandatory`,
                # without which a busy share runs the daemon out of file handles.
                #
                # The terraform config asked for open_files max here too, and it
                # never did anything: libvirt has no such element, accepts the
                # domain, and silently drops it.  The wrapper is the whole fix.
                push @filesystems, sprintf( <<'FS', _xml($disk), _xml($dev) );
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs' queue='1024'/>
      <binary path='/usr/libexec/virtiofs-better'/>
      <source dir='%s'/>
      <target dir='%s'/>
    </filesystem>
FS
                next;
            }

            $index++;

            if ( $pool eq 'raw' ) {
                push @disks, sprintf( <<'DISK', disk_driver_xml( $tuning, format => 'raw', index => $index ), _xml($disk), _xml($dev), disk_tune_xml($tuning), $order );
    <disk type='block' device='disk'>
%s      <source dev='%s'/>
      <target dev='%s' bus='virtio'/>
%s      <boot order='%d'/>
    </disk>
DISK
                next;
            }

            # A file, or a volume in some other pool -- either way it resolves
            # to a path, and libvirt wants the path.
            my $path = $pool eq 'file' ? $disk : ( $hv->volume_path( $disk, $pool ) // $disk );
            push @disks, sprintf( <<'DISK', disk_driver_xml( $tuning, format => 'qcow2', index => $index ), _xml($path), _xml($dev), disk_tune_xml($tuning), $order );
    <disk type='file' device='disk'>
%s      <source file='%s'/>
      <target dev='%s' bus='virtio'/>
%s      <boot order='%d'/>
    </disk>
DISK
        }
    }

    File::Slurper::Temp::write_text( "$domain_dir/$domain/devices.map", $mapper );
    return ( join( '', @disks ), join( '', @filesystems ) );
}

sub _xml {
    my ($str) = @_;
    $str = '' unless defined $str;
    $str =~ s/&/&amp;/g;
    $str =~ s/</&lt;/g;
    $str =~ s/>/&gt;/g;
    $str =~ s/"/&quot;/g;
    $str =~ s/'/&apos;/g;
    return $str;
}

# Slam in the IPs, gw, resolvers
sub mongle_network_configuration {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain = $config->param('domain');
    my $ips    = _coerce_array( $config->param('ips') );
    my $gw     = $config->param('gateway');
    my $res    = _coerce_array( $config->param('resolvers') );
    die "MUST SET gateway in provision.conf when ips are set\n"
      if @$ips && !( defined $gw && length $gw );

    # These used to have to be told to us, because what the guest calls its
    # interfaces depends on the machine type and the order libvirt happened to
    # assign PCI slots in.  Both are ours to decide now: the slots are pinned in
    # the domain XML, and systemd names a PCI NIC after its hotplug slot, so
    # slot 3 and slot 4 are ens3 and ens4.
    #
    # The MAC is what actually does the work, though.  cloud-init matches the
    # interface on that and renames it to the name below, so a guest whose
    # kernel names things some other way still gets the right configuration on
    # the right card.  The names are only what they end up called afterwards.
    my ( $nat_slot, $bridge_slot ) = $hv->nic_slots;
    my $dhcp_devname   = $config->param('dhcp_devname')   // "ens$nat_slot";
    my $bridge_devname = $config->param('bridge_devname') // "ens$bridge_slot";

    # We need two adapters, one on virbr0 and another on the bridge.
    # So, we need to figure out:
    # 1. IP of the virbr
    # 2. name of the bridge device.
    # 3. IP of bridge device.

    print "Using libvirt network device " . $hv->virbr_device . "\n";
    print "HV internal IP: " . $hv->virbr_ip . "\n";

    # Stash these in the config object for later use by the clown-config
    $config->param( 'hv_internal_ip', $hv->virbr_ip );
    $config->param( 'hv_sshd_port',   $hv->sshd_port );

    # Such an astonishingly tedious format
    my @subnets = map {
        {
            type            => 'static',
            address         => $_,
            gateway         => $gw,
            dns_nameservers => $res,
            dns_search      => [$domain],
        }
    } @$ips;

    # Do DHCP if no IP was supplied
    if ( !@subnets ) {
        @subnets = (
            {
                type => 'dhcp',
            }
        );
    }

    my $netconf = {
        network => {
            version => 1,
            config  => [
                {
                    type        => 'physical',
                    name        => $bridge_devname,
                    mac_address => $hv->guest_mac( $domain, 1 ),
                    subnets     => \@subnets,
                    gateway4    => $gw,
                    nameservers => {
                        search    => [$domain],
                        addresses => $res,
                    }
                },
                {
                    type        => 'physical',
                    name        => $dhcp_devname,
                    mac_address => $hv->guest_mac( $domain, 0 ),
                    subnets     => [
                        {
                            type => 'dhcp',
                        },
                    ],
                },
            ],
        },
    };

    my $rendered = YAML::XS::Dump($netconf);
    File::Slurper::Temp::write_text( "$domain_dir/$domain/network-config", $rendered );
    return $rendered;
}

sub inject_admin_key {
    my ( $admin_user, $domain, $config, $pubkey ) = @_;

    # Don't bother if we aren't setting this up.
    return unless $admin_user;
    return unless ref $config->{users} eq 'ARRAY';

    foreach my $u ( @{ $config->{users} } ) {
        next unless exists $u->{name};
        next unless $u->{name} eq $admin_user;
        $u->{ssh_authorized_keys} //= [];
        push( @{ $u->{ssh_authorized_keys} }, $pubkey );
        return;
    }
    return;
}

# Generate and store a new SSH key for the guest, which we will authorize on the HV to grab the data.tar.gz
sub mongle_cloud_init {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain       = $config->param('domain');
    my $contactemail = $config->param('contact_email');
    my $hv_ip        = $config->param('hv_internal_ip');
    die "MUST SET contact_email in provision.conf for $domain\n"
      unless defined $contactemail && length $contactemail;

    # Generate a new key for the child.  This used to pipe yes(1) in to answer
    # the overwrite prompt; removing the old key first means there is no prompt.
    my $key = "$domain_dir/$domain/key.rsa";
    unlink $key, "$key.pub";
    IPC::Run3::run3( [ qw{ssh-keygen -t rsa -f}, $key, qw{-N}, '', qw{-q} ], \undef, \undef, undef );
    close _must_read( $key,       "ssh-keygen made no key for $domain" );
    close _must_read( "$key.pub", "ssh-keygen made no pubkey for $domain" );
    chmod 0600, "$domain_dir/$domain/key.rsa";
    chmod 0600, "$domain_dir/$domain/key.rsa.pub";

    # Authorize the key with the transfer user *here*.  This is the box the guest
    # scps its payload out of, and it is this one because the payload is written
    # here and is not copied anywhere else.
    my $pubkey = File::Slurper::read_text("$domain_dir/$domain/key.rsa.pub");
    chomp $pubkey;
    my $this_machine = Trog::Local->new();
    $this_machine->append_line( $this_machine->authorized_keys, $pubkey )
      or die "Could not authorize the key for $domain on " . $this_machine->describe . "\n";

    my $pkgs = _coerce_array( $config->param('packages') );

    # We absolutely must have atd, sendmail and make.
    push( @$pkgs, 'sendmail' ) unless any { $_ eq 'postfix' } @$pkgs;
    push( @$pkgs, qw{at make} );
    @$pkgs = uniq @$pkgs;

    my $udf      = "$domain_dir/$domain/users.yaml";
    my $userdefs = YAML::XS::Load( File::Slurper::read_text($udf) );

    # Inject the SSH key for access into the admin_user's SSH
    inject_admin_key( $config->param('admin_user'), $domain, $userdefs, $pubkey );

    #TODO Figure out apt-secure with the mirror
    # The name of YAML::XS's boolean mode, not a choice of JSON module:
    # it takes "JSON::PP" or "boolean" and nothing else.  Both it and
    # Cpanel::JSON::XS::true below give the same JSON::PP::Boolean objects.
    $YAML::XS::Boolean = "JSON::PP";
    my $clown_config = {
        runcmd => [
            qq{echo "root:$contactemail\n" > /etc/aliases },
            "at now -f /root/setup.sh",
        ],
        package_update  => !!1,
        package_upgrade => !!1,
        packages        => $pkgs,
        apt             => {
            primary => [
                {
                    arches => [qw{default}],
                    uri    => "mirror+file:/etc/apt/mirrorlist",
                },
            ],
            security => [
                {
                    arches => [qw{default}],
                    uri    => "mirror+file:/etc/apt/mirrorlist",
                },
            ],
            conf => qq|
Acquire {
    Retries "12";
    Force-IPv4: true;
    AllowInsecureRepositories: true;
}
APT {
    Get {
        Assume-Yes "true";
        Fix-Broken "true";
    }
}|,
        },
        users            => $userdefs->{users},
        fqdn             => $domain,
        manage_etc_hosts => 'localhost',
        final_message    => "Boot configuration complete.",

        # Make sure root can scp to/from the transfer user on the HV, and we start shipping logs.
        write_files => [
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/key.rsa"),
                path        => "/root/.ssh/id_rsa",
                owner       => "root:root",
                permissions => '0600',
                defer       => Cpanel::JSON::XS::true(),
            },
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/key.rsa.pub"),
                path        => "/root/.ssh/id_rsa.pub",
                owner       => "root:root",
                permissions => '0600',
                defer       => Cpanel::JSON::XS::true(),
            },
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/setup.sh"),
                path        => "/root/setup.sh",
                owner       => "root:root",
                permissions => "0775",
                defer       => Cpanel::JSON::XS::true(),
            },
            {
                content     => "http://$hv_ip/ubuntu\tpriority:1\nhttp://archive.ubuntu.com/ubuntu\tpriority:2\nhttp://security.ubuntu.com/ubuntu\tpriority:3\n",
                path        => "/etc/apt/mirrorlist",
                permissions => "0644",
                owner       => "root:root",
                defer       => Cpanel::JSON::XS::false(),
            },
        ],
        rsyslog => {
            install_rsyslog => Cpanel::JSON::XS::true(),
            config_dir      => '/etc/rsyslog.d',
            configs         => [
                {
                    filename => '10-ship_logs_to_hv.conf',
                    content  => File::Slurper::read_text("$domain_dir/$domain/rsyslog.conf"),
                }
            ]
        }
    };

    # Kept beside the domain as well as going into the seed, so you can read
    # what a guest was built with without unpacking an ISO.
    my $user_data = "#cloud-config\n" . YAML::XS::Dump($clown_config);
    File::Slurper::Temp::write_text( "$domain_dir/$domain/user-data", $user_data );
    return $user_data;
}

# NoCloud wants an instance-id.  Keeping it stable across rebuilds is what
# stops cloud-init deciding it has already run and skipping everything.
sub mongle_meta_data {
    my ($config) = @_;
    my $domain = $config->param('domain');

    return YAML::XS::Dump(
        {
            'instance-id'    => $domain,
            'local-hostname' => $domain,
        }
    );
}

sub mongle_setup_script {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain          = $config->param('domain');
    my $pre_make_script = $config->param('pre_make_script');

    # Us, not the hypervisor.  bin/new_config worked out which of our addresses
    # a guest built on this hypervisor can reach, and wrote all three into
    # provision.conf; the tarball never leaves this machine.
    my $transfer_ip   = $config->param('transfer_ip');
    my $transfer_port = $config->param('transfer_port') // 22;
    my $username      = $config->param('transfer_user');
    die "provision.conf for $domain says nothing about where the guest fetches its payload from;\n" . "re-run bin/new_config for it\n"
      unless $transfer_ip && $username;
    chomp $username;

    my $script_template = File::Slurper::read_text("$FindBin::Bin/../setup.tmpl");
    $script_template =~ s/%THISIP%/$transfer_ip/gmx;
    $script_template =~ s/%PORT%/$transfer_port/gmx;
    $script_template =~ s/%DOMAIN%/$domain/gmx;
    $script_template =~ s/%THISDIR%/$domain_dir/gmx;
    $script_template =~ s/%USER%/$username/gmx;
    $script_template =~ s/%PRE_MAKE%/$pre_make_script/gmx if $pre_make_script;

    my $sf = "$domain_dir/$domain/setup.sh";
    File::Slurper::Temp::write_text( $sf, $script_template );
    return $sf;
}

# Make this VM send its rsyslog to here, or wherever is setup correctly
sub mongle_logging_config {
    my $config = shift;

    print "Connecting to Hypervisor...";
    my $hv = Trog::HV->new();
    print "OK!\n";
    my $domain_dir = $hv->domain_dir;

    my $domain  = $config->param('domain');
    my $ship_to = $config->param('hv_internal_ip');

    my $local_config_template = File::Slurper::read_text("$FindBin::Bin/../rsyslog.tmpl");
    $local_config_template =~ s/%DOMAIN%/$domain/gmx;

    # The guest ships its logs at the HV, so the collector config goes there too.
    my $lcf = "/etc/rsyslog.d/10-$domain.conf";
    $hv->write_text( $lcf, $local_config_template, sudo => 1 );
    print "Wrote $lcf\n";

    $hv->put_file( "$FindBin::Bin/../rsyslog-logrotate.tmpl", "/etc/logrotate.d/vms.conf", sudo => 1 );
    print "Wrote /etc/logrotate.d/vms.conf\n";

    #TODO die if these fail
    $hv->run_sudo(qw{systemctl restart rsyslog});
    print "Restarted rsyslogd\n";

    my $config_template = File::Slurper::read_text("$FindBin::Bin/../rsyslog-guest.tmpl");
    $config_template =~ s/%LOGHOST%/$ship_to/gmx;

    my $lf = "$domain_dir/$domain/rsyslog.conf";
    File::Slurper::Temp::write_text( $lf, $config_template );
    return $lf;
}

exit main(@ARGV) unless caller;

1;
