#!/usr/bin/env perl

package Trog::Bin::Provisioner;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aasx';
use FindBin();
use FindBin::libs;
use Config::Simple();
use Trog::HV();
use Trog::Local();
use Trog::Hypervisors();
use Trog::Guest();
use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();
use Provisioner::Cookbook();
use Provisioner::Utils();
use File::Basename();
use File::Slurper();
use File::Slurper::Temp();
use File::Temp();
use Provisioner::IPPool();
use YAML::XS();
use List::Util   qw{uniq};
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Carp::Always;

=head1 NAME

provision - build a VM from a domain directory

=head1 SYNOPSIS

    provision [OPTIONS] DOMAIN

    provision vm.example.com
    provision --connect qemu+ssh://root@hv1.example.net/system vm.example.com

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor to build on.  Bypasses
F<hypervisors.conf> entirely: no placement, no capacity check, build it there.
A remote hypervisor has to be named with an ssh transport
(C<qemu+ssh://user@host/system>), since we need its filesystem as well as its
libvirt.

=item B<--credentials>

Read the passwords this run needs from standard input before anything starts,
rather than asking for them.  For a run with no terminal to ask at: tCMS's
reprovision button, a cron.  See L<Trog::Credentials> for the format.

=item B<--no-config>

Skip generating the domain's configuration, and build from whatever is already
in its directory.  Normally F<bin/new_config> is run first, which is what
writes F<provision.conf> and packs F<data.tar.gz>; pass this when you want to
build exactly what is on disk.

=item B<--salvage-gaps-ok>

Rebuild the guest even though state that is on it did not come off it.

Without this, a salvage that found a directory on the guest and came away with
nothing stops the run before anything is destroyed -- that is what an
unreadable directory looks like, and rebuilding would lose the only copy.  Pass
this when the state really is gone, or you do not want it, and the guest should
be rebuilt regardless.

Only ever typed.  There is no environment variable and no configuration key for
it, because the whole point is that somebody read what it is about to lose.

A directory the guest has never written does not trip this, and neither does a
domain that has no guest yet, so a new machine never needs it.

=item B<--recipes> FILE

Handed to F<bin/new_config>.  Defaults to F</etc/trog-provisioner/recipes.yaml>.

=item B<--ipmap> FILE

Handed to F<bin/new_config>.  Defaults to F</etc/trog-provisioner/ipmap.cfg>.

=item B<--hvconf> FILE

The fleet definition.  Defaults to F</etc/trog-provisioner/hypervisors.conf>.
When it exists, the hypervisor is chosen from it -- see L<Trog::Hypervisors>.
When it doesn't, the hypervisor is whatever F<provision.conf> and C<--connect>
say, which for most people is still this machine.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.

=item B<--existing> IP

Layer this domain's configuration onto an already running VM rather than
building a new one.

=item B<--dryrun>

Write the domain's configuration out and change nothing anywhere else.

F<network-config>, F<user-data>, F<meta-data> and F<setup.sh> land in the domain
directory as they always would, and everything that reaches past it is described
instead of done: no disk or cloud-init seed is made, the domain is neither
destroyed nor defined, and this machine's C<authorized_keys> is left alone.

A domain that already has a key keeps it.  The guest that is up has the public
half, so replacing the private one here would be losing the way in to a machine
this was not going to touch.  A domain with no key yet gets one, since
F<user-data> is written out of it.

F<domain.xml> is the one thing a dry run does not produce.  It is built out of
the paths to the storage pool, the base image, the guest's disk and its seed --
so writing it means making all four, which is the opposite of the point.

=back

=head1 DESCRIPTION

Reads F<DOMAIN/provision.conf> and F<DOMAIN/users.yaml> out of the domain
directory, renders the libvirt XML and cloud-init configuration for the domain,
and defines it on the hypervisor.  See L<Trog::HV> for what "the
hypervisor" means when it isn't this machine.

=cut

sub _coerce_array (@values) {
    return \@values;
}

# Which of these are lists.  Config::Simple hands back a bare string for a file
# that names one of them and an arrayref for one that names two, and what every
# recipe validates against says array -- so a guest with a single resolver would
# be refused for saying what provision.conf has always meant by it.
my %LIST_SETTING = map { $_ => 1 } qw{resolvers ips packages transfer_ips};

# Everything provision.conf says, as a plain hash, for handing to a recipe.
#
# Config::Simple prefixes every key with the block it came from, and
# provision.conf has no blocks -- so a key arrives as 'default.image' and a
# recipe asked for 'image' would see none of them.
#
# Stripped rather than asked for by block: param(-block => 'default') is refused
# outright unless Config::Simple decided the file was ini syntax, which it
# decides by looking for a [header] this file does not have.
sub _settings {
    my ($config) = @_;

    my %vars     = $config->vars();
    my %settings = map { (s/\Adefault[.]//r) => $vars{$_} } keys %vars;

    $settings{$_} = Provisioner::Utils::coerce_arrayref( $settings{$_} )
      for grep { exists $settings{$_} } keys %LIST_SETTING;

    return %settings;
}

#TODO: cpu/gpu passthru accel via techniques such as the following:
# https://github.com/HarbourHeading/KVM-GPU-Passthrough

# Open a file, or die saying which one and why.
#
# A -f test is a promise about a moment that has already passed by the time
# anything acts on it, and it cannot tell "not there" from "there but not ours
# to read" -- which is the failure this tool actually hits, running as a user
# that may not own the domain directory.  Opening it answers both questions at
# once, and the answer is still true when the handle is used.
sub _must_read {
    my ( $path, $what ) = @_;
    open( my $fh, '<', $path ) or die "$what: $path ($!)\n";
    return $fh;
}

=head2 place_guest_secrets($guest, $domain)

Put the files a recipe reads but must never generate onto the guest, out of the
secret store.

C<bin/new_config> leaves a manifest beside the domain saying where each one goes
and which reference holds it -- the reference, never the value, so that nothing
here is readable out of the domain directory or out of a backup of it.  This
resolves them and writes each file, before the makefile that will read them has
started.

Most guests ask for no secret at all, and F<bin/new_config> writes no manifest
for one that does not.  There is nothing to place then, and nothing happens.

Dies if the store cannot be reached.  A guest whose signing key or equivalent
did not arrive is a guest that will make itself a new identity, which is the
whole thing this exists to stop; better to fail here, where an operator is
watching, than three minutes later on the guest.

=cut

# Once per run, whichever path reached it first.  A guest being re-provisioned
# goes through the reuse branch, which places these and then schedules the
# makefile itself; main places them too, for the guest that was just built.  On
# the reuse path both fire, and the second would rewrite a key the recipe had
# already handed to the service now reading it.
my %PLACED;

sub place_guest_secrets {
    my ( $guest, $domain ) = @_;

    return if $PLACED{$domain}++;

    # The same domain directory bin/destroy purges: whatever hypervisor this run
    # is working with says where it is.
    my $manifest = Trog::HV->new()->domain_dir . "/$domain/guest-secrets.yaml";

    # No manifest is the ordinary case: new_config writes one only for a domain
    # whose recipes ask for a secret, and --no-config writes none at all.
    return unless -e $manifest;

    my $wanted = YAML::XS::Load( File::Slurper::read_binary($manifest) );
    return unless ref $wanted eq 'HASH' && %$wanted;

    my %needed = map { $_ => $wanted->{$_}{ref} } keys %$wanted;
    my %values = Trog::Secrets->lookup( Trog::Config->path('secrets.kdbx'), Trog::Credentials->prompt( 'Enter password:', 'keepass' ), %needed );

    foreach my $path ( sort keys %$wanted ) {
        my $value = $values{$path};
        die "The secret store had nothing for $wanted->{$path}{ref}, which $domain needs at $path\n"
          unless defined $value && length $value;

        # The directory the recipe will later make: this runs first, so it is not
        # there yet and a write into it would fail.
        my $dir = File::Basename::dirname($path);
        die "Could not make $dir on $domain\n" if $guest->run_sudo( 'mkdir', '-p', $dir );

        $guest->write_text( $path, "$value\n", sudo => 1, mode => $wanted->{$path}{mode} // '0600' )
          or die "Could not place $path on $domain\n";

        # Attempted rather than required: this runs before the makefile, so the
        # account that will own the file usually belongs to a package that is
        # not installed yet.  The mode above is what keeps the secret to itself
        # in the meantime, and the recipe chowns it once the service exists --
        # which is why guest_secrets says the owner is what it ends up as
        # rather than what it lands as.
        my $owner = $wanted->{$path}{owner} // 'root:root';
        warn "$path is root's for now: no $owner on $domain yet, so the recipe has to give it away\n"
          if $guest->run_sudo( 'chown', $owner, $path );

        print "Placed $path on $domain from $wanted->{$path}{ref}\n";
    }

    authorize_runner_key( $domain, \%values );
    return 1;
}

=head2 authorize_runner_key($domain, $values)

Let a runner's key in to each hypervisor it was configured to build guests on.

The same kind of change as C<authorize_guest_key> and here for the same reason:
it is a change to a machine that is not the guest, so it belongs in the tool
rather than in the recipe.  It is here rather than beside that one because this
is where the key has already been resolved out of the store -- doing it
anywhere else means asking for the store password twice.

A dry run never reaches this.  C<provision_domain> returns before anything that
places a secret, and that is the only place the decision is made.

Which hypervisors, and whether at all, is a configuration question, so
L<Provisioner::Cookbook> is what answers it.  Nothing happens for a domain that
does not run the C<trogrunner> recipe, or that runs it with the default
C<hypervisor_access> of C<none>.

The public half is written beside the domain as F<hypervisor-key.pub>: it is
public, and it is what C<bin/destroy> reads to take the grant away again
without needing the store password.

=cut

sub authorize_runner_key {
    my ( $domain, $values ) = @_;

    my $config = eval { Provisioner::Cookbook->domain_config($domain) } // {};
    my %grant  = Provisioner::Cookbook->load('trogrunner')->grant( $config->{trogrunner} );
    return 0 unless %grant;

    my $hypervisors = $grant{hypervisors};
    unless (%$hypervisors) {
        warn "$domain asked for $grant{access} on its hypervisors and names none, so there is nobody to authorize it with\n";
        return 0;
    }

    my $domain_dir = Trog::HV->new()->domain_dir;
    my ($private) = grep { m{/\.ssh/id_ed25519\z} } keys %$values;
    die "$domain wants hypervisor access and the store had no key for it\n"
      unless $private && length( $values->{$private} // q{} );

    my $pubkey = _public_half( $domain, $values->{$private} );
    File::Slurper::Temp::write_binary( "$domain_dir/$domain/hypervisor-key.pub", "$pubkey\n" );

    # from="<address>" when the domain holds one.  It costs nothing and it is
    # stable, because re-provisioning keeps whatever address the domain has --
    # see bin/destroy, which is the only thing that gives one back.
    my $line = $pubkey;
    if ( $grant{restrict} ) {
        my $ip = eval { Provisioner::IPPool::held_by($domain) };
        $line = qq{from="$ip" $pubkey} if $ip;
    }

    foreach my $name ( sort keys %$hypervisors ) {
        my $uri = $hypervisors->{$name}{libvirt_uri}
          or die "$domain names a hypervisor '$name' with no libvirt_uri\n";

        my $machine = Trog::HV->candidate( uri => $uri );
        $machine->append_line( $machine->authorized_keys, $line )
          or die "Could not authorize $domain on $name (" . $machine->describe . ")\n";

        print "Authorized $domain on $name as " . ( $machine->ssh_user // 'the connecting user' ) . "\n";
    }

    print "$domain now has $grant{access} on: " . join( ', ', sort keys %$hypervisors ) . "\n";
    return 1;
}

# Provisioner::Utils::ssh_pubkey_from_private, which already does this and did
# before any of this was written: CryptX rather than a process, for RSA, Ed25519
# and ECDSA alike.  It takes a path and what is in hand here is the value out of
# the store, so the only thing left to do is put it where it can be read from.
sub _public_half {
    my ( $domain, $private ) = @_;

    my $tmp = File::Temp->new( UNLINK => 1 );
    chmod 0600, $tmp->filename;
    print {$tmp} "$private\n";
    $tmp->flush();

    my $pubkey = eval { Provisioner::Utils::ssh_pubkey_from_private( $tmp->filename ) };
    die "Could not read the public half of $domain's hypervisor key; the store may be holding something that is not one.\n$@"
      unless defined $pubkey && length $pubkey;

    # Named, because what comes back is the key and nothing else -- so without
    # this, what lands in somebody's authorized_keys is an anonymous line that
    # nobody reading that file can attribute or safely remove by hand.
    return "$pubkey trog-provisioner runner $domain";
}

sub main {
    my @args = @_;

    umask 0022;

    my ( $reuse, $uri, $domain_dir, $hvconf, $no_config, $recipes, $ipmap, $credentials, $salvage_gaps_ok, $dryrun );
    GetOptionsFromArray(
        \@args,
        'existing=s'      => \$reuse,
        'domaindir=s'     => \$domain_dir,
        'dryrun'          => \$dryrun,
        'connect=s'       => \$uri,
        'hvconf=s'        => \$hvconf,
        'no-config'       => \$no_config,
        'recipes=s'       => \$recipes,
        'ipmap=s'         => \$ipmap,
        'credentials'     => \$credentials,
        'salvage-gaps-ok' => \$salvage_gaps_ok,
    );

    # Before anything that could want one, and only when asked: see
    # Trog::Credentials, which will not read a handle nobody offered it.
    Trog::Credentials->load() if $credentials;

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    # Everything the hypervisor knows about itself comes off provision.conf, so
    # we have to find that the hard way first -- and asking Trog::HV for one here
    # would pin the singleton before generate_config has chosen it.  The class
    # answers without being built, so the default is spelled in one place.
    #
    # Kept, because the default below makes "given" and "defaulted"
    # indistinguishable afterwards, and only one of them should beat what the
    # hypervisor says.
    my $domain_dir_from_cli = $domain_dir;
    $domain_dir //= Trog::HV->default_domain_dir;
    $domain =~ s/\///g;

    # Build the domain's configuration first.  It is what writes provision.conf
    # and packs data.tar.gz, and it needs the hypervisor to write either -- so
    # it picks the hypervisor too, and everything after this shares it.
    generate_config(
        $domain,
        {
            domain_dir => $domain_dir,
            recipes    => $recipes,
            ipmap      => $ipmap,
            hvconf     => $hvconf,
            uri        => $uri,
            dryrun     => $dryrun,

            # Typed, every time, by somebody who has read what it is about to
            # lose.  No environment variable and no config key: this is the
            # difference between rebuilding a guest and destroying the only copy
            # of what was on it.
            salvage_gaps_ok => $salvage_gaps_ok,
        }
    ) unless $no_config;

    # generate_config picked the hypervisor, and where a domain's directory is
    # can come from its block in hypervisors.conf -- so ask it.  Reading the
    # default here instead was right only while every hypervisor used
    # /opt/domains.
    $domain_dir = Trog::HV->new()->domain_dir
      unless $no_config || defined $domain_dir_from_cli;

    my $cfile = "$domain_dir/$domain/provision.conf";
    close( _must_read( $cfile, "No provision.conf for $domain" ) ) or die "Could not close $cfile: $!\n";

    my $udf = "$domain_dir/$domain/users.yaml";
    close( _must_read( $udf, "No users.yaml for $domain" ) ) or die "Could not close $udf: $!\n";

    my $config = Config::Simple->new($cfile);
    my $reuser = $config->param('admin_user') // 'root';

    # Figure out which hypervisor we're talking to before we touch anything.
    # Every other sub picks this same object back up with Trog::HV->new().
    my $hv = choose_hypervisor(
        $config, $domain,
        {
            uri        => $uri,
            domain_dir => $domain_dir,
            hvconf     => $hvconf,
        }
    );
    print "Provisioning against hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    $domain_dir = $hv->domain_dir;
    my $data = "$domain_dir/$domain/data.tar.gz";
    close( _must_read( $data, "No data to host for $domain" ) ) or die "Could not close $data: $!\n";

    # Its storage pool, and a fix for a sillyness in virtiofs -- or nothing, on a
    # hypervisor that has neither.
    $hv->prepare_host("$FindBin::Bin/../virtiofs-better");

    # Now, let's figure out if this has a VM which needs to be built first.
    # In the event reuse is passed, we are just layering configs really.
    my $skey;
    my $depends = $config->param('depends_on');
    if ($depends) {
        print "$domain depends on $depends, provisioning that first...\n";
        my $dcfile = "$domain_dir/$depends/provision.conf";
        close( _must_read( $dcfile, "No provision.conf for $depends, which $domain depends on" ) ) or die "Could not close $dcfile: $!\n";
        my $dconfig = Config::Simple->new($dcfile);

        #XXX should probably die here if the admin_users differ!

        ( $reuser, $reuse ) = provision_domain( config => $dconfig, domain => $depends, reuse => $reuse, reuser => $reuser, dryrun => $dryrun );

        # After, not before: provision_domain is what mints this key and puts it
        # in the store, so asking any earlier is asking about the guest that was.
        $skey = Trog::Guest->key_path( $depends, "$domain_dir/$depends/key.rsa" );
        if ( !$dryrun ) {
            my $guest = Trog::Guest->new( name => $depends, host => $reuse, user => $reuser, key_path => $skey );
            $guest->wait_for_ssh();
            $guest->wait_for_cloud_init($depends);
            $hv->release_seed($depends);
            $guest->wait_for_makefile($depends)
              or die "The build for $depends failed; read /var/log/$depends.setup.log on the guest\n";
        }

    }

    #TODO need to figure out how to apply the cloud-init for the second domain if deps are active
    my ( $user, $ip ) = provision_domain( config => $config, domain => $domain, reuse => $reuse, reuser => $reuser, depends => $depends, dryrun => $dryrun );
    return 0 if $dryrun;

    # Same reason as above: the key this needs is the one provision_domain just
    # made.  A domain with a dependency uses that one, which is already in hand.
    $skey //= Trog::Guest->key_path( $domain, "$domain_dir/$domain/key.rsa" );

    # --out rather than a $(...): the key is in the store, and what bin/guest_key
    # writes without --out is a temporary file it unlinks on the way out -- so a
    # substitution hands ssh a path that stopped existing before ssh started.
    print "bin/guest_key --out $domain.key $domain && ssh -i $domain.key $user\@$ip\n";
    my $guest = Trog::Guest->new( name => $domain, host => $ip, user => $user, key_path => $skey );
    $guest->wait_for_ssh();

    my $map = "$domain_dir/$domain/devices.map";
    if ( -f $map ) {    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- whether there is one to send; put_file dies if it has gone since
        print "Syncing disk map\n";
        $guest->put_file( $map, '/root/devices.map', sudo => 1 )
          or die "could not sync devices map!";
    }

    # Before cloud-init has finished, and so well before the makefile it
    # schedules starts: these are what a recipe reads rather than generates.
    place_guest_secrets( $guest, $domain );

    $guest->wait_for_cloud_init($domain);

    # Only now.  The seed ISO has to stay in the drive for as long as cloud-init
    # might want to read it, which is until it says it is finished; pulling it
    # out any earlier leaves the guest with no user, no keys and no netplan, and
    # the pulling-out is only to stop the guest booting off it next time.
    $hv->release_seed($domain);

    $guest->wait_for_makefile($domain)
      or die "The build for $domain failed; read /var/log/$domain.setup.log on the guest\n";

    return 0;
}

# Run the config generator for this domain, if there is anything for it to
# work from.
#
# The two used to be separate repositories and separate runs: you generated a
# domain's configuration, then provisioned it.  That worked while the generator
# could assume it was running on the hypervisor it was writing about -- it read
# the internal IP and the sshd port off the local machine.  Once the hypervisor
# became a choice, the two halves had to agree on which one, and the only
# honest way for them to agree is to be one program.
sub generate_config {
    my ( $domain, $opts ) = @_;

    my $dir     = $opts->{domain_dir};
    my $recipes = $opts->{recipes} // Trog::Config->path('recipes.yaml');
    my $ipmap   = $opts->{ipmap}   // Trog::Config->path('ipmap.cfg');

    # No site data, nothing to generate: somebody is provisioning from a domain
    # directory they wrote by hand, which is a supported thing to do.
    my $recipe_dir = File::Basename::dirname($recipes) . '/recipes.d';
    unless ( -f $recipes || -d $recipe_dir ) {    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- whether there is site data at all; the generator opens what there is
        print "No recipes at $recipes, building from what is already in $dir/$domain\n";
        return 0;
    }

    print "Generating the configuration for $domain...\n";

    # An explicit --connect settles the hypervisor before the generator gets to
    # choose one; it picks the singleton up from there.
    Trog::HV->new( uri => $opts->{uri}, domain_dir => $dir ) if $opts->{uri};

    push @INC, '.';
    my $generator = File::Basename::dirname(__FILE__) . '/new_config';
    require $generator;
    my @flags = ( '--recipes', $recipes, '--ipmap', $ipmap );

    # Which here means only that a guest that is up keeps the key it is up with;
    # see the generator's own POD.
    push( @flags, '--dryrun' ) if $opts->{dryrun};

    my $result = Trog::Provisioner::Config::Generator::main( @flags, $domain );

    die "Could not generate the configuration for $domain\n" if $result;

    refuse_on_salvage_gaps( $opts->{salvage_gaps_ok} );
    return 1;
}

=head2 refuse_on_salvage_gaps($allowed)

Stop before anything is destroyed when the salvage came away without state the
guest still has.

The generator says so and carries on, which is right for what it is -- it
writes configuration, and it runs from cron to take backups where quitting over
one unreadable directory would abandon every domain after it.  This program is
the one that asks a hypervisor to C<clear_guest>, so this is where the warning
has to turn into a refusal.

Only the gaps where the guest still holds files that did not come off it.  A
path with nothing under it has nothing to salvage, which is what every first
build of a recipe looks like, and a domain with no guest yet is never salvaged at
all -- so a new machine cannot trip this.

=cut

sub refuse_on_salvage_gaps {
    my ($allowed) = @_;

    my %gaps = Trog::Provisioner::Config::Generator::salvage_gaps();
    return 1 unless %gaps;

    my $detail = join(
        q{},
        map {
            my $domain = $_;
            map { "    $domain: $_->{recipe} read nothing out of $_->{remote}\n" } @{ $gaps{$domain} }
        } sort keys %gaps
    );

    # Loud, and then carry on, because somebody said to.
    if ($allowed) {
        warn "Continuing past " . scalar( keys %gaps ) . " domain(s) whose state could not be read, because --salvage-gaps-ok says to:\n" . $detail;
        return 1;
    }

    die "Refusing to rebuild: state that is on the guest did not come off it.\n\n" . $detail
      . "\nThe guest was asked, and it still has files under each of those -- so this is\na fetch that did not bring them, not a service that has nothing.  Rebuilding now\ndestroys the only copy.\n\nThe salvage reads them as root over sudo, so the usual cause is sudo being\nrefused on the guest or the fetch failing partway.  Look at what it said above,\nfix it and run again, or pass --salvage-gaps-ok if that state is gone for good\nand you want the guest rebuilt without it.\n";
}

# Which hypervisor does this guest belong on?
#
# --connect is the manual override and skips every question below.  Otherwise,
# if there is a hypervisors.conf, it decides: the guest goes where it already
# lives, or where it fits.  With no fleet configured we are back to the old
# behavior, where provision.conf carried the connection details itself.
sub choose_hypervisor {
    my ( $config, $domain, $opts ) = @_;

    my %paths = ( domain_dir => $opts->{domain_dir} );

    return Trog::HV->new( uri => $opts->{uri}, %paths ) if $opts->{uri};

    my $fleet = Trog::Hypervisors->load( $opts->{hvconf} // Trog::Hypervisors->default_path );
    return Trog::HV->from_config( $config, %paths ) unless $fleet->configured;

    warn "hypervisors.conf decides which hypervisor $domain lands on; the " . "libvirt_uri in its provision.conf is ignored\n"
      if $config->param('libvirt_uri');

    my $hv = $fleet->select_for( $domain, $config );

    # The command line still outranks the fleet on where *our* files go.
    $hv->{domain_dir} = $opts->{domain_dir} if defined $opts->{domain_dir};
    return $hv;
}

sub provision_domain (%args) {
    my ( $config, $domain, $reuse, $reuser, $depends, $dryrun ) = @args{qw{config domain reuse reuser depends dryrun}};

    my $hv = Trog::HV->new();

    # Set this to simplify calling conventions
    $config->param( 'domain', $domain );

    # A dry run stops here: there is no ISO to build the seed into and no machine
    # to tell about it, so nothing below reads it or lets a key in anywhere.
    # would_provision says what it would do and hands back where the guest is, or
    # would be.  Not passed through guest_ssh_ip: main() throws this address away
    # on a dry run, and asking a backend how to reach a guest that does not exist
    # yet is a question with no answer -- a cloud looks it up by name and dies,
    # where libvirt happens to hand the placeholder straight back.
    if ($dryrun) {
        return ( $reuser,                      $reuse ) if $reuse;
        return ( $config->param('admin_user'), $hv->would_provision( $config, reuse => $reuse ) );
    }

    return reprovision_guest( hv => $hv, config => $config, domain => $domain, reuse => $reuse, reuser => $reuser, depends => $depends ) if $reuse;

    # What bin/new_config wrote beside the domain, and the change to this machine
    # that goes with it: the guest fetches its payload from here, so its key has
    # to be let in.  The hypervisor's half is install_log_collector, further
    # down, because what it installs is one of the vm recipe's generated files.
    my %seed = read_seed($config);
    authorize_guest_key($config);

    # Which of these a hypervisor does is its own business: libvirt annihilates a
    # domain and its disks, a cloud rebuilds the server it already has.  This
    # says what happens, in order, and asks the backend to do each part.
    $hv->clear_guest($domain);

    my $address = $hv->provision_guest( $config, \%seed, settings => { _settings($config) }, reuse => $reuse );

    return ( $config->param('admin_user'), $hv->guest_ssh_ip( $config, $address ) );
}

# Layering a domain onto a guest that is already up, rather than building one.
#
# The machine is $reuse: where --existing pointed, or where provisioning the
# dependency ended up.  That is what makes a shared host -- bar.test is added to
# the guest built for foo.test rather than getting one of its own.  Only two
# things here are the hypervisor's: what MAC the guest's second interface has,
# and clearing anything left standing under this domain's own name.
sub reprovision_guest (%args) {
    my ( $hv, $config, $domain, $reuse, $reuser, $depends ) = @args{qw{hv config domain reuse reuser depends}};

    # Whose machine this is.  With --depends it is the domain that was built, and
    # that domain's key is the one which opens it; otherwise this domain is the
    # guest.  Failing the key there is the agent, and $reuser is root when nobody
    # named an admin user -- which will not do if the box has been locked down.
    my $built_for  = $depends // $domain;
    my $domain_dir = $hv->domain_dir;
    my $key        = Trog::Guest->key_path( $built_for, "$domain_dir/$built_for/key.rsa" );

    # Any VM still standing under this domain's own name, which is the guest it
    # had to itself before being moved onto this one.  Only with --depends: there
    # the two are different machines, and without one that name *is* the machine
    # being connected to below.
    $hv->clear_guest($domain) if $depends;

    print "Attempting to access Machine\n";
    my $guest = Trog::Guest->new( name => $domain, host => $reuse, user => $reuser, key_path => $key );

    refresh_cloud_init( $guest, $domain_dir, $domain );
    merge_guest_addresses( guest => $guest, hv => $hv, config => $config, domain_dir => $domain_dir, domain => $domain, built_for => $built_for );

    print "Syncing setup script\n";
    $guest->put_file( "$domain_dir/$domain/setup.sh", "/root/setup-$domain.sh", sudo => 1, mode => '0755' )
      or die "Could not ship the setup script to $domain";

    place_guest_secrets( $guest, $domain );

    print "Scheduling job to run setup script\n";
    print $guest->capture_cmd("sudo at now -f /root/setup-$domain.sh");
    print "Done.\n";

    return ( $reuser, $reuse );
}

# cloud-init runs once and remembers that it did.  Asking for a module by name
# runs it again regardless, which is what applies the config we have just
# shipped to a guest that booted from an older one.
sub refresh_cloud_init {
    my ( $guest, $domain_dir, $domain ) = @_;

    print "Installing Updated cloud-init and forcing re-run...\n";
    my $init = "$domain_dir/$domain/user-data";
    $guest->put_file( $init, 'cloud-config.txt' ) or die "Could not ship the cloud-init config to $domain";

    foreach my $module (qw{cc_package_update_upgrade_install cc_users_groups}) {
        print $guest->capture_cmd("sudo cloud-init single --name $module -f cloud-config.txt") . "\n";
    }

    return 1;
}

# The addresses provision.conf names, added to whatever the guest already has.
# Only written back when that changes something: netplan apply on an unchanged
# file is a needless bounce of the guest's network.
#
# The interface belongs to $built_for, the domain the machine was built for,
# while the addresses belong to $domain -- two different names on a shared host.
sub merge_guest_addresses (%args) {
    my ( $guest, $hv, $config, $domain_dir, $domain, $built_for ) = @args{qw{guest hv config domain_dir domain built_for}};

    my $ips         = _coerce_array( $config->param('ips') );
    my $existing_nc = $guest->capture_cmd('sudo cat /etc/netplan/50-cloud-init.yaml');
    my $parsed      = YAML::XS::Load($existing_nc);

    my $adapter   = primary_adapter( $parsed, $config, $hv->guest_mac( $built_for, 1 ) );
    my $addresses = ( $parsed->{network}{ethernets}{$adapter}{addresses} //= [] );

    my $num_ips = scalar @$addresses;
    @$addresses = uniq( @$addresses, map { "$_/24" } @$ips );
    return 1 if $num_ips == scalar @$addresses;

    my $new_config = "$domain_dir/$domain/network-config-merged.yaml";
    File::Slurper::Temp::write_text( $new_config, YAML::XS::Dump($parsed) );
    print "Setting up IP for $domain...\n";

    # Straight to where it belongs, as root, rather than landing in the home
    # directory and being moved and chmodded afterwards.
    $guest->put_file( $new_config, '/etc/netplan/50-cloud-init.yaml', sudo => 1, mode => '0600' )
      or die "Could not install the netplan config on $domain";

    my $output = $guest->capture_cmd('sudo netplan apply');
    chomp $output;
    print "$output\n" if $output;

    return 1;
}

# Which entry in the guest's netplan is the outbound interface?
#
# By MAC, because that is the one thing about an interface we decide and the
# guest cannot disagree with.  cloud-init writes the MAC it matched on into
# netplan, so the entry we want identifies itself; the name it ended up with is
# a consequence and not a handle.  Falling back to the name covers a guest
# built before any of this, whose netplan has no match stanza at all.
sub primary_adapter {
    my ( $netplan, $config, $mac ) = @_;

    my $ethernets = $netplan->{network}{ethernets};
    die "No ethernets at all in the guest's netplan config!\n" unless ref $ethernets eq 'HASH';

    foreach my $name ( sort keys %$ethernets ) {
        my $match = $ethernets->{$name}{match} or next;
        next unless ref $match eq 'HASH' && defined $match->{macaddress};
        return $name if lc $match->{macaddress} eq lc $mac;
    }

    my ( undef, $bridge_name ) = Trog::HV->new()->nic_names;
    my $named = $config->param('bridge_devname') // $bridge_name;
    return $named if ref $ethernets->{$named} eq 'HASH';

    die "Could not find the outbound adapter in the guest's netplan: nothing matches\n" . "$mac, and there is no $named either.  It has: " . join( ', ', sort keys %$ethernets ) . "\n";
}

=head2 %seed = read_seed($config)

The three NoCloud files the guest's seed ISO is built from, read out of the
domain directory.

They are the distro recipe's C<template_files>, written by F<bin/new_config>
along with everything else a domain is configured with.  Dies naming the file if
one of them cannot be read: a guest cannot be built without its seed, so there
is nothing to carry on to.

A dry run does not call this, having no ISO to build and no guest to give one
to.

=cut

sub read_seed {
    my ($config) = @_;

    my $domain = $config->param('domain');
    my $dir    = Trog::HV->new()->domain_dir . "/$domain";
    my @files  = qw{user-data meta-data network-config};

    return map { $_ => scalar File::Slurper::read_text("$dir/$_") } @files;
}

=head2 authorize_guest_key($config)

Let the guest's key in to this machine, which is the one holding its payload.

A change to this machine rather than to the domain directory, and the reason
this is here rather than in the recipe that makes the key.  F<bin/destroy> is
what takes it back out again, and it would know nothing about one left behind by
a configuration run that never became a guest.

A dry run never reaches this, for the same reason C<authorize_runner_key> does
not: C<provision_domain> returns first.

=cut

sub authorize_guest_key {
    my ($config) = @_;

    my $domain = $config->param('domain');
    my $pubkey = File::Slurper::read_text( Trog::HV->new()->domain_dir . "/$domain/key.rsa.pub" );
    chomp $pubkey;

    my $this_machine = Trog::Local->new();
    $this_machine->append_line( $this_machine->authorized_keys, $pubkey )
      or die "Could not authorize the key for $domain on " . $this_machine->describe . "\n";
    return 1;
}

exit main(@ARGV) unless caller;

1;
