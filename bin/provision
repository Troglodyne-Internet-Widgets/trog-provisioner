#!/usr/bin/env perl

package Trog::Bin::Provisioner;

use strict;
use warnings FATAL => 'all';

use FindBin();
use FindBin::libs;
use Config::Simple();
use Trog::HV();
use Trog::Hypervisors();
use Trog::Guest();
use File::Slurper();
use YAML::XS();
use JSON::PP();
use List::Util qw{any uniq};
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage qw{pod2usage};

use Carp::Always;

=head1 NAME

provision - build a VM from a domain directory

=head1 SYNOPSIS

    provision [OPTIONS] DOMAIN

    provision vm.example.com
    provision --connect qemu+ssh://root@hv1.example.net/system vm.example.com

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor to build on.  Bypasses
F<hypervisors.conf> entirely: no placement, no capacity check, build it there.
A remote hypervisor has to be named with an ssh transport
(C<qemu+ssh://user@host/system>), since we need its filesystem as well as its
libvirt.

=item B<--hvconf> FILE

The fleet definition.  Defaults to F<hypervisors.conf> in the domain directory.
When it exists, the hypervisor is chosen from it -- see L<Trog::Hypervisors>.
When it doesn't, the hypervisor is whatever F<provision.conf> and C<--connect>
say, which for most people is still this machine.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.

=item B<--existing> IP

Layer this domain's configuration onto an already running VM rather than
building a new one.

=item B<--dryrun>

Write out everything that would be applied, but don't apply it.

=back

=head1 DESCRIPTION

Reads F<DOMAIN/provision.conf> and F<DOMAIN/users.yaml> out of the domain
directory, renders the libvirt XML and cloud-init configuration for the domain,
and defines it on the hypervisor.  See L<Trog::HV> for what "the
hypervisor" means when it isn't this machine.

=cut

sub _coerce_array {
    return \@_;
}

#TODO: cpu/gpu passthru accel via techniques such as the following:
# https://github.com/HarbourHeading/KVM-GPU-Passthrough

our $dryrun;

sub main {
    my @args = @_;

    umask 0022;

    my ($reuse, $uri, $domain_dir, $hvconf);
    GetOptionsFromArray(\@args,
        'existing=s'  => \$reuse,
        'domaindir=s' => \$domain_dir,
        'dryrun'      => \$dryrun,
        'connect=s'   => \$uri,
        'hvconf=s'    => \$hvconf,
    );

    my $domain = shift @args;
    pod2usage(-exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed')
      unless $domain;

    # Everything the hypervisor knows about itself comes off provision.conf, so
    # we have to find that the hard way first.
    $domain_dir //= '/opt/domains';
    $domain =~ s/\///g;
    my $cfile = "$domain_dir/$domain/provision.conf";
    die "No such file provision.conf in $domain_dir/$domain/" unless -f $cfile;

    my $udf = "$domain_dir/$domain/users.yaml";
    die "User definition file $domain_dir/$udf not present!" unless -f $udf;

    my $config = Config::Simple->new($cfile);
    my $reuser = $config->param('admin_user') // 'root';

    # Figure out which hypervisor we're talking to before we touch anything.
    # Every other sub picks this same object back up with Trog::HV->new().
    my $hv = choose_hypervisor($config, $domain, {
        uri        => $uri,
        domain_dir => $domain_dir,
        hvconf     => $hvconf,
    });
    print "Provisioning against hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    # The storage pool is the hypervisor's, and it may not have one yet.
    $hv->mkpath($hv->pool_path)
      or die "Could not create storage pool dir " . $hv->pool_path . " on the hypervisor";

    $domain_dir = $hv->domain_dir;
    my $data = "$domain_dir/$domain/data.tar.gz";
    die "No data to host in $domain/" unless -f $data;

    # Start off by fixing a sillyness in virtiofs.  This runs as part of the
    # qemu process, so it has to land on the hypervisor, not on us.
    if (!$hv->file_exists('/usr/libexec/virtiofs-better')) {
        $hv->put_file("$FindBin::Bin/../virtiofs-better", '/usr/libexec/virtiofs-better', sudo => 1)
          or die('Could not copy virtiofs-better to /usr/libexec/virtiofs-better, you may have to do this manually');
        $hv->run_sudo(qw{chmod 0755 /usr/libexec/virtiofs-better});
    }

    # Now, let's figure out if this has a VM which needs to be built first.
    # In the event reuse is passed, we are just layering configs really.
    my $skey = "$domain_dir/$domain/key.rsa";
    my $depends = $config->param('depends_on');
    if ($depends) {
        print "$domain depends on $depends, provisioning that first...\n";
        my $dcfile = "$domain_dir/$depends/provision.conf";
        die "No such file provision.conf in $domain_dir/$depends/" unless -f $cfile;
        my $dconfig = Config::Simple->new($dcfile);

        #XXX should probably die here if the admin_users differ!

        $skey = "$domain_dir/$depends/key.rsa";
        ($reuser, $reuse) = provision_domain($dconfig, $depends, $reuse, $reuser);
        if (!$dryrun) {
            my $guest = Trog::Guest->new(name => $depends, host => $reuse, user => $reuser, key_path => $skey);
            $guest->wait_for_ssh();
            $guest->wait_for_cloud_init($domain);
            $guest->wait_for_makefile($depends);
        }

    }
    #TODO need to figure out how to apply the cloud-init for the second domain if deps are active
    my ($user, $ip) = provision_domain($config, $domain, $reuse, $reuser, $depends);
    return 0 if $dryrun;

    print "ssh -i $skey $user\@$ip\n";
    my $guest = Trog::Guest->new(name => $domain, host => $ip, user => $user, key_path => $skey);
    $guest->wait_for_ssh();

    my $map = "$domain_dir/$domain/devices.map";
    if (-f $map) {
        print "Syncing disk map\n";
        $guest->put_file($map, '/root/devices.map', sudo => 1)
          or die "could not sync devices map!";
    }

    $guest->wait_for_cloud_init($domain);
    $guest->wait_for_makefile($domain);

    # If we don't do this, any subsequent manual tf plan will explode violently
    sync_tf_state_with_libvirt();

    # Hand the state back, so the hypervisor's own copy is not left behind
    # describing a world that has moved on without it.
    return_hypervisor_state($hv);

    return 0;
}

# Which hypervisor does this guest belong on?
#
# --connect is the manual override and skips every question below.  Otherwise,
# if there is a hypervisors.conf, it decides: the guest goes where it already
# lives, or where it fits.  With no fleet configured we are back to the old
# behaviour, where provision.conf carried the connection details itself.
sub choose_hypervisor {
    my ($config, $domain, $opts) = @_;

    my %paths = (domain_dir => $opts->{domain_dir});

    return Trog::HV->new(uri => $opts->{uri}, %paths) if $opts->{uri};

    my $fleet = Trog::Hypervisors->load(
        $opts->{hvconf} // Trog::Hypervisors->default_path($opts->{domain_dir}));
    return Trog::HV->from_config($config, %paths) unless $fleet->configured;

    warn "hypervisors.conf decides which hypervisor $domain lands on; the "
      . "libvirt_uri in its provision.conf is ignored\n"
      if $config->param('libvirt_uri');

    my $hv = $fleet->select_for($domain, $config);

    # The command line still outranks the fleet on where *our* files go.
    $hv->{domain_dir} = $opts->{domain_dir} if defined $opts->{domain_dir};
    return $hv;
}

sub provision_domain {
    my ($config, $domain, $reuse, $reuser, $depends) = @_;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    # Set this to simplify calling conventions
    $config->param('domain', $domain);

    # Order matters here.  The network configuration works out the hypervisor's
    # internal IP and sshd port and stashes them on the config; the setup script
    # needs both; the logging config writes the rsyslog drop-in that cloud-init
    # then reads back in.
    my %seed;
    $seed{'network-config'} = mongle_network_configuration($config);
    print "Wrote the network configuration for $domain\n";

    my $ss = mongle_setup_script($config);
    print "Wrote $ss\n";

    my $lc = mongle_logging_config($config);
    print "Wrote $lc\n";

    $seed{'user-data'} = mongle_cloud_init($config);
    $seed{'meta-data'} = mongle_meta_data($config);
    print "Wrote the cloud-init configuration for $domain\n";

    # Everything the domain dir is going to hold now holds it, so the HV can
    # have its copy.  The guest pulls its payload from there.
    $hv->sync_domain_dir($domain);

    # If the domain is already up, let's find the IP.
    # We can't guarantee we have a static IP, so use the internal.
    my $qdn = $domain;
    $qdn = $depends if $depends;
    $qdn =~ s/\.\S+$//;

    #XXX this can be fooled if you have two VMs, one a subdo of the other
    my $old_ip = $hv->lease_ip('default', $qdn) // 'bogus';

    if ($reuse) {
        my $old_ssh_ip = $hv->guest_ssh_ip($config, $old_ip);
        return ($reuser, $old_ssh_ip) if $dryrun;
        #$old_ip = $reuse;

        # Re-Use the existing VM, and just ship over what we got and run the makefile again.
        # Try to use the root key if no admin user is passed (this may not work if you locked down the box!)
        # Otherwise we'll use the agent.
        my $key = "$domain_dir/$domain/key.rsa";
        $key = "$domain_dir/$depends/key.rsa" if $depends;

        # Make sure any existing VMs don't have this domain
        clean_domain_resources($domain);

        print "Attempting to access Machine\n";
        my $guest = Trog::Guest->new(name => $domain, host => $old_ssh_ip, user => $reuser, key_path => $key);

        my $output = '';
        print "Installing Updated cloud-init and forcing re-run...\n";
        my $init = "$domain_dir/$domain/user-data";
        my $ci_dir = "/var/lib/cloud/instances/$domain";
        $guest->put_file($init, 'cloud-config.txt') or die "Could not ship the cloud-init config to $domain";
        # Remove the semaphore that says this was run, then run the needed targets
        $guest->run_sudo(qw{rm}, "$ci_dir/sem/cc_package_update_upgrade_install");
        print $guest->capture('sudo cloud-init single --name cc_package_update_upgrade_install -f cloud-config.txt') . "\n";
        $guest->run_sudo(qw{rm}, "$ci_dir/sem/cc_users_groups");
        print $guest->capture('sudo cloud-init single --name cc_users_groups -f cloud-config.txt') . "\n";

        my $ips  = _coerce_array($config->param('ips'));
        my $existing_nc = $guest->capture('sudo cat /etc/netplan/50-cloud-init.yaml');
        my $parsed = YAML::XS::Load($existing_nc);

        my $primary_adapter_name = $config->param('bridge_devname');
        die "Could not find primary adapter '$primary_adapter_name' in netplan config!" unless ref $parsed->{network}{ethernets}{$primary_adapter_name} eq 'HASH';

        my $num_ips = scalar(@{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}});
        @{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}} = uniq(@{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}}, map { "$_/24"} @$ips);
        if ($num_ips != scalar(@{$parsed->{network}{ethernets}{$primary_adapter_name}{addresses}})) {
            my $encoded = YAML::XS::Dump($parsed);
            my $new_config = "$domain_dir/$domain/network-config-merged.yaml";
            File::Slurper::write_text($new_config, $encoded);
            print "Setting up IP for $domain...\n";
            # Straight to where it belongs, as root, rather than landing in the
            # home directory and being moved and chmodded afterwards.
            $guest->put_file($new_config, '/etc/netplan/50-cloud-init.yaml', sudo => 1, mode => '0600')
              or die "Could not install the netplan config on $domain";
            $output = $guest->capture('sudo netplan apply');
            chomp $output;
            print "$output\n" if $output;
        }

        print "Syncing setup script\n";
        $guest->put_file("$domain_dir/$domain/setup.sh", "/root/setup-$domain.sh", sudo => 1, mode => '0755')
          or die "Could not ship the setup script to $domain";
        print "Scheduling job to run setup script\n";
        print $guest->capture("sudo at now -f /root/setup-$domain.sh");
        print "Done.\n";
        return ($reuser, $old_ssh_ip);
    }

    # Anything already answering to this name has to go before we define one.
    clean_domain_resources($domain);

    my ($xml, $file) = mongle_domain_xml($config, \%seed);
    print "Wrote $file\n";

    return ($config->param('admin_user'), $hv->guest_ssh_ip($config, $old_ip)) if $dryrun;

    print "Defining and starting $domain...\n";
    $hv->define_domain($xml);

    # If we're not re-using the VM, waste the old DHCP lease, so we don't fill up the table and gum everything up.
    $hv->release_dhcp_lease($old_ip) unless $old_ip eq 'bogus';

    print "Waiting for VM to come live...";
    my $new_ip = '';
    for (1..30) {
        $new_ip = $hv->lease_ip('default', $qdn, exclude => $old_ip);
        last if $new_ip;
        print ".";
        sleep 1;
    }
    die "\nVM never came up!\n" unless $new_ip;

    # Eject the CDROM we used for cloud-init
    $hv->eject_cdrom($domain);

    print "\nAll Done!  The server should be live at $new_ip\n";

    return ($config->param('admin_user'), $hv->guest_ssh_ip($config, $new_ip));
}

# Whatever is already answering to this name, gone.
#
# A domain we are about to define cannot share a name with one that already
# exists, and its disk is a fresh overlay on the base image -- keeping the old
# one would hand the new guest the old one's filesystem.  This used to have to
# fight terraform for the privilege; now it asks libvirt.
sub clean_domain_resources {
    my ($domain) = @_;
    my $hv = Trog::HV->new();

    if ($hv->domain_exists($domain)) {
        print "Terminating the existing VM $domain\n";
        $hv->annihilate_domain($domain);
    }

    $hv->delete_volume("$domain-qcow2");
    $hv->delete_volume("$domain-cloudinit.iso");
    return 1;
}

# Render the libvirt XML for a domain, and make the disks it refers to.
#
# This used to write terraform HCL.  Terraform's model is that it owns the
# world and may rebuild it; ours is that the hypervisor owns the world and we
# are adding one guest.  Reconciling those cost a state file per hypervisor,
# import blocks, ignore_changes for attributes the provider would not report
# back, and a provider that cannot import a volume at all.  This is less code
# than the machinery that was keeping terraform's opinion at bay.
sub mongle_domain_xml {
    my ($config, $seed) = @_;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain    = $config->param('domain');
    my $image     = $config->param('image');
    my $disk_size = $config->param('size');
    my $ram_mb    = $config->param('memory');
    my $cpus      = $config->param('cpus');

    # host-passthrough exposes the bare-metal CPU (incl. AVX/AVX2/etc.) to the
    # guest — required by anything that probes cpuid for vector extensions
    # (e.g. the `claude` CLI bundled v8 snapshot).  Override to host-model,
    # custom, or a specific model name only if you need live migration to a
    # differently-specced HV.
    my $cpu_mode = $config->param('cpu_mode') // 'host-passthrough';

    # These have no sane default, and every one of them goes into the XML.
    # Say which one is missing rather than producing a domain that won't define.
    foreach my $required (
        [image  => $image],  [size => $disk_size],
        [memory => $ram_mb], [cpus => $cpus],
    ) {
        my ($key, $value) = @$required;
        die "MUST SET $key in provision.conf for $domain\n" unless defined $value && length $value;
    }

    my $bridge_device = $hv->bridge_device;
    print "Using outbound bridge $bridge_device\n";

    # The pool, the image everything is layered on, and this guest's own disk.
    $hv->pool();
    my $base = $hv->base_image($image);
    my $disk_volume = "$domain-qcow2";
    $hv->create_disk($disk_volume, backing => $base, capacity => $disk_size);

    my ($extra_disks, $filesystems) = mongle_extra_disks($config);

    # NoCloud wants all three, and cloud-init will not look at a seed that is
    # missing any of them.
    foreach my $file (qw{user-data meta-data network-config}) {
        die "No $file to build the cloud-init seed for $domain from\n"
          unless defined $seed->{$file} && length $seed->{$file};
    }
    my $cloudinit = $hv->cloudinit_iso($domain, %$seed);

    my $xml = File::Slurper::read_text("$FindBin::Bin/../domain.xml.tmpl");
    my %substitutions = (
        REPLACEME   => $domain,
        MUGUBYTES   => $ram_mb,
        NUMCPUS     => $cpus,
        CPUMODE     => $cpu_mode,
        POOLNAME    => 'tf_disks',
        DISKVOLUME  => $disk_volume,
        CLOUDINIT   => $cloudinit,
        BRIDGENAME  => $bridge_device,
        EXTRADISKS  => $extra_disks,
        FILESYSTEMS => $filesystems,
    );
    $xml =~ s/%$_%/$substitutions{$_}/gmx for keys %substitutions;

    my $file = "$domain_dir/$domain/domain.xml";
    File::Slurper::write_text($file, $xml);
    return ($xml, $file);
}

# Whatever mounts.txt asks for, as libvirt device XML.
#
# Each line is pool=name.  A `raw` pool is a host block device, `dir` is a
# directory shared in over virtiofs, `file` is an image file, and anything else
# is taken as the name of another libvirt pool.  `fuse` is skipped: the guest
# mounts those itself.
sub mongle_extra_disks {
    my ($config) = @_;

    my $hv         = Trog::HV->new();
    my $domain     = $config->param('domain');
    my $domain_dir = $hv->domain_dir;

    my $spec_file = "$domain_dir/$domain/mounts.txt";
    my (@disks, @filesystems, $mapper);
    $mapper = '';

    if (-f $spec_file) {
        my @devnames = ('vdb' .. 'vdz');
        my $order    = 2;

        foreach my $diskspec (grep { $_ } split(/\n/, File::Slurper::read_text($spec_file))) {
            my ($pool, $disk) = split(/=/, $diskspec);
            next if $pool eq 'fuse';

            $order++;
            my $dev = shift @devnames or die "Ran out of vdnames!\n";

            # The guest gets a map of what it asked for to where it landed.
            $mapper .= $pool eq 'dir' ? "$disk=$dev\n" : "$disk=/dev/$dev\n";

            if ($pool eq 'dir') {
                # virtiofs-better is `virtiofsd --inode-file-handles=mandatory`,
                # without which a busy share runs the daemon out of file handles.
                #
                # The terraform config asked for open_files max here too, and it
                # never did anything: libvirt has no such element, accepts the
                # domain, and silently drops it.  The wrapper is the whole fix.
                push @filesystems, sprintf(<<'FS', _xml($disk), _xml($dev));
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs' queue='1024'/>
      <binary path='/usr/libexec/virtiofs-better'/>
      <source dir='%s'/>
      <target dir='%s'/>
    </filesystem>
FS
                next;
            }

            if ($pool eq 'raw') {
                push @disks, sprintf(<<'DISK', _xml($disk), _xml($dev), $order);
    <disk type='block' device='disk'>
      <driver name='qemu' type='raw'/>
      <source dev='%s'/>
      <target dev='%s' bus='virtio'/>
      <boot order='%d'/>
    </disk>
DISK
                next;
            }

            # A file, or a volume in some other pool -- either way it resolves
            # to a path, and libvirt wants the path.
            my $path = $pool eq 'file' ? $disk : ($hv->volume_path($disk, $pool) // $disk);
            push @disks, sprintf(<<'DISK', _xml($path), _xml($dev), $order);
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='%s'/>
      <target dev='%s' bus='virtio'/>
      <boot order='%d'/>
    </disk>
DISK
        }
    }

    File::Slurper::write_text("$domain_dir/$domain/devices.map", $mapper);
    return (join('', @disks), join('', @filesystems));
}

sub _xml {
    my ($str) = @_;
    $str = '' unless defined $str;
    $str =~ s/&/&amp;/g;
    $str =~ s/</&lt;/g;
    $str =~ s/>/&gt;/g;
    $str =~ s/"/&quot;/g;
    $str =~ s/'/&apos;/g;
    return $str;
}

# Slam in the IPs, gw, resolvers
sub mongle_network_configuration {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain = $config->param('domain');
    my $ips  = _coerce_array($config->param('ips'));
    my $gw   = $config->param('gateway');
    my $res  = _coerce_array($config->param('resolvers'));
    die "MUST SET gateway in provision.conf when ips are set\n"
      if @$ips && !(defined $gw && length $gw);

    # XXX ugh there is no way to set consistent devnames, fml
    my $dhcp_devname = $config->param('dhcp_devname');
    die "MUST SET dhcp_devname in provision.conf" unless $dhcp_devname;
    my $bridge_devname = $config->param('bridge_devname');
    die "MUST SET bridge_devname in provision.conf" unless $dhcp_devname;

    # We need two adapters, one on virbr0 and another on the bridge.
    # So, we need to figure out:
    # 1. IP of the virbr
    # 2. name of the bridge device.
    # 3. IP of bridge device.

    print "Using libvirt network device " . $hv->virbr_device . "\n";
    print "HV internal IP: " . $hv->virbr_ip . "\n";

    # Stash these in the config object for later use by the clown-config
    $config->param('hv_internal_ip', $hv->virbr_ip);
    $config->param('hv_sshd_port',   $hv->sshd_port);

    # Such an astonishingly tedious format
    my @subnets = map {
        {
            type      => 'static',
            address   => $_,
            gateway   => $gw,
            dns_nameservers => $res,
            dns_search      => [$domain],
        }
    } @$ips;

    # Do DHCP if no IP was supplied
    if (!@subnets) {
        @subnets = (
            {
                type => 'dhcp',
            }
        );
    }

    my $netconf = {
       network => {
            version => 1,
            config  => [
                {
                    type => 'physical',
                    name => $bridge_devname,
                    subnets => \@subnets,
                    gateway4 => $gw,
                    nameservers => {
                        search => [$domain],
                        addresses => $res,
                    }
                },
                {
                    type => 'physical',
                    name => $dhcp_devname,
                    subnets => [
                        {
                            type => 'dhcp',
                        },
                    ],
                },
            ],
       },
    };

    my $rendered = YAML::XS::Dump($netconf);
    File::Slurper::write_text("$domain_dir/$domain/network-config", $rendered);
    return $rendered;
}

sub inject_admin_key {
    my ($admin_user, $domain, $config, $pubkey) = @_;
    # Don't bother if we aren't setting this up.
    return unless $admin_user;
    return unless ref $config->{users} eq 'ARRAY';

    foreach my $u (@{$config->{users}}) {
        next unless exists $u->{name};
        next unless $u->{name} eq $admin_user;
        $u->{ssh_authorized_keys} //= [];
        push(@{$u->{ssh_authorized_keys}}, $pubkey);
        return;
    }
    return;
}

# Generate and store a new SSH key for the guest, which we will authorize on the HV to grab the data.tar.gz
sub mongle_cloud_init {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain = $config->param('domain');
    my $contactemail = $config->param('contact_email');
    my $hv_ip = $config->param('hv_internal_ip');
    die "MUST SET contact_email in provision.conf for $domain\n"
      unless defined $contactemail && length $contactemail;

    # Generate a new key for the child
    qx{yes | ssh-keygen -t rsa -f $domain_dir/$domain/key.rsa -N ''};
    die "No key generated!" unless -f "$domain_dir/$domain/key.rsa";
    die "No pubkey generated!" unless -f "$domain_dir/$domain/key.rsa.pub";
    chmod 0600, "$domain_dir/$domain/key.rsa";
    chmod 0600, "$domain_dir/$domain/key.rsa.pub";

    # Authorize the key with the transfer user *on the hypervisor* -- that's the
    # box the guest will scp its payload back from.
    my $pubkey = File::Slurper::read_text("$domain_dir/$domain/key.rsa.pub");
    chomp $pubkey;
    $hv->append_line($hv->authorized_keys, $pubkey)
      or die "Could not authorize the key for $domain on the hypervisor";

    my $pkgs = _coerce_array($config->param('packages'));
    # We absolutely must have atd, sendmail and make.
    push(@$pkgs, 'sendmail') unless any { $_ eq 'postfix' } @$pkgs;
    push(@$pkgs, qw{at make});
    @$pkgs = uniq @$pkgs;

    my $udf = "$domain_dir/$domain/users.yaml";
    my $userdefs = YAML::XS::Load(File::Slurper::read_text($udf));

    # Inject the SSH key for access into the admin_user's SSH
    inject_admin_key($config->param('admin_user'), $domain, $userdefs, $pubkey);

    #TODO Figure out apt-secure with the mirror
    $YAML::XS::Boolean = "JSON::PP";
    my $clown_config = {
        runcmd => [
            qq{echo "root:$contactemail\n" > /etc/aliases },
            "at now -f /root/setup.sh",
        ],
        package_update  => !!1,
        package_upgrade => !!1,
        packages => $pkgs,
        apt => {
            primary => [
                {
                    arches => [qw{default}],
                    uri    => "mirror+file:/etc/apt/mirrorlist",
                },
            ],
            security => [
                {
                    arches => [qw{default}],
                    uri    => "mirror+file:/etc/apt/mirrorlist",
                },
            ],
            conf => qq|
Acquire {
    Retries "12";
    Force-IPv4: true;
    AllowInsecureRepositories: true;
}
APT {
    Get {
        Assume-Yes "true";
        Fix-Broken "true";
    }
}|,
        },
        users => $userdefs->{users},
        fqdn => $domain,
        manage_etc_hosts => 'localhost',
        final_message => "Boot configuration complete.",
        # Make sure root can scp to/from the transfer user on the HV, and we start shipping logs.
        write_files => [
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/key.rsa"),
                path        => "/root/.ssh/id_rsa",
                owner       => "root:root",
                permissions => '0600',
                defer       => $JSON::PP::true,
            },
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/key.rsa.pub"),
                path        => "/root/.ssh/id_rsa.pub",
                owner       => "root:root",
                permissions => '0600',
                defer       => $JSON::PP::true,
            },
            {
                content     => File::Slurper::read_text("$domain_dir/$domain/setup.sh"),
                path        => "/root/setup.sh",
                owner       => "root:root",
                permissions => "0775",
                defer       => $JSON::PP::true,
            },
            {
                content     => "http://$hv_ip/ubuntu\tpriority:1\nhttp://archive.ubuntu.com/ubuntu\tpriority:2\nhttp://security.ubuntu.com/ubuntu\tpriority:3\n",
                path        => "/etc/apt/mirrorlist",
                permissions => "0644",
                owner       => "root:root",
                defer       => $JSON::PP::false,
            },
        ],
        rsyslog => {
            install_rsyslog => $JSON::PP::true,
            config_dir => '/etc/rsyslog.d',
            configs => [{
                filename => '10-ship_logs_to_hv.conf',
                content  => File::Slurper::read_text("$domain_dir/$domain/rsyslog.conf"),
             }]
        }
    };
    # Kept beside the domain as well as going into the seed, so you can read
    # what a guest was built with without unpacking an ISO.
    my $user_data = "#cloud-config\n" . YAML::XS::Dump($clown_config);
    File::Slurper::write_text("$domain_dir/$domain/user-data", $user_data);
    return $user_data;
}

# NoCloud wants an instance-id.  Keeping it stable across rebuilds is what
# stops cloud-init deciding it has already run and skipping everything.
sub mongle_meta_data {
    my ($config) = @_;
    my $domain = $config->param('domain');

    return YAML::XS::Dump({
        'instance-id'    => $domain,
        'local-hostname' => $domain,
    });
}

sub mongle_setup_script {
    my $config = shift;

    my $hv         = Trog::HV->new();
    my $domain_dir = $hv->domain_dir;

    my $domain          = $config->param('domain');
    my $hvip            = $config->param('hv_internal_ip');
    my $hv_ssh_port     = $config->param('hv_sshd_port');
    my $pre_make_script = $config->param('pre_make_script');

    my $username = $hv->hv_user();
    die "Could not determine the transfer user on the hypervisor" unless $username;
    chomp $username;

    my $script_template = File::Slurper::read_text("$FindBin::Bin/../setup.tmpl");
    $script_template =~ s/%THISIP%/$hvip/gmx;
    $script_template =~ s/%PORT%/$hv_ssh_port/gmx;
    $script_template =~ s/%DOMAIN%/$domain/gmx;
    $script_template =~ s/%THISDIR%/$domain_dir/gmx;
    $script_template =~ s/%USER%/$username/gmx;
    $script_template =~ s/%PRE_MAKE%/$pre_make_script/gmx if $pre_make_script;

    my $sf = "$domain_dir/$domain/setup.sh";
    File::Slurper::write_text($sf, $script_template);
    return $sf;
}

# Make this VM send its rsyslog to here, or wherever is setup correctly
sub mongle_logging_config {
    my $config = shift;

    print "Connecting to Hypervisor...";
    my $hv         = Trog::HV->new();
    print "OK!\n";
    my $domain_dir = $hv->domain_dir;

    my $domain  = $config->param('domain');
    my $ship_to = $config->param('hv_internal_ip');

    my $local_config_template = File::Slurper::read_text("$FindBin::Bin/../rsyslog.tmpl");
    $local_config_template =~ s/%DOMAIN%/$domain/gmx;

    # The guest ships its logs at the HV, so the collector config goes there too.
    my $lcf = "/etc/rsyslog.d/10-$domain.conf";
    $hv->write_text($lcf, $local_config_template, sudo => 1);
    print "Wrote $lcf\n";

    $hv->put_file("$FindBin::Bin/../rsyslog-logrotate.tmpl", "/etc/logrotate.d/vms.conf", sudo => 1);
    print "Wrote /etc/logrotate.d/vms.conf\n";

    #TODO die if these fail
    $hv->run_sudo(qw{systemctl restart rsyslog});
    print "Restarted rsyslogd\n";

    my $config_template = File::Slurper::read_text("$FindBin::Bin/../rsyslog-guest.tmpl");
    $config_template =~ s/%LOGHOST%/$ship_to/gmx;

    my $lf = "$domain_dir/$domain/rsyslog.conf";
    File::Slurper::write_text($lf, $config_template);
    return $lf;
}

exit main(@ARGV) unless caller;

1;
