#!/usr/bin/env perl

package Provisioner::Bin::add_secret;

#ABSTRACT: Put one secret into the store the recipes read from.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();

=head1 USAGE

    add_secret --group GROUP --title TITLE [--field FIELD] [--secrets FILE] -- VALUE
    add_secret --group GROUP --title TITLE [--field FIELD] [--secrets FILE] --stdin < FILE

Write one C<secret:GROUP/TITLE/FIELD> into the secret store, so that the basic
secrets a configuration refers to can be added without opening keepassxc.

C<--field> defaults to C<password>.  It has to name a field the database
actually keeps, which is C<password> or C<username>; anything else is dropped on
save, and this says so rather than reporting a success the store did not keep.

C<--secrets> defaults to F<secrets.kdbx> beside the rest of the configuration.
The passphrase is asked for the same way C<bin/new_config> asks, so a run with
nobody to type at can pipe it in.

=head2 READING THE VALUE FROM STANDARD INPUT

C<--stdin> takes the value from standard input instead of from the command line,
which is what you want for anything that will not fit on one comfortably -- an
ssh private key being the case this was added for:

    bin/add_secret --group koan --title example.com-github-ssh --stdin < id_koan

Worth preferring even where C<-- VALUE> would work.  An argument is readable out
of the process table by anything running as the same user for as long as this
runs, and it lands in the shell history of whoever typed it; a pipe is neither.

One trailing newline is removed, so a key file gives the same value as
C<-- "$(cat id_koan)"> would: command substitution strips it too, and what the
recipes generate is stored without one.  Nothing else is touched -- the interior
newlines of a key are the key.

It cannot be combined with a value on the command line: that would be two
answers to one question, and picking one silently is how the wrong secret gets
stored.

The passphrase is then asked for at the terminal, F</dev/tty>, rather than on
standard input -- which is the value, and has nothing left in it to answer a
prompt with.  So C<--stdin> wants somebody present to type the passphrase, even
though the value itself is piped, and says so when there is no terminal.

=head2 IT WILL NOT OVERWRITE

A reference that already holds something is left exactly as it is, and this
exits non-zero saying so.  Rotating a secret is a different job with different
consequences -- whatever authenticated with the old one stops working -- and it
is not one to do by accident while adding a missing entry.

=cut

sub main {
    my @args = @_;

    my ( $group, $title, $field, $store, $from_stdin, $help );
    GetOptionsFromArray(
        \@args,
        'group=s'   => \$group,
        'title=s'   => \$title,
        'field=s'   => \$field,
        'secrets=s' => \$store,
        'stdin'     => \$from_stdin,
        'help'      => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    $field //= 'password';
    $store //= Trog::Config->path('secrets.kdbx');

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need --group and --title' )
      unless $group && $title;

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Give a value or --stdin, not both' )
      if $from_stdin && @args;

    # Read before the passphrase is asked for, so the order is the same every
    # time and a standard input that is closed says so before anything is
    # opened.  One trailing newline off, and nothing else: the interior newlines
    # of a private key are the key.
    my $value = shift @args;
    if ($from_stdin) {

        # STDIN by name: <> would open whatever is still in @ARGV as files, and
        # main parses a copy of it, so every option is still there.
        $value = do { local $/ = undef; <STDIN> };    ## no critic (InputOutput::ProhibitExplicitStdin)
        chomp $value if defined $value;
    }

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need a value to store' )
      unless length $value;                           ## no critic (ValuesAndExpressions::ProhibitDefinedBeforeLength) -- a secret of "0" is still a secret

    my $ref = "secret:$group/$title/$field";

    my $password = Trog::Credentials->prompt( 'Enter password:', 'keepass', terminal => $from_stdin );

    # Asked before anything is written.  remember() declines to replace what is
    # already there, so without this a run that meant to add would report the
    # value it found rather than the one it was given, and look like it worked.
    my %found = eval { Trog::Secrets->lookup( $store, $password, probe => $ref ) };
    if ( defined $found{probe} ) {
        return 0 if $found{probe} eq $value;

        warn "$ref already holds something else in $store, and this will not replace it.\n" . "Rotating a secret stops whatever authenticated with the old one; do that deliberately.\n";
        return 1;
    }

    my %held = Trog::Secrets->remember( $store, $password, $ref => sub { $value } );

    die "$store did not come back holding $ref\n"
      unless defined $held{$ref} && $held{$ref} eq $value;

    print "Added $ref to $store\n";
    return 0;
}

exit main(@ARGV) unless caller;

1;
