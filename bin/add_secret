#!/usr/bin/env perl

package Provisioner::Bin::add_secret;

#ABSTRACT: Put one secret into the store the recipes read from.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aa';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();

=head1 USAGE

    add_secret --group GROUP --title TITLE [--field FIELD] [--secrets FILE] -- VALUE

Write one C<secret:GROUP/TITLE/FIELD> into the secret store, so that the basic
secrets a configuration refers to can be added without opening keepassxc.

    add_secret --group troglodyne --title easydns_token --field username -- someuser

C<--field> defaults to C<password>.  It has to name a field the database
actually keeps, which is C<password> or C<username>; anything else is dropped on
save, and this says so rather than reporting a success the store did not keep.

C<--secrets> defaults to F<secrets.kdbx> beside the rest of the configuration.
The passphrase is asked for the same way C<bin/new_config> asks, so a run with
nobody to type at can pipe it in.

=head2 IT WILL NOT OVERWRITE

A reference that already holds something is left exactly as it is, and this
exits non-zero saying so.  Rotating a secret is a different job with different
consequences -- whatever authenticated with the old one stops working -- and it
is not one to do by accident while adding a missing entry.

=cut

sub main {
    my @args = @_;

    my ( $group, $title, $field, $store, $help );
    GetOptionsFromArray(
        \@args,
        'group=s'   => \$group,
        'title=s'   => \$title,
        'field=s'   => \$field,
        'secrets=s' => \$store,
        'help'      => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    $field //= 'password';
    $store //= Trog::Config->path('secrets.kdbx');

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need --group and --title' )
      unless defined $group && length $group && defined $title && length $title;

    my $value = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need a value to store' )
      unless defined $value && length $value;

    my $ref = "secret:$group/$title/$field";

    my $password = Trog::Credentials->prompt( 'Enter password:', 'keepass' );

    # Asked before anything is written.  remember() declines to replace what is
    # already there, so without this a run that meant to add would report the
    # value it found rather than the one it was given, and look like it worked.
    my %found = eval { Trog::Secrets->read( $store, $password, probe => $ref ) };
    if ( defined $found{probe} ) {
        return 0 if $found{probe} eq $value;

        warn "$ref already holds something else in $store, and this will not replace it.\n" . "Rotating a secret stops whatever authenticated with the old one; do that deliberately.\n";
        return 1;
    }

    my %held = Trog::Secrets->remember( $store, $password, $ref => sub { $value } );

    die "$store did not come back holding $ref\n"
      unless defined $held{$ref} && $held{$ref} eq $value;

    print "Added $ref to $store\n";
    return 0;
}

exit main(@ARGV) unless caller;

1;
