#!/usr/bin/env perl

package Provisioner::Bin::add_secret;

#ABSTRACT: Put one secret into the store the recipes read from.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();

=head1 USAGE

    add_secret --group GROUP --title TITLE [--field FIELD] [--secrets FILE] -- VALUE
    add_secret --group GROUP --title TITLE [--field FIELD] [--secrets FILE] --stdin < FILE

Write one C<secret:GROUP/TITLE/FIELD> into the secret store.  You can add the
basic secrets that a configuration names without opening keepassxc.

C<--field> defaults to C<password>.  It must name a field that the database
keeps, which is C<password> or C<username>.  The database drops any other field
when it saves.  If that happens, this stops with an error and does not report a
success.

C<--secrets> defaults to F<secrets.kdbx> in the configuration directory.  The
passphrase prompt reads standard input, so you can pipe the passphrase in when
nobody is at a terminal.

=head2 READING THE VALUE FROM STANDARD INPUT

C<--stdin> reads the value from standard input and not from the command line.
Use it for a value that does not fit on a command line, for example an ssh
private key:

    bin/add_secret --group koan --title example.com-github-ssh --stdin < id_koan

Use it also when C<-- VALUE> works.  While this runs, any process of the same
user can read an argument from the process table.  An argument also goes into
the shell history of the person who typed it.  A pipe does neither.

This removes one trailing newline from the value.  Thus a key file gives the
same value as C<-- "$(cat id_koan)">, because command substitution also removes
it.  The recipes also store the keys that they generate without one.  Nothing
else changes, because the newlines inside a key are part of the key.

If you give C<--stdin> and a value on the command line, this stops with an
error.  It does not choose one of the two values, because a silent choice can
store the wrong secret.

With C<--stdin>, the passphrase prompt is at the terminal, F</dev/tty>.
Standard input holds the value, and nothing remains in it to answer a prompt.
So a person must be at the terminal to type the passphrase.  If there is no
terminal, this stops and says so.

=head2 IT WILL NOT OVERWRITE

If the reference already holds a different value, this does not change it.  It
exits non-zero and says so.  If the reference already holds the same value,
this exits zero and writes nothing.  To rotate a secret is a different job,
because everything that authenticated with the old value stops working.

=cut

sub main {
    my @args = @_;

    my ( $group, $title, $field, $store, $from_stdin, $help );
    GetOptionsFromArray(
        \@args,
        'group=s'   => \$group,
        'title=s'   => \$title,
        'field=s'   => \$field,
        'secrets=s' => \$store,
        'stdin'     => \$from_stdin,
        'help'      => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    $field //= 'password';
    $store //= Trog::Config->path('secrets.kdbx');

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need --group and --title' )
      unless $group && $title;

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Give a value or --stdin, not both' )
      if $from_stdin && @args;

    # Read before the passphrase prompt, so an empty standard input stops the
    # run before the store opens.  See READING THE VALUE FROM STANDARD INPUT.
    my $value = shift @args;
    if ($from_stdin) {

        # STDIN by name, because <> opens each word left in @ARGV as a file.
        # main parses a copy, so @ARGV still holds every option.
        $value = do { local $/ = undef; <STDIN> };    ## no critic (InputOutput::ProhibitExplicitStdin)
        chomp $value if defined $value;
    }

    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need a value to store' )
      unless length $value;                           ## no critic (ValuesAndExpressions::ProhibitDefinedBeforeLength) -- a secret of "0" is still a secret

    my $ref = "secret:$group/$title/$field";

    my $password = Trog::Credentials->prompt( 'Enter password:', 'keepass', terminal => $from_stdin );

    # Look before writing, because remember() keeps an existing value and does
    # not say so.
    my %found = eval { Trog::Secrets->lookup( $store, $password, probe => $ref ) };
    if ( defined $found{probe} ) {
        return 0 if $found{probe} eq $value;

        warn "$ref already holds something else in $store, and this will not replace it.\n" . "Rotating a secret stops whatever authenticated with the old one; do that deliberately.\n";
        return 1;
    }

    my %held = Trog::Secrets->remember( $store, $password, $ref => sub { $value } );

    die "$store did not come back holding $ref\n"
      unless defined $held{$ref} && $held{$ref} eq $value;

    print "Added $ref to $store\n";
    return 0;
}

exit main(@ARGV) unless caller;

1;
