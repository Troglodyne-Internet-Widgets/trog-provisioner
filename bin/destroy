#!/usr/bin/env perl

package Trog::Bin::Destroy;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aa';
use FindBin::libs;
use Provisioner::IPPool();
use Provisioner::Cookbook();
use Trog::Config();
use Trog::HV();
use Trog::Local();
use Trog::Hypervisors();
use File::Basename();
use File::Path();
use File::Slurper();
use Getopt::Long qw{GetOptionsFromArray};
use List::Util   qw{uniq};
use Pod::Usage   qw{pod2usage};

=head1 NAME

destroy - tear a provisioned VM back down

=head1 SYNOPSIS

    destroy [OPTIONS] DOMAIN
    destroy --orphans [--dryrun]

    destroy vm.example.com
    destroy --purge --connect qemu+ssh://root@hv1.example.net/system vm.example.com
    destroy --purge --purge-data vm.test

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor holding the domain.  Skips the
search described under C<--hvconf> and goes straight there.  A remote
hypervisor has to be named with an ssh transport
(C<qemu+ssh://user@host/system>).

=item B<--hvconf> FILE

The fleet definition.  Defaults to F</etc/trog-provisioner/hypervisors.conf>.
When it exists, every hypervisor in it is asked whether it has this guest, and
the one that does is the one we destroy on.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.

=item B<--purge>

Also delete the domain directory, on both this machine and the hypervisor.

=item B<--purge-data>

Also delete the domain's directory under the data source, on this machine and on
the hypervisor that held the guest.  C<bin/new_config> makes it for the datadirs
the recipes ask for, writes into it whatever was salvaged off the last guest,
and ships a copy to the hypervisor for the guest to pull its payload out of.

Never implied by C<--purge>, and not to be used on a domain anything will be
restored onto: a real domain's data directory is where its backups come back
from.  It is for throwaway guests, which is what the provisioning-recipes
skill's teardown passes it for.

=item B<--orphans>

Sweep rather than destroy one domain: every C<.test> directory, in the data
source and in the domain directory of each hypervisor in the fleet, that no
hypervisor has a guest for and no recipe configuration names -- here and on each
of them.  Takes no domain.  Pair it with C<--dryrun> first; it says what it
found and where each copy is.

Only C<.test>, which RFC 2606 reserves: nothing real is named under it, and
every real domain's data sits in the same directory.  The two exclusions are
the rest of the safety of it, so neither is inferred and neither may be
unavailable: a name a hypervisor still has is a live guest however old its
directory looks, a name the configuration carries is one somebody means to build
again, and a hypervisor that will not say what it has stops the sweep rather than
being counted as holding nothing.

=item B<--dryrun>

Say what would be removed without removing any of it.

=back

=head1 DESCRIPTION

Undoes what C<provision> did: stops and undefines the VM, destroys the
disks belonging to it, and removes the authorized key it left behind.  Shared resources -- the base image and the
storage pool -- are left alone.

=cut

sub main {
    my @args = @_;

    umask 0022;

    my ( $purge, $purge_data, $orphans, $dryrun, $uri, $domain_dir, $hvconf );
    GetOptionsFromArray(
        \@args,
        'domaindir=s' => \$domain_dir,
        'purge'       => \$purge,
        'purge-data'  => \$purge_data,
        'orphans'     => \$orphans,
        'dryrun'      => \$dryrun,
        'connect=s'   => \$uri,
        'hvconf=s'    => \$hvconf,
    );

    return sweep_orphans( $uri, $hvconf, $dryrun ) if $orphans;

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    # The domain arrives on the command line and ends up in an rm.
    $domain =~ s/\///g;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'That is not a domain' )
      if $domain =~ m/\A[.]*\z/;

    # A domain no hypervisor holds is not always a mistake: a guest that shares
    # another domain's machine never had one of its own.  What is on this side
    # is still ours to take back -- the domain directory, the authorized key,
    # and above all the address, which stays reserved against a domain nobody
    # has if this stops here.
    my $hosted = eval { Trog::Hypervisors->find( $domain, uri => $uri, hvconf => $hvconf, domain_dir => $domain_dir ) };
    my $err    = $@;
    my $hv     = $hosted;
    unless ($hv) {

        # Why, and not just that: this is the whole of what an operator running
        # this by hand is told, and "nothing has it" reads the same for a shared
        # guest as for a domain whose name they typed wrong.
        print $err if $err;
        print "Nothing in the fleet has $domain, so only what is on this side goes.\n";
        $hv = Trog::HV->from_config( undef, ( defined $domain_dir ? ( domain_dir => $domain_dir ) : () ) )->activate();
    }
    print "Destroying on hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    $domain_dir = $hv->domain_dir;

    print "Destroying domain: $domain\n";
    print "[DRY RUN] No changes will be made.\n" if $dryrun;

    # 1. Stop and undefine the VM
    #
    # Only where one is: a domain nothing hosts has no VM and no disks, and the
    # fallback above is this machine, which is not a hypervisor at all on a fleet
    # that keeps them elsewhere.  Asking it anyway fails on the libvirt socket and
    # takes the run down before step five, which is what gives the address back.
    if ($hosted) {
        destroy_vm( $domain, $dryrun );

        # 2. Remove the disks it was using
        destroy_disks( $domain, $dryrun );
    }

    # 3. Remove the domain's SSH pubkey from the HV's authorized_keys
    remove_authorized_key( $domain, $dryrun );
    remove_runner_key( $domain, $dryrun );

    # 4. Optionally purge the domain directory, and the data directory
    if ($purge) {
        purge_domain_dir( $domain, $dryrun );
    }
    else {
        print "Domain directory $domain_dir/$domain preserved (use --purge to remove it)\n";
    }
    purge_data_dir( $domain, $hosted, $dryrun ) if $purge_data;

    # 5. Give the address back to the pool
    release_ip( $domain, $dryrun );

    print "Done.\n";
    return 0;
}

=head2 release_ip($domain, $dryrun)

Hand the domain's static address back to the pool.

Here and nowhere else: re-provisioning a guest goes through C<bin/provision>,
which keeps whatever address the domain already has.  This is the deliberate
"take it away" verb, so it is the one that should let go of the address --
otherwise the pool fills with entries for guests that stopped existing, which
is what the C<[ips]> section of F<ipmap.cfg> did for years.

=cut

sub release_ip {
    my ( $domain, $dryrun ) = @_;

    my $held = Provisioner::IPPool::held_by($domain);
    unless ($held) {
        print "No address was assigned to $domain\n";
        return 0;
    }

    if ($dryrun) {
        print "[DRY RUN] Would return $held to the pool\n";
        return 0;
    }

    Provisioner::IPPool::release($domain);
    print "Returned $held to the pool\n";

    return 1;
}

sub destroy_vm {
    my ( $domain, $dryrun ) = @_;

    my $hv = Trog::HV->new();
    unless ( $hv->domain_exists($domain) ) {
        print "VM $domain not found on " . $hv->uri . ", skipping.\n";
        return;
    }

    print "Stopping VM $domain...\n";
    $hv->annihilate_domain($domain) unless $dryrun;
    return;
}

sub destroy_disks {
    my ( $domain, $dryrun ) = @_;
    my $hv = Trog::HV->new();

    foreach my $volume ( $hv->guest_volumes($domain) ) {
        print "Removing volume $volume\n";
        $hv->delete_volume($volume) unless $dryrun;
    }
    return;
}

sub remove_authorized_key {
    my ( $domain, $dryrun ) = @_;

    # Ours, because ours is where bin/provision wrote it: the guest fetches its
    # payload from this machine, so this is the account it was authorized on.
    my $this_machine = Trog::Local->new();
    my $pubkey_file  = Trog::HV->new()->domain_dir . "/$domain/key.rsa.pub";
    my $pubkey       = eval { File::Slurper::read_text($pubkey_file) };
    return unless defined $pubkey;
    chomp $pubkey;

    my $ak = $this_machine->authorized_keys;
    return unless $this_machine->file_exists($ak);

    # Taking a line out means rewriting the file, so this is the one place that
    # has to read it first -- and the one place that can lock somebody out of
    # their own machine by getting it wrong.  Refuse on anything unexpected.
    my $contents = $this_machine->read_text($ak);
    die "Could not read $ak on " . $this_machine->describe . "; refusing to rewrite it blind\n"
      unless defined $contents && length $contents;

    unless ( $contents =~ m/\Q$pubkey\E/ ) {
        print "Domain SSH key not found in $ak, skipping.\n";
        return;
    }

    print "Removing domain SSH key from $ak\n";
    return if $dryrun;

    my @before = split( "\n", $contents );
    my @after  = grep { $_ !~ m/\Q$pubkey\E/ } @before;
    die "Removing the key for $domain from $ak would drop " . ( scalar(@before) - scalar(@after) ) . " lines, not 1; refusing\n"
      unless scalar(@after) == scalar(@before) - 1;

    $this_machine->write_text( $ak, join( "\n", @after ) . "\n" );
    return;
}

=head2 remove_runner_key($domain, $dryrun)

Take a runner's key back off every hypervisor it was let in to.

The counterpart of C<authorize_runner_key> in F<bin/provision>, and the reason
the public half is written beside the domain rather than only kept in the
store: this needs no passphrase, and a destroy that stops to prompt for one is
a destroy nobody runs.

Which hypervisors is a configuration question, so the Cookbook answers it.

Every line carrying the key goes, rather than the one line C<bin/provision>
wrote.  The key is generated per domain and kept in the store, so there is
nobody else a line carrying it could belong to -- and matching the whole line
instead leaves the grant standing whenever the C<from=> restriction or the
comment has been edited on the hypervisor since.  What is refused is a key that
does not look like one, which is the case that would match half the file.

=cut

sub remove_runner_key {
    my ( $domain, $dryrun ) = @_;

    my $domain_dir = Trog::HV->new()->domain_dir;
    my $pubkey     = eval { File::Slurper::read_text("$domain_dir/$domain/hypervisor-key.pub") };
    return unless defined $pubkey;
    chomp $pubkey;

    # The key material, not the whole line.  What bin/provision wrote carries a
    # from= restriction and a comment, and either can have been edited by hand
    # on the hypervisor since -- matching the line would then leave the grant
    # standing for a guest that no longer exists.  The material is what
    # authorizes anything, so it is what has to go.
    my ($material) = ( split( q{ }, $pubkey ) )[1];
    die "The public key beside $domain does not look like one; refusing to match on it\n"
      unless defined $material && length($material) > 32;

    my $config      = eval { Provisioner::Cookbook->domain_config($domain) } // {};
    my $hypervisors = ( $config->{trogrunner} // {} )->{hypervisors}         // {};
    return unless ref $hypervisors eq 'HASH' && %$hypervisors;

    foreach my $name ( sort keys %$hypervisors ) {
        my $uri     = $hypervisors->{$name}{libvirt_uri}          or next;
        my $machine = eval { Trog::HV->candidate( uri => $uri ) } or next;

        my $ak = eval { $machine->authorized_keys } or next;
        next unless $machine->file_exists($ak);

        my $contents = $machine->read_text($ak);
        die "Could not read $ak on $name; refusing to rewrite it blind\n"
          unless defined $contents && length $contents;

        my @before = split( "\n", $contents );
        my @after  = grep { index( $_, $material ) < 0 } @before;
        my $going  = scalar(@before) - scalar(@after);

        unless ($going) {
            print "$domain's key is not in $ak on $name, skipping.\n";
            next;
        }

        # Every line carrying this key is a grant to the guest being destroyed:
        # the key is generated per domain and lives in the store, so there is
        # nobody else it could belong to.  More than one means a re-provision
        # wrote the line differently at some point, and both have to go.
        print "Removing $going line(s) carrying $domain's key from $ak on $name\n";
        next if $dryrun;

        $machine->write_text( $ak, join( "\n", @after ) . "\n" );
    }

    return;
}

sub purge_domain_dir {
    my ( $domain, $dryrun ) = @_;

    my $hv  = Trog::HV->new();
    my $dir = $hv->domain_dir . "/$domain";
    unless ( -d $dir ) {
        print "Domain directory $dir not found, skipping.\n";
        return;
    }

    print "Purging domain directory $dir\n";
    File::Path::remove_tree($dir) unless $dryrun;
    return;
}

=head2 purge_data_dir($domain, $hv, $dryrun)

Remove the domain's directory under the data source, here and on C<$hv> -- the
hypervisor that held the guest, worked out before it went, since the fleet can
only say which one did for as long as it does.  Undef for C<$hv> is this machine
alone.

Says so, rather than failing, when nothing says where the data source is, and
when the directory is not there: a provision that died early made none.

=cut

sub purge_data_dir {
    my ( $domain, $hv, $dryrun ) = @_;

    my $dir = Provisioner::Cookbook->data_dir($domain);
    unless ($dir) {
        print 'Nothing in ' . Trog::Config->path('recipes.yaml') . " says where the data source is\n" . "(_global: data_source), so there is no data directory to remove.\n";
        return;
    }

    if ($dryrun) {
        print "[DRY RUN] Would purge the data directory $dir, here and on the hypervisor\n";
        return;
    }

    print "Purging data directory $dir\n";
    File::Path::remove_tree($dir) if -d $dir;
    $hv->remove_tree($dir)        if $hv && !$hv->is_local;

    return;
}

=head2 sweep_orphans($uri, $hvconf, $dryrun)

What C<--orphans> does: every C<.test> directory under C<sweep_roots> that no
hypervisor in the fleet has a guest for and no recipe configuration names, here
and on each of them.  Non-zero when a hypervisor could not be asked, or there was
nowhere to look.

=cut

sub sweep_orphans {
    my ( $uri, $hvconf, $dryrun ) = @_;

    my @hvs = $uri ? ( Trog::HV->new( uri => $uri ) ) : Trog::Hypervisors->load( $hvconf // Trog::Hypervisors->default_path )->all;

    # Every guest anywhere in the fleet.  A hypervisor that cannot be asked stops
    # the sweep rather than being skipped: the guests it holds are exactly the
    # ones that would then look like orphans.
    #
    # Asked of the hypervisor rather than of libvirt, because not every
    # hypervisor has one -- a cloud answers this out of Nova, and asking it for a
    # domain list stopped the sweep for the whole fleet.
    my %spoken_for = map { $_ => 1 } grep { !m/\A_/ } keys %{ Provisioner::Cookbook->configuration() };
    foreach my $hv (@hvs) {
        my @names = eval { $hv->guest_names };
        if ($@) {
            warn 'Could not ask ' . $hv->describe . " what guests it has, so nothing is swept:\n$@";
            return 1;
        }
        $spoken_for{$_} = 1 for @names;
    }

    my @roots = sweep_roots(@hvs) or return 1;

    # This machine, as something with the same file operations on it as a
    # hypervisor has, so the copy here and the copy there are taken away the
    # same way.
    my $here = Trog::HV->candidate();

    # name => the copies of it there are, as [ machine, path ] pairs.
    my %found;
    foreach my $root (@roots) {
        ## no critic (ValuesAndExpressions::ProhibitFiletest_d)
        push @{ $found{ File::Basename::basename($_) } }, [ $here, $_ ] for grep { -d $_ } glob "$root/*.test";

        foreach my $hv (@hvs) {
            next if $hv->is_local;
            push @{ $found{$_} }, [ $hv, "$root/$_" ] for grep { substr( $_, -length '.test' ) eq '.test' } $hv->list_dir($root);
        }
    }

    my @orphans = sort grep { !$spoken_for{$_} } keys %found;
    unless (@orphans) {
        print 'Nothing under ' . join( ' or ', @roots ) . " belongs to a guest that is gone.\n";
        return 0;
    }

    print scalar(@orphans) . ' of ' . scalar( keys %found ) . ' .test directories under ' . join( ' and ', @roots ) . " belong to no guest:\n";
    foreach my $name (@orphans) {
        print "  $name (" . join( ', ', where_they_are( $found{$name} ) ) . ")\n";
    }

    if ($dryrun) {
        print "[DRY RUN] None of it removed.\n";
        return 0;
    }

    foreach my $name (@orphans) {
        $_->[0]->remove_tree( $_->[1] ) for @{ $found{$name} };
    }

    print 'Removed ' . scalar(@orphans) . " directories.\n";
    return 0;
}

=head2 sweep_roots(@hvs)

The directories a run leaves things in: the data source, and the domain
directory of each hypervisor.  Empty, having said why, only when there is
neither.

The data source is C<Provisioner::Cookbook>'s answer, which is C<_base>'s
C<_global: data_source> or the C<data> recipe's C<from> before it.  Without one
the domain directories are still swept: they come out of the fleet, because that
is where C<purge_domain_dir> gets the one it purges, and a configuration that says
nothing about data still builds guests into them.

=cut

sub sweep_roots {
    my (@hvs) = @_;

    my $data = Provisioner::Cookbook->data_source();
    warn 'Nothing in ' . Trog::Config->path('recipes.yaml') . " says where the data source is\n" . "(_global: data_source), so only the domain directories are swept.\n"
      unless $data;

    my @roots = uniq( grep { defined && length } $data, map { $_->domain_dir } @hvs );
    warn "And there is no fleet to ask for a domain directory either, so there is nothing to sweep.\n" unless @roots;

    return @roots;
}

=head2 where_they_are($copies)

The machines a name was found on, for saying so: C<here> for this one and the
hypervisor's name for the others, each mentioned once however many directories
it turned up in.

=cut

sub where_they_are {
    my ($copies) = @_;
    return uniq( map { $_->[0]->is_local ? 'here' : ( $_->[0]->name // $_->[0]->describe ) } @$copies );
}

exit main(@ARGV) unless caller;

1;
