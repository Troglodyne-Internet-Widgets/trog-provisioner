#!/usr/bin/env perl

package Trog::Bin::Destroy;

use strict;
use warnings FATAL => 'all';

use FindBin::libs;
use Trog::HV();
use Trog::Hypervisors();
use File::Slurper();
use List::Util qw{any};
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage qw{pod2usage};

=head1 NAME

destroy - tear a provisioned VM back down

=head1 SYNOPSIS

    destroy [OPTIONS] DOMAIN

    destroy vm.example.com
    destroy --purge --connect qemu+ssh://root@hv1.example.net/system vm.example.com

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor holding the domain.  Skips the
search described under C<--hvconf> and goes straight there.  A remote
hypervisor has to be named with an ssh transport
(C<qemu+ssh://user@host/system>).

=item B<--hvconf> FILE

The fleet definition.  Defaults to F<hypervisors.conf> in the domain directory.
When it exists, every hypervisor in it is asked whether it has this guest, and
the one that does is the one we destroy on.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.

=item B<--tfdir> DIR

Where terraform's config and state live.  Defaults to the same per-hypervisor
path C<provision> writes to.

=item B<--purge>

Also delete the domain directory, on both this machine and the hypervisor.

=item B<--dryrun>

Say what would be removed without removing any of it.

=back

=head1 DESCRIPTION

Undoes what C<provision> did: stops and undefines the VM, destroys the
terraform resources belonging to it, and removes the hypervisor-side rsyslog
config and authorized key it left behind.  Shared resources (the base image and
the storage pool) are left alone.

=cut

sub main {
    my @args = @_;

    umask 0022;

    my ($purge, $dryrun, $uri, $tf_dir, $domain_dir, $hvconf);
    GetOptionsFromArray(\@args,
        'domaindir=s' => \$domain_dir,
        'purge'       => \$purge,
        'dryrun'      => \$dryrun,
        'connect=s'   => \$uri,
        'tfdir=s'     => \$tf_dir,
        'hvconf=s'    => \$hvconf,
    );

    my $domain = shift @args;
    pod2usage(-exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed')
      unless $domain;

    $domain =~ s/\///g;

    my $hv = Trog::Hypervisors->find($domain,
        uri => $uri, hvconf => $hvconf, tf_dir => $tf_dir, domain_dir => $domain_dir);
    print "Destroying on hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    $domain_dir = $hv->domain_dir;


    my $domain_mongled = $domain;
    $domain_mongled =~ s/\./-/g;

    print "Destroying domain: $domain\n";
    print "[DRY RUN] No changes will be made.\n" if $dryrun;

    # 1. Stop and undefine the VM
    destroy_vm($domain, $dryrun);

    # 2. Remove terraform-managed resources for this domain
    destroy_tf_resources($domain, $domain_mongled, $dryrun);

    # 3. Remove HV-side terraform config files
    remove_tf_configs($domain, $dryrun);

    # 4. Remove HV-side rsyslog config
    remove_rsyslog_config($domain, $dryrun);

    # 5. Remove the domain's SSH pubkey from the HV's authorized_keys
    remove_authorized_key($domain, $dryrun);

    # 6. Optionally purge the domain directory
    if ($purge) {
        purge_domain_dir($domain, $dryrun);
    } else {
        print "Domain directory $domain_dir/$domain preserved (use --purge to remove it)\n";
    }

    print "Done.\n";
    return 0;
}

sub destroy_vm {
    my ($domain, $dryrun) = @_;

    my $hv = Trog::HV->new();
    unless ($hv->domain_exists($domain)) {
        print "VM $domain not found on " . $hv->uri . ", skipping.\n";
        return;
    }

    print "Stopping VM $domain...\n";
    $hv->annihilate_domain($domain) unless $dryrun;
    return;
}

sub destroy_tf_resources {
    my ($domain, $domain_mongled, $dryrun) = @_;

    my $tf_config_dir = Trog::HV->new()->tf_config_dir;
    return unless -d $tf_config_dir;

    chdir $tf_config_dir or do {
        warn "Cannot chdir to $tf_config_dir: $!\n";
        return;
    };

    my $resources = qx{terraform state list 2>/dev/null};
    chomp $resources;
    return unless $resources;

    my @exempt = qw{libvirt_volume.image_base libvirt_pool.tf_disks};
    foreach my $resource (split(/\n/, $resources)) {
        next unless $resource =~ m/\Q$domain_mongled\E/;
        next if any { $_ eq $resource } @exempt;
        print "Destroying terraform resource $resource\n";
        unless ($dryrun) {
            system(qw{terraform destroy -auto-approve -target}, $resource);
        }
    }
    return;
}

sub remove_tf_configs {
    my ($domain, $dryrun) = @_;

    my $cfgdir = Trog::HV->new()->tf_config_dir;
    my @patterns = map { "$cfgdir/$domain.$_" } qw{tf cloud_init.cfg network_config.cfg};

    foreach my $f (@patterns) {
        next unless -f $f;
        print "Removing $f\n";
        unlink $f unless $dryrun;
    }
    return;
}

sub remove_rsyslog_config {
    my ($domain, $dryrun) = @_;

    my $hv   = Trog::HV->new();
    my $conf = "/etc/rsyslog.d/10-$domain.conf";
    unless ($hv->file_exists_hv($conf)) {
        print "No rsyslog config found at $conf, skipping.\n";
        return;
    }

    print "Removing rsyslog config $conf\n";
    unless ($dryrun) {
        $hv->system_hv(qw{sudo rm -f}, $conf);
        $hv->system_hv(qw{sudo systemctl restart rsyslog});
    }
    return;
}

sub remove_authorized_key {
    my ($domain, $dryrun) = @_;

    my $hv          = Trog::HV->new();
    my $pubkey_file = $hv->domain_dir . "/$domain/key.rsa.pub";
    return unless -f $pubkey_file;

    my $pubkey = File::Slurper::read_text($pubkey_file);
    chomp $pubkey;

    my $ak = $hv->authorized_keys;
    return unless $hv->file_exists_hv($ak);

    my $contents = $hv->read_text_hv($ak);
    if ($contents =~ m/\Q$pubkey\E/) {
        print "Removing domain SSH key from $ak\n";
        unless ($dryrun) {
            my @lines = grep { $_ !~ m/\Q$pubkey\E/ } split(/\n/, $contents);
            $hv->write_text_hv($ak, join("\n", @lines) . "\n");
        }
    } else {
        print "Domain SSH key not found in $ak, skipping.\n";
    }
    return;
}

sub purge_domain_dir {
    my ($domain, $dryrun) = @_;

    my $hv  = Trog::HV->new();
    my $dir = $hv->domain_dir . "/$domain";
    unless (-d $dir) {
        print "Domain directory $dir not found, skipping.\n";
        return;
    }

    print "Purging domain directory $dir\n";
    unless ($dryrun) {
        system(qw{rm -rf}, $dir);
        # A remote HV holds a copy of the whole domain dir for the guest to pull.
        $hv->system_hv(qw{rm -rf}, $dir) unless $hv->is_local;
    }
    return;
}

exit main(@ARGV) unless caller;

1;
