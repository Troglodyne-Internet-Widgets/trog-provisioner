#!/usr/bin/env perl

package Trog::Bin::Destroy;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aasx';
use FindBin::libs;
use Provisioner::IPPool();
use Provisioner::Cookbook();
use Trog::Config();
use Trog::HV();
use Trog::Local();
use Trog::Hypervisors();
use File::Basename();
use File::Path();
use File::Slurper();
use Getopt::Long qw{GetOptionsFromArray};
use List::Util   qw{uniq sum};
use Pod::Usage   qw{pod2usage};

=head1 NAME

destroy - remove a provisioned VM

=head1 SYNOPSIS

    destroy [OPTIONS] DOMAIN
    destroy --orphans [--dryrun]

    destroy vm.example.com
    destroy --purge --connect qemu+ssh://root@hv1.example.net/system vm.example.com
    destroy --purge --purge-data vm.test

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor that holds the domain.  With
it, destroy does not search the fleet (see C<--hvconf>) and goes to that
hypervisor.  Name a remote hypervisor with an ssh transport
(C<qemu+ssh://user@host/system>).

=item B<--hvconf> FILE

The fleet definition.  The default is F</etc/trog-provisioner/hypervisors.conf>.
If the file exists, destroy asks each hypervisor in it for the guest.  It
destroys the guest on the hypervisor that has it.

=item B<--domaindir> DIR

The directory that holds the per-domain directories.  The default is
F</opt/domains>.

=item B<--purge>

Also delete the domain directory on this machine.

=item B<--purge-data>

Also delete the directory of the domain under the data source, on this machine
and on the hypervisor that held the guest.  C<bin/new_config> makes this
directory for the datadirs that the recipes ask for.  It also writes into it
what it salvaged from the last guest.

C<--purge> does not include this option.  Do not use it on a domain that you
will restore.  The data directory of a real domain is where its backups come
back from.  The option is for throwaway guests, and the teardown of the
provisioning-recipes skill passes it for them.

=item B<--orphans>

Sweep instead of destroying one domain.  The sweep removes every C<.test>
directory in the data source and in the domain directory of each hypervisor in
the fleet, if two things are true:

=over 4

=item *

No hypervisor has a guest with that name.

=item *

No recipe configuration names it.

=back

The sweep looks on this machine and on each hypervisor.  It takes no domain.
Run it with C<--dryrun> first.  It says what it found and where each copy is.

The sweep touches only C<.test>, which RFC 2606 reserves, so no real domain has
a name under it.  The data of every real domain is in the same directory, so the
two conditions above are the rest of the safety.  Neither one is guessed, and
neither can be missing.  A name that a hypervisor still has is a live guest,
however old its directory is.  A name that the configuration has is one that
somebody intends to build again.

If a hypervisor does not say what guests it has, the run stops.  The sweep does
not count it as a hypervisor with no guests, because its guests are exactly the
names that then look like orphans.

=item B<--backups>

Sweep instead of destroying one domain.  The sweep removes every disk that
C<bin/provision --clone-on-nonreusable> copied aside, on each hypervisor in the
fleet.  It takes no domain.  Run it with C<--dryrun> first.  It names every copy
and the machine that holds it.

A copy is a volume, not a domain, so nothing else in the toolkit removes one.
This sweep removes every copy, even a copy whose guest still runs.
C<sweep_backups> tells why, and why this is not the same rule as C<--orphans>.

=item B<--dryrun>

Say what destroy will remove, and remove nothing.

=back

=head1 DESCRIPTION

destroy undoes what C<provision> did.  It stops and undefines the VM, destroys
its disks, and removes the authorized keys that were added for it.  Then it
returns the address of the domain to the pool.  It does not touch the shared
resources, which are the base image and the storage pool.

=cut

sub main {
    my @args = @_;

    umask 0022;

    my ( $purge, $purge_data, $orphans, $backups, $dryrun, $uri, $domain_dir, $hvconf );
    GetOptionsFromArray(
        \@args,
        'domaindir=s' => \$domain_dir,
        'purge'       => \$purge,
        'purge-data'  => \$purge_data,
        'orphans'     => \$orphans,
        'backups'     => \$backups,
        'dryrun'      => \$dryrun,
        'connect=s'   => \$uri,
        'hvconf=s'    => \$hvconf,
    );

    return sweep_orphans( $uri, $hvconf, $dryrun ) if $orphans;
    return sweep_backups( $uri, $hvconf, $dryrun ) if $backups;

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    # The domain comes from the command line and goes into an rm.
    $domain =~ s/\///g;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'That is not a domain' )
      if $domain =~ m/\A[.]*\z/;

    # A domain that no hypervisor holds is not always a mistake.  A guest that
    # shares the machine of another domain never had a VM of its own.  We still
    # remove what is on this side: the domain directory, the authorized key and
    # the address.  If this stops here, the address stays reserved for a domain
    # that nobody has.
    my $hosted = eval { Trog::Hypervisors->find( $domain, uri => $uri, hvconf => $hvconf, domain_dir => $domain_dir ) };
    my $err    = $@;
    my $hv     = $hosted;
    unless ($hv) {

        # Print the reason too.  "Nothing has it" reads the same for a shared
        # guest and for a domain name with a typing error.
        print $err if $err;
        print "Nothing in the fleet has $domain, so only what is on this side goes.\n";
        $hv = Trog::HV->from_config( undef, ( defined $domain_dir ? ( domain_dir => $domain_dir ) : () ) )->activate();
    }
    print "Destroying on hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    $domain_dir = $hv->domain_dir;

    my $announce = "Destroying domain: $domain\n";
    $announce .= "[DRY RUN] No changes will be made.\n" if $dryrun;
    print $announce;

    # Steps 1 to 4, then the address, whatever happened in steps 1 to 4.  A
    # failure does not stop the run, because a leaked address stays reserved
    # for a domain that does not exist.
    #
    # The eval is for annihilate_domain, which dies if a guest does not stop or
    # undefine.  delete_volume only warns and returns false.
    my $failure;
    eval {
        # 1. Stop and undefine the VM
        #
        # Only if there is one.  A domain that nothing hosts has no VM and no
        # disks, and the fallback above is this machine, which is not always a
        # hypervisor.
        if ($hosted) {
            destroy_vm( $domain, $dryrun );

            # 2. Remove the disks it was using
            destroy_disks( $domain, $dryrun );
        }

        # 3. Remove its keys from authorized_keys, here and on the hypervisors
        remove_authorized_key( $domain, $dryrun );
        remove_runner_key( $domain, $dryrun );

        # 4. Optionally purge the domain directory, and the data directory
        if ($purge) {
            purge_domain_dir( $domain, $dryrun );
        }
        else {
            print "Domain directory $domain_dir/$domain preserved (use --purge to remove it)\n";
        }
        purge_data_dir( $domain, $hosted, $dryrun ) if $purge_data;
        1;
    } or do {
        $failure = $@ || "Destroying $domain failed, without saying why.\n";
        warn $failure;
    };

    # 5. Give the address back to the pool
    release_ip( $domain, $dryrun );

    # The address came back, but that does not mean the teardown worked.
    print $failure  ? "Done, except for what failed above.\n" : "Done.\n";
    return $failure ? 1                                       : 0;
}

=head2 release_ip($domain, $dryrun)

Give the static address of the domain back to the pool.  Returns 1 if it
released an address, and 0 if the domain had none or C<$dryrun> is true.

Only destroy releases an address.  C<bin/provision> keeps the address that the
domain already has when it builds the guest again.  If destroy did not release
it, the pool fills with entries for guests that do not exist.

=cut

sub release_ip {
    my ( $domain, $dryrun ) = @_;

    my $held = Provisioner::IPPool::held_by($domain);
    unless ($held) {
        print "No address was assigned to $domain\n";
        return 0;
    }

    if ($dryrun) {
        print "[DRY RUN] Would return $held to the pool\n";
        return 0;
    }

    Provisioner::IPPool::release($domain);
    print "Returned $held to the pool\n";

    return 1;
}

sub destroy_vm {
    my ( $domain, $dryrun ) = @_;

    my $hv = Trog::HV->new();
    unless ( $hv->domain_exists($domain) ) {
        print "VM $domain not found on " . $hv->uri . ", skipping.\n";
        return;
    }

    print "Stopping VM $domain...\n";
    $hv->annihilate_domain($domain) unless $dryrun;
    return;
}

sub destroy_disks {
    my ( $domain, $dryrun ) = @_;
    my $hv = Trog::HV->new();

    foreach my $volume ( $hv->guest_volumes($domain) ) {
        print "Removing volume $volume\n";
        $hv->delete_volume($volume) unless $dryrun;
    }
    return;
}

sub remove_authorized_key {
    my ( $domain, $dryrun ) = @_;

    # This machine, because the guest fetches its payload from here, so
    # bin/provision authorized the key here.
    my $this_machine = Trog::Local->new();
    my $pubkey_file  = Trog::HV->new()->domain_dir . "/$domain/key.rsa.pub";
    my $pubkey       = eval { File::Slurper::read_text($pubkey_file) };
    return unless defined $pubkey;
    chomp $pubkey;

    my $ak = $this_machine->authorized_keys;
    return unless $this_machine->file_exists($ak);

    # A mistake when the file is written again can lock the owner out of this
    # machine.  Refuse anything unexpected.
    my $contents = $this_machine->read_text($ak);
    die "Could not read $ak on " . $this_machine->describe . "; refusing to rewrite it blind\n"
      unless $contents;

    unless ( $contents =~ m/\Q$pubkey\E/ ) {
        print "Domain SSH key not found in $ak, skipping.\n";
        return;
    }

    print "Removing domain SSH key from $ak\n";
    return if $dryrun;

    my @before = split( m/\n/, $contents );
    my @after  = grep { $_ !~ m/\Q$pubkey\E/ } @before;
    die "Removing the key for $domain from $ak would drop " . ( scalar(@before) - scalar(@after) ) . " lines, not 1; refusing\n"
      unless scalar(@after) == scalar(@before) - 1;

    $this_machine->write_text( $ak, join( "\n", @after ) . "\n" );
    return;
}

=head2 remove_runner_key($domain, $dryrun)

Remove the key of a runner from each hypervisor that authorized it.  Returns
nothing.  Dies if the public key beside the domain does not look like a key, or
if an F<authorized_keys> file that exists is empty or cannot be read.

This is the counterpart of C<authorize_runner_key> in F<bin/provision>.  It
reads the public half from the domain directory, not from the store, so it
needs no passphrase.  A destroy that stops to ask for a passphrase is a destroy
that nobody runs.

C<Provisioner::Cookbook> says which hypervisors to clean.

It removes every line that has the key material in it, not only the line that
C<bin/provision> wrote.  The key is generated per domain and kept in the store,
so no other grant can have it.  A match on the whole line fails if somebody
edited the C<from=> restriction or the comment on the hypervisor.  The check on
the key prevents a short or empty string that matches half the file.

=cut

sub remove_runner_key {
    my ( $domain, $dryrun ) = @_;

    my $domain_dir = Trog::HV->new()->domain_dir;
    my $pubkey     = eval { File::Slurper::read_text("$domain_dir/$domain/hypervisor-key.pub") };
    return unless defined $pubkey;
    chomp $pubkey;

    # The key material, not the whole line.  The POD above tells why.
    my ($material) = ( split( q{ }, $pubkey ) )[1];
    die "The public key beside $domain does not look like one; refusing to match on it\n"
      if !defined $material || length($material) <= 32;

    my $config      = eval { Provisioner::Cookbook->domain_config($domain) } // {};
    my $hypervisors = ( $config->{trogrunner} // {} )->{hypervisors}         // {};
    return unless ref $hypervisors eq 'HASH' && %$hypervisors;

    foreach my $name ( sort keys %$hypervisors ) {
        my $uri     = $hypervisors->{$name}{libvirt_uri}          or next;
        my $machine = eval { Trog::HV->candidate( uri => $uri ) } or next;

        my $ak = eval { $machine->authorized_keys } or next;
        next unless $machine->file_exists($ak);

        my $contents = $machine->read_text($ak);
        die "Could not read $ak on $name; refusing to rewrite it blind\n"
          unless $contents;

        my @before = split( m/\n/, $contents );
        my @after  = grep { index( $_, $material ) < 0 } @before;
        my $going  = scalar(@before) - scalar(@after);

        unless ($going) {
            print "$domain's key is not in $ak on $name, skipping.\n";
            next;
        }

        # More than one line means that a provision wrote the line differently
        # at some time.  All of them go.
        print "Removing $going line(s) carrying $domain's key from $ak on $name\n";
        next if $dryrun;

        $machine->write_text( $ak, join( "\n", @after ) . "\n" );
    }

    return;
}

sub purge_domain_dir {
    my ( $domain, $dryrun ) = @_;

    my $hv  = Trog::HV->new();
    my $dir = $hv->domain_dir . "/$domain";
    unless ( -d $dir ) {
        print "Domain directory $dir not found, skipping.\n";
        return;
    }

    print "Purging domain directory $dir\n";
    File::Path::remove_tree($dir) unless $dryrun;
    return;
}

=head2 purge_data_dir($domain, $hv, $dryrun)

Remove the directory of the domain under the data source, here and on C<$hv>.
C<$hv> is the hypervisor that held the guest.  The caller finds it before the
guest goes, because after that the fleet cannot say which one held it.  If
C<$hv> is undef, only this machine is cleaned.

If nothing says where the data source is, it says so and returns.  It does not
fail if the directory is not there, because a provision that stopped early
makes none.  Returns nothing.

=cut

sub purge_data_dir {
    my ( $domain, $hv, $dryrun ) = @_;

    my $dir = Provisioner::Cookbook->data_dir($domain);
    unless ($dir) {
        print 'Nothing in ' . Trog::Config->path('recipes.yaml') . " says where the data source is\n" . "(_global: data_source), so there is no data directory to remove.\n";
        return;
    }

    if ($dryrun) {
        print "[DRY RUN] Would purge the data directory $dir, here and on the hypervisor\n";
        return;
    }

    print "Purging data directory $dir\n";
    File::Path::remove_tree($dir) if -d $dir;
    $hv->remove_tree($dir)        if $hv && !$hv->is_local;

    return;
}

=head2 sweep_backups($uri, $hvconf, $dryrun)

Remove the disks that C<bin/provision --clone-on-nonreusable> copied aside.
Returns 0 if it removed every copy, found none, or C<$dryrun> is true.  Returns
1 if a copy did not go.

Nothing else removes them.  C<guest_volumes> does not name a copy, so a destroy
of its guest leaves the copy in place.

It removes all copies, even those whose guest still exists.  The rule of
C<sweep_orphans> does not apply here.  When a copy outlives its guest, the copy
is the only thing left.  Three things guard this sweep instead:

=over 4

=item *

It looks only at copies.

=item *

It names every copy before it removes one.

=item *

It removes none when C<$dryrun> is true.

=back

A backend that makes no copies reports none.  If a pool cannot be read, the
backend dies, and nothing here catches it.

=cut

sub sweep_backups {
    my ( $uri, $hvconf, $dryrun ) = @_;

    my @hvs = $uri ? ( Trog::HV->new( uri => $uri ) ) : Trog::Hypervisors->load( $hvconf // Trog::Hypervisors->default_path )->hypervisors;

    my %found;
    foreach my $hv (@hvs) {
        push @{ $found{$_} }, $hv for $hv->backup_volumes;
    }

    my @copies = sort keys %found;
    unless (@copies) {
        print "No disks have been copied aside anywhere in the fleet.\n";
        return 0;
    }

    # A copy is a volume on one machine, so a name two machines hold is two.
    my $count = sum( map { scalar @{ $found{$_} } } @copies );
    print "$count " . ( $count == 1 ? 'disk' : 'disks' ) . " copied aside, and nothing has taken them away:\n";
    foreach my $name (@copies) {
        print "  $name (" . join( ', ', map { $_->is_local ? 'here' : ( $_->name // $_->describe ) } @{ $found{$name} } ) . ")\n";
    }

    if ($dryrun) {
        print "[DRY RUN] None of it removed.\n";
        return 0;
    }

    # delete_volume warns and returns false if it cannot remove a volume, so
    # count the volumes that went.
    my $removed = 0;
    foreach my $name (@copies) {
        $removed++ for grep { $_ } map { $_->delete_volume($name) } @{ $found{$name} };
    }

    print "Removed $removed of $count copies.\n";
    return $removed == $count ? 0 : 1;
}

=head2 sweep_orphans($uri, $hvconf, $dryrun)

The sweep that C<--orphans> runs, over the directories that C<sweep_roots>
returns.  See C<--orphans> for what it removes.  Returns 1 if there was nowhere
to look, and 0 otherwise.  Dies if a hypervisor cannot say what guests it
holds.

=cut

sub sweep_orphans {
    my ( $uri, $hvconf, $dryrun ) = @_;

    my @hvs = $uri ? ( Trog::HV->new( uri => $uri ) ) : Trog::Hypervisors->load( $hvconf // Trog::Hypervisors->default_path )->hypervisors;

    # Ask the hypervisor, not libvirt, because a cloud has no libvirt.  It
    # answers from Nova.
    my %spoken_for = map { $_ => 1 } grep { !m/\A_/ } keys %{ Provisioner::Cookbook->configuration() };
    foreach my $hv (@hvs) {
        $spoken_for{$_} = 1 for $hv->guest_names;
    }

    my @roots = sweep_roots(@hvs) or return 1;

    # This machine, with the same file operations as a hypervisor, so the copy
    # here and the copy there are removed the same way.
    my $here = Trog::HV->candidate();

    # name => its copies, as [ machine, path ] pairs.
    my %found;
    foreach my $root (@roots) {
        push @{ $found{ File::Basename::basename($_) } }, [ $here, $_ ] for grep { -d $_ } glob "$root/*.test";

        foreach my $hv (@hvs) {
            next if $hv->is_local;
            push @{ $found{$_} }, [ $hv, "$root/$_" ] for grep { substr( $_, -length '.test' ) eq '.test' } $hv->list_dir($root);
        }
    }

    my @orphans = sort grep { !$spoken_for{$_} } keys %found;
    unless (@orphans) {
        print 'Nothing under ' . join( ' or ', @roots ) . " belongs to a guest that is gone.\n";
        return 0;
    }

    print scalar(@orphans) . ' of ' . scalar( keys %found ) . ' .test directories under ' . join( ' and ', @roots ) . " belong to no guest:\n";
    foreach my $name (@orphans) {
        print "  $name (" . join( ', ', where_they_are( $found{$name} ) ) . ")\n";
    }

    if ($dryrun) {
        print "[DRY RUN] None of it removed.\n";
        return 0;
    }

    foreach my $name (@orphans) {
        $_->[0]->remove_tree( $_->[1] ) for @{ $found{$name} };
    }

    print 'Removed ' . scalar(@orphans) . " directories.\n";
    return 0;
}

=head2 sweep_roots(@hvs)

Returns the directories that a run leaves things in: the data source, and the
domain directory of each hypervisor.  Returns an empty list, with a warning,
only if there are neither.

The data source comes from C<Provisioner::Cookbook>, which reads
C<_global: data_source>.  If there is none, the domain directories are still
swept.  They come from the fleet, because C<purge_domain_dir> gets its
directory there too.  A configuration that says nothing about data still builds
guests into them.

=cut

sub sweep_roots {
    my (@hvs) = @_;

    my $data = Provisioner::Cookbook->data_source();
    warn 'Nothing in ' . Trog::Config->path('recipes.yaml') . " says where the data source is\n" . "(_global: data_source), so only the domain directories are swept.\n"
      unless $data;

    my @roots = uniq( grep { $_ } $data, map { $_->domain_dir } @hvs );
    warn "And there is no fleet to ask for a domain directory either, so there is nothing to sweep.\n" unless @roots;

    return @roots;
}

=head2 where_they_are($copies)

Returns the machines where a name was found, for a message.  This machine is
C<here>, and a hypervisor is its name.  Each machine is in the list once, however
many directories it had.

=cut

sub where_they_are {
    my ($copies) = @_;
    return uniq( map { $_->[0]->is_local ? 'here' : ( $_->[0]->name // $_->[0]->describe ) } @$copies );
}

exit main(@ARGV) unless caller;

1;
