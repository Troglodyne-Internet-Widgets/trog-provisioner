#!/usr/bin/env perl

package Trog::Bin::Destroy;

use 5.041;

use strict;
use warnings FATAL => 'all';

use re '/aa';
use FindBin::libs;
use Trog::HV();
use Trog::Hypervisors();
use File::Path();
use File::Slurper();
use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage qw{pod2usage};

=head1 NAME

destroy - tear a provisioned VM back down

=head1 SYNOPSIS

    destroy [OPTIONS] DOMAIN

    destroy vm.example.com
    destroy --purge --connect qemu+ssh://root@hv1.example.net/system vm.example.com

=head1 OPTIONS

=over 4

=item B<--connect> URI

The libvirt connection string of the hypervisor holding the domain.  Skips the
search described under C<--hvconf> and goes straight there.  A remote
hypervisor has to be named with an ssh transport
(C<qemu+ssh://user@host/system>).

=item B<--hvconf> FILE

The fleet definition.  Defaults to F</etc/trog-provisioner/hypervisors.conf>.
When it exists, every hypervisor in it is asked whether it has this guest, and
the one that does is the one we destroy on.

=item B<--domaindir> DIR

Where the per-domain directories live.  Defaults to F</opt/domains>.

=item B<--purge>

Also delete the domain directory, on both this machine and the hypervisor.

=item B<--dryrun>

Say what would be removed without removing any of it.

=back

=head1 DESCRIPTION

Undoes what C<provision> did: stops and undefines the VM, destroys the
disks belonging to it, and removes the hypervisor-side rsyslog config and
authorized key it left behind.  Shared resources -- the base image and the
storage pool -- are left alone.

=cut

sub main {
    my @args = @_;

    ## no critic (Plicease::ProhibitLeadingZeros) -- a file mode, which is octal
    umask 0022;

    my ($purge, $dryrun, $uri, $domain_dir, $hvconf);
    GetOptionsFromArray(\@args,
        'domaindir=s' => \$domain_dir,
        'purge'       => \$purge,
        'dryrun'      => \$dryrun,
        'connect=s'   => \$uri,
        'hvconf=s'    => \$hvconf,
    );

    my $domain = shift @args;
    pod2usage(-exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed')
      unless $domain;

    $domain =~ s/\///g;

    my $hv = Trog::Hypervisors->find($domain,
        uri => $uri, hvconf => $hvconf, domain_dir => $domain_dir);
    print "Destroying on hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    $domain_dir = $hv->domain_dir;


    print "Destroying domain: $domain\n";
    print "[DRY RUN] No changes will be made.\n" if $dryrun;

    # 1. Stop and undefine the VM
    destroy_vm($domain, $dryrun);

    # 2. Remove the disks it was using
    destroy_disks($domain, $dryrun);

    # 3. Remove HV-side rsyslog config
    remove_rsyslog_config($domain, $dryrun);

    # 4. Remove the domain's SSH pubkey from the HV's authorized_keys
    remove_authorized_key($domain, $dryrun);

    # 5. Optionally purge the domain directory
    if ($purge) {
        purge_domain_dir($domain, $dryrun);
    } else {
        print "Domain directory $domain_dir/$domain preserved (use --purge to remove it)\n";
    }

    print "Done.\n";
    return 0;
}

sub destroy_vm {
    my ($domain, $dryrun) = @_;

    my $hv = Trog::HV->new();
    unless ($hv->domain_exists($domain)) {
        print "VM $domain not found on " . $hv->uri . ", skipping.\n";
        return;
    }

    print "Stopping VM $domain...\n";
    $hv->annihilate_domain($domain) unless $dryrun;
    return;
}

sub destroy_disks {
    my ($domain, $dryrun) = @_;
    my $hv = Trog::HV->new();

    # The guest's own overlay and its cloud-init seed.  The base image is
    # shared by every guest on the hypervisor and is emphatically not ours to
    # remove; nor is the pool.
    foreach my $volume ("$domain-qcow2", "$domain-cloudinit.iso") {
        next unless $hv->volume($volume);
        print "Removing volume $volume\n";
        $hv->delete_volume($volume) unless $dryrun;
    }
    return;
}

sub remove_rsyslog_config {
    my ($domain, $dryrun) = @_;

    my $hv   = Trog::HV->new();
    my $conf = "/etc/rsyslog.d/10-$domain.conf";
    unless ($hv->file_exists($conf)) {
        print "No rsyslog config found at $conf, skipping.\n";
        return;
    }

    print "Removing rsyslog config $conf\n";
    unless ($dryrun) {
        $hv->run_sudo(qw{rm -f}, $conf);
        $hv->run_sudo(qw{systemctl restart rsyslog});
    }
    return;
}

sub remove_authorized_key {
    my ($domain, $dryrun) = @_;

    my $hv          = Trog::HV->new();
    my $pubkey_file = $hv->domain_dir . "/$domain/key.rsa.pub";
    my $pubkey = eval { File::Slurper::read_text($pubkey_file) };
    return unless defined $pubkey;
    chomp $pubkey;

    my $ak = $hv->authorized_keys;
    return unless $hv->file_exists($ak);

    # Taking a line out means rewriting the file, so this is the one place that
    # has to read it first -- and the one place that can lock somebody out of
    # their own machine by getting it wrong.  Refuse on anything unexpected.
    my $contents = $hv->read_text($ak);
    die "Could not read $ak on " . $hv->describe . "; refusing to rewrite it blind\n"
      unless defined $contents && length $contents;

    unless ($contents =~ m/\Q$pubkey\E/) {
        print "Domain SSH key not found in $ak, skipping.\n";
        return;
    }

    print "Removing domain SSH key from $ak\n";
    return if $dryrun;

    my @before = split("\n", $contents);
    my @after  = grep { $_ !~ m/\Q$pubkey\E/ } @before;
    die "Removing the key for $domain from $ak would drop "
      . (scalar(@before) - scalar(@after)) . " lines, not 1; refusing\n"
      unless scalar(@after) == scalar(@before) - 1;

    $hv->write_text($ak, join("\n", @after) . "\n");
    return;
}

sub purge_domain_dir {
    my ($domain, $dryrun) = @_;

    my $hv  = Trog::HV->new();
    my $dir = $hv->domain_dir . "/$domain";
    unless (-d $dir) {
        print "Domain directory $dir not found, skipping.\n";
        return;
    }

    print "Purging domain directory $dir\n";
    unless ($dryrun) {
        File::Path::remove_tree($dir);
        # A remote HV holds a copy of the whole domain dir for the guest to pull.
        $hv->run(qw{rm -rf}, $dir) unless $hv->is_local;
    }
    return;
}

exit main(@ARGV) unless caller;

1;
