#!/usr/bin/env perl

package Trog::Bin::Destroy;

use strict;
use warnings;

use Cwd qw{abs_path};
use FindBin;
use lib "$FindBin::Bin/../lib";
use Config::Simple();
use Trog::HV();
use File::Slurper();
use List::Util qw{any};
use File::Which qw{which};
use Getopt::Long qw{GetOptionsFromArray};

our $domain_dir;

# The hypervisor we're destroying on.  Defaults to this machine.
our $hv;

# Where terraform's config + state live on this machine.
our $tf_dir;

sub hv {
    $hv //= Trog::HV->new();
    return $hv;
}

sub tf_dir {
    my $dir = $tf_dir;
    $dir //= hv()->uri eq $Trog::HV::DEFAULT_URI ? '/opt/terraform' : '/opt/terraform/hv/' . hv()->slug;
    return $dir;
}

sub usage {
    return "Usage: destroy [--domaindir DIR] [--connect URI] [--tfdir DIR] [--purge] [--dryrun] DOMAIN\n";
}

sub main {
    my @args = @_;

    umask 0022;

    my ($purge, $dryrun, $uri, $hv_ssh_host, $hv_ssh_user, $hv_ssh_port);
    GetOptionsFromArray(\@args,
        'domaindir=s'   => \$domain_dir,
        'purge'         => \$purge,
        'dryrun'        => \$dryrun,
        'connect=s'     => \$uri,
        'hv-ssh-host=s' => \$hv_ssh_host,
        'hv-ssh-user=s' => \$hv_ssh_user,
        'hv-ssh-port=i' => \$hv_ssh_port,
        'tfdir=s'       => \$tf_dir,
    );

    my $domain = shift @args;
    die usage() unless $domain;

    $hv = Trog::HV->new(
        uri      => $uri,
        ssh_host => $hv_ssh_host,
        ssh_user => $hv_ssh_user,
        ssh_port => $hv_ssh_port,
    );
    print "Destroying on hypervisor " . $hv->uri . "\n" unless $hv->is_local;

    $domain_dir //= '/opt/domains';
    $domain =~ s/\///g;

    my $domain_mongled = $domain;
    $domain_mongled =~ s/\./-/g;

    print "Destroying domain: $domain\n";
    print "[DRY RUN] No changes will be made.\n" if $dryrun;

    # 1. Stop and undefine the VM via virsh
    destroy_vm($domain, $dryrun);

    # 2. Remove terraform-managed resources for this domain
    destroy_tf_resources($domain, $domain_mongled, $dryrun);

    # 3. Remove HV-side terraform config files
    remove_tf_configs($domain, $dryrun);

    # 4. Remove HV-side rsyslog config
    remove_rsyslog_config($domain, $dryrun);

    # 5. Remove the domain's SSH pubkey from the HV's authorized_keys
    remove_authorized_key($domain, $dryrun);

    # 6. Optionally purge the domain directory
    if ($purge) {
        purge_domain_dir($domain, $dryrun);
    } else {
        print "Domain directory $domain_dir/$domain preserved (use --purge to remove it)\n";
    }

    print "Done.\n";
    return 0;
}

sub destroy_vm {
    my ($domain, $dryrun) = @_;

    my $vm_list = hv()->virsh_pipe([qw{list --all}], '2>/dev/null');
    if ($vm_list =~ m/\Q$domain\E/) {
        print "Stopping VM $domain...\n";
        unless ($dryrun) {
            hv()->virsh_system('destroy', $domain);
            hv()->virsh_system('undefine', '--nvram', $domain);
        }
    } else {
        print "VM $domain not found in virsh, skipping.\n";
    }
}

sub destroy_tf_resources {
    my ($domain, $domain_mongled, $dryrun) = @_;

    my $tf_config_dir = tf_dir() . '/config';
    return unless -d $tf_config_dir;

    chdir $tf_config_dir or do {
        warn "Cannot chdir to $tf_config_dir: $!\n";
        return;
    };

    my $resources = qx{terraform state list 2>/dev/null};
    chomp $resources;
    return unless $resources;

    my @exempt = qw{libvirt_volume.image_base libvirt_pool.tf_disks};
    foreach my $resource (split(/\n/, $resources)) {
        next unless $resource =~ m/\Q$domain_mongled\E/;
        next if any { $_ eq $resource } @exempt;
        print "Destroying terraform resource $resource\n";
        unless ($dryrun) {
            system(qw{terraform destroy -auto-approve -target}, $resource);
        }
    }
}

sub remove_tf_configs {
    my ($domain, $dryrun) = @_;

    my $cfgdir = tf_dir() . '/config';
    my @patterns = (
        "$cfgdir/$domain.tf",
        "$cfgdir/$domain.cloud_init.cfg",
        "$cfgdir/$domain.network_config.cfg",
    );

    foreach my $f (@patterns) {
        if (-f $f) {
            print "Removing $f\n";
            unlink $f unless $dryrun;
        }
    }
}

sub remove_rsyslog_config {
    my ($domain, $dryrun) = @_;

    my $conf = "/etc/rsyslog.d/10-$domain.conf";
    if (hv()->file_exists_hv($conf)) {
        print "Removing rsyslog config $conf\n";
        unless ($dryrun) {
            hv()->is_local ? unlink($conf) : hv()->system_hv('sudo', 'rm', '-f', $conf);
            hv()->system_hv(qw{sudo systemctl restart rsyslog});
        }
    } else {
        print "No rsyslog config found at $conf, skipping.\n";
    }
}

sub remove_authorized_key {
    my ($domain, $dryrun) = @_;

    my $pubkey_file = "$domain_dir/$domain/key.rsa.pub";
    return unless -f $pubkey_file;

    my $pubkey = File::Slurper::read_text($pubkey_file);
    chomp $pubkey;

    my $ak = hv_authorized_keys();
    return unless hv()->file_exists_hv($ak);

    my $contents = hv()->read_text_hv($ak);
    if ($contents =~ m/\Q$pubkey\E/) {
        print "Removing domain SSH key from $ak\n";
        unless ($dryrun) {
            my @lines = grep { $_ !~ m/\Q$pubkey\E/ } split(/\n/, $contents);
            hv()->write_text_hv($ak, join("\n", @lines) . "\n");
        }
    } else {
        print "Domain SSH key not found in $ak, skipping.\n";
    }
}

sub hv_authorized_keys {
    return "$ENV{HOME}/.ssh/authorized_keys" if hv()->is_local;
    my $home = hv()->qx_hv('echo $HOME');
    chomp $home if defined $home;
    die "Could not determine the home directory of the transfer user on the hypervisor"
      unless defined $home && length $home;
    return "$home/.ssh/authorized_keys";
}

sub purge_domain_dir {
    my ($domain, $dryrun) = @_;

    my $dir = "$domain_dir/$domain";
    unless (-d $dir) {
        print "Domain directory $dir not found, skipping.\n";
        return;
    }

    print "Purging domain directory $dir\n";
    unless ($dryrun) {
        system('rm', '-rf', $dir);
        # A remote HV holds a copy of the payload for the guest to pull.
        hv()->system_hv('rm', '-rf', $dir) unless hv()->is_local;
    }
}

exit main(@ARGV) unless caller;

1;
