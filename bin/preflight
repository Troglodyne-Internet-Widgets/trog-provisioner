#!/usr/bin/env perl

package Trog::Bin::Preflight;

#ABSTRACT: Say whether a throwaway guest can be built at all, before any time is spent trying.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Trog::HV();
use Trog::Local();
use Trog::Config();
use Trog::Hypervisors();
use IO::Prompter();

=head1 NAME

preflight - say whether a throwaway guest can be built, before any time is spent trying

=head1 SYNOPSIS

    bin/preflight
    bin/preflight --connect qemu+ssh://root@hv/system

=head1 DESCRIPTION

Provisioning a guest takes minutes and touches a hypervisor.  Every check here
is one that, if it fails, fails the whole run -- so they all happen up front,
all of them run even after the first failure, and each one that fails says what
to do about it.

Worth running against a hypervisor you have not built on before, or after
changing anything about how you reach one.  The failures it catches are the ones
that otherwise surface minutes in, as something that reads like an unrelated
problem: a sudo prompt that hangs the run rather than failing it, a Sys::Virt
that is a release out of step and so is missing a constant.

Exits 0 when a run is worth starting and 1 when it is not.

=head1 OPTIONS

=over 4

=item B<--connect> URI

Check this hypervisor rather than whichever the fleet would pick.

=item B<--hvconf> FILE

The fleet definition.  Defaults to the one under L<Trog::Config>.

=back

=cut

sub main {
    my @args = @_;

    my ( $uri, $hvconf, $help );
    GetOptionsFromArray(
        \@args,
        'connect=s' => \$uri,
        'hvconf=s'  => \$hvconf,
        'help'      => \$help,
    );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    my $hv = hypervisor( $uri, $hvconf );
    return 1 unless $hv;

    print "Hypervisor: " . $hv->uri . "\n\n";

    # Every check runs even once one has failed: being told about the sudo and
    # then, a fix later, about the missing xorriso is two round trips where one
    # would do.
    #
    # Which questions are worth asking is the backend's to say -- see
    # Trog::HV's PREFLIGHT section -- so this walks the list it gives rather
    # than deciding from what kind of hypervisor it is.
    my @failed = grep { !$_->{ok} } map { report( %{ $hv->$_ } ) } $hv->preflight_checks;

    my @notes = grep { !$_->{ok} } map { $hv->$_ } $hv->preflight_notes;

    if (@notes) {
        print "\nNot required, but worth having:\n\n";
        foreach my $note (@notes) {
            print "  * $note->{what}\n" . join( q{}, map { "    $_\n" } split( m/\n/, $note->{fix} ) ) . "\n";
        }
    }

    return 0 unless @failed;

    print "\n" . scalar(@failed) . " thing" . ( @failed == 1 ? '' : 's' ) . " to fix first:\n\n";
    foreach my $failure (@failed) {
        print "  * $failure->{what}\n" . join( q{}, map { "    $_\n" } split( m/\n/, $failure->{fix} ) ) . "\n";
    }

    seed_admin_keys();
    return 1;
}

# Offer to fill in admin_authorized_keys from an online identity, when that is
# what is missing and there is somebody there to ask.  ssh-import-id is what
# fetches them, which is the same thing cloud-init used to do on every guest at
# first boot -- done once here instead, against a file every guest is built from.
#
# Only ever at a terminal.  bin/preflight is run unattended by the provisioning
# workflow, where a question has nowhere to be answered from, and a check that
# blocks is worse than one that reports.
sub seed_admin_keys {
    my $path = Trog::Config->path('admin_authorized_keys');
    return 0 if -e $path;

    return 0 unless interactive();

    # IO::Prompter reads from *ARGV, which here holds this program's own
    # arguments and sends it off to open a file named after one.  Flattening it
    # leaves nothing there to open; see Trog::Credentials, which does the same.
    local *ARGV = join ' ', @ARGV;

    # The two ssh-import-id answers to, as a hash rather than a match: what the
    # answer has to be one of is the thing worth writing down.
    my %offered = map { $_ => 1 } qw{gh lp};

    my $service = IO::Prompter::prompt('Seed it now? Which service [gh, lp, or empty to skip]:');
    my $at      = "$service";
    return 0 unless $offered{$at};

    my $who = IO::Prompter::prompt('Whose keys, as that service spells the name:');
    return 0 unless length "$who";

    my @cmd = ( 'ssh-import-id', '-o', $path, "$at:$who" );
    print 'Running ' . join( ' ', @cmd ) . "\n";

    # Through the machine we are running on rather than a bare system(): it is
    # how everything else here runs a command, and it is the half of this a test
    # can stand in for.
    return Trog::Local->new()->run_cmd(@cmd) == 0 ? 1 : 0;
}

# Whether there is anybody there to answer a question.  Its own sub because a
# filetest on a real handle is not something a test can stand in for, and both
# answers are worth covering.
sub interactive {
    ## no critic (InputOutput::ProhibitInteractiveTest) -- whether there is anybody to ask is exactly what this decides
    return ( -t *STDIN && -t *STDOUT ) ? 1 : 0;
}

sub hypervisor {
    my ( $uri, $hvconf ) = @_;

    my $hv = eval {
        return Trog::HV->new( uri => $uri ) if $uri;

        my $fleet = Trog::Hypervisors->load( $hvconf // Trog::Hypervisors->default_path() );
        return Trog::HV->new() unless $fleet->configured;

        my ($name) = $fleet->names();
        return $fleet->hypervisor($name);
    };

    print "Could not work out which hypervisor to use: $@" unless $hv;
    return $hv;
}

# The backends work out the verdict; this says it out loud as each arrives, so a
# run reads as it goes rather than in one burst at the end.
sub report {
    my (%verdict) = @_;
    printf "%s %s\n", ( $verdict{ok} ? '  ok  ' : 'FAILED' ), ( $verdict{what} // q{} );
    return \%verdict;
}

exit main(@ARGV) unless caller;

1;
