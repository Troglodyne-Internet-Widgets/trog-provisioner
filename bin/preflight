#!/usr/bin/env perl

package Trog::Bin::Preflight;

#ABSTRACT: Say whether a throwaway guest can be built at all, before any time is spent trying.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Trog::HV();
use Trog::Local();
use Trog::Config();
use Trog::Credentials();
use Trog::Hypervisors();
use Trog::Utils();

=head1 NAME

preflight - say whether a throwaway guest can be built, before any time is spent trying

=head1 SYNOPSIS

    bin/preflight
    bin/preflight --hypervisor hv1

=head1 DESCRIPTION

To provision a guest takes minutes and uses a hypervisor.  If one of these
checks fails, the whole run fails.  So this program does all of them before the
run.  It does every check, also after one fails, and each failure says what to
do.

Run it against a hypervisor that you did not build on before.  Also run it after
you change how you connect to a hypervisor.  Without it, these failures occur
minutes into a run and look like a different problem.  Two examples are a sudo
prompt that stops the run and does not fail it, and a Sys::Virt of a different
release that does not have a constant.

It checks one hypervisor in full, and every other block in F<hypervisors.conf>
for the two faults a block can have on its own: naming no kind of hypervisor, or
naming a kind whose API client is not installed here.  Each backend loads its
client only when a hypervisor of that kind is built, so an installation installs
the clients of the kinds it has.

Exits 0 when a run is worth starting and 1 when it is not.

=head1 OPTIONS

=over 4

=item B<--hypervisor> NAME

Check the hypervisor that F<hypervisors.conf> calls NAME, instead of the one
the fleet picks.  It dies when the file does not name it, and says which names
it has.

=item B<--credentials>

Reads the passwords that the checks need from standard input before they run,
and does not ask for them.  A check that asks a cloud needs the passphrase of
the secret store when the cloud's credential is kept there, as a Linode token
is.  See L<Trog::Credentials> for the format.

=item B<--hvconf> FILE

The fleet definition.  The default is the one in the configuration directory
of L<Trog::Config>.

=back

=cut

sub main {
    my @args = @_;

    my ( $hv_name, $hvconf, $credentials, $help );
    GetOptionsFromArray(
        \@args,
        'hypervisor=s' => \$hv_name,
        'hvconf=s'     => \$hvconf,
        'credentials'  => \$credentials,
        'help'         => \$help,
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    # Before anything asks for a password, and only with --credentials.  See
    # Trog::Credentials for why it has to be asked for.
    Trog::Credentials->load() if $credentials;

    my $fleet = Trog::Hypervisors->load( $hvconf // Trog::Hypervisors->default_path() );
    my $hv    = hypervisor( $fleet, $hv_name );
    return 1 unless $hv;

    print "Hypervisor: " . $hv->uri . "\n\n";

    # Every check runs, also after one fails, so one run reports all the fixes.
    # The backend lists the checks.  See the PREFLIGHT section of Trog::HV.
    my @failed = grep { !$_->{ok} } map { report( %{ $hv->$_ } ) } $hv->preflight_checks;

    push( @failed, rest_of_fleet( $fleet, $hv ) );

    my @notes = grep { !$_->{ok} } map { $hv->$_ } $hv->preflight_notes;

    if (@notes) {
        print "\nNot required, but worth having:\n\n";
        foreach my $note (@notes) {
            print "  * $note->{what}\n" . join( q{}, map { "    $_\n" } split( m/\n/, $note->{fix} ) ) . "\n";
        }
    }

    return 0 unless @failed;

    print "\n" . scalar(@failed) . " thing" . ( @failed == 1 ? '' : 's' ) . " to fix first:\n\n";
    foreach my $failure (@failed) {
        print "  * $failure->{what}\n" . join( q{}, map { "    $_\n" } split( m/\n/, $failure->{fix} ) ) . "\n";
    }

    seed_admin_keys();
    return 1;
}

=head2 $seeded = seed_admin_keys()

If F<admin_authorized_keys> is missing or empty, this offers to fill it in with
ssh-import-id.  It asks for a service (C<gh> or C<lp>) and a name on that
service.  Every guest gets its admin keys from this file.

It asks only at a terminal.  The provisioning workflow runs bin/preflight with
nobody to answer, and a question there stops the run.

Returns 1 if ssh-import-id succeeded, and 0 in all other cases.

=cut

sub seed_admin_keys {
    my $path = Trog::Config->path('admin_authorized_keys');
    return 0 if -s $path;

    return 0 unless Trog::Local->interactive;

    # The services that ssh-import-id accepts.
    my %offered = map { $_ => 1 } qw{gh lp};

    my $service = Trog::Utils::prompt('Seed it now? Which service [gh, lp, or empty to skip]:');
    my $at      = "$service";
    return 0 unless $offered{$at};

    my $who = Trog::Utils::prompt('Whose keys, as that service spells the name:');
    return 0 unless "$who";

    my @cmd = ( 'ssh-import-id', '-o', $path, "$at:$who" );
    print 'Running ' . join( ' ', @cmd ) . "\n";

    # Trog::Local and not system(), so a test can replace it.
    return Trog::Local->new()->run_cmd(@cmd) == 0 ? 1 : 0;
}

sub hypervisor {
    my ( $fleet, $hv_name ) = @_;

    my $hv = eval {

        # A name is answered from the fleet, and the lack of one is this
        # machine.  A name with no fleet to look it up in is neither.
        die "No hypervisors are configured in " . $fleet->{path} . ", so there is no '$hv_name' to check.\n"
          if defined $hv_name && !$fleet->configured;

        return Trog::HV->new() unless $fleet->configured;
        return $fleet->hypervisor( $hv_name // ( $fleet->names )[0] );
    };

    print "Could not work out which hypervisor to use: $@" unless $hv;
    return $hv;
}

=head2 @failed = rest_of_fleet($fleet, $checked)

Reports every other block in F<hypervisors.conf>: what it builds through, and
whether that client is installed.  Prints each answer as it arrives and returns
the failures, as the checks above do.

Those checks are of one hypervisor, because a run builds on one.  This is about
the file.  A block that names two kinds of hypervisor, a block that names none,
and a block whose client nobody installed are all faults that otherwise show
when something reaches that block, which is a run that has already started.

=cut

sub rest_of_fleet {
    my ( $fleet, $checked ) = @_;

    my @others = grep { $_ ne ( $checked->{name} // q{} ) } $fleet->names;
    return () unless @others;

    print "\nThe rest of the fleet:\n\n";
    return grep { !$_->{ok} } map { report(%$_) } map { block_verdicts( $fleet, $_ ) } @others;
}

=head2 @verdicts = block_verdicts($fleet, $name)

Returns what can be said about one block, each verdict as C<[name] what>: what
kind of hypervisor it is, and then the checks it answers about itself, which
L<Trog::HV/@names = $hv-E<gt>preflight_block_checks()> lists.

None of those asks a hypervisor for anything or reads its credential, so a
preflight of one machine does not authenticate to every cloud in the fleet, and
does not open the secret store for a token.  A block of a kind whose client is
not installed here is still reported.

=cut

sub block_verdicts {
    my ( $fleet, $name ) = @_;

    return { ok => 0, what => "[$name] does not say what to build on", fix => $@ }
      unless eval { $fleet->backend_of($name); 1 };

    my $hv = eval { $fleet->hypervisor($name) }
      or return { ok => 0, what => "[$name] cannot be built from its block", fix => $@ };

    return map {
        my $verdict = $hv->$_;
        +{ %$verdict, what => "[$name] " . $verdict->{what} };
    } $hv->preflight_block_checks;
}

=head2 \%verdict = report(%verdict)

Prints one line for a check as its result arrives, not all of them at the end.
C<%verdict> has C<ok> and C<what>.  Returns C<%verdict> as a hash reference.

=cut

sub report {
    my (%verdict) = @_;
    printf "%s %s\n", ( $verdict{ok} ? '  ok  ' : 'FAILED' ), ( $verdict{what} // q{} );
    return \%verdict;
}

exit main(@ARGV) unless caller;

1;
