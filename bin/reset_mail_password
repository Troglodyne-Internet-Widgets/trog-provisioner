#!/usr/bin/env perl

package Provisioner::Bin::reset_mail_password;

#ABSTRACT: Give a mail account of a running guest a new password.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use Provisioner::MailAccount();
use Trog::Config();
use Trog::Credentials();

=head1 USAGE

    reset_mail_password [--credentials] [--stdin] [--kick] [--secrets FILE] DOMAIN NAME

Gives C<NAME@DOMAIN> a new password on the guest of C<DOMAIN>, while the guest
runs, and in the secret store, so that a rebuild keeps it.

=head1 DESCRIPTION

In order, it:

=over 4

=item 1. Refuses an account that is not in C<mail.names>, or one whose password
the configuration does not keep as a C<secret:> reference.  Nothing has changed
at that point.

=item 2. Asks for the new password, two times, with no echo.

=item 3. Replaces the value in the secret store, as C<bin/add_secret --overwrite>
does.  The reference in the configuration does not change.

=item 4. Replaces the hash in the line of that account in F</mail/DOMAIN/passwd>
on the guest, and leaves every other byte of the file as it was.  It writes a
temporary file and renames it, so dovecot never reads half a file.

=back

A session that is open keeps working with the old password until it ends.  To
end it, give C<--kick>.

=head2 OPTIONS

=over 4

=item C<--kick>

End the open sessions of the account with C<doveadm kick>, so that a client
with the old password must log in again.  An account with no session is not an
error.

=item C<--credentials>, C<--stdin>, C<--secrets FILE>

As for C<bin/add_mail_user>.

=back

=head1 SUBROUTINES

=head2 $rc = main(@args)

Resets the password.  Returns 0, or 2 for a usage error.  Dies with the reason
if it refuses.

=cut

sub main {
    my @args = @_;

    my ( $kick, $store, $credentials, $stdin, $help );
    GetOptionsFromArray(
        \@args,
        'kick'        => \$kick,
        'secrets=s'   => \$store,
        'credentials' => \$credentials,
        'stdin'       => \$stdin,
        'help'        => \$help,
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Need a domain and a name' ) unless @args == 2;

    my ( $domain, $name ) = @args;

    Trog::Credentials->load() if $credentials;

    # Refuse before asking for a password, so that a typing error in the name
    # does not cost two answers.
    my $address = Provisioner::MailAccount::address( $domain, $name );
    die "$address is not in mail.names of $domain, so there is no account to reset.\n" unless exists Provisioner::MailAccount::configured_accounts($domain)->{$name};

    my $password = Provisioner::MailAccount::ask_password( $address, stdin => $stdin );

    my $outcome = Provisioner::MailAccount::reset_password(
        domain   => $domain,
        name     => $name,
        password => $password,
        kick     => $kick,
        secrets  => $store // Trog::Config->path('secrets.kdbx'),
    );

    print "Reset the password of $address\n" . ( $outcome eq 'no session' ? "No session of $address was open.\n" : q{} );
    return 0;
}

exit main(@ARGV) unless caller;

1;
