#!/usr/bin/env perl

package Trog::Bin::Recipes;

#ABSTRACT: List the recipes, or show what one recipe takes.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Cpanel::JSON::XS();
use Getopt::Long qw{GetOptionsFromArray};
use List::Util   qw{max};
use Pod::Usage   qw{pod2usage};

use Provisioner::Cookbook();

=head1 NAME

recipes - list the recipes, or show what one recipe takes

=head1 SYNOPSIS

    bin/recipes                 # each recipe and what it does
    bin/recipes --json          # the same list, as JSON
    bin/recipes mariadb         # what mariadb takes, as JSON

=head1 OPTIONS

=over 4

=item B<--json>

Print the list as JSON, not as a table.  The schema of one recipe is always
JSON.

=item B<--scaffold>

Print the configuration that F<bin/new_guest> writes for this recipe, not the
schema.  A field gets its default if the recipe has one, and C<CHANGEME> if it
does not.

=item B<--all>

With C<--scaffold>, also include the optional fields.

=back

=head1 DESCRIPTION

Each recipe declares what it accepts in C<args()>.  This is an OpenAPIv3 object
schema, and the provisioner validates the configuration of a domain against it.
This command prints the schema.  You can then learn what to write in
F<recipes.d/> without reading the recipe.

=cut

sub main {
    my @args = @_;

    my ( $json, $scaffold, $all, $help );
    GetOptionsFromArray(
        \@args,
        'json'     => \$json,
        'scaffold' => \$scaffold,
        'all'      => \$all,
        'help'     => \$help,
    );

    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    my $encoder = Cpanel::JSON::XS->new->pretty->canonical;

    my $name = shift @args;
    return list( $encoder, $json ) unless defined $name;

    pod2usage(
        -exitval => 2, -verbose => 1, -input => __FILE__,
        -message => 'One recipe at a time'
    ) if @args;

    # The Cookbook dies with the recipe name and points at the list, so do not
    # require the recipe here.
    my $spec = describe( $name, $scaffold, $all );
    print $encoder->encode($spec);
    return 0;
}

=head2 describe($name, $scaffold, $all)

Returns a hashref to print for the recipe C<$name>.  This is its schema, with
the hosts it downloads from under C<x-fetch-hosts>.  If C<$scaffold> is true,
it is the configuration that C<--scaffold> describes instead, and C<$all> adds
the optional fields.  Dies if there is no recipe called C<$name>.

=cut

sub describe {
    my ( $name, $scaffold, $all ) = @_;

    if ($scaffold) {
        my ( $config, @todo ) = Provisioner::Cookbook->scaffold( $name, all => $all );
        return {
            recipe        => $name,
            configuration => { $name => $config },
            needs_filling => \@todo,
        };
    }

    my $class = Provisioner::Cookbook->load($name);
    my %spec  = Provisioner::Cookbook->spec($name);

    # A guest points these hosts at the fetch cache while it provisions.  The
    # x- prefix is how OpenAPI marks a key that is not schema.
    #
    # The guest does this in /etc/hosts, not with a recipe that manages the
    # file.  scripts/fetch_via_cache adds the entries before the makefile and
    # removes them after it, so no state remains for a recipe to own.
    my @hosts = $class->fetch_hosts;
    $spec{'x-fetch-hosts'} = \@hosts if @hosts;

    return \%spec;
}

=head2 list($encoder, $json)

Prints each recipe name with its abstract, as a table, or as JSON through
C<$encoder> if C<$json> is true.  Returns 0.

=cut

sub list {
    my ( $encoder, $json ) = @_;

    my @names = Provisioner::Cookbook->names();

    if ($json) {
        print $encoder->encode( [ map { { name => $_, abstract => Provisioner::Cookbook->abstract($_) } } @names ] );
        return 0;
    }

    my $width = max( map { length } @names );
    foreach my $name (@names) {
        printf "%-*s  %s\n", $width, $name, Provisioner::Cookbook->abstract($name) // '';
    }
    return 0;
}

exit main(@ARGV) unless caller;

1;
