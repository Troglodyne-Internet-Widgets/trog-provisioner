# This supplies mirror_only.  With it, the testdeps line of the makefile asks
# cpanm for a release in the same way as scripts/cpan_install.  The require
# does not run the script.
require( Cwd::abs_path( File::Basename::dirname(__FILE__) . '/../scripts/cpan_install' ) );

=head1 USAGE

    new_config [--secrets=file] [--recipes=file] [--hvconf=file] [--hypervisor=name] [--domaindir=dir] [--skip_ssh] [--credentials] [--dryrun] $domain $domain2 ...

new_config makes a configuration package for each domain that you name.
F<bin/provision> uses the package to build the virtual machine (the guest) and
provision it.

These files control what each domain gets:

    /etc/trog-provisioner/recipes.yaml
    /etc/trog-provisioner/recipes.d/*.yaml

The files describe your installation, not this software, so they are not in the
checkout.  To use a different set, set C<TROG_PROVISIONER_CONFIG> to the
directory that holds them.  To name one file at a time, use the --recipes
option.  See L<Trog::Config>.

What the guests of an installation share -- who administers them, how they
reach the network, where their addresses come from -- is the C<_global> of
C<_base> in F<recipes.yaml>, and a domain overrides one in its own C<_global>.
L<Provisioner::Cookbook/global_schema> declares them.  An installation that
still has the older F<ipmap.cfg> moves them across with
F<bin/ipmap_to_globals>.

The --hvconf option names the fleet definition that chooses the hypervisor of a
new guest.  The default is F</etc/trog-provisioner/hypervisors.conf>.  See
L<Trog::Hypervisors>.

The --hypervisor option names one hypervisor in the fleet definition, and the
search is not done.  The --domaindir option names the directory that the configuration
of each domain goes in, instead of the one that the hypervisor names.
F<bin/provision> passes both when it gets them.

Most of what you put in the main recipes.yaml goes in the _base section:

    _base:
        registrar:
            type: "some_dns_provider_understood_by_dns-lexicon"
            user: "AzureDiamond"
            key: "hunter2"
        _global:
            libdir:
                - path/to/my/custom/libdir
            data_source: "/opt/data"
            install_dir: "/opt/domains"
        adminconfig:
            pkgs:
                - vim
                - tig
                - tmux
                - plocate
                - traceroute
            skel: "/opt/dotfiles/my_dude"
        nosnap:
        nostubresolver:
        auditd:
        ufw:
        fail2ban:
        cron:
        letsencrypt:
        ...

The _base section configures what all your guests need.  You can name any
number of recipes in it, so that the files in recipes.d/ do not repeat them.
The _global section holds the most important values, because more than one
recipe uses them.  You do not have to know all of them now.  If a recipe does
not get a value that it needs, it stops with an error.

If you have recipes of your own, for example proprietary ones, list their
directories in the libdir key of _global.  The value is a list.  Each directory
must hold a lib/ directory and a templates/ directory, with the same layout as
this checkout.  Its recipes are found after the ones in the checkout, and a
recipe there with the name of one here is never loaded.  Its templates/ is
searched after the templates in the checkout.

To put more than one domain on one guest, list them in the top-level _shared
section of recipes.yaml:

    _shared:
        shared.host.name:
            - guy.hosted.here
            - otherguy.hosted.here
        ...

In this example, run C<bin/new_config guy.hosted.here>.  It also writes the
configuration for shared.host.name, because guy.hosted.here is built onto that
host.  Then run C<bin/provision guy.hosted.here>.  It provisions
shared.host.name first, and then adds guy.hosted.here to the same guest.  Run
the same two commands for otherguy.hosted.here.

new_config ignores the _base and _shared sections in recipes.d/*.yaml.  This
prevents configuration merges that are hard to diagnose.

=head2 DRY RUNS

With C<--dryrun>, this program changes one thing only.  It leaves the private
key of the guest on the disk where it found it, and does not seal the key.  To
seal a key is to move its private half into the secret store and remove it from
the disk.  The program still writes all its other files, and the domain keeps
the same key.

This flag is narrower than the C<--dryrun> of F<bin/provision>, which is the
flag that an operator passes.  The difference is intentional.  This program
writes configuration and does not destroy anything.  So a dry run has little to
protect, except the key that opens a guest that is up now.

=head2 IP POOL

The IP pool is the set of static addresses that new guests can get.  To use one,
add an C<ip_pool> to the C<_global> of C<_base>:

    _base:
      _global:
        ip_pool:
          # Every address of the static pool.
          addresses: [192.0.2.10, 192.0.2.11, 192.0.2.12]

          # Or a CIDR block to expand.  Both keys may appear, and the
          # addresses are merged.
          cidr: 192.0.2.0/24

new_config gives each domain an address from the pool, and records it in the
address database of L<Provisioner::IPPool>.  A domain keeps its address when you
provision it again.  If the hypervisor gives its guests their addresses,
new_config does not use the pool.

To see which addresses are assigned and which are free, run
C<bin/list_ip_pool>:

    bin/list_ip_pool [--recipes=/etc/trog-provisioner/recipes.yaml]

The output shows the full pool, the guest that holds each assigned address, and
the addresses that are still free.

=head2 TESTS

Each recipe can name tests that run on the guest after provisioning.  Use them
for behavior that a makefile failure does not catch, or for results that you
want to report somewhere else.  See the tests() and testdeps() methods in
L<Provisioner::Recipe>.

=head2 SECRETS

You can keep a value out of the recipe configuration and store it in a KeePass
(kdbx) database.  By default, new_config reads
F</etc/trog-provisioner/secrets.kdbx>.  To use a different file, use the
--secrets option.

If the configuration uses a secret, new_config asks you for the password of the
database.  To supply the password without a terminal, use the --credentials
option.  See L<Trog::Credentials>.

An example of a secret in a recipe configuration:

    _base:
        registrar:
            type: "some_dns_provider_understood_by_dns-lexicon"
            user: "AzureDiamond"
            key: "secret:Hosting/DNS/password"

The parts of the path after C<secret:> are, in order, a group, an entry and a
field in the KDBX database.

=cut

our ( $sfile, $pfile, $hvconf, $hv_name, $domaindir, $skip_ssh, $dryrun );

sub get_recipe_config {
    return Provisioner::Cookbook->configuration($pfile);
}

sub expand_dependent_domains {
    my $d    = shift;
    my $host = Provisioner::Cookbook->host_of( $d, get_recipe_config() );
    return $d unless defined $host;

    print "Expanding list of configs to generate to include $host\n";
    return ( $host, $d );
}

our %SALVAGE_GAPS;

# The recipes that each domain runs, so that a tenant can be compared with its
# host.  expand_dependent_domains puts the host first, so the host is here
# before its tenants are generated.
our %MACHINE_MODULES;

# The ports that the domains of each guest so far claim, keyed by the guest's
# own domain, in the form of ufw's listeners.  See handle_domain.
our %MACHINE_LISTENERS;

=head2 %gaps = salvage_gaps()

Returns the salvages of the last C<main> that got nothing from a guest that
still has state.  To salvage is to copy the state of a service off a guest
before it is rebuilt.  The hash is keyed by domain, and each value is an array
reference of the alarming gaps that C<_salvage_gap> returned.  The hash is empty when there is nothing
to report.

C<main> gives a warning and exits 0 in this case.  F<bin/provision> calls this
before it destroys the guest, and refuses: see C<refuse_on_salvage_gaps> there
for why the refusal is its job.

A path that is not on the guest at all is not a gap.  Every first build of a
recipe looks like that.

=cut

sub salvage_gaps { return %SALVAGE_GAPS }

sub main {
    my @args = @_;

    # Clear the gaps and the hypervisor options of the last run, because a
    # process can call main() more than once.
    %SALVAGE_GAPS = ();
    undef $_ for $hvconf, $hv_name, $domaindir;

    my $credentials;
    GetOptionsFromArray(
        \@args,
        'secrets=s'    => \$sfile,
        'recipes=s'    => \$pfile,
        'hvconf=s'     => \$hvconf,
        'hypervisor=s' => \$hv_name,
        'domaindir=s'  => \$domaindir,
        'skip_ssh'     => \$skip_ssh,
        'credentials'  => \$credentials,
        'dryrun'       => \$dryrun,
    );

    # The password of the secrets database, for a run with no terminal.  See
    # Trog::Credentials.
    Trog::Credentials->load() if $credentials;
    $skip_ssh //= 0;
    $sfile    //= Trog::Config->path('secrets.kdbx');
    $pfile    //= Trog::Config->path('recipes.yaml');

    @args = uniq map { expand_dependent_domains($_) } @args;

    foreach my $d (@args) {
        my $res = handle_domain($d);
        return $res if $res;
    }
    return 0;
}

=head2 apply_global_defaults($distro, $global_config)

Puts the defaults of the distribution under what C<$global_config> says, in
place, and returns C<$global_config>.  This is done here, because _global
reaches every recipe without validation.  See
L<Provisioner::DistroRecipe/global_defaults>.

=cut

sub apply_global_defaults {
    my ( $distro, $global_config ) = @_;

    %$global_config = ( $distro->global_defaults, %$global_config );

    return $global_config;
}

=head2 @keys = hv_settings()

Returns the sorted keys that tell the hypervisor how to build the guest.  They
go in provision.conf, not in a template.  They come from the schema of the
C<vm> recipe, which C<bin/recipes vm> prints.

=cut

sub hv_settings {
    my $props = Provisioner::Cookbook->properties( { Provisioner::Cookbook->spec('vm') } );

    # Not the readOnly keys, such as the volume and the MAC, because the
    # hypervisor sets those itself.
    my @settings = sort grep { !$props->{$_}{readOnly} } keys %$props;
    return @settings;
}

=head2 $lines = hv_lines($global_config, $written)

Returns the C<hv_settings> lines for F<provision.conf>, one C<key=value> each,
each starting with a newline.  It takes only the keys that C<$global_config>
sets and that C<$written> does not name.  None of them gets a default here: an
absent key lets F<bin/provision> decide.

An empty value counts as absent, because Config::Simple reads a bare C<key=> as
an empty string.  A value of 0 is written: C<disk_iothreads=0> turns iothreads
off.

=cut

sub hv_lines {
    my ( $global_config, $written ) = @_;

    ## no critic (ValuesAndExpressions::ProhibitDefinedBeforeLength) -- a setting of "0" is still a setting
    my @keys = grep { !$written->{$_} && length $global_config->{$_} } hv_settings();
    ## use critic

    return join( q{}, map { "\n$_=$global_config->{$_}" } @keys );
}

=head2 $lines = placement_lines($hv, $global_config)

Returns the F<provision.conf> lines that say where this guest goes and what it
is there: the hypervisor it was placed on, and the size it names for that kind
of hypervisor, such as C<linode_type>.  An empty string for a hypervisor that
is not in F<hypervisors.conf> and sizes its guests from C<memory>, C<cpus> and
C<size>.

What this writes depends on where the guest goes: a cloud gives it no address
from the pool, and a hypervisor can name its own C<transfer_ip>.  So
F<bin/provision> must build it where it was placed here, and not place it
again, which can choose another hypervisor that the configuration does not
fit.

=cut

sub placement_lines {
    my ( $hv, $global_config ) = @_;

    my @lines;
    push @lines, 'hypervisor=' . $hv->name if defined $hv->name;

    my $key = $hv->size_key;
    push @lines, "$key=" . $global_config->{$key} if $key && defined $global_config->{$key};

    return @lines ? "\n" . join( "\n", @lines ) . "\n" : q{};
}

=head2 %order_only = order_only(\@modules, \%targets_of, \%required_by, \@ordered)

The order-only prerequisites of each recipe target in C<@ordered>, as a hash of
target to an array reference of the targets that must finish before it.  A
recipe's global target comes before its per-domain one.  A dependency comes
after each recipe that required it, as C<resolve_dependencies> in
L<Provisioner::Cookbook> orders them.  C<%required_by> is what that method
returns third, and C<%targets_of> holds each recipe's targets in the order they
run.

A target outside C<@ordered>, such as that of C<data> or C<ufw>, has its place
set by C<targets_in_order>, and is left out here.  Under C<make -j> these
prerequisites are the order.

=cut

sub order_only {
    my ( $modules, $targets_of, $required_by, $ordered ) = @_;

    my %in_order = map { $_ => 1 } @$ordered;
    my %before;
    foreach my $module (@$modules) {
        my @mine = grep { $in_order{$_} } @{ $targets_of->{$module} // [] };
        next if !@mine;

        push( @{ $before{ $mine[1] } }, $mine[0] ) if @mine == 2;

        my @after = grep { $in_order{$_} } map { @{ $targets_of->{$_} // [] } } @{ $required_by->{$module} // [] };
        push( @{ $before{ $mine[0] } }, @after ) if @after;
    }
    return %before;
}

=head2 @targets = targets_in_order(%args)

Every target that C<all> builds, in the order that a serial make runs them.
Each is a hash reference with C<target>, the path of its state file, C<slot>,
its place in that order counted from 1, and C<after>, the targets that must
finish before it.  The template writes C<all> and the order-only prerequisites
out of it.

Takes C<state_dir>, C<user>, C<admin_user>, C<fetch>, which is true when the
guest fetches through a cache, C<modules>, the recipe targets in order,
C<order_only>, what C<order_only> returns for them, and C<ufw>, which is true
when the guest runs ufw.

The global targets wait for one another.  The cache waits for the last of them,
every recipe target waits for the cache, or for the last global target without
one, and for what C<order_only> says.  ufw waits for every recipe target.

=cut

sub targets_in_order {
    my (%args) = @_;
    my $state = $args{state_dir};

    my @global = qw{sysctl packages scripts data ssl ssh sendmail testdeps};
    unshift( @global, $args{user} eq $args{admin_user} ? 'admin_user' : 'service_user' ) if $args{user};
    unshift( @global, 'state' );

    my @targets;
    my $last;
    foreach my $target ( map { "$state/$_" } @global, ( $args{fetch} ? 'fetch_via_cache' : () ) ) {
        push( @targets, { target => $target, after => [ $last // () ] } );
        $last = $target;
    }
    foreach my $module ( @{ $args{modules} } ) {
        push( @targets, { target => $module, after => [ $last, @{ $args{order_only}{$module} // [] } ] } );
    }
    push( @targets, { target => "$state/ufw", after => [ $last, @{ $args{modules} } ] } ) if $args{ufw};

    my $slot = 0;
    $_->{slot} = ++$slot for @targets;
    return @targets;
}

=head2 ($ips, $port, $user) = transfer_to($hv, $this_machine, $global_config, $fqdn, @towards)

Returns where a guest of C<$hv> fetches its payload from: every address of this
machine that the guest's firewall must accept, the one it fetches from first,
then the ssh port and the account.

The block of the hypervisor in F<hypervisors.conf> answers first, then the
C<_global> of the domain, then this machine.  The address is the hypervisor's
because it depends on where the guest is: a guest on a machine of ours reaches
us across our own network, and a guest on a cloud reaches us through the
gateway, at an address and a port forwarded past it.  With neither set, the
routing table decides, from C<@towards>, the addresses of the guest that it
could route to.

Dies when there is nothing to route to and nothing configured, as on a cloud,
which allocates the guest's address after this runs; or when none of this
machine's addresses reaches the guest.

=cut

sub transfer_to {
    my ( $hv, $this_machine, $global_config, $fqdn, @towards ) = @_;

    my $port = $hv->configured_transfer_port   // $global_config->{transfer_port} // $this_machine->sshd_port;
    my $user = $global_config->{transfer_user} // $this_machine->transfer_user;
    die "Could not work out the transfer user on " . $this_machine->describe . "\n" unless $user;

    my $named = $hv->configured_transfer_ip // $global_config->{transfer_ip};
    my @ips   = $named ? ($named) : ( @towards ? $this_machine->transfer_ips(@towards) : () );

    # No address to route to is a different problem from no route.
    die "There is no address of $fqdn to work out which of ours it can reach.\n" . $hv->describe . " allocates that when the guest is created, so it cannot be\n" . "known here.  Name the address a guest fetches from as transfer_ip in the\n" . "block of the hypervisor in hypervisors.conf, or in the _global of recipes.yaml.\n"
      if !@ips && !@towards;

    die "Nothing on " . $this_machine->describe . " can be reached from $fqdn.\n" . "A guest fetches its payload from here, so it needs an address of ours it can\n" . "get to -- and none of " . join( ', ', @towards ) . " routes anywhere from this\n" . "machine.  Put it on one of those networks, or name the address as\n" . "transfer_ip in the _global of recipes.yaml.\n"
      unless @ips;

    return ( \@ips, $port, $user );
}

## no critic(CognitiveComplexity::ProhibitExcessCognitiveComplexity)
sub handle_domain {
    my ( $domain, $hv ) = @_;

    die "Must pass domain" unless $domain;

    my $fqdn = $domain;
    my ( undef, $tld ) = split( quotemeta('.'), $domain, 2 );
    die "'$domain' is not a fully qualified domain name.\n" . "Domains are spelled out in full now, in recipes.yaml and in recipes.d alike:\n" . "  new_config $domain.example.com\n"
      unless $tld;

    my $rconf = clone( get_recipe_config() );

    die "No recipe configuration found for '$domain'. Add a '$domain' key to your recipes.yaml (or recipes.d/) configuration.\n"
      unless exists $rconf->{$domain};

    # Only prompt if we have to
    my %to_replace = Trog::Secrets->needed($rconf);
    my $keepass;

    # The values, so that a command that holds one starts with @ and make does
    # not print it into the setup log.
    my @secret_values;
    if (%to_replace) {
        $keepass = Trog::Credentials->prompt( 'Enter password:', 'keepass' );
        my %secrets = Trog::Secrets->lookup( $sfile, $keepass, %to_replace );
        Trog::Secrets->apply( $rconf, %secrets );
        @secret_values = values %secrets;

        # Give Cookbook the resolved copy, because a recipe that reads the
        # credential of another recipe asks Cookbook for it.
        Provisioner::Cookbook->remember( $pfile, $rconf );
    }

    my $alias_conf = Provisioner::Cookbook->alias_map($rconf);

    # This run does not need to know yet if the domain goes onto another host.
    delete $rconf->{_shared};

    # The host, if this domain goes onto the guest of another domain.
    my ($dep_dom) = expand_dependent_domains($domain);

    my $depends_on;
    $depends_on = $dep_dom if $dep_dom ne $domain;

    # _base and the domain, merged and then validated against
    # Provisioner::Cookbook/global_schema, which names every setting that is
    # missing rather than the first of them.
    my $global_config = Provisioner::Cookbook->globals( $domain, $rconf );
    delete $rconf->{$domain}{_global};

    my $basedir     = $global_config->{basedir};
    my $admin_user  = $global_config->{admin_user};
    my $admin_gecos = $global_config->{admin_gecos};
    my $admin_email = $global_config->{admin_email};
    my $gateway     = $global_config->{gateway};
    my $resolvers   = $global_config->{resolvers};
    my $ns_conf     = $global_config->{nameservers};
    my $pool_conf   = $global_config->{ip_pool} // {};

    # From a file, not from GitHub at first boot, so that a provision does not
    # wait on GitHub.  A file also takes a raw public key.
    my $keyfile    = Trog::Config->path('admin_authorized_keys');
    my @admin_keys = grep { $_ && !m/\A[#]/ } map { s/\A\s+|\s+\z//gr } split( m/\n/, File::Slurper::read_text($keyfile) );
    die "No administrator keys in $keyfile.\nbin/preflight will offer to seed it with ssh-import-id.\n" unless @admin_keys;

    # A loopback resolver answers only on a guest that runs its own DNS server,
    # and Provisioner::Recipe::nostubresolver adds it for that guest.
    my @loopback = grep { m/\A127[.]/ || $_ eq '::1' } @$resolvers;
    die "The resolvers of this installation name @loopback, which only answers on a guest that runs its own DNS server.\n" . "Take it out of the _global in recipes.yaml: nostubresolver puts it in front for a guest running pdns, and every other guest spends its first lookup on an address nothing is listening at.\n"
      if @loopback;

    # Refused here, because a typing error such as `distro: unbuntu` that falls
    # back to the generic recipes builds a guest with no packages.
    my $distro_name = $global_config->{distro} // 'ubuntu';
    die "There is no '$distro_name' distro recipe, which $domain asks for as its distro.\n" . 'There is: ' . join( ', ', Provisioner::Cookbook->distros() ) . "\n"
      unless any { $_ eq $distro_name } Provisioner::Cookbook->distros();

    # Chosen here, because _global already gives the memory, disk and CPU that
    # placement needs.
    $hv //= Trog::Hypervisors->choose(
        $domain,
        hypervisor  => $hv_name,
        hvconf      => $hvconf,
        domain_dir  => $domaindir,
        config      => $global_config,
        host        => $depends_on,
        host_config => defined $depends_on ? Provisioner::Cookbook->global_config( $depends_on, $rconf ) : undef,
    );

    # No pool when the hypervisor gives its guests their addresses, because an
    # address from the pool stays reserved for a guest that never uses it.
    my ( $static_ip, $ip_conf ) = ( undef, {} );
    if ( !$hv->manages_addresses ) {
        Provisioner::IPPool::ensure_seeded( $pool_conf, $gateway );

        # One transaction, so that two provisions cannot get the same address.
        # A domain that you provision again keeps its address.
        $static_ip = Provisioner::IPPool::assign( $domain, $pool_conf );
        $ip_conf   = Provisioner::IPPool::assignments();

        # A single label must not go into a zone file without a warning.
        my @unqualified = grep { index( $_, q{.} ) < 0 } sort keys %$ip_conf;
        die "These domains in " . Provisioner::IPPool::db_path() . " are not fully qualified:\n" . join( '', map { "  $_\n" } @unqualified ) . "There is no tld to append any more.  Spell them out, as recipes.d already does.\n"
          if @unqualified;
    }

    # The guest fetches its payload from this machine, not from the hypervisor.
    my $this_machine = Trog::Local->new();

    # The NAT bridge, on a hypervisor that does not give its guests their
    # addresses.
    my $tld_ip = $hv->manages_addresses ? undef : $hv->virbr_ip;

    # Every address of ours that routes to the guest, because the firewall of
    # the guest must accept each one.
    my @towards = grep { $_ } ( $static_ip, $tld_ip );
    my ( $transfer_ips, $transfer_port, $transfer_user ) = transfer_to( $hv, $this_machine, $global_config, $fqdn, @towards );
    my @transfer_ips = @$transfer_ips;
    my $transfer_ip  = $transfer_ips[0];

    # Before _base is removed, because a fleet usually sets these in _base.
    # Provisioner::Cookbook/install_dir says why they belong to _global.
    $global_config->{install_dir} //= Provisioner::Cookbook->install_dir( $domain, $rconf );
    $global_config->{data_source} //= Provisioner::Cookbook->data_source( $domain, $rconf );
    my $data_dir = Provisioner::Cookbook->data_dir( $domain, $rconf );

    # Merged from this copy, not from the file, so that the resolved secrets
    # stay in it.
    $rconf->{$domain} = Provisioner::Cookbook->domain_config( $domain, $rconf );
    delete $rconf->{_base};

    # Validation accepts the CHANGEME that bin/new_guest writes, so refuse it
    # here, after the merge, because _base can supply the real value.
    my @unfilled = Provisioner::Cookbook->placeholders_in( $rconf->{$domain} );
    die "Still unfilled in the configuration for $domain:\n" . join( '', map { "  $_\n" } @unfilled ) . "Each of these is a " . Provisioner::Cookbook->PLACEHOLDER . " that new_guest left for you.\n" if @unfilled;

    # Provisioner::Cookbook put these on @INC when it read the configuration,
    # before anything asked about a recipe.
    my $libdirs = $global_config->{libdir} // [];
    print "Included vendor libs from $_/lib\n" foreach @$libdirs;

    # The directory of the distribution comes first, so that
    # templates/ubuntu/nginx.tt is used before templates/nginx.tt.
    my @paths = @{ Provisioner::Cookbook->template_dirs( $distro_name, @$libdirs ) };

    die "Nothing says where $fqdn's data comes from: set data_source in _global.\n"
      unless $data_dir;

    my @data_users;
    my $data_users_f = "$data_dir/users.yaml";
    ## no critic (ValuesAndExpressions::ProhibitFiletest_f)
    if ( -f $data_users_f ) {
        my $data_users_yaml = YAML::XS::Load( File::Slurper::read_binary($data_users_f) );
        @data_users = @{ $data_users_yaml->{users} };
    }

    # The administrator from the globals, then the users of the data directory.
    my $user_conf = {
        users => [
            {
                gecos               => $admin_gecos,
                name                => $admin_user,
                shell               => '/bin/bash',
                sudo                => 'ALL=(ALL) NOPASSWD:ALL',
                ssh_authorized_keys => [@admin_keys],
            },
            @data_users,
        ],
    };

    my $cfg_dir = "$basedir/$fqdn";
    if ( !-d $cfg_dir ) {
        mkdir $cfg_dir or die "could not create $cfg_dir";
    }

    File::Slurper::Temp::write_binary( "$cfg_dir/users.yaml", YAML::XS::Dump($user_conf) );

    # Give the list of users to all the templates, for example the LDIF that
    # seeds ldap.
    $global_config->{users} = $user_conf->{users};

    my %fragments;
    my %global_fragments;

    my $root_scripts = '/root/bin';

    my %formatters = (
        tabinate => Text::Xslate::html_builder(
            sub {
                my $input = shift;
                $input =~ s/^\s*/\t/mg;
                return $input;
            }
        ),
    );

    my $tt = Text::Xslate->new(
        {
            path     => \@paths,
            syntax   => 'TTerse',
            module   => [qw{Text::Xslate::Bridge::TT2}],
            function => \%formatters,
        }
    ) || die "Could not initialize template dir";

    # The class, not an instance, because the depsolver builds the one object.
    # A second object is a second chance to generate the key of the guest.
    my $distro = Provisioner::Cookbook->load($distro_name);

    my %provisioner_opts = (
        distro          => $distro_name,
        target_packager => $distro->packager,
        script_loc      => $root_scripts,
        output_dir      => $cfg_dir,
        template_dirs   => \@paths,

        # Given to every builder, so that none calls Trog::HV->new() and gets a
        # hypervisor other than the one that placement chose.
        hv => $hv,
    );

    # An address, not a name, because the guest fetches before its DNS works.
    $global_config->{transfer_ip}  = $transfer_ip;
    $global_config->{transfer_ips} = \@transfer_ips;
    $global_config->{tld}          = $tld;
    $global_config->{admin_user}   = $admin_user;
    $global_config->{admin_email}  = $admin_email;

    # The gateway and the keys, for a recipe that writes an ipmap.cfg of its
    # own, such as Provisioner::Recipe::trogrunner.
    $global_config->{admin_keys}    = [@admin_keys];
    $global_config->{gateway}       = $gateway;
    $global_config->{domain}        = $fqdn;
    $global_config->{ipmap}         = $ip_conf;
    $global_config->{aliases}       = $alias_conf;
    $global_config->{nameservers}   = $ns_conf;
    $global_config->{main_ip}       = $static_ip;
    $global_config->{tld_ip}        = $tld_ip;
    $global_config->{transfer_user} = $transfer_user;
    $global_config->{transfer_port} = $transfer_port;

    apply_global_defaults( $distro, $global_config );

    # Once, here, not by each recipe: see Provisioner::DistroRecipe/cache_address.
    # The resolvers go to every recipe, because the fetch cache runs one.
    $global_config->{cache_ip}  = $distro->cache_address(%$global_config);
    $global_config->{resolvers} = $resolvers;

    # Emptied, not only made, because every file in it goes to the guest and
    # runs there.  A recipe taken off the domain would otherwise leave its test,
    # which fails the build on a guest that no longer has it.
    remove_tree("$cfg_dir/t");
    make_path("$cfg_dir/t");

    $global_config->{script_dir} = $root_scripts;

    my ( @pkgs, @generated );

    # Always, because the guest can be a system that exists already.
    push( @pkgs, $distro->deps() );

    $global_config->{packager_invocation}        = $distro->packager_invocation;
    $global_config->{packager_up_invocation}     = $distro->packager_up_invocation;
    $global_config->{packager_remove_invocation} = $distro->packager_remove_invocation;

    # Whether the guest is up.  The connection is only the probe: the fetch
    # goes through _salvage_guest.
    my ( $ssh, $target_is_up );

    # A guest without an address yet is not built, so it has nothing to
    # salvage.
    ( $ssh, $target_is_up ) = _get_sftp( $static_ip, $admin_user, $cfg_dir )
      if !$skip_ssh && $static_ip;

    # The distro recipe goes in, so that the depsolver configures it and pulls
    # in the vm recipe.  Both come out again below.
    my @modules = ( $distro_name, sort keys( %{ $rconf->{$domain} } ) );

    my %mf_vars;
    my @testdeps;
    my @empty_salvage;
    my @conflicts;
    my @modules_ordered;

    # The targets of each recipe, in the order they run: global, then per domain.
    my %targets_of;

    my %builders;

    # In Provisioner::Cookbook, so that bin/new_guest gets the same answer.
    my ( $solved, $built, $required_by ) = Provisioner::Cookbook->resolve_dependencies(
        modules       => \@modules,
        domain_conf   => $rconf->{$domain},
        global_config => $global_config,
        distro        => $distro_name,
        provisioner   => \%provisioner_opts,
        domain        => $domain,
        host          => $depends_on,
        host_conf     => defined $depends_on ? $rconf->{$depends_on} : undef,
    );
    @modules  = @$solved;
    %builders = %$built;

    # Not the distro and vm recipes, which direct the build, because every
    # template gets `modules` as the list of what is on the guest.
    @modules = grep { $builders{$_}->is_module } @modules;

    # Here rather than where the map is read, because that is before the
    # depsolver has run and a name belonging to a dependency would be missed.
    # $global_config->{aliases} holds this same hash, so everything rendered
    # below sees what this adds.
    $alias_conf->{$domain} = [
        uniq(
            @{ $alias_conf->{$domain} // [] },
            Provisioner::Utils::subdomain_aliases( $domain, map { $builders{$_} } @modules )
        )
    ];

    # A recipe that cannot serve a second domain replaces the first, so refuse
    # it here.  This compares a tenant with its host only, not with the other
    # tenants.
    $MACHINE_MODULES{$domain} = [@modules];
    if ($depends_on) {
        my %on_host = map  { $_ => 1 } @{ $MACHINE_MODULES{$depends_on} // [] };
        my @cannot  = grep { $on_host{$_} && !$builders{$_}->is_multi_tenant } @modules;

        die "$domain is provisioned onto $depends_on, and both are configured with: " . join( ', ', @cannot ) . "\n" . "There is one of that on a guest, and it cannot be told about a second domain -- so this\n" . "would replace what $depends_on configured rather than add to it.  Configure it on one of\n" . "the two, or give $domain a machine of its own.\n"
          if @cannot;
    }

    # One guest has one of each address on each port.  Each domain resolves its
    # recipes alone, so hand the claims that the guest already has to this
    # domain's ufw, whose schema refuses an address that two recipes claim.
    # The host comes first, and starts the guest's claims afresh.  Every leaf
    # is 1, so which side of the merge takes precedence does not matter.
    my $machine = $depends_on // $domain;
    $MACHINE_LISTENERS{$machine} = {} unless $depends_on;
    if ( my $ufw = $rconf->{$domain}{ufw} ) {
        $ufw->{listeners} = Hash::Merge->new('STORAGE_PRECEDENT')->merge( $ufw->{listeners} // {}, $MACHINE_LISTENERS{$machine} // {} );
        $MACHINE_LISTENERS{$machine} = clone( $ufw->{listeners} );
    }

    my %guest_secrets;

    foreach my $module (@modules) {
        my $builder = $builders{$module};
        my $pconf   = $rconf->{$domain}{$module};

        my $aliases      = $alias_conf->{$domain} // [];
        my $full_aliases = [@$aliases];
        if ( $builder->has_global_template() ) {
            $global_fragments{$module} = Provisioner::Recipe->quiet_secrets(
                $builder->render_global(
                    $builder->takes(%$global_config),
                    %$pconf,
                    full_aliases => $full_aliases,
                    modules      => \@modules,
                ),
                @secret_values
            );
            push( @modules_ordered,          "/etc/provisioner/state/global_$module" );
            push( @{ $targets_of{$module} }, "/etc/provisioner/state/global_$module" );
        }
        if ( $builder->has_template() ) {
            $fragments{$module} = Provisioner::Recipe->quiet_secrets(
                $builder->render(
                    $builder->takes(%$global_config),
                    %$pconf,
                    full_aliases => $full_aliases,
                    modules      => \@modules,
                ),
                @secret_values
            );
            push( @modules_ordered,          "/etc/provisioner/state/$fqdn/$module" );
            push( @{ $targets_of{$module} }, "/etc/provisioner/state/$fqdn/$module" );
        }
        push( @pkgs,      ( $builder->deps(%$pconf) ) );
        push( @conflicts, ( $builder->dep_conflicts(%$pconf) ) );

        my %t_vars = $builder->makefile_vars();
        %mf_vars = ( %mf_vars, %t_vars ) if %t_vars;

        # Collected for one lookup below, so that a run asks for the password of
        # the store one time.  They go through the store, not the payload.
        %guest_secrets = ( %guest_secrets, $builder->guest_secrets( $global_config->{install_dir}, $fqdn, %$pconf ) );

        foreach my $d ( $builder->datadirs() ) {
            make_path("$data_dir/$d") unless -d "$data_dir/$d";
        }

        if ($target_is_up) {
            print "Backing up $module files from $fqdn\n";
            my %tg   = $builder->remote_files( $global_config->{install_dir}, $fqdn );
            my @skip = $builder->remote_skip();

            # Before the fetch, so that it gets the current state.
            refresh_salvage(
                static_ip  => $static_ip,
                admin_user => $admin_user,
                cfg_dir    => $cfg_dir,
                module     => $module,
                commands   => [ $builder->remote_prepare( $global_config->{install_dir}, $fqdn ) ],
                watched    => [ sort keys %tg ],
            );
            foreach my $to_fetch ( sort keys(%tg) ) {
                print "Fetching $to_fetch into $data_dir/$tg{$to_fetch}\n";

                # The result is ignored, because _salvage_gap below tells more,
                # and part of the state is better than none.
                _salvage_guest( $static_ip, $admin_user, $cfg_dir )->get_dir(
                    $to_fetch,
                    "$data_dir/$tg{$to_fetch}",

                    # Left on the live guest, not fetched and then deleted: see
                    # remote_skip in Provisioner::Recipe.
                    exclude => \@skip,

                    # A copy on the guest that is older than ours is not fetched.
                    update => 1,

                    # As root, because every other practical option is more
                    # complex and has no benefit to security.
                    sudo => 1,
                );

                my $gap = _salvage_gap(
                    guest       => _salvage_guest( $static_ip, $admin_user, $cfg_dir ),
                    recipe      => $module,
                    host        => $fqdn,
                    user        => $admin_user,
                    remote      => $to_fetch,
                    destination => "$data_dir/$tg{$to_fetch}",
                );
                next unless $gap;

                # warn, not print, so that it stands out from the progress on
                # STDOUT and a caller can catch it with a warn handler.
                warn $gap->{message} . "\n";
                push( @empty_salvage, $gap ) if $gap->{alarming};
            }
        }

        # These go in the payload, unlike the files of the distro recipe below.
        push( @generated, $builder->generate_files( $cfg_dir, $builder->takes(%$global_config), %$pconf, full_aliases => $full_aliases, modules => \@modules ) );

        my @tests = $builder->tests();
        foreach my $test (@tests) {
            my $tname = $test;
            $tname =~ s/tt$/t/;
            my $rendered = $builder->render_file( "tests/$test", $builder->takes(%$global_config), %$pconf, full_aliases => $full_aliases, modules => \@modules );
            print "Writing $test as $tname\n";
            File::Slurper::Temp::write_binary( "$cfg_dir/t/$tname", $rendered );
        }

        push( @testdeps, ( $builder->testdeps(@modules) ) );
    }
    @testdeps = uniq @testdeps;
    push( @pkgs, 'cpanminus' ) if @testdeps;

    @pkgs      = sort { $a cmp $b } uniq @pkgs;
    @conflicts = uniq @conflicts;

    @pkgs = grep {
        my $pkg = $_;
        !any { $_ eq $pkg } @conflicts;
    } @pkgs if @conflicts;

    my $extra_packages = join( ', ', @pkgs );

    # makefile.tt runs the data target with its global targets, before the
    # target of any recipe, so that each recipe finds its state already
    # restored.  So data comes out of %fragments, where it
    # makes a second state/data: target, and out of the ordered list, where it
    # runs last.
    #
    # Empty, not undef, because makefile.tt writes the data target for every
    # guest.  The data recipe is in the build only when a recipe declares
    # restores.  The path is compared exactly, so that a domain called 'data'
    # keeps its target.
    my $data_fragment = delete $fragments{data} // q{};
    @modules_ordered = grep { $_ ne "/etc/provisioner/state/$fqdn/data" } @modules_ordered;

    # ufw comes out because it must run last: templates/makefile.tt says why.
    my $ufw_fragment = delete $fragments{ufw};
    @modules_ordered = grep { $_ ne "/etc/provisioner/state/$fqdn/ufw" } @modules_ordered;

    my %order_only = order_only( \@modules, \%targets_of, $required_by, \@modules_ordered );

    # The hosts that the guest downloads from through the fetch cache, and the
    # certificate of the authority that the guest trusts meanwhile.  See
    # Provisioner::Recipe/fetch_hosts and scripts/fetch_via_cache.
    #
    # Asked with the configuration of each module, so that a configured
    # repo_url or api_url names the host that the recipe really uses.
    my @fetch_hosts =
      $global_config->{cache_ip}
      ? uniq( sort map { $builders{$_}->fetch_hosts( %$global_config, %{ $rconf->{$domain}{$_} // {} } ) } @modules )
      : ();
    if (@fetch_hosts) {
        copy( Provisioner::Cookbook->load('fetchcache')->authority()->{cert}, "$cfg_dir/fetchcache-ca.crt" )
          or die "Could not give $fqdn the fetch cache's authority: $!\n";

        # Only files in @generated go into the tarball.
        push( @generated, 'fetchcache-ca.crt' );
    }

    my $makefile = $tt->render(
        'makefile.tt',
        {
            %$global_config,
            data_fragment    => $data_fragment,
            ufw_fragment     => $ufw_fragment,
            fragments        => \%fragments,
            global_fragments => \%global_fragments,
            targets          => [
                targets_in_order(
                    state_dir  => "/etc/provisioner/state/$fqdn",
                    user       => $global_config->{user},
                    admin_user => $global_config->{admin_user},
                    fetch      => scalar @fetch_hosts,
                    modules    => \@modules_ordered,
                    order_only => \%order_only,
                    ufw        => defined $ufw_fragment,
                )
            ],

            # The ssl target puts each of these names in its certificate.
            full_aliases     => $alias_conf->{$fqdn} // [],
            vars             => \%mf_vars,
            state_dir        => "/etc/provisioner/state/$fqdn",
            global_state_dir => "/etc/provisioner/state",
            testdeps         => \@testdeps,
            testdeps_flags   => [ Trog::Script::CpanInstall::mirror_only(@testdeps) ],
            fetch_hosts      => @fetch_hosts ? \@fetch_hosts : undef,
        }
    );

    print "Writing Makefile to $cfg_dir\n";
    File::Slurper::Temp::write_binary( "$cfg_dir/Makefile", $makefile );

    write_guest_secrets( $cfg_dir, $fqdn, \%guest_secrets, $sfile, $keepass );

    my $r_text = join( ', ', @$resolvers );

    # Put the sealed key back beside the recipe, because seal_key took the
    # private half off the disk.  A recipe that finds no pair makes a new one.
    my $sealed = Trog::Guest->key_path( $fqdn, "$cfg_dir/key.rsa" );
    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- whether it is already the file we want
    if ( defined $sealed && $sealed ne "$cfg_dir/key.rsa" && !-f "$cfg_dir/key.rsa" ) {
        File::Slurper::Temp::write_binary( "$cfg_dir/key.rsa", File::Slurper::read_binary($sealed) );
        chmod 0600, "$cfg_dir/key.rsa";
    }

    # The files that the guest first boots from: network configuration,
    # cloud-init, setup.sh and the destination of its logs.  After the loop,
    # because the user-data lists @pkgs, which is final only now.  And outside
    # the payload, because user-data holds the private key of the guest.
    #
    # The vm recipe is the other director, and bin/provision generates its file,
    # because its paths exist only after a hypervisor makes them.
    print "Writing what $fqdn first boots from, out of the $distro_name recipe\n";
    $builders{$distro_name}->generate_files(
        $cfg_dir,
        $builders{$distro_name}->takes(%$global_config),
        %{ $rconf->{$domain}{$distro_name} // {} },
        packages      => \@pkgs,
        ips           => [ grep { defined } $static_ip ],
        gateway       => $gateway,
        contact_email => $admin_email,
        payload_dir   => $basedir,
        ( defined $dryrun ? ( dryrun => $dryrun ) : () ),
        modules => \@modules,
    );

    # After generate_files, which makes a key for a domain that had none.  Not
    # on a dry run: see DRY RUNS.
    Trog::Guest->seal_key( $fqdn, "$cfg_dir/key.rsa" ) unless $dryrun;

    # The hypervisor's, for the distro's release: a cloud names its images in a
    # catalog of its own, and a URL means nothing to it.
    my $image = $hv->image_for_distro($distro);

    # The size of the guest defaults from the schema of the vm recipe, which
    # `bin/recipes vm` prints.
    my %vm   = Provisioner::Cookbook->defaults('vm');
    my $size = $global_config->{size}   // $vm{size};
    my $cpus = $global_config->{cpus}   // $vm{cpus};
    my $mem  = $global_config->{memory} // $vm{memory};

    my $pconf = qq(
        distro=$distro_name
        image=$image
        size=$size
        cpus=$cpus
        memory=$mem
        packages=$extra_packages
        contact_email=$admin_email
        ips=@{[ $static_ip // q{} ]}
        admin_user=$admin_user
        gateway=$gateway
        resolvers=$r_text
        transfer_ip=$transfer_ip
        transfer_user=$transfer_user
        transfer_port=$transfer_port
        payload_dir=$basedir
    );
    $pconf .= "depends_on=$depends_on" if $depends_on;
    $pconf .= placement_lines( $hv, $global_config );

    # The hypervisor settings that _global sets.  See hv_lines.
    my %written = map { m/\A\s*(\w+)=/ ? ( $1 => 1 ) : () } split( m/\n/, $pconf );
    $pconf .= hv_lines( $global_config, \%written );

    File::Slurper::Temp::write_binary( "$cfg_dir/provision.conf", $pconf );

    # From the checkout, not the working directory, so that this program runs
    # from any directory.
    my $checkout = Cwd::abs_path( File::Basename::dirname(__FILE__) . '/..' );

    # For the self-signed certificate.
    print "Copying openssl.conf to $cfg_dir/openssl.conf\n";
    copy( "$checkout/openssl.conf", "$cfg_dir/openssl.conf" )
      or die "Could not copy openssl.conf into $cfg_dir: $!\n";

    # In the tarball, because the hypervisor has no checkout for the guest to
    # get them from.
    my @scripts = pack_scripts( $checkout, $cfg_dir );

    print "Tarring up Makefile and generated configuration\n";
    unlink "$cfg_dir/data.tar.gz";

    my @members = ( 'Makefile', @generated, 'openssl.conf', @scripts );
    File::Find::find(
        sub {
            my $rel = $File::Find::name;
            $rel =~ s{^\Q$cfg_dir\E/}{};
            push( @members, $rel );
        },
        "$cfg_dir/t"
    );

    my $tar = Archive::Tar->new();
    $tar->add_files( map { "$cfg_dir/$_" } @members ) or die "Could not add files to $cfg_dir/data.tar.gz: " . Archive::Tar->error();

    # Relative to $cfg_dir, because add_files stores each path as it is given.
    foreach my $member ( $tar->get_files() ) {
        my $stored = $member->full_path();
        $stored =~ s{^\Q$cfg_dir\E/}{};
        $member->rename($stored);
    }

    $tar->write( "$cfg_dir/data.tar.gz", Archive::Tar::COMPRESS_GZIP() ) or die "Could not write $cfg_dir/data.tar.gz: " . Archive::Tar->error();

    # Also when it is empty, because the rsync of the data target fails on a
    # source that is not there, and stops the Makefile.
    make_path($data_dir) unless -d $data_dir;

    # Again at the end, where the operator looks.  A warning, not a stop: see
    # salvage_gaps.
    if (@empty_salvage) {
        warn "\n" . scalar(@empty_salvage) . " salvage(s) on $fqdn came back with nothing:\n" . join( q{}, map { "    $_->{recipe} read nothing out of $_->{remote}\n" } @empty_salvage ) . "None of that state is in $data_dir.  Rebuilding $fqdn now loses it.\n";

        $SALVAGE_GAPS{$fqdn} = [@empty_salvage];
    }

    print "Done.\n";
    return 0;
}

=head2 $guest = _salvage_guest($static_ip, $admin_user, $cfg_dir)

Returns a L<Trog::Guest> for the guest that is about to be rebuilt, as
C<$admin_user>.  It returns the same object for the same three arguments, for
the life of the process.

=cut

sub _salvage_guest {
    my ( $static_ip, $admin_user, $cfg_dir ) = @_;

    # Without a CIDR suffix.
    ( my $host = $static_ip ) =~ s{/\N*\z}{};

    # One connection for each guest, not one for each call, because both
    # callers ask inside the loop over the modules.
    state %guest;
    my $id = join( "\0", $host, $admin_user // q{}, $cfg_dir // q{} );
    return $guest{$id} if $guest{$id};

    # When there is no key yet, ssh uses its agent and its own configuration.
    my $key = Trog::Guest->key_path( File::Basename::basename($cfg_dir), "$cfg_dir/key.rsa" );

    return $guest{$id} = Trog::Guest->new(
        name => $host,
        host => $host,
        user => $admin_user,
        ( $key ? ( key_path => $key ) : () ),
    );
}

=head2 refresh_salvage(%args)

Runs the C<commands> from the C<remote_prepare> of a recipe as root on the
guest.  Then the state is up to date when it is salvaged.  Returns 1.

C<static_ip>, C<admin_user> and C<cfg_dir> tell which guest to connect to.
C<module> names the recipe.  C<watched> lists the paths that are about to come
down.

A command that fails gives a warning, because an old dump is better than none.

Dies if a command fails after it changed a file under C<watched>, because the
dump is then partial, for example a mysqldump that stopped halfway.  Nothing is
fetched.

=cut

sub refresh_salvage (%args) {
    my ( $static_ip, $admin_user, $cfg_dir, $module, $commands, $watched ) = @args{qw{static_ip admin_user cfg_dir module commands watched}};

    return unless @$commands;
    $watched //= [];

    my $guest = _salvage_guest( $static_ip, $admin_user, $cfg_dir );
    my $host  = $guest->name;

    my %seen = _salvage_mtimes( $guest, $watched );

    foreach my $command (@$commands) {
        print "Asking $host to run '$command' before salvaging $module\n";

        # Through a shell, because a recipe gives a command line, not an argv.
        my $failed = $guest->run_sudo( '/bin/sh', '-c', $command );

        # Again after every command, so that the next one is not blamed for
        # the changes of this one.
        my %now     = _salvage_mtimes( $guest, $watched );
        my @touched = grep { ( $seen{$_} // q{} ) ne ( $now{$_} // q{} ) } sort keys %now;
        %seen = %now;

        next unless $failed;

        die "$module: '$command' failed on $host after changing what it was refreshing:\n" . join( q{}, map { "    $_\n" } @touched ) . "That is a partial dump rather than a stale one, and fetching it would carry\n" . "a corrupt copy home as though it were the state of the guest.  Nothing was\n" . "fetched.  Fix the guest, or move what it left aside, and run this again.\n"
          if @touched;

        warn "$module: '$command' failed on $host, so what comes down is whatever was already there.\n" . "Whatever it was going to refresh is as old as the last time something did.\n";
    }

    return 1;
}

=head2 %mtime = _salvage_mtimes($guest, $watched)

Returns the newest mtime anywhere under each path in C<$watched>, keyed by
path.  It looks under the path, because the mtime of a directory misses a dump
that is written again in place.  A path that is absent or unreadable gives an
empty value.

=cut

sub _salvage_mtimes {
    my ( $guest, $watched ) = @_;
    return () unless @$watched;

    my $script = join "\n", map {
        ( my $q = $_ ) =~ s/'/'\\''/g;
        "printf '%s\\t%s\\n' '$q' \"\$(find '$q' -printf '%T@\\n' 2>/dev/null | sort -rn | head -1)\""
    } @$watched;

    ( my $quoted = $script ) =~ s/'/'\\''/g;
    my $said = $guest->capture_cmd("sudo sh -c '$quoted'") // q{};

    my %mtime;
    foreach my $line ( split m/\n/, $said ) {
        my ( $path, $stamp ) = split m/\t/, $line, 2;
        next unless $path;
        $mtime{$path} = defined $stamp ? $stamp : q{};
    }

    return %mtime;
}

=head2 write_guest_secrets($cfg_dir, $fqdn, $wanted, $store, $keepass)

Makes sure that the secret store at C<$store> holds a value for each file in
C<$wanted>, and generates the values that are missing.  Then writes
F<guest-secrets.yaml> in C<$cfg_dir>, which tells where each file goes on the
guest.  Asks for the password when C<$keepass> is undef.  Returns a reference to
the values that the store holds.  When C<$wanted> is empty, it removes an old
manifest and returns nothing.

The manifest holds references, never values, and is not in the payload, so that
no secret goes into the tarball or its backups.  C<bin/provision> reads it and
puts the files on the guest.

=cut

sub write_guest_secrets {
    my ( $cfg_dir, $fqdn, $wanted, $store, $keepass ) = @_;

    my $manifest = "$cfg_dir/guest-secrets.yaml";
    unlink $manifest;
    return unless %$wanted;

    # Only now, so that a run with nothing to place asks for no password.
    $keepass //= Trog::Credentials->prompt( 'Enter password:', 'keepass' );

    my %generator = map { $wanted->{$_}{ref} => $wanted->{$_}{generate} } keys %$wanted;
    my %held      = Trog::Secrets->remember( $store, $keepass, %generator );

    my %manifest = map {
        $_ => {
            ref   => $wanted->{$_}{ref},
            owner => $wanted->{$_}{owner} // 'root:root',
            mode  => $wanted->{$_}{mode}  // '0600',
        }
    } keys %$wanted;

    File::Slurper::Temp::write_binary( $manifest, YAML::XS::Dump( \%manifest ) );
    chmod 0600, $manifest;

    print "Wrote $manifest: " . scalar( keys %manifest ) . " file(s) for bin/provision to place on $fqdn\n" . join( q{}, map { "  $_ <- $manifest{$_}{ref}\n" } sort keys %manifest );

    return \%held;
}

=head2 @packed = pack_scripts($checkout, $cfg_dir)

Copies the helper scripts from F<scripts/> in C<$checkout> into
C<$cfg_dir/scripts>, with their modes, and returns their paths relative to
C<$cfg_dir>.  The modes are copied, because File::Copy does not promise to keep
the executable bit.  A name that starts with a dot is not a script, and is not
copied.  F<scripts/.perlcriticrc> is one: it is for the tools that lint the
scripts.  Dies if there is no F<scripts/>.

=cut

sub pack_scripts {
    my ( $checkout, $cfg_dir ) = @_;

    my $from = "$checkout/scripts";
    die "No scripts directory at $from\n" unless -d $from;

    my $to = "$cfg_dir/scripts";
    remove_tree($to) if -d $to;
    make_path($to) or die "Could not create $to: $!\n";

    my @packed;
    foreach my $script ( grep { !m/\A[.]/ } Provisioner::Utils::files_in($from) ) {

        # From the handle, so that the file and its mode come from the same
        # file.
        open( my $in, '<', "$from/$script" ) or next;
        copy( $in, "$to/$script" )           or die "Could not copy $script into $to: $!\n";
        ## no critic (ProhibitLeadingZeros) -- the policy exempts a
        ## literal handed straight to chmod; this is a mask against a mode.
        chmod( ( stat $in )[2] & 07777, "$to/$script" );
        close($in) or die "Could not close $from/$script: $!\n";
        push @packed, "scripts/$script";
    }

    print "Packed " . scalar(@packed) . " scripts from $from\n";
    return @packed;
}

=head2 $gap = _salvage_gap(%args)

Returns nothing if C<destination> holds a file.  Otherwise returns a hash
reference with C<recipe>, C<remote>, C<message>, and C<alarming>, which is true
when the salvage lost state.  The other arguments are C<guest>, C<recipe>,
C<host>, C<user> and C<remote>.

It examines the destination, not the transfer, because a second run moves
nothing from a guest that did not change.  An empty destination has three
causes.  The path is not on the guest, or it is empty, or it holds files that
did not come down.  Only the last one is alarming.  The guest is asked as root,
because only the service can open the path.

=cut

sub _salvage_gap {
    my (%args) = @_;

    return () if _dir_has_files( $args{destination} );

    # The path as an argument, because run_sudo escapes each one.  find prints
    # nothing for an absent path, so one question covers both quiet causes.
    my $rc = $args{guest}->run_sudo(
        'sh',          '-c', 'test -n "$(find "$1" -type f -print -quit 2>/dev/null)"',
        'salvage-gap', $args{remote},
    );

    my %gap = ( recipe => $args{recipe}, remote => $args{remote} );

    # Any code other than 0 or 1 means that the question did not run, so it
    # is alarming, not a service that never ran.
    return {
        %gap,
        alarming => 1,
        message  => "$args{recipe}: could not ask $args{host} whether $args{remote} still holds anything" . " -- the check exited $rc as $args{user}.  Treating that as state that did not come off," . " because the alternative is calling a guest we cannot reach a guest with nothing on it.",
    } if $rc > 1;

    return {
        %gap,
        alarming => 0,
        message  => "$args{recipe}: nothing under $args{remote} on $args{host} yet, so there is nothing to salvage.",
    } if $rc;

    return {
        %gap,
        alarming => 1,
        message  => "$args{recipe}: salvaged nothing out of $args{remote} on $args{host}, and $args{destination} is empty." . "  The guest still has files there, so this is a fetch that failed rather than a service with no state." . "  Rebuilding $args{host} now loses them.",
    };
}

=head2 $bool = _dir_has_files($dir)

Returns 1 if any file is under C<$dir>, and 0 if there is none or C<$dir> is not
a directory.  It counts files, not entries, because a fetch that cannot read
makes the directories anyway.  It stops at the first file.  A symlink counts,
and is not followed, because it can point anywhere.

=cut

sub _dir_has_files {
    my ($dir) = @_;
    return 0 unless -d $dir;

    # die is how you leave File::Find early.  A reference, not a string,
    # because File::Find appends its own context to a message.
    my $found = \'found';

    my $ok = eval {
        File::Find::find(
            {
                no_chdir => 1,
                wanted   => sub {
                    die $found if -l $File::Find::name || !-d $File::Find::name;
                },
            },
            $dir
        );
        1;
    };
    return 0 if $ok;

    my $err = $@;
    return 1 if ref $err && ref $err eq 'SCALAR' && $err == $found;
    die $err;
}

sub _get_sftp {
    my ( $static_ip, $admin_user, $cfg_dir ) = @_;

    # Without a CIDR suffix.
    $static_ip =~ s|/\N*$||;
    my $target_is_up = 0;

    # From the store, or from the disk for a domain that was never sealed.  The
    # domain is the last part of $cfg_dir.
    my $key2use = Trog::Guest->key_path( File::Basename::basename($cfg_dir), "$cfg_dir/key.rsa" );

    my $ssh = Net::SFTP::Foreign->new(
        host     => $static_ip,
        user     => $admin_user,
        more     => [ -o => "StrictHostKeyChecking=no", -o => 'UserKnownHostsFile=/dev/null' ],
        key_path => $key2use
    );
    $ssh->error or $target_is_up = 1;
    return ( $ssh, $target_is_up );
}

main(@ARGV) unless caller;
