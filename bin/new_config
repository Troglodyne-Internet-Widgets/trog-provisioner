package Trog::Provisioner::Config::Generator;

#ABSTRACT: Build provisioning configuration packages for VMs.

use 5.041;

use strict;
use warnings FATAL => 'all';

no warnings qw{experimental};
use re '/aa';

use FindBin::libs;

use YAML::XS;
use File::Slurper;
use File::Slurper::Temp;
use Config::Simple;
use Cwd();
use File::Basename();
use Clone qw{clone};

use Text::Xslate;
use Text::Xslate::Bridge::TT2;
use List::Util qw{uniq any};
use Net::SFTP::Foreign;
use Net::SFTP::Foreign::Constants qw{SSH2_FX_NO_SUCH_FILE};
use Archive::Tar();
use File::Path   qw{make_path remove_tree};
use Getopt::Long qw{GetOptionsFromArray};
use Trog::Config();
use Trog::Credentials();
use Trog::Secrets();
use File::Copy qw{copy};
use Hash::Merge();
use File::Find();

# For secret getting/setting

