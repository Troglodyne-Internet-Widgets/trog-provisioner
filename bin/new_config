# This supplies mirror_only.  With it, the testdeps line of the makefile asks
# cpanm for a release in the same way as scripts/cpan_install.  The require
# does not run the script.
require( Cwd::abs_path( File::Basename::dirname(__FILE__) . '/../scripts/cpan_install' ) );

=head1 USAGE

    new_config [--ipmap=file] [--secrets=file] [--recipes=file] [--skip_ssh] [--credentials] [--dryrun] $domain $domain2 ...

new_config makes a configuration package for each domain that you name.
F<bin/provision> uses the package to build the virtual machine (the guest) and
provision it.

These files control what each domain gets:

    /etc/trog-provisioner/recipes.yaml
    /etc/trog-provisioner/recipes.d/*.yaml
    /etc/trog-provisioner/ipmap.cfg

The files describe your installation, not this software, so they are not in the
checkout.  To use a different set, set C<TROG_PROVISIONER_CONFIG> to the
directory that holds them.  To name one file at a time, use the --recipes and
--ipmap options.  See L<Trog::Config>.

Most of what you put in the main recipes.yaml goes in the _base section:

    _base:
        registrar:
            type: "some_dns_provider_understood_by_dns-lexicon"
            user: "AzureDiamond"
            key: "hunter2"
        _global:
            libdir:
                - path/to/my/custom/libdir
            data_source: "/opt/data"
            install_dir: "/opt/domains"
        adminconfig:
            pkgs:
                - vim
                - tig
                - tmux
                - plocate
                - traceroute
            skel: "/opt/dotfiles/my_dude"
        nosnap:
        nostubresolver:
        auditd:
        ufw:
        fail2ban:
        cron:
        letsencrypt:
        ...

The _base section configures what all your guests need.  You can name any
number of recipes in it, so that the files in recipes.d/ do not repeat them.
The _global section holds the most important values, because more than one
recipe uses them.  You do not have to know all of them now.  If a recipe does
not get a value that it needs, it stops with an error.

If you have recipes of your own, for example proprietary ones, list their
directories in the libdir key of _global.  The value is a list.  Each directory
must hold a lib/ directory and a templates/ directory, with the same layout as
this checkout.  new_config adds each lib/ to C<@INC>.  It searches each
templates/ after the templates in the checkout.

To put more than one domain on one guest, list them in the top-level _shared
section of recipes.yaml:

    _shared:
        shared.host.name:
            - guy.hosted.here
            - otherguy.hosted.here
        ...

In this example, run C<bin/new_config guy.hosted.here>.  It also writes the
configuration for shared.host.name, because guy.hosted.here is built onto that
host.  Then run C<bin/provision guy.hosted.here>.  It provisions
shared.host.name first, and then adds guy.hosted.here to the same guest.  Run
the same two commands for otherguy.hosted.here.

new_config ignores the _base and _shared sections in recipes.d/*.yaml.  This
prevents configuration merges that are hard to diagnose.

=head2 DRY RUNS

With C<--dryrun>, this program changes one thing only.  It leaves the private
key of the guest on the disk where it found it, and does not seal the key.  To
seal a key is to move its private half into the secret store and remove it from
the disk.  The program still writes all its other files.

This flag is narrower than the C<--dryrun> of F<bin/provision>, which is the
flag that an operator passes.  The difference is intentional.  This program
writes configuration and does not destroy anything.  So a dry run has little to
protect, except the key that opens a guest that is up now.

A domain keeps the same key with or without C<--dryrun>.  The only difference is
where the private half stays: on the disk, or in the store.

=head2 IP POOL

The IP pool is the set of static addresses that new guests can get.  To use one,
add an C<[ip_pool]> section to ipmap.cfg:

    [ip_pool]
    ; Space-separated list of all IPs in your static pool
    addresses = 192.168.1.10 192.168.1.11 192.168.1.12 192.168.1.13

    ; OR expand a CIDR block (both keys may coexist; IPs are merged)
    ; cidr = 192.168.1.0/24

new_config gives each domain an address from the pool, and records it in the
address database of L<Provisioner::IPPool>.  A domain keeps its address when you
provision it again.  If the hypervisor gives its guests their addresses,
new_config does not use the pool.

To see which addresses are assigned and which are free, run
C<bin/list_ip_pool>:

    bin/list_ip_pool [--ipmap=/etc/trog-provisioner/ipmap.cfg]

The output shows the full pool, the guest that holds each assigned address, and
the addresses that are still free.

=head2 TESTS

Each recipe can name tests that run on the guest after provisioning.  Use them
for behavior that a makefile failure does not catch, or for results that you
want to report somewhere else.  See the tests() and testdeps() methods in
L<Provisioner::Recipe>.

=head2 SECRETS

You can keep a value out of the recipe configuration and store it in a KeePass
(kdbx) database.  By default, new_config reads
F</etc/trog-provisioner/secrets.kdbx>.  To use a different file, use the
--secrets option.

If the configuration uses a secret, new_config asks you for the password of the
database.  To supply the password without a terminal, use the --credentials
option.  See L<Trog::Credentials>.

An example of a secret in a recipe configuration:

    _base:
        registrar:
            type: "some_dns_provider_understood_by_dns-lexicon"
            user: "AzureDiamond"
            key: "secret:Hosting/DNS/password"

The parts of the path after C<secret:> are, in order, a group, an entry and a
field in the KDBX database.

=cut

our ( $cfile, $sfile, $pfile, $skip_ssh, $dryrun );

sub get_config {
    my $c = Config::Simple->new($cfile);
    die $Config::Simple::errstr unless $c;

    my $global_conf = $c->param( -block => 'global' );
    my $alias_conf  = $c->param( -block => 'aliases' ) // {};
    my $ns_conf     = $c->param( -block => 'nameservers' );
    my $pool_conf   = $c->param( -block => 'ip_pool' ) // {};
    $alias_conf->{$_} = Provisioner::Utils::coerce_arrayref( $alias_conf->{$_} ) for keys %$alias_conf;

    # The [ips] section is not read.  The addresses are in ips.db, where two
    # runs that assign at the same time cannot take the same address.  They are
    # read later, after the domain is known to have a recipe.  This program must
    # not touch the database for a domain that it will refuse.
    return ( $global_conf, $alias_conf, $ns_conf, $pool_conf );
}

sub get_recipe_config {
    return Provisioner::Cookbook->configuration($pfile);
}

sub expand_dependent_domains {
    my $d    = shift;
    my $host = Provisioner::Cookbook->host_of( $d, get_recipe_config() );
    return $d unless defined $host;

    print "Expanding list of configs to generate to include $host\n";
    return ( $host, $d );
}

=head2 %gaps = salvage_gaps()

The state that the last C<main> did not get from the guests it salvaged, keyed
by domain.  To salvage is to copy the state of a service from a guest before the
rebuild.  The hash is empty when there is nothing to report.

This is not a return value, because this program intentionally exits 0 in this
case.  It writes configuration and does not destroy anything.  A failure here
keeps back the configuration that somebody needs to fix the permissions.  It
also runs from cron to take backups.  There, a stop for one directory that it
cannot read abandons every domain after it.
F<bin/provision> destroys the guest, so it is the program that must refuse, and
it gets its answer here.

The hash holds only the alarming gaps.  A path that is not on the guest has
nothing to salvage.  Every first build of a guest looks like that.  See
C<_salvage_gap>.

=cut

our %SALVAGE_GAPS;

# The recipes that each domain runs, keyed by domain.  When a domain goes onto
# the guest of another domain, it is compared with what that host already runs.
# A guest with several domains has one of each service for all of them.
# expand_dependent_domains puts the host before the domains on it.  So when a
# tenant is generated, its host is already in this hash.
our %MACHINE_MODULES;

sub salvage_gaps { return %SALVAGE_GAPS }

sub main {
    my @args = @_;

    # Clear the gaps of the last run.  The tests call main() more than once in
    # one process, and so will any other caller that generates two
    # configurations.
    %SALVAGE_GAPS = ();

    my $credentials;
    GetOptionsFromArray(
        \@args,
        'ipmap=s'     => \$cfile,
        'secrets=s'   => \$sfile,
        'recipes=s'   => \$pfile,
        'skip_ssh'    => \$skip_ssh,
        'credentials' => \$credentials,
        'dryrun'      => \$dryrun,
    );

    # This loads the password of the secrets database, for a run that has no
    # terminal to ask on.  It loads only when you ask.  See Trog::Credentials.
    Trog::Credentials->load() if $credentials;
    $skip_ssh //= 0;
    $cfile    //= Trog::Config->path('ipmap.cfg');
    $sfile    //= Trog::Config->path('secrets.kdbx');
    $pfile    //= Trog::Config->path('recipes.yaml');

    # Add to the list each host that a domain goes onto.
    @args = uniq map { expand_dependent_domains($_) } @args;

    foreach my $d (@args) {
        my $res = handle_domain($d);
        return $res if $res;
    }
    return 0;
}

# Put the defaults of the distribution under the values that _global gives.
# _global goes to every recipe without validation.  So a default that applies
# only when the distro recipe is validated gets to no other recipe.  See
# Provisioner::DistroRecipe/global_defaults.

sub apply_global_defaults {
    my ( $distro, $global_config ) = @_;

    %$global_config = ( $distro->global_defaults, %$global_config );

    return $global_config;
}

# The configuration keys that tell the hypervisor how to build the guest, not
# what goes on it.  So they go in provision.conf, not in a template.
#
# The vm recipe uses them, so this sub gets them from its schema.  In the past,
# this file had a hardcoded list, and example.test/provision.conf had comments
# about each key.  The two did not know about each other.  So a key added to one
# was missing from the other.  Now, bin/recipes vm prints the list.
sub hv_settings {
    my $props = Provisioner::Cookbook->properties( { Provisioner::Cookbook->spec('vm') } );

    # Leave out the readOnly keys.  The hypervisor sets those itself, for
    # example the volume that it made and the MAC that it gave the guest.  A
    # key of that kind from _global points the domain XML at a device that does
    # not exist.
    my @settings = sort grep { !$props->{$_}{readOnly} } keys %$props;
    return @settings;
}

# Choose the hypervisor for this guest.  The first choice is the hypervisor
# that already has the guest.  The second is one that has room.  If no fleet is
# configured, the guest goes on this machine.
sub choose_hypervisor {
    my ( $domain, $requirements ) = @_;

    # If the operator gave --connect, they chose the hypervisor.  Use it.
    my $chosen = Trog::HV->new();
    return $chosen if $chosen->explicit;

    my $fleet = Trog::Hypervisors->load( Trog::Hypervisors->default_path() );
    return $chosen unless $fleet->configured;

    return $fleet->select_for( $domain, $requirements );
}

## no critic(CognitiveComplexity::ProhibitExcessCognitiveComplexity)
sub handle_domain {
    my ( $domain, $hv ) = @_;

    die "Must pass domain" unless $domain;

    my ( $global_conf, $alias_conf, $ns_conf, $pool_conf ) = get_config();

    my $basedir = $global_conf->{basedir};
    die "Must have basedir defined in global section of $cfile" unless $basedir;

    my $admin_user = $global_conf->{admin_user};
    die "Must set admin_user in global section of $cfile" unless $admin_user;

    # The keys of the administrator are in a file beside the rest of the
    # configuration.  In the past, cloud-init got them at first boot from a gh:
    # identity.  That fetch went to GitHub while the guest started.  A slow
    # answer delayed every provision, and an outage stopped the provision.  Also,
    # a raw public key had no place to go.
    my $keyfile    = Trog::Config->path('admin_authorized_keys');
    my @admin_keys = grep { length && !m/\A[#]/ } map { s/\A\s+|\s+\z//gr } split( m/\n/, File::Slurper::read_text($keyfile) );
    die "No administrator keys in $keyfile.\nbin/preflight will offer to seed it with ssh-import-id.\n" unless @admin_keys;

    my $admin_gecos = $global_conf->{admin_gecos};
    die "Must set admin_gecos in global section of $cfile" unless $admin_gecos;

    my $admin_email = $global_conf->{admin_email};
    die "Must set admin_email in global section of $cfile" unless $admin_email;

    my $gateway = $global_conf->{gateway};
    die "Must set gateway (ipv4) in global section of $cfile" unless $gateway;

    # Coerce the value to a list here, one time.  All the code below reads it as
    # a list, but Config::Simple gives a plain string for a key with one value.
    # In the past, the coercion was further down, into the global
    # configuration, and this copy stayed a scalar.  So an installation with
    # exactly one resolver got "Can't use string as an ARRAY ref" from the
    # provision.conf line, and no guest.
    my $resolvers = Provisioner::Utils::coerce_arrayref( $global_conf->{resolvers} );
    die "Must set resolvers in global section of $cfile" unless @$resolvers;

    # A loopback address answers only on a guest that runs its own DNS server.
    # For that guest, the recipe that turns off the stub listener puts loopback
    # first.  See Provisioner::Recipe::nostubresolver.  If ipmap.cfg names it
    # here, it goes to every guest, and most of them have nothing that listens
    # on it.  nginx in the fetch cache uses the addresses in this list in turn.
    # So every few lookups got a refused connection, and
    # Provisioner::Recipe::fetchcache removes loopback from the list again.
    my @loopback = grep { m/\A127[.]/ || $_ eq '::1' } @$resolvers;
    die "resolvers in the global section of $cfile names @loopback, which only answers on a guest that runs its own DNS server.\n" . "Take it out: nostubresolver puts it in front for a guest running pdns, and every other guest spends its first lookup on an address nothing is listening at.\n"
      if @loopback;

    # Every domain is fully qualified, here and in recipes.d.  This program does
    # not append a tld, and an addon is not a different kind of domain.  A
    # domain that is not under your usual parent is a domain like the others,
    # written in full.
    my $fqdn = $domain;
    my ( undef, $tld ) = split( quotemeta('.'), $domain, 2 );
    die "'$domain' is not a fully qualified domain name.\n" . "Domains are spelled out in full now, in ipmap.cfg and in recipes.d alike:\n" . "  new_config $domain.example.com\n"
      unless defined $tld && length $tld;

    # Read the recipe configuration.
    my $rconf = clone( get_recipe_config() );

    die "No recipe configuration found for '$domain'. Add a '$domain' key to your recipes.yaml (or recipes.d/) configuration.\n"
      unless exists $rconf->{$domain};

    # Ask for the password of the secret store only now, when the domain is
    # known to have a recipe.  Do not prompt a person for a domain that has no
    # recipe.  An address from the pool is the other thing that this program
    # cannot take back.  It comes later, because it needs the hypervisor.  The
    # hypervisor decides if there is an address of ours to give at all.
    #
    # A recipe holds a reference to the location of a password, not the
    # password.
    my %to_replace = Trog::Secrets->needed($rconf);
    my $keepass;
    if (%to_replace) {
        $keepass = Trog::Credentials->prompt( 'Enter password:', 'keepass' );
        my %secrets = Trog::Secrets->lookup( $sfile, $keepass, %to_replace );
        Trog::Secrets->apply( $rconf, %secrets );
        %secrets = ();

        # Give this copy to Provisioner::Cookbook, because a recipe asks
        # Cookbook about the other recipes on the guest.  The references became
        # passwords in the clone above, not in the copy that Cookbook kept.  In
        # the past, a recipe that read the credential of another recipe got the
        # reference.  It wrote the reference into the file that was to
        # authenticate with the password.
        Provisioner::Cookbook->remember( $pfile, $rconf );
    }

    # Read the _global values of the _base set of recipes, but do not remove
    # _base.  Provisioner::Cookbook does the merge below, and it needs the full
    # configuration.
    my $base_globals = clone( $rconf->{_base}{_global} // {} );

    # This run does not need to know yet if the domain goes onto another host.
    delete $rconf->{_shared};

    my ($dep_dom) = expand_dependent_domains($domain);

    my $depends_on;
    $depends_on = $dep_dom if $dep_dom ne $domain;

    # Every domain has some global configuration, and all the recipes must get
    # it.
    my $global_config = delete $rconf->{$domain}{_global} // {};
    $global_config = { %$base_globals, %$global_config };

    # _global names the distribution of the guest.  The distribution decides
    # the base image, the packager and its commands, and which templates are
    # searched first.  It also decides which version of each recipe gives the
    # package names.
    #
    # Make sure that the name is correct here, not at the require further down.
    # A typing error such as `distro: unbuntu` must not fall back to the generic
    # recipes without a warning.  If it does, the guest gets no packages.
    my $distro_name = $global_config->{distro} // 'ubuntu';
    die "There is no '$distro_name' distro recipe, which $domain asks for as its distro.\n" . 'There is: ' . join( ', ', Provisioner::Cookbook->distros() ) . "\n"
      unless any { $_ eq $distro_name } Provisioner::Cookbook->distros();

    # Choose the hypervisor for the guest.
    #
    # The recipe gives the memory, disk and CPU that the guest needs.  That is
    # all the data that placement needs.  So the choice is made here, not after
    # provision.conf is written, and provision.conf does not have to hold it.
    $hv //= choose_hypervisor( $domain, $global_config );

    # If the hypervisor gives its guests their addresses, do not use the pool.
    # There is no address of ours to give.  An address taken from the pool
    # stays reserved for a guest that never answers at it.
    my ( $static_ip, $ip_conf ) = ( undef, {} );
    if ( !$hv->manages_addresses ) {
        Provisioner::IPPool::ensure_seeded($pool_conf);

        # One transaction, so that many provisions at the same time cannot give
        # two guests the same address.  It is idempotent (safe to run again).
        # So a domain that you provision again keeps its address.
        $static_ip = Provisioner::IPPool::assign( $domain, $pool_conf );
        $ip_conf   = Provisioner::IPPool::assignments();

        # Every domain is written in full.  A single label is left from the time
        # when this program appended a tld.  Refuse it, so that it does not go
        # into a zone file without a warning.
        my @unqualified = grep { index( $_, q{.} ) < 0 } sort keys %$ip_conf;
        die "These domains in " . Provisioner::IPPool::db_path() . " are not fully qualified:\n" . join( '', map { "  $_\n" } @unqualified ) . "There is no tld to append any more.  Spell them out, as recipes.d already does.\n"
          if @unqualified;
    }

    # The guest gets its payload from this machine.  This machine supplies the
    # address, the user and the port.  Nothing is copied to the hypervisor for
    # the guest to get.  The guest comes to this machine for it.
    my $this_machine = Trog::Local->new();

    # The NAT bridge of the hypervisor.  It is one of the networks that this
    # machine can share with the guest.  A cloud has no such bridge, and no
    # address of its own through which a guest is reached.
    my $tld_ip        = $hv->manages_addresses ? undef : $hv->virbr_ip;
    my $transfer_port = $global_conf->{transfer_port} // $this_machine->sshd_port;
    my $transfer_user = $global_conf->{transfer_user} // $this_machine->transfer_user;
    die "Could not work out the transfer user on " . $this_machine->describe . "\n" unless $transfer_user;

    # Which of our addresses to use depends on how this machine connects to the
    # networks of the guest.  So the routing table is asked, not assumed.  You
    # can override the answer.  If a machine has several routes to the same
    # place, the kernel cannot choose between them for us.
    #
    # Try the address of the guest first, then the NAT bridge of the
    # hypervisor.  This machine can share either network with the guest.  A
    # workstation that is not a guest itself shares the static subnet.
    #
    # Collect every address of ours that gets to the guest, not only the one
    # that the guest fetches from.  The address that we connect from depends on
    # the hypervisor.  A remote one is administered over the static address of
    # the guest, and a local one over its NAT lease.  So the firewall of the
    # guest must accept all of them.  The fetch uses the first address, because
    # the rsync in the template names one address.
    my @towards = grep { defined $_ && length $_ } ( $static_ip, $tld_ip );

    my @transfer_ips = $global_conf->{transfer_ip} ? ( $global_conf->{transfer_ip} ) : ( @towards ? $this_machine->transfer_ips(@towards) : () );
    my $transfer_ip  = $transfer_ips[0];

    # No address of the guest is a different problem from no route to it.  A
    # cloud gives the guest its address when it creates the guest.  So at this
    # point, there is no address to ask the routing table about.  You must give
    # the answer in the configuration, because this program cannot find it.
    die "There is no address of $fqdn to work out which of ours it can reach.\n" . $hv->describe . " allocates that when the guest is created, so it cannot be\n" . "known here.  Name the address a guest fetches from as transfer_ip in the\n" . "[global] section of ipmap.cfg.\n"
      if !$transfer_ip && !@towards;

    die "Nothing on " . $this_machine->describe . " can be reached from $fqdn.\n" . "A guest fetches its payload from here, so it needs an address of ours it can\n" . "get to -- and none of " . join( ', ', @towards ) . " routes anywhere from this\n" . "machine.  Put it on one of those networks, or name the address as\n" . "transfer_ip in the [global] section of ipmap.cfg.\n"
      unless $transfer_ip;

    # Where the files of this domain go on the guest, and where the files that
    # are sent to it come from.  Ask before _base is removed, because a fleet
    # usually sets them one time in _base for every domain.
    #
    # _global sets these values, not the data recipe.  Every recipe
    # interpolates install_dir.  In the past, it came from the `to` field of
    # data.  So every recipe depended on data for a path, not for what data
    # does.  That kept data from being an ordinary recipe.
    $global_config->{install_dir} //= Provisioner::Cookbook->install_dir( $domain, $rconf );
    $global_config->{data_source} //= Provisioner::Cookbook->data_source( $domain, $rconf );

    # This is the same merge that every other caller uses to get the
    # configuration of a domain.  It works on this copy, not on the file, so
    # the secrets resolved above stay in it.
    $rconf->{$domain} = Provisioner::Cookbook->domain_config( $domain, $rconf );
    delete $rconf->{_base};

    # bin/new_guest writes CHANGEME for each value that a recipe requires and
    # has no default for.  A placeholder is a valid string, so no code further
    # down refuses it.  Validation passes, the guest builds, and the database
    # gets a root password of CHANGEME.  So refuse placeholders here.  Do it
    # after the merge, because _base can supply the real value.
    my @unfilled = Provisioner::Cookbook->placeholders_in( $rconf->{$domain} );
    die "Still unfilled in the configuration for $domain:\n" . join( '', map { "  $_\n" } @unfilled ) . "Each of these is a " . Provisioner::Cookbook->PLACEHOLDER . " that new_guest left for you.\n" if @unfilled;

    # Add the recipes of this site to the search path.
    my $libdirs = $global_config->{libdir} // [];
    foreach my $libdir (@$libdirs) {
        print "Including vendor libs from $libdir/lib\n";
        push( @INC, "$libdir/lib" );
    }

    # The directory of the distribution comes first.  So templates/ubuntu/nginx.tt
    # is found before templates/nginx.tt, and is used.  That order is the full
    # mechanism, and no code has to know about it.
    my @paths = @{ Provisioner::Cookbook->template_dirs( $distro_name, @$libdirs ) };

    # Refuse a domain with no data_source here, not further down.  Then all the
    # code after this point gets the same answer.  That includes the tests that
    # data renders and the state that each recipe salvages.
    die "Nothing says where $fqdn's data comes from: set data_source in _global.\n"
      unless defined $global_config->{data_source} && length $global_config->{data_source};

    my $data_dir = "$global_config->{data_source}/$fqdn";

    my @data_users;
    my $data_users_f = "$data_dir/users.yaml";
    ## no critic (ValuesAndExpressions::ProhibitFiletest_f)
    if ( -f $data_users_f ) {
        my $data_users_yaml = YAML::XS::Load( File::Slurper::read_binary($data_users_f) );
        @data_users = @{ $data_users_yaml->{users} };
    }

    # Make a users.yaml from ipmap.cfg and from a users.yaml in the data
    # directory, if one is there.
    my $user_conf = {
        users => [
            {
                gecos               => $admin_gecos,
                name                => $admin_user,
                shell               => '/bin/bash',
                sudo                => 'ALL=(ALL) NOPASSWD:ALL',
                ssh_authorized_keys => [@admin_keys],
            },
            @data_users,
        ],
    };

    my $cfg_dir = "$basedir/$fqdn";
    if ( !-d $cfg_dir ) {
        mkdir $cfg_dir or die "could not create $cfg_dir";
    }

    File::Slurper::Temp::write_binary( "$cfg_dir/users.yaml", YAML::XS::Dump($user_conf) );

    # Give the list of users to all the templates, for example the LDIF that
    # seeds ldap.
    $global_config->{users} = $user_conf->{users};

    my %fragments;
    my %global_fragments;

    my $root_scripts = '/root/bin';

    my %formatters = (
        tabinate => Text::Xslate::html_builder(
            sub {
                my $input = shift;
                $input =~ s/^\s*/\t/mg;
                return $input;
            }
        ),
    );

    my $tt = Text::Xslate->new(
        {
            path     => \@paths,
            syntax   => 'TTerse',
            module   => [qw{Text::Xslate::Bridge::TT2}],
            function => \%formatters,
        }
    ) || die "Could not initialize template dir";

    # Load the class, not an instance.  Each question asked of it here is about
    # the distribution, not about this guest.  The depsolver below builds the
    # object that renders its files, as it does for every other recipe.  Two
    # objects for one recipe give two chances to generate the key of the guest.
    my $distro = Provisioner::Cookbook->load($distro_name);

    my %provisioner_opts = (
        distro          => $distro_name,
        target_packager => $distro->packager,
        script_loc      => $root_scripts,
        output_dir      => $cfg_dir,
        template_dirs   => \@paths,

        # The hypervisor chosen above.  Every builder gets it here, and does not
        # find one for itself.  vm and the distro recipe both ask a hypervisor
        # what it accepts.  A recipe that calls Trog::HV->new() itself asks
        # again a question that placement already answered.
        hv => $hv,
    );

    # Every web host gets its own www and mail CNAMEs.  In the past, there were
    # two forms: a bare one for an addon, and a prefixed one for other domains.
    # This program appended a tld to one of them and not to the other.  Both
    # gave www.<fqdn>.  Now that every domain is written in full, there is one
    # form.  $each_domain is not the $subdomain above.  It is each domain in the
    # map, not the domain that this run builds.
    foreach my $each_domain ( keys(%$ip_conf) ) {
        $alias_conf->{$each_domain} = Provisioner::Utils::coerce_arrayref( $alias_conf->{$each_domain} );
        push( @{ $alias_conf->{$each_domain} }, map { "$_.$each_domain" } qw{www mail} );
        $alias_conf->{$each_domain} = [ uniq @{ $alias_conf->{$each_domain} } ];
    }

    # The guest gets its payload with rsync before its DNS works.  So this value
    # must be an address, not a name.
    $global_config->{transfer_ip}  = $transfer_ip;
    $global_config->{transfer_ips} = \@transfer_ips;
    $global_config->{tld}          = $tld;
    $global_config->{admin_user}   = $admin_user;
    $global_config->{admin_email}  = $admin_email;

    # The rest of the data about who administers a guest and where it is on the
    # network.  The gateway comes from the same [global] block as the two values
    # above.  It was the one value in that block that a recipe did not get.
    # That was an oversight, not a decision.  Provisioner::Recipe::trogrunner
    # found it, because it writes an ipmap.cfg of its own and had no way to read
    # this one.  The keys are here for the same reason.  A runner must authorize
    # a person on the guests that it builds, and the keys are no longer a
    # configuration value that it can copy.
    $global_config->{admin_keys}    = [@admin_keys];
    $global_config->{gateway}       = $gateway;
    $global_config->{domain}        = $fqdn;
    $global_config->{ipmap}         = $ip_conf;
    $global_config->{aliases}       = $alias_conf;
    $global_config->{nameservers}   = $ns_conf;
    $global_config->{main_ip}       = $static_ip;
    $global_config->{tld_ip}        = $tld_ip;
    $global_config->{transfer_user} = $transfer_user;
    $global_config->{transfer_port} = $transfer_port;

    apply_global_defaults( $distro, $global_config );

    # The cache address is found one time, here, not by each recipe.  See
    # Provisioner::DistroRecipe/cache_address.  The resolvers were for the
    # distro recipe only, and now go to every recipe.  A recipe that runs a
    # resolver of its own must know where to send queries.  An example is nginx
    # in the fetch cache.
    $global_config->{cache_ip}  = $distro->cache_address(%$global_config);
    $global_config->{resolvers} = $resolvers;

    # The directory for the tests of every recipe, data included.  data is a
    # module now.  So the loop below renders its tests from its final
    # configuration, not from its first one.
    mkdir "$cfg_dir/t";

    $global_config->{script_dir} = $root_scripts;

    my ( @pkgs, @generated );

    # This can run on a system that exists already, so install the packages of
    # the distribution in all cases.
    push( @pkgs, $distro->deps() );

    $global_config->{packager_invocation}        = $distro->packager_invocation;
    $global_config->{packager_up_invocation}     = $distro->packager_up_invocation;
    $global_config->{packager_remove_invocation} = $distro->packager_remove_invocation;

    # Find out if the remote host is up.
    #
    # This uses sftp, because to open the connection is the probe.  That is the
    # only use of this handle now.  In the past, it also answered the question
    # of _salvage_gap: was a directory that salvaged nothing missing, or only
    # unreadable?  Here, that was one status code.  Now the fetch reads the
    # files that the service owns.  So the question is if the path holds
    # anything.  sftp cannot answer that without the privileges that the fetch
    # uses.  Nothing is fetched over this handle.  _salvage_guest does that.
    my ( $ssh, $target_is_up );

    # Do this only if there is an address to try.  If the hypervisor gives the
    # guest its address, the guest has none until it is built.  A guest that
    # does not exist yet has nothing to salvage.
    ( $ssh, $target_is_up ) = _get_sftp( $static_ip, $admin_user, $cfg_dir )
      if !$skip_ssh && defined $static_ip && length $static_ip;

    # Make a makefile from the configured recipes.
    #
    # The distro recipe goes in the list, so that the depsolver resolves it like
    # the other recipes.  The depsolver finds the dependencies of each recipe.
    # The distro recipe pulls in the vm recipe, and the same merge configures
    # both of them.  Neither one stays a module.  The code below removes them.
    my @modules = ( $distro_name, sort keys( %{ $rconf->{$domain} } ) );

    my %mf_vars;
    my @testdeps;
    my @empty_salvage;
    my @conflicts;
    my @modules_ordered;

    # One builder for each recipe, keyed by name.
    my %builders;

    # Find what each recipe requires, and what those recipes require in turn.
    # Also find the configuration that each dependent recipe gave it.  This is in
    # Provisioner::Cookbook, so that bin/new_guest can ask the same question.
    # In the past, bin/new_guest did its own walk, and the two became different.
    # Its walk did not see the half of the dependencies from the base class.
    my ( $solved, $built ) = Provisioner::Cookbook->resolve_dependencies(
        modules       => \@modules,
        domain_conf   => $rconf->{$domain},
        global_config => $global_config,
        distro        => $distro_name,
        provisioner   => \%provisioner_opts,
        domain        => $domain,
        host          => $depends_on,
        host_conf     => defined $depends_on ? $rconf->{$depends_on} : undef,
    );
    @modules  = @$solved;
    %builders = %$built;

    # Remove the two recipes that direct the build and do not run in it.  They
    # are the distro recipe and the vm recipe that it depends on.  They are
    # removed here, after they were added, because the depsolver above had to
    # configure them and pull in each other.
    #
    # The makefile skips a recipe with no fragment, so it does not need this.
    # But every template and every recipe gets `modules` as the list of what is
    # on this guest.  Neither of these two recipes is on the guest.
    @modules = grep { $builders{$_}->is_module } @modules;

    # A guest has one of each service.  Some recipes cannot serve a second
    # domain.  Such a recipe does not add this domain.  It replaces the first
    # one.  So refuse here, where an operator reads the output.  Otherwise the
    # first domain stops without a warning on the guest, an hour later.
    #
    # This compares with the host only.  expand_dependent_domains puts a host
    # and one of the domains on it in the same run, never two of those domains.
    # So this does not find two tenants that conflict with each other.
    $MACHINE_MODULES{$domain} = [@modules];
    if ($depends_on) {
        my %on_host = map  { $_ => 1 } @{ $MACHINE_MODULES{$depends_on} // [] };
        my @cannot  = grep { $on_host{$_} && !$builders{$_}->is_multi_tenant } @modules;

        die "$domain is provisioned onto $depends_on, and both are configured with: " . join( ', ', @cannot ) . "\n" . "There is one of that on a guest, and it cannot be told about a second domain -- so this\n" . "would replace what $depends_on configured rather than add to it.  Configure it on one of\n" . "the two, or give $domain a machine of its own.\n"
          if @cannot;
    }

    my %guest_secrets;

    # The dependencies are resolved.  Now process the modules.
    foreach my $module (@modules) {
        my $builder = $builders{$module};
        my $pconf   = $rconf->{$domain}{$module};

        # Aliases in ipmap.cfg are also fully qualified.  Nothing is appended.
        my $aliases      = $alias_conf->{$domain} // [];
        my $full_aliases = [@$aliases];
        if ( $builder->has_global_template() ) {
            $global_fragments{$module} = $builder->render_global(
                $builder->takes(%$global_config),
                %$pconf,
                full_aliases => $full_aliases,
                modules      => \@modules,
            );
            push( @modules_ordered, "/etc/provisioner/state/global_$module" );
        }
        if ( $builder->has_template() ) {
            $fragments{$module} = $builder->render(
                $builder->takes(%$global_config),
                %$pconf,
                full_aliases => $full_aliases,
                modules      => \@modules,
            );
            push( @modules_ordered, "/etc/provisioner/state/$fqdn/$module" );
        }
        push( @pkgs,      ( $builder->deps(%$pconf) ) );
        push( @conflicts, ( $builder->dep_conflicts(%$pconf) ) );

        # Get the makefile variables for the target of this recipe.
        my %t_vars = $builder->makefile_vars();
        %mf_vars = ( %mf_vars, %t_vars ) if %t_vars;

        # Files that the guest must have, but that must not go in the payload.
        # The store holds them, and bin/provision puts them on the guest.  They
        # are collected here and resolved together below.  So a run asks for the
        # password of the store one time.
        %guest_secrets = ( %guest_secrets, $builder->guest_secrets( $global_config->{install_dir}, $fqdn, %$pconf ) );

        # Make the directories that the recipe needs in the data directory.
        foreach my $d ( $builder->datadirs() ) {
            make_path("$data_dir/$d") unless -d "$data_dir/$d";
        }

        # Copy the state from the guest that exists now.
        if ($target_is_up) {
            print "Backing up $module files from $fqdn\n";
            my %tg   = $builder->remote_files( $global_config->{install_dir}, $fqdn );
            my @skip = $builder->remote_skip();

            # Do this before any file comes down.  Then the files show the guest
            # as it is now, not as it was at the last run of its cron job.
            refresh_salvage(
                static_ip  => $static_ip,
                admin_user => $admin_user,
                cfg_dir    => $cfg_dir,
                module     => $module,
                commands   => [ $builder->remote_prepare( $global_config->{install_dir}, $fqdn ) ],
                watched    => [ sort keys %tg ],
            );
            foreach my $to_fetch ( sort keys(%tg) ) {
                print "Fetching $to_fetch into $data_dir/$tg{$to_fetch}\n";

                # The return value is not examined, intentionally.  If the
                # salvage got nothing, _salvage_gap below reports it.  Its
                # message tells more about the cause than a return value.  If
                # the salvage got part of the state, the domain is still better
                # off than if the rest were abandoned.
                _salvage_guest( $static_ip, $admin_user, $cfg_dir )->get_dir(
                    $to_fetch,
                    "$data_dir/$tg{$to_fetch}",

                    # These are directories.  A recipe can keep files in one
                    # that must stay on the machine that made them.  See
                    # remote_skip in Provisioner::Recipe.  Those files are not
                    # fetched and then deleted.  They stay, because this runs
                    # against a live guest that still needs them.
                    exclude => \@skip,

                    # The sftp fetch called this newer_only.  If the copy on the
                    # guest is older than ours, it stays where it is.
                    update => 1,

                    # Run as root on the guest.  A recipe salvages the state
                    # directory of a service.  The service owns it, and no other
                    # user can open it.  For example, redis is 0750
                    # redis:redis, slapd.d is 0700 openldap, and a PKI is 0600
                    # root.  Without privileges, the fetch made the local
                    # directories, copied nothing into them, and reported
                    # success.  That looks the same as a guest that never ran
                    # the service.
                    sudo => 1,
                );

                my $gap = _salvage_gap(
                    guest       => _salvage_guest( $static_ip, $admin_user, $cfg_dir ),
                    recipe      => $module,
                    host        => $fqdn,
                    user        => $admin_user,
                    remote      => $to_fetch,
                    destination => "$data_dir/$tg{$to_fetch}",
                );
                next unless $gap;

                # Use warn, not print.  The rest of a run is many lines of
                # progress on STDOUT.  The line that says the state of a service
                # did not come down must stay visible after it scrolls past.
                # warn also goes through the warn handler.  So a caller can send
                # these messages to a place other than the terminal.
                warn $gap->{message} . "\n";
                push( @empty_salvage, $gap ) if $gap->{alarming};
            }
        }

        # Render the templates of the recipe.  These files go in the payload.
        # That is the difference between them and the files of the director
        # below.
        push( @generated, $builder->generate_files( $cfg_dir, $builder->takes(%$global_config), %$pconf, full_aliases => $full_aliases, modules => \@modules ) );

        # Write the tests of the recipe, if it has any.
        my @tests = $builder->tests();
        foreach my $test (@tests) {
            my $tname = $test;
            $tname =~ s/tt$/t/;
            my $rendered = $builder->render_file( "tests/$test", $builder->takes(%$global_config), %$pconf, full_aliases => $full_aliases, modules => \@modules );
            print "Writing $test as $tname\n";
            File::Slurper::Temp::write_binary( "$cfg_dir/t/$tname", $rendered );
        }

        # Collect the dependencies of the tests.
        push( @testdeps, ( $builder->testdeps(@modules) ) );
    }
    @testdeps = uniq @testdeps;
    push( @pkgs, 'cpanminus' ) if @testdeps;

    @pkgs      = sort { $a cmp $b } uniq @pkgs;
    @conflicts = uniq @conflicts;

    # Remove each package that a recipe names as a conflict.
    @pkgs = grep {
        my $pkg = $_;
        !any { $_ eq $pkg } @conflicts;
    } @pkgs if @conflicts;

    my $extra_packages = join( ', ', @pkgs );

    # Take data out of the module machinery, here and nowhere else.  data went
    # through the loop like every other recipe.  That is how the other recipes
    # gave it their restores.  But its target is not one of the ordered ones.
    # makefile.tt puts it first, by hand, because each recipe must find its
    # state already restored.
    #
    # Both lines are necessary.  The first supplies the data_fragment that the
    # template expects.  If data stays in %fragments, the makefile gets a
    # second state/data: target, and make uses it instead of the first.  The
    # second line keeps data off the prerequisite list of all:.  On that list,
    # it runs last.
    #
    # The path is compared exactly, not matched.  So a domain called 'data'
    # keeps its own target.
    #
    # The fragment is empty, not undef.  makefile.tt writes the data target for
    # every guest, and sends this value through a formatter that substitutes on
    # it.  But the data recipe is in the build only when a recipe declares
    # restores.
    my $data_fragment = delete $fragments{data} // q{};
    @modules_ordered = grep { $_ ne "/etc/provisioner/state/$fqdn/data" } @modules_ordered;

    # ufw comes out for the opposite reason.  It must run after every other
    # recipe, not before them.  templates/makefile.tt tells why.  The template
    # sets its position, so alphabetical order does not decide it.
    my $ufw_fragment = delete $fragments{ufw};
    @modules_ordered = grep { $_ ne "/etc/provisioner/state/$fqdn/ufw" } @modules_ordered;

    # The hosts that the recipes of this guest download from.  While the guest
    # provisions, these names point at the fetch cache.  The guest also gets
    # the authority that signs the certificate of the cache, and trusts it
    # during that time.  See Provisioner::Recipe/fetch_hosts and
    # scripts/fetch_via_cache.  Only the certificate goes to the guest.  Its
    # key stays on this machine.
    #
    # Each module is asked with its own configuration.  A recipe can have a
    # configured upstream, for example a repo_url or an api_url that is not the
    # default.  Then it names the host that it really connects to.  The cache
    # makes its certificate from Cookbook::fetch_hosts.  That is asked of the
    # class, and cannot see the configuration.  A cache that serves a
    # configured upstream needs that host in its own upstreams.
    my @fetch_hosts =
      $global_config->{cache_ip}
      ? uniq( sort map { $builders{$_}->fetch_hosts( %$global_config, %{ $rconf->{$domain}{$_} // {} } ) } @modules )
      : ();
    if (@fetch_hosts) {
        copy( Provisioner::Cookbook->load('fetchcache')->authority()->{cert}, "$cfg_dir/fetchcache-ca.crt" )
          or die "Could not give $fqdn the fetch cache's authority: $!\n";

        # Put it in the tarball with the files that the recipes generated.  No
        # other file in $cfg_dir gets to the guest.
        push( @generated, 'fetchcache-ca.crt' );
    }

    my $makefile = $tt->render(
        'makefile.tt',
        {
            %$global_config,
            data_fragment    => $data_fragment,
            ufw_fragment     => $ufw_fragment,
            fragments        => \%fragments,
            global_fragments => \%global_fragments,
            modules_ordered  => \@modules_ordered,

            # The ssl target puts each of these names in its certificate.
            full_aliases     => $alias_conf->{$fqdn} // [],
            vars             => \%mf_vars,
            packages         => \@pkgs,
            state_dir        => "/etc/provisioner/state/$fqdn",
            global_state_dir => "/etc/provisioner/state",
            testdeps         => \@testdeps,
            testdeps_flags   => [ Trog::Script::CpanInstall::mirror_only(@testdeps) ],
            fetch_hosts      => @fetch_hosts ? \@fetch_hosts : undef,
        }
    );

    print "Writing Makefile to $cfg_dir\n";
    File::Slurper::Temp::write_binary( "$cfg_dir/Makefile", $makefile );

    write_guest_secrets( $cfg_dir, $fqdn, \%guest_secrets, $sfile, $keepass );

    my $r_text = join( ', ', @$resolvers );

    # Write the files that a guest boots from the first time.  They are its
    # network configuration, its cloud-init, the setup script that fetches the
    # payload, and the destination of its logs.  They are ordinary
    # template_files of the distro recipe.  They are rendered in the same way as
    # the generated files of every other recipe.
    #
    # They are rendered after the loop, not in it.  The user-data lists the
    # packages that are passed in below.  @pkgs is not final until the loop has
    # collected the dependencies of every recipe and removed the conflicts.
    #
    # The last position inside the loop also solves that problem.  That is how a
    # dependency usually gets its turn: lastuniq puts a recipe after the last
    # recipe that pulled it in.  But that works only while every recipe on the
    # guest pulls in the distro recipe.  Every recipe in the namespace of the
    # distribution must then declare the dependency.  Also, no recipe from
    # outside that namespace can sort after them, for example a vendor recipe or
    # a later required_recipes.  A separate pass does not depend on any of that.
    #
    # The separate pass also keeps these files out of the payload, and they must
    # stay out of it.  user-data holds the private half of the key of the guest.
    # setup.sh gets to the guest inside cloud-init, not in the tarball that it
    # fetches.  In the loop, that is a special case.
    #
    # Only the distro recipe does this.  The other director is the vm recipe.
    # Its one file names a storage volume, a base image and a seed ISO.  Their
    # paths do not exist until a hypervisor makes them.  So bin/provision
    # generates that file, because bin/provision has a hypervisor.

    # Put the sealed key back beside the recipe before the recipe looks for it.
    # seal_key removes the private half from the disk, and leaves only the
    # public half here.  A recipe that cannot find a pair makes a new one.  The
    # salvage pass above already got this same key to connect to the guest
    # that is up.
    my $sealed = Trog::Guest->key_path( $fqdn, "$cfg_dir/key.rsa" );
    ## no critic (ValuesAndExpressions::ProhibitFiletest_f) -- whether it is already the file we want
    if ( defined $sealed && $sealed ne "$cfg_dir/key.rsa" && !-f "$cfg_dir/key.rsa" ) {
        File::Slurper::Temp::write_binary( "$cfg_dir/key.rsa", File::Slurper::read_binary($sealed) );
        chmod 0600, "$cfg_dir/key.rsa";
    }

    print "Writing what $fqdn first boots from, out of the $distro_name recipe\n";
    $builders{$distro_name}->generate_files(
        $cfg_dir,
        $builders{$distro_name}->takes(%$global_config),
        %{ $rconf->{$domain}{$distro_name} // {} },
        packages      => \@pkgs,
        ips           => [ grep { defined } $static_ip ],
        gateway       => $gateway,
        contact_email => $admin_email,
        payload_dir   => $basedir,
        ( defined $dryrun ? ( dryrun => $dryrun ) : () ),
        modules => \@modules,
    );

    # Then put the private half into the store, not in the domain directory.
    # Do this after generate_files, which makes a key for a domain that had
    # none.  For every other domain, this seals again the key that it already
    # had.  That costs one write, and the bytes do not change.
    #
    # Do not do this on a dry run.  A dry run leaves the key on the disk where
    # it was.  If this step removes the key, we lose the way into a guest that
    # nobody asked us to touch.
    Trog::Guest->seal_key( $fqdn, "$cfg_dir/key.rsa" ) unless $dryrun;

    # Write provision.conf.

    # The distribution names the image.  The vm recipe sets the size of the
    # guest.  bin/new_guest writes a domain block from the same schema, and
    # `bin/recipes vm` prints it.
    my $image = $distro->base_image;
    my %vm    = Provisioner::Cookbook->defaults('vm');
    my $size  = $global_config->{size}   // $vm{size};
    my $cpus  = $global_config->{cpus}   // $vm{cpus};
    my $mem   = $global_config->{memory} // $vm{memory};

    my $pconf = qq(
        distro=$distro_name
        image=$image
        size=$size
        cpus=$cpus
        memory=$mem
        packages=$extra_packages
        contact_email=$admin_email
        ips=@{[ $static_ip // q{} ]}
        admin_user=$admin_user
        gateway=$gateway
        resolvers=$r_text
        transfer_ip=$transfer_ip
        transfer_user=$transfer_user
        transfer_port=$transfer_port
        payload_dir=$basedir
    );
    $pconf .= "depends_on=$depends_on" if $depends_on;

    # The optional configuration for the hypervisor part of the build.  Each
    # key comes from _global, if _global has it.  None of them gets a default
    # here.  bin/provision finds what the libvirt and qemu of this hypervisor
    # accept.  A key that is absent means that bin/provision decides.
    #
    # An empty key is left out, not written.  Config::Simple gives an empty
    # string for a bare `key=`, and an empty string is not the same as no
    # answer.  A key that is already written above is also left out, because
    # a second copy is a duplicate.
    my %written = map { m/\A\s*(\w+)=/ ? ( $1 => 1 ) : () } split( m/\n/, $pconf );
    $pconf .= join( '', map { "\n$_=$global_config->{$_}" } grep { !$written{$_} && defined $global_config->{$_} && length $global_config->{$_} } hv_settings() );

    File::Slurper::Temp::write_binary( "$cfg_dir/provision.conf", $pconf );

    # openssl.conf and scripts/ are in the checkout of this script, not in the
    # directory that it runs from.  Because their paths start at the checkout,
    # the generator can run from any directory.  It does that now, because it
    # does not run on the hypervisor any more.
    my $checkout = Cwd::abs_path( File::Basename::dirname(__FILE__) . '/..' );

    # Copy openssl.conf, which the self-signed certificate needs.
    print "Copying openssl.conf to $cfg_dir/openssl.conf\n";
    copy( "$checkout/openssl.conf", "$cfg_dir/openssl.conf" )
      or die "Could not copy openssl.conf into $cfg_dir: $!\n";

    # In the past, the guest got these scripts from the hypervisor with rsync.
    # That worked only while the hypervisor had a checkout at the same path as
    # this one.  It does not have one now.  So the scripts go in the tarball,
    # and the Makefile moves them into place.
    my @scripts = pack_scripts( $checkout, $cfg_dir );

    # Put the Makefile and the generated configuration in a gzipped tarball.
    print "Tarring up Makefile and generated configuration\n";
    unlink "$cfg_dir/data.tar.gz";

    my @members = ( 'Makefile', @generated, 'openssl.conf', @scripts );
    File::Find::find(
        sub {
            my $rel = $File::Find::name;
            $rel =~ s{^\Q$cfg_dir\E/}{};
            push( @members, $rel );
        },
        "$cfg_dir/t"
    );

    my $tar = Archive::Tar->new();
    $tar->add_files( map { "$cfg_dir/$_" } @members ) or die "Could not add files to $cfg_dir/data.tar.gz: " . Archive::Tar->error();

    # add_files stores each path as it is given.  So make each stored name
    # relative to $cfg_dir.
    foreach my $member ( $tar->get_files() ) {
        my $stored = $member->full_path();
        $stored =~ s{^\Q$cfg_dir\E/}{};
        $member->rename($stored);
    }

    $tar->write( "$cfg_dir/data.tar.gz", Archive::Tar::COMPRESS_GZIP() ) or die "Could not write $cfg_dir/data.tar.gz: " . Archive::Tar->error();

    # The data directory must exist, also when it is empty.  A new domain has
    # no data of its own yet.  If the source directory is not there, the rsync
    # on the guest fails.  Then the data target fails, and the rest of the
    # Makefile stops before any other recipe runs.
    make_path($data_dir) unless -d $data_dir;

    # In a run this long, nobody remembers one line in the middle.  So report
    # the empty salvages again at the end of the run, where the operator looks.
    #
    # The report is loud, but it does not stop the program.  This program
    # writes configuration and does not destroy anything.  A stop here does not
    # protect the state that it did not read.  It only keeps back the
    # configuration that somebody needs to fix the permissions and try again.
    # Cron also runs this program to take backups.  There, a stop for one
    # directory that it cannot read abandons every domain after it, also the
    # good ones.  bin/provision rebuilds the guest and loses the data.  This
    # report tells you not to run it yet.
    if (@empty_salvage) {
        warn "\n" . scalar(@empty_salvage) . " salvage(s) on $fqdn came back with nothing:\n" . join( q{}, map { "    $_->{recipe} read nothing out of $_->{remote}\n" } @empty_salvage ) . "None of that state is in $data_dir.  Rebuilding $fqdn now loses it.\n";

        # Keep the gaps for the program that acts on them.  This program can
        # only report them.  bin/provision must refuse to destroy the guest,
        # and it reads the gaps from here.
        $SALVAGE_GAPS{$fqdn} = [@empty_salvage];
    }

    print "Done.\n";
    return 0;
}

=head2 refresh_salvage(%args)

Ask the guest to update the state that is about to be salvaged.

C<static_ip>, C<admin_user> and C<cfg_dir> tell which guest to ask and how to
connect to it.  C<module> names the recipe that asks.  C<commands> is the list
that its C<remote_prepare> gave.

A dump that is written each night and fetched at noon is twelve hours old.  The
difference is all the changes in those hours, and a rebuild must not lose them.
A recipe tells how to update its own state in C<remote_prepare>.  This sub runs
those commands as root on the guest that is salvaged.

Usually, a failure gives only a warning.  The guest can be without the script
yet, and the dump from last night is better than no dump.  A stop here leaves
no dump at all.

If the command changed files before it failed, this sub stops the program.
C<watched> is the list of paths that are about to come down.  Before and after
each command, this sub gets the newest mtime under each path.  If a command
failed and changed none of them, the dump from last night is as it was.  The
warning is for that case.  If a command failed and changed them, the dump is
partial, not old.  Examples are a mysqldump that stopped halfway, or a snapshot
that is half written.  A fetch of it brings home a corrupt copy as the state of
the guest.  So in that case, this sub stops the program before it fetches
anything.

=cut

# The guest that a salvage connects to.  It is the guest that is about to be
# rebuilt.  The connection uses the admin user, and the key that this run
# already wrote into the configuration directory.
sub _salvage_guest {
    my ( $static_ip, $admin_user, $cfg_dir ) = @_;

    # The address can have a CIDR suffix.  Remove it, because a CIDR is not a
    # host to connect to.
    ( my $host = $static_ip ) =~ s{/\N*\z}{};

    # Make one connection for each guest, not one for each recipe.  Both callers
    # ask for it inside the loop over the modules.  refresh_salvage asks one
    # time for each module.  The fetch asks one time for each path that the
    # module salvages.  If each caller keeps its own connection, every call
    # makes an ssh handshake with a machine that is about to be discarded.
    #
    # The key holds all the data that identifies the machine and how to
    # connect to it.  One run configures several domains, and each domain is a
    # different guest.  The cache is for the full process, because there is no
    # object here to keep it on.
    state %guest;
    my $id = join( "\0", $host, $admin_user // q{}, $cfg_dir // q{} );
    return $guest{$id} if $guest{$id};

    # The key can be absent at this time.  If it is, do not name a key file
    # that is not there.  ssh has an agent and a configuration of its own.
    # Either one is better than an -i that points at nothing.
    my $key = Trog::Guest->key_path( File::Basename::basename($cfg_dir), "$cfg_dir/key.rsa" );

    return $guest{$id} = Trog::Guest->new(
        name => $host,
        host => $host,
        user => $admin_user,
        ( $key ? ( key_path => $key ) : () ),
    );
}

sub refresh_salvage (%args) {
    my ( $static_ip, $admin_user, $cfg_dir, $module, $commands, $watched ) = @args{qw{static_ip admin_user cfg_dir module commands watched}};

    return unless @$commands;
    $watched //= [];

    my $guest = _salvage_guest( $static_ip, $admin_user, $cfg_dir );
    my $host  = $guest->name;

    my %seen = _salvage_mtimes( $guest, $watched );

    foreach my $command (@$commands) {
        print "Asking $host to run '$command' before salvaging $module\n";

        # Run it through a shell.  A recipe gives a command line, not an argv.
        # For example, a script with its arguments, or a pipeline.
        my $failed = $guest->run_sudo( '/bin/sh', '-c', $command );

        # Get the mtimes again, if the command worked or not.  A command that
        # succeeded is expected to change files.  If the next command is
        # compared with the mtimes from before this one, the changes of this
        # command look like changes of the next.
        my %now     = _salvage_mtimes( $guest, $watched );
        my @touched = grep { ( $seen{$_} // q{} ) ne ( $now{$_} // q{} ) } sort keys %now;
        %seen = %now;

        next unless $failed;

        die "$module: '$command' failed on $host after changing what it was refreshing:\n" . join( q{}, map { "    $_\n" } @touched ) . "That is a partial dump rather than a stale one, and fetching it would carry\n" . "a corrupt copy home as though it were the state of the guest.  Nothing was\n" . "fetched.  Fix the guest, or move what it left aside, and run this again.\n"
          if @touched;

        warn "$module: '$command' failed on $host, so what comes down is whatever was already there.\n" . "Whatever it was going to refresh is as old as the last time something did.\n";
    }

    return 1;
}

# The newest mtime anywhere under each path, one number for each path.  The
# mtime of a directory changes only when an entry is added or removed.  So an
# mtime of the directories alone misses a dump that is written again in place.
# That is the usual case that this looks for.
#
# A path that is absent, or that the probe cannot read, gives an empty value.
# Two empty values are equal.  So a path that does not exist before or after a
# command is not a change.
sub _salvage_mtimes {
    my ( $guest, $watched ) = @_;
    return () unless @$watched;

    my $script = join "\n", map {
        ( my $q = $_ ) =~ s/'/'\\''/g;
        "printf '%s\\t%s\\n' '$q' \"\$(find '$q' -printf '%T@\\n' 2>/dev/null | sort -rn | head -1)\""
    } @$watched;

    ( my $quoted = $script ) =~ s/'/'\\''/g;
    my $said = $guest->capture_cmd("sudo sh -c '$quoted'") // q{};

    my %mtime;
    foreach my $line ( split m/\n/, $said ) {
        my ( $path, $stamp ) = split m/\t/, $line, 2;
        next unless defined $path && length $path;
        $mtime{$path} = defined $stamp ? $stamp : q{};
    }

    return %mtime;
}

=head2 write_guest_secrets($cfg_dir, $fqdn, $wanted, $store, $keepass)

Make sure that the secret store holds a value for each file that the recipes
want on the guest.  Then write a manifest that tells where each file goes.

The manifest holds the reference, never the value.  It is beside the domain, not
in the payload.  So these values do not go where the state from
C<remote_files> goes: into the data directory, into the tarball, and into every
backup of it.  C<bin/provision> reads the manifest and resolves the references.
Then it puts the files on the guest before the makefile runs.

=cut

sub write_guest_secrets {
    my ( $cfg_dir, $fqdn, $wanted, $store, $keepass ) = @_;

    my $manifest = "$cfg_dir/guest-secrets.yaml";
    unlink $manifest;
    return unless %$wanted;

    # Ask for the password here, not at the top.  If the recipes of a run want
    # no files on the guest, the run must not ask for a password.
    $keepass //= Trog::Credentials->prompt( 'Enter password:', 'keepass' );

    my %generator = map { $wanted->{$_}{ref} => $wanted->{$_}{generate} } keys %$wanted;
    my %held      = Trog::Secrets->remember( $store, $keepass, %generator );

    my %manifest = map {
        $_ => {
            ref   => $wanted->{$_}{ref},
            owner => $wanted->{$_}{owner} // 'root:root',
            mode  => $wanted->{$_}{mode}  // '0600',
        }
    } keys %$wanted;

    File::Slurper::Temp::write_binary( $manifest, YAML::XS::Dump( \%manifest ) );
    chmod 0600, $manifest;

    print "Wrote $manifest: " . scalar( keys %manifest ) . " file(s) for bin/provision to place on $fqdn\n" . join( q{}, map { "  $_ <- $manifest{$_}{ref}\n" } sort keys %manifest );

    return \%held;
}

# Copy the helper scripts into the directory of the domain, so that they go into
# the tarball with the other files.
#
# The modes are copied intentionally.  The guest executes every one of these
# scripts, and File::Copy does not promise to keep the executable bit.
sub pack_scripts {
    my ( $checkout, $cfg_dir ) = @_;

    my $from = "$checkout/scripts";
    die "No scripts directory at $from\n" unless -d $from;

    my $to = "$cfg_dir/scripts";
    remove_tree($to) if -d $to;
    make_path($to) or die "Could not create $to: $!\n";

    my @packed;
    foreach my $script ( Provisioner::Utils::files_in($from) ) {

        # Copy the file and its mode from the open handle.  Then both come from
        # the file that was opened, not from what the path holds at a later
        # time.  files_in already left out the directories.
        open( my $in, '<', "$from/$script" ) or next;
        copy( $in, "$to/$script" )           or die "Could not copy $script into $to: $!\n";
        ## no critic (ProhibitLeadingZeros) -- the policy exempts a
        ## literal handed straight to chmod; this is a mask against a mode.
        chmod( ( stat $in )[2] & 07777, "$to/$script" );
        close($in) or die "Could not close $from/$script: $!\n";
        push @packed, "scripts/$script";
    }

    print "Packed " . scalar(@packed) . " scripts from $from\n";
    return @packed;
}

# Tell if a salvage that got nothing is a problem, and what kind of problem.
#
# Examine the destination, not the transfer.  A transfer reports what it moved
# on this pass.  A second run against a guest that did not change moves nothing,
# because the first run took all of it.  So what moved does not tell if the
# salvage has anything in it.
#
# An empty destination has one of three causes, and only the guest can tell
# which.  The path is not there at all.  Every first build of a recipe looks like
# that.  Or the path is there and holds nothing, because the service started
# and did not write anything yet.  Or the path holds files that did not come
# down.  Only that last cause is a reason to stop a rebuild.
#
# Ask the guest as root, for the same reason as the fetch.  The paths that a
# recipe salvages belong to the service, and no other user can open them.
# Without privileges, a look inside one cannot tell "empty" from "not mine to
# read".  Then every path looks alarming.
#
# In the past, there were two causes, not three.  The fetch had no privileges,
# so an unreadable path was the likely case.  A directory that was really empty
# got a warning about permissions.  The warning was for an unreadable
# directory.  Now the fetch can read them, so the only alarming case left is a
# fetch that failed.
sub _salvage_gap {
    my (%args) = @_;

    return () if _dir_has_files( $args{destination} );

    # Give the path as an argument, not interpolated into the command.  This is
    # a shell, and run_sudo escapes each element for us.
    #
    # find -print -quit stops at the first file.  It does not walk all of a
    # state directory, which can be very large.  For a path that is not there,
    # it prints nothing.  So one question covers the two quiet cases: a path
    # that was never made, and a path that the service did not write into.
    my $rc = $args{guest}->run_sudo(
        'sh',          '-c', 'test -n "$(find "$1" -type f -print -quit 2>/dev/null)"',
        'salvage-gap', $args{remote},
    );

    my %gap = ( recipe => $args{recipe}, remote => $args{remote} );

    # test exits 0 or 1 and nothing else.  Any other code means that the
    # question did not run.  For example, the guest went away during the run,
    # or sudo refused.  Do not report that as a service that never ran.  That
    # report hides the alarm for state that is still on the guest.  This sub
    # exists to prevent that failure.
    return {
        %gap,
        alarming => 1,
        message  => "$args{recipe}: could not ask $args{host} whether $args{remote} still holds anything" . " -- the check exited $rc as $args{user}.  Treating that as state that did not come off," . " because the alternative is calling a guest we cannot reach a guest with nothing on it.",
    } if $rc > 1;

    return {
        %gap,
        alarming => 0,
        message  => "$args{recipe}: nothing under $args{remote} on $args{host} yet, so there is nothing to salvage.",
    } if $rc;

    return {
        %gap,
        alarming => 1,
        message  => "$args{recipe}: salvaged nothing out of $args{remote} on $args{host}, and $args{destination} is empty." . "  The guest still has files there, so this is a fetch that failed rather than a service with no state." . "  Rebuilding $args{host} now loses them.",
    };
}

# Tell if a salvage put any file under its destination.
#
# Count files, not entries.  rget makes the local directories on the way down,
# if it can read their contents or not.  So a tree of empty directories is
# exactly what an unreadable fetch leaves.
#
# It stops at the first file, and does not walk the full tree.  One file
# answers the question, and some salvaged state is very large.  A symlink counts
# as a file and is not followed.  A symlink from a guest can point anywhere,
# also back up the tree that holds it.
sub _dir_has_files {
    my ($dir) = @_;
    return 0 unless -d $dir;

    # die is how you leave File::Find early.  So the find is in an eval, and
    # the value that it throws is the answer.  The value is a reference, not a
    # string, and is compared by identity below.  File::Find appends its own
    # context to a die from wanted.  So a message changes on the way out, and
    # cannot be told from a real error.
    my $found = \'found';

    my $ok = eval {
        File::Find::find(
            {
                no_chdir => 1,
                wanted   => sub {
                    die $found if -l $File::Find::name || !-d $File::Find::name;
                },
            },
            $dir
        );
        1;
    };
    return 0 if $ok;

    my $err = $@;
    return 1 if ref $err && ref $err eq 'SCALAR' && $err == $found;
    die $err;
}

sub _get_sftp {
    my ( $static_ip, $admin_user, $cfg_dir ) = @_;

    # The address can have a CIDR suffix.  Remove it.
    $static_ip =~ s|/\N*$||;
    my $target_is_up = 0;

    # The key that opens the guest that is up.  It is found before
    # generate_files writes anything.  It comes from the store, unless a domain
    # that was provisioned before sealing still has one on disk.  The domain is
    # the last part of the path of the configuration directory, because that
    # path is made from the domain.
    my $key2use = Trog::Guest->key_path( File::Basename::basename($cfg_dir), "$cfg_dir/key.rsa" );

    my $ssh = Net::SFTP::Foreign->new(
        host     => $static_ip,
        user     => $admin_user,
        more     => [ -o => "StrictHostKeyChecking=no", -o => 'UserKnownHostsFile=/dev/null' ],
        key_path => $key2use
    );
    $ssh->error or $target_is_up = 1;
    return ( $ssh, $target_is_up );
}

main(@ARGV) unless caller;
