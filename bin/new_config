use warnings FATAL => 'all';

no warnings qw{experimental};
use feature qw{state};
use warnings;
use re '/aa';

use FindBin;
use FindBin::libs;

use YAML::XS;
use File::Slurper;
use File::Slurper::Temp;
use Config::Simple;
use Cwd();
