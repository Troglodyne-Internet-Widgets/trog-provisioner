#!/usr/bin/env perl

package Trog::Bin::RunnerAccount;

#ABSTRACT: Give a runner an account of its own on a hypervisor, with a pool that has a quota and sudo for only what a build runs.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use File::Slurper();

use Trog::Hypervisors();
use Trog::HV::Libvirt();
use Trog::Steps();

=head1 NAME

runner_account - give a runner an account of its own on a hypervisor, with a
pool that has a quota and sudo for only what a build runs

=head1 SYNOPSIS

    bin/runner_account --hypervisor hv1 --user runner \
        --pool-name runner_disks --pool-path /srv/vm-disks/runner --quota 500G \
        --partition /machine/runner --cpu-quota 400% --io-weight 50 \
        [--authorize ~/.ssh/id_ed25519.pub] [--dryrun]

    bin/runner_account --hypervisor hv1 --user runner \
        --pool-name runner_disks --pool-path /srv/vm-disks/runner \
        --partition /machine/runner --remove [--dryrun]

=head1 DESCRIPTION

A runner is a guest that builds guests: see
L<Provisioner::Recipe::trogrunner>.  It reaches a hypervisor as the user in the
C<libvirt_uri> of its C<hypervisors> block.  This command makes that user on
the hypervisor, and everything that the user needs to build guests and nothing
more.  It runs from the machine that provisions, through the account that
F<hypervisors.conf> already has for the hypervisor, and that account needs
sudo for everything.

You do not need this command for a runner whose C<hypervisors> entry has an
C<account> block.  F<bin/provision> then makes the same account when it builds
the runner, and lets the key of the runner in, and F<bin/destroy> takes the
account away.  Use this command to make an account by hand, to see what a
provision would change, or to let another key in.

The steps are C<runner_account_steps> in L<Trog::HV::Libvirt>, which says what
each one makes, and what the hypervisor must have first.  Each step first asks
whether it is done, and skips itself if it is.  So a second run changes
nothing, and a run after you change an option changes only what the option is
about.  Each key of C<--authorize> goes into the F<authorized_keys> of the user
last, through C<runner_key_steps>.

At the end it prints the C<hypervisors> entry for the trogrunner block of the
runner.

=head2 What the account can and cannot do

The sudo grant names each command that this tool runs as root on a hypervisor
during a build, a rebuild and a teardown, with its arguments pinned by a
regular expression.  C<runner_sudoers> in L<Trog::HV::Libvirt> lists them, and
the three that it leaves out.  The account cannot install
F</usr/libexec/virtiofs-better>, so that file must be on the hypervisor before
the runner builds there.  This command refuses to start when the file is not
there.

The C<libvirt> group is root in all but name, because a domain can be
defined that mounts any file of the host.  Neither the pool nor the slice
stops a runner that names another pool or partition.  Only the polkit access
driver of libvirt closes that, and this command does not configure it.

=head2 Taking it away

C<--remove> undoes each step, in the other order, through
C<runner_removal_steps>.  It refuses to start while the pool holds a volume, or
the directory of the pool holds a file, because each is a disk of a guest.
Destroy the guests of the runner with F<bin/destroy> first.  It removes the
dataset with C<zfs destroy>, without C<-r>, so a snapshot or a child dataset
stops it.  It removes the user with its home, and the keys in it.

=head1 OPTIONS

=over 4

=item B<--hypervisor> NAME

The block of F<hypervisors.conf> to work on.  Required.

=item B<--user> NAME

The account to make.  Required.

=item B<--pool-name> NAME, B<--pool-path> DIR

The storage pool of the runner.  Required.  The trogrunner block must name
both, because libvirt finds a pool by its name and ignores the path of a pool
that exists.

=item B<--quota> SIZE

The quota of the dataset, as C<zfs> reads it, for example C<500G>.  Required,
except with C<--remove>.

=item B<--partition> PATH

The libvirt partition of the guests of the runner, as C</machine/NAME>.
Optional.

=item B<--cpu-quota> PERCENT, B<--io-weight> WEIGHT

The CPU and I/O limits of the slice, as systemd reads C<CPUQuota> and
C<IOWeight>.  Only with C<--partition>.

=item B<--authorize> FILE

A file of public keys to add to the F<authorized_keys> of the user.  Can be
given more than once.

=item B<--remove>

Take the account away.  See L</Taking it away>.

=item B<--dryrun>

Ask the hypervisor what is done, print what would change, and change nothing.

=item B<--hvconf> FILE

The fleet definition.  The default is the one in the configuration directory
of L<Trog::Config>.

=back

=cut

sub main {
    my @args = @_;

    my %opt = ( authorize => [] );
    GetOptionsFromArray(
        \@args, \%opt,
        qw{hypervisor=s user=s pool-name=s pool-path=s quota=s partition=s cpu-quota=s io-weight=s authorize=s@ remove dryrun hvconf=s help},
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $opt{help};

    my @missing = grep { !defined $opt{$_} } ( qw{hypervisor user pool-name pool-path}, $opt{remove} ? () : 'quota' );
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Missing: ' . join( ', ', map { "--$_" } @missing ) ) if @missing;

    my $plan = Trog::HV::Libvirt->runner_account_plan( map { (tr/-/_/r) => $opt{$_} } grep { defined $opt{$_} } qw{user pool-name pool-path quota partition cpu-quota io-weight} );
    my @keys = keys_in( @{ $opt{authorize} } );

    my $fleet = Trog::Hypervisors->load( $opt{hvconf} // Trog::Hypervisors->default_path() );
    my $hv    = $fleet->hypervisor( $opt{hypervisor} );
    die "$opt{hypervisor} is not a libvirt hypervisor, and only libvirt has accounts to give\n" unless $hv->isa('Trog::HV::Libvirt');

    my @steps =
        $opt{remove}
      ? $hv->runner_removal_steps($plan)
      : ( $hv->runner_account_steps($plan), map { $hv->runner_key_steps( $plan->{user}, $_ ) } @keys );
    my $changed = Trog::Steps::run( \@steps, $opt{dryrun} );

    print $opt{dryrun} ? "Nothing changed: $changed step(s) would run.\n" : "Done: $changed step(s) ran.\n";
    print "\n" . trogrunner_entry( $hv, $plan ) unless $opt{remove};
    return 0;
}

=head2 @lines = keys_in(@files)

The lines of C<@files> that hold a public key.  Dies when there are files and
none of them holds one.

=cut

sub keys_in {
    my @files = @_;

    my @keys = map {
        grep { m/\A(?:ssh|ecdsa|sk)-\S+\s+\S+/ } split m/\n/,
          File::Slurper::read_text($_)
    } @files;
    die "No public key in " . join( ', ', @files ) . "\n" if @files && !@keys;
    return @keys;
}

=head2 $text = trogrunner_entry($hv, \%plan)

The C<hypervisors> entry for the trogrunner block of the runner, as YAML, with
the user in the C<libvirt_uri>, and the C<account> block that makes
F<bin/provision> keep the account as this command left it.

=cut

sub trogrunner_entry {
    my ( $hv, $plan ) = @_;

    my $host = $hv->ssh_host // 'localhost';
    my $port = $hv->ssh_port != 22 ? ':' . $hv->ssh_port : q{};
    return join "\n", 'The hypervisors entry for the trogrunner block of the runner:', q{}, '    hypervisors:', '        ' . $hv->name . ':',
      "            libvirt_uri: qemu+ssh://$plan->{user}\@$host$port/system",
      "            pool_name:   $plan->{pool_name}",
      "            pool_path:   $plan->{pool_path}",
      ( $plan->{partition} ? "            partition:   $plan->{partition}" : () ),
      '            account:',
      "                quota: $plan->{quota}",
      ( defined $plan->{cpu_quota} ? "                cpu_quota: \"$plan->{cpu_quota}\"" : () ),
      ( defined $plan->{io_weight} ? "                io_weight: $plan->{io_weight}"     : () ),
      q{}, '    hypervisor_access: least', q{}, q{};
}

exit main(@ARGV) unless caller;
1;
