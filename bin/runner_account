#!/usr/bin/env perl

package Trog::Bin::RunnerAccount;

#ABSTRACT: Give a runner an account of its own on a hypervisor, with a pool that has a quota and sudo for only what a build runs.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Getopt::Long qw{GetOptionsFromArray};
use Pod::Usage   qw{pod2usage};

use File::Basename();
use File::Slurper();

use Trog::Hypervisors();
use Trog::HV::Libvirt();

=head1 NAME

runner_account - give a runner an account of its own on a hypervisor, with a
pool that has a quota and sudo for only what a build runs

=head1 SYNOPSIS

    bin/runner_account --hypervisor hv1 --user runner \
        --pool-name runner_disks --pool-path /srv/vm-disks/runner --quota 500G \
        --partition /machine/runner --cpu-quota 400% --io-weight 50 \
        --authorize ~/.ssh/id_ed25519.pub [--dryrun]

    bin/runner_account --hypervisor hv1 --user runner \
        --pool-name runner_disks --pool-path /srv/vm-disks/runner \
        --partition /machine/runner --remove [--dryrun]

=head1 DESCRIPTION

A runner is a guest that builds guests: see
L<Provisioner::Recipe::trogrunner>.  It reaches a hypervisor as the user in the
C<libvirt_uri> of its C<hypervisors> block.  This command makes that user on
the hypervisor, and everything that the user needs to build guests and nothing
more.  It runs from the machine that provisions, through the account that
F<hypervisors.conf> already has for the hypervisor, and that account needs
sudo for everything.

It does these steps, in this order.  Each step first asks whether it is done,
and skips itself if it is.  So a second run changes nothing, and a run after
you change an option changes only what the option is about.

=over 4

=item 1. A system user with no password, a shell and a home, in the C<libvirt>
group.  The group is what the libvirt API on the system URI asks for.

=item 2. Each public key of C<--authorize> in the F<authorized_keys> of that
user.  C<bin/provision> logs in as that user to add the key of the runner, so
the machine that provisions must be able to log in as it first.

=item 3. A ZFS dataset at C<--pool-path>, with C<quota> set to C<--quota>.  Its
parent is the dataset mounted on the parent directory of C<--pool-path>.  On a
filesystem other than ZFS, the command stops and prints how to put a quota
there, which is the advice of C<note_pool_quota> in L<Trog::HV::Libvirt>.

=item 4. A libvirt storage pool C<--pool-name> on that directory, owned by the
user and started with the host.  The pool owns the permissions of the
directory, so a later build of the pool keeps them.

=item 5. With C<--partition>, the systemd slice for it, with C<CPUQuota> and
C<IOWeight> from C<--cpu-quota> and C<--io-weight>.  There is no option for
memory, because C<MemoryMax> on a slice kills a guest rather than refusing the
next one.  See QUOTAS in L<Provisioner::Recipe::trogrunner>.

=item 6. The sudoers file F</etc/sudoers.d/90-trog-runner-USER>, which
C<runner_sudoers> in L<Trog::HV::Libvirt> writes.  C<visudo -c> checks it
before it is installed.

=back

At the end it prints the C<hypervisors> entry for the trogrunner block of the
runner.

=head2 What the account can and cannot do

The sudo grant names each command that this tool runs as root on a hypervisor
during a build, a rebuild and a teardown, with its arguments pinned by a
regular expression.  C<runner_sudoers> in L<Trog::HV::Libvirt> lists them, and
the three that it leaves out.  The account cannot install
F</usr/libexec/virtiofs-better>, so that file must be on the hypervisor before
the runner builds there.  This command refuses to start when the file is not
there.

The C<libvirt> group is root in all but name, because a domain can be
defined that mounts any file of the host.  Neither the pool nor the slice
stops a runner that names another pool or partition.  Only the polkit access
driver of libvirt closes that, and this command does not configure it.

=head2 Taking it away

C<--remove> undoes each step, in the other order.  It refuses to remove a
pool that still holds a volume, because a volume is a disk of a guest.  Destroy
the guests of the runner with F<bin/destroy> first.  It removes the dataset
with C<zfs destroy>, without C<-r>, so a snapshot or a child dataset stops it.
It removes the user with its home, and the keys in it.

=head1 OPTIONS

=over 4

=item B<--hypervisor> NAME

The block of F<hypervisors.conf> to work on.  Required.

=item B<--user> NAME

The account to make.  Required.

=item B<--pool-name> NAME, B<--pool-path> DIR

The storage pool of the runner.  Required.  The trogrunner block must name
both, because libvirt finds a pool by its name and ignores the path of a pool
that exists.

=item B<--quota> SIZE

The quota of the dataset, as C<zfs> reads it, for example C<500G>.  Required,
except with C<--remove>.

=item B<--partition> PATH

The libvirt partition of the guests of the runner, as C</machine/NAME>.
Optional.

=item B<--cpu-quota> PERCENT, B<--io-weight> WEIGHT

The CPU and I/O limits of the slice, as systemd reads C<CPUQuota> and
C<IOWeight>.  Only with C<--partition>.

=item B<--authorize> FILE

A file of public keys to add to the F<authorized_keys> of the user.  Can be
given more than once.

=item B<--remove>

Take the account away.  See L</Taking it away>.

=item B<--dryrun>

Ask the hypervisor what is done, print what would change, and change nothing.

=item B<--hvconf> FILE

The fleet definition.  The default is the one in the configuration directory
of L<Trog::Config>.

=back

=cut

sub main {
    my @args = @_;

    my %opt = ( authorize => [] );
    GetOptionsFromArray(
        \@args, \%opt,
        qw{hypervisor=s user=s pool-name=s pool-path=s quota=s partition=s cpu-quota=s io-weight=i authorize=s@ remove dryrun hvconf=s help},
    ) or pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__ );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $opt{help};

    my @missing = grep { !defined $opt{$_} } ( qw{hypervisor user pool-name pool-path}, $opt{remove} ? () : 'quota' );
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'Missing: ' . join( ', ', map { "--$_" } @missing ) ) if @missing;

    my $plan = plan(%opt);

    my $fleet = Trog::Hypervisors->load( $opt{hvconf} // Trog::Hypervisors->default_path() );
    my $hv    = $fleet->hypervisor( $opt{hypervisor} );
    die "$opt{hypervisor} is not a libvirt hypervisor, and only libvirt has accounts to give\n" unless $hv->isa('Trog::HV::Libvirt');

    my @steps   = $opt{remove} ? removal_steps( $hv, $plan ) : creation_steps( $hv, $plan );
    my $changed = run_steps( \@steps, $opt{dryrun} );

    print $opt{dryrun} ? "Nothing changed: $changed step(s) would run.\n" : "Done: $changed step(s) ran.\n";
    print "\n" . trogrunner_entry( $hv, $plan ) unless $opt{remove};
    return 0;
}

=head2 \%plan = plan(%opt)

Checks the options and returns what the steps need: C<user>, C<pool_name>,
C<pool_path>, C<quota>, C<slice> (the unit name for the partition, or undef),
C<cpu_quota>, C<io_weight> and C<keys> (the lines of the C<--authorize>
files).  Dies on a value that a step would write into a file or a command as
syntax.

=cut

sub plan {
    my (%opt) = @_;

    # The match is ASCII under /aa, so \w and \d mean what useradd, zfs and
    # systemd accept.
    die "--user '$opt{user}' is not a name useradd takes\n"                    unless $opt{user}        =~ m/\A[[:lower:]_][[:lower:]\d_-]{0,31}\z/;
    die "--pool-name '$opt{'pool-name'}' has to be letters, digits, _ and -\n" unless $opt{'pool-name'} =~ m/\A[\w-]+\z/;
    die "--pool-path '$opt{'pool-path'}' has to be an absolute path of letters, digits, _ . and -\n"
      if $opt{'pool-path'} !~ m{\A(?:/[\w.-]+)+\z} || $opt{'pool-path'} =~ m{/[.]{1,2}(?:/|\z)};
    die "--quota '$opt{quota}' is not a size zfs reads, such as 500G\n" if defined $opt{quota} && $opt{quota} !~ m/\A\d+[KMGTP]?\z/;

    my $slice;
    if ( defined $opt{partition} ) {
        die "--partition '$opt{partition}' has to be /machine/NAME: libvirt makes NAME a slice under machine.slice\n"
          unless $opt{partition} =~ m{\A/machine/[[:lower:]\d_]+\z};
        $slice = 'machine-' . File::Basename::basename( $opt{partition} ) . '.slice';
    }
    die "--cpu-quota and --io-weight are limits of the slice, and need --partition\n"
      if !$slice && ( defined $opt{'cpu-quota'} || defined $opt{'io-weight'} );
    die "--cpu-quota '$opt{'cpu-quota'}' is not a percentage, such as 400%\n" if defined $opt{'cpu-quota'} && $opt{'cpu-quota'} !~ m/\A\d+%\z/;
    die "--io-weight '$opt{'io-weight'}' has to be from 1 to 10000\n"         if defined $opt{'io-weight'} && ( $opt{'io-weight'} < 1 || $opt{'io-weight'} > 10_000 );

    my @keys = map {
        grep { m/\A(?:ssh|ecdsa|sk)-\S+\s+\S+/ } split m/\n/,
          File::Slurper::read_text($_)
    } @{ $opt{authorize} };
    die "No public key in " . join( ', ', @{ $opt{authorize} } ) . "\n" if @{ $opt{authorize} } && !@keys;

    return {
        user      => $opt{user},
        pool_name => $opt{'pool-name'},
        pool_path => $opt{'pool-path'},
        quota     => $opt{quota},
        slice     => $slice,
        partition => $opt{partition},
        cpu_quota => $opt{'cpu-quota'},
        io_weight => $opt{'io-weight'},
        keys      => \@keys,
    };
}

=head2 $count = run_steps(\@steps, $dryrun)

Runs each step whose C<done> returns false, and prints what it does.  A step is
a hash reference of C<what>, a sentence, and C<done> and C<do>, two code
references.  With C<$dryrun>, prints what would run and runs nothing.  A
C<do> that dies stops the run.  Returns how many steps ran or would run.

=cut

sub run_steps {
    my ( $steps, $dryrun ) = @_;

    my $count = 0;
    foreach my $step (@$steps) {
        if ( $step->{done}->() ) {
            print "  ok    $step->{what}\n";
            next;
        }
        $count++;
        print $dryrun ? "  would $step->{what}\n" : "  now   $step->{what}\n";
        $step->{do}->() unless $dryrun;
    }
    return $count;
}

# A string for a shell on the hypervisor, quoted.
my sub q1 ($value) { return q{'} . ( $value =~ s/'/'\\''/gr ) . q{'} }

# What a command printed, without its last newline, or an empty string.
my sub said ( $hv, $cmd ) {
    my $out = $hv->capture_cmd("$cmd 2>/dev/null") // q{};
    chomp $out;
    return $out;
}

# Dies unless a root command on the hypervisor succeeds.
my sub as_root ( $hv, @argv ) {
    $hv->run_sudo(@argv) == 0 or die 'Could not run ' . join( ' ', @argv ) . ' on ' . $hv->describe . "\n";
    return 1;
}

=head2 @steps = creation_steps($hv, \%plan)

The steps that make the account, in order.  Before the first, it checks what
every step needs from the hypervisor, and dies with the reason if one is
missing: sudo 1.9.10 or later for the patterns of the grant, the lease helper,
qemu-img, F</usr/libexec/virtiofs-better>, and ZFS under the parent of the
pool.

=cut

sub creation_steps {
    my ( $hv, $plan ) = @_;
    my ( $user, $path, $name ) = @{$plan}{qw{user pool_path pool_name}};

    my ($version) = said( $hv, 'sudo -V' ) =~ m/version\s+(\d+)[.](\d+)[.](\d+)/ ? ( sprintf '%d.%03d%03d', $1, $2, $3 ) : (0);
    die "sudo on " . $hv->describe . " is older than 1.9.10, which is the first that takes the patterns the grant needs\n" if $version < 1.009010;

    my $lease = $hv->lease_helper                  or die 'There is no libvirt lease helper on ' . $hv->describe . "\n";
    my $qemu  = said( $hv, 'command -v qemu-img' ) or die 'There is no qemu-img on ' . $hv->describe . "\n";
    $hv->file_exists('/usr/libexec/virtiofs-better')
      or die "/usr/libexec/virtiofs-better is not on " . $hv->describe . ", and the account will not be able to install it.\n" . "Provision one guest there from the account that hypervisors.conf has, which installs it, and run this again.\n";

    my $parent = File::Basename::dirname($path);
    my $fstype = $hv->path_fstype($parent);
    die "The parent of $path is on '$fstype', and this command can give a pool a quota only on ZFS.\n" . Trog::HV::Libvirt::pool_quota_advice( $fstype, $name, { path => $path, mount => $parent, source => $parent } )
      unless $fstype eq 'zfs';

    my $parent_set = said( $hv, 'zfs list -H -o name ' . q1($parent) );
    my $mounted_at = said( $hv, 'zfs get -H -o value mountpoint ' . q1($parent_set) );
    die "$parent is not where a ZFS dataset is mounted (it is inside $parent_set, mounted at $mounted_at), so a child dataset would not mount at $path\n"
      unless $parent_set && $mounted_at eq $parent;
    my $dataset = "$parent_set/" . File::Basename::basename($path);

    my $sudoers  = "/etc/sudoers.d/90-trog-runner-$user";
    my $grant    = Trog::HV::Libvirt->runner_sudoers( user => $user, pool_path => $path, lease_helper => $lease, qemu_img => $qemu );
    my $home     = sub { said( $hv, 'getent passwd ' . q1($user) . ' | cut -d: -f6' ) };
    my $id_of    = sub ($flag) { said( $hv, "id $flag " . q1($user) ) };
    my $existing = sub ($file) { said( $hv, 'sudo -n cat ' . q1($file) ) };

    my @steps = (
        {
            what => "make the user $user, with no password",
            done => sub { $id_of->('-u') ne q{} },
            do   => sub { as_root( $hv, qw{useradd --system --create-home --shell /bin/bash}, $user ) },
        },
        {
            what => "put $user in the libvirt group",
            done => sub {
                grep { $_ eq 'libvirt' } split q{ }, $id_of->('-nG');
            },
            do => sub { as_root( $hv, qw{usermod -aG libvirt}, $user ) },
        },
        (
            map {
                my $key = $_;
                my ($comment) = $key =~ m/\A\S+\s+\S+\s*(.*)\z/;
                {
                    what => 'let ' . ( $comment || 'a key' ) . " log in as $user",
                    done => sub {
                        grep { $_ eq $key } split m/\n/, $existing->( $home->() . '/.ssh/authorized_keys' );
                    },
                    do => sub {
                        my $dir = $home->() . '/.ssh';
                        as_root( $hv, qw{install -d -m 0700 -o}, $user, '-g', $user, $dir );
                        as_root( $hv, 'sh', '-c', 'printf "%s\n" "$1" >> "$2" && chown "$3:" "$2" && chmod 0600 "$2"', 'sh', $key, "$dir/authorized_keys", $user );
                    },
                }
            } @{ $plan->{keys} }
        ),
        {
            what => "make the ZFS dataset $dataset at $path",
            done => sub { said( $hv, 'zfs list -H -o name ' . q1($dataset) ) eq $dataset },
            do   => sub { as_root( $hv, qw{zfs create -o}, "quota=$plan->{quota}", $dataset ) },
        },
        {
            what => "set the quota of $dataset to $plan->{quota}",
            done => sub { uc said( $hv, 'zfs get -H -o value quota ' . q1($dataset) ) eq uc $plan->{quota} },
            do   => sub { as_root( $hv, qw{zfs set}, "quota=$plan->{quota}", $dataset ) },
        },
        {
            what => "define the storage pool $name at $path, owned by $user",
            done => sub {
                my $target = $hv->pool_target($name) // return 0;
                die "libvirt already has a pool $name at $target, and finds a pool by its name: pick another --pool-name, or remove that pool\n" if $target ne $path;
                return 1;
            },
            do => sub {
                my $pool = $hv->define_pool( $name, $path, owner => $id_of->('-u'), group => $id_of->('-g'), mode => '0755' );
                $pool->create() unless $pool->is_active();
            },
        },
        ( $plan->{slice} ? slice_step( $hv, $plan, $existing ) : () ),
        {
            what => "grant $user sudo for what a build runs, in $sudoers",
            done => sub { chomp( my $wanted = $grant ); $existing->($sudoers) eq $wanted },
            do   => sub {
                my $staged = said( $hv, 'mktemp' ) or die 'Could not make a temporary file on ' . $hv->describe . "\n";
                $hv->write_text( $staged, $grant ) or die "Could not stage the sudoers file\n";
                my $checked = $hv->run_sudo( qw{visudo -c -f}, $staged ) == 0;
                $checked &&= as_root( $hv, qw{install -o root -g root -m 0440}, $staged, $sudoers );
                $hv->remove($staged);
                die "visudo refused the sudoers file for $user, so it was not installed\n" unless $checked;
            },
        },
    );
    return @steps;
}

# The unit file of the slice, and the step that installs it.
sub slice_step {
    my ( $hv, $plan, $existing ) = @_;

    my $unit = "/etc/systemd/system/$plan->{slice}";
    my $text = join "\n", "[Unit]", "Description=Guests that the trog-provisioner runner $plan->{user} builds", "Before=slices.target", q{}, "[Slice]",
      ( defined $plan->{cpu_quota} ? "CPUQuota=$plan->{cpu_quota}" : () ),
      ( defined $plan->{io_weight} ? "IOWeight=$plan->{io_weight}" : () );

    return {
        what => "write $unit" . ( $plan->{cpu_quota} || $plan->{io_weight} ? q{} : ' with no limits in it' ),
        done => sub { $existing->($unit) eq $text },
        do   => sub {
            $hv->write_text( $unit, "$text\n", sudo => 1, mode => '0644' ) or die "Could not write $unit\n";
            as_root( $hv, qw{systemctl daemon-reload} );
        },
    };
}

=head2 @steps = removal_steps($hv, \%plan)

The steps that take the account away, in the other order from
C<creation_steps>.  The step for the pool dies if the pool holds a volume.

=cut

sub removal_steps {
    my ( $hv, $plan ) = @_;
    my ( $user, $path, $name ) = @{$plan}{qw{user pool_path pool_name}};

    my $sudoers = "/etc/sudoers.d/90-trog-runner-$user";
    my $absent  = sub ($file) { $hv->run_cmd( qw{sudo -n test ! -e}, $file ) == 0 };
    my $dataset = sub { said( $hv, 'zfs list -H -o name ' . q1($path) ) };

    # A pool that is not running cannot list its volumes, and the disks of its
    # guests are files in the directory.  So the directory is asked as well.
    my $refuse_if_full = sub {
        my $first = said( $hv, 'sudo -n find ' . q1($path) . ' -mindepth 1 -print -quit' );
        die "$path still holds $first, and maybe more.  Destroy the guests of the runner first.\n" if $first ne q{};
    };

    return (
        {
            what => "remove $sudoers",
            done => sub { $absent->($sudoers) },
            do   => sub { as_root( $hv, qw{rm -f}, $sudoers ) },
        },
        (
            $plan->{slice}
            ? {
                what => "remove /etc/systemd/system/$plan->{slice}",
                done => sub { $absent->("/etc/systemd/system/$plan->{slice}") },
                do   => sub { as_root( $hv, qw{rm -f}, "/etc/systemd/system/$plan->{slice}" ); as_root( $hv, qw{systemctl daemon-reload} ) },
              }
            : ()
        ),
        {
            what => "remove the storage pool $name",
            done => sub { !defined $hv->pool_target($name) },
            do   => sub {
                my $pool    = $hv->vmm->get_storage_pool_by_name($name);
                my @volumes = $pool->is_active() ? map { $_->get_name() } $pool->list_all_volumes() : ();
                die "The pool $name still holds " . join( ', ', @volumes ) . ".  Destroy those guests first.\n" if @volumes;
                $refuse_if_full->();
                $pool->destroy() if $pool->is_active();
                $pool->undefine();
            },
        },
        {
            what => "destroy the ZFS dataset at $path",
            done => sub { my $set = $dataset->(); !$set || said( $hv, 'zfs get -H -o value mountpoint ' . q1($set) ) ne $path },
            do   => sub { $refuse_if_full->();    as_root( $hv, qw{zfs destroy}, $dataset->() ) },
        },
        {
            what => "remove the user $user and its home",
            done => sub { said( $hv, 'id -u ' . q1($user) ) eq q{} },
            do   => sub { as_root( $hv, qw{userdel --remove}, $user ) },
        },
    );
}

=head2 $text = trogrunner_entry($hv, \%plan)

The C<hypervisors> entry for the trogrunner block of the runner, as YAML, with
the user in the C<libvirt_uri>.

=cut

sub trogrunner_entry {
    my ( $hv, $plan ) = @_;

    my $host = $hv->ssh_host // 'localhost';
    my $port = $hv->ssh_port != 22 ? ':' . $hv->ssh_port : q{};
    return join "\n", 'The hypervisors entry for the trogrunner block of the runner:', q{}, '    hypervisors:', '        ' . $hv->name . ':',
      "            libvirt_uri: qemu+ssh://$plan->{user}\@$host$port/system",
      "            pool_name:   $plan->{pool_name}",
      "            pool_path:   $plan->{pool_path}",
      ( $plan->{partition} ? "            partition:   $plan->{partition}" : () ),
      q{}, '    hypervisor_access: least', q{}, q{};
}

exit main(@ARGV) unless caller;
1;
