<!-- libvirt domain for %REPLACEME%, written by bin/provision.
     Everything between %...% is substituted; see mongle_domain_xml. -->
<domain type='kvm'>
  <name>%REPLACEME%</name>
  <memory unit='MiB'>%MUGUBYTES%</memory>
  <currentMemory unit='MiB'>%MUGUBYTES%</currentMemory>
  <vcpu placement='static'>%NUMCPUS%</vcpu>

  <!-- i440fx, not q35: every guest on these hypervisors is i440fx, and the
       machine type decides the PCI topology a guest's kernel already knows.
       `pc` is the alias for the host qemu's newest i440fx, so this does not
       pin a version the next hypervisor may not have. -->
  <os>
    <type arch='x86_64' machine='pc'>hvm</type>
  </os>

  <features>
    <acpi/>
    <pae/>
  </features>

  <!-- host-passthrough by default, so the guest sees the real CPU including
       AVX and friends.  Anything that probes cpuid for vector extensions
       needs it; migratability is what you trade for that. -->
  <cpu mode='%CPUMODE%'/>
  <clock offset='utc'/>

  <!-- virtiofs needs shared memory, and memfd is how you get it without
       hugepages.  Without this block every filesystem below fails to start. -->
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <devices>
    <!-- By volume rather than by path, so the domain does not hardcode where
         the pool happens to live.  The backing store is baked into the qcow2
         at creation; libvirt reports it back but we do not declare it. -->
    <disk type='volume' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source pool='%POOLNAME%' volume='%DISKVOLUME%'/>
      <target dev='vda' bus='virtio'/>
      <boot order='1'/>
    </disk>
%EXTRADISKS%
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='%CLOUDINIT%'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>

    <!-- Two interfaces: the libvirt NAT for the hypervisor to reach it by
         lease, and the outbound bridge for its real address.

         Both the PCI slot and the MAC are pinned rather than left to libvirt.
         The slot is what the guest's interface name is derived from ; ens3
         and ens4 here, because systemd names a PCI NIC after its hotplug slot
         ; so leaving it to allocation order means the names move whenever the
         device list does.  The MAC is derived from the domain name, so it is
         the same on every rebuild: the DHCP lease stays put, and the network
         configuration can match on it rather than on a name. -->
    <interface type='network'>
      <mac address='%NATMAC%'/>
      <source network='default'/>
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x0'/>
    </interface>
    <interface type='bridge'>
      <mac address='%BRIDGEMAC%'/>
      <source bridge='%BRIDGENAME%'/>
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x04' function='0x0'/>
    </interface>

%FILESYSTEMS%
    <!-- Cloud images expect a console and sulk without one:
         https://bugs.launchpad.net/cloud-images/+bug/1573095 -->
    <serial type='pty'><target port='0'/></serial>
    <console type='pty'><target type='serial' port='0'/></console>
    <console type='pty'><target type='virtio' port='1'/></console>

    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video><model type='cirrus' vram='16384' heads='1' primary='yes'/></video>
    <!-- stats period is what makes `virsh dommemstat` say anything; the
         existing guests have it. -->
    <memballoon model='virtio'>
      <stats period='5'/>
    </memballoon>
  </devices>
</domain>
