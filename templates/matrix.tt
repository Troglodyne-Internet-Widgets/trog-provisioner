# matrix-synapse-py3 and python3-txredisapi are matrix.org's packages, not
# Ubuntu's.  They were listed in deps, which is the list cloud-init installs at
# first boot -- with no such repository configured, so they were never
# installed, cloud-init said nothing about it, and every line below this ran
# against a matrix-synapse user that does not exist.
install -d -m 0755 /usr/share/keyrings
curl -fsSL https://packages.matrix.org/debian/matrix-org-archive-keyring.gpg -o /usr/share/keyrings/matrix-org-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/matrix-org-archive-keyring.gpg] https://packages.matrix.org/debian/ $$(. /etc/os-release; echo $$VERSION_CODENAME) main" > /etc/apt/sources.list.d/matrix-org.list
apt-get update
# Preseeded, because installing synapse otherwise stops on a debconf prompt for
# the server name, and a make recipe has no terminal to answer it from.
echo "matrix-synapse-py3 matrix-synapse/server-name string matrix.[% domain %]" | debconf-set-selections
echo "matrix-synapse-py3 matrix-synapse/report-stats boolean false" | debconf-set-selections
[%# matrix-synapse-py3 only.  The repository ships exactly that and its keyring,
    and the package carries its own Python dependencies inside it -- its Depends
    are system libraries and python3 itself -- so txredisapi, which synapse uses
    for redis, is inside the package and not separately installable anywhere. -%]
DEBIAN_FRONTEND=noninteractive apt-get install -y matrix-synapse-py3
# Put the homeserver back before anything below makes the directory it lives in.
# restore_state declines a destination that already has something in it, and an
# empty media/ is something -- so this has to come first, and after the package
# install, which is what creates the matrix-synapse account it is chowned to.
#
# Without this leg the salvaged homeserver simply sat in the domain directory:
# every room, message and account came down off the last guest and was never
# put back, and the new guest came up empty and, worse, minted itself a fresh
# signing key and introduced itself to the federation as somebody else.
#
# No owner argument: the chown -R and chmod -R below cover the restored tree,
# and a media store is not a thing to walk twice.
[% script_dir %]/restore_state [% install_dir %]/[% domain %]/matrix [% install_dir %]/matrix.[% domain %]
# Setup directories
mkdir -p [% install_dir %]/matrix.[% domain %]
mkdir -p [% install_dir %]/matrix.[% domain %]/media
mkdir -p [% install_dir %]/admin.matrix.[% domain %]
mkdir -p /etc/matrix-synapse
mkdir -p /var/log/matrix-synapse
# Set ownership using admin_user pattern
chown -R matrix-synapse:[% admin_user %] [% install_dir %]/matrix.[% domain %]
chmod -R 0750 [% install_dir %]/matrix.[% domain %]
chown -R matrix-synapse:matrix-synapse /var/log/matrix-synapse
# Deploy configuration files
cp homeserver.yaml /etc/matrix-synapse/
cp log.yaml /etc/matrix-synapse/
cp matrix-synapse.service /etc/systemd/system/
chown root:root /etc/matrix-synapse/homeserver.yaml
chown root:root /etc/matrix-synapse/log.yaml
chmod 0644 /etc/matrix-synapse/homeserver.yaml
chmod 0644 /etc/matrix-synapse/log.yaml
[%# The signing key is not made here, and must never be.  It is the federation
    identity of this server: a new one tells everybody who knew this homeserver
    that it is a stranger now.  bin/provision puts it on the guest out of the
    secret store before this makefile starts -- see guest_secrets in
    Provisioner::Recipe -- so a missing one means the store could not be
    reached, and generating a replacement would do the exact damage the store
    is there to prevent.  Fail instead, and say so. -%]
test -s /etc/matrix-synapse/homeserver.signing.key \
    || { echo "matrix: no signing key at /etc/matrix-synapse/homeserver.signing.key" >&2; \
         echo "bin/provision places it from the secret store; synapse must not be started without it." >&2; \
         exit 1; }
[%# Given away here because bin/provision places these before this guest has a
    matrix-synapse account to give them to -- the package that makes it is
    installed by this makefile.  Kept to synapse alone; nothing has to read
    either off this guest, since the store is where they come from. -%]
chown matrix-synapse:matrix-synapse /etc/matrix-synapse/homeserver.signing.key /etc/matrix-synapse/registration.shared.secret
chmod 0600 /etc/matrix-synapse/homeserver.signing.key /etc/matrix-synapse/registration.shared.secret
# Download and setup Synapse Admin
[% script_dir %]/matrix.download-admin.sh [% install_dir %]/admin.matrix.[% domain %]
chown -R www-data:[% admin_user %] [% install_dir %]/admin.matrix.[% domain %]
chmod -R 0750 [% install_dir %]/admin.matrix.[% domain %]
# Setup nginx sites
mkdir -p /etc/nginx/sites-enabled
# Only the admin vhost: the domain's own is nginxproxy's, which this recipe
# requires and which already carries the _matrix nocache prefix.  There was a
# `cp matrix.nginx.conf` here for a file template_files does not generate.
cp matrix-admin.nginx.conf /etc/nginx/sites-enabled/admin.matrix.[% domain %].conf
chown root:root /etc/nginx/sites-enabled/admin.matrix.[% domain %].conf
chmod 0644 /etc/nginx/sites-enabled/*.conf
# Slam in the chat index.html
install -m 0755 -o [% user %] -g www-data -d [% install_dir %]/[% domain %]/www; /bin/true
install -m 0755 -o [% user %] -g www-data matrix.index.html [% install_dir %]/[% domain %]/www
# Enable service (actual start will be queued)
systemctl daemon-reload
systemctl enable matrix-synapse
# Queue service start for postrun
[% script_dir %]/queue_postrun_task systemctl start matrix-synapse
[% script_dir %]/queue_postrun_task systemctl reload nginx
# Create script to register admin user after service is running
install -m 0750 matrix_register_admin.sh [% script_dir %]/matrix_register_admin.sh
chmod +x [% script_dir %]/matrix_register_admin.sh
# Queue admin user creation for postrun
[% script_dir %]/queue_postrun_task [% script_dir %]/matrix_register_admin.sh
