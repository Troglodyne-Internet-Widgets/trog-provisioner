[%# One line in forward-zones-file, not a config fragment in recursor.d.
    That fragment said `forward-zones+=<domain>=...`, and the recursor refused
    the whole file -- "could not be parsed" -- every time.  += needs a plain
    forward-zones to append to, and giving it one in recursor.conf, ahead of
    include-dir, did not help either: the documentation claims += for the main
    configuration and says nothing about files pulled in by include-dir, and the
    recursor agrees with the silence.
    forward-zones-file is the mechanism meant for this -- one zone per line,
    zone=address:port -- and every domain simply adds its line. -%]
# Point the recursor at our domain, via the forward zones file
grep -qxF '[% domain %]=127.0.0.1:2500' /etc/powerdns/forward-zones 2>/dev/null     || cat pdns-recursor-domain.conf >> /etc/powerdns/forward-zones
rm -f pdns-recursor-domain.conf
# Build the zone database
mkdir -p /var/spool/powerdns/[% domain %]; /bin/true
# TODO do this via lexicon instead
cp zonefile /var/spool/powerdns/[% domain %]/bind.zone
zone2sql --gsqlite --zone=zonefile --zone-name=[% domain %] > /var/spool/powerdns/[% domain %]/zone.sql
[%# Only load the zone into a database that does not already answer for it.  The
    global half puts the previous guest zones.db back before this runs, and what
    is in there is the live zone -- every record lexicon or DCV or somebody with
    a shell added after the last provision.  Reloading the zonefile over it
    would replace that with the handful of records this recipe knows about, and
    it would not even get that far: zone2sql emits a plain insert into domains,
    which the unique index on name refuses, so the target would fail outright.
    A zone that is already there and needs changing is a job for lexicon. -%]
sqlite3 /var/spool/powerdns/zones.db "SELECT id FROM domains WHERE name='[% domain %]'" | grep -q . || sqlite3 /var/spool/powerdns/zones.db < /var/spool/powerdns/[% domain %]/zone.sql
chown -R pdns:pdns /var/spool/powerdns
chmod -R 0775 /var/spool/powerdns
[% script_dir %]/queue_postrun_task systemctl restart pdns
[% script_dir %]/queue_postrun_task systemctl restart pdns-recursor
# Setup lexicon shortcuts
mkdir -p /opt/lexicon/[% domain %]; /bin/true
mv lexicon-pdns.sh /opt/lexicon/[% domain %]/pdns
chmod -R 0700 /opt/lexicon/[% domain %]
chown -R root:root /opt/lexicon/[% domain %]
