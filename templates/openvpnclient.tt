	# Sync client certificates from hypervisor
	mkdir -p /etc/openvpn/client
	# The package leaves a README in here saying what the directory is for, and
	# restore_state reads anything at the destination as state worth keeping and
	# declines.  A guest that has certificates has content either way, so the
	# only thing this clears is the README on a guest that does not.
	rm -f /etc/openvpn/client/README
	# What came off the last guest, before the hypervisor copy lands on top of
	# it.  cert_dir on the hypervisor is normally the authority for these and a
	# rebuilt guest needs nothing else; this is the copy that answers when it is
	# not, because the rsync below updates what cert_dir still has and leaves
	# anything it has lost since alone rather than starting the tunnel without
	# it.  restore_state declines on a guest that already has its certificates.
	[% script_dir %]/restore_state '[% install_dir %]/[% domain %]/openvpn-client' /etc/openvpn/client root:root
	rsync -av -e 'ssh -p[% hv_ssh_port %]' [% transfer_user %]@[% hv_ip %]:[% cert_dir %]/ /etc/openvpn/client/
	chmod 0600 /etc/openvpn/client/client.key /etc/openvpn/client/ta.key
	chown root:root /etc/openvpn/client/client.key /etc/openvpn/client/ta.key
	# Deploy client configuration
	cp client.conf /etc/openvpn/client/client.conf
	chown root:root /etc/openvpn/client/client.conf
	chmod 0640 /etc/openvpn/client/client.conf
	# Stage a copy the next fetch can read.  new_config comes in over sftp as
	# [% admin_user %] with no sudo, and this directory is root owned with the
	# keys at 0600, so naming it in remote_files fetched nothing at all and said
	# nothing about it.  Same trade the mail recipe makes for the DKIM keys: the
	# client key is readable by whoever holds the admin account from here, and
	# travels into the data directory and any backup of it.
	rm -rf /etc/openvpn/client-salvage
	mkdir -p /etc/openvpn/client-salvage
	cp -a /etc/openvpn/client/. /etc/openvpn/client-salvage/
	chown -R [% admin_user %]:[% admin_user %] /etc/openvpn/client-salvage
	chmod -R u=rwX,go= /etc/openvpn/client-salvage
	# Enable and start the tunnel immediately so dependent recipes can use it
	systemctl daemon-reload
	systemctl enable openvpn-client@client
	systemctl start openvpn-client@client
	# Wait for the tunnel interface to come up (up to 30s)
	[% script_dir %]/wait_for_iface tun0 30
	touch $@
