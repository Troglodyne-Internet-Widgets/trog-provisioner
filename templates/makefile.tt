[% FOR var IN vars.keys().sort() %]
[% var %] := [% vars.$var | mark_raw %]
[% END -%]

[% global_targets = ['sysctl', 'packages', 'scripts', 'data', 'ssl', 'ssh', 'sendmail', 'testdeps'] -%]
[% IF user -%]
[% IF user == admin_user -%]
[% global_targets.unshift('admin_user') -%]
[% ELSE -%]
[% global_targets.unshift('service_user') -%]
[% END -%]
[% END -%]
[% global_targets.unshift('state') -%]

.PHONY: all
[%# ufw last, after every module.  setup-ufw-rules allows whatever `ufw app
    list` reports, so a profile installed by a target running after it is a
    service the firewall never opens; and it opens with a `ufw reset`, which
    restores before.rules from the packaged copy and takes any rules already
    written into it.  Application profiles survive that reset, so every recipe
    can install one whenever it likes and be allowed here.

    bin/new_config lifts ufw out of modules_ordered so this is the only place
    the position is decided, rather than the alphabet deciding it. -%]
all:[% FOR target IN global_targets %] [% state_dir %]/[% target %][% END %][% IF fetch_hosts %] [% state_dir %]/fetch_via_cache[% END %][% FOR module IN modules_ordered %] [% module %][% END %][% IF ufw_fragment %] [% state_dir %]/ufw[% END %]
	[%# The tests run whether or not the deferred work succeeded, and the build
	    still fails afterwards if it did not.  post_install failing used to stop
	    make right there, so a guest with one broken postrun task produced no
	    test output at all -- which is exactly the guest whose test results you
	    want to read. -%]
	rm -f /root/.postrun_failed
	[% script_dir %]/post_install || touch /root/.postrun_failed
[% IF fetch_hosts -%]
[%# Every host given back to upstream once the deferred work is done, which is
    the last of what downloads anything, and before the tests, which ask about
    the guest as it will be left. -%]
	[% script_dir %]/fetch_via_cache off
[% END -%]
	$(MAKE) --no-print-directory [% state_dir %]/test
	test ! -f /root/.postrun_failed || { echo "post_install: some deferred work failed; see above" >&2; exit 1; }
	touch /root/install_complete

[% state_dir %]/state:
	mkdir -p [% state_dir %]
	touch $@

[% state_dir %]/sysctl:
	echo "net.ipv4.conf.all.arp_announce=1" > /etc/sysctl.d/10-arp-flux.conf
	echo "net.ipv4.conf.all.arp_ignore=2" >> /etc/sysctl.d/10-arp-flux.conf
	sysctl -p
	touch $@

[% state_dir %]/packages:
	# We have to account for broken packages that depend on apache or some other incompatible sofware for no reason
	# Or forgets to list a dependency, or relies on a curses UI to install
	# As such we have no way of knowing whether we have a fucked kit or not, yay
	[% packager_up_invocation | mark_raw %]; /bin/true
	#[% packager_invocation | mark_raw %] [% FOR pkg IN packages %][% pkg %] [% END %]; /bin/true
	#[% packager_invocation | mark_raw %] [% FOR pkg IN packages %][% pkg %] [% END %]; /bin/true
	touch $@

[% state_dir %]/testdeps:
	/bin/true;
	[% IF testdeps.size() %]
	cpanm [% testdeps.join(' ') %]
	[% END -%]

[% IF fetch_hosts -%]
[%# The hosts recipes download from, pointed at the fetch cache: after the
    global targets, which download nothing and put this script where it is run
    from, and ahead of every recipe.  Never touched, so a make run again asks
    the cache again -- what it answered for last time says nothing about now.
    scripts/fetch_via_cache has the rest. -%]
[% state_dir %]/fetch_via_cache:
	[% script_dir %]/fetch_via_cache on [% cache_ip %] fetchcache-ca.crt[% FOR host IN fetch_hosts %] [% host %][% END %]

[% END -%]
# Last, and after post_install rather than before it.  Most of what a recipe
# does to a service it defers -- enable here, start there -- so testing ahead of
# that asks whether the packaged config works, not whether ours does.
[% state_dir %]/test:
	prove -vm

[%# The one target here that is not distribution-neutral: /etc/mail/sendmail.mc
    and friends are where Debian puts them, and the packager invocations above
    are what keeps the rest of this file portable.  Left where it is rather than
    moved into templates/ubuntu/makefile.tt, because with one distribution in
    existence there is nothing to check the split against -- see issue #36. -%]
[% state_dir %]/sendmail:
	# Make sure mailing works by forcing send-only lo and enabling starttls
	! grep starttls.m4 /etc/mail/sendmail.mc && echo "include(\`/etc/mail/tls/starttls.m4')dnl\n" >> /etc/mail/sendmail.mc; /bin/true
	! grep starttls.m4 /etc/mail/submit.mc && echo "include(\`/etc/mail/tls/starttls.m4')dnl\n" >> /etc/mail/submit.mc; /bin/true
	test -f /etc/mail/sendmail.conf && sed -i -e "s/eth0/lo/gm" /etc/mail/sendmail.conf; /bin/true
	#XXX something mangles this later
	test -f /etc/mail/sendmail.conf && chattr +ie /etc/mail/sendmail.conf; /bin/true
	test -f /etc/mail/sendmail.conf && systemctl enable sendmail; /bin/true
	test -f /etc/mail/sendmail.conf && [% script_dir %]/queue_postrun_task systemctl restart sendmail; /bin/true
	newaliases
	touch $@

[% state_dir %]/service_user:
	useradd -s /usr/sbin/nologin -d [% install_dir %]/[% domain %] [% user %]
	mkdir -p [% install_dir %]/[% domain %]; /bin/true
	chown [% user %]:[% admin_user %] [% install_dir %]/[% domain %]
	touch $@

[% state_dir %]/admin_user:
	 mkdir -p [% install_dir %]; /bin/true
	 ln -s /home/[% admin_user %] [% install_dir %]/[% domain %]
	 chown [% admin_user %]:[% admin_user %] [% install_dir %]/[% domain %]
	 touch $@

[% state_dir %]/scripts:
	mkdir -p [% script_dir %]
	mv scripts/* [% script_dir %]/
	touch $@

# Make a self-signed cert FIRST, because everybody and their mama needs a damn cert
[% state_dir %]/ssl:
	# The domain itself first, then every alias -- new_config appends www and
	# mail to each domain's aliases, so they are in there.  This named www and
	# mail explicitly and then joined the aliases straight onto the end with no
	# separator, and full_aliases was never passed to this template in the first
	# place: the certificate came out covering www and mail and not the domain.
	mkdir -p '/etc/letsencrypt/live/[% domain %]'
	openssl req -x509 -config openssl.conf -nodes -newkey rsa:4096 -subj '/CN=[% domain %]' -addext 'subjectAltName=DNS:[% domain %][% FOR alias IN full_aliases %],DNS:[% alias %][% END %]' -keyout '/etc/letsencrypt/live/[% domain %]/privkey.pem' -out '/etc/letsencrypt/live/[% domain %]/fullchain.pem' -days 365
	# Setup the link to LE certs
	# -sf, because these are the two links the letsencrypt fetcher repoints
	# later: a guest restored from a snapshot and provisioned again already has
	# them, and a plain ln then fails with "File exists" and takes the ssl
	# target -- which every other target waits on -- down with it.
	ln -sf /etc/letsencrypt/live/[% domain %]/fullchain.pem /etc/ssl/certs/[% domain %].pem
	ln -sf /etc/letsencrypt/live/[% domain %]/privkey.pem /etc/ssl/private/[% domain %].pem
	touch $@

# Be explicit about SSH security
# You will want to have users setup via ipmap/recipes.
[% state_dir %]/ssh:
	echo 'PermitRootLogin prohibit-password' > /etc/ssh/sshd_config.d/100-security.conf
	echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config.d/100-security.conf
	touch $@

[% state_dir %]/data:
[% data_fragment | tabinate -%]
	touch $@

[% IF ufw_fragment -%]
[% state_dir %]/ufw:
[% ufw_fragment | tabinate -%]
	touch $@
[% END -%]

[% FOR module IN global_fragments.keys().sort() %]
[% global_state_dir %]/global_[% module %]:
[% global_fragments.$module | tabinate -%]
	touch $@
[% END -%]
[% FOR module IN fragments.keys().sort() %]
[% state_dir %]/[% module %]:
[% fragments.$module | tabinate -%]
	touch $@
[% END -%]
