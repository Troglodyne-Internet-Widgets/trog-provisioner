# Recipe lines run under bash and not under /bin/sh, the default of make.
SHELL := /bin/bash

[% FOR var IN vars.keys().sort() %]
[% var %] := [% vars.$var | mark_raw %]
[% END -%]

[% global_targets = ['sysctl', 'packages', 'scripts', 'data', 'ssl', 'ssh', 'sendmail', 'testdeps'] -%]
[% IF user -%]
[% IF user == admin_user -%]
[% global_targets.unshift('admin_user') -%]
[% ELSE -%]
[% global_targets.unshift('service_user') -%]
[% END -%]
[% END -%]
[% global_targets.unshift('state') -%]

.PHONY: all
[%# ufw runs last, after every module.  setup-ufw-rules allows each profile
    that `ufw app list` shows, so the firewall never opens a profile that a
    later target installs.  setup-ufw-rules also starts with a `ufw reset`.
    The reset restores before.rules from the packaged copy and removes any rules
    written into it.  Application profiles survive the reset, so a recipe can
    install one at any time and ufw allows it here.

    bin/new_config takes ufw out of modules_ordered, so only this line decides
    its position, and not alphabetical order. -%]
all:[% FOR target IN global_targets %] [% state_dir %]/[% target %][% END %][% IF fetch_hosts %] [% state_dir %]/fetch_via_cache[% END %][% FOR module IN modules_ordered %] [% module %][% END %][% IF ufw_fragment %] [% state_dir %]/ufw[% END %]
	[%# The tests run even when the deferred work fails, and the build fails
	    after them.  A guest with a broken postrun task is the guest whose test
	    results you want to read. -%]
	rm -f /root/.postrun_failed
	[% script_dir %]/post_install || touch /root/.postrun_failed
[% IF fetch_hosts -%]
[%# Send every host back to upstream here.  This is after the deferred work,
    the last step that downloads anything, and before the tests, which examine
    the guest in its final state. -%]
	[% script_dir %]/fetch_via_cache off
[% END -%]
	$(MAKE) --no-print-directory [% state_dir %]/test
	test ! -f /root/.postrun_failed || { echo "post_install: some deferred work failed; see above" >&2; exit 1; }
	touch /root/install_complete

[% state_dir %]/state:
	mkdir -p [% state_dir %]
	touch $@

[% state_dir %]/sysctl:
	echo "net.ipv4.conf.all.arp_announce=1" > /etc/sysctl.d/10-arp-flux.conf
	echo "net.ipv4.conf.all.arp_ignore=2" >> /etc/sysctl.d/10-arp-flux.conf
	sysctl -p
	touch $@

[%# Only the upgrade: cloud-init installs the packages, out of the user-data the distro recipe renders. -%]
[% state_dir %]/packages:
	# Ignore a failed upgrade.  Some packages depend on software that conflicts,
	# forget to list a dependency, or need a curses UI to install.  So the exit
	# status cannot tell a broken kit from a good one.
	[% packager_up_invocation | mark_raw %]; /bin/true
	touch $@

[% state_dir %]/testdeps:
	/bin/true;
	[% IF testdeps.size() %]
	cpanm[% FOR flag IN testdeps_flags %] [% flag %][% END %] [% testdeps.join(' ') %]
	[% END -%]

[% IF fetch_hosts -%]
[%# Point the hosts that recipes download from at the fetch cache.  This target
    runs after the global targets, which download nothing and install this
    script, and before every recipe.  It never touches its state file, so each
    make run asks the cache again.  An earlier answer says nothing about now.
    scripts/fetch_via_cache has the rest. -%]
[% state_dir %]/fetch_via_cache:
	[% script_dir %]/fetch_via_cache on [% cache_ip %] fetchcache-ca.crt[% FOR host IN fetch_hosts %] [% host %][% END %]

[% END -%]
# The tests run last, after post_install.  A recipe defers most of its work on a
# service, for example it enables the service here and starts it in post_install.
# A test before that step tests the packaged configuration, not ours.
[% state_dir %]/test:
	prove -vm

[%# This is the one target here that is specific to a distribution.  Debian
    puts /etc/mail/sendmail.mc and the files next to it where this target looks.
    The packager invocations above keep the rest of this file portable.  The
    target stays here and not in templates/ubuntu/makefile.tt.  With only one
    distribution, nothing can test the split.  See issue #36. -%]
[% state_dir %]/sendmail:
	# Make mail work: send only, listen on lo only, and use starttls.
	# Make the certificate first.  Debian makes it in sendmailconfig, and the
	# postinst only runs sendmailconfig after a question that a noninteractive
	# install does not answer.  Without it, starttls has nothing to present.
	test -x /usr/share/sendmail/update_tls && /usr/share/sendmail/update_tls < /dev/null; /bin/true
	# The configuration that update_tls writes caps emailAddress at 40 characters.
	# It asks for admin@`hostname -f`, so it refuses a name over 34 characters
	# and hides the error.  Widen the cap and run update_tls again.  It keeps the
	# configuration and the key that it made, so it only tries the certificate again.
	sed -i -e 's/^emailAddress_max.*/emailAddress_max = 255/' /etc/mail/tls/sendmail-server.cfg /etc/mail/tls/sendmail-client.cfg; /bin/true
	test -x /usr/share/sendmail/update_tls && /usr/share/sendmail/update_tls < /dev/null; /bin/true
	! grep starttls.m4 /etc/mail/sendmail.mc && printf '%s\n\n' "include(\`/etc/mail/tls/starttls.m4')dnl" >> /etc/mail/sendmail.mc; /bin/true
	! grep starttls.m4 /etc/mail/submit.mc && printf '%s\n\n' "include(\`/etc/mail/tls/starttls.m4')dnl" >> /etc/mail/submit.mc; /bin/true
	test -f /etc/mail/sendmail.conf && sed -i -e "s/eth0/lo/gm" /etc/mail/sendmail.conf; /bin/true
	#XXX something mangles this later
	test -f /etc/mail/sendmail.conf && chattr +ie /etc/mail/sendmail.conf; /bin/true
	test -f /etc/mail/sendmail.conf && systemctl enable sendmail; /bin/true
	test -f /etc/mail/sendmail.conf && [% script_dir %]/queue_postrun_task systemctl restart sendmail; /bin/true
	newaliases
	touch $@

[%# One machine can hold several domains.  The account is per machine and this
    target is per domain, so a second domain must not stop on the account that
    the first one made. %]
[% state_dir %]/service_user:
	getent passwd [% user %] > /dev/null || useradd -s /usr/sbin/nologin -d [% install_dir %]/[% domain %] [% user %]
	mkdir -p [% install_dir %]/[% domain %]; /bin/true
	chown [% user %]:[% admin_user %] [% install_dir %]/[% domain %]
	touch $@

[% state_dir %]/admin_user:
	 mkdir -p [% install_dir %]; /bin/true
	 ln -s /home/[% admin_user %] [% install_dir %]/[% domain %]
	 chown [% admin_user %]:[% admin_user %] [% install_dir %]/[% domain %]
	 touch $@

[% state_dir %]/scripts:
	mkdir -p [% script_dir %]
	mv scripts/* [% script_dir %]/
	touch $@

# A self-signed certificate, only so that a service with TLS can start before
# there is a real one.  The letsencrypt recipe gets the real one with dehydrated
# in the postrun, points the two links below at it, and restarts the services.
# Every domain gets this, whatever its recipes are, because it costs one
# openssl command and a guest has no certificate otherwise.
[% state_dir %]/ssl:
	# Name the domain first, then every alias.  new_config adds www and mail to
	# the aliases of each domain.
	mkdir -p '/etc/letsencrypt/live/[% domain %]'
	openssl req -x509 -config openssl.conf -nodes -newkey rsa:4096 -subj '/CN=[% domain %]' -addext 'subjectAltName=DNS:[% domain %][% FOR alias IN full_aliases %],DNS:[% alias %][% END %]' -keyout '/etc/letsencrypt/live/[% domain %]/privkey.pem' -out '/etc/letsencrypt/live/[% domain %]/fullchain.pem' -days 365
	# Link to the certificate where letsencrypt keeps it.  Use -sf, because the
	# letsencrypt fetcher repoints these links later.  A guest restored from a
	# snapshot and provisioned again already has them.  A plain ln then fails
	# with "File exists" and stops the ssl target, which every other target needs.
	ln -sf /etc/letsencrypt/live/[% domain %]/fullchain.pem /etc/ssl/certs/[% domain %].pem
	ln -sf /etc/letsencrypt/live/[% domain %]/privkey.pem /etc/ssl/private/[% domain %].pem
	touch $@

# Set the SSH security policy explicitly.  Password logins stop working, so set
# up users and their keys in ipmap.cfg and the users.yaml of the data directory.
[% state_dir %]/ssh:
	echo 'PermitRootLogin prohibit-password' > /etc/ssh/sshd_config.d/100-security.conf
	echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config.d/100-security.conf
	touch $@

[% state_dir %]/data:
[% data_fragment | tabinate -%]
	touch $@

[% IF ufw_fragment -%]
[% state_dir %]/ufw:
[% ufw_fragment | tabinate -%]
	touch $@
[% END -%]

[% FOR module IN global_fragments.keys().sort() %]
[% global_state_dir %]/global_[% module %]:
[% global_fragments.$module | tabinate -%]
	touch $@
[% END -%]
[% FOR module IN fragments.keys().sort() %]
[% state_dir %]/[% module %]:
[% fragments.$module | tabinate -%]
	touch $@
[% END -%]
