#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active gogs 2>/dev/null`;
chomp $status;
is($status, 'active', 'gogs is running');
ok(-f '[% install_dir %]/git.[% domain %]/custom/conf/app.ini', 'gogs config exists');

# These four are made in one brace expansion, which is bash and not POSIX sh.
# Make ran recipe lines under /bin/sh -- dash, here -- until the Makefile said
# otherwise, and dash made one directory named after the whole brace list, so
# none of these existed and app.ini had nowhere to be installed.
foreach my $dir (qw{repos data log custom/conf}) {
    ok(-d "[% install_dir %]/git.[% domain %]/$dir", "the $dir directory was created");
}
ok(!-d '[% install_dir %]/git.[% domain %]/{repos,data,log,custom/conf}',
    'and none was created with the braces taken literally');

# The account gogs runs as.  Its useradd sat behind an `id -u ... &>/dev/null ||`
# guard, and dash reads &> as a background & -- so the guard always succeeded
# and the account was never created on a guest that did not already have one.
my $passwd = `getent passwd [% gogs_admin %] 2>/dev/null`;
ok($passwd, 'the [% gogs_admin %] account exists');
like($passwd, qr{:\Q[% install_dir %]/git.[% domain %]\E:}, 'with the home directory the recipe asked for');

# The vhost belongs to nginxproxy, which this recipe requires and points at
# gogs on port 3000.  gogs used to install one of its own from a template that
# does not exist, which killed the target outright.
ok(-f '/etc/nginx/sites-enabled/[% domain %].conf', 'nginxproxy wrote the domain vhost');
ok(!-e '/etc/nginx/sites-enabled/git.[% domain %].conf',
    'and gogs did not write a competing one');

my $check = `nginx -t 2>&1`;
like($check, qr/test is successful/, 'nginx accepts the configuration') or diag $check;

done_testing();
