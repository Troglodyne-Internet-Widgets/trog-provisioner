#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active gogs 2>/dev/null`;
chomp $status;
is($status, 'active', 'gogs is running');
ok(-f '[% install_dir %]/git.[% domain %]/custom/conf/app.ini', 'gogs config exists');

# These four are made in one brace expansion, which is bash and not POSIX sh.
# Make ran recipe lines under /bin/sh -- dash, here -- until the Makefile said
# otherwise, and dash made one directory named after the whole brace list, so
# none of these existed and app.ini had nowhere to be installed.
foreach my $dir (qw{repos data log custom/conf}) {
    ok(-d "[% install_dir %]/git.[% domain %]/$dir", "the $dir directory was created");
}
ok(!-d '[% install_dir %]/git.[% domain %]/{repos,data,log,custom/conf}',
    'and none was created with the braces taken literally');

# The account gogs runs as.  Its useradd sat behind an `id -u ... &>/dev/null ||`
# guard, and dash reads &> as a background & -- so the guard always succeeded
# and the account was never created on a guest that did not already have one.
my $passwd = `getent passwd [% gogs_admin %] 2>/dev/null`;
ok($passwd, 'the [% gogs_admin %] account exists');
like($passwd, qr{:\Q[% install_dir %]/git.[% domain %]\E:}, 'with the home directory the recipe asked for');

# The vhost belongs to nginxproxy, which this recipe requires and points at
# gogs on port 3000.  gogs used to install one of its own from a template that
# does not exist, which killed the target outright.
ok(-f '/etc/nginx/sites-enabled/[% domain %].conf', 'nginxproxy wrote the domain vhost');
ok(!-e '/etc/nginx/sites-enabled/git.[% domain %].conf',
    'and gogs did not write a competing one');

my $check = `nginx -t 2>&1`;
like($check, qr/test is successful/, 'nginx accepts the configuration') or diag $check;

# The database it was actually configured with.  gogs renamed this key from
# DB_TYPE to TYPE and ignores the one it does not know, so it fell back to its
# postgres defaults and died on every start -- while app.ini said sqlite3 and
# the journal said only "status=1/FAILURE".
my $ini = do { local (@ARGV, $/) = '[% install_dir %]/git.[% domain %]/custom/conf/app.ini'; <> } // '';
like($ini, qr/^TYPE\s*=\s*sqlite3/m, 'the database type is set with the key gogs reads');
unlike($ini, qr/^DB_TYPE\s*=/m, 'and not with the one it ignores');

# console as well as file, so a gogs that will not start says why where systemd
# can see it.
like($ini, qr/^MODE\s*=\s*console/m, 'gogs logs to the console as well as its own file');

ok(-s '[% install_dir %]/git.[% domain %]/data/gogs.db', 'the sqlite database was created');

# The release asset is not named after the version alone.  gogs started
# spelling it gogs_v0.14.2_linux_amd64.tar.gz at 0.14.2, so the URL built from
# the bare version 404s from that release on -- curl wrote nothing, tar had
# nothing to open and the whole target died before any of this ran.  Asking the
# binary its version covers both halves: that one was fetched at all, and that
# it is the one this domain asked for.
my $reported = `/usr/local/bin/gogs --version 2>&1`;
chomp $reported;
like($reported, qr/\b\Q[% version %]\E\b/, 'the installed gogs is the version configured')
    or diag $reported;

# The git service the last guest was carrying, put where gogs reads it.
# new_config fetches git.[% domain %] into the domain directory -- every
# repository, the issue database, the users -- and nothing ever moved it back
# out again, so a rebuilt guest came up with no repositories at all and met the
# people who owned them with the installer.
my $salvaged = '[% install_dir %]/[% domain %]/gogs';

sub entries {
    my ($dir) = @_;
    opendir(my $dh, $dir) or return ();
    my @found = grep { !m/\A[.][.]?\z/ } readdir $dh;
    closedir $dh;
    return @found;
}

# restore_state leaves the copy alone when the destination already has state --
# re-provisioning a guest that is still running, whose own repositories are the
# real ones.  Either way, nothing the copy knows about may be missing here.
my @salvaged_repos = entries("$salvaged/repos");
if (@salvaged_repos) {
    my @live_repos = entries('[% install_dir %]/git.[% domain %]/repos');
    ok(scalar @live_repos >= scalar @salvaged_repos, 'every account with salvaged repositories has them on the guest')
        or diag "salvaged: @salvaged_repos, live: @live_repos";
}
ok(!-e "$salvaged/data/gogs.db" || -s '[% install_dir %]/git.[% domain %]/data/gogs.db',
    'a salvaged database is not sitting in the domain directory with nothing at the live path');

# The session key belongs to the guest.  It signs sessions and encrypts 2FA
# enrolments, and it used to arrive as sixty-four characters minted by whichever
# new_config run wrote app.ini -- so every re-provision logged everybody out and
# voided every second factor, and said nothing about it.
my ($key) = $ini =~ m/^SECRET_KEY\s*=\s*(\S+)\s*$/m;
ok($key && length($key) >= 32, 'gogs has a session key of some substance')
    or diag 'SECRET_KEY: ' . ($key // 'unset');

my $salvaged_ini = "$salvaged/custom/conf/app.ini";
if (-f $salvaged_ini) {
    my $was = do { local (@ARGV, $/) = $salvaged_ini; <> } // '';
    my ($had) = $was =~ m/^SECRET_KEY\s*=\s*(\S+)\s*$/m;
    is($key, $had, 'and it is the key the guest already had, not one minted this run') if $had;
}

my $port = `ss -lntp 2>/dev/null | grep -c ':3000 '`;
chomp $port;
ok($port >= 1, 'gogs is listening on port 3000');

done_testing();
