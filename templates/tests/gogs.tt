#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active gogs 2>/dev/null`;
chomp $status;
is($status, 'active', 'gogs is running');
ok(-f '[% install_dir %]/git.[% domain %]/custom/conf/app.ini', 'gogs config exists');

foreach my $dir (qw{repos data log custom/conf}) {
    ok(-d "[% install_dir %]/git.[% domain %]/$dir", "the $dir directory was created");
}
ok(!-d '[% install_dir %]/git.[% domain %]/{repos,data,log,custom/conf}',
    'and none was created with the braces taken literally');

my $passwd = `getent passwd [% gogs_admin %] 2>/dev/null`;
ok($passwd, 'the [% gogs_admin %] account exists');
like($passwd, qr{:\Q[% install_dir %]/git.[% domain %]\E:}, 'with the home directory the recipe asked for');

# The vhost belongs to nginxproxy, which this recipe requires and points at
# gogs on port 3000.
ok(-f '/etc/nginx/sites-enabled/[% domain %].conf', 'nginxproxy wrote the domain vhost');
ok(!-e '/etc/nginx/sites-enabled/git.[% domain %].conf',
    'and gogs did not write a competing one');

my $check = `nginx -t 2>&1`;
like($check, qr/test is successful/, 'nginx accepts the configuration') or diag $check;

# The database key that gogs reads.  gogs ignores the old key DB_TYPE, falls
# back to its postgres defaults and then does not start.
my $ini = do { local (@ARGV, $/) = '[% install_dir %]/git.[% domain %]/custom/conf/app.ini'; <> } // '';
like($ini, qr/^TYPE\s*=\s*sqlite3/m, 'the database type is set with the key gogs reads');
unlike($ini, qr/^DB_TYPE\s*=/m, 'and not with the one it ignores');

# Console as well as file, so that the journal shows why gogs does not start.
like($ini, qr/^MODE\s*=\s*console/m, 'gogs logs to the console as well as its own file');

ok(-s '[% install_dir %]/git.[% domain %]/data/gogs.db', 'the sqlite database was created');

# From 0.14.2 on, the release asset has a v before the version, as in
# gogs_v0.14.2_linux_amd64.tar.gz.  The version that the binary reports shows
# that the fragment fetched a release, and that it is the configured version.
my $reported = `/usr/local/bin/gogs --version 2>&1`;
chomp $reported;
like($reported, qr/\b\Q[% version %]\E\b/, 'the installed gogs is the version configured')
    or diag $reported;

# The salvage from the last guest must be back where gogs reads it.  new_config
# fetches it into the domain directory, and the data target puts it back.
my $salvaged = '[% install_dir %]/[% domain %]/gogs';

sub entries {
    my ($dir) = @_;
    opendir(my $dh, $dir) or return ();
    my @found = grep { !m/\A[.][.]?\z/ } readdir $dh;
    closedir $dh;
    return @found;
}

# restore_state does not replace a destination that already has state, as on a
# live guest that is provisioned again.  In both cases, everything in the
# salvage must be here.
my @salvaged_repos = entries("$salvaged/repos");
if (@salvaged_repos) {
    my @live_repos = entries('[% install_dir %]/git.[% domain %]/repos');
    ok(scalar @live_repos >= scalar @salvaged_repos, 'every account with salvaged repositories has them on the guest')
        or diag "salvaged: @salvaged_repos, live: @live_repos";
}
ok(!-e "$salvaged/data/gogs.db" || -s '[% install_dir %]/git.[% domain %]/data/gogs.db',
    'a salvaged database is not sitting in the domain directory with nothing at the live path');

# The session key belongs to the guest.  A new key on each provision logs out
# every user.  See args in Provisioner::Recipe::gogs.
my ($key) = $ini =~ m/^SECRET_KEY\s*=\s*(\S+)\s*$/m;
ok($key && length($key) >= 32, 'gogs has a session key of some substance')
    or diag 'SECRET_KEY: ' . ($key // 'unset');

my $salvaged_ini = "$salvaged/custom/conf/app.ini";
if (-f $salvaged_ini) {
    my $was = do { local (@ARGV, $/) = $salvaged_ini; <> } // '';
    my ($had) = $was =~ m/^SECRET_KEY\s*=\s*(\S+)\s*$/m;
    is($key, $had, 'and it is the key the guest already had, not one minted this run') if $had;
}

my $port = `ss -lntp 2>/dev/null | grep -c ':3000 '`;
chomp $port;
ok($port >= 1, 'gogs is listening on port 3000');

# The host name that gogs uses.  The vhost from nginxproxy answers on the domain
# and on the aliases that new_config gives it, and git. is not one of them.
like($ini, qr{^ROOT_URL\s*=\s*https://\Q[% domain %]\E/?\s*$}m, 'ROOT_URL is the domain the vhost answers on')
    or diag $ini;
like($ini, qr/^DOMAIN\s*=\s*\Q[% domain %]\E\s*$/m, 'and so is DOMAIN');
unlike($ini, qr{^(ROOT_URL|DOMAIN)\s*=.*\bgit\.\Q[% domain %]\E}m,
    'neither names a git. host the operator would have had to create');

# And gogs answers there.  The vhost proxies every request, so this tests the
# whole path: nginx, the proxy_pass and gogs.
my $served = `curl -sk -o /dev/null -w '%{http_code}' -H 'Host: [% domain %]' https://127.0.0.1/ 2>/dev/null`;
like($served, qr/^(200|30[0-9])$/, 'the domain itself serves gogs through nginx')
    or diag "got HTTP $served";

done_testing();
