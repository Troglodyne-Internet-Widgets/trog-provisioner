#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# The unit, the configuration and the certificates are named for the domain,
# because a guest can hold two of these tunnels.
my $status = `systemctl is-active openvpn-client\@[% domain %] 2>/dev/null`;
chomp $status;
is($status, 'active', 'the tunnel for this domain is running');

ok(-f '/etc/openvpn/client/[% domain %].conf', 'its configuration is where openvpn-client@ looks for it');
ok(-d '/etc/openvpn/client/[% domain %]', 'and its certificates are in a directory of its own');
foreach my $file (qw{ca.crt client.crt client.key ta.key}) {
    ok(-s "/etc/openvpn/client/[% domain %]/$file", "which has $file in it");
}
is((stat('/etc/openvpn/client/[% domain %]/client.key'))[2] & 07777, 0600, 'and the key is readable by nobody else');

# The interface that the recipe waits for, checked here apart from that wait.
my $link = `ip link show [% device %] 2>&1`;
like($link, qr/\Q[% device %]\E/, 'the tunnel interface is up under the name this domain was given') or diag $link;

[% IF issue_from -%]
# The address comes from the bin of ip_pool that [% issue_from %] routes, and
# the server gives it at each connect.
my @blocks = qw{[% address_blocks.join(' ') %]};
my ($address) = `ip -4 -o addr show dev [% device %] 2>&1` =~ m{\binet\s+(\d+(?:\.\d+){3})/};
my $in = sub {
    my ($block) = @_;
    my ($net, $prefix) = split m{/}, $block;
    my $mask = $prefix ? (0xFFFFFFFF << (32 - $prefix)) & 0xFFFFFFFF : 0;
    return (unpack('N', pack('C4', split /\./, $address)) & $mask) == unpack('N', pack('C4', split /\./, $net));
};
ok($address && grep({ $in->($_) } @blocks), 'the tunnel has the static address that [% issue_from %] gave this domain')
    or diag 'address: ' . ($address // 'none') . ", bin: @blocks";

# The guests of this installation by name, without a DNS server that knows them.
my $hosts = do { local (@ARGV, $/) = '/etc/hosts'; <> } // q{};
my $marked = () = $hosts =~ m/^# BEGIN trog openvpnclient \Q[% domain %]\E$/gm;
is($marked, 1, '/etc/hosts has one block of the guests that the tunnel reaches');
my %pool = (
[% FOR name IN ipmap.keys().sort() -%]
[% IF name != domain -%]
    '[% name %]' => '[% ipmap.$name %]',
[% END -%]
[% END -%]
);
my ($name) = sort keys %pool;
SKIP: {
    skip 'the ip pool assigns no other guest', 2 unless defined $name;
    my ($found) = `getent hosts $name` =~ m/^(\S+)/;
    is($found, $pool{$name}, "$name resolves to its address in the ip pool");

    my $route = `ip -4 route get $pool{$name} 2>&1`;
[% IF same_network_as_server -%]
    unlike($route, qr/\bdev\s+\Q[% device %]\E\b/, "$name is on the network of this guest, so it is reached there and not through the tunnel") or diag $route;
[% ELSE -%]
    like($route, qr/\bdev\s+\Q[% device %]\E\b/, "$name is reached through the tunnel") or diag $route;
[% END -%]
}

[% END -%]
# Nothing is salvaged off this guest.  Provisioner::Recipe::openvpnclient says why.

done_testing();
