use strict;
use warnings;

use Test::More;

my $port     = '[% port %]';
my $protocol = '[% protocol %]';
my $log_dir  = '[% log_dir %]';

subtest 'rsyslog is running and accepts its configuration' => sub {
    chomp( my $active = `systemctl is-active rsyslog 2>/dev/null` );
    is( $active, 'active', 'rsyslog is running' );

    my $out = `rsyslogd -N1 2>&1`;
    unlike( $out, qr/error|could not|unknown|invalid/i, 'rsyslogd -N1 finds nothing to complain about' )
      or diag $out;
};

subtest 'it is listening where it said it would' => sub {

    # The configured port, not 514.  If you ask only about 514, a moved
    # collector and a broken collector look the same.
    my $listening = `ss -lntu 2>/dev/null`;
[% IF protocol == 'udp' %]
    like( $listening, qr/^udp\s+UNCONN\s.*:$port\b/m, "something is bound to $port/udp" ) or diag $listening;
[% ELSE %]
    like( $listening, qr/^tcp\s+LISTEN\s.*:$port\b/m, "something is bound to $port/tcp" ) or diag $listening;
[% END %]
};

subtest 'the firewall profile is one ufw will actually use' => sub {

    # ufw skips a profile whose section name is also in /etc/services, and says
    # nothing.  So a correct profile can exist and never make a rule.
    my $profiles = `ufw app list 2>&1`;
    like( $profiles, qr/logcollector/, 'ufw lists the profile' ) or diag $profiles;
};

subtest 'rotation is configured and logrotate will read it' => sub {
    my $conf = '/etc/logrotate.d/logcollector';
    ok( -f $conf, "$conf exists" ) or return;

    # logrotate ignores a configuration that root does not own, or that the
    # group can write.  It says so only in -d output.  templates/tests/backup.tt
    # does the same test.
    my $out = `logrotate -d $conf 2>&1`;
    unlike( $out, qr/Ignoring/, 'logrotate does not ignore it' ) or diag $out;

    # Read the file, not the -d output.  On a new collector no logs have
    # rotated, so -d says "not running postrotate script, since no logs were
    # rotated".
    my $body = do { open( my $fh, '<', $conf ) or die $!; local $/; <$fh> };
    like( $body, qr{postrotate\s+/usr/lib/rsyslog/rsyslog-rotate}s, 'and rotation signals rsyslog, so it reopens the files it was writing' );
};

# The full path on one machine: a message goes over the port, through the
# listener ruleset, into the file for its sender.
#
# The message must go over the port.  A plain `logger` goes through the default
# rules and never enters the collector ruleset.  A test that uses it can pass on a
# guest that receives nothing.
subtest 'a message sent over the port lands in a file named for its sender' => sub {
    my $marker = "logcollector-selftest-$$-" . time;

[% IF protocol == 'udp' %]
    system( 'logger', '-n', '127.0.0.1', '-P', $port, '-d', '-t', 'logcollector-test', $marker );
[% ELSE %]
    system( 'logger', '-n', '127.0.0.1', '-P', $port, '-T', '-t', 'logcollector-test', $marker );
[% END %]

    # rsyslog writes asynchronously.  A single check races it and fails on a
    # collector that works.
    my @found;
    foreach ( 1 .. 20 ) {
        chomp( @found = split( m/\n/, `grep -l '$marker' '$log_dir'/*.log 2>/dev/null` // q{} ) );
        last if @found;
        select( undef, undef, undef, 0.5 );
    }

    is( scalar @found, 1, 'the marker arrived, in exactly one per-sender file' )
      or diag "Nothing matching $marker under $log_dir after 10s.  Directory holds: " . ( `ls -la '$log_dir' 2>&1` // 'nothing' )
      . "\nrsyslog said: " . ( `journalctl -u rsyslog --no-pager -n 5 2>&1` // q{} );
    diag "filed as $found[0]" if @found;
};

subtest 'the fleet logs do not also land in this guest own syslog' => sub {

    # The listener has its own ruleset that ends in stop, so a message from a
    # sender is written once.  Without it, the collector keeps a second copy of
    # each message in /var/log/syslog, and rotates only one of the two copies.
    my $conf = do { open( my $fh, '<', '/etc/rsyslog.d/09-logcollector.conf' ) or die $!; local $/; <$fh> };
    like( $conf, qr/ruleset="logcollector"/, 'the input is bound to its own ruleset' );
    like( $conf, qr/secpath-replace/,        'and a sender cannot choose the path it is written to' );
};

# This test is about order.  The per-host file action and the forwards share a
# ruleset that ends in stop, and stop ends the processing of the message.  A
# forward below it never runs.  Then the consumer on this guest receives nothing,
# and each other test here still passes.
subtest 'each forwarded copy is sent before the ruleset stops' => sub {
    my @expect = ( [% FOR dest IN forward %]'[% dest %]', [% END %] );
    plan skip_all => 'nothing on this guest asked for a copy of the stream' unless @expect;

    my $conf = do { open( my $fh, '<', '/etc/rsyslog.d/09-logcollector.conf' ) or die $!; local $/; <$fh> };
    my ($ruleset) = $conf =~ m/ruleset\(name="logcollector"\)\s*\{(.*?)\n\}/s;
    ok( $ruleset, 'the collector ruleset is there to look in' ) or return;

    my $stop = index( $ruleset, 'stop' );
    foreach my $dest (@expect) {
        my ($host) = split( m/:/, $dest );
        my $at = index( $ruleset, qq{target="$host"} );
        cmp_ok( $at, '>=', 0,     "the copy to $dest is an action in the ruleset" );
        cmp_ok( $at, '<',  $stop, "and it is above the stop, which would otherwise drop it" );
    }
};

done_testing();
