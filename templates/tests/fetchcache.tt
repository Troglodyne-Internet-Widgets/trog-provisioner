use strict;
use warnings;

use Test::More;

my $store = '[% store %]';
my @hosts = qw{[% allow.join(' ') %]};
my $chain = '/etc/ssl/certs/fetchcache.pem';

# Ask by name, as a guest does when its /etc/hosts points the name here.  Only
# that shows that nginx and the certificate answer to the name.
sub ask {
    my ( $host, $path, @curl ) = @_;
    my $out = `curl -s -o /dev/null -D - --max-time 60 --resolve '$host:443:127.0.0.1' @curl 'https://$host$path' 2>/dev/null`;
    my ($code)   = $out =~ m{\AHTTP/\S+ (\d+)};
    my ($status) = $out =~ m{^X-Cache-Status: (\S+)}mi;
    return ( $code // 'none', $status // 'none' );
}

chomp( my $nginx_active = `systemctl is-active nginx 2>/dev/null` );
is( $nginx_active, 'active', 'nginx is running' );

my $nginx_t = `nginx -t 2>&1`;
like( $nginx_t, qr/test is successful/, 'and its configuration is valid' ) or diag $nginx_t;

my @store = stat($store);
ok( @store, "the store $store exists" );
is( ( getpwuid( $store[4] // -1 ) )[0] // 'nobody', 'www-data', 'and nginx can write it' );

foreach my $host (@hosts) {
    is( ( ask( $host, '/fetchcache-status', '--cacert', $chain ) )[0], '200', "it answers to $host, with a certificate naming it" );
}
is( ( ask( 'not-an-upstream.test', '/anything', '-k' ) )[0], '421', 'and fetches nothing for a host it was not given' );

# Plain http too, because cpanm asks CPAN over it.
my $plain = `curl -s -o /dev/null -w '%{http_code}' --max-time 30 --resolve '$hosts[0]:80:127.0.0.1' 'http://$hosts[0]/fetchcache-status' 2>/dev/null`;
is( $plain, '200', "and it answers to $hosts[0] over plain http" );

# One real fetch through the cache.  Only this tests the resolver, the TLS
# verification of upstream and the egress.  It fetches a CPAN index, which every
# CPAN install through the cache asks for.
SKIP: {
    skip 'www.cpan.org is not one of its upstreams', 2 unless grep { $_ eq 'www.cpan.org' } @hosts;

    my ( $code, $status ) = ask( 'www.cpan.org', '/modules/02packages.details.txt.gz', '--cacert', $chain );
    is( $code, '200', 'a CPAN index comes back through it' );
    like( $status, qr/\A(?:MISS|HIT|EXPIRED|REVALIDATED|STALE|UPDATING)\z/, "and says what the cache did about it ($status)" );
}

# A clone is two requests, and both must pass through uncached.  The first is
# the ref advertisement, and the second is a POST of the wants.
SKIP: {
    skip 'github.com is not one of its upstreams', 3 unless grep { $_ eq 'github.com' } @hosts;

    my $repo = '/Troglodyne-Internet-Widgets/trog-provisioner.git';
    my ( $code, $status ) = ask( 'github.com', "$repo/info/refs?service=git-upload-pack", '--cacert', $chain );
    is( $code, '200', 'the ref advertisement comes back through it' );
    is( $status, 'none', 'and is not cached, so a clone gets what is there now' );

    # The POST takes the other branch of the test on the request method.
    my $post = `curl -s -o /dev/null -w '%{http_code}' --max-time 60 --resolve 'github.com:443:127.0.0.1' --cacert '$chain' -X POST -H 'Content-Type: application/x-git-upload-pack-request' --data-binary '' 'https://github.com$repo/git-upload-pack' 2>/dev/null`;
    isnt( $post, '421', "a POST is passed upstream rather than refused ($post)" );
}

done_testing();
