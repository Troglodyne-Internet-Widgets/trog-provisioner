#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use JSON::PP ();

my $status = `systemctl is-active matrix-synapse 2>/dev/null`;
chomp $status;
is($status, 'active', 'matrix-synapse is running');
ok(-f '/etc/matrix-synapse/homeserver.yaml', 'homeserver.yaml is where synapse reads it');

# The name that other servers know this one by, and sign its keys under.
my $keys = `curl -s --max-time 10 http://127.0.0.1:8008/_matrix/key/v2/server`;
my $said = eval { JSON::PP::decode_json($keys)->{server_name} };
is($said, '[% server_name %]', 'synapse federates as server_name') or diag $keys;

# Each file that template_files generates, where the recipe puts it.
ok(-f '/etc/matrix-synapse/log.yaml', 'log.yaml is there too');

ok(-f '/etc/nginx/sites-enabled/admin.matrix.[% domain %].conf', 'the admin vhost was installed');

# And something behind it.  The admin interface comes from a GitHub release,
# and a download that fails leaves the vhost an empty directory.
ok(-s '[% install_dir %]/admin.matrix.[% domain %]/index.html',
    'the admin interface was downloaded and extracted');
# What nginx answers on this guest for $url, with the name of the URL resolved
# here.  -k, because a scratch guest has no certificate that a client trusts.
# @extra goes to curl before the URL.
sub fetch {
    my ( $url, @extra ) = @_;
    my ( $host, $port ) = $url =~ m{\Ahttps?://([^/:]+)(?::(\d+))?};
    $port //= $url =~ m/\Ahttps/ ? 443 : 80;
    my $body = `curl -sk --max-time 10 --resolve '$host:$port:127.0.0.1' @extra '$url' 2>/dev/null`;
    return $body;
}

# The domain and its aliases serve the page, through the vhost of nginxproxy.
my $index = fetch('https://[% domain %]/');
like($index, qr{href="https://element\.\Q[% server_name %]\E/"}, 'the domain serves the page, which links to Element') or diag $index;

# Element, from its release, and set to start at the homeserver.
ok(-s '[% install_dir %]/element.matrix.[% domain %]/index.html', 'Element was downloaded and extracted');
my $element = eval { JSON::PP::decode_json( fetch('https://element.matrix.[% domain %]/config.json') ) } // {};
is( ( ( $element->{default_server_config} // {} )->{'m.homeserver'} // {} )->{base_url}, 'https://[% server_name %]:[% federation_port %]', 'Element starts at the homeserver' );

# The vhost of the homeserver answers for server_name on 443, where the
# well-known documents are, and on the port of federation.
foreach my $port ( 443, [% federation_port %] ) {
    my $server = eval { JSON::PP::decode_json( fetch("https://[% server_name %]:$port/.well-known/matrix/server") ) } // {};
    is( $server->{'m.server'}, '[% server_name %]:[% federation_port %]', "on $port, /.well-known/matrix/server sends other servers to [% federation_port %]" );
    my $client = eval { JSON::PP::decode_json( fetch("https://[% server_name %]:$port/.well-known/matrix/client") ) } // {};
    is( ( $client->{'m.homeserver'} // {} )->{base_url}, 'https://[% server_name %]:[% federation_port %]', "and /.well-known/matrix/client sends clients there" );
    my $version = eval { JSON::PP::decode_json( fetch("https://[% server_name %]:$port/_matrix/federation/v1/version") ) } // {};
    is( ( $version->{server} // {} )->{name}, 'Synapse', "and synapse answers federation through nginx on $port" );
}

# Other servers reach federation from outside, so ufw lets it in.
my $ufw = `ufw status 2>&1`;
like( $ufw, qr/^matrix-homeserver\s+ALLOW/m, 'ufw lets federation in' ) or diag $ufw;

# synapse sends its notices to smtp_host, and the guest denies outgoing
# traffic that no profile names.
like( $ufw, qr/^matrix-smtp\s+ALLOW[ ]OUT/m, 'ufw lets synapse send mail to port [% smtp_port %]' ) or diag $ufw;
[% IF relayed %]

# Where the relay passes federation through, with the PROXY protocol, which
# curl sends.
my $relayed = eval { JSON::PP::decode_json( fetch( 'https://[% server_name %]:[% passthrough_port %]/_matrix/federation/v1/version', '--haproxy-protocol' ) ) } // {};
is( ( $relayed->{server} // {} )->{name}, 'Synapse', 'synapse answers federation on [% passthrough_port %], where the relay passes [% federation_port %] through' );

# The relay passes 443 to 8443, with the PROXY protocol, for each public name.
like( fetch( 'https://admin.[% server_name %]:8443/',   '--haproxy-protocol' ), qr/<html/i, 'the admin interface answers where the relay passes admin.[% server_name %]' );
like( fetch( 'https://element.[% server_name %]:8443/', '--haproxy-protocol' ), qr/<html/i, 'and Element where the relay passes element.[% server_name %]' );
[% ELSE %]

# Without a relay, the vhosts answer for the names under server_name themselves.
like( fetch('https://admin.[% server_name %]/'),   qr/<html/i, 'the admin interface answers for admin.[% server_name %]' );
like( fetch('https://element.[% server_name %]/'), qr/<html/i, 'and Element for element.[% server_name %]' );
[% END %]

# Some of the packages that the recipe asks for.  A package name that does not
# exist makes nothing fail.  It is only never installed.
foreach my $pkg (qw{matrix-synapse-py3 python3-pil python3-attr}) {
    # dpkg -s, not dpkg-query -f, because Perl interpolates a ${Status} format
    # string inside backticks before dpkg sees it.
    my $installed = `dpkg -s $pkg 2>/dev/null`;
    like($installed, qr/Status: install ok installed/, "$pkg is installed");
}

# synapse comes from the matrix.org repository, not from Ubuntu.
ok(-f '/etc/apt/sources.list.d/matrix-org.sources', 'the matrix.org repository is configured');
ok(-s '/etc/apt/keyrings/matrix-org.gpg', 'and its signing key is installed');

# The admin registration script, installed as a file and valid shell.
ok(-x '[% script_dir %]/matrix_register_admin.sh', 'the register-admin script is installed');
my $syntax = `bash -n [% script_dir %]/matrix_register_admin.sh 2>&1`;
is($syntax, '', 'and is a valid shell script') or diag $syntax;

# The postrun ran the script before these tests, and the script fails if it
# cannot register the admin.  So the account exists, with the admin flag set.
SKIP: {
    my $db = '[% install_dir %]/matrix.[% domain %]/homeserver.db';
    skip 'synapse has made no database', 1 unless -e $db;
    skip 'no sqlite3 to read it with', 1 unless system('command -v sqlite3 >/dev/null 2>&1') == 0;
    my $admin = `sqlite3 $db "SELECT admin FROM users WHERE name = '\@[% admin_user %]:[% server_name %]'" 2>&1`;
    chomp $admin;
    is($admin, 1, 'the admin user is registered as an admin') or diag $admin;
}

# The salvage of the last guest, put back where synapse reads it.  homeserver.db
# holds every room, message and account.
my $live     = '[% install_dir %]/matrix.[% domain %]';
my $salvaged = '[% install_dir %]/[% domain %]/matrix';

# Synapse makes the database on first start, which is a postrun task.  So a new
# guest has no database yet.  The loop below checks a salvaged one.
SKIP: {
    skip 'synapse has not been started yet, so it has made no database', 1 unless -e "$live/homeserver.db";
    ok(-s "$live/homeserver.db", 'the database is at the path homeserver.yaml names');
}
ok(-d "$live/media",         'and the media store is beside it');

# restore_state does not copy over a destination that already holds state.  An
# example is a live guest that is provisioned again, whose fetch can be partial.
# But the salvage must never stay in the domain directory with nothing at the
# live path.
foreach my $piece (qw{homeserver.db homeserver.signing.key}) {
    next unless -e "$salvaged/$piece";
    ok(-s "$live/$piece", "the salvaged $piece is on the guest, not stranded in the domain directory");
}

# Under /etc/matrix-synapse, not the domain directory.  guest_secrets in
# Provisioner::Recipe::matrix says why.
my $signing_key = '/etc/matrix-synapse/homeserver.signing.key';
my $reg_secret  = '/etc/matrix-synapse/registration.shared.secret';

ok(-s $signing_key, 'synapse has a signing key');
ok(-s $reg_secret,  'and the registration secret it shares with the admin script');

foreach my $secret ($signing_key, $reg_secret) {
    SKIP: {
        my @st = stat $secret;
        skip "there is no $secret to stat", 2 unless @st;

        is($st[2] & 07777, 0600, "$secret is kept to synapse");
        is(scalar getpwuid($st[4] // -1), 'matrix-synapse', "and owned by it");
    }
}

my $keyline = do { local (@ARGV, $/) = $signing_key; <> } // '';
like($keyline, qr/\Aed25519 \S+ \S+/, 'the key is the one the store handed over, in the format synapse reads');

# What other servers learn about the keys of this one.
my $published = eval { JSON::PP::decode_json($keys) } // {};
my ($version) = $keyline =~ m/\Aed25519 (\S+)/;
ok( exists( ( $published->{verify_keys} // {} )->{ 'ed25519:' . ( $version // '' ) } ), 'synapse signs with the key from the store' ) or diag $keys;
[% FOR id IN old_signing_keys.keys().sort() %]
is( ( ( $published->{old_verify_keys} // {} )->{'[% id %]'} // {} )->{key}, '[% old_signing_keys.$id.public %]', 'and publishes the old key [% id %] under old_verify_keys' ) or diag $keys;
[% END %]

# The check that the build ran before synapse started, now that synapse wrote
# events of its own.
my $check = `[% script_dir %]/matrix_check_signing_key $live/homeserver.db '[% server_name %]' $signing_key 2>&1`;
is( $? >> 8, 0, 'the key from the store signed the events of this homeserver' ) or diag $check;

# homeserver.yaml must name these paths, so that synapse uses the secrets from
# the store.
my $hs = do { local (@ARGV, $/) = '/etc/matrix-synapse/homeserver.yaml'; <> } // '';
like($hs, qr{^signing_key_path:\s*\Q$signing_key\E$}m, 'and homeserver.yaml reads it from there');
like($hs, qr{^registration_shared_secret_path:\s*\Q$reg_secret\E$}m, 'as it does the registration secret');
unlike($hs, qr/^registration_shared_secret:/m, 'with no copy of the secret written into the config itself');

# Neither secret is in the domain directory or the salvage.  So a rebuild gets
# its identity from the store, not from a backup.
foreach my $stray (qw{homeserver.signing.key registration.shared.secret}) {
    ok(!-e "$live/$stray", "no copy of $stray was left in the domain directory for a backup to pick up");
    ok(!-e "[% install_dir %]/[% domain %]/matrix/$stray", "nor in the salvage");
}

my $check = `nginx -t 2>&1`;
like($check, qr/test is successful/, 'nginx accepts every vhost we added') or diag $check;

done_testing();
