#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active auditd 2>/dev/null`;
chomp $status;
is($status, 'active', 'auditd is running');

my $file = '/etc/audit/rules.d/[% domain %].rules';
ok(-f $file, 'audit rules file exists');

my $text = do { local (@ARGV, $/) = $file; <> } // '';

# The key of the rule comes from the user of the recipe.  An empty user gives
# `-k -watch`, and auditctl does not accept a key that begins with a dash.
like($text, qr/-k\s+\S+-watch/, 'the rule has a key') or diag $text;
unlike($text, qr/-k\s+-/,       'and the key does not begin with a dash') or diag $text;

# Loaded, not only written.  augenrules loads the rules when the service starts,
# and it drops a rule that it cannot parse.  The rules file then audits nothing.
my $loaded = `auditctl -l 2>&1`;
like($loaded, qr{\Q[% install_dir %]/[% domain %]\E}, 'the domain rule is loaded')
    or diag $loaded;

done_testing();
