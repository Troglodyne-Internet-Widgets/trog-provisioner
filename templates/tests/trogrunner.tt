#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

[%# A runner needs a perl that can load this distribution, cpanm, Sys::Virt,
    and a configuration.  These assertions make sure that it has them.

    No apostrophes in an Xslate comment. -%]
my $user    = '[% user %]';
my $dir     = '[% install_dir %]/[% domain %]';
my $confdir = "$dir/etc/trog-provisioner";

# The newest perl under /opt/perl5.  scripts/cpan_install and everything else
# on a guest find the perl this way.
my ($bin) = reverse sort glob('/opt/perl5/*/bin');
ok( $bin && -d $bin, 'the perl recipe built a perl under /opt/perl5' )
    or BAIL_OUT( 'no perl was built: nothing under /opt/perl5' );
diag "the built perl is in $bin" if $bin;

# The version as a number.  Every module in the distribution declares
# `use 5.041`, and an older perl cannot load one even for a syntax check.
#
# \$] is escaped, or the perl that runs this test interpolates it.
chomp( my $version = `$bin/perl -e 'print \$]' 2>/dev/null` );
ok( $version && $version >= 5.041, "the runner perl is $version, which can load this distribution" )
    or diag 'Everything below needs a perl >= 5.041 and will fail without one';

# Each tool must run, not only exist, because a dangling symlink satisfies -e.
foreach my $tool (qw{cpanm perlcritic dzil prove}) {
    my $said = `$bin/$tool --version 2>&1`;
    ok( $? == 0 && length $said, "$bin/$tool runs" )
        or diag "$tool said: $said";
}

# dzil comes with the perl, because a distribution that needs it cannot
# install it for itself.
ok( -x "$bin/dzil", "$bin/dzil is there for the checkout dependencies" );

# Sys::Virt binds the API of the libvirt that it was built against.  A
# mismatch shows up later as a missing constant, with no clear cause.
# bin/preflight asks this of its own machine.  Here the guest is asked, while
# the problem can still be fixed.
chomp( my $libvirt = `pkg-config --modversion libvirt 2>/dev/null` );
chomp( my $sysvirt = `$bin/perl -MSys::Virt -e 'print Sys::Virt->VERSION' 2>&1` );
my ($want) = $libvirt =~ m/^(\d+\.\d+)/;
my ($have) = $sysvirt =~ m/^v?(\d+\.\d+)/;

# The name says what is asked, not what came back.  A Sys::Virt that does not
# load answers with a page of @INC, and a test name is one line.
is( $have, $want, "Sys::Virt matches the libvirt-dev this guest has ($libvirt)" )
    or diag "Sys::Virt said: $sysvirt";

# Two files that bin/preflight requires, and one thing it does not ask.  The
# address pool creates ips.db in this directory on first use.  If the runner
# cannot write here, it cannot assign an address.
ok( -r "$confdir/ipmap.cfg",    'ipmap.cfg is readable' );
ok( -r "$confdir/recipes.yaml", 'recipes.yaml is readable' );
is( readlink('/etc/trog-provisioner') // q{}, $confdir, '/etc/trog-provisioner points at it' );

# In /etc, not a dotfile under the domain directory.  That directory is a home
# only if the domain names a service user.
ok( -r '/etc/profile.d/trogrunner.sh', 'and a login shell is told the same thing' );
is( system( "runuser -u $user -- test -w '$confdir'" ), 0, "$user can write there, which is where ips.db goes" );
[% IF hypervisors.keys().size() %]
ok( -r "$confdir/hypervisors.conf", 'the fleet is configured' );
[% ELSE %]
ok( !-e "$confdir/hypervisors.conf", 'no fleet file, so the runner is its own hypervisor' );
[% END %]
[% IF store %]
ok( -r "$confdir/secrets.kdbx", 'the secret store is in place' );
[% END %]
[% IF checkout %]
my $checkout = "$dir/[% checkout_dir %]";
ok( -d "$checkout/.git", 'the checkout is there' );

# A syntax check is the cheapest test that fails when the perl is too old.
is( system("cd '$checkout' && $bin/perl -Ilib -c lib/Provisioner/Recipe.pm >/dev/null 2>&1"), 0,
    'the distribution modules compile under the runner perl' );

is( system("cd '$checkout' && $bin/prove -l t/Provisioner-Recipe.t >/dev/null 2>&1"), 0,
    'and its own tests run' );
[% ELSE %]
# A runner that manages its own repositories must not get a second copy of
# this one.
ok( !-e "$dir/trog-provisioner", 'no checkout was made, which is what was asked for' );
[% END %]
[% IF hypervisor_access != 'none' %]
my $key = "$dir/.ssh/id_ed25519";
ok( -f $key, 'the hypervisor key was placed' );
SKIP: {
    skip 'no key to check', 4 unless -f $key;
    my @stat = stat $key;
    is( sprintf( '%04o', $stat[2] & 07777 ), '0600', 'kept to itself, which ssh insists on' );
    chomp( my $owner = `stat -c '%U' '$key'` );
    is( $owner, $user, "owned by $user rather than by root" );
    is( system("ssh-keygen -y -f '$key' >/dev/null 2>&1"), 0, 'and ssh can read it' );

    # Where ssh looks.  Nothing in a libvirt qemu+ssh URI can point it
    # elsewhere.  The domain directory is the home of this user only if the
    # domain names a service user.
    chomp( my $keyhome = `getent passwd $user | cut -d: -f6` );
    ok( -e "$keyhome/.ssh/id_ed25519", "and reachable at $keyhome/.ssh/id_ed25519, which is where ssh will look" );
}
[% END %]

# Net::OpenSSH::More does not start if the ssh config mode is wider than this,
# and the runner does all remote work through it.  adminconfig ships one 0775.
chomp( my $home = `getent passwd $user | cut -d: -f6` );
SKIP: {
    skip 'no ssh config to check', 1 unless -e "$home/.ssh/config";
    my @stat = stat "$home/.ssh/config";
    is( sprintf( '%04o', $stat[2] & 07777 ), '0600', "$home/.ssh/config is narrow enough for Net::OpenSSH::More" );
}

# Reported, not asserted.  Most preflight checks are about the hypervisor,
# which is not this guest.  But the operator needs the list in the provision
# log.
diag "bin/preflight on this guest:";
[% IF checkout %]
# As the service user, not as root.  The key that a hypervisor trusts is in
# the ~/.ssh of that user, so root can only report that it cannot connect.
diag $_ for split( "\n", `runuser -u $user -- sh -c "cd '$dir/[% checkout_dir %]' && $bin/perl -Ilib bin/preflight" 2>&1` );
[% ELSE %]
diag 'skipped: no checkout here to run it from';
[% END %]

done_testing;
