#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

[%# Every assertion here is one of the things koan measured as absent when it
    was asked to work on this repository and could not: no perl new enough to
    load a single module, no cpanm, no Sys::Virt, no configuration.

    No apostrophes in an Xslate comment. -%]
my $user    = '[% user %]';
my $dir     = '[% install_dir %]/[% domain %]';
my $confdir = "$dir/etc/trog-provisioner";

# The perl the perl recipe built, found the way the fragment finds it: through
# the cpanm link build_latest_perl.sh puts in /root/bin, which is the only path
# here that does not depend on the domain naming a service user.  The home
# directory of an admin user is /home/<them> and not the domain directory, and
# assuming otherwise is what perl.tt already had to be fixed for.
chomp( my $bin = `dirname \$(readlink -f /root/bin/cpanm) 2>/dev/null` );
ok( $bin && $bin ne '.' && -d $bin, "the built perl is in $bin" )
    or BAIL_OUT('no perl was built, or /root/bin/cpanm does not point at one');

# The version, as a number, because that is the thing that was wrong: every
# module in the distribution declares `use 5.041`, and a 5.38 toolchain cannot
# load one of them to run so much as a syntax check.
#
# \$] escaped: unescaped, it is interpolated by the perl running this test
# rather than by the one being asked about.
chomp( my $version = `$bin/perl -e 'print \$]' 2>/dev/null` );
ok( $version && $version >= 5.041, "the runner perl is $version, which can load this distribution" )
    or diag 'Everything below needs a perl >= 5.041 and will fail without one';

# Running, not merely present.  A dangling symlink satisfies -e, and dzil and
# yath were both shipped as exactly that on every guest with the perl recipe.
foreach my $tool (qw{cpanm perlcritic dzil prove}) {
    my $said = `$bin/$tool --version 2>&1`;
    ok( $? == 0 && length $said, "$bin/$tool runs" )
        or diag "$tool said: $said";
}

# And the link the fragment makes once dzil exists, since /root/bin is where
# anything else deferred on this guest will look for it.
ok( -x '/root/bin/dzil', '/root/bin/dzil is there for anything queued after it' );

# Sys::Virt binds the API of the libvirt it was built against and does not say
# so when it is wrong -- it shows up later as a missing constant, blamed on
# whatever was being done at the time.  bin/preflight asks this of the machine
# it runs on; here it is asked of the guest, where it can still be fixed.
chomp( my $libvirt = `pkg-config --modversion libvirt 2>/dev/null` );
chomp( my $sysvirt = `$bin/perl -MSys::Virt -e 'print Sys::Virt->VERSION' 2>&1` );
my ($want) = $libvirt =~ m/^(\d+\.\d+)/;
my ($have) = $sysvirt =~ m/^v?(\d+\.\d+)/;
is( $have, $want, "Sys::Virt $sysvirt matches the libvirt-dev this guest has ($libvirt)" );

# The two files bin/preflight insists on, plus the question it does not ask:
# the address pool creates ips.db in this directory on first use, so a
# directory the runner cannot write is a runner that cannot assign an address.
ok( -r "$confdir/ipmap.cfg",    'ipmap.cfg is readable' );
ok( -r "$confdir/recipes.yaml", 'recipes.yaml is readable' );
is( readlink('/etc/trog-provisioner') // q{}, $confdir, '/etc/trog-provisioner points at it' );

# In /etc rather than a dotfile under the domain directory, which is only a
# home when the domain names a service user.
ok( -r '/etc/profile.d/trogrunner.sh', 'and a login shell is told the same thing' );
is( system( "runuser -u $user -- test -w '$confdir'" ), 0, "$user can write there, which is where ips.db goes" );
[% IF hypervisors.keys().size() %]
ok( -r "$confdir/hypervisors.conf", 'the fleet is configured' );
[% ELSE %]
ok( !-e "$confdir/hypervisors.conf", 'no fleet file, so the runner is its own hypervisor' );
[% END %]
[% IF store %]
ok( -r "$confdir/secrets.kdbx", 'the secret store is in place' );
[% END %]
[% IF checkout %]
my $checkout = "$dir/[% checkout_dir %]";
ok( -d "$checkout/.git", 'the checkout is there' );

# The sentence from every one of those six pull requests, turned into an
# assertion.  A syntax check is the cheapest thing that fails when the perl is
# too old, and the first thing that stops failing when it is not.
is( system("cd '$checkout' && $bin/perl -Ilib -c lib/Provisioner/Recipe.pm >/dev/null 2>&1"), 0,
    'the distribution modules compile under the runner perl' );

is( system("cd '$checkout' && $bin/prove -l t/Provisioner-Recipe.t >/dev/null 2>&1"), 0,
    'and its own tests run' );
[% ELSE %]
# The negative assertion the no-checkout case actually needs: a runner that
# manages its own repositories should not find a second copy of this one.
ok( !-e "$dir/trog-provisioner", 'no checkout was made, which is what was asked for' );
[% END %]
[% IF hypervisor_access != 'none' %]
my $key = "$dir/.ssh/id_ed25519";
ok( -f $key, 'the hypervisor key was placed' );
SKIP: {
    skip 'no key to check', 4 unless -f $key;
    my @stat = stat $key;
    is( sprintf( '%04o', $stat[2] & 07777 ), '0600', 'kept to itself, which ssh insists on' );
    chomp( my $owner = `stat -c '%U' '$key'` );
    is( $owner, $user, "owned by $user rather than by root" );
    is( system("ssh-keygen -y -f '$key' >/dev/null 2>&1"), 0, 'and ssh can read it' );

    # Where ssh actually looks.  Nothing on a libvirt qemu+ssh URI can point it
    # anywhere else, and the domain directory is this user home only when the
    # domain names a service user.
    chomp( my $home = `getent passwd $user | cut -d: -f6` );
    ok( -e "$home/.ssh/id_ed25519", "and reachable at $home/.ssh/id_ed25519, which is where ssh will look" );
}
[% END %]

# Reported rather than asserted.  Most of what preflight checks is about the
# hypervisor, and failing this guest over the state of somebody else machine
# would be wrong -- but the list an operator still has to work through belongs
# in the provision log rather than nowhere.
diag "bin/preflight on this guest:";
[% IF checkout %]
diag $_ for split( "\n", `cd '$dir/[% checkout_dir %]' && $bin/perl -Ilib bin/preflight 2>&1` );
[% ELSE %]
diag 'skipped: no checkout here to run it from';
[% END %]

done_testing;
