#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $home = '[% install_dir %]/[% domain %]';

foreach my $unit ('clod-[% domain %]', 'clod-worker-[% domain %]') {
    my $status = `systemctl is-active '$unit' 2>/dev/null`;
    chomp $status;
    is($status, 'active', "$unit is running") or diag `journalctl -u '$unit' -n 30 --no-pager 2>&1`;

    # Ask the process, not the unit file, which systemd may not have loaded.
    my $pid = `systemctl show -p MainPID --value '$unit' 2>/dev/null`;
    chomp $pid;
    my @st = stat "/proc/$pid";
    is(scalar getpwuid($st[4] // -1), '[% user %]', "and runs as [% user %]");
}

# nginx proxies to this socket.  If the service runs without it, every request
# gets a 502.
my $sock = "$home/run/clod.sock";
ok(-S $sock, 'the socket of the health page is there') or diag "no socket at $sock";

# The page is behind basic authentication, so a request without it is a 401
# from the application itself, and not a 502 from nginx.
my $code = `curl -s -o /dev/null -w '%{http_code}' --unix-socket '$sock' http://localhost/ 2>&1`;
is($code, '401', 'the application answers on it, and asks who is there');

my $vhost = do { local (@ARGV, $/) = '/etc/nginx/sites-enabled/[% domain %].conf'; <> } // '';
like($vhost, qr{\Qserver unix:$sock\E}, 'and nginx has an upstream for it') or diag $vhost;

# The request above is root at the socket.  This one goes through nginx, which
# runs as www-data and must pass through the domain directory to the socket.
my $proxied = `curl -sk -o /dev/null -w '%{http_code}' --resolve '[% domain %]:443:127.0.0.1' 'https://[% domain %]/' 2>&1`;
is($proxied, '401', 'and nginx reaches it, so a request to the page gets the 401 and not a 502');

# The service user reads its secrets and cannot change them.
foreach my $file ("$home/clod.conf", "$home/clod.env") {
    my @st = stat $file;
    is(scalar getpwuid($st[4] // -1), 'root',       "$file is owned by root");
    is(scalar getgrgid($st[5] // -1), '[% user %]', "and group [% user %]");
    is(($st[2] // 0) & 07777, 0640,                 "and mode 0640");
}

# The configuration is perl, and App::Clod refuses one that it cannot use.
my $checked = `cd '$home/App-Clod' && /opt/perl5/current/bin/perl -Ilib -MApp::Clod::Config -e 'my \$c = do \$ARGV[0] or die \$@ || \$!; App::Clod::Config::validate(\$c); print "ok\\n"' '$home/clod.conf' 2>&1`;
is($checked, "ok\n", 'App::Clod accepts the configuration') or diag $checked;

# The bot runs claude and git as [% user %], with HOME the directory of the domain.
ok(qx{which claude}, 'claude is on the PATH');
ok(-d "$home/clod-state" && (stat _)[4] == (getpwnam('[% user %]'))[2], 'the database directory belongs to [% user %]');

[% IF agent_user %]
# claude runs as [% agent_user %].  See THE AGENT ACCOUNT in
# Provisioner::Recipe::clod.  Each check runs as the account that it is about.
{
    my $agent = '[% agent_user %]';
    my $pid   = `systemctl show -p MainPID --value 'clod-worker-[% domain %]' 2>/dev/null`;
    chomp $pid;

    my ($groups) = (do { local (@ARGV, $/) = "/proc/$pid/status"; <> } // '') =~ m/^Groups:\s*([^\n]*)/m;
    my $gid = (getgrnam $agent)[2] // -1;
    ok((grep { $_ == $gid } split ' ', $groups // ''), "the worker is in the group of $agent") or diag "groups: ", $groups // 'none';

    foreach my $secret ("$home/clod.env", "$home/clod.conf", "$home/clod-state/minion.db", "/proc/$pid/environ") {
        system('runuser', '-u', $agent, '--', 'cat', $secret);
        isnt($? >> 8, 0, "$agent cannot read $secret");
    }

    # Runs a command as the worker, or through sudo as the agent the way that
    # App::Clod starts claude, with the umask of the worker and a and b on its
    # input.  A list all the way down, so that nothing is quoted twice.
    my $as = sub {
        my ($who, @command) = @_;
        my @sudo = $who eq 'agent' ? (qw{sudo -n -H -u}, $agent, '--preserve-env=CLOD_TEST_PASSED', '--') : ();
        open(my $fh, '-|', 'runuser', '-u', '[% user %]', '--', 'sh', '-c', q{umask 0007; printf 'a\nb\n' | "$@" 2>&1}, 'sh', @sudo, @command)
            or return (-1, "runuser: $!");
        my $out = do { local $/; <$fh> } // '';
        close $fh;
        return ($? >> 8, $out);
    };

    # The input comes back byte for byte, so a pty, which writes CRLF, shows.
    local $ENV{CLOD_TEST_PASSED} = 'passed';
    my (undef, $said) = $as->('agent', '/usr/bin/env', 'PATH=/bogus/first:/usr/bin:/bin', 'sh', '-c', q{id -un; echo "$HOME"; echo "$CLOD_TEST_PASSED"; echo "$PATH"; umask; cat});
    is($said, "$agent\n[% agent_home %]\npassed\n/bogus/first:/usr/bin:/bin\n0007\na\nb\n",
        'the agent runs in its home, with what --preserve-env names, the PATH that it is given, the umask 0007 and a clean pipe');

    # A repository that the worker makes in the workspace, a commit and new
    # files of the agent in it, and the worker reads it and removes it.
    my $repo = "$home/workspace/.clod-guest-test";
    system('rm', '-rf', $repo);
    my @made = $as->('worker', 'sh', '-c', "git init -q --shared=group -b main $repo && git -C $repo -c user.name=w -c user.email=w\@test.test commit -q --allow-empty -m one");
    is($made[0], 0, 'the worker makes a repository in the workspace') or diag $made[1];
    my @committed = $as->('agent', 'sh', '-c', "mkdir $repo/made && touch $repo/made/file && git -C $repo -c user.name=a -c user.email=a\@test.test commit -q --allow-empty -m two");
    is($committed[0], 0, 'the agent commits in it, and makes files there') or diag $committed[1];
    my @log = $as->('worker', 'git', '-C', $repo, 'log', '--format=%s');
    is($log[1], "two\none\n", 'the worker reads the commit of the agent') or diag $log[1];
    my @removed = $as->('worker', 'rm', '-r', $repo);
    is($removed[0], 0, 'and removes what the agent made') or diag $removed[1];
    system('rm', '-rf', $repo);

    # The Claude token is the agent alone, as a file, because sudo logs what
    # it passes in the environment.  Its value is never printed.
    my $token = '[% agent_home %]/.claude-token';
    my @st    = stat $token;
    is(sprintf('%s %04o', scalar getpwuid($st[4] // -1) // '', ($st[2] // 0) & 07777), "$agent 0400", 'the token of the agent is its own, mode 0400');
    system('runuser', '-u', '[% user %]', '--', 'test', '-r', $token);
    isnt($? >> 8, 0, 'and the worker cannot read it');
    unlike(do { local (@ARGV, $/) = "$home/clod.env"; <> } // '', qr/CLAUDE_CODE_OAUTH_TOKEN/, 'and clod.env holds no Claude token');
    ok(!-e "$home/clod-agent.token", 'and the copy that waited for the postrun is gone');
    my @version = $as->('agent', '/usr/bin/env', "PATH=$ENV{PATH}", "$home/clod-claude.sh", '--version');
    like($version[1], qr/Claude[ ]Code/, 'the agent runs claude through clod-claude.sh') or diag $version[1];
}
[% END %]

[% IF user != admin_user -%]
# servicesudo lets the service user restart its own units, and nothing else.
foreach my $unit (qw{clod-[% domain %].service clod-worker-[% domain %].service}) {
    system('runuser', '-u', '[% user %]', '--', 'sudo', '-n', '-l', '/usr/bin/systemctl', 'restart', $unit);
    is($? >> 8, 0, "[% user %] may restart $unit with sudo");
}
[% END -%]

# The installer of the system packages, as the bot runs it.  THE SYSTEM
# PACKAGES in Provisioner::Recipe::clod.
{
    my $installer = '[% installer %]';
    my @st        = stat $installer;
    is(sprintf('%s %04o', scalar getpwuid($st[4] // -1) // '', ($st[2] // 0) & 07777), 'root 0755', "$installer is root's, mode 0755");

    # Runs the installer as the service user, through sudo, with stderr in the
    # output.  A list all the way down, so that a name with a space stays one
    # argument.
    my $install = sub {
        my @names = @_;
        open(my $fh, '-|', 'runuser', '-u', '[% user %]', '--', 'sh', '-c', 'exec "$@" 2>&1', 'sh', 'sudo', '-n', $installer, @names)
            or return (-1, "runuser: $!");
        my $out = do { local $/; <$fh> } // '';
        close $fh;
        return ($? >> 8, $out);
    };

    system('runuser', '-u', '[% user %]', '--', 'sudo', '-n', '-l', $installer, 'sqlite3');
    is($? >> 8, 0, "[% user %] may run $installer with sudo, with arguments");

    # apt-get always prints something, so output that is all the installer's
    # own lines means that the packager never ran.
    foreach my $bad ('sqlite3-', '-y', 'sqlite3 git') {
        my ($exit, $said) = $install->('git', $bad);
        is($exit, 2, "it refuses '$bad', and the whole call with it") or diag $said;
        unlike($said, qr/^(?!clod-install-packages: )/m, 'without running the packager') or diag $said;
    }

    # sqlite3 is a dep of this recipe, so it is installed already.
    my ($exit, $said) = $install->('sqlite3');
    is($exit, 0, 'it accepts a package that is installed already') or diag $said;
    like($said, qr/sqlite3/, 'and prints what the packager printed') or diag $said;
}

# The local lib holds a copy of what the bot needs, which the service user
# owns, so that it can upgrade it.  THE LOCAL LIB in Provisioner::Recipe::clod.
{
    my $copy = '[% local_lib %]/lib/perl5/Mojolicious.pm';
    ok(-e $copy, 'the local lib has its own Mojolicious');
    is(scalar getpwuid((stat $copy)[4] // -1), '[% user %]', 'which belongs to [% user %]');
}

# App::Clod lets a run use these programs, so each one must run, as the
# service user, on the PATH of the units.  nytprofhtml and nytprofmerge have
# no --version, so for them the module that they load must load.
my $path = '[% local_lib %]/bin:/opt/perl5/current/bin:/usr/local/bin:/usr/bin:/bin';
my %runs = (
    perlcritic   => 'perlcritic --version',
    perltidy     => 'perltidy --version',
    make         => 'make --version',
    nytprofhtml  => 'command -v nytprofhtml && perl -MDevel::NYTProf::Data -e 1',
    nytprofmerge => 'command -v nytprofmerge && perl -MDevel::NYTProf::Data -e 1',
);
foreach my $program (sort keys %runs) {
    my $said = qx{runuser -u '[% user %]' -- env PATH='$path' sh -c '$runs{$program}' 2>&1};
    is($? >> 8, 0, "[% user %] runs $program") or diag $said;
}

# The agent lib: the agent loads its policies from it, and cannot change them.
# THE AGENT LIB in Provisioner::Recipe::clod.
{
    my $lib   = '[% agent_lib %]';
    my $agent = '[% agent_user || admin_user %]';
    my @st    = stat $lib;
    is(sprintf('%04o', ($st[2] // 0) & 07777), '2750', 'the agent lib has mode 2750');
    is(scalar getpwuid($st[4] // -1), '[% user %]', 'and belongs to [% user %]');
    is(scalar getgrgid($st[5] // -1), $agent, "with the group $agent");
[% IF agent_user -%]
    my $env = "env PERL5LIB=$lib/lib/perl5 PATH=$lib/bin:/usr/bin:/bin";
    my $said = qx{runuser -u '[% agent_user %]' -- $env perl -MPerl::Critic::Policy::Variables::RequireNoAutovivification -e 1 2>&1};
    is($? >> 8, 0, '[% agent_user %] loads a policy of the standards from it') or diag $said;
    system('runuser', '-u', '[% agent_user %]', '--', 'test', '-w', "$lib/lib/perl5");
    isnt($? >> 8, 0, 'and cannot change it');
[% END -%]
}

done_testing();
