#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# Configd must be installed for the system perl.  It runs from an
# ExecStartPre.  Under the perl in /opt/perl5, every service that it wraps
# fails to start with "Can't locate Configd.pm".
ok(-x '/usr/bin/configd', 'configd is at the path the generated drop-ins name');

my $shebang = q{};
if (open(my $fh, '<', '/usr/bin/configd')) {
    $shebang = <$fh> // q{};
    close $fh;
}
like($shebang, qr{^\#!/usr/bin/perl\b}, 'and it runs under the system perl') or diag $shebang;

my $version = `/usr/bin/perl -e 'require Configd; print Configd->VERSION' 2>&1`;
like($version, qr/\A\d/, 'Configd is installed for the system perl') or diag $version;

my $known = `/usr/bin/configd languages 2>&1`;

[% FOR language IN languages %]
subtest '[% language %]' => sub {
    like($known, qr/^[% language %]$/m, 'configd knows this language') or diag $known;

    # status exits non-zero when the service is not wrapped.  Then nothing reads
    # the fragments.
    my $status = `/usr/bin/configd status [% language %] 2>&1`;
    is($? >> 8, 0, 'its service is wrapped') or diag $status;
    unlike($status, qr/NOT adopted/, 'every file it manages is adopted') or diag $status;

    my @files = $status =~ m/^\s\s(\/\S+)\s/gm;
    ok(scalar @files, 'and it says which files those are') or diag $status;

    foreach my $file (@files) {
        ok(-f $file, "$file is there");
        my $head = do { local (@ARGV, $/) = $file; <> } // q{};
        like($head, qr/Generated by configd/, "$file is generated rather than edited in place");
        ok(-f "$file.d/00-original", "$file.d/00-original keeps what the guest arrived with");
    }
};
[% END %]

done_testing();
