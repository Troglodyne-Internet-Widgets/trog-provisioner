#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use IO::Socket::INET;
use IO::Select;
use MIME::Base64 ();
use IPC::Open2 ();

my $client = '[% script_dir %]/edge_client';
my $domain = 'edge-selftest.test.test';
# Long, because nginx refuses a map with a name longer than its bucket.
my $name = 'selftest-' . ( 'x' x 50 ) . '.edge.test.test';

my $check = `nginx -t 2>&1`;
like( $check, qr/test is successful/, 'nginx accepts the configuration' ) or diag $check;

# A listener that stands in for a guest, and the first lines that a connection
# to it sends, or nothing when none comes within ten seconds.
sub listener {
    my $listener = IO::Socket::INET->new( Listen => 1, LocalAddr => '127.0.0.1', LocalPort => 0, ReuseAddr => 1 );
    die "Cannot listen: $!\n" unless $listener;
    return $listener;
}

sub first_lines {
    my ($listener) = @_;
    return q{} unless IO::Select->new($listener)->can_read(10);
    my $conn = $listener->accept() or return q{};
    my $said = q{};
    while ( IO::Select->new($conn)->can_read(2) ) {
        my $got = sysread( $conn, my $buf, 4096 ) or last;
        $said .= $buf;
        last if $said =~ m/\r\n\r\n/ || $said =~ m/\APROXY [^\n]*\n/;
    }
    return $said;
}

# The status that curl gets for $name on $port of this guest, or 000 for none.
# The stream proxy is on [% tls_port %], because ufw forwards only a
# connection from outside from 443.
sub status {
    my ( $name, $port ) = @_;
    my $scheme = $port == [% tls_port %] ? 'https' : 'http';
    return `curl -sk --max-time 5 -o /dev/null -w '%{http_code}' --resolve '$name:$port:127.0.0.1' '$scheme://$name:$port/' 2>/dev/null` || '000';
}

# Each command of an SMTP session with the relay over STARTTLS, and the reply of
# the relay to it.
sub smtp_session {
    my (@commands) = @_;
    my $pid = IPC::Open2::open2( my $out, my $in, qw{openssl s_client -quiet -crlf -starttls smtp -connect [% relay_address %]:[% relay_port %]} );
    my @replies;
    foreach my $command (@commands) {
        print {$in} "$command\n";
        $in->flush;
        my $reply = q{};
        while ( IO::Select->new($out)->can_read(10) ) {
            my $got = sysread( $out, my $buf, 4096 ) or last;
            $reply .= $buf;
            last if $reply =~ m/^\d{3} [^\n]*\n\z/m;
        }
        push @replies, $reply;
    }
    close $in;
    waitpid( $pid, 0 );
    return \@replies;
}

# A reload starts new workers, which take a moment to answer.
sub settle { sleep 2; return }

my ( $tls, $http ) = ( listener(), listener() );
my $key = `$client register $domain 127.0.0.1:@{[ $tls->sockport ]} 127.0.0.1:@{[ $http->sockport ]} $name 2>&1`;
is( $?, 0, 'a guest registers a name' ) or diag $key;
like( $key, qr/\A[A-Za-z0-9+\/=]+\z/, 'and gets its key in base64 on one line' );
settle();

subtest 'a TLS connection goes by its SNI name, with the PROXY protocol' => sub {
    system("curl -sk --max-time 5 --resolve '$name:[% tls_port %]:127.0.0.1' 'https://$name:[% tls_port %]/' >/dev/null 2>&1 &");
    like( first_lines($tls), qr/\APROXY TCP4 127[.]0[.]0[.]1 /, 'the guest learns the address of the client' );
};

subtest 'a plain request goes by its Host header, with X-Forwarded-For' => sub {
    system("curl -s --max-time 5 --resolve '$name:80:127.0.0.1' 'http://$name/' -H 'X-Forwarded-For: 203.0.113.7' >/dev/null 2>&1 &");
    my $said = first_lines($http);
    like( $said, qr/^Host: \Q$name\E\r$/m,                'the guest gets the name' );
    like( $said, qr/^X-Forwarded-For: 127[.]0[.]0[.]1\r$/m, 'and the address that connected, not one that the client claims' );
};

is( status( 'nosuch.test.test', [% tls_port %] ), '000', 'a name that nobody registered gets no TLS handshake' );
is( status( 'nosuch.test.test', 80 ),  '000', 'and no reply on 80' );

my $other = `$client register other-$domain 127.0.0.1:1 127.0.0.1:2 $name 2>&1`;
isnt( $?, 0, 'another domain cannot register the same name' );
like( $other, qr/\Q$name is registered to $domain\E/, 'and the refusal names the domain that holds it' );

# The key that the edge issued, as the guest of $domain holds it.  The test
# registered 127.0.0.1 as the address of that guest, so the key works from here.
my $keyfile = "/root/.edge-selftest.key";
{
    open( my $fh, '>', $keyfile ) or die "Cannot write $keyfile: $!\n";
    chmod 0600, $keyfile;
    print {$fh} MIME::Base64::decode_base64($key);
    close $fh or die "Cannot write $keyfile: $!\n";
}
sub as_guest {
    my ($request) = @_;
    my $said = `ssh -n -i $keyfile -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root\@127.0.0.1 '$request' 2>&1`;
    return ( $? >> 8, $said );
}
sub banned { return system("ipset test edge-bans '$_[0]' >/dev/null 2>&1") == 0 }

# An address from the documentation ranges, which no client has.
my $abuser = '192.0.2.77';

subtest 'the key of a guest sends bans, and nothing else' => sub {
    my ( $rc, $said ) = as_guest("ban $abuser 600");
    is( $rc, 0, 'a guest bans an address' ) or diag $said;
    ok( banned($abuser), 'and the address is in the set' );

    my $rules = `iptables -S trog-edge-bans 2>&1`;
    like( $rules, qr/--dports 80,[% tls_port %] .*--match-set edge-bans src -j DROP/, 'whose members are dropped on the ports that the edge proxies' ) or diag $rules;

    system('ufw reload >/dev/null 2>&1');
    my @jumps = `iptables -S INPUT` =~ m/^-A INPUT -j trog-edge-bans$/mg;
    is( scalar @jumps, 1, 'INPUT enters the chain once after a reload' );
    ok( banned($abuser), 'and the ban is still there' );

    ( $rc, $said ) = as_guest("check $abuser");
    is( $rc, 0, 'a guest can ask whether an address is banned' ) or diag $said;

    ( $rc, $said ) = as_guest('id');
    is( $rc, 2, 'and the key runs nothing but edge_ban' ) or diag $said;

    ( $rc, $said ) = as_guest("unban $abuser");
    is( $rc, 0, 'a guest unbans an address' ) or diag $said;
    ok( !banned($abuser), 'and the address leaves the set' );
};

my $host = `ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key 2>&1`;
my $pub  = do { local ( @ARGV, $/ ) = '/etc/ssh/ssh_host_ed25519_key.pub'; <> } // '';
is( ( split ' ', $pub )[1], ( split ' ', $host )[1], 'the host key that the guests pin is the one that sshd has' );

# Port 25 takes mail from the internet, so it checks the client as a mail guest
# does, from the same template.
my $clients = `postconf -h smtpd_client_restrictions 2>&1`;
like( $clients, qr/\breject_unknown_reverse_client_hostname\b.*\breject_rbl_client\b/, 'port 25 checks the reverse DNS of a client and the RBLs' ) or diag $clients;

# The SPF policy service, asked as postfix asks it on 25.  It refuses a sender
# that fails SPF, and adds nothing to any other message.
sub spf_policy {
    my ( $ip, $sender ) = @_;
    my $request = join( q{}, map { "$_\n" } 'request=smtpd_access_policy', 'protocol_state=RCPT', 'protocol_name=ESMTP', "client_address=$ip", 'client_name=unknown', 'helo_name=client.nosuch.test.test', "sender=$sender", 'recipient=postmaster@[% domain %]', 'instance=spf.selftest' ) . "\n";
    my $pid = IPC::Open2::open2( my $out, my $in, '/usr/bin/policyd-spf' );
    print {$in} $request;
    close $in;
    my $answer = do { local $/; <$out> } // q{};
    waitpid( $pid, 0 );
    return $answer;
}
my $none = spf_policy( '203.0.113.9', 'someone@nosuch.test.test' );
unlike( $none, qr/^action=(?:prepend|5)/mi, 'a sender with no SPF record passes the SPF policy service, which adds no header' ) or diag $none;
SKIP: {
    my $spf = `dig +short TXT [% domain %] 2>/dev/null`;
    skip( 'the SPF record of [% domain %] does not end in -all', 1 ) unless $spf =~ m/v=spf1[^"]*-all/;
    my $fail = spf_policy( '203.0.113.9', 'someone@[% domain %]' );
    like( $fail, qr/^action=5\d\d /mi, 'and a sender that fails SPF is refused' ) or diag $fail;
}

# The milters of 25.  opendkim removes a verdict under the name of this guest
# that a client wrote, and opendmarc writes the real one, from the client that
# connected, which the guests behind the edge trust.
[% INCLUDE "files/milter_probe.t.tt" %]
my %probe   = ( ip => '203.0.113.9', from => 'someone@nosuch.test.test' );
my $removed = milter_probe( %probe, socket => '/var/spool/postfix/opendkim/opendkim.sock', ar => '[% domain %]; spf=pass smtp.mailfrom=nosuch.test.test' );
like( $removed, qr/^delete_header \d+ Authentication-Results$/m, 'a verdict under the name of this guest that a client wrote is removed' ) or diag $removed;
my $kept = milter_probe( %probe, socket => '/var/spool/postfix/opendkim/opendkim.sock', ar => 'elsewhere.test.test; spf=pass smtp.mailfrom=nosuch.test.test' );
unlike( $kept, qr/^delete_header \d+ Authentication-Results$/m, 'and one under another name is kept, which nobody trusts' ) or diag $kept;
my $written = milter_probe( %probe, socket => '/var/spool/postfix/opendmarc/opendmarc.sock' );
like( $written, qr/^(?:add|insert)_header (?:\d+ )?Authentication-Results: \Q[% domain %]\E; spf=/m, 'opendmarc writes its SPF verdict under the name of this guest' ) or diag $written;

# postfix.service is a wrapper that stays active when the instance does not
# start, so ask the instance, and ask postfix what it makes of main.cf.
is( system('systemctl is-active --quiet postfix@-'), 0, 'the postfix instance runs, not only its wrapper' );
my $postfix_check = `postfix check 2>&1`;
unlike( $postfix_check, qr/^(?:postfix: )?(?:fatal|error):/mi, 'postfix accepts its configuration' ) or diag $postfix_check;

subtest 'a guest sends its mail through the relay, as its own domain only' => sub {
    my $password = `$client register-mail $domain 192.0.2.10 2>&1`;
    is( $?, 0, 'a guest registers for mail' ) or diag $password;
    chomp $password;
    like( $password, qr/\A[0-9a-f]{48}\z/, 'and gets its password on one line' );

    my $auth = `doveadm auth test '$domain' '$password' 2>&1`;
    like( $auth, qr/auth succeeded/, 'dovecot takes the login' ) or diag $auth;
    $auth = `doveadm auth test '$domain' wrong 2>&1`;
    unlike( $auth, qr/auth succeeded/, 'and not with another password' );
    $auth = `doveadm auth test root '$password' 2>&1`;
    unlike( $auth, qr/auth succeeded/, 'and knows no account of this guest' );

    my $listen = `ss -Hlnt 'sport = :[% relay_port %]' 2>&1`;
    like( $listen, qr/\Q[% relay_address %]:[% relay_port %]\E/, 'the relay listens where the guests reach this guest' ) or diag $listen;
    unlike( $listen, qr/(?:0[.]0[.]0[.]0|\*):[% relay_port %]/, 'and not on every address' );

    my $smtp = smtp_session(
        "EHLO selftest.test.test",
        'AUTH PLAIN ' . MIME::Base64::encode_base64( "\0$domain\0$password", q{} ),
        "MAIL FROM:<someone\@$domain>",
        'RCPT TO:<relay-selftest@[% domain %]>',
        'RSET',
        'MAIL FROM:<someone@other.test.test>',
        'RCPT TO:<relay-selftest@[% domain %]>',
        'QUIT',
    );
    like( $smtp->[1], qr/^235 /m, 'the relay takes the login over TLS' ) or diag explain $smtp;
    like( $smtp->[3], qr/^250 /m, 'and a sender in its domain' )          or diag explain $smtp;
    like( $smtp->[6], qr/^553 /m, 'and refuses a sender in another domain' ) or diag explain $smtp;

    # What postfix finds in the tables, for mail in.
    my $lookup = sub { my ( $key, $table ) = @_; my $r = `postmap -q '$key' texthash:/etc/nginx/edge.d/mail.$table 2>&1`; chomp $r; $r };
    is( $lookup->( $domain, 'transport' ), 'smtp:[192.0.2.10]:25', 'mail for the domain from the internet goes to its guest, on 25' );
    # postmap looks up the key as given, and postfix tries @domain for every
    # address in the domain that has no entry of its own.
    is( $lookup->( "\@$domain", 'recipients' ), 'OK', 'for any recipient in the domain' );
    is( $lookup->( 'other.test.test', 'relay_domains' ), q{}, 'and the edge takes no mail for a domain that did not register' );

    my $released = `$client release-mail $domain 2>&1`;
    is( $?, 0, 'a guest releases its login' ) or diag $released;
    is( $lookup->( $domain, 'transport' ), q{}, 'and its route in' );
    $auth = `doveadm auth test '$domain' '$password' 2>&1`;
    unlike( $auth, qr/auth succeeded/, 'and dovecot takes it no more' );
};

my $released = `$client release $domain 2>&1`;
is( $?, 0, 'a guest releases its names' ) or diag $released;
settle();
is( status( $name, 80 ), '000', 'and the name gets no reply after that' );
ok( !-e "/etc/nginx/edge.d/$domain.ban.pub", 'and its key is gone' );
my ( $rc, $said ) = as_guest("check $abuser");
is( $rc, 255, 'and the key logs in no more' ) or diag $said;
unlink $keyfile;

done_testing();
