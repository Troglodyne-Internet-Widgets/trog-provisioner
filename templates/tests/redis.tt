#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active redis-server 2>/dev/null`;
chomp $status;
is($status, 'active', 'redis-server is running');
ok(-f '/etc/redis/redis.conf', 'redis config exists');

# Running and answering are different questions, and only the second one is any
# use to the things that depend on redis -- matrix asks for it by name.
my $ping = `redis-cli ping 2>&1`;
like($ping, qr/PONG/, 'redis answers') or diag $ping;

# On the socket or address it was configured with, rather than wherever it
# happened to come up.
my $conf = do { local (@ARGV, $/) = '/etc/redis/redis.conf'; <> } // '';
my ($port) = $conf =~ m/^port\s+(\d+)/m;
SKIP: {
    skip 'no port in redis.conf', 1 unless defined $port;
    if ($port == 0) {
        my ($sock) = $conf =~ m/^unixsocket\s+(\S+)/m;
        ok($sock && -S $sock, 'the configured unix socket is there') or diag $conf;
    }
    else {
        my $listening = `ss -lnt 2>/dev/null`;
        like($listening, qr/:$port\b/, "redis is listening on port $port") or diag $listening;
    }
}

# The salvage half of remote_files, and the half that fails without a word.
# bin/new_config fetches /var/lib/redis over sftp as [% admin_user %] with no
# sudo, and the package leaves that directory redis:redis 0750 -- which reads
# back as an empty directory rather than as a refusal, so a guest can look
# perfectly well backed up for months.  Ask it the way the fetch asks it.
my @dstat = stat '/var/lib/redis';
is(scalar getgrgid($dstat[5] // -1), '[% admin_user %]', 'the redis data directory is group [% admin_user %]');
ok($dstat[2] & 02000, 'and setgid, so what redis writes next belongs to that group too')
    or diag sprintf('mode is %04o', $dstat[2] & 07777);

# The unit ships UMask=007, so redis writes 0660 and the group above is what
# makes that readable.  Nothing here is worth much if the answer to this is no.
my $denied = `su -s /bin/sh -c 'find /var/lib/redis ! -readable -print' [% admin_user %] 2>&1`;
is($denied, '', '[% admin_user %] can read every last thing in it') or diag $denied;

# And the restore half.  What was salvaged lands in the domain directory, and
# restore_state moves it out of there -- so anything still sitting in it while
# redis started from nothing is a rebuild that quietly lost its keyspace.
my $salvage = '[% install_dir %]/[% domain %]/redis';
my @unrestored = glob("$salvage/*");
SKIP: {
    skip 'no salvage left to check: either there was none, or it was restored and moved', 1 unless @unrestored;
    ok(scalar glob('/var/lib/redis/*'), 'salvaged redis state was put back where redis reads it')
        or diag "still sitting in $salvage: @unrestored";
}

done_testing();
