#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active redis-server 2>/dev/null`;
chomp $status;
is($status, 'active', 'redis-server is running');
ok(-f '/etc/redis/redis.conf', 'redis config exists');

# Running and answering are different questions.  What uses redis, such as the
# matrix homeserver, needs it to answer.  redis-cli with no -p talks to 6379, so
# name the configured port.
my $ping = `redis-cli -p [% port %] ping 2>&1`;
like($ping, qr/PONG/, 'redis answers on the port it was configured with') or diag $ping;

# Listening on the socket or port in its configuration, not wherever it came up.
my $conf = do { local (@ARGV, $/) = '/etc/redis/redis.conf'; <> } // '';
my ($port) = $conf =~ m/^port\s+(\d+)/m;
SKIP: {
    skip 'no port in redis.conf', 1 unless defined $port;
    if ($port == 0) {
        my ($sock) = $conf =~ m/^unixsocket\s+(\S+)/m;
        ok($sock && -S $sock, 'the configured unix socket is there') or diag $conf;
    }
    else {
        my $listening = `ss -lnt 2>/dev/null`;
        like($listening, qr/:$port\b/, "redis is listening on port $port") or diag $listening;
    }
}

# The salvage half of remote_files.  bin/new_config fetches /var/lib/redis as
# root, so the package default of redis:redis 0750 is enough.  The directory
# keeps that default: group redis and no setgid bit.
my @dstat = stat '/var/lib/redis';
is(scalar getgrgid($dstat[5] // -1), 'redis', 'the redis data directory is still group redis');
ok(!($dstat[2] & 02000), 'and not setgid, since nothing needs the group carried onto new files')
    or diag sprintf('mode is %04o', $dstat[2] & 07777);

# The restore half.  The salvage lands in the domain directory, and
# restore_state moves it out.  If salvage is still there and /var/lib/redis is
# empty, the rebuild lost its keyspace.
my $salvage = '[% install_dir %]/[% domain %]/redis';
my @unrestored = glob("$salvage/*");
SKIP: {
    skip 'no salvage left to check: either there was none, or it was restored and moved', 1 unless @unrestored;
    ok(scalar glob('/var/lib/redis/*'), 'salvaged redis state was put back where redis reads it')
        or diag "still sitting in $salvage: @unrestored";
}

# The firewall profile, under a name that ufw loads.  ufw skips a section whose
# name is also in /etc/services.  templates/files/redis.ufw.conf.tt says more.
my $profile = '/etc/ufw/applications.d/redis-server';
ok(-f $profile, 'the redis firewall profile was installed');
my $prof = do { local (@ARGV, $/) = $profile; <> } // '';
like($prof, qr/^ports=\Q[% port %]\E\/tcp$/m, 'and it names the port this guest configured') or diag $prof;

SKIP: {
    skip 'ufw is not installed on this guest', 2 unless -x '/usr/sbin/ufw';

    # The listing is the whole assertion.  ufw does not list a profile that it
    # skips, and it gives no other sign.
    my $apps = `ufw app list 2>&1`;
    like($apps, qr/^\s*redis-server\s*$/m, 'ufw lists it as an application') or diag $apps;

    my $status = `ufw status 2>/dev/null`;
    like($status, qr/^\s*redis-server\b/m, 'and the ufw target turned it into a rule') or diag $status;
}

done_testing();
