#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

ok(-f '/etc/cron.d/autoupdate', 'autoupdate cron exists');

# cron silently ignores a file in cron.d that is not owned by root or that
# the group can write.
my @st = stat '/etc/cron.d/autoupdate';
is(scalar getpwuid($st[4] // -1), 'root', 'and is owned by root');
is($st[2] & 022, 0, 'and is not group or world writable');

# The redirection must be one that dash understands.  See autoupdate.cron.tt.
my $text = do { local (@ARGV, $/) = '/etc/cron.d/autoupdate'; <> } // '';
# Leave out comment lines, because the comment in the file names &> itself.
my $commands = join "\n", grep { !m/^\s*#/ } split m/\n/, $text;
unlike($commands, qr/&>>?/, 'no &> redirection, which dash does not do');
like($text, qr{> ?/var/log/autoupdate\.log 2>&1}, 'output and errors both go to the log')
    or diag $text;

# This test runs inside the build, so the build must be holding reboots now.  A
# reboot from the autorestart cron in the middle of a build leaves a half-built
# guest.  scripts/reboot_if_needed has the whole account.
ok(-e '/run/provisioner/no-reboot/[% domain %]', 'the build holds reboots while it runs');
[% IF autorestart -%]
like(slurp('/etc/cron.d/[% domain %]-autorestart'), qr{reboot_if_needed \Q[% autorestart %]\E$}m, 'the reboot cron passes the switch that holds it');
[% END -%]

sub slurp { my ($f) = @_; return do { local (@ARGV, $/) = $f; <> } // '' }

done_testing();
