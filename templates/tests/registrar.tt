#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# The shortcut an operator reaches for, with the credentials already in it.
my $shortcut = '/opt/lexicon/[% domain %]/[% lexicon.type %]';

ok(-f $shortcut, 'the lexicon shortcut for this registrar is installed');
ok(-x $shortcut, 'and can be run');

my @st = stat $shortcut;
is($st[4] // -1, 0, 'owned by root, since it carries the registrar credentials') if @st;
is(($st[2] // 0) & 07777, 0700, 'and readable by nobody else') if @st;

my $text = do { local (@ARGV, $/) = $shortcut; <> } // '';
like($text, qr/^export LEXICON_[% lexicon.type.upper() %]_AUTH_TOKEN=/m, 'carrying the token lexicon reads');

done_testing();
