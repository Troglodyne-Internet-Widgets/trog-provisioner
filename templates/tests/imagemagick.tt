#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $wanted = '[% version %]';
( my $base = $wanted ) =~ s/-[0-9]+$//;

# The perl bindings are the purpose of this recipe, so load them.  They build
# against the perl that the perl recipe installs under /opt/perl5.
my ($perl) = glob('/opt/perl5/*/bin/perl');
ok( $perl && -x $perl, 'there is a perl under /opt/perl5 to build against' );

SKIP: {
    skip 'no perl under /opt/perl5', 1 unless $perl && -x $perl;

    # Image::Magick is a subclass of the class for one quantum, such as
    # Image::Magick::Q16HDRI, and only that class has a $VERSION.  The library
    # names its own version, whichever quantum it was built with.
    my $bindings = `$perl -MImage::Magick -e 'print Image::Magick->new->Get(q{version})' 2>&1`;
    like( $bindings, qr/\Q$base\E/, "Image::Magick loads under $perl and reports $base" )
        or diag $bindings;
}

# The binaries that the build installed must be the version the recipe asked
# for, not one that a package left on the PATH.
my $magick = `magick -version 2>/dev/null` || `convert -version 2>/dev/null`;
like( $magick, qr/\QImageMagick $wanted\E/, "the installed imagemagick is $wanted" )
    or diag $magick;

done_testing();
