use strict;
use warnings;

use Test::More;
use JSON::PP;

my $port       = '[% port %]';
my $datasource = '[% datasource %]';
my $influx     = 'http://127.0.0.1:8086';

subtest 'telegraf is listening for the forwarded stream' => sub {

    # ss -lntu rather than -lnt: asked for tcp alone ss prints no Netid column,
    # so every row begins LISTEN and a pattern anchored on tcp matches nothing --
    # failing the like below and passing the unlike beneath it for free.
    #
    # Polled as well, since telegraf is restarted from a postrun task.
    my $listening = q{};
    foreach ( 1 .. 30 ) {
        $listening = `ss -lntu 2>/dev/null`;
        last if $listening =~ m/^tcp\s+LISTEN\s+\S+\s+\S+\s+127\.0\.0\.1:$port\b/m;
        sleep 2;
    }

    like( $listening, qr/^tcp\s+LISTEN\s+\S+\s+\S+\s+127\.0\.0\.1:$port\b/m, "something is bound to 127.0.0.1:$port" )
      or diag $listening;
    unlike( $listening, qr/^tcp\s+LISTEN\s+\S+\s+\S+\s+(?:0\.0\.0\.0|\*|\[::\]):$port\b/m, 'and not to every interface' )
      or diag $listening;
};

subtest 'the dashboard is in place, and names the datasource that exists' => sub {
    my $file = '/var/lib/grafana/dashboards/syslog.json';
    ok( -f $file, "$file is there" ) or return;

    my $body = do { open( my $fh, '<', $file ) or die $!; local $/; <$fh> };

    # Valid JSON, because grafana skips a dashboard it cannot parse with one
    # line in its log and goes on serving happily with nothing on it.
    my $json = eval { JSON::PP->new->decode($body) };
    ok( $json, 'and is JSON grafana can read' ) or do { diag $@; return };

    is( $json->{title}, 'Syslog', 'it is the syslog dashboard' );

    # The substitution that has to have happened: an exported dashboard refers
    # to ${DS_INFLUXDB}, and grafana replaces nothing when loading from a file,
    # so a panel left holding the placeholder draws "Datasource not found".
    unlike( $body, qr/\$\{DS_/, 'with no unsubstituted datasource placeholder left in it' );
    like( $body, qr/\Q"$datasource"\E/, "and naming the $datasource datasource" );
};

# The whole path on one machine: a message over the collector port, through its
# ruleset, out of the forward, into telegraf, and into influxdb as the syslog
# measurement the dashboard reads.
subtest 'a message sent to the collector arrives in influxdb as syslog' => sub {

    # The collector's port is read out of its own configuration rather than
    # assumed to be 514.  It is configurable at that end, and this test knowing
    # better than the file is how it would pass on a collector that was moved.
    my $conf_file = '/etc/rsyslog.d/09-logcollector.conf';
    ok( -f $conf_file, "$conf_file is there to read the port from" ) or return;
    my $conf = do { open( my $fh, '<', $conf_file ) or die $!; local $/; <$fh> };
    my ($cport) = $conf =~ m/input\(type="im(?:tcp|udp)"\s+port="(\d+)"/;
    ok( $cport, 'and says which port the collector listens on' ) or return;

    # Which database is grafana's to name, so it is discovered rather than
    # hardcoded here -- two copies of that name is how this would go green
    # against a guest storing nothing.
    my $dbs = `curl -fsS -G $influx/query --data-urlencode 'q=SHOW DATABASES' 2>&1`;
    my @dbs = $dbs =~ m/\["([^"]+)"\]/g;
    ok( scalar @dbs, 'influxdb has a database to look in' ) or do { diag $dbs; return };

    my $marker = "grafanasyslog-selftest-$$-" . time;
    system( 'logger', '-n', '127.0.0.1', '-P', $cport, '-T', '-t', 'grafanasyslog-test', $marker );

    # rsyslog forwards asynchronously and telegraf flushes on an interval, so a
    # bare check races a guest that is working perfectly well.
    my $found = q{};
    foreach ( 1 .. 24 ) {
        foreach my $db (@dbs) {
            my $out = `curl -fsS -G $influx/query --data-urlencode 'db=$db' --data-urlencode "q=SELECT \\"message\\" FROM syslog WHERE time > now() - 10m" 2>&1`;
            next unless index( $out, $marker ) >= 0;
            $found = $db;
            last;
        }
        last if $found;
        sleep 5;
    }

    ok( $found, 'the message arrived in influxdb, parsed into the syslog measurement' )
      or diag "Nothing matching $marker in @dbs after two minutes.\n"
      . `journalctl -u telegraf --no-pager -n 20 2>&1`;
    diag "stored in $found" if $found;
};

subtest 'the tags the dashboard groups by are the tags that arrived' => sub {

    # The dashboard's three variables are SHOW TAG VALUES on these, so a stream
    # parsed without them draws empty dropdowns and no data -- which is what
    # forwarding RFC3164 instead of RFC5424 looks like from the outside.
    my $dbs = `curl -fsS -G $influx/query --data-urlencode 'q=SHOW DATABASES' 2>&1`;
    my @dbs = $dbs =~ m/\["([^"]+)"\]/g;

    my $keys = q{};
    foreach my $db (@dbs) {
        my $out = `curl -fsS -G $influx/query --data-urlencode 'db=$db' --data-urlencode 'q=SHOW TAG KEYS FROM syslog' 2>&1`;
        next unless index( $out, 'hostname' ) >= 0;
        $keys = $out;
        last;
    }

    ok( $keys, 'the syslog measurement has tags on it' ) or do { diag 'no syslog measurement with tags in any database'; return };
    foreach my $tag (qw{hostname appname severity}) {
        like( $keys, qr/\["\Q$tag\E"\]/, "$tag is a tag the dashboard can group by" ) or diag $keys;
    }
};

done_testing();
