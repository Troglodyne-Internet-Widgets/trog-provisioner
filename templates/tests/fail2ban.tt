#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active fail2ban 2>/dev/null`;
chomp $status;
is($status, 'active', 'fail2ban is running');

# Whether fail2ban can read its configuration is a different question from
# whether it runs.
my $check = `fail2ban-client -t 2>&1`;
like($check, qr/OK/i, 'fail2ban accepts its configuration') or diag $check;

ok(-f '/etc/fail2ban/jail.d/[% domain %].conf', 'the jails of this domain are installed');

# fail2ban does not start a jail whose log is missing, and says so only in its
# own log.  So ask it which jails it runs.
my $running = `fail2ban-client status 2>&1`;
my ($list) = $running =~ /Jail list:\s*(.*)/;
my %running = map { $_ => 1 } split /,\s*/, ($list // '');

# sshd is on by default on Ubuntu, and every jail bans through ufw rather than
# the nftables that Ubuntu sets.
foreach my $jail (sort 'sshd', qw{[% FOR name IN jails.keys().sort() %] [% name %][% END %] }) {
    ok($running{$jail}, "the $jail jail is running") or diag $running;
    my $actions = `fail2ban-client get $jail actions 2>&1`;
    like($actions, qr/\bufw\b/, "and bans through ufw") or diag $actions;
}

done_testing();
