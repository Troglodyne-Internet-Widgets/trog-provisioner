#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $cron = '/etc/cron.d/[% domain %]-backups';
ok(-f $cron, 'backup destination cron exists');

# cron ignores a file in cron.d that is not root-owned or is group writable, and
# does not say so.  A backup schedule that cron declines to read is the same as
# no backup schedule, and looks identical from here.
my @st = stat $cron;
is(scalar getpwuid($st[4] // -1), 'root', 'and is owned by root');
is($st[2] & 022, 0, 'and is not group or world writable');

my $text = do { local (@ARGV, $/) = $cron; <> } // '';

# The redirection has to be one /bin/sh understands.  Written with &>>, dash
# reads a background & and a redirect: the backup ran detached, wrote nothing,
# and told cron it had succeeded at the moment it started.
# Comment lines excluded: the file carries a comment explaining this very
# rule, and matching against the whole text found the explanation rather
# than any command.
my $commands = join "\n", grep { !m/^\s*#/ } split m/\n/, $text;
unlike($commands, qr/&>>?/, 'no &> redirection, which dash does not do') or diag $commands;
like($commands, qr{>> ?/var/log/backups/\S+\.log 2>&1}, 'output and errors both go to the log');

# Somewhere to write it.  With no directory the redirection fails and the job
# never runs at all.
ok(-d '/var/log/backups', 'the backup log directory exists');
ok(-w '/var/log/backups', 'and is writable');

# The scripts the jobs call, by absolute path in this crontab.
foreach my $prog ($text =~ m{^\S+ \S+ \S+ \S+ \S+ \S+ (?:command )?(/\S+)}gm) {
    ok(-x $prog, "$prog is there and executable");
}

# The key rsync authenticates with.  0600 or ssh refuses to use it.
my $key = '[% install_dir %]/[% domain %]/[% key_file %]';
ok(-f $key, 'backup ssh key is in place');
my @kst = stat $key;
is($kst[2] & 07777, 0600, 'and is mode 0600, which is what ssh insists on');

# The log the cron above writes to has to be rotated, or the backup log is only
# a slower way to fill the disk that the backups are on.  logrotate passes over
# a config file it does not find owned by root, or that anyone else can write,
# and says so nowhere but its own --debug output -- and a file moved out of the
# payload keeps the ownership the tarball recorded, which is whoever built it.
my $rotate = '/etc/logrotate.d/backups';
ok(-f $rotate, 'a logrotate config for the backup logs is installed');
my @rst = stat $rotate;
is(scalar getpwuid($rst[4] // -1), 'root', 'and is owned by root');
is($rst[2] & 022, 0, 'and is not group or world writable');

my $debug = `logrotate -d $rotate 2>&1`;
unlike($debug, qr/Ignoring/, 'logrotate does not ignore it') or diag $debug;
# Its own state file is not our business, and is the one error a run of this
# under anything but root reliably produces.
my @complaints = grep { m/error:/i && !m/state file/i } split m/\n/, $debug;
is_deeply(\@complaints, [], 'and finds nothing to complain about in it') or diag $debug;
like($debug, qr{/var/log/backups/}, 'and it is the backup logs it rotates') or diag $debug;

done_testing();
