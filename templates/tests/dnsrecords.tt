#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use JSON::PP ();

# The credential this recipe writes records with belongs to the lexicon recipe,
# which it requires.  Without the shortcut there is nothing to publish through,
# whether or not this domain has anything to publish.
my $shortcut = '/opt/lexicon/[% domain %]';
ok(-x $shortcut, 'the lexicon shortcut is installed, since that is what carries the credential');

[% IF publish_records %]
# Asked of the provider rather than of a resolver: what is under test is that
# the records were published, and a resolver would answer out of its cache for
# as long as whatever it held before this lives.  stdout alone, so that a
# warning cannot spoil the JSON; stderr is asked for again only to explain a
# failure.
sub listed {
    my ($type) = @_;
    my $out = `$shortcut list $type --output=JSON 2>/dev/null`;
    my $ok = $? == 0;
    my $list = eval { JSON::PP->new->utf8->decode($out) };
    return ($ok && ref $list eq 'ARRAY') ? $list : undef;
}

sub why { my ($type) = @_; return scalar `$shortcut list $type --output=JSON 2>&1` }

my $a_records = listed('A');
ok($a_records, 'the provider answered with a list of A records') or diag why('A');
ok((grep { ($_->{content} // '') eq '[% main_ip %]' } @{ $a_records // [] }), 'holding the address this guest was built with')
    or diag explain $a_records;

my $cnames = listed('CNAME');
ok($cnames, 'and with a list of CNAMEs') or diag why('CNAME');
my %cname = map { ($_->{name} // '') => 1 } @{ $cnames // [] };
[% FOREACH alias IN full_aliases.sort() %]
ok($cname{'[% alias %]'}, '[% alias %] is published under exactly that name') or diag explain $cnames;
[% END -%]
[% ELSE %]
# The hypervisor allocates the address here, so there was none to publish at the
# time the makefile was written.
ok(1, 'this domain has no address of its own to publish, so nothing was');
[% END -%]

done_testing();
