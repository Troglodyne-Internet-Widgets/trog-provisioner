#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $user_entry = `getent passwd [% admin_user %] 2>/dev/null`;
chomp $user_entry;
ok($user_entry, 'admin user exists');

my $home = ( split m/:/, $user_entry )[5] // '';
ok($home && -d $home, "admin user home directory exists ($home)")
    or BAIL_OUT('no home directory to check');

# The directory of the domain when the admin runs it.  Recipes write the
# settings of that account there, so another home would not see them.
is($home, '[% admin_home %]', 'and it is the home that the recipes write to');

# The recipe rsyncs the skel into the home and chowns it.  ssh does not read a
# key from a home that the admin does not own.
my @st = stat $home;
is(scalar getpwuid($st[4] // -1), '[% admin_user %]', 'and is owned by the admin');

# ssh ignores an authorized_keys that is group or world writable, or that is in
# a home that is.  It gives no error, only a password prompt on a host that has
# no password.
my $keys = "$home/.ssh/authorized_keys";
ok(-s $keys, 'the admin has authorized_keys');
my @kst = stat $keys;
is($kst[2] & 022, 0, 'and it is not group or world writable');

# The recipe takes group and world write off what comes from skel, the home
# included, because the home can be the directory of the domain.
is($st[2] & 022, 0, 'and the home directory is not group or world writable');

# bin/provision runs the whole build over ssh as this user, and every command
# uses sudo.  So sudo without a password is required.
my $sudo = system("sudo -n -u [% admin_user %] sudo -n true >/dev/null 2>&1");
is($sudo, 0, 'the admin can sudo without a password');

done_testing();
