#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $user_entry = `getent passwd [% admin_user %] 2>/dev/null`;
chomp $user_entry;
ok($user_entry, 'admin user exists');

my $home = ( split m/:/, $user_entry )[5] // '';
ok($home && -d $home, "admin user home directory exists ($home)")
    or BAIL_OUT('no home directory to check');

# The recipe rsyncs a skeleton into that home and chowns it.  A home the admin
# does not own is one ssh will not read a key out of.
my @st = stat $home;
is(scalar getpwuid($st[4] // -1), '[% admin_user %]', 'and is owned by the admin');

# How anyone gets in.  ssh ignores an authorized_keys that is group or world
# writable, or one in a home directory that is -- silently, and the only symptom
# is a password prompt on a host that has no password.
my $keys = "$home/.ssh/authorized_keys";
ok(-s $keys, 'the admin has authorized_keys');
my @kst = stat $keys;
is($kst[2] & 022, 0, 'and it is not group or world writable');

# World writable, not group writable, for the home directory.  It comes out 775
# owned by the admin and a group of the same name, so group write is the same
# permission the owner already has -- and key authentication works on these
# guests with StrictModes on, which is the question that matters.  Asserting
# 0022 here failed on a guest where ssh was working perfectly well.
is($st[2] & 002, 0, 'and the home directory is not world writable');

# And passwordless sudo, which is not a convenience here: bin/provision drives
# the whole build over ssh as this user and every command it runs is sudo.
my $sudo = system("sudo -n -u [% admin_user %] sudo -n true >/dev/null 2>&1");
is($sudo, 0, 'the admin can sudo without a password');

done_testing();
