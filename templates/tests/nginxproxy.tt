#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active nginx 2>/dev/null`;
chomp $status;
is($status, 'active', 'nginx is running');

my $conf = '/etc/nginx/sites-enabled/[% domain %].conf';
ok(-f $conf, 'nginx domain config exists');

# `is-active` says nothing about the config on disk: nginx keeps running on the
# last one it accepted.  This vhost rendered `listen 443 ssl backlog=;` for a
# while, which nginx refuses outright, and the only sign was a restart failing
# three targets later.
my $check = `nginx -t 2>&1`;
like($check, qr/syntax is ok/, 'nginx accepts the configuration') or diag $check;
like($check, qr/test is successful/, 'and the whole of it, not just this file');

my $vhost = do { local (@ARGV, $/) = $conf; <> } // '';

# Every directive that takes a value has to have one.  An empty backlog= is
# what happens when a variable the template uses is not one the recipe declares.
unlike($vhost, qr/^\s*\S+=\s*;/m, 'no directive was left with an empty value')
    or diag $vhost;

# A root that does not exist serves 404s and says nothing about it.  This was
# rendering install_dir/domain twice, one inside the other.
foreach my $root ($vhost =~ m/^\s*root\s+(\S+);/gm) {
    ok(-d $root, "root $root is a directory that exists");
}

# A redirect vhost redirects; it does not also terminate TLS and proxy.
foreach my $block (split m/^server \{/m, $vhost) {
    next unless $block =~ m/return 301/;
    unlike($block, qr/^\s*listen[^;]*\bssl\b/m, 'the redirect vhost does not claim ssl');
    unlike($block, qr/proxy_pass/,              'and does not proxy');
}

# -f passes on an empty file.  This whole template is one loop over vhosts, so
# anything that leaves that loop with nothing to iterate -- a flat-interface
# config, or a stray apostrophe in a template comment, which Xslate lexes as a
# string opener and swallows the rest of the file on -- writes a valid, empty,
# entirely silent vhost.
ok(length($vhost) > 0, 'the vhost is not empty');
like($vhost, qr/^server \{/m, 'and has at least one server block in it');

# nginx wants http://unix:<path>:<uri>.  install_dir already starts with a
# slash, so this built unix://opt/... with the path doubled and no closing
# colon, and nginx refused the entire configuration with "no closing \":\" in
# unix domain socket".
unlike($vhost, qr{unix://}, 'no doubled slash after unix:');
foreach my $pass ($vhost =~ m{^\s*proxy_pass\s+(http://unix:\S+);}gm) {
    like($pass, qr{^http://unix:/[^:]+:\S*$}, "$pass terminates the socket path with a colon");
}

# server_name is a space separated list.  Joining the aliases with a comma made
# a name with a comma stuck to it, which matches nothing and is never reported.
foreach my $names ($vhost =~ m/^\s*server_name\s+([^;]+);/gm) {
    unlike($names, qr/,/, 'no comma in server_name');

    # www is appended to every domain's aliases already; naming it here as well
    # made nginx report a conflicting server name and ignore one of them.
    my %seen;
    my @dupes = grep { $seen{$_}++ } split ' ', $names;
    is_deeply(\@dupes, [], 'and no name listed twice') or diag $names;
}

# Plain HTTP on the plain HTTP port.  ssl defaulted to true for every vhost, so
# a port 80 vhost that asked for neither ssl nor a redirect spoke TLS on 80.
unlike($vhost, qr/^\s*listen\s+(\[::\]:)?80\b[^;]*\bssl\b/m,
    'port 80 does not claim ssl') or diag $vhost;

done_testing();
