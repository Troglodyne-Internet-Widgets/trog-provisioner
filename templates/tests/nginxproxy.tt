#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active nginx 2>/dev/null`;
chomp $status;
is($status, 'active', 'nginx is running');

my $conf = '/etc/nginx/sites-enabled/[% domain %].conf';
ok(-f $conf, 'nginx domain config exists');

# `is-active` says nothing about the configuration on disk.  nginx keeps
# running on the last configuration it accepted, so only a later restart fails.
my $check = `nginx -t 2>&1`;
like($check, qr/syntax is ok/, 'nginx accepts the configuration') or diag $check;
like($check, qr/test is successful/, 'and the whole of it, not just this file');

my $vhost = do { local (@ARGV, $/) = $conf; <> } // '';

# Every directive that takes a value must have one.  An empty value such as
# backlog= comes from a template variable that the recipe does not declare.
unlike($vhost, qr/^\s*\S+=\s*;/m, 'no directive was left with an empty value')
    or diag $vhost;

# A root that does not exist serves 404s and logs nothing about it.
foreach my $root ($vhost =~ m/^\s*root\s+(\S+);/gm) {
    ok(-d $root, "root $root is a directory that exists");
}

# nginx must also be able to traverse to the root.  These tests run as root,
# which can traverse every directory.  nginx runs as www-data, and a root it
# cannot traverse fails stat() ... (13: Permission denied) on every request.
foreach my $root ($vhost =~ m/^\s*root\s+(\S+);/gm) {
    my $reachable = system('runuser', '-u', 'www-data', '--', 'test', '-x', $root) == 0;
    ok($reachable, "and www-data can actually traverse into $root");
}

# Traverse is not read.  A file that the application writes into the root later
# gets the www-data group only from the setgid bit on the directory.  Without
# that bit, the file keeps the default group of the process that wrote it.
# The probe gets mode 0750, as data leaves every file, so only the group lets
# www-data read it.
foreach my $root ($vhost =~ m/^\s*root\s+(\S+);/gm) {
    next unless -d $root;
    my $probe = "$root/.nginxproxy_read_probe";
    open(my $fh, '>', $probe) or die "could not write $probe: $!";
    print {$fh} "probe\n";
    close $fh;
    chmod 0750, $probe;
    my $readable = system('runuser', '-u', 'www-data', '--', 'cat', $probe) == 0;
    ok($readable, "and www-data can actually read a file under $root, not merely traverse to it");
    unlink $probe;
}

# Every server block must serve something.  A vhost that neither serves files
# nor proxies from / answers 404 to everything, which looks like a fault in the
# application.
foreach my $block (split m/^server \{/m, $vhost) {
    next unless $block =~ m/listen/;
    next if $block =~ m/return 301/;
    ok($block =~ m/^\s*root\s/m || $block =~ m/location\s+\/\s+\{[^}]*proxy_pass/s,
        'a serving vhost either has a docroot or proxies from /') or diag $block;
}

# A redirect vhost only redirects.  It does not also terminate TLS or proxy.
foreach my $block (split m/^server \{/m, $vhost) {
    next unless $block =~ m/return 301/;
    unlike($block, qr/^\s*listen[^;]*\bssl\b/m, 'the redirect vhost does not claim ssl');
    unlike($block, qr/proxy_pass/,              'and does not proxy');
}

# -f passes on an empty file.  The vhost template is one loop over vhosts, so
# anything that empties that loop writes an empty vhost with no error.  A stray
# apostrophe in a template comment does this, because Xslate reads it as the
# start of a string and consumes the rest of the file.
ok(length($vhost) > 0, 'the vhost is not empty');
like($vhost, qr/^server \{/m, 'and has at least one server block in it');

# A unix socket reaches nginx through an upstream, never directly through
# proxy_pass.  nginx refuses every inline form of a socket, and the POD for
# enrich in Provisioner::Recipe::nginxproxy quotes the two errors.
unlike($vhost, qr{proxy_pass\s+http://unix:}, 'no socket passed to proxy_pass directly');
unlike($vhost, qr{unix://}, 'and no doubled slash after unix:');

# If a proxy_pass names an upstream that the file does not declare, nginx
# refuses the file with "host not found in upstream".
my %declared = map { $_ => 1 } $vhost =~ m{^upstream\s+(\S+)\s*\{}gm;
foreach my $used ($vhost =~ m{^\s*proxy_pass\s+http://([A-Za-z0-9_]+);}gm) {
    ok($declared{$used}, "upstream $used is declared in this file") or diag $vhost;
}

# server_name is a list separated by spaces.  A name with a comma attached
# matches nothing, and nginx does not report it.
foreach my $names ($vhost =~ m/^\s*server_name\s+([^;]+);/gm) {
    unlike($names, qr/,/, 'no comma in server_name');

    # new_config adds www to the aliases of every domain.  If a name is here
    # twice, nginx reports a conflicting server name and ignores one of them.
    my %seen;
    my @dupes = grep { $seen{$_}++ } split ' ', $names;
    is_deeply(\@dupes, [], 'and no name listed twice') or diag $names;
}

# Plain HTTP on the plain HTTP port.
unlike($vhost, qr/^\s*listen\s+(\[::\]:)?80\b[^;]*\bssl\b/m,
    'port 80 does not claim ssl') or diag $vhost;

# ACME spells it .well-known, with a hyphen, as RFC 8615 and every client do.
ok(-d '[% install_dir %]/[% domain %]/www/.well-known', 'the ACME webroot is spelled the way ACME spells it');

done_testing();
