#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active plexmediaserver 2>/dev/null`;
chomp $status;
is($status, 'active', 'plex media server is running');
ok(-d '/var/lib/plexmediaserver', 'plex data directory exists');

# Where the preferences actually went.  PREFS_DIR was set on its own make recipe
# line and used on the next, so it was empty in every use and this landed at
# /Preferences.xml -- and the python that writes it spanned several lines with
# no continuations, so the shell never got a closing quote at all.
my $prefs = '/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Preferences.xml';
ok(-f $prefs, 'Preferences.xml is in the Plex library');
ok(!-e '/Preferences.xml', 'and not at the root of the filesystem');

my $xml = do { local (@ARGV, $/) = $prefs; <> } // '';
like($xml, qr/customCertificatePath="[^"]+"/, 'the certificate path was written');
like($xml, qr/PlexOnlineUsername="\Q[% plex_login_name %]\E"/, 'and the account name');

# The repository this was installed from.  It pointed at
# downloads.plex.tv/repos/deb, which Plex has retired -- and because a missing
# key on that bucket answers 403 rather than 404, it looked like the far end
# refusing us rather than a URL that is no longer anything.
my $list = do { local (@ARGV, $/) = '/etc/apt/sources.list.d/plexmediaserver.list'; <> } // '';
like($list, qr{https://repo\.plex\.tv/deb/?\s+public\s+main}, 'the repository is repo.plex.tv')
    or diag $list;
unlike($list, qr{downloads\.plex\.tv/repos}, 'and not the retired one') or diag $list;

ok(-s '/usr/share/keyrings/plex.gpg', 'the signing key is installed');

# Installed from that repository, rather than merely present.
my $policy = `apt-cache policy plexmediaserver 2>/dev/null`;
like($policy, qr/Installed:\s*(?!\(none\))\S+/, 'plexmediaserver is installed') or diag $policy;

done_testing();
