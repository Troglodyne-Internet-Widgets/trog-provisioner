#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active nginx 2>/dev/null`;
chomp $status;
is($status, 'active', 'nginx is running');

# nginx keeps serving the last configuration it accepted, so `is-active` says
# nothing about the files on disk.  `nginx -t` reads them.
my $check = `nginx -t 2>&1`;
like($check, qr/syntax is ok/,     'nginx accepts the configuration') or diag $check;
like($check, qr/test is successful/, 'and every file it includes');

# A name that two server blocks claim goes to one of them, and nginx only
# warns.  Provisioner::Recipe::nginx gives each name to one vhost.
unlike($check, qr/conflicting server name/, 'no vhost claims a name that another vhost claims') or diag $check;
foreach my $vhost (glob '/etc/nginx/sites-enabled/*') {
    my $text = do { local (@ARGV, $/) = $vhost; <> } // '';
    foreach my $include ($text =~ m{^\s*include\s+(/etc/nginx/names/\S+);}mg) {
        ok(-s $include, "$include, which $vhost reads its names from, is there");
    }
}

# The global configuration that this recipe installs, and the map that the vhosts use.
my $global = '/etc/nginx/conf.d/global.conf';
ok(-f $global, 'the global config was installed');

my $text = do { local (@ARGV, $/) = $global; <> } // '';
like($text, qr/map \$http_upgrade \$connection_upgrade/,
    'it defines connection_upgrade, which every proxy vhost uses');

# Big enough for any domain name.  See server_names_hash_bucket_size in
# Provisioner::Recipe::nginx.
my ($bucket) = $text =~ m/server_names_hash_bucket_size\s+(\d+)/;
ok($bucket && $bucket >= 253, "server_names_hash_bucket_size is $bucket") or diag $text;

# The recipe raises worker_connections to the listen backlog.  A default value
# limits the connections that the guest accepts, and nothing reports it.
my $conf = do { local (@ARGV, $/) = '/etc/nginx/nginx.conf'; <> } // '';
like($conf, qr/worker_connections\s+\d{4,}/, 'worker_connections was tuned up');

[% IF syslog -%]
subtest 'nginx sends its access log to syslog too' => sub {
    require IO::Socket::INET;

    # A Host that no server block names goes to the default site of Ubuntu,
    # which keeps the access log of the http block.  A server block with an
    # access_log of its own, such as the mirror of aptmirror, would not.
    my $marker = "syslog-check-$$-" . time;
    my $sock   = IO::Socket::INET->new( PeerAddr => '127.0.0.1', PeerPort => 80, Proto => 'tcp', Timeout => 10 );
    ok( $sock, 'nginx answers on port 80' ) or return;
    print $sock "GET /$marker HTTP/1.0\r\nHost: nosuch.test.test\r\n\r\n";
    1 while <$sock>;
    close($sock);

    # journald has the line within a moment, but not always before the reply.
    my $journal = '';
    for ( 1 .. 5 ) {
        $journal = `journalctl --no-pager -t nginx_access --since '-5min' 2>&1`;
        last if $journal =~ m/\Q$marker\E/;
        sleep 1;
    }
    like( $journal, qr/\Q$marker\E/, 'the request is in the journal, tagged nginx_access' ) or diag $journal;
};
[% END -%]
[% IF proxied -%]

subtest 'each vhost that a public name names answers for it behind the proxy' => sub {

    # The status of a request for $name on $port as the proxy sends it, or 000
    # when nothing answers: with a PROXY header on 8443, which curl sends from
    # 127.0.0.1, and as plain HTTP on 8080.
    my $status = sub {
        my ( $name, $port ) = @_;
        my $tls  = $port == 8443;
        my $code = `curl -sk --max-time 10 @{[ $tls ? '--haproxy-protocol' : '' ]} -o /dev/null -w '%{http_code}' --resolve '$name:$port:127.0.0.1' '@{[ $tls ? 'https' : 'http' ]}://$name:$port/' 2>/dev/null`;
        return $code || '000';
    };

[% FOR vhost IN proxied.keys().sort() -%]
[% FOR name IN proxied.$vhost -%]
    isnt( $status->( '[% name %]', 8443 ), '000', '[% name %] reaches [% vhost %] on 8443' );
    isnt( $status->( '[% name %]', 8080 ), '000', 'and on 8080' );
[% END -%]
[% END -%]
    is( $status->( 'nosuch.test.test', 8443 ), '000', 'a name that no vhost answers for gets no TLS handshake on 8443' );
    is( $status->( 'nosuch.test.test', 8080 ), '000', 'and no reply on 8080' );
};

subtest 'nginx believes X-Forwarded-For on 8080 only from proxy_from' => sub {
    require IO::Socket::INET;

    # 127.0.0.1 is not in proxy_from, so this header is a client that lies.
    # The vhost, because only its servers on 8080 read the header.
    my $marker = "proxy-check-$$-" . time;
    my $sock   = IO::Socket::INET->new( PeerAddr => '127.0.0.1', PeerPort => 8080, Proto => 'tcp', Timeout => 10 );
    ok( $sock, 'nginx listens on 8080' ) or return;
    print $sock "GET /$marker HTTP/1.0\r\nHost: [% proxied.keys().sort().0 %]\r\nX-Forwarded-For: 203.0.113.7\r\n\r\n";
    1 while <$sock>;
    close($sock);

    my $log = '';
    for ( 1 .. 5 ) {
        $log = `grep -h -- '/$marker ' /var/log/nginx/access.log 2>&1`;
        last if $log;
        sleep 1;
    }
    like( $log, qr/\A127[.]0[.]0[.]1 /m, 'the log names the address that connected, not the one in the header' ) or diag $log;

    # The requests above pass no firewall, and the proxy is on another host.
    my $ufw = `ufw status 2>&1`;
    like( $ufw, qr/^nginx-proxy\s+ALLOW\s/m, 'ufw lets the proxy reach the two ports' ) or diag $ufw;
};
[% END -%]
[% IF relay_address -%]

subtest 'the jails of nginx ban through the relay' => sub {
    my $relay = '[% relay_address %]';
    foreach my $jail (qw{[% relay_jails.join(' ') %]}) {
        my $actions = `fail2ban-client get $jail actions 2>&1`;
        like( $actions, qr/\brelay-\Q[% domain %]\E\b/, "$jail bans through the relay" ) or diag $actions;
        my $ignored = `fail2ban-client get $jail ignoreip 2>&1`;
        like( $ignored, qr/\Q$relay\E/, 'and never bans the relay itself' ) or diag $ignored;
    }

    # As the action asks: with the key that the relay issued, against the host
    # key that this guest pinned.
    my $ssh = "ssh -n -i /etc/fail2ban/nginxrelay/[% domain %].key -o BatchMode=yes -o IdentitiesOnly=yes -o HostKeyAlgorithms=ssh-ed25519 -o UserKnownHostsFile=/etc/fail2ban/nginxrelay/[% domain %].known_hosts -o StrictHostKeyChecking=yes -o ConnectTimeout=10 root\@$relay";
    my $banned = sub {
        my ($ip) = @_;
        my $said = `$ssh 'check $ip' 2>&1`;
        my $rc   = $? >> 8;
        diag "the relay said: $said" if $rc > 1;
        return $rc == 0;
    };

    # An address from the documentation ranges, which no client has.  fail2ban
    # runs the action after it answers, so wait for the relay.
    my $abuser = '192.0.2.78';
    my ($jail) = qw{[% relay_jails.join(' ') %]};
    my $wait   = sub { my ($want) = @_; for ( 1 .. 15 ) { return 1 if !!$banned->($abuser) == $want; sleep 1 } return 0 };

    system("fail2ban-client set $jail banip $abuser >/dev/null 2>&1");
    ok( $wait->(1), "a ban in $jail reaches the relay" );
    system("fail2ban-client set $jail unbanip $abuser >/dev/null 2>&1");
    ok( $wait->(0), 'and so does the unban' );
};
[% END -%]

done_testing();
