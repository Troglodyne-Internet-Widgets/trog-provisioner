#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active sssd 2>/dev/null`;
chomp $status;
is($status, 'active', 'sssd is running');

ok(-f '/etc/sssd/sssd.conf', 'sssd config exists');

my $mode = (stat('/etc/sssd/sssd.conf'))[2];
is($mode & 0777, 0600, 'sssd.conf has mode 0600');

# An installed sssd does nothing until NSS and PAM name it, so check both.
my $nsswitch = do { local (@ARGV, $/) = '/etc/nsswitch.conf'; <> } // '';
like($nsswitch, qr/^passwd:.*\bsss\b/m, 'nsswitch consults sss for passwd') or diag $nsswitch;
like($nsswitch, qr/^group:.*\bsss\b/m,  'and for group');

my $pam = `grep -rl pam_sss.so /etc/pam.d 2>/dev/null`;
ok($pam, 'PAM is wired to sss') or diag 'pam-auth-update --enable sss did not take';

# sshd takes the keys of a user of the directory from SSSD.  sshd -T is
# what sshd made of every file, not what one file says.
my $sshd = `sshd -T 2>&1`;
like($sshd, qr{^authorizedkeyscommand /usr/bin/sss_ssh_authorizedkeys$}m, 'sshd asks SSSD for keys') or diag $sshd;
like($sshd, qr{^authorizedkeyscommanduser nobody$}m, 'as nobody');
ok(-x '/usr/bin/sss_ssh_authorizedkeys', 'and the command it asks is there');

my $sudoers = do { local (@ARGV, $/) = '/etc/sudoers.d/sssd'; <> } // '';
my $visudo  = `visudo -c 2>&1`;
is($? >> 8, 0, 'sudo reads every file in sudoers.d') or diag $visudo;
[% FOR group IN sudo_groups %]
like($sudoers, qr/^%\Q[% group %]\E ALL=\(ALL:ALL\) NOPASSWD: ALL$/m, '[% group %] gets sudo without a password') or diag $sudoers;
[% END %]

done_testing();
