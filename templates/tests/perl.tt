#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $user = '[% user %]';

# Ask passwd.  The home is the domain directory only when the domain names a
# service user, and otherwise it is the home of the admin under /home.
chomp( my $home = `getent passwd $user | cut -d: -f6` );
ok($home, "$user has a home directory") or BAIL_OUT("no home for $user");

# Test the build first, before anything that points at it.  The link is what
# scripts/cpan_install follows, so it names the perl everything installs into.
ok(-x '/opt/perl5/current/bin/perl', '/opt/perl5/current points at a built perl');

my $built = '/opt/perl5/current/bin/perl';
($built) = glob('/opt/perl5/*/bin/perl') unless -x $built;
ok($built && -x $built, 'a perl was built under /opt/perl5');

[% IF version -%]
# The release this domain asked for, which is what the directory is named after.
is(readlink('/opt/perl5/current'), 'perl[% version %]', 'the perl that the configuration named is the current one');
chomp( my $asked = `$built -e 'print \$^V' 2>/dev/null` );
is($asked, 'v[% version %]', 'and that release is what got built');
[% END -%]

SKIP: {
    skip 'nothing built under /opt/perl5', 2 unless $built && -x $built;

    # \$^V is escaped so that the perl running this test does not interpolate it.
    my $version = `$built -e 'print \$^V' 2>/dev/null`;
    like($version, qr/^v\d+\.\d+\.\d+$/, "the built perl reports a version ($version)");

    my $system = `/usr/bin/perl -e 'print \$^V' 2>/dev/null`;
    isnt($version, $system, 'and it is not just the system perl again')
        or diag "built: $version  system: $system";
}

# The tools that this perl always gets, which scripts/cpan_install uses.  Each
# one must run, because a build that half-worked leaves the file in place.
SKIP: {
    skip 'nothing built under /opt/perl5', 4 unless $built && -x $built;

    my $bin = $built =~ s{/perl\z}{}r;
    foreach my $tool (qw{cpanm cpm dzil}) {
        my $said = `$bin/$tool --version 2>&1`;
        ok($? == 0 && length $said, "$bin/$tool runs, as the perl recipe installs it")
            or diag "$tool said: $said";
    }

    # Module::Build has no command, so the test loads it by name.
    my $mb = `$built -MModule::Build -e 'print Module::Build->VERSION' 2>&1`;
    like($mb, qr/^\d/, 'and Module::Build is installed in it') or diag $mb;
}

# A person who logs in finds this perl through profile.d.  The build does not
# read it, and perldoc Provisioner::Recipe::perl says why.
ok(-f '/etc/profile.d/perl.sh', '/etc/profile.d/perl.sh is there');
chomp( my $on_path = `bash -lc 'command -v perl' 2>/dev/null` );
like($on_path, qr{^/opt/perl5/}, "a login shell gets the built perl first ($on_path)");

# The same perl, by whichever path each of them names it.
chomp( my $login_version = `$on_path -e 'print \$^V' 2>/dev/null` );
chomp( my $current_version = `$built -e 'print \$^V' 2>/dev/null` );
is($login_version, $current_version, 'and it is the perl that /opt/perl5/current points at');

# The editor configurations.  Every account on the guest reads them, and none
# runs them.
foreach my $rc (qw{/etc/perltidyrc /etc/perlcriticrc}) {
    my @st = stat $rc;
    ok(scalar @st, "$rc is there") or next;
    is($st[2] & 07777, 0644, "and is mode 0644");
}
my $tidyrc = '[% install_dir %]/[% domain %]/.perltidyrc';
SKIP: {
    skip "$tidyrc is not a link", 1 unless -l $tidyrc;
    is(readlink $tidyrc, '/etc/perltidyrc', "$tidyrc links to the tidy config");
}

# Nothing links tools into the bin directory of an account.
ok(!-e "$home/bin/starman", "$home/bin holds no symlink farm");

done_testing();
