#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use JSON::PP ();
use File::Basename qw{basename dirname};
use File::Temp ();

my $code = '[% install_dir %]/[% domain %]/[% basedir %]';
ok(-d $code, 'code directory exists');
ok(-d '[% admin_home %]/bin', 'admin bin directory exists');

# The admin must own both, or nothing that runs as the admin can write to them.
foreach my $dir ($code, '[% admin_home %]/bin') {
    my @st = stat $dir;
    is(scalar getpwuid($st[4] // -1), '[% admin_user %]', "$dir is owned by the admin");
}

# The recipe copies this helper in without setting a mode, then runs it by its
# absolute path.
ok(-x '[% admin_home %]/bin/repos_for', 'repos_for is installed and executable');

# Test each entity, not the directory.  Every entity clones into the one
# basedir, so a count of the directory passes when any single entity worked.
#
# repos_for records the repositories of each entity in .repos_for.json in the
# admin home, by api_url and then by entity.  That file tells whether an entity
# was fetched, and which directories it must leave.
my $repos_cache = '[% admin_home %]/.repos_for.json';
ok(-f $repos_cache, 'repos_for recorded what it fetched');

my $fetched = {};
if (-f $repos_cache) {
    open(my $cfh, '<', $repos_cache) or die "Cannot read $repos_cache: $!";
    my $json = do { local $/; <$cfh> };
    close($cfh) or die "Cannot close $repos_cache: $!";
    $fetched = eval { JSON::PP->new->utf8->decode($json) } // {};
}

[% FOR repo IN repos_from %]
[% FOR entity IN repo.repos_for %]
{
    my $named = $fetched->{'[% repo.api_url %]'}{'[% entity %]'};
    ok(ref $named eq 'HASH', '[% entity %] was fetched from [% repo.api_url %]')
        or diag 'nothing under that entity in the cache, so repos_for never asked for it';

    # repos_for goes on past a failed clone, which leaves no directory, so the
    # failure shows here.
    my @absent = grep { !-d "$code/$_" } sort keys %{ $named || {} };
    is(scalar @absent, 0, 'every repository [% entity %] has is checked out')
        or diag "not under $code: @absent";
}
[% END -%]
[% END -%]

[% IF modules.grep('^claude$').size() %]
# Each clone is a directory the agent may read and write, from wherever its
# session starts.
{
    my $settings_path = '[% install_dir %]/[% domain %]/.claude/settings.json';
    my $settings = eval { JSON::PP->new->decode(do { local (@ARGV, $/) = $settings_path; <> }) } // {};
    my %added = map { $_ => 1 } @{ $settings->{permissions}{additionalDirectories} // [] };
    # .* matches . and .., which are the basedir and its parent.
    my @clones  = grep { basename($_) ne '.' && basename($_) ne '..' } map { dirname($_) } glob "$code/*/.git $code/.*/.git";
    my @missing = grep { !$added{$_} } @clones;
    is(scalar @missing, 0, 'every clone is an additional directory of the agent')
        or diag "not in $settings_path: @missing";
}

# Only --add-dir loads the skills of a clone, so an interactive bash of the
# admin runs claude, with a claude first on PATH that prints what it got.
{
    my $stub = File::Temp::tempdir( CLEANUP => 1 );
    open( my $fh, '>', "$stub/claude" ) or die "Cannot write $stub/claude: $!";
    print {$fh} qq{#!/bin/sh\nprintf '%s\\n' "\$@"\n};
    close($fh) or die "Cannot close $stub/claude: $!";
    chmod 0755, $stub, "$stub/claude";

    my @got = `sudo -u [% admin_user %] -i bash -ic 'PATH=$stub:\$PATH claude' 2>/dev/null`;
    chomp @got;
    my %added = map { $got[$_] eq '--add-dir' ? ( $got[ $_ + 1 ] => 1 ) : () } 0 .. $#got;
    my @clones  = grep { basename($_) ne '.' && basename($_) ne '..' } map { dirname($_) } glob "$code/*/.git $code/.*/.git";
    my @missing = grep { !$added{$_} } @clones;
    is(scalar @missing, 0, 'claude in a shell of the admin adds every clone, which loads its skills')
        or diag "not added: @missing; claude got: @got";
}
[% END -%]

# A file that root owns in a checkout is one the admin cannot write, and a
# root-owned .git/index stops every commit.  The smoke of the perl recipe runs
# after this target, in the postrun, and this test after that.
{
    my @strays = grep { length } split m/\n/, qx{find '$code' -user root -printf '%p\\n' 2>&1};
    is(scalar @strays, 0, 'nothing in the checkouts belongs to root')
        or diag join "\n", @strays[0 .. ($#strays < 19 ? $#strays : 19)];
}

[% FOR pkg IN extra_pkgs %]
{
    my $installed = `dpkg -s [% pkg %] 2>/dev/null`;
    like($installed, qr/Status: install ok installed/, '[% pkg %] is installed');
}
[% END -%]

done_testing();
