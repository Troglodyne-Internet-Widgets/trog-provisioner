use strict;
use warnings;

use Test::More;

# JSON::PP is core, so every guest has it.  This file runs on the guest, and
# nothing installs an XS JSON there.
use JSON::PP;

ok(qx{which claude}, "claude installed");

my $settings_path = '[% install_dir %]/[% domain %]/.claude/settings.json';
my $settings = do { local (@ARGV, $/) = $settings_path; <> } // '';

# Do not exit early here.  An early exit prints a plan and exits 0, so a guest
# without this file reports a pass.
ok(length $settings, 'the settings file is installed');

my $conf = eval { decode_json($settings) };
ok($conf, 'and it is valid JSON') or diag $settings;

# Every enabled plugin must name a marketplace that this file declares.  If it
# does not, the plugin loads nothing and says nothing.  The unit test reads the
# rendered file, and this test reads the installed one.
SKIP: {
    skip 'settings did not parse', 1 unless $conf;
    my %declared = map { $_ => 1 } keys %{ $conf->{extraKnownMarketplaces} // {} };
    my @orphans  = grep { my (undef, $m) = split m/\@/, $_, 2; !$m || !$declared{$m} }
                   keys %{ $conf->{enabledPlugins} // {} };
    is_deeply(\@orphans, [], 'every enabled plugin comes from a marketplace this file declares')
        or diag 'declared: ' . join(', ', sort keys %declared);
}

done_testing();
