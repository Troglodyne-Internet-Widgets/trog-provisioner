use strict;
use warnings;

use Test::More;

# JSON::PP is core, so every guest has it.  This file runs on the guest, and
# nothing installs an XS JSON there.
use JSON::PP;

ok(qx{which claude}, "claude installed");

my $settings_path = '[% install_dir %]/[% domain %]/.claude/settings.json';
my $settings = do { local (@ARGV, $/) = $settings_path; <> } // '';

# Do not exit early here.  An early exit prints a plan and exits 0, so a guest
# without this file reports a pass.
ok(length $settings, 'the settings file is installed');

my $conf = eval { decode_json($settings) };
ok($conf, 'and it is valid JSON') or diag $settings;

# Every enabled plugin must name a marketplace that this file declares.  If it
# does not, the plugin loads nothing and says nothing.  The unit test reads the
# rendered file, and this test reads the installed one.
SKIP: {
    skip 'settings did not parse', 1 unless $conf;
    my %declared = map { $_ => 1 } keys %{ $conf->{extraKnownMarketplaces} // {} };
    my @orphans  = grep { my (undef, $m) = split m/\@/, $_, 2; !$m || !$declared{$m} }
                   keys %{ $conf->{enabledPlugins} // {} };
    is_deeply(\@orphans, [], 'every enabled plugin comes from a marketplace this file declares')
        or diag 'declared: ' . join(', ', sort keys %declared);
}

# Over ssh, a mouse that Claude Code captures is a terminal that cannot copy.
SKIP: {
    skip 'settings did not parse', 1 unless $conf;
    is($conf->{env}{CLAUDE_CODE_DISABLE_MOUSE}, '1', 'Claude Code leaves the mouse to the terminal');
}

# The agent runs as the service user, so it must own what the recipe leaves in
# its home, and the admin only where the domain names no service user.  A file
# that the admin or root owns is one the agent cannot write.  .claude is always
# there; npm and rtk leave the others only when they run.
my $home = '[% install_dir %]/[% domain %]';
ok(-d "$home/.claude", 'the agent has a .claude directory');
foreach my $path (grep { -e } map { "$home/$_" } qw{.claude .npm .config/rtk .local/share/rtk}) {
    my @strays = grep { length } split m/\n/, qx{find '$path' ! -user '[% user %]' -printf '%u %p\\n' 2>&1};
    is_deeply(\@strays, [], "everything under $path belongs to [% user %]")
        or diag join "\n", @strays;
}

# rtk filters the output of a shell command before the agent reads it.  A path
# is not a program, so this runs it, and the version says the .deb of the
# release is what is installed rather than whatever was on the guest before.
my $rtk = qx{rtk --version 2>&1};
like($rtk, qr/\d+\.\d+\.\d+/, 'rtk runs and says its version') or diag $rtk;
like($rtk, qr/\Q[% rtk_version.replace('^v', '') %]\E/, 'and it is the version that was asked for') or diag $rtk;

# The hook is the whole point: without it in settings.json, rtk is installed
# and nothing goes through it.
SKIP: {
    skip 'settings did not parse', 2 unless $conf;

    my @bash = grep { ($_->{matcher} // '') eq 'Bash' } @{ $conf->{hooks}{PreToolUse} // [] };
    my @commands = map { map { $_->{command} // '' } @{ $_->{hooks} // [] } } @bash;
    ok((grep { m/\brtk\b/ } @commands), 'the Bash tool goes through rtk')
        or diag 'PreToolUse commands: ' . join(', ', @commands);

    # rtk edits this file rather than writing its own, so a recipe that ran it
    # in the wrong order would leave the settings with no plugins in them.
    ok(scalar keys %{ $conf->{enabledPlugins} // {} }, 'and the plugins the recipe enabled are still there');
}

# The plugins every guest gets, named as their marketplaces publish them.
SKIP: {
    skip 'settings did not parse', 2 unless $conf;
    foreach my $plugin (qw{perl-slop@troglodyne-marketplace simple-english@simple-english}) {
        ok($conf->{enabledPlugins}{$plugin}, "$plugin is enabled");
    }
}

# The plugins that claude itself says are installed and enabled for an account,
# as plugin@marketplace.  An enabled plugin that is not installed loads nothing,
# and a claude -p run does not install it.
sub installed_plugins {
    my ($account, $home) = @_;
    my $json = qx{runuser -u '$account' -- env HOME='$home' claude plugin list --json 2>/dev/null};
    my $list = eval { decode_json($json) } // [];
    return sort map { $_->{id} } grep { $_->{enabled} } @$list;
}

SKIP: {
    skip 'settings did not parse', 1 unless $conf;
    my @got = installed_plugins('[% user %]', $home);
    is_deeply(\@got, [sort keys %{ $conf->{enabledPlugins} // {} }], 'claude says that [% user %] has each enabled plugin installed')
        or diag 'installed: ' . join(', ', @got);
}

# The auto mode configuration of the operator, where the domain has one.  A
# domain without one keeps the defaults, which is the ordinary case.
my $fragment_path = '[% install_dir %]/[% domain %]/claude.auto-mode.json';
SKIP: {
    skip 'this domain has no auto mode configuration', 1 unless -e $fragment_path;
    skip 'settings did not parse', 1 unless $conf;

    my $fragment = eval { decode_json(do { local (@ARGV, $/) = $fragment_path; <> }) };
    is_deeply($conf->{autoMode}, $fragment, 'the settings carry the auto mode configuration of the domain');
}
[% IF github_user %]

# The bot that each command of the agent acts as.  Asked of gh and git with the
# environment that the installed settings give, because that is what the agent
# runs with.  The token is never printed.
SKIP: {
    skip 'settings did not parse', 3 unless $conf;
    my %env = %{ $conf->{env} // {} };

    is($env{GH_CONFIG_DIR}, '[% gh_config_dir %]', 'the agent reads the login of the bot');

    my $token = qx{runuser -u '[% user %]' -- env GH_CONFIG_DIR='[% gh_config_dir %]' gh auth token 2>/dev/null};
    chomp $token;
    ok(length $token, 'and gh finds a token there for [% user %], who runs the agent');

    # In variables first, because an @ in an address interpolates in a regex.
    my ($bot, $email) = ('[% github_user %]', '[% git_email %]');
    local @ENV{ keys %env } = values %env;
    my $ident = qx{git var GIT_AUTHOR_IDENT 2>&1};
    like($ident, qr/^\Q$bot\E[ ]<\Q$email\E>[ ]/x, 'and git commits as the bot') or diag $ident;
}
[% END %]

[% IF restricted_user %]
# The account that a program runs claude as, and its home.  See A RESTRICTED
# AGENT in Provisioner::Recipe::claude.
{
    my $restricted = '[% restricted_home %]';
    my @account    = getpwnam '[% restricted_user %]';
    is($account[7], $restricted, 'the restricted agent has a home of its own');
    is($account[8], '/usr/sbin/nologin', 'and cannot log in');

    my $text  = do { local (@ARGV, $/) = "$restricted/.claude/settings.json"; <> } // '';
    my $rconf = eval { decode_json($text) };
    ok($rconf, 'its settings are installed, as valid JSON') or diag $text;
    SKIP: {
        skip 'its settings did not parse', 4 unless $rconf;
        ok($rconf->{enabledPlugins}{'perl-slop@troglodyne-marketplace'}, 'with the plugins');
        is_deeply($rconf->{env}, { CLAUDE_CODE_DISABLE_MOUSE => '1' }, 'and none of the environment that makes the agent of the domain the bot');
        my @commands = map { map { $_->{command} // '' } @{ $_->{hooks} // [] } }
                       grep { ($_->{matcher} // '') eq 'Bash' } @{ $rconf->{hooks}{PreToolUse} // [] };
        ok((grep { m/\brtk\b/ } @commands), 'and its Bash tool goes through rtk');

        my @got = installed_plugins('[% restricted_user %]', $restricted);
        is_deeply(\@got, [sort keys %{ $rconf->{enabledPlugins} // {} }], 'and claude says that each of its plugins is installed')
            or diag 'installed: ' . join(', ', @got);
    }

    system('runuser', '-u', '[% restricted_user %]', '--', 'test', '-r', "$restricted/.claude/settings.json");
    is($? >> 8, 0, '[% restricted_user %] reads its own settings, through the directory of the domain');
    system('runuser', '-u', '[% restricted_user %]', '--', 'ls', '[% install_dir %]/[% domain %]');
    isnt($? >> 8, 0, 'and cannot list that directory');

    my @strays = grep { length } split m/\n/, qx{find '$restricted' ! -user '[% restricted_user %]' -printf '%u %p\\n' 2>&1};
    is_deeply(\@strays, [], 'everything in its home belongs to [% restricted_user %]') or diag join "\n", @strays;
}
[% END %]

done_testing();
