use strict;
use warnings;

use Test::More;

# Core, so a freshly provisioned guest has it.  Nothing here installs an XS
# JSON, and this file runs on the guest rather than on the provisioner.
use JSON::PP;

ok(qx{which claude}, "claude installed");

my $settings_path = '[% install_dir %]/[% domain %]/.claude/settings.json';
my $settings = do { local (@ARGV, $/) = $settings_path; <> } // '';

# No early exit here.  Bailing out emits a plan and exits 0, so a guest missing
# this file would report a passing run.
ok(length $settings, 'the settings file is installed');

my $conf = eval { decode_json($settings) };
ok($conf, 'and it is valid JSON') or diag $settings;

# Every enabled plugin has to name a marketplace this same file declares.  This
# shipped enabling "perl-sloppin@Troglodyne-Internet-Widgets" -- a plugin that
# nothing publishes, from a marketplace named nowhere else in the file -- so it
# loaded nothing, quietly, on every guest built with this recipe.  The unit test
# reads what was rendered; this reads what was installed, which is the half that
# catches the fragment putting it somewhere else.
SKIP: {
    skip 'settings did not parse', 1 unless $conf;
    my %declared = map { $_ => 1 } keys %{ $conf->{extraKnownMarketplaces} // {} };
    my @orphans  = grep { my (undef, $m) = split m/\@/, $_, 2; !$m || !$declared{$m} }
                   keys %{ $conf->{enabledPlugins} // {} };
    is_deeply(\@orphans, [], 'every enabled plugin comes from a marketplace this file declares')
        or diag 'declared: ' . join(', ', sort keys %declared);
}

done_testing();
