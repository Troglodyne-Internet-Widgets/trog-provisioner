use strict;
use warnings;

use Test::More;

# JSON::PP is core, so every guest has it.  This file runs on the guest, and
# nothing installs an XS JSON there.
use JSON::PP;

ok(qx{which claude}, "claude installed");

my $settings_path = '[% install_dir %]/[% domain %]/.claude/settings.json';
my $settings = do { local (@ARGV, $/) = $settings_path; <> } // '';

# Do not exit early here.  An early exit prints a plan and exits 0, so a guest
# without this file reports a pass.
ok(length $settings, 'the settings file is installed');

my $conf = eval { decode_json($settings) };
ok($conf, 'and it is valid JSON') or diag $settings;

# Every enabled plugin must name a marketplace that this file declares.  If it
# does not, the plugin loads nothing and says nothing.  The unit test reads the
# rendered file, and this test reads the installed one.
SKIP: {
    skip 'settings did not parse', 1 unless $conf;
    my %declared = map { $_ => 1 } keys %{ $conf->{extraKnownMarketplaces} // {} };
    my @orphans  = grep { my (undef, $m) = split m/\@/, $_, 2; !$m || !$declared{$m} }
                   keys %{ $conf->{enabledPlugins} // {} };
    is_deeply(\@orphans, [], 'every enabled plugin comes from a marketplace this file declares')
        or diag 'declared: ' . join(', ', sort keys %declared);
}

# rtk filters the output of a shell command before the agent reads it.  A path
# is not a program, so this runs it, and the version says the .deb of the
# release is what is installed rather than whatever was on the guest before.
my $rtk = qx{rtk --version 2>&1};
like($rtk, qr/\d+\.\d+\.\d+/, 'rtk runs and says its version') or diag $rtk;
like($rtk, qr/\Q[% rtk_version.replace('^v', '') %]\E/, 'and it is the version that was asked for') or diag $rtk;

# The hook is the whole point: without it in settings.json, rtk is installed
# and nothing goes through it.
SKIP: {
    skip 'settings did not parse', 2 unless $conf;

    my @bash = grep { ($_->{matcher} // '') eq 'Bash' } @{ $conf->{hooks}{PreToolUse} // [] };
    my @commands = map { map { $_->{command} // '' } @{ $_->{hooks} // [] } } @bash;
    ok((grep { m/\brtk\b/ } @commands), 'the Bash tool goes through rtk')
        or diag 'PreToolUse commands: ' . join(', ', @commands);

    # rtk edits this file rather than writing its own, so a recipe that ran it
    # in the wrong order would leave the settings with no plugins in them.
    ok(scalar keys %{ $conf->{enabledPlugins} // {} }, 'and the plugins the recipe enabled are still there');
}

# The plugins every guest gets, named as their marketplaces publish them.
SKIP: {
    skip 'settings did not parse', 2 unless $conf;
    foreach my $plugin (qw{perl-slop@troglodyne-marketplace simple-english@simple-english}) {
        ok($conf->{enabledPlugins}{$plugin}, "$plugin is enabled");
    }
}

done_testing();
