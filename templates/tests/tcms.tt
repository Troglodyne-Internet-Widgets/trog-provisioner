#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $dir = '[% install_dir %]/[% domain %]/tCMS';

# The first request that tCMS answers touches config/setup, and from then on
# nobody is offered the page that registers the first user.  The flag is there
# before this test only in a checkout that came down from the last guest.
my $was_set_up = -e "$dir/config/setup";

ok(-d $dir, 'the tCMS checkout is there');
ok(-d "$dir/.git", 'and is a git checkout');

# scripts/cpan_install installs the dependencies of tCMS with this cpanm.  It
# uses the perl that /opt/perl5/current points at, where the perl recipe built one.
my $cpanm = '/opt/perl5/current/bin/cpanm';
($cpanm) = reverse sort grep { !m{/current/} } glob('/opt/perl5/*/bin/cpanm') unless -x $cpanm;
ok($cpanm && -x $cpanm, 'the cpanm the perl recipe installed is there');

# A cpanm that is there can still fail to start, so run it.
my $cpanm_version = `$cpanm --version 2>&1`;
like($cpanm_version, qr/cpanm|App::cpanminus/i, 'and it runs') or diag $cpanm_version;

my ($perl) = reverse sort glob('/opt/perl5/*/bin/perl');

# The modules of the checkout that build against a system library.  The Ubuntu
# deps of tcms carry what each one builds against.
foreach my $module (qw{Sys::Virt Imager::File::PNG Trog::TOTP}) {
    my $loaded = `$perl -M$module -e 1 2>&1`;
    is($?, 0, "$module loads in the perl the recipe built") or diag $loaded;
}

# Installer.mk makes what the checkout does not track.  Without data/, every
# request answers 500.
foreach my $made ("$dir/data/files", "$dir/totp", "$dir/logs", '[% install_dir %]/[% domain %]/.tcms') {
    my $owner = getpwuid( ( stat $made )[4] // -1 ) // '';
    is($owner, '[% user %]', "$made is there, and the service user owns it");
}

# prereq-frontend of Installer.mk fetches what the pages load, and make -q says
# whether a file is still missing.  The emoji picker dies without its list.
my $frontend = `sudo -u [% user %] HOME='[% install_dir %]/[% domain %]' make -q -C '$dir' -f Installer.mk prereq-frontend 2>&1`;
is($? >> 8, 0, 'every front-end file that Installer.mk fetches is there') or diag $frontend;
my $emoji = '';
if (open(my $fh, '<', "$dir/www/scripts/list.min.json")) { local $/; $emoji = <$fh> }
ok(eval { require JSON::PP; JSON::PP::decode_json($emoji) }, 'and the emoji list is JSON') or diag $@;

# The tests run after post_install has started the service.  Ask its socket,
# not nginx, whose cache can answer 200 for a tCMS that answers 500.
my $code = `curl -s -m 30 -o /dev/null -w '%{http_code}' --unix-socket '[% install_dir %]/[% domain %]/run/tpsgi.sock' -H 'Host: [% domain %]' http://localhost/ 2>&1`;
is($code, '200', 'tCMS answers its front page');

# tCMS builds its links and its redirects from this.  bin/tcms-hostname with no
# argument prints it.
my $hostname = `cd '$dir' && sudo -u [% user %] HOME='[% install_dir %]/[% domain %]' /opt/perl5/current/bin/perl bin/tcms-hostname 2>&1`;
chomp $hostname;
is($hostname, '[% domain %]', 'the hostname of tCMS is the domain');

[% IF secure_host -%]
# Asked after the front page, which set tCMS up: before that, every path is the
# setup page.
my $login = `curl -s -m 30 -o /dev/null -w '%{http_code} %{redirect_url}' --unix-socket '[% install_dir %]/[% domain %]/run/tpsgi.sock' -H 'Host: [% domain %]' http://localhost/login 2>&1`;
is($login, '302 https://[% secure_host %]/login', 'tCMS sends the login of the domain to the secure host');
[% END -%]

# tPSGI answers the first request for a file of www/ and links the file into
# www/static, and nginx answers the second from the link.
foreach my $try (qw{first second}) {
    my $css = `curl -sk -m 30 -o /dev/null -w '%{http_code}' --resolve '[% domain %]:443:127.0.0.1' https://[% domain %]/styles/structure.css 2>&1`;
    is($css, '200', "nginx answers the $try request for a stylesheet of tCMS");
}
isnt(system(qw{runuser -u www-data -- test -r}, "$dir/config/default.cfg"), 0, 'and nginx cannot read the configuration of tCMS');

# Asking took the first-time setup away from a fresh install, so give it back.
# The running workers opened the databases that the reset deletes, so restart
# them too.
SKIP: {
    skip 'the checkout was set up before this test', 2 if $was_set_up;
    my $reset = `sudo -u [% user %] HOME='[% install_dir %]/[% domain %]' make -C '$dir' -f Installer.mk reset 2>&1 && systemctl restart '[% domain %]' 2>&1`;
    is($?, 0, 'a fresh install is reset, and tCMS restarted') or diag $reset;
    ok(!-e "$dir/config/setup", 'so its first visitor is offered the setup page');
}

# The Minion worker transcodes the uploaded videos, and the units of the
# postrun tasks have started by now.
my $worker = `systemctl is-active 'tcms-worker-[% domain %].service' 2>&1`;
chomp $worker;
is($worker, 'active', 'the tCMS job worker is active') or diag `journalctl -u 'tcms-worker-[% domain %].service' -n 20 --no-pager 2>&1`;
my $ffmpeg = `ffmpeg -version 2>&1`;
is($? >> 8, 0, 'ffmpeg, which the worker transcodes with, runs') or diag $ffmpeg;
[% IF user != admin_user -%]

# tCMS restarts its worker from a job of that worker, after it updates its
# checkout.  THE JOB WORKER in Provisioner::Recipe::tcms.
system('runuser', '-u', '[% user %]', '--', 'sudo', '-n', '-l', '/usr/bin/systemctl', 'restart', '--no-block', 'tcms-worker-[% domain %].service');
is($? >> 8, 0, '[% user %] may restart the job worker with sudo, without waiting');
[% END -%]

# git refuses to work in a checkout that another account owns, and the service
# user is not the admin.
my $safe = `HOME='[% install_dir %]/[% domain %]' git config --global --get-all safe.directory 2>/dev/null`;
like($safe, qr{\Q$dir\E}, 'the checkout is registered as a git safe.directory') or diag $safe;

done_testing();
