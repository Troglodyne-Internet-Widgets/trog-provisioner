#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $dir = '[% install_dir %]/[% domain %]/tCMS';

# This used to name a tcms_dir that no recipe, module or template ever set, so
# it rendered empty: the assertion became -d on the domain directory with a
# trailing slash, and passed whether tCMS had been checked out or not.
ok(-d $dir, 'the tCMS checkout is there');
ok(-d "$dir/.git", 'and is a git checkout');

# What cpan_install runs to install the application's dependencies: it finds its
# perl as the newest under /opt/perl5, which is where the perl recipe built one.
# Missing, the build fails in the perl recipe's target.
my ($cpanm) = reverse sort glob('/opt/perl5/*/bin/cpanm');
ok($cpanm && -x $cpanm, 'the cpanm the perl recipe installed is there');

# And it runs.  Being there is not the same thing: nvm's node was installed and
# could not start for want of a shared library, and every check that asked where
# it was rather than what it did passed regardless.
my $cpanm_version = `$cpanm --version 2>&1`;
like($cpanm_version, qr/cpanm|App::cpanminus/i, 'and it runs') or diag $cpanm_version;

# git refuses to operate in a checkout owned by another account, and the service
# user is not the admin.
my $safe = `HOME='[% install_dir %]/[% domain %]' git config --global --get-all safe.directory 2>/dev/null`;
like($safe, qr{\Q$dir\E}, 'the checkout is registered as a git safe.directory') or diag $safe;

done_testing();
