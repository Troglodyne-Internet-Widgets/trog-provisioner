#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# One entry for each file that a recipe of this guest names in guest_secrets.
# bin/new_config writes this list from those entries, so a recipe that adds a
# secret gets this check with no other change.  bin/provision places each file
# with its mode and tries the owner.  The account is often from a package that
# was not installed yet, so only the state after the build says whether the
# recipe gave the file to its owner.
my @secrets = (
[% FOREACH s IN secrets %]
    [ q{[% s.path %]}, q{[% s.owner %]}, q{[% s.mode %]} ],
[% END %]
);

foreach my $secret (@secrets) {
    my ( $path, $owner, $mode ) = @{$secret};
    my $wanted = sprintf( '%s %04o', $owner, oct($mode) );

    my @st    = lstat $path;
    my $found = 'no such file';
    if (@st) {
        my $user  = getpwuid( $st[4] ) // $st[4];
        my $group = getgrgid( $st[5] ) // $st[5];
        $found = sprintf( '%s:%s %04o', $user, $group, $st[2] & 07777 );
        $found .= ' (not a regular file)' unless -f _;
    }

    is( $found, $wanted, "$path is $wanted" )
        or diag "$path should be owned by $owner with mode $mode, and it is: $found";
}

done_testing();
