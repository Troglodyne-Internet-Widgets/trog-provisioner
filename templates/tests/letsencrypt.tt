#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

ok(-f '/etc/dehydrated/domains.d/[% domain %].conf', 'dehydrated domain config exists');
ok(-f '/etc/dehydrated/hooks/[% domain %].sh', 'dehydrated hook script exists');

# The cert nginx and everything else reads.  The fetcher used to rm this pair
# and relink to whatever dehydrated had produced -- so when dehydrated failed,
# and it fails for any domain that cannot answer ACME, what was left was two
# dangling symlinks and no service that terminates TLS would start.
foreach my $pem ('/etc/ssl/certs/[% domain %].pem', '/etc/ssl/private/[% domain %].pem') {
    ok(-e $pem, "$pem exists");
    ok(-s $pem, "$pem is readable and not empty")
        or diag("dangling symlink? " . (-l $pem ? readlink($pem) : 'not a symlink'));
}

# The hook has to be runnable, not merely present -- dehydrated calls it.
ok(-x '/etc/dehydrated/hooks/[% domain %].sh', 'the hook is executable');

# The certificate covers the domain itself.  The ssl target used to name only
# www and mail in the SAN, because the alias list it joined was never passed to
# that template -- so the name almost everything asks for was the one name the
# certificate did not carry.
my $san = `openssl x509 -noout -ext subjectAltName -in /etc/ssl/certs/[% domain %].pem 2>&1`;
like($san, qr/DNS:\Q[% domain %]\E(?![\w.-])/, 'the certificate covers the domain itself')
    or diag $san;
like($san, qr/DNS:www\.\Q[% domain %]\E/, 'and www');

# And it parses at all, which a truncated or half-written pem does not.
my $subject = `openssl x509 -noout -subject -in /etc/ssl/certs/[% domain %].pem 2>&1`;
like($subject, qr/subject=/, 'the certificate parses') or diag $subject;

done_testing();
