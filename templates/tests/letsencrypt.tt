#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

ok(-f '/etc/dehydrated/domains.d/[% domain %].conf', 'dehydrated domain config exists');
ok(-f '/etc/dehydrated/hooks/[% domain %].sh', 'dehydrated hook script exists');

# The cert nginx and everything else reads.  The fetcher used to rm this pair
# and relink to whatever dehydrated had produced -- so when dehydrated failed,
# and it fails for any domain that cannot answer ACME, what was left was two
# dangling symlinks and no service that terminates TLS would start.
foreach my $pem ('/etc/ssl/certs/[% domain %].pem', '/etc/ssl/private/[% domain %].pem') {
    ok(-e $pem, "$pem exists");
    ok(-s $pem, "$pem is readable and not empty")
        or diag("dangling symlink? " . (-l $pem ? readlink($pem) : 'not a symlink'));
}

# The hook has to be runnable, not merely present -- dehydrated calls it.
ok(-x '/etc/dehydrated/hooks/[% domain %].sh', 'the hook is executable');

# The certificate covers the domain itself.  The ssl target used to name only
# www and mail in the SAN, because the alias list it joined was never passed to
# that template -- so the name almost everything asks for was the one name the
# certificate did not carry.
my $san = `openssl x509 -noout -ext subjectAltName -in /etc/ssl/certs/[% domain %].pem 2>&1`;
like($san, qr/DNS:\Q[% domain %]\E(?![\w.-])/, 'the certificate covers the domain itself')
    or diag $san;
like($san, qr/DNS:www\.\Q[% domain %]\E/, 'and www');

# And it parses at all, which a truncated or half-written pem does not.
my $subject = `openssl x509 -noout -subject -in /etc/ssl/certs/[% domain %].pem 2>&1`;
like($subject, qr/subject=/, 'the certificate parses') or diag $subject;

# What the next rebuild will be able to salvage.  bin/new_config fetches the
# certificate store as root now (issue #76), so none of this needs to be
# readable by the admin account any more -- issue #98 took that back out.
# dehydrated writes both the private keys and the account key 0600 root, and
# nothing here widens that.  A guest rebuilt with certificates it has no keys
# for still issues from scratch against the rate limit, and loses the
# registration if the account key went too -- that risk is what the salvage
# exists to avoid, not who else could read it on the guest.
#
# The exit hook runs first, because it is what leaves the tree in the state the
# nightly renewal leaves it in.
is(system('/etc/dehydrated/hooks/[% domain %].sh', 'exit_hook'), 0, 'the dehydrated exit hook runs');

# /etc/dehydrated/accounts holds nothing but the account key, so the whole tree
# is root-only now.  /var/lib/dehydrated/certs still has to be walkable, since
# the certificates in it stay public.
my $accounts_gripe = `sudo -u '[% admin_user %]' find '/etc/dehydrated/accounts' -print 2>&1 >/dev/null`;
isnt($accounts_gripe, '', 'the admin user can no longer walk the accounts tree');

my $certs_gripe = `sudo -u '[% admin_user %]' find '/var/lib/dehydrated' -print 2>&1 >/dev/null`;
is($certs_gripe, '', 'but can still walk the certificate tree, since the certificates in it are public');

# And every key in there is root-only: not readable by the admin account, and
# not by the rest of the guest either.  A guest that has never reached the CA
# has none of these, which is the one case where there is nothing to say.
my @keys = grep { -f $_ && !-l $_ } (
    glob('/var/lib/dehydrated/certs/*/priv*.pem'),
    glob('/etc/dehydrated/accounts/*/account_key.pem'),
);
SKIP: {
    skip 'dehydrated has issued nothing and registered nothing here', 2 unless @keys;

    my @readable = grep { system('sudo', '-u', '[% admin_user %]', 'test', '-r', $_) == 0 } @keys;
    is(scalar @readable, 0, 'no private key is readable by the admin account any more')
        or diag join("\n", @readable);

    my @exposed = grep { (stat $_)[2] & 0077 } @keys;
    is(scalar @exposed, 0, 'and none of them is readable by anyone but root')
        or diag join("\n", @exposed);
}

done_testing();
