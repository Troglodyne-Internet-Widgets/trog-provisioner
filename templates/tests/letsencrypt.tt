#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

ok(-f '/etc/dehydrated/domains.d/[% domain %].conf', 'dehydrated domain config exists');
ok(-f '/etc/dehydrated/hooks/[% domain %].sh', 'dehydrated hook script exists');

# The certificate that nginx and every other TLS service reads.  If this pair
# is a dangling symlink, none of those services starts.
foreach my $pem ('/etc/ssl/certs/[% domain %].pem', '/etc/ssl/private/[% domain %].pem') {
    ok(-e $pem, "$pem exists");
    ok(-s $pem, "$pem is readable and not empty")
        or diag("dangling symlink? " . (-l $pem ? readlink($pem) : 'not a symlink'));
}

# dehydrated calls the hook, so it must be executable, not only present.
ok(-x '/etc/dehydrated/hooks/[% domain %].sh', 'the hook is executable');

# The certificate covers the domain itself, which is the name that almost
# every client asks for.
my $san = `openssl x509 -noout -ext subjectAltName -in /etc/ssl/certs/[% domain %].pem 2>&1`;
like($san, qr/DNS:\Q[% domain %]\E(?![\w.-])/, 'the certificate covers the domain itself')
    or diag $san;
like($san, qr/DNS:www\.\Q[% domain %]\E/, 'and www');

# A truncated or half-written pem does not parse.
my $subject = `openssl x509 -noout -subject -in /etc/ssl/certs/[% domain %].pem 2>&1`;
like($subject, qr/subject=/, 'the certificate parses') or diag $subject;

# What the next rebuild can salvage.  bin/new_config fetches the certificate
# store as root, so the keys stay 0600 root.  Provisioner::Recipe::letsencrypt
# has the whole account.
#
# Run the exit hook first, because it leaves the tree in the state that the
# nightly renewal leaves it in.
is(system('/etc/dehydrated/hooks/[% domain %].sh', 'exit_hook'), 0, 'the dehydrated exit hook runs');

# /etc/dehydrated/accounts holds the ACME account and its key, so the whole
# tree is root-only.  /var/lib/dehydrated/certs stays walkable, because the
# certificates in it are public.
my $accounts_gripe = `sudo -u '[% admin_user %]' find '/etc/dehydrated/accounts' -print 2>&1 >/dev/null`;
isnt($accounts_gripe, '', 'the admin user can no longer walk the accounts tree');

my $certs_gripe = `sudo -u '[% admin_user %]' find '/var/lib/dehydrated' -print 2>&1 >/dev/null`;
is($certs_gripe, '', 'but can still walk the certificate tree, since the certificates in it are public');

# Only root can read each key: not the admin account, and not the rest of the
# guest.  A guest that never reached the CA has no keys, so there is nothing to
# test.
my @keys = grep { -f $_ && !-l $_ } (
    glob('/var/lib/dehydrated/certs/*/priv*.pem'),
    glob('/etc/dehydrated/accounts/*/account_key.pem'),
);
SKIP: {
    skip 'dehydrated has issued nothing and registered nothing here', 2 unless @keys;

    my @readable = grep { system('sudo', '-u', '[% admin_user %]', 'test', '-r', $_) == 0 } @keys;
    is(scalar @readable, 0, 'no private key is readable by the admin account any more')
        or diag join("\n", @readable);

    my @exposed = grep { (stat $_)[2] & 0077 } @keys;
    is(scalar @exposed, 0, 'and none of them is readable by anyone but root')
        or diag join("\n", @exposed);
}

done_testing();
