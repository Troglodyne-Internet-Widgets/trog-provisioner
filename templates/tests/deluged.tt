#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $deluged = `systemctl is-active deluged 2>/dev/null`;
chomp $deluged;
is($deluged, 'active', 'deluged is running');

my $web = `systemctl is-active deluge-web 2>/dev/null`;
chomp $web;
is($web, 'active', 'deluge-web is running');

ok(-d '[% install_dir %]/[% domain %]/torrents', 'torrent storage directory exists');

# Everything this recipe puts in place, checked where it was put.  The recipe
# used to move a deluged_nginx.conf that template_files never generated, so the
# target died partway and left the rest of this undone.
ok(-f '/var/lib/deluged/config/core.conf', 'the core config was installed');
ok(-f '/etc/ufw/applications.d/deluged',   'and the ufw application profile');

# The web UI is served through nginxproxy, which this recipe requires rather
# than writing a vhost of its own.  A second vhost here would be one this recipe
# invented, and there was one.
ok(-f '/etc/nginx/sites-enabled/[% domain %].conf', 'nginxproxy wrote the vhost');
ok(!-e '/etc/nginx/sites-enabled/files.[% domain %].conf',
    'and deluged did not write a competing one');

# The state directory, made here rather than by deluged, because the torrent
# state salvaged off the last guest is restored into it before the daemon is
# started at all.
ok(-d '/var/lib/deluged/config/state', 'the torrent state directory is there before deluged makes it');

# And the path down to it walkable by the admin user, since the salvage that
# preserves it is an sftp session as that user with no sudo.  One directory in
# this list owned debian-deluged:debian-deluged is a fetch that comes back empty
# and does not say why.
foreach my $dir (qw{/var/lib/deluged /var/lib/deluged/config /var/lib/deluged/config/state}) {
    my @st = stat($dir);
    is(scalar getgrgid($st[5] // -1), '[% admin_user %]', "$dir has the admin user as its group");
    is($st[2] & 0050, 0050, "$dir can be read and walked by that group");
    ok(!($st[2] & 0007), "$dir is closed to everybody else");
}

# The group stops there: core.conf is this domain configuration, rewritten from
# the template every provision, and nothing off the guest reads it.
my @core = stat('/var/lib/deluged/config/core.conf');
is(scalar getgrgid($core[5] // -1), 'debian-deluged', 'core.conf keeps the group it had');
ok(!($core[2] & 0007), 'and is readable by nobody else');

# What remote_files is a round trip for.  State salvaged off the last guest is
# restored before deluged starts and the copy in the data directory goes away
# when it is; still sitting there with an empty state directory beside it is a
# restore that never happened, and a seedbox that has forgotten every torrent.
sub has_content {
    my ($dir) = @_;
    opendir(my $dh, $dir) or return 0;
    my @entries = grep { !m/\A\.\.?\z/ } readdir($dh);
    closedir($dh);
    return scalar @entries;
}

ok(!has_content('[% install_dir %]/[% domain %]/deluged/state')
    || has_content('/var/lib/deluged/config/state'),
    'nothing was salvaged and left unrestored beside an empty state directory');

# Modes per type, not u=rwX: the data target lands a salvage 0750, X preserves
# an execute bit somebody already has, and the state would come back executable
# on a rebuild while looking right on a first build.
my $state = '/var/lib/deluged/config/state';
SKIP: {
    skip 'no state directory yet', 2 unless -d $state;
    my @wrong_dirs  = grep { ( (stat $_)[2] & 07777 ) != 0750 } grep { -d $_ } glob("$state $state/*");
    my @wrong_files = grep { ( (stat $_)[2] & 07777 ) != 0640 } grep { -f $_ } glob("$state/*");
    is_deeply(\@wrong_dirs,  [], 'every directory under the torrent state is 0750');
    is_deeply(\@wrong_files, [], 'and every file in it is 0640, executable bits and all');
}

done_testing();
