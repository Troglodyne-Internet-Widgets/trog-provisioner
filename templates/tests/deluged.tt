#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $deluged = `systemctl is-active deluged 2>/dev/null`;
chomp $deluged;
is($deluged, 'active', 'deluged is running');

my $web = `systemctl is-active deluge-web 2>/dev/null`;
chomp $web;
is($web, 'active', 'deluge-web is running');

ok(-d '[% install_dir %]/[% domain %]/torrents', 'torrent storage directory exists');

# Each file that this recipe installs, in the place that it puts it.
ok(-f '/var/lib/deluged/config/core.conf', 'the core config was installed');
ok(-f '/etc/ufw/applications.d/deluged',   'and the ufw application profile');

# nginxproxy serves the web UI.  This recipe requires it and writes no vhost of
# its own.
ok(-f '/etc/nginx/sites-enabled/[% domain %].conf', 'nginxproxy wrote the vhost');
ok(!-e '/etc/nginx/sites-enabled/files.[% domain %].conf',
    'and deluged did not write a competing one');

# The fragment makes the state directory, so that it exists before deluged
# first starts.
ok(-d '/var/lib/deluged/config/state', 'the torrent state directory is there before deluged makes it');

# The fetch reads the guest as root.  So the whole path stays
# debian-deluged:debian-deluged, and no other account can walk it.
foreach my $dir (qw{/var/lib/deluged /var/lib/deluged/config /var/lib/deluged/config/state}) {
    my @st = stat($dir);
    is(scalar getgrgid($st[5] // -1), 'debian-deluged', "$dir is still group debian-deluged");
    ok(!($st[2] & 0007), "$dir is closed to everybody outside that account");
}

# core.conf keeps its group too.  The fragment writes it from the template on
# every new guest, and nothing off the guest reads it.
my @core = stat('/var/lib/deluged/config/core.conf');
is(scalar getgrgid($core[5] // -1), 'debian-deluged', 'core.conf keeps the group it had');
ok(!($core[2] & 0007), 'and is readable by nobody else');

# The round trip of remote_files.  The restore moves the salvaged state out of
# the data directory before deluged starts.  If the salvage is still there and
# the state directory is empty, the restore did not happen.  The seedbox then
# forgets every torrent.
sub has_content {
    my ($dir) = @_;
    opendir(my $dh, $dir) or return 0;
    my @entries = grep { !m/\A\.\.?\z/ } readdir($dh);
    closedir($dh);
    return scalar @entries;
}

ok(!has_content('[% install_dir %]/[% domain %]/deluged/state')
    || has_content('/var/lib/deluged/config/state'),
    'nothing was salvaged and left unrestored beside an empty state directory');

# One mode per type, not u=rwX.  The data target lands a salvage 0750, and X
# keeps that execute bit.  So a rebuild brings the state back executable, and a
# first build does not show it.
#
# Ask the files for the bits that they must not have, not for one exact mode.
# deluged writes torrents.state itself after the fragment runs chmod, under its
# own umask.  So an exact 0640 passes only on a guest where deluged did not
# start.  A file must not be executable, and must give no access outside the
# account.  The 0660 that the daemon writes breaks neither rule.
my $state = "/var/lib/deluged/config/state";
SKIP: {
    skip "no state directory yet", 3 unless -d $state;
    my @state_files = grep { -f $_ } glob("$state/*");
    my @wrong_dirs  = grep { ( (stat $_)[2] & 07777 ) != 0750 } grep { -d $_ } glob("$state $state/*");
    my @executable  = grep { (stat $_)[2] & 0111 } @state_files;
    my @open_to_all = grep { (stat $_)[2] & 0007 } @state_files;
    is_deeply(\@wrong_dirs,  [], "every directory under the torrent state is 0750");
    is_deeply(\@executable,  [], "nothing in it came back executable");
    is_deeply(\@open_to_all, [], "and nothing in it is open outside debian-deluged");
}

done_testing();
