use strict;
use warnings;

use Test::More;
use JSON::PP;

my $port      = '[% port %]';
my $database  = '[% influx_database %]';
my $ds_name   = '[% datasource_name %]';
my $retention = '[% retention %]';
my $influx    = 'http://127.0.0.1:8086';

subtest 'all three services are running' => sub {

    # grafana-server is the unit name that the deb installs, not the package
    # name.  Asked about `grafana`, systemctl reports inactive on a good guest.
    foreach my $unit (qw{influxdb telegraf grafana-server}) {
        chomp( my $active = `systemctl is-active $unit 2>/dev/null` );
        is( $active, 'active', "$unit is running" )
          or diag `systemctl status $unit --no-pager -n 15 2>&1`;
    }
};

subtest 'the metrics store is on loopback and nowhere else' => sub {

    # influxd defaults to ":8086", every interface, with no authentication.
    # /etc/default/influxdb keeps it off the network, and a guest without that
    # file looks the same until something scans it.
    #
    # ss -lntu, not -lnt.  Asked for tcp alone, ss prints no Netid column, so a
    # pattern anchored on tcp matches nothing and the unlike passes untested.
    my $listening = `ss -lntu 2>/dev/null`;
    like( $listening, qr/^tcp\s+LISTEN\s+\S+\s+\S+\s+127\.0\.0\.1:8086\b/m, 'influxd is bound to loopback' )
      or diag $listening;
    unlike( $listening, qr/^tcp\s+LISTEN\s+\S+\s+\S+\s+(?:0\.0\.0\.0|\*|\[::\]):8086\b/m, 'and not to every interface' )
      or diag $listening;
};

subtest 'grafana answers, on loopback, behind the proxy' => sub {

    # Polled, because a postrun task restarts grafana, and grafana binds its
    # port a few seconds after systemd calls it active.
    my ( $listening, $health ) = ( q{}, q{} );
    foreach ( 1 .. 30 ) {
        $listening = `ss -lntu 2>/dev/null`;

        # The health endpoint needs no credentials, and it reports the version
        # and the database that grafana keeps its state in.
        $health = `curl -fsS --max-time 5 http://127.0.0.1:$port/api/health 2>&1`;
        last if $listening =~ m/^tcp\s+LISTEN\s+\S+\s+\S+\s+127\.0\.0\.1:$port\b/m && $health =~ m/"database"/;
        sleep 2;
    }

    like( $listening, qr/^tcp\s+LISTEN\s+\S+\s+\S+\s+127\.0\.0\.1:$port\b/m, "grafana is bound to 127.0.0.1:$port" )
      or diag $listening;
    like( $health, qr/"database":\s*"ok"/, 'and reports itself healthy' ) or diag $health;
};

subtest 'the database exists and expires what it holds' => sub {

    # A database that telegraf makes has duration 0s, which never expires.  On
    # a collector that takes the syslog stream of the fleet, the disk fills.
    my $out = `curl -fsS -G $influx/query --data-urlencode 'q=SHOW RETENTION POLICIES ON "$database"' 2>&1`;
    like( $out, qr/\bautogen\b/, "$database exists and has its default policy" ) or diag $out;
    unlike( $out, qr/"autogen","0s"/, "and $database expires measurements rather than keeping them forever" )
      or diag "retention is 0s, which is never: $out";
};

subtest 'telegraf is actually writing to it' => sub {

    # Telegraf flushes every ten seconds, so a single check races a guest that
    # is new and works correctly.
    my $out = q{};
    foreach ( 1 .. 12 ) {
        $out = `curl -fsS -G $influx/query --data-urlencode 'db=$database' --data-urlencode 'q=SHOW MEASUREMENTS' 2>&1`;
        last if $out =~ m/\bcpu\b/;
        sleep 5;
    }
    like( $out, qr/\bcpu\b/, 'the host metrics telegraf collects are arriving in influxdb' )
      or diag "after 60s, SHOW MEASUREMENTS said: $out\n" . `journalctl -u telegraf --no-pager -n 15 2>&1`;
};

subtest 'grafana loaded the datasource it was provisioned with' => sub {

    # Ask grafana, not the file.  Grafana skips a provisioning file with a
    # syntax error at startup, logs it once, and stays healthy with no
    # datasource.
    my $out = `curl -fsS -u '[% grafana_admin %]:[% admin_password %]' http://127.0.0.1:$port/api/datasources 2>&1`;
    like( $out, qr/"name":"\Q$ds_name\E"/,     "the $ds_name datasource is there" ) or diag $out;
    like( $out, qr/"database":"\Q$database\E"/, "pointed at $database" )            or diag $out;
};
[% IF home_dashboard -%]

subtest 'a login lands on the home dashboard' => sub {

    # Without default_home_dashboard_path, the home page lists only starred and
    # recent dashboards.  On a new guest that is none, so a provisioned
    # dashboard is loaded and still out of sight.
    my $file = '/var/lib/grafana/dashboards/[% home_dashboard %]';
    ok( -f $file, "$file is there" ) or return;
    my $want = eval { JSON::PP->new->decode( do { open( my $fh, '<', $file ) or die $!; local $/; <$fh> } ) };
    ok( $want,          'and is JSON' ) or do { diag $@; return };
    ok( $want->{title}, 'with a title to tell it from the stock home page' ) or return;

    my $api  = "http://127.0.0.1:$port/api/dashboards";
    my $auth = q{[% grafana_admin %]:[% admin_password %]};
    my $out  = `curl -fsS -u '$auth' $api/home 2>&1`;
    my $home = eval { JSON::PP->new->decode($out) };
    ok( $home, 'grafana answers for its home page' ) or do { diag $out; return };

    # Grafana 13 answers with a redirect to a copy of the file under a uid of
    # its own, so the title is what the two have in common.
    if ( my ($uid) = ( $home->{redirectUri} // q{} ) =~ m{^/d/([^/]+)} ) {
        $out  = `curl -fsS -u '$auth' $api/uid/$uid 2>&1`;
        $home = eval { JSON::PP->new->decode($out) };
    }
    is( $home && $home->{dashboard}{title}, $want->{title}, "and the home page is $want->{title}" ) or diag $out;
};
[% END -%]

done_testing();
