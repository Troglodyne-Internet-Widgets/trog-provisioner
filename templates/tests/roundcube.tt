#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

ok(-d '[% install_dir %]/webmail.[% domain %]', 'roundcube directory exists');
ok(-f '[% install_dir %]/webmail.[% domain %]/config/config.inc.php', 'roundcube config exists');
ok(-f '/etc/nginx/sites-enabled/webmail.[% domain %].conf', 'roundcube nginx vhost exists');

# nginx can refuse a vhost file that exists.  A failed restart says only that it
# failed, and nginx -t says why.
my $check = `nginx -t 2>&1`;
like($check, qr/test is successful/, 'nginx accepts the configuration') or diag $check;

my $status = `systemctl is-active nginx 2>/dev/null`;
chomp $status;
is($status, 'active', 'and nginx is running');

# php-fpm serves roundcube through the socket that the vhost names.  php-fpm.conf
# includes only pool.d/*.conf, so the pool must be a .conf.
my $pool = `ls /etc/php/*/fpm/pool.d/roundcube-[% domain %].conf 2>/dev/null`;
ok($pool, 'the php-fpm pool for this domain is installed where php-fpm includes it') or diag $pool;
ok(!glob('/etc/php/*/fpm/pool.d/roundcube-[% domain %].ini'),
    'and not under an extension php-fpm never reads');

# An empty user in a pool file is one php-fpm refuses to start on.
my $conf = `cat /etc/php/*/fpm/pool.d/roundcube-[% domain %].conf 2>/dev/null`;
like($conf, qr/^user\s*=\s*\S+/m,  'the pool names a user');
like($conf, qr/^group\s*=\s*\S+/m, 'and a group');

# The socket exists only if php-fpm loaded the pool.  Without it, nginx answers
# every request to webmail with a 502 that names a missing file, not the pool.
my $sock = '/var/run/roundcube-[% domain %].sock';
ok(-S $sock, 'php-fpm created the socket the vhost proxies to')
    or diag `ls -l /var/run/roundcube-* /run/php/ 2>&1`;

# Roundcube looks for the database only where the DSN points, and the salvaged
# one goes back there.  So these two go together.  A restore into another
# directory leaves the DSN pointing at an empty database.
my $db = '[% install_dir %]/webmail.[% domain %]_data/roundcube.db';
my $inc = do { local (@ARGV, $/) = '[% install_dir %]/webmail.[% domain %]/config/config.inc.php'; <> } // '';
like($inc, qr{db_dsnw.*\Qsqlite://\E/*\Q$db\E}, 'the configured database is the one at that path') or diag $inc;
ok(-s $db, 'and there is a database there');

# The schema comes from sqlite.initial.sql on a first build, or from the
# previous guest on a rebuild.
my $tables = `sqlite3 '$db' "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name IN ('users','contacts','identities')" 2>&1` // '';
chomp $tables;
is($tables, '3', 'and roundcube tables in it') or diag $tables;

# The pool runs as the service user of the domain.  That user must write the
# database and its journal, the session and attachment temp files, and the log.
my ($pool_user) = $conf =~ m/^user\s*=\s*(\S+)/m;
$pool_user //= '';
foreach my $path ($db, '[% install_dir %]/webmail.[% domain %]_data',
    '[% install_dir %]/webmail.[% domain %]/temp', '[% install_dir %]/webmail.[% domain %]/logs') {
    my $writable = $pool_user ? `runuser -u $pool_user -- test -w '$path' && echo yes` : '';
    like($writable, qr/yes/, "$pool_user, which the pool runs as, can write $path")
        or diag `ls -ld '$path'`;
}

# A 502 here means that the pool did not load.  Any other code means that php
# ran.
my $code = `curl -sk -o /dev/null -w '%{http_code}' -H 'Host: webmail.[% domain %]' https://127.0.0.1/ 2>/dev/null`;
chomp $code;
like($code, qr/^(?:200|30[0-9])$/, 'roundcube answers a request through nginx')
    or diag "HTTP $code from the webmail vhost";

# restore_state removes the salvage after it puts it back.  So a salvage still in
# the domain directory means that restore_state declined.  That is correct on a
# guest that still has its own users.  On a rebuild, it means that the contacts
# and identities of the old guest stopped in the domain directory.
my $salvaged = '[% install_dir %]/[% domain %]/roundcube/roundcube.db';
SKIP: {
    skip 'no previous guest was salvaged from', 1 unless -s $salvaged;
    my $was = `sqlite3 '$salvaged' 'SELECT COUNT(*) FROM contacts' 2>/dev/null` // '';
    my $now = `sqlite3 '$db' 'SELECT COUNT(*) FROM contacts' 2>/dev/null` // '';
    chomp($was, $now);
    ok($was =~ m/^[0-9]+$/ && $now =~ m/^[0-9]+$/ && $now >= $was,
        "the live database kept the $was contacts the salvage had (it has $now)")
        or diag "salvage at $salvaged was never restored into $db";
}

done_testing();
