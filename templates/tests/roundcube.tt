#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

ok(-d '[% install_dir %]/webmail.[% domain %]', 'roundcube directory exists');
ok(-f '[% install_dir %]/webmail.[% domain %]/config/config.inc.php', 'roundcube config exists');
ok(-f '/etc/nginx/sites-enabled/webmail.[% domain %].conf', 'roundcube nginx vhost exists');

# The vhost file existing says nothing about nginx accepting it, and a failed
# restart says only that it failed.  This guest could not start nginx at all:
# server_names_hash_bucket_size was 64, which webmail.<domain> overflows once
# the domain is any length, and the sentence saying so appears only here.
my $check = `nginx -t 2>&1`;
like($check, qr/test is successful/, 'nginx accepts the configuration') or diag $check;

my $status = `systemctl is-active nginx 2>/dev/null`;
chomp $status;
is($status, 'active', 'and nginx is running');

# php-fpm is what serves it, through the socket the vhost names.
my $pool = `ls /etc/php/*/fpm/pool.d/roundcube-[% domain %].ini 2>/dev/null`;
ok($pool, 'the php-fpm pool for this domain is installed') or diag $pool;

# An empty user in a pool file is one php-fpm refuses to start on.
my $conf = `cat /etc/php/*/fpm/pool.d/roundcube-[% domain %].ini 2>/dev/null`;
like($conf, qr/^user\s*=\s*\S+/m,  'the pool names a user');
like($conf, qr/^group\s*=\s*\S+/m, 'and a group');

# The database has to be where the DSN says it is, because that is the only
# place roundcube will look for it, and it is where the salvaged one is put
# back.  Asserting both together is the point: a restore into some other
# directory would leave the config pointing at an empty database.
my $db = '[% install_dir %]/webmail.[% domain %]_data/roundcube.db';
my $inc = do { local (@ARGV, $/) = '[% install_dir %]/webmail.[% domain %]/config/config.inc.php'; <> } // '';
like($inc, qr{db_dsnw.*\Qsqlite://\E/*\Q$db\E}, 'the configured database is the one at that path') or diag $inc;
ok(-s $db, 'and there is a database there');

# With the schema in it, whether that came from sqlite.initial.sql on a first
# build or off the previous guest on a rebuild.
my $tables = `sqlite3 '$db' "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name IN ('users','contacts','identities')" 2>&1` // '';
chomp $tables;
is($tables, '3', 'and roundcube tables in it') or diag $tables;

# restore_state removes the salvage once it has put it back, so one still lying
# in the domain directory means it declined.  That is correct against a guest
# that still has its own users, and wrong on a rebuild -- where it means the
# contacts and identities came down off the old guest and got no further than
# the domain directory.
my $salvaged = '[% install_dir %]/[% domain %]/roundcube/roundcube.db';
SKIP: {
    skip 'no previous guest was salvaged from', 1 unless -s $salvaged;
    my $was = `sqlite3 '$salvaged' 'SELECT COUNT(*) FROM contacts' 2>/dev/null` // '';
    my $now = `sqlite3 '$db' 'SELECT COUNT(*) FROM contacts' 2>/dev/null` // '';
    chomp($was, $now);
    ok($was =~ m/^[0-9]+$/ && $now =~ m/^[0-9]+$/ && $now >= $was,
        "the live database kept the $was contacts the salvage had (it has $now)")
        or diag "salvage at $salvaged was never restored into $db";
}

done_testing();
