#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $status = `systemctl is-active koan 2>/dev/null`;
chomp $status;
is($status, 'active', 'koan service is running');

ok(-d '[% install_dir %]/[% domain %]/koan', 'koan repo directory exists');
ok(-d '[% install_dir %]/[% domain %]/.venv', 'python virtualenv exists');

# root, group the service user, mode 0640 -- which is what the recipe sets these
# to at the end and what the comment at the top of it describes: the bot reads
# its secrets, and does not get to rewrite them.
#
# They are installed with -o [% user %] first.  That used to be a hardcoded
# `-o koan`, which is the account name only because the one domain running this
# recipe happens to use it; any other got "install: invalid user 'koan'" and
# lost the target there.
foreach my $file (
    '[% install_dir %]/[% domain %]/koan/.env',
    '[% install_dir %]/[% domain %]/koan/instance/config.yaml',
) {
    next unless -e $file;
    my @st = stat $file;
    is(scalar getpwuid($st[4]), 'root',      "$file is owned by root");
    is(scalar getgrgid($st[5]), '[% user %]', "and group [% user %]");
    is($st[2] & 07777, 0640,                 "and mode 0640");
}

[% IF messaging_provider == 'matrix' -%]
# The matrix federation port, declared as a profile rather than allowed from
# the fragment.  `default deny outgoing` blocks 8448, and a rule added here had
# to outlive the ufw target -- which is why this used to be queued to postrun to
# land after it.  A profile is what that target applies instead.
my $profile = '/etc/ufw/applications.d/koan';
ok(-f $profile, 'the matrix federation firewall profile was installed');

SKIP: {
    skip 'ufw is not installed on this guest', 2 unless -x '/usr/sbin/ufw';

    # A malformed profile is absent from the list rather than reported.
    my $apps = `ufw app list 2>&1`;
    like($apps, qr/^\s*koan-matrix\s*$/m, 'ufw lists it as an application') or diag $apps;

    # Outbound is the direction this one is for: koan reaches out to a
    # homeserver, it does not answer federation itself.
    my $status = `ufw status 2>/dev/null`;
    like($status, qr/koan-matrix.*\bALLOW OUT\b|\bALLOW OUT\b.*koan-matrix/m, 'and 8448 is allowed outbound') or diag $status;
}
[% ELSE -%]
# Not a matrix bot, so nothing should have opened the federation port.
ok(!-e '/etc/ufw/applications.d/koan', 'no matrix firewall profile on a bot that does not speak matrix');
[% END -%]

done_testing();
