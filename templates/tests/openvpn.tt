#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use File::Temp qw{tempdir};

sub slurp {
    my ($file) = @_;
    open( my $fh, '<', $file ) or return '';
    local $/;
    my $content = <$fh>;
    close $fh;
    return $content // '';
}

# Every file that easyrsa must make, by name.
foreach my $pki (qw{
    pki/ca.crt
    pki/issued/server.crt
    pki/private/server.key
    pki/dh.pem
    pki/ta.key
}) {
    ok(-s "/etc/openvpn/easy-rsa/$pki", "easy-rsa produced $pki");
}

# And the copies that the server reads.  Compared, not only counted: a restore
# one directory too deep leaves both files present but different.
foreach my $file (qw{ca.crt server.crt server.key dh.pem ta.key}) {
    ok(-s "/etc/openvpn/server/$file", "$file was copied into the server directory");
}
is(slurp('/etc/openvpn/server/ca.crt'), slurp('/etc/openvpn/easy-rsa/pki/ca.crt'), 'the CA the server reads is the CA in the pki');

# Modes, because a wrong mode appears only on the second provision.  A salvaged
# PKI comes back through the data directory, which sets every file to 0750.
foreach my $mode (qw{ca.crt dh.pem ta.key issued/server.crt private/ca.key private/server.key}) {
    is((stat("/etc/openvpn/easy-rsa/pki/$mode"))[2] & 07777, 0600, "pki/$mode is 0600 however this guest was built");
}
is((stat('/etc/openvpn/easy-rsa/pki'))[2] & 07777, 0700, 'and the pki directory is 0700');
foreach my $file (qw{ca.crt server.crt server.key dh.pem ta.key}) {
    is((stat("/etc/openvpn/server/$file"))[2] & 07777, 0600, "the server copy of $file is 0600, not whatever cp carried over");
}

# The CA has the name of the domain.  EASYRSA_REQ_CN gives that name in batch
# mode.
my $subject = `openssl x509 -noout -subject -in /etc/openvpn/easy-rsa/pki/ca.crt 2>/dev/null`;
like($subject, qr/\Q[% domain %]\E/, 'the CA is named for the domain') or diag $subject;

# The staged copy is what remote_files names, so a rebuilt guest keeps its CA.
# It keeps what travels apart from what the running VPN uses.  It belongs to
# [% admin_user %] and nobody else can read it.  Provisioner::Recipe::openvpn
# has the whole account.
my $stage = '/etc/openvpn/pki-salvage';
ok(-d $stage, 'the pki was staged for the fetch');
foreach my $file (qw{ca.crt private/ca.key issued/server.crt}) {
    ok(-s "$stage/$file", "the staged pki has $file");
}

my $uid = getpwnam('[% admin_user %]');
is((stat($stage))[4], $uid, 'the staged pki belongs to [% admin_user %]');
is((stat("$stage/private/ca.key"))[4], $uid, 'and so does the CA key inside it');
is((stat("$stage/private/ca.key"))[2] & 07777, 0600, 'which nobody else can read');
is(slurp("$stage/ca.crt"), slurp('/etc/openvpn/easy-rsa/pki/ca.crt'), 'the staged CA is the one in use');

# What the data target put down, if it is still here.  restore_state moves the
# salvage when it restores it.  It declines when this guest already has a PKI,
# and then the CA of the guest is already that one.  So a copy here next to a
# different CA is a rebuild that lost its CA.  An empty copy here is a fetch
# that could not read its source.
my $salvaged = '[% install_dir %]/[% domain %]/openvpn/pki';
SKIP: {
    skip('no salvage left to check: either there was none, or it was restored and moved', 2) unless -d $salvaged;
    ok(-s "$salvaged/ca.crt", 'the salvaged pki came down with a CA in it');
    is(slurp("$salvaged/ca.crt"), slurp('/etc/openvpn/easy-rsa/pki/ca.crt'), 'and it is the CA this guest is using');
}

my $status = `systemctl is-active openvpn-server\@server 2>/dev/null`;
chomp $status;
is($status, 'active', 'openvpn server is running');
ok(-f '/etc/openvpn/server/server.conf', 'openvpn server config exists');

# The firewall profile names the port and the protocol that this domain
# configured.
my $profile = '/etc/ufw/applications.d/openvpn-server';
ok(-f $profile, 'the openvpn firewall profile was installed');
my $prof = do { local (@ARGV, $/) = $profile; <> } // '';
like($prof, qr{^ports=\Q[% port %]\E/\Q[% proto %]\E$}m, 'and it names the port and protocol this domain configured') or diag $prof;

SKIP: {
    skip 'ufw is not installed on this guest', 2 unless -x '/usr/sbin/ufw';

    my $apps = `ufw app list 2>&1`;
    like($apps, qr/^\s*OpenVPN\s*$/m, 'ufw lists it as an application') or diag $apps;

    # What the profile is for: ufw resolving it to the real port.  A malformed
    # one lists and then yields nothing here.
    my $info = `ufw app info OpenVPN 2>&1`;
    like($info, qr{\Q[% port %]\E/\Q[% proto %]\E}, 'and resolves it to a port a rule can be made from') or diag $info;
}

# Forwarding.  ip_forward and MASQUERADE route nothing alone, because a
# forwarded packet meets the filter FORWARD chain first and ufw drops it there.
# Provisioner::Recipe::openvpn has the whole account.
my $forwarding = `sysctl -n net.ipv4.ip_forward 2>/dev/null`;
chomp $forwarding;
is($forwarding, '1', 'the kernel is willing to forward');

# -S, not -L: it prints rules as they were written, so this tests the rule and
# not the layout of a table.
my $filter = `iptables -S ufw-before-forward 2>&1`;
like($filter, qr{^-A ufw-before-forward -s \Q[% subnet %]/[% cidr %]\E -j ACCEPT$}m,
    'the VPN subnet is forwarded rather than dropped') or diag $filter;
like($filter, qr{^-A ufw-before-forward -d \Q[% subnet %]/[% cidr %]\E .*RELATED,ESTABLISHED -j ACCEPT$}m,
    'and the answers get back to it') or diag $filter;

# The NAT rule, and the interface that it names.  A missing rule and a rule for
# an interface that this guest does not have look the same from outside.
# iptables accepts any name, and nothing matches a wrong one.  Both look like a
# working VPN until somebody connects.
my $nat = `iptables -t nat -S 2>&1`;
my ($masq_iface) = $nat =~ m{^-A trog-nat -s \Q[% subnet %]/[% cidr %]\E -o (\S+) -j MASQUERADE$}m;
ok($masq_iface, 'the VPN subnet is masqueraded on the way out') or diag $nat;
ok($masq_iface && -d "/sys/class/net/$masq_iface", 'and out of an interface this guest actually has')
    or diag 'masquerading out of: ' . ($masq_iface // 'nothing');

# Once, after any number of ufw reloads.  ufw reloads with iptables-restore
# --noflush, which flushes a user chain that the input declares but never a
# built-in one.  So the rule is in trog-nat, and a reload replaces it.
my $copies = () = $nat =~ m{^-A \S+ -s \Q[% subnet %]/[% cidr %]\E -o \S+ -j MASQUERADE$}mg;
is($copies, 1, 'and masqueraded exactly once') or diag $nat;

# In the file as well as in the kernel.  The kernel copy goes at the next
# reboot, and /etc/ufw/before.rules puts it back.
my $before = slurp('/etc/ufw/before.rules');
like($before, qr{^-A ufw-before-forward -s \Q[% subnet %]/[% cidr %]\E -j ACCEPT$}m,
    'and the forwarding rules survive a reboot, because ufw reads them from before.rules');

# What the server tells clients to do with all this.
my $server_conf = slurp('/etc/openvpn/server/server.conf');
like($server_conf, qr{^topology subnet$}m,
    'the server names its topology rather than taking the deprecated net30 default');
[% FOR r IN pushes -%]
like($server_conf, qr{^push "route \Q[% r.network %] [% r.netmask %]\E"$}m,
    'and routes clients to [% r.network %] [% r.netmask %] through the tunnel');
[% END -%]
[% IF redirect_gateway -%]
like($server_conf, qr{^push "redirect-gateway def1 bypass-dhcp"$}m,
    'and pushes the default route, which is what this domain asked for');
[% ELSE -%]
unlike($server_conf, qr{redirect-gateway},
    'and pushes no default route, which is what this domain asked for');
[% END -%]

ok(-x '/usr/local/sbin/openvpn-stage-pki', 'the script that stages the pki is installed, for remote_prepare to run');

# openvpn-client-config, against a copy of the PKI, so that a provision leaves
# no working client certificate on the real one.
{
    my $copy = tempdir(CLEANUP => 1);
    is(system('cp', '-a', '/etc/openvpn/easy-rsa/.', $copy), 0, 'copied the easy-rsa directory to issue a test client from');

    my $client = 'provisioner-test';
    my $ovpn   = `OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-client-config $client 2>&1 >'$copy/out'`;
    is($?, 0, 'openvpn-client-config issues a client and prints its configuration') or diag $ovpn;
    $ovpn = slurp("$copy/out");

    like($ovpn, qr{^remote \Q[% domain %] [% port %]\E$}m, 'the client connects to this domain on the port the server listens on') or diag $ovpn;
    like($ovpn, qr{^proto \Q[% proto %]\E$}m, 'with the protocol the server listens with');
    like($ovpn, qr{^cipher \Q[% cipher %]\E$}m, 'and the cipher the server uses');

    my %inline = $ovpn =~ m{^<([a-z-]+)>\n(.*?)^</\1>$}msg;
    foreach my $block (qw{ca cert key tls-auth}) {
        ok(length($inline{$block} // ''), "the configuration carries <$block> inline");
    }
    is($inline{'tls-auth'}, slurp('/etc/openvpn/easy-rsa/pki/ta.key'), 'and the tls-auth key is the one the server reads');

    open(my $fh, '>', "$copy/client.crt") or die "$copy/client.crt: $!";
    print $fh $inline{cert} // '';
    close $fh;
    my $verify = `openssl verify -CAfile /etc/openvpn/easy-rsa/pki/ca.crt '$copy/client.crt' 2>&1`;
    like($verify, qr/: OK$/m, 'the client certificate is signed by the CA of this server') or diag $verify;

    open($fh, '>', "$copy/client.key") or die "$copy/client.key: $!";
    print $fh $inline{key} // '';
    close $fh;
    my $from_cert = `openssl x509 -noout -pubkey -in '$copy/client.crt' 2>&1`;
    my $from_key  = `openssl pkey -pubout -in '$copy/client.key' 2>&1`;
    is($from_key, $from_cert, 'and the key in the configuration is the key of that certificate');

    my $again = `OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-client-config $client 2>/dev/null`;
    my ($second) = $again =~ m{^<cert>\n(.*?)^</cert>$}ms;
    is($second, $inline{cert}, 'a second run prints the same certificate rather than issuing another');

    ok(!-e "/etc/openvpn/easy-rsa/pki/issued/$client.crt", 'and the real pki issued nothing');

    my $refused = system("OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-client-config server >/dev/null 2>&1");
    isnt($refused, 0, 'the script refuses to hand out the certificate of the server');

    my $listed = `OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-list-clients 2>&1`;
    like($listed, qr/^\Q$client\E\s+valid\s+\d{4}-\d\d-\d\d /m, 'openvpn-list-clients lists the new client as valid, with its expiry') or diag $listed;
    unlike($listed, qr/^server\s/m, 'and leaves out the certificate of the server');

    # A status file in the format that server.conf pins, as openvpn 2.6 writes it.
    open(my $sfh, '>', "$copy/status.log") or die "$copy/status.log: $!";
    print $sfh join("\n",
        'TITLE,OpenVPN 2.6',
        'HEADER,CLIENT_LIST,Common Name,Real Address,Virtual Address,Virtual IPv6 Address,Bytes Received,Bytes Sent,Connected Since,Connected Since (time_t),Username,Client ID,Peer ID,Data Channel Cipher',
        "CLIENT_LIST,$client,127.0.0.1:47238,10.8.0.2,,3940,3897,2026-10-01 02:46:35,1790822795,UNDEF,0,0,AES-256-GCM",
        'HEADER,ROUTING_TABLE,Virtual Address,Common Name,Real Address,Last Ref,Last Ref (time_t)',
        "ROUTING_TABLE,10.8.0.2,$client,127.0.0.1:47238,2026-10-01 02:46:35,1790822795",
        'END', '');
    close $sfh;
    $listed = `OPENVPN_EASYRSA_DIR='$copy' OPENVPN_STATUS_FILE='$copy/status.log' /usr/local/sbin/openvpn-list-clients 2>&1`;
    like($listed, qr/^\Q$client\E\s+valid\s.*\s10\.8\.0\.2$/m, 'and shows the tunnel address of a client that is connected') or diag $listed;

    # And take the client away again, in the copy.
    my $live_crl = slurp('/etc/openvpn/server/crl.pem');
    my $revoked  = `OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-revoke-client $client 2>&1`;
    is($?, 0, 'openvpn-revoke-client revokes the client') or diag $revoked;

    my $check = `openssl verify -crl_check -CRLfile '$copy/pki/crl.pem' -CAfile '$copy/pki/ca.crt' '$copy/client.crt' 2>&1`;
    like($check, qr/certificate revoked/, 'and the new revocation list names its certificate') or diag $check;

    $listed = `OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-list-clients 2>&1`;
    unlike($listed, qr/^\Q$client\E\s/m, 'a revoked client is no longer listed') or diag $listed;
    $listed = `OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-list-clients --all 2>&1`;
    like($listed, qr/^\Q$client\E\s+revoked\s/m, 'except by --all, as revoked') or diag $listed;
    is(slurp('/etc/openvpn/server/crl.pem'), $live_crl, 'while the list the server reads stays as it was');

    $refused = system("OPENVPN_EASYRSA_DIR='$copy' /usr/local/sbin/openvpn-revoke-client server >/dev/null 2>&1");
    isnt($refused, 0, 'the script refuses to revoke the certificate of the server');
}

# The revocation list.  Once it expires, openvpn refuses every client, so it
# must be in place, in date, and renewed.  Provisioner::Recipe::openvpn has the
# whole account.
like(slurp('/etc/openvpn/server/server.conf'), qr{^status-version 2$}m, 'the server writes its status in the format openvpn-list-clients reads');
like(slurp('/etc/openvpn/server/server.conf'), qr{^crl-verify /etc/openvpn/server/crl\.pem$}m, 'the server checks the revocation list');
is(slurp('/etc/openvpn/server/crl.pem'), slurp('/etc/openvpn/easy-rsa/pki/crl.pem'), 'and reads the one in the pki');
is((stat('/etc/openvpn/server/crl.pem'))[2] & 07777, 0600, 'which only root can read, as with the other files of the server');

my ($next) = `openssl crl -noout -nextupdate -in /etc/openvpn/server/crl.pem 2>&1` =~ /^nextUpdate=(.+)$/m;
my $expires = $next ? `date -d '$next' +%s 2>/dev/null` : '';
chomp $expires;
$expires = 0 unless $expires =~ /^\d+$/;
cmp_ok($expires, '>', time + 30 * 86400, 'the revocation list has more than 30 days left') or diag($next // 'no nextUpdate');

ok(-f '/etc/cron.d/openvpn-refresh-crl', 'and cron signs it again each day');
ok(-x '/usr/local/sbin/openvpn-revoke-client', 'the script that revokes a client is installed');

done_testing();
