#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

ok(-f '/usr/lib/systemd/system/[% domain %].service', 'systemd service unit exists');

my $status = `systemctl is-active [% domain %] 2>/dev/null`;
chomp $status;
is($status, 'active', 'tpsgi service is running');

# nginx proxies to this socket.  If the service runs without it, every request
# gets a 502.
my $sock = '[% install_dir %]/[% domain %]/run/tpsgi.sock';
ok(-S $sock, 'the application socket is there') or diag "no socket at $sock";

# The service user and its login group own the checkout, and nginx reads www
# and run through the www-data group.  See Provisioner::Recipe::tpsgi.
my $group = getgrgid( ( getpwnam('[% user %]') )[3] // -1 ) // '';
my %owner = (
    '.git'       => "[% user %]:$group",
    'bin'        => "[% user %]:$group",
    '.tpsgi.ini' => "[% user %]:$group",
    'www'        => '[% user %]:www-data',
    'run'        => '[% user %]:www-data',
    'log'        => "[% user %]:$group",
);
foreach my $name (sort keys %owner) {
    my @st = stat "[% install_dir %]/[% domain %]/$name";
    my $got = join ':', scalar getpwuid($st[4] // -1) // '', scalar getgrgid($st[5] // -1) // '';
    is($got, $owner{$name}, "$name is owned by $owner{$name}");
}

my $vhost = do { local (@ARGV, $/) = '/etc/nginx/sites-enabled/[% domain %].conf'; <> } // '';
like($vhost, qr{\Qserver unix:$sock\E}, 'and nginx has an upstream for it') or diag $vhost;

[% IF user != admin_user -%]
# servicesudo lets the service user restart its own units, and nothing else.
foreach my $unit (qw{[% domain %].service}) {
    system('runuser', '-u', '[% user %]', '--', 'sudo', '-n', '-l', '/usr/bin/systemctl', 'restart', $unit);
    is($? >> 8, 0, "[% user %] may restart $unit with sudo");
}
[% END -%]

done_testing();
