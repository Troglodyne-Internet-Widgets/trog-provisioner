#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $pdns = `systemctl is-active pdns 2>/dev/null`;
chomp $pdns;
is($pdns, 'active', 'pdns is running');

my $recursor = `systemctl is-active pdns-recursor 2>/dev/null`;
chomp $recursor;
is($recursor, 'active', 'pdns-recursor is running');

# The release train the recipe asked for.  This used to install from
# auth-master, PowerDNS's development branch, so guests ended up running
# 5.1.0~alpha1+master.380 -- whatever had landed on master that morning.
my $version = `pdns_server --version 2>&1`;
unlike($version, qr/alpha|beta|rc\d|master/i, 'pdns is a release, not a development build')
    or diag $version;

# And new enough for the API socket.  webserver-address takes a unix socket path
# only from 5.0.0; on 4.9 pdns_server will not start at all, saying "Unable to
# convert presentation address" -- to its own log, which is not the journal.
my ($major) = $version =~ m/(\d+)\.\d+\.\d+/;
ok($major && $major >= 5, "pdns is 5.x or newer, which the socket API needs (got $major)")
    or diag $version;

# Chrooted, with every path it opens named relative to that root.  The unit was
# given a bare --chroot, which takes a directory and had none, so pdns_server
# exited before logging anywhere.
my $exec = `systemctl show -p ExecStart --value pdns 2>/dev/null`;
like($exec, qr{--chroot=/var/spool/powerdns\b}, 'pdns chroots into its spool directory')
    or diag $exec;

my $domain_conf = do { local (@ARGV, $/) = '/etc/powerdns/pdns.d/sqlite.conf'; <> } // '';
like($domain_conf, qr{^gsqlite3-database=/zones\.db$}m,
    'the database is named relative to the chroot') or diag $domain_conf;

# And it is where that resolves to from outside.
my $zonedb = '/var/spool/powerdns/zones.db';
ok(-s $zonedb, 'which is /var/spool/powerdns/zones.db on the host');

# Whichever way this guest got its database -- loaded from the zonefile on a
# first build, or handed back the previous guest's on a rebuild -- it has to be
# answering for this domain by the end of it.  The rebuild is the case that used
# to come out empty, and the case the guard on the zone load can now break.
my $domain_rows = `sqlite3 '$zonedb' "SELECT COUNT(*) FROM domains WHERE name='[% domain %]'" 2>&1` // '';
chomp $domain_rows;
is($domain_rows, '1', 'the zone database answers for this domain, exactly once') or diag $domain_rows;

my $record_rows = `sqlite3 '$zonedb' "SELECT COUNT(*) FROM records r JOIN domains d ON d.id = r.domain_id WHERE d.name='[% domain %]'" 2>&1` // '';
chomp $record_rows;
ok($record_rows =~ m/^[0-9]+$/ && $record_rows > 0, "and has records for it ($record_rows)") or diag $record_rows;

# restore_state takes the salvage away when it puts it back, so one still
# sitting in the domain directory means it declined.  Declining is the right
# answer against a guest that already had its zones -- it is the wrong one while
# the salvage holds records this database has never seen, which is a rebuild
# that threw away every zone edit lexicon or DCV made since the last provision.
my $salvaged = '[% install_dir %]/[% domain %]/pdns/zones.db';
SKIP: {
    skip 'no previous guest was salvaged from', 1 unless -s $salvaged;
    my $was = `sqlite3 '$salvaged' 'SELECT COUNT(*) FROM records' 2>/dev/null` // '';
    my $now = `sqlite3 '$zonedb' 'SELECT COUNT(*) FROM records' 2>/dev/null` // '';
    chomp($was, $now);
    ok($was =~ m/^[0-9]+$/ && $now =~ m/^[0-9]+$/ && $now >= $was,
        "the live database kept the $was records the salvage had (it has $now)")
        or diag "salvage at $salvaged was never restored into $zonedb";
}

# The socket itself, which is what lexicon talks to.
my $api = do { local (@ARGV, $/) = '/etc/powerdns/pdns.d/api.conf'; <> } // '';
my ($sock) = $api =~ m/^webserver-address=(\S+)/m;
SKIP: {
    skip 'the API is not on a unix socket', 1 unless $sock && $sock =~ m{^/};
    # Named inside the chroot, so it appears under the spool from out here.
    my $onhost = $sock =~ m{^/var/spool/powerdns/} ? $sock : "/var/spool/powerdns$sock";
    ok(-S $onhost, "the API socket is at $onhost") or diag $api;
}

my $recursor_conf = do { local (@ARGV, $/) = '/etc/powerdns/recursor.conf'; <> } // '';
my $zones_file    = '/etc/powerdns/forward-zones';
my $zones         = do { local (@ARGV, $/) = $zones_file; <> } // '';

# Zones go in forward-zones-file, one per line, rather than into a fragment in
# recursor.d: the recursor refuses a file using `forward-zones+=` outright.
# templates/pdns.tt has the account.
like($recursor_conf, qr{^forward-zones-file=\Q$zones_file\E}m,
    'the recursor is pointed at a forward zones file') or diag $recursor_conf;
ok(-f $zones_file, 'and that file exists');

like($zones, qr/^\Q[% domain %]\E=127\.0\.0\.1:2500$/m,
    'this domain forwards to the authoritative server on 2500') or diag $zones;

# One line per zone, however many times this has been provisioned.
my %seen;
my @dupes = grep { $seen{$_}++ } grep { m/\S/ } split m/\n/, $zones;
is_deeply(\@dupes, [], 'no forward zone is listed twice') or diag $zones;

# And nothing left over from somebody checking that recursion worked.
unlike($zones, qr/^test\.test=/m, 'no hardcoded test.test forward zone') or diag $zones;

# Nothing should be dropping config fragments into recursor.d any more.
ok(!-e '/etc/powerdns/recursor.d/[% domain %].conf',
    'no per-domain fragment in recursor.d');

# The unit configure_pdns rewrites.  It used to end the command line with a
# bare --chroot, which takes a value and was given none, so pdns_server refused
# to start every time and the only thing said out loud was systemd's "Failed to
# start pdns.service".
my $execstart = `systemctl show -p ExecStart --value pdns 2>/dev/null`;
like($execstart, qr{/usr/sbin/pdns_server}, 'the pdns unit runs pdns_server') or diag $execstart;
unlike($execstart, qr/--chroot(?![=\w])/, 'and not with a --chroot that has no value')
    or diag $execstart;


# chroot(2) needs CAP_SYS_CHROOT, so a pdns_server the unit starts as User=pdns
# never enters the chroot -- and then every path in its configuration, all of
# which are written relative to that root, points somewhere on the real
# filesystem that either does not exist or is not its to write.
my $unit_user = `systemctl show -p User --value pdns 2>/dev/null`;
chomp $unit_user;
ok($unit_user eq 'root' || $unit_user eq '', 'pdns starts with the privilege it needs to chroot') or diag "User=$unit_user";

# Both sets, not just the bounding one: the ambient set is what the process
# actually starts holding, and a pdns that can chroot but cannot setuid spends
# its life failing to drop privileges once a second.
foreach my $set (qw{CapabilityBoundingSet AmbientCapabilities}) {
    my $caps = `systemctl show -p $set --value pdns 2>/dev/null`;
    like($caps, qr/cap_sys_chroot/i, "$set lets it chroot");
    like($caps, qr/cap_setuid/i,     "$set lets it drop privileges afterwards");
}

my $global_conf = do { local (@ARGV, $/) = '/etc/powerdns/pdns.d/00-global.conf'; <> } // '';
like($global_conf, qr/^setuid=pdns$/m, 'and gives it up itself once it is inside');
like($global_conf, qr/^setgid=pdns$/m, 'both halves of it');

# Which is the whole point: the API socket lands inside the chroot, where
# synczones and the patched lexicon look for it.
ok(-S '/var/spool/powerdns/api.sock', 'the API socket exists, so the webserver bound it')
    or diag `systemctl status pdns --no-pager -n 15 2>&1 | tail -8`;

# pdns runs as pdns and the payload arrives owned by the admin user, so a
# fragment moved into place and left alone is one pdns cannot read -- it falls
# back to the packaged defaults, binds 0.0.0.0:53 on top of the recursor, and
# exits.  Which looks like anything except a permissions problem.
foreach my $fragment (qw{00-global.conf sqlite.conf api.conf}) {
    my $path = "/etc/powerdns/pdns.d/$fragment";
    ok(-f $path, "$fragment is installed");
    my @st = stat $path;
    next unless @st;
    is(scalar getgrgid($st[5] // -1), 'pdns', "$fragment is group pdns");
    ok($st[2] & 0040, "$fragment is group readable, so pdns can actually read it");
}

# What the fragments are for: without them pdns takes the packaged default of
# 0.0.0.0:53, which is where the recursor already is.
my $ports = `ss -lnup 2>/dev/null`;
like($ports, qr/127\.0\.0\.1:2500/, 'pdns is on the port the recipe puts it on') or diag $ports;

done_testing();
