#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $pdns = `systemctl is-active pdns 2>/dev/null`;
chomp $pdns;
is($pdns, 'active', 'pdns is running');

my $recursor = `systemctl is-active pdns-recursor 2>/dev/null`;
chomp $recursor;
is($recursor, 'active', 'pdns-recursor is running');

# The release train the recipe asked for.  This used to install from
# auth-master, PowerDNS's development branch, so guests ended up running
# 5.1.0~alpha1+master.380 -- whatever had landed on master that morning.
my $version = `pdns_server --version 2>&1`;
unlike($version, qr/alpha|beta|rc\d|master/i, 'pdns is a release, not a development build')
    or diag $version;

my $recursor_conf = do { local (@ARGV, $/) = '/etc/powerdns/recursor.conf'; <> } // '';
my $zones_file    = '/etc/powerdns/forward-zones';
my $zones         = do { local (@ARGV, $/) = $zones_file; <> } // '';

# Zones go in forward-zones-file, one per line, rather than into a fragment in
# recursor.d.  The fragment said `forward-zones+=<domain>=...` and the recursor
# refused the whole file, every time: += wants a plain forward-zones to append
# to, and giving it one in recursor.conf ahead of include-dir did not help --
# the documentation offers += for the main configuration and says nothing about
# included files.
like($recursor_conf, qr{^forward-zones-file=\Q$zones_file\E}m,
    'the recursor is pointed at a forward zones file') or diag $recursor_conf;
ok(-f $zones_file, 'and that file exists');

like($zones, qr/^\Q[% domain %]\E=127\.0\.0\.1:2500$/m,
    'this domain forwards to the authoritative server on 2500') or diag $zones;

# One line per zone, however many times this has been provisioned.
my %seen;
my @dupes = grep { $seen{$_}++ } grep { m/\S/ } split m/\n/, $zones;
is_deeply(\@dupes, [], 'no forward zone is listed twice') or diag $zones;

# And nothing left over from somebody checking that recursion worked.
unlike($zones, qr/^test\.test=/m, 'no hardcoded test.test forward zone') or diag $zones;

# Nothing should be dropping config fragments into recursor.d any more.
ok(!-e '/etc/powerdns/recursor.d/[% domain %].conf',
    'no per-domain fragment in recursor.d');

# The unit configure_pdns rewrites.  It used to end the command line with a
# bare --chroot, which takes a value and was given none, so pdns_server refused
# to start every time and the only thing said out loud was systemd's "Failed to
# start pdns.service".
my $execstart = `systemctl show -p ExecStart --value pdns 2>/dev/null`;
like($execstart, qr{/usr/sbin/pdns_server}, 'the pdns unit runs pdns_server') or diag $execstart;
unlike($execstart, qr/--chroot(?![=\w])/, 'and not with a --chroot that has no value')
    or diag $execstart;

# The recursor forwards the domain to the authoritative server on 2500.  The
# address here was written 127.0.01.
my $recursor = do { local (@ARGV, $/) = '/etc/powerdns/recursor.d/[% domain %].conf'; <> } // '';
like($recursor, qr/forward-zones\+?=\Q[% domain %]\E=127\.0\.0\.1:2500/,
    'the recursor forwards the domain to 127.0.0.1:2500') or diag $recursor;

done_testing();
