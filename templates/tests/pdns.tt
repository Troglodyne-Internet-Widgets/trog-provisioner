#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $pdns = `systemctl is-active pdns 2>/dev/null`;
chomp $pdns;
is($pdns, 'active', 'pdns is running');

my $recursor = `systemctl is-active pdns-recursor 2>/dev/null`;
chomp $recursor;
is($recursor, 'active', 'pdns-recursor is running');

# The release train the recipe asked for.  This used to install from
# auth-master, PowerDNS's development branch, so guests ended up running
# 5.1.0~alpha1+master.380 -- whatever had landed on master that morning.
my $version = `pdns_server --version 2>&1`;
unlike($version, qr/alpha|beta|rc\d|master/i, 'pdns is a release, not a development build')
    or diag $version;

my $recursor_conf = do { local (@ARGV, $/) = '/etc/powerdns/recursor.conf'; <> } // '';

# One line per configured forward zone, however many times this has been
# provisioned.  The line used to be appended unconditionally.
my %seen;
my @dupes = grep { $seen{$_}++ } ($recursor_conf =~ m/^(forward-zones\+?=.*)$/gm);
is_deeply(\@dupes, [], 'no forward-zone line appears twice') or diag $recursor_conf;

# Every domain appends its own forward zone with += from a file in recursor.d,
# and the recursor refuses the whole file when there is no plain forward-zones
# for it to append to -- "could not be parsed", said only to syslog.
like($recursor_conf, qr/^forward-zones=/m, 'there is a base forward-zones setting to append to')
    or diag $recursor_conf;

# And it comes before include-dir.  The recursor reads that directory where the
# line appears, so a base after it is too late for the files it pulled in -- the
# setting was present and the recursor still refused the per-domain file, which
# is why asserting it exists was not enough.
my @lines = split m/\n/, $recursor_conf;
my ($base)    = grep { $lines[$_] =~ m/^forward-zones=/ } 0 .. $#lines;
my ($include) = grep { $lines[$_] =~ m/^include-dir=/ }   0 .. $#lines;
SKIP: {
    skip 'no include-dir in recursor.conf', 1 unless defined $include;
    ok(defined $base && $base < $include, 'and it comes before include-dir')
        or diag "forward-zones at line $base, include-dir at line $include";
}

# And nothing left over from somebody checking that recursion worked.
unlike($recursor_conf, qr/^forward-zones=test\.test=/m,
    'no hardcoded test.test forward zone') or diag $recursor_conf;

# The unit configure_pdns rewrites.  It used to end the command line with a
# bare --chroot, which takes a value and was given none, so pdns_server refused
# to start every time and the only thing said out loud was systemd's "Failed to
# start pdns.service".
my $execstart = `systemctl show -p ExecStart --value pdns 2>/dev/null`;
like($execstart, qr{/usr/sbin/pdns_server}, 'the pdns unit runs pdns_server') or diag $execstart;
unlike($execstart, qr/--chroot(?![=\w])/, 'and not with a --chroot that has no value')
    or diag $execstart;

# The recursor forwards the domain to the authoritative server on 2500.  The
# address here was written 127.0.01.
my $recursor = do { local (@ARGV, $/) = '/etc/powerdns/recursor.d/[% domain %].conf'; <> } // '';
like($recursor, qr/forward-zones\+?=\Q[% domain %]\E=127\.0\.0\.1:2500/,
    'the recursor forwards the domain to 127.0.0.1:2500') or diag $recursor;

done_testing();
