#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $ufw_status = `ufw status 2>/dev/null | head -1`;
chomp $ufw_status;
like($ufw_status, qr/active/i, 'ufw is active');

my $rules = `ufw status verbose 2>/dev/null`;
like($rules, qr/OpenSSH/, 'ssh is allowed at all') or diag $rules;

# But not with ufw's own limit, which is six connections in thirty seconds.  A
# provision opens far more than that.  The hashlimit below limits ssh like every
# other port, at the rate in rate_limits.
unlike($rules, qr/^\s*OpenSSH\s+LIMIT/mi, 'and not by ufw\'s six-in-thirty limit') or diag $rules;

# Nor any other profile.  ufw keys a rule on its action and its ports, so an
# allow does not replace a limit that an older provision left.  setup-ufw-rules
# deletes those limits.
unlike($rules, qr/\bLIMIT\b/, 'nothing at all is on ufw\'s limit any more') or diag $rules;

# One page load opens more than the six connections that ufw's limit allows.
foreach my $web (grep { m/nginx|apache/i } split m/\n/, `ufw app list 2>/dev/null`) {
    $web =~ s/^\s+|\s+$//g;
    next unless length $web;
    unlike($rules, qr/^\s*\Q$web\E\s+LIMIT/mi, "$web is not rate limited");
}

# The real rate limits, which setup-ufw-ratelimits writes into before.rules.
# That script says why they are there, and not in ufw's `limit` or user.rules.
my $before = do { local (@ARGV, $/) = '/etc/ufw/before.rules'; <> } // '';

# With the protocol, not only the port.  A rule for the wrong protocol matches
# none of the traffic, but before.rules still names the port.  So an assertion
# on the port alone passes when the limit does nothing.
my %limits = (
[% FOR spec IN rate_limits.keys().sort() %]    '[% spec %]' => [% rate_limits.$spec %],
[% END -%]
);

# ssh by name, not only through the loop below.  A loop over the limits that
# this test gets cannot see a limit that is missing from them.
like($before, qr/-p tcp --dport 22 .*--hashlimit-above \d+\/sec/,
    'ssh is rate limited, whatever else the guest listens on') or diag $before;

foreach my $spec (sort keys %limits) {
    my ($port, $proto) = split m{/}, $spec;
    $proto //= 'tcp';
    like($before, qr/-p \Q$proto\E --dport \Q$port\E .*--hashlimit-above \Q$limits{$spec}\E\/sec/,
        "$proto port $port is rate limited at $limits{$spec} a second") or diag $before;
}

# An exemption must be in a chain of our own, not in ufw-before-input.
# setup-ufw-ratelimits says why.  Ask iptables, because a working connection
# proves nothing.  ESTABLISHED is accepted earlier in the chain, so an
# exemption in the wrong chain refuses only new connections.
my $before_chain = `iptables -S ufw-before-input 2>/dev/null`;

unlike($before_chain, qr/^-A ufw-before-input -s \S+ -j RETURN/m,
    'no exemption returns straight out of ufw-before-input, past the allow rules')
    or diag $before_chain;

like($before_chain, qr/-j trog-ratelimit\b.*-j ufw-user-input\b/s,
    'the rate limits are entered before the allow rules and do not replace them')
    or diag $before_chain;

my $limit_chain = `iptables -S trog-ratelimit 2>/dev/null`;

[% FOR net IN admin_networks %]
# Named in admin_networks, so the limits let it through and do not count it.
like($limit_chain, qr{-s \Q[% net %]\E(?:/32)? -j RETURN}, '[% net %] is exempt from the rate limits')
    or diag $limit_chain;
[% END -%]

# Once, however many times the guest was provisioned.
my $blocks = () = $before =~ m/^# BEGIN trog-provisioner rate limits$/gm;
is($blocks, 1, 'the rate limit block appears exactly once');

# After the rules that accept loopback and established traffic, so that the
# limits do not count that traffic.
my ($lo) = $before =~ m/\A(.*?)-A ufw-before-input -i lo/s;
unlike($lo // '', qr/BEGIN trog-provisioner rate limits/,
    'and comes after the loopback accept, not before it');

my $active = `ufw status 2>/dev/null`;
like($active, qr/Status:\s*active/, 'ufw is still active after the edit') or diag $active;

# But "active" is not "loaded".  If iptables-restore rejects before.rules, it
# loads no rule from the file, not even the loopback and ESTABLISHED accepts.
# ufw still reports itself active, with one rule in the chain.
my $reload = `ufw reload 2>&1`;
unlike($reload, qr/Problem running|RULE_APPEND failed|iptables-restore/i,
    'before.rules is actually accepted by iptables, not merely present') or diag $reload;

my $chain = `iptables -L ufw-before-input -n 2>/dev/null`;
like($chain, qr/^ACCEPT\s+\S+\s+--\s+0\.0\.0\.0\/0\s+0\.0\.0\.0\/0\s*$/m,
    'the loopback accept survived, so the chain really did load') or diag $chain;

# What the loopback accept protects: a connection to a local service.
my $loopback = system('timeout 5 bash -c "echo > /dev/tcp/127.0.0.1/22" 2>/dev/null');
is($loopback, 0, 'a loopback connection to an open port is not dropped');

done_testing();
