use strict;
use warnings;

use Test::More;
use IO::Socket::INET();

# The point of this file is the connection test below.
#
# From the guest, a destination that listens and one that does not look the
# same.  rsyslog queues, retries, suspends the action and discards the messages.
# It logs nothing about any of it.  Provisioner::Recipe::logshipper has the
# whole account.

my $target   = '[% target %]';
my $port     = '[% port %]';
my $protocol = '[% protocol %]';
my $conf     = '/etc/rsyslog.d/10-logshipper.conf';

[% IF target %]
subtest 'the forwarder is installed and says where it is sending' => sub {
    ok( -f $conf, "$conf exists" ) or return;

    my $body = do { open( my $fh, '<', $conf ) or die $!; local $/; <$fh> };
    like( $body, qr/\Qtarget="$target"\E/,     'naming the destination it was configured with' );
    like( $body, qr/\Qport="$port"\E/,         'on the configured port' );
    like( $body, qr/\Qprotocol="$protocol"\E/, 'over the configured protocol' );
};

subtest 'rsyslog accepts the configuration' => sub {

    # -N1 parses everything under /etc/rsyslog.d and starts nothing.  So this
    # catches a directive that the rsyslog of this distribution does not know.
    # Otherwise that shows up as a service that does not start, after the build.
    my $out = `rsyslogd -N1 2>&1`;
    unlike( $out, qr/error|could not|unknown|invalid/i, 'rsyslogd -N1 finds nothing to complain about' )
      or diag $out;
};

subtest 'and something is actually listening at the other end' => sub {
[% IF protocol == 'udp' %]

    # UDP cannot answer this question.  There is no handshake, so a socket to a
    # dead port succeeds and tells you nothing.  A note that says so is better
    # than an assertion that cannot fail.
    ok( 1, 'nothing to connect to over UDP; this guest cannot tell whether the destination exists' );
    diag "protocol is udp, so delivery is unverifiable from here -- use tcp if you want this checked";
[% ELSE %]
    my $sock = IO::Socket::INET->new( PeerAddr => $target, PeerPort => $port, Proto => 'tcp', Timeout => 10 );
    ok( $sock, "$target:$port accepts a connection" )
      or diag "Could not reach $target:$port -- $!.  rsyslog will queue, retry, suspend and then drop every message, silently, so nothing else on this guest will ever tell you.";
    close($sock) if $sock;
[% END %]
};
[% ELSE %]
subtest 'a guest that is its own destination forwards nothing' => sub {

    # The usual way to turn this on for a fleet is one _base block, and that
    # block also covers the collector.  Forwarding to its own listener makes a
    # loop, so the recipe installs nothing here.
    ok( !-f $conf, "no forwarder at $conf" );
};
[% END %]

done_testing();
