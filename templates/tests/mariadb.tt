#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# The package must be the exact release that apt pinned.  Binlogs restore only
# onto the version that wrote them.
my $installed = `dpkg-query -W -f='\${Version}' mariadb-server 2>/dev/null`;
chomp $installed;
like($installed, qr/\Q[% version %]\E/, 'mariadb-server is the release this recipe pinned')
    or diag "installed: '$installed'";

# It must come from the pin, not from Ubuntu.  Ubuntu ships its own version,
# which wins on version order over any older release.
my $origin = `apt-cache policy mariadb-server 2>/dev/null`;
like($origin, qr/archive\.mariadb\.org/, 'and came from the pinned repository') or diag $origin;

my $status = `systemctl is-active mariadb 2>/dev/null`;
chomp $status;
is($status, 'active', 'mariadb is running');

ok(-d '/var/lib/mysql', 'the packaged data directory exists');
ok(-f '/var/lib/mysql/ibdata1', 'and was initialized');

# The drop-in must be where the packaged server reads it, and the server must
# read it.  A drop-in in the wrong directory looks applied but is not.
ok(-f '/etc/mysql/mariadb.conf.d/60-provisioner.cnf', 'the config drop-in is in place');
my $binlog = `mariadb -sN -e "SELECT \@\@log_bin" 2>/dev/null`;
chomp $binlog;
is($binlog, '1', 'and the server read it: binlogs are on, which the pinning exists for')
    or diag "log_bin=$binlog";

# The drop-in must be in place before the schema loads.  If not, the dump loads
# under the sql_mode of the package and outside the binlog.  This asks the
# running server for its sql_mode.  t/recipes.t tests the order in the recipe.
my $sqlmode = `mariadb -sN -e "SELECT \@\@sql_mode" 2>/dev/null`;
like($sqlmode, qr/NO_ENGINE_SUBSTITUTION/, 'and the sql_mode the dump loaded under is ours')
    or diag "sql_mode=$sqlmode";

# Root over the socket.  Everything here connects that way, and the
# secure-installation SQL keeps it.
my $whoami = `mariadb -sN -e "SELECT CURRENT_USER()" 2>/dev/null`;
chomp $whoami;
like($whoami, qr/^root\@localhost$/, 'root still authenticates over the unix socket');

my $dbs = `mariadb -sN -e "SHOW DATABASES" 2>/dev/null`;
ok(length $dbs, 'the server answers a query') or diag $dbs;

# The credentials files.  --defaults-file replaces the defaults, so each file
# must name the socket as well as the account.  Run as the owner.  If not,
# unix_socket auth answers for the wrong identity and the test passes anyway.
sub connects_as {
    my ($who, $sql) = @_;
    my @pw = getpwnam($who) or return;
    my $out = `setpriv --reuid=$pw[2] --regid=$pw[3] --clear-groups mariadb --defaults-file='$pw[7]/.my.cnf' -sN -e '$sql' 2>&1`;
    chomp $out;
    return $out;
}

# Root and the admin get full access.
foreach my $who (qw{root [% admin_user %]}) {
    my @pw = getpwnam($who) or do { fail("no $who account"); next };
    my $cnf = "$pw[7]/.my.cnf";

    ok(-f $cnf, "$who has a .my.cnf") or next;
    is(sprintf('%04o', (stat $cnf)[2] & 07777), '0600', 'and it is 0600');
    is((stat $cnf)[4], $pw[2], "and owned by $who");
    is(connects_as($who, 'SELECT CURRENT_USER()'), 'root@localhost', "and $who connects with full access")
        or diag connects_as($who, 'SELECT 1');
}

[% IF user != admin_user %]
# This recipe grants the service account nothing.  The dump or another recipe
# does that.  So this makes sure that the file is well formed and reaches the
# server as the right account.  "Access denied" for [% user %] means that
# mariadb parsed the file, found the socket and tried.  A malformed file fails
# differently, and this catches that failure.
my @svc = getpwnam('[% user %]');
ok(scalar @svc, 'there is a [% user %] account');
SKIP: {
    skip 'no [% user %] account', 4 unless @svc;
    my $cnf = "$svc[7]/.my.cnf";

    ok(-f $cnf, '[% user %] has a .my.cnf');
    is(sprintf('%04o', (stat $cnf)[2] & 07777), '0600', 'and it is 0600');
    is((stat $cnf)[4], $svc[2], 'and owned by [% user %]');

    my $out = connects_as('[% user %]', 'SELECT 1') // '';
    ok($out eq '1' || $out =~ m/Access denied for user '\Q[% user %]\E'/,
       'and it reaches the server as [% user %], granted or not')
        or diag $out;
}
[% END %]

# The packaged build links against liburing, so InnoDB can use io_uring.
my $lib = `ldd \$(command -v mariadbd || echo /usr/sbin/mariadbd) 2>/dev/null`;
like($lib, qr/liburing/, 'mariadbd is linked against liburing') or diag $lib;

# The round trip.  remote_files salvages /var/backups/mysql from the guest that
# this one replaces.  The data recipe puts it back under the domain directory.
# What follows takes a real backup, drops a database, and restores it.
ok(-x '/usr/local/sbin/mariadb-backup.sh', 'the backup is installed');
ok(-x '/usr/local/sbin/mariadb-restore.sh', 'and so is the restore that reads what it wrote');

sub sql {
    my ($query, $db) = @_;
    $db //= q{};
    my $out = `mariadb -sN $db -e "$query" 2>&1`;
    chomp $out;
    return $out;
}

my $probe = 'restore_probe';
system(qq{mariadb -e "DROP DATABASE IF EXISTS $probe"});
system(qq{mariadb -e "CREATE DATABASE $probe"});
system(qq{mariadb $probe -e "CREATE TABLE t (v VARCHAR(32))"});
system(qq{mariadb $probe -e "INSERT INTO t VALUES ('salvaged')"});

is(system('/usr/local/sbin/mariadb-backup.sh > /tmp/mariadb-backup.log 2>&1'), 0, 'the nightly backup runs')
    or diag `cat /tmp/mariadb-backup.log`;

my @dumps = sort glob '/var/backups/mysql/*';
ok(scalar @dumps, 'and left a dump behind') or diag `ls -la /var/backups/mysql`;
my $newest = $dumps[-1] // '';
ok(-f "$newest/complete", 'which says it finished, since nothing will restore one that does not');
ok(-f "$newest/$probe/t.sql.gz", 'with the probe database in it');

# The rebuild.  The database is gone, and only the salvage holds its contents.
system(qq{mariadb -e "DROP DATABASE $probe"});
is(system('/usr/local/sbin/mariadb-restore.sh /var/backups/mysql > /tmp/mariadb-restore.log 2>&1'), 0, 'the restore runs')
    or diag `cat /tmp/mariadb-restore.log`;
is(sql('SELECT v FROM t', $probe), 'salvaged', 'and the database nothing else could have brought back is back');

# On a guest that is still running, the restore does not write over a database
# that exists, whatever the age or size of the dump.
system(qq{mariadb $probe -e "UPDATE t SET v='since the dump'"});
is(system('/usr/local/sbin/mariadb-restore.sh /var/backups/mysql > /tmp/mariadb-restore.log 2>&1'), 0, 'restoring again is not an error')
    or diag `cat /tmp/mariadb-restore.log`;
is(sql('SELECT v FROM t', $probe), 'since the dump', 'and it left the live database alone');

# A dump with no `complete` is not restored.  mariadb-restore.sh explains why.
my $half = '/tmp/half-a-dump';
system("rm -rf $half && mkdir -p $half/20200101-000000/never_finished");
system("cp $newest/$probe/t.sql.gz $half/20200101-000000/never_finished/");
is(system("/usr/local/sbin/mariadb-restore.sh $half > /tmp/mariadb-restore.log 2>&1"), 0, 'an unfinished dump is not an error')
    or diag `cat /tmp/mariadb-restore.log`;
is(sql("SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='never_finished'"), '',
   'but it is not restored either');

system(qq{mariadb -e "DROP DATABASE IF EXISTS $probe"});
system("rm -rf $half");

done_testing();
