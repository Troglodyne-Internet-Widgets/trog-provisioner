#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# From MariaDB's own apt repository at the exact release, not the generic
# bintar.  The version is the whole point -- binlogs restore only onto the one
# that wrote them -- so check the package, which is the thing apt pinned.
my $installed = `dpkg-query -W -f='\${Version}' mariadb-server 2>/dev/null`;
chomp $installed;
like($installed, qr/\Q[% version %]\E/, 'mariadb-server is the release this recipe pinned')
    or diag "installed: '$installed'";

# And that it came from the pin rather than from Ubuntu, which ships its own
# and would win on version order for any release older than theirs.
my $origin = `apt-cache policy mariadb-server 2>/dev/null`;
like($origin, qr/archive\.mariadb\.org/, 'and came from the pinned repository') or diag $origin;

my $status = `systemctl is-active mariadb 2>/dev/null`;
chomp $status;
is($status, 'active', 'mariadb is running');

# The packaged layout, rather than the /opt/mysql the bintar needed.
ok(-d '/var/lib/mysql', 'the packaged data directory exists');
ok(-f '/var/lib/mysql/ibdata1', 'and was initialised');
ok(!-e '/opt/mysql', 'and nothing was hand-rolled under /opt') or diag `ls -la /opt`;

# Our configuration went in as a drop-in the packaged server reads, and it read
# it -- a drop-in in the wrong directory is a setting that looks applied.
ok(-f '/etc/mysql/mariadb.conf.d/60-provisioner.cnf', 'the config drop-in is in place');
my $binlog = `mariadb -sN -e "SELECT \@\@log_bin" 2>/dev/null`;
chomp $binlog;
is($binlog, '1', 'and the server read it: binlogs are on, which the pinning exists for')
    or diag "log_bin=$binlog";

# root over the socket, which is how everything here connects and what the
# secure-installation SQL was careful to keep.
my $whoami = `mariadb -sN -e "SELECT CURRENT_USER()" 2>/dev/null`;
chomp $whoami;
like($whoami, qr/^root\@localhost$/, 'root still authenticates over the unix socket');

# The dump the recipe was given actually loaded.
my $dbs = `mariadb -sN -e "SHOW DATABASES" 2>/dev/null`;
ok(length $dbs, 'the server answers a query') or diag $dbs;

# The reason for moving off the bintar: this build can use io_uring, where the
# generic tarball is linked against libaio and never could.
my $lib = `ldd \$(command -v mariadbd || echo /usr/sbin/mariadbd) 2>/dev/null`;
like($lib, qr/liburing/, 'mariadbd is linked against liburing') or diag $lib;

done_testing();
