#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use File::Find ();

# What the next fetch finds.  The fragment gives the whole mail store to
# dovecot:dovecot.
my $store = '/mail/[% domain %]';
my $dovecot_gid = (getgrnam('dovecot'))[2];
ok(defined $dovecot_gid, 'dovecot has a group');

SKIP: {
    skip 'no dovecot group to check the mail store against', 4 unless defined $dovecot_gid;

    my @st = stat $store;
    ok(scalar @st, "$store exists") or skip 'no mail store', 3;
    is($st[5], $dovecot_gid, 'the mail store is still grouped to dovecot, not the admin user');
    ok($st[2] & 02000, 'and setgid, so what dovecot creates in it inherits that group');
    is($st[2] & 0007, 0, 'and is closed to everybody else on the guest');
}

# Every maildir and message under the store, because a fetch walks the whole
# tree.  Nothing in the tree is open wider than the top of it.
my @exposed;
File::Find::find({ no_chdir => 1, wanted => sub {
    my @f = lstat $File::Find::name or return;
    return if -l _;
    push @exposed, $File::Find::name if $f[2] & 0007;
} }, $store);
is(scalar @exposed, 0, 'and nothing under the mail store is readable by anybody else')
    or diag join("\n", @exposed);

# And the walk itself: the admin user cannot do it.
my $gripes = `sudo -u '[% admin_user %]' find '$store' -print 2>&1 >/dev/null`;
isnt($gripes, '', 'the admin user can no longer walk the mail store');

# The DKIM key, and the staged copy of it.  remote_files names the staged copy,
# not the original.  Provisioner::Recipe::mail says why.  restores() takes the
# key back from exactly this path.
ok(-s '/etc/opendkim/keys/[% domain %]/default.private', 'this domain has a DKIM signing key');
ok(!-e '/mail/keys/keys', 'staged once, rather than into itself');
SKIP: {
    my $staged = '/mail/keys/[% domain %]/default.private';
    ok(-s $staged, 'and a copy of it where the next fetch will look') or skip 'nothing staged to read', 2;
    isnt(system('sudo', '-u', '[% admin_user %]', 'test', '-r', $staged), 0, 'which the admin user can no longer read');
    my $mode = (stat $staged)[2] & 07777;
    is($mode & 0077, 0, sprintf('and nobody but root can (%04o)', $mode));
}

my $postfix = `systemctl is-active postfix 2>/dev/null`;
chomp $postfix;
is($postfix, 'active', 'postfix is running');

my $dovecot = `systemctl is-active dovecot 2>/dev/null`;
chomp $dovecot;
is($dovecot, 'active', 'dovecot is running');

# What postfix makes of its configuration.  That it runs says nothing, because
# it keeps the configuration it last accepted.  Warnings are normal here, for
# example an unused parameter.  Only a fatal or an error means that postfix
# does not work with its configuration.
my $check = `postfix check 2>&1`;
unlike($check, qr/^(?:postfix: )?(?:fatal|error):/mi, 'postfix accepts its configuration')
    or diag $check;

# And dovecot, the same question.
my $doveconf_out = `doveconf -n 2>&1 >/dev/null`;
unlike($doveconf_out, qr/^(?:doveconf: )?(?:Fatal|Error):/mi, 'dovecot accepts its configuration')
    or diag $doveconf_out;

# The aliases map, which newaliases builds from /etc/aliases.  sendmail and
# postfix both refuse a line that starts with a bare colon.  An empty user
# makes one.
my $aliases = do { local (@ARGV, $/) = '/etc/aliases'; <> } // '';
unlike($aliases, qr/^\s*:/m, 'no alias line begins with a colon') or diag $aliases;
like($aliases, qr/^root:/m,  'root has an alias, so its mail goes somewhere');

ok(-s '/etc/aliases.db', 'newaliases built the alias database');

# The address classes.  If a virtual mailbox domain is also in mydestination,
# local delivery wins, and its mail reaches no mailbox.  The hostname of this
# guest is the domain it hosts, so the main.cf of the package starts with that
# overlap.  The configuration must remove it.
my %local_domains = map { $_ => 1 } grep { length } split(m/[,\s]+/, `postconf -h mydestination 2>/dev/null` // '');
my @virtual_domains = grep { length } split(m/[,\s]+/, `postconf -h virtual_mailbox_domains 2>/dev/null` // '');
my @in_both = grep { $local_domains{$_} } @virtual_domains;
is(scalar @in_both, 0, 'no domain is both a local and a virtual mailbox domain')
    or diag "in both: @in_both";
ok(scalar @virtual_domains, 'and there are virtual mailbox domains to have checked');

# Every table that main.cf names must exist.  If not, postfix logs an open
# failure and the lookup finds nothing.  Each domain has its own tables.
foreach my $param (qw{virtual_mailbox_maps virtual_alias_maps smtpd_sender_login_maps}) {
    my @tables = grep { length } split(m/[,\s]+/, `postconf -h $param 2>/dev/null` // '');
    ok(scalar @tables, "$param names at least one table");
    foreach my $table (@tables) {
        my ($path) = $table =~ m{^[a-z]+:(/.*)$} or next;
        ok(-f $path, "$param: $path is there");
    }
}

# An authenticated user can send only as an address it owns.  The check must
# come before the permit that ends the list.
my $sender_list = `postconf -h smtpd_sender_restrictions 2>/dev/null` // '';
my @sender_order = grep { length } split(m/[,\s]+/, $sender_list);
my ($mismatch) = grep { $sender_order[$_] eq 'reject_authenticated_sender_login_mismatch' } 0 .. $#sender_order;
my ($sasl_permit) = grep { $sender_order[$_] eq 'permit_sasl_authenticated' } 0 .. $#sender_order;
ok(defined $mismatch, 'authenticated senders are checked against smtpd_sender_login_maps') or diag $sender_list;
ok(defined $sasl_permit && defined $mismatch && $mismatch < $sasl_permit,
   'ahead of the permit that would otherwise end the list') or diag $sender_list;

# And the map answers for the accounts of this domain.  If it misses an
# address, the owner cannot send from it.
my $login_maps = `postconf -h smtpd_sender_login_maps 2>/dev/null` // '';
chomp $login_maps;
[% FOR name IN names.keys().sort() %]
SKIP: {
    skip 'no sender login map', 1 unless $login_maps;
    my $owner = `postmap -q '[% name %]\@[% domain %]' $login_maps 2>&1`;
    chomp $owner;
    is($owner, '[% name %]@[% domain %]', '[% name %]@[% domain %] owns its own address') or diag $owner;
}
[% END %]
# The mailboxes that the recipe told doveadm to make.  doveadm looks up an
# account in the passwd-file userdb, which uses the full address as its key.
[% FOR name IN names.keys().sort() %]
[% IF names.$name.mailboxes.size() %]
{
    my $boxes = `doveadm mailbox list -u '[% name %]\@[% domain %]' 2>&1`;
[% FOR box IN names.$name.mailboxes %]
    like($boxes, qr/^\Q[% box %]\E$/m, '[% name %] has the mailbox [% box %]') or diag $boxes;
[% END %]
}
[% END %]
[% END %]
# install_dkim_records publishes the key into a zone this guest serves itself,
# once for each selector however many times the guest has been provisioned.
SKIP: {
    my $zones = '/var/spool/powerdns/zones.db';
    skip 'this guest serves no zones with pdns', 2 unless -f $zones;
    my $served = `sqlite3 $zones "SELECT count(*) FROM domains WHERE name='[% domain %]'" 2>&1`;
    chomp $served;
    skip 'this guest does not serve the zone for [% domain %]', 2 unless $served;
    foreach my $selector (qw{default mail}) {
        my $count = `sqlite3 $zones "SELECT count(*) FROM records WHERE name='$selector._domainkey.[% domain %]' AND type='TXT'" 2>&1`;
        chomp $count;
        is($count, 1, "one DKIM record for the $selector selector");
    }
}
done_testing();
