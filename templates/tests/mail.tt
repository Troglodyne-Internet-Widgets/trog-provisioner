#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use File::Find ();
use JSON::PP ();

# What the next fetch finds.  The fragment gives the whole mail store to
# dovecot:dovecot.
my $store = '/mail/[% domain %]';
my $dovecot_gid = (getgrnam('dovecot'))[2];
ok(defined $dovecot_gid, 'dovecot has a group');

SKIP: {
    skip 'no dovecot group to check the mail store against', 4 unless defined $dovecot_gid;

    my @st = stat $store;
    ok(scalar @st, "$store exists") or skip 'no mail store', 3;
    is($st[5], $dovecot_gid, 'the mail store is still grouped to dovecot, not the admin user');
    ok($st[2] & 02000, 'and setgid, so what dovecot creates in it inherits that group');
    is($st[2] & 0007, 0, 'and is closed to everybody else on the guest');
}

# Every maildir and message under the store, because a fetch walks the whole
# tree.  Nothing in the tree is open wider than the top of it.
my @exposed;
File::Find::find({ no_chdir => 1, wanted => sub {
    my @f = lstat $File::Find::name or return;
    return if -l _;
    # dovecot makes this marker 0444, and it is empty.
    return if -z _ && $File::Find::name =~ m{/dovecot-uidvalidity\.[0-9a-f]+\z};
    push @exposed, $File::Find::name if $f[2] & 0007;
} }, $store);
is(scalar @exposed, 0, 'and nothing under the mail store is readable by anybody else')
    or diag join("\n", @exposed);

# And the walk itself: the admin user cannot do it.
my $gripes = `sudo -u '[% admin_user %]' find '$store' -print 2>&1 >/dev/null`;
isnt($gripes, '', 'the admin user can no longer walk the mail store');

# The DKIM key, and the staged copy of it.  remote_files names the staged copy,
# not the original.  Provisioner::Recipe::mail says why.  restores() takes the
# key back from exactly this path.
ok(-s '/etc/opendkim/keys/[% domain %]/default.private', 'this domain has a DKIM signing key');

# The tables that opendkim reads are the rows of every domain on the guest.  If
# the domain built last replaced them, the other domains would go out unsigned.
{
    my $keys = do { local (@ARGV, $/) = '/etc/opendkim/KeyTable'; <> } // '';
    like($keys, qr{^\Q[% domain %]\E\s+\Q[% domain %]\E:default:}m, 'opendkim has the key of [% domain %]') or diag $keys;

    # Of every domain on the guest, because the target of this domain chmods
    # the whole of /etc/opendkim.
    my $open = `find /etc/opendkim/keys -type f -perm /077 2>&1`;
    is($open, '', 'and no key on the guest is readable by anyone but opendkim') or diag $open;

    my $subject = 'dkim probe of the guest tests';
    open( my $mail, '|-', '/usr/sbin/sendmail', '-oi', '-f', 'postmaster@[% domain %]', 'catchall@[% domain %]' ) or die "sendmail: $!";
    print {$mail} "From: postmaster\@[% domain %]\nTo: catchall\@[% domain %]\nSubject: $subject\n\nprobe\n";
    close($mail) or die "sendmail exited $?";

    my $headers = '';
    foreach ( 1 .. 60 ) {
        $headers = `doveadm fetch -u 'catchall\@[% domain %]' hdr mailbox INBOX subject '$subject' 2>&1`;
        last if $headers =~ m/\S/;
        sleep 1;
    }
    like($headers, qr/^DKIM-Signature:.*\bd=\Q[% domain %]\E;/msx, 'and signs the mail of [% domain %]') or diag $headers;
    system('doveadm', 'expunge', '-u', 'catchall@[% domain %]', 'mailbox', 'INBOX', 'subject', $subject);
}
ok(!-e '/mail/keys/keys', 'staged once, rather than into itself');
SKIP: {
    my $staged = '/mail/keys/[% domain %]/default.private';
    ok(-s $staged, 'and a copy of it where the next fetch will look') or skip 'nothing staged to read', 2;
    isnt(system('sudo', '-u', '[% admin_user %]', 'test', '-r', $staged), 0, 'which the admin user can no longer read');
    my $mode = (stat $staged)[2] & 07777;
    is($mode & 0077, 0, sprintf('and nobody but root can (%04o)', $mode));
}

my $postfix = `systemctl is-active postfix 2>/dev/null`;
chomp $postfix;
is($postfix, 'active', 'postfix is running');

my $dovecot = `systemctl is-active dovecot 2>/dev/null`;
chomp $dovecot;
is($dovecot, 'active', 'dovecot is running');

# What postfix makes of its configuration.  That it runs says nothing, because
# it keeps the configuration it last accepted.  Warnings are normal here, for
# example an unused parameter.  Only a fatal or an error means that postfix
# does not work with its configuration.
my $check = `postfix check 2>&1`;
unlike($check, qr/^(?:postfix: )?(?:fatal|error):/mi, 'postfix accepts its configuration')
    or diag $check;

# And dovecot, the same question.
my $doveconf_out = `doveconf -n 2>&1 >/dev/null`;
unlike($doveconf_out, qr/^(?:doveconf: )?(?:Fatal|Error):/mi, 'dovecot accepts its configuration')
    or diag $doveconf_out;

# The aliases map, which newaliases builds from /etc/aliases.  sendmail and
# postfix both refuse a line that starts with a bare colon.  An empty user
# makes one.
my $aliases = do { local (@ARGV, $/) = '/etc/aliases'; <> } // '';
unlike($aliases, qr/^\s*:/m, 'no alias line begins with a colon') or diag $aliases;
like($aliases, qr/^root:/m,  'root has an alias, so its mail goes somewhere');

ok(-s '/etc/aliases.db', 'newaliases built the alias database');

# The address classes.  If a virtual mailbox domain is also in mydestination,
# local delivery wins, and its mail reaches no mailbox.  The hostname of this
# guest is the domain it hosts, so the main.cf of the package starts with that
# overlap.  The configuration must remove it.
my %local_domains = map { $_ => 1 } grep { length } split(m/[,\s]+/, `postconf -h mydestination 2>/dev/null` // '');
my @virtual_domains = grep { length } split(m/[,\s]+/, `postconf -h virtual_mailbox_domains 2>/dev/null` // '');
my @in_both = grep { $local_domains{$_} } @virtual_domains;
is(scalar @in_both, 0, 'no domain is both a local and a virtual mailbox domain')
    or diag "in both: @in_both";
ok(scalar @virtual_domains, 'and there are virtual mailbox domains to have checked');

# Every table that main.cf names must exist.  If not, postfix logs an open
# failure and the lookup finds nothing.  Each domain has its own tables.
foreach my $param (qw{virtual_mailbox_maps virtual_alias_maps smtpd_sender_login_maps}) {
    my @tables = grep { length } split(m/[,\s]+/, `postconf -h $param 2>/dev/null` // '');
    ok(scalar @tables, "$param names at least one table");
    foreach my $table (@tables) {
        my ($path) = $table =~ m{^[a-z]+:(/.*)$} or next;
        ok(-f $path, "$param: $path is there");
    }
}

# An authenticated user can send only as an address it owns.  The check must
# come before the permit that ends the list.
my $sender_list = `postconf -h smtpd_sender_restrictions 2>/dev/null` // '';
my @sender_order = grep { length } split(m/[,\s]+/, $sender_list);
my ($mismatch) = grep { $sender_order[$_] eq 'reject_authenticated_sender_login_mismatch' } 0 .. $#sender_order;
my ($sasl_permit) = grep { $sender_order[$_] eq 'permit_sasl_authenticated' } 0 .. $#sender_order;
ok(defined $mismatch, 'authenticated senders are checked against smtpd_sender_login_maps') or diag $sender_list;
ok(defined $sasl_permit && defined $mismatch && $mismatch < $sasl_permit,
   'ahead of the permit that would otherwise end the list') or diag $sender_list;

# And the map answers for the accounts of this domain.  If it misses an
# address, the owner cannot send from it.
my @login_maps = grep { length } split( m/[,\s]+/, `postconf -h smtpd_sender_login_maps 2>/dev/null` // '' );
[% FOR name IN names.keys().sort() %]
SKIP: {
    skip 'no sender login map', 1 unless @login_maps;

    # postmap queries one table, and postfix takes the answer of the first
    # table in the list that has one.
    my $owner = '';
    foreach my $map (@login_maps) {
        $owner = `postmap -q '[% name %]\@[% domain %]' $map 2>&1`;
        last if !$? || $owner =~ m/fatal/;
    }
    chomp $owner;
    is($owner, '[% name %]@[% domain %]', '[% name %]@[% domain %] owns its own address') or diag $owner;
}
[% END %]
# The mailboxes that the recipe told doveadm to make.  doveadm looks up an
# account in the passwd-file userdb, which uses the full address as its key.
[% FOR name IN names.keys().sort() %]
[% IF names.$name.mailboxes.size() %]
{
    my $boxes = `doveadm mailbox list -u '[% name %]\@[% domain %]' 2>&1`;
[% FOR box IN names.$name.mailboxes %]
    like($boxes, qr/^\Q[% box %]\E$/m, '[% name %] has the mailbox [% box %]') or diag $boxes;
[% END %]
}
[% END %]
[% END %]
# virtual_maps delivers unmatched mail for the domain to the catchall, and only
# an account dovecot knows can own that mailbox.
{
    my $catchall = `doveadm user -f home 'catchall\@[% domain %]' 2>&1`;
    chomp $catchall;
    is($catchall, '/mail/[% domain %]/catchall', 'dovecot knows the catchall of [% domain %]') or diag $catchall;
}

# Where an address goes.  postfix answers from virtual_aliases as it delivers.
{
    my $aliases = '/etc/postfix/domains/[% domain %]/virtual_aliases';
    my $lookup  = sub { my $r = `postmap -q '$_[0]' hash:$aliases 2>&1`; chomp $r; $r };
[% IF admin_email %]
    is($lookup->('root@[% domain %]'), '[% admin_email %]', 'mail to root goes to the admin');
[% END %]
[% FOR name IN names.keys().sort() %]
    is($lookup->('[% name %]@[% domain %]'), '[% name %]@[% domain %]', '[% name %] keeps its own mail');
[% END %]
    is($lookup->('@[% domain %]'), 'catchall@[% domain %]', 'and every other address goes to the catchall');
}

# And a real delivery to such an address, which used to bounce at dovecot.
{
    my $subject = 'catchall probe of the guest tests';
    open( my $mail, '|-', '/usr/sbin/sendmail', '-oi', 'nobody-has-this-mailbox@[% domain %]' ) or die "sendmail: $!";
    print {$mail} "From: postmaster\@[% domain %]\nTo: nobody-has-this-mailbox\@[% domain %]\nSubject: $subject\n\nprobe\n";
    close($mail) or die "sendmail exited $?";

    my $found = '';
    foreach ( 1 .. 60 ) {
        $found = `doveadm search -u 'catchall\@[% domain %]' mailbox INBOX subject '$subject' 2>&1`;
        last if $found =~ m/\S/;
        sleep 1;
    }
    like($found, qr/\S/, 'mail to an address with no mailbox reaches the catchall')
      or diag `journalctl -u postfix\@- --since '-2min' --no-pager -o cat 2>&1 | grep nobody-has-this-mailbox`;
    system('doveadm', 'expunge', '-u', 'catchall@[% domain %]', 'mailbox', 'INBOX', 'subject', $subject);
}

# The quota warning, run as dovecot runs it.  Nothing else delivers it, so a
# script that cannot find dovecot-lda warns nobody and logs nothing we read.
{
    my $to      = 'catchall@[% domain %]';
    my $subject = 'This mailbox is nearly over its quota';
    my $said    = `sudo -u dovecot /mail/scripts/dovecot_overquota '$to' 2>&1`;
    is($?, 0, 'the over-quota script runs as dovecot') or diag $said;

    my $found = `doveadm search -u '$to' mailbox INBOX subject '$subject' 2>&1`;
    like($found, qr/\S/, 'and its warning arrives in the mailbox') or diag $found;
    system('doveadm', 'expunge', '-u', $to, 'mailbox', 'INBOX', 'subject', $subject);
}

# amavis lists its files with run-parts, which skips a name with a dot in it,
# and so would skip a file named for the domain as it is spelled.
{
    my $listed = `run-parts --list /etc/amavis/conf.d 2>&1`;
    like($listed, qr{^/etc/amavis/conf.d/50-\Q[% domain.replace('[.]', '_') %]\E$}m, 'amavis reads the file of [% domain %]') or diag $listed;
    like($listed, qr{^/etc/amavis/conf.d/40-trog-mail$}m, 'and the file of the guest') or diag $listed;
    unlike($listed, qr{/50-user$}m, 'and no 50-user, which would replace the list of domains') or diag $listed;
}

# Spam, end to end: GTUBE is the message that SpamAssassin always scores as
# spam.  amavis must mark it, and the global sieve must file it into Junk.
{
    my $to      = 'catchall@[% domain %]';
    my $subject = 'spam probe of the guest tests';
    open( my $mail, '|-', '/usr/sbin/sendmail', '-oi', $to ) or die "sendmail: $!";
    print {$mail} "From: postmaster\@[% domain %]\nTo: $to\nSubject: $subject\n\n"
      . "XJS*C4JDBQADN1.NSBN3*2IDNEN*GTUBE-STANDARD-ANTI-UBE-TEST-EMAIL*C.34X\n";
    close($mail) or die "sendmail exited $?";

    my $found = '';
    foreach ( 1 .. 60 ) {
        $found = `doveadm search -u '$to' mailbox Junk subject '$subject' 2>&1`;
        last if $found =~ m/\S/;
        sleep 1;
    }
    like($found, qr/\S/, 'spam is filed into Junk') or diag `doveadm search -u '$to' mailbox INBOX subject '$subject' 2>&1`;

    my $headers = `doveadm fetch -u '$to' hdr mailbox Junk subject '$subject' 2>&1`;
    like($headers, qr/^X-Spam-Flag:\s*YES/mi, 'because amavis marked it as spam') or diag $headers;

    # The nightly training, on the probe.  Then the database forgets it, because
    # this test also runs on a guest whose filter is in use.
    my $db = '/var/lib/amavis/.spamassassin';
    my $trained = `[% script_dir %]/sa_train_amavis /mail/[% domain %]/catchall/Maildir 2>&1`;
    is($?, 0, 'the nightly training runs') or diag $trained;
    my $magic = `sudo -u amavis sa-learn --dump magic 2>&1`;
    my ($nspam) = $magic =~ m/^\S+\s+\S+\s+(\d+)\s+.*non-token data: nspam$/m;
    ok(($nspam // 0) >= 1, 'and amavis reads the spam that it learned') or diag $magic;
    my $owners = `find $db ! -user amavis 2>&1`;
    is($owners, '', 'and still owns all of its database') or diag $owners;

    my ($file) = `grep -rl '$subject' /mail/[% domain %]/catchall/Maildir/.Junk 2>/dev/null` =~ m/^(.*\S)/m;
    system("sa-learn --dbpath $db --forget '$file' >/dev/null 2>&1; chown -R amavis:amavis $db") if $file;
    system('doveadm', 'expunge', '-u', $to, 'mailbox', 'Junk', 'subject', $subject);
}

# The postfix filter goes to amavis, which scores the spam, and only there.
{
    my $filter = `postconf -h content_filter 2>&1`;
    chomp $filter;
    is($filter, 'smtp-amavis:[127.0.0.1]:10024', 'postfix filters mail through amavis alone') or diag $filter;
}

# The publisher of the registrar puts the DKIM key in the zone of the domain,
# wherever the zone is, once for each selector however many times the guest
# has been provisioned.
SKIP: {
    my $shortcut = '/opt/lexicon/[% domain %]';
    skip 'no lexicon shortcut, so the registrar publishes nothing', 4 unless -x $shortcut;
    my $public = `openssl rsa -in /etc/opendkim/keys/[% domain %]/default.private -pubout 2>/dev/null`;
    $public =~ s/-----[^-]+-----//g;
    $public =~ s/\s+//g;
    my $listed = `$shortcut list TXT --output=JSON 2>/dev/null`;
    my $rows   = eval { JSON::PP->new->decode($listed) } // [];
    foreach my $selector (qw{default mail}) {
        my @keys = grep { lc( $_->{name} // '' ) =~ m/\A\Q$selector._domainkey.[% domain %]\E[.]?\z/ && ( $_->{content} // '' ) =~ m/v=DKIM1/ } @$rows;
        is( scalar @keys, 1, "one DKIM record for the $selector selector" ) or diag $listed;
        like( ( $keys[0] // {} )->{content} // '', qr/p=\Q$public\E/, 'which holds the key that opendkim signs with' );
    }
}
# opendmarc checks SPF itself.  milterprobe gives it a message as a client
# would, from an address that the test chooses, and the test reads what
# opendmarc concluded.  An SMTP session from here would stop at the reverse DNS
# check of postfix, before opendmarc saw it.
[% INCLUDE "files/milter_probe.t.tt" %]

subtest 'opendmarc checks SPF for a message from outside' => sub {
    my $verdict = sub {
        my ( $ip, $ar ) = @_;
        return milter_probe( socket => '/var/spool/postfix/opendmarc/opendmarc.sock', ip => $ip, from => 'postmaster@[% domain %]', ar => $ar );
    };

    # An address from the documentation ranges, which no SPF record allows.
    my $stranger = $verdict->('203.0.113.9');
    like( $stranger, qr/\bspf=(?:fail|softfail|neutral|none)\b/, 'a stranger gets an SPF result, which DMARC can use' ) or diag $stranger;
    unlike( $stranger, qr/\bspf=pass\b/, 'and not a pass' );

    # The record that the zone of this domain publishes allows its own A record.
    my $spf     = `dig +short TXT [% domain %] 2>/dev/null`;
    my ($own)   = `dig +short A [% domain %] 2>/dev/null` =~ m/^(\d+\.\d+\.\d+\.\d+)$/m;
    SKIP: {
        skip( 'the SPF record of [% domain %] does not allow its A record', 1 ) unless $own && $spf =~ m/v=spf1[^"]*[ +]a\b/;
        my $pass = $verdict->($own);
        like( $pass, qr/\bspf=pass\b/, "and $own, which SPF allows, passes" ) or diag $pass;
    }
[% IF mailrelay -%]

    # The mail relay saw the client, so its verdict stands, and the relay is
    # the only client whose verdict does.
    my $trusted = $verdict->( '203.0.113.9', '[% mailrelay %]; spf=pass smtp.mailfrom=[% domain %]' );
    like( $trusted, qr/\bdmarc=pass\b/, 'a pass that the mail relay wrote decides DMARC' ) or diag $trusted;
    my $forged = $verdict->( '203.0.113.9', 'elsewhere.test.test; spf=pass smtp.mailfrom=[% domain %]' );
    unlike( $forged, qr/\bdmarc=pass\b/, 'and one under another name does not' ) or diag $forged;
[% END -%]
};

# One opendmarc serves every domain on this guest, so a later domain must not
# take away the ids that an earlier one trusts.
subtest 'opendmarc trusts every id that a domain on this guest names' => sub {
    my %ids;
    foreach my $fragment ( glob '/etc/opendmarc.conf.d/*' ) {
        open( my $fh, '<', $fragment ) or die "$fragment: $!";
        while ( my $line = <$fh> ) {
            next unless $line =~ m/^\s*TrustedAuthservIDs\s+(.*?)\s*$/;
            $ids{$_} = $fragment for grep { length } split m/[\s,]+/, $1;
        }
    }
    ok( scalar( keys %ids ), 'the fragments name ids to trust' );
    foreach my $id ( sort keys %ids ) {
        my $verdict = milter_probe( socket => '/var/spool/postfix/opendmarc/opendmarc.sock', ip => '203.0.113.9', from => 'postmaster@[% domain %]', ar => "$id; spf=pass smtp.mailfrom=[% domain %]" );
        like( $verdict, qr/\bdmarc=pass\b/, "a pass under $id, from $ids{$id}, decides DMARC" ) or diag $verdict;
    }
};

# opendmarc trusts what is written under the name of this guest, so a client
# must not be able to write it.  opendkim, which runs first, removes it.
subtest 'a verdict under the name of this guest that a client sent is removed' => sub {
    my %probe = ( socket => '/var/spool/postfix/opendkim/opendkim.sock', ip => '203.0.113.9', from => 'someone@nosuch.test.test' );
    my $own = milter_probe( %probe, ar => 'mail.[% domain %]; spf=pass smtp.mailfrom=nosuch.test.test' );
    like( $own, qr/^delete_header \d+ Authentication-Results$/m, 'opendkim removes it before opendmarc reads the message' ) or diag $own;
    my $other = milter_probe( %probe, ar => 'elsewhere.test.test; spf=pass smtp.mailfrom=nosuch.test.test' );
    unlike( $other, qr/^delete_header \d+ Authentication-Results$/m, 'and keeps one under another name, which opendmarc does not trust anyway' ) or diag $other;
};

[% IF mailrelay_login -%]
subtest 'the mail of this domain goes out through the mail relay' => sub {
    my $relay = `postmap -q '\@[% domain %]' hash:/etc/postfix/domains/[% domain %]/sdd_relay_maps 2>&1`;
    chomp $relay;
    is( $relay, '[[% mailrelay_login.address %]]:[% mailrelay_login.port %]', 'every sender of this domain is sent to the mail relay' );
    my $login = `postmap -q '\@[% domain %]' hash:/etc/postfix/domains/[% domain %]/sasl_passwd 2>&1`;
    like( $login, qr/\A\Q[% domain %]\E:[0-9a-f]+$/, 'with the login that the mail relay issued' );

    # relay-selftest on the mail relay delivers to /dev/null, so this sends
    # nothing to the internet.
    open( my $mail, '|-', '/usr/sbin/sendmail', '-f', 'postmaster@[% domain %]', 'relay-selftest@[% mailrelay %]' ) or die "sendmail: $!";
    print {$mail} "Subject: a test of the mail relay\n\nNothing to read.\n";
    close $mail or die "sendmail: $!";

    my $log = '';
    for ( 1 .. 60 ) {
        $log = `journalctl -t postfix/cleanup -t postfix/smtp --since '-5min' --no-pager -o cat 2>&1`;
        last if $log =~ m/to=<relay-selftest\@\Q[% mailrelay %]\E>, relay=\Q[% mailrelay_login.address %]\E\[[^\]]*\]:[% mailrelay_login.port %],.* status=sent/;
        sleep 1;
    }
    like( $log, qr/to=<relay-selftest\@\Q[% mailrelay %]\E>, relay=\Q[% mailrelay_login.address %]\E\[[^\]]*\]:[% mailrelay_login.port %],.* status=sent/, 'a message reaches the relay, which takes it' ) or diag $log;
};

[% INCLUDE "files/relay.client_test.tt" WITH recipe = 'mail' %]

subtest 'the mail clients that the relay passes reach the proxy ports, which take the relay alone' => sub {
    my $master = `postconf -M '[% proxied_ports.submissions %]/inet' 2>&1`;
    like( $master, qr/smtpd_upstream_proxy_protocol=haproxy/, 'postfix reads the PROXY header on [% proxied_ports.submissions %]' ) or diag $master;
    like( $master, qr/smtpd_client_restrictions=permit_sasl_authenticated,reject/, 'and takes mail there only after a login, as on 465' ) or diag $master;

    my $dovecot = `doveconf -n 2>&1`;
    like( $dovecot, qr/port = [% proxied_ports.imaps %]\s+ssl = yes|haproxy = yes\s+port = [% proxied_ports.imaps %]/, 'dovecot takes IMAP over TLS on [% proxied_ports.imaps %]' ) or diag $dovecot;
    like( $dovecot, qr/^haproxy_trusted_networks = .*\Q[% mailrelay_login.address %]\E/m, 'and believes the PROXY header from the relay' ) or diag $dovecot;

    my $listening = `ss -lnt 2>&1`;
    like( $listening, qr/:\Q$_\E\s/, "something listens on $_" ) or diag $listening foreach [% proxied_ports.values().sort().join(', ') %];

    my $chain = `iptables -S trog-mail-proxy-from 2>&1`;
    like( $chain, qr/^-A trog-mail-proxy-from -s \Q[% mailrelay_login.address %]\E\/32 -j RETURN$/m, 'the firewall lets the relay reach those ports' ) or diag $chain;
    like( $chain, qr/^-A trog-mail-proxy-from -j DROP$/m, 'and drops everybody else there' ) or diag $chain;
    my $ufw = `ufw status 2>&1`;
    like( $ufw, qr/^mail-proxy\s+ALLOW\s/m, 'ufw opens them, behind that' ) or diag $ufw;
    my $input = `iptables -S INPUT 2>&1`;
    like( $input, qr/--dports [% proxied_ports.values().sort().join(',') %] -j trog-mail-proxy-from/, 'for the proxy ports' ) or diag $input;
};
[% END -%]

subtest '465 is submission over TLS, which takes mail only after a login' => sub {
    require IO::Select;
    require IPC::Open2;

    # Each command of one session on 465, which is TLS from the first byte, and
    # the reply of postfix to it.
    my $pid = IPC::Open2::open2( my $out, my $in, qw{openssl s_client -quiet -crlf -connect 127.0.0.1:465 -servername [% domain %]} );
    my @replies;
    foreach my $command ( undef, 'EHLO client.nosuch.test.test', 'MAIL FROM:<someone@nosuch.test.test>', 'RCPT TO:<postmaster@[% domain %]>', 'QUIT' ) {
        if ( defined $command ) {
            print {$in} "$command\n";
            $in->flush;
        }
        my $reply = q{};
        while ( IO::Select->new($out)->can_read(10) ) {
            my $got = sysread( $out, my $buf, 4096 ) or last;
            $reply .= $buf;
            last if $reply =~ m/^\d{3} [^\n]*\n\z/m;
        }
        push @replies, $reply;
    }
    close $in;
    waitpid( $pid, 0 );

    like( $replies[0], qr/^220 /m,       'postfix greets a client in TLS on 465' ) or diag explain \@replies;
    like( $replies[1], qr/^250[- ]AUTH /m, 'and offers a login' ) or diag $replies[1];
    like( $replies[3], qr/^5\d\d /m,      'and refuses a message for this domain from a client with no login, which only 25 takes' ) or diag $replies[3];
};

subtest 'a mail client finds its settings, as Outlook and Thunderbird ask for them' => sub {
    # The body and then the status, of one request to this guest by name.
    my $fetch = sub {
        my ( $method, $url ) = @_;
        my ( $scheme, $name ) = $url =~ m{\A(\w+)://([^/]+)};
        my $port = $scheme eq 'https' ? 443 : 80;
        my $body = $method eq 'POST' ? q{-H 'Content-Type: text/xml' --data '<Autodiscover/>'} : q{};
        my $got  = `curl -sk --max-time 10 -X $method $body -w '\n%{http_code}' --resolve '$name:$port:127.0.0.1' '$url' 2>&1`;
        return $got =~ m/\A(.*)\n(\d{3})\z/s ? ( $1, $2 ) : ( $got, 'none' );
    };

    my ( $outlook, $code ) = $fetch->( POST => 'https://autodiscover.[% domain %]/autodiscover/autodiscover.xml' );
    is( $code, 200, 'Outlook gets an answer to its POST over HTTPS' ) or diag $outlook;
    like( $outlook, qr{<Server>mail[.]\Q[% domain %]\E</Server>}, 'which names the mail host' ) or diag $outlook;
    like( $outlook, qr{<SPA>off</SPA>}, 'and asks for no NTLM, which neither server offers' );
    ( undef, $code ) = $fetch->( POST => 'https://autodiscover.[% domain %]/Autodiscover/Autodiscover.xml' );
    is( $code, 200, 'and with the path in capitals, as Outlook also spells it' );

    my ( $thunderbird, $tb_code ) = $fetch->( GET => 'https://autoconfig.[% domain %]/mail/config-v1.1.xml?emailaddress=someone%40[% domain %]' );
    is( $tb_code, 200, 'Thunderbird gets its config over HTTPS' ) or diag $thunderbird;
    like( $thunderbird, qr{<incomingServer type="imap">\s*<hostname>mail[.]\Q[% domain %]\E</hostname>\s*<port>993</port>}, 'which names IMAP on 993 of the mail host' ) or diag $thunderbird;
    like( $thunderbird, qr{<outgoingServer type="smtp">\s*<hostname>mail[.]\Q[% domain %]\E</hostname>\s*<port>465</port>}, 'and submission on 465' ) or diag $thunderbird;
    ( undef, $code ) = $fetch->( GET => 'http://autoconfig.[% domain %]/mail/config-v1.1.xml' );
    is( $code, 200, 'and over plain HTTP, which it tries when HTTPS fails' );

    # Outlook refuses a certificate that does not name the host it asked.
    foreach my $name ( 'autodiscover.[% domain %]', 'autoconfig.[% domain %]' ) {
        my $names = `openssl s_client -connect 127.0.0.1:443 -servername $name </dev/null 2>/dev/null | openssl x509 -noout -ext subjectAltName 2>&1`;
        like( $names, qr/DNS:\Q$name\E\b/, "the certificate on 443 names $name" ) or diag $names;
    }
};
done_testing();
