#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $conf = '/etc/systemd/resolved.conf.d/10-disable-stub-resolver.conf';
ok(-f $conf, 'stub resolver config exists');

my $text = do { local (@ARGV, $/) = $conf; <> } // '';
like($text, qr/^DNSStubListener\s*=\s*no/m, 'and it turns the stub listener off');

# This is the purpose of the recipe.  The stub holds 127.0.0.53:53, and a real
# resolver on this guest cannot use port 53 until the stub lets go of it.  The
# file does not prove that resolved read it, so this asks the running system.
my $listening = `ss -lntu 2>/dev/null`;
unlike($listening, qr/127\.0\.0\.53:53\b/, 'nothing is listening on the stub address')
    or diag $listening;

my $status = `systemctl is-active systemd-resolved 2>/dev/null`;
chomp $status;
is($status, 'active', 'systemd-resolved is still running');

# Names must still resolve, because turning the stub off is safe only when
# something else answers.
my $resolved = `getent hosts localhost 2>/dev/null`;
ok($resolved, 'names still resolve');

done_testing();
