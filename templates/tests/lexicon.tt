#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# The client that every recipe on the guest uses to write a DNS record.
my $which = `command -v lexicon 2>/dev/null`;
like($which, qr/\S/, 'lexicon is installed') or diag 'no lexicon on PATH';

# Building the parser imports every provider, patched ones included, so a
# module a patch needs and nothing installed fails here for every provider.
my $help = `lexicon --help 2>&1`;
is($?, 0, 'and it starts') or diag $help;

# The shortcut that an operator uses.  It contains the credentials.
my $shortcut = '/opt/lexicon/[% domain %]';

ok(-f $shortcut, 'the lexicon shortcut is installed');
ok(-x $shortcut, 'and can be run');

# On an older guest this path is a directory with one shortcut per provider.
# The build must remove it, not move the new file into it.
ok(!-d $shortcut, 'as a file, and not a directory of per-provider shortcuts');

my @st = stat $shortcut;
is($st[4] // -1, 0, 'owned by root, since it carries the credentials') if @st;
is(($st[2] // 0) & 07777, 0700, 'and readable by nobody else') if @st;

my $text = do { local (@ARGV, $/) = $shortcut; <> } // '';
like($text, qr/^export LEXICON_[% lexicon.type.upper() %]_AUTH_TOKEN=/m, 'carrying the token lexicon reads');

done_testing();
