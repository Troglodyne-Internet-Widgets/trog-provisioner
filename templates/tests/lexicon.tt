#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# The client that every recipe on the guest uses to write a DNS record.
my $which = `command -v lexicon 2>/dev/null`;
like($which, qr/\S/, 'lexicon is installed') or diag 'no lexicon on PATH';

# Building the parser imports every provider, patched ones included, so a
# module a patch needs and nothing installed fails here for every provider.
my $help = `lexicon --help 2>&1`;
is($?, 0, 'and it starts') or diag $help;

# The shortcut that an operator uses.  It contains the credentials.
my $shortcut = '/opt/lexicon/[% domain %]';

ok(-f $shortcut, 'the lexicon shortcut is installed');
ok(-x $shortcut, 'and can be run');

# On an older guest this path is a directory with one shortcut per provider.
# The build must remove it, not move the new file into it.
ok(!-d $shortcut, 'as a file, and not a directory of per-provider shortcuts');

my @st = stat $shortcut;
is($st[4] // -1, 0, 'owned by root, since it carries the credentials') if @st;
is(($st[2] // 0) & 07777, 0700, 'and readable by nobody else') if @st;

# The easydns provider against a fake API, which records what it sends.  The
# patch lexicon-easydns-priority moves the priority of an MX out of the
# content.
my $easydns = <<'PYTHON';
from lexicon.config import ConfigResolver
from lexicon._private.providers import easydns
conf = {"provider_name": "easydns", "domain": "zone.test", "type": "MX", "easydns": {"auth_username": "u", "auth_token": "t"}}
p = easydns.Provider(ConfigResolver().with_dict(conf))
p.domain_id = "zone.test"
p._put = lambda url, data=None, **kw: print(data["prio"], data["rdata"]) or {}
p.create_record("MX", "zone.test", "10 mail.zone.test.")
PYTHON
my $sent = `python3 -I -c '$easydns' 2>&1`;
is($sent, "10 mail.zone.test.\n", 'the easydns provider sends the priority of an MX apart from its target') or diag $sent;

# The patch lexicon-pdns-identifier: an identifier keeps the whole content.
my $identifier = `python3 -I -c 'from lexicon._private.providers.powerdns import Provider; c = "v=DKIM1; p=ab/cd+ef/gh=="; print(Provider._parse_identifier(None, Provider._make_identifier(None, "TXT", "x.zone.test.", c))[2])' 2>&1`;
is($identifier, "v=DKIM1; p=ab/cd+ef/gh==\n", 'the powerdns provider reads back the content of a record that holds a slash, so it can delete it') or diag $identifier;

# An argument with spaces in it, such as the content of an SPF record, reaches
# lexicon whole.  A fake lexicon early on PATH prints the last argument that
# arrives.
{
    my $bin = '/root/lexicon-args-test';
    mkdir $bin;
    open(my $fake, '>', "$bin/lexicon") or die "Cannot write the fake lexicon: $!";
    print {$fake} "#!/bin/sh\nfor arg; do last=\$arg; done\necho \"\$last\"\n";
    close $fake;
    chmod 0700, "$bin/lexicon";
    my $last = `PATH=$bin:\$PATH $shortcut create TXT --content='v=spf1 +a -all' 2>&1`;
    unlink "$bin/lexicon";
    rmdir $bin;
    is($last, "--content=v=spf1 +a -all\n", 'the shortcut hands lexicon each argument whole') or diag $last;
}

my $text = do { local (@ARGV, $/) = $shortcut; <> } // '';
like($text, qr/^export LEXICON_[% lexicon.type.upper() %]_AUTH_TOKEN=/m, 'carrying the token lexicon reads');

done_testing();
