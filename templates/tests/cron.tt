#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# Both files in cron.d: the one for this domain, and the one for the guest that
# the global half installs with the SAR, rkhunter and watcher jobs.  The guest
# file is written once, by the first domain built on the guest, so its MAILFROM
# names that domain, which need not be this one.
subtest '/etc/cron.d/[% domain %]' => sub { check_crontab( '/etc/cron.d/[% domain %]', '[% from %]' ) };
subtest '/etc/cron.d/default'     => sub { check_crontab('/etc/cron.d/default') };

# The crontab of the service user, which crontab(1) installs, not cron.d.
my $user_tab = `crontab -u [% user %] -l 2>&1`;
is($?, 0, 'the crontab for [% user %] is installed') or diag $user_tab;
like($user_tab, qr/^MAILTO="[^"]+"/m, 'and sets MAILTO') or diag $user_tab;

# The files that the other recipes of this guest gave this recipe to install.
[% FOR name IN files.keys().sort() -%]
subtest '/etc/cron.d/[% name %]' => sub { check_recipe_file('/etc/cron.d/[% name %]') };
[% END -%]

my $status = `systemctl is-active cronie 2>/dev/null || systemctl is-active cron 2>/dev/null`;
like($status, qr/active/, 'cron is running');

done_testing();

# What this recipe adds to each file that another recipe gave it: the two mail
# lines at the top, and no later line that overrides either of them.
sub check_recipe_file {
    my ($file) = @_;

    ok(-f $file, 'it is installed');
    my @st = stat $file;
    is(scalar getpwuid($st[4] // -1), 'root', 'and is owned by root');
    is($st[2] & 022, 0, 'and is not group or world writable');

    my @lines = split m/\n/, ( do { local (@ARGV, $/) = $file; <> } // '' );
    is($lines[0], 'MAILTO="[% admin_email %]"', 'its jobs mail the admin');
    is($lines[1], 'MAILFROM="[% from %]"', 'from cron at the domain');
    is(scalar( grep { m/^MAIL(?:TO|FROM)=/ } @lines ), 2, 'and nothing later in the file changes either') or diag join("\n", @lines);
    return;
}

# MAILFROM must be $from when it is given, and only set when it is not.
sub check_crontab {
    my ( $file, $from ) = @_;

    ok(-f $file, 'crontab file exists');

    # cron ignores a file in cron.d that root does not own, or that group or
    # world can write.  It does not report this, so the jobs in the file never
    # run.
    my @st = stat $file;
    is(scalar getpwuid($st[4] // -1), 'root', 'and is owned by root');
    is($st[2] & 022, 0, 'and is not group or world writable');

    my $text = do { local (@ARGV, $/) = $file; <> } // '';

    like($text, qr/^MAILTO="[^"]+"/m, 'it sets MAILTO, so failures reach somebody');
    my ($mailfrom) = $text =~ /^MAILFROM="([^"]*)"$/m;
    if ( defined $from ) {
        is($mailfrom, $from, 'and MAILFROM, so the mail comes from cron and not from the user of the job');
    }
    else {
        like($mailfrom // '', qr/\S/, 'and MAILFROM, so the mail comes from cron and not from the user of the job');
    }
    like($text, qr/^PATH="[^"]+"/m,   'and a PATH for the jobs to find their commands in');

    # Look up each command of the jobs in the PATH that the file declares.  If
    # a script is not installed, its job mails "command not found" each time it
    # runs.
    my ($path) = $text =~ m/^PATH="([^"]+)"/m;
    my @dirs = split m/:/, ( $path // '' );

    foreach my $line ( split m/\n/, $text ) {
        next if $line =~ m/^\s*(#|$)/ || $line =~ m/^[A-Z_]+=/;

        # minute hour dom mon dow user command...
        my @f = split ' ', $line, 7;
        next unless @f == 7;

        my $cmd = $f[6];
        $cmd =~ s/^command\s+//;          # a shell builtin, not the program
        my ($prog) = split ' ', $cmd;
        next unless $prog;
        next if $prog =~ m/^[\[\(]/;

        if ( $prog =~ m{^/} ) {
            ok(-x $prog, "$prog is there and executable");
        }
        else {
            my $found = grep { -x "$_/$prog" } @dirs;
            ok($found, "$prog is somewhere on the crontab PATH") or diag $line;
        }
    }
    return;
}
