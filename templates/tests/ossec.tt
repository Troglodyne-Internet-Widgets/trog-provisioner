use strict;
use warnings;

use Test::More;
use JSON::PP;
use MIME::Base64();
use POSIX qw{strftime};

my $port = '[% port %]';
my $influx = 'http://127.0.0.1:8086';

# The hosts that this test makes up.  The collector is a live one, so they go
# when the test ends, however it ends.
my @fake_hosts;
END {
    local $?;
    forget_hosts(@fake_hosts);
}

subtest 'the manager runs the daemons that read the stream and send the mail of the alerts' => sub {
    my $status = `/var/ossec/bin/ossec-control status 2>&1`;
    foreach my $daemon (qw{ossec-analysisd ossec-remoted ossec-maild}) {
        like( $status, qr/^\Q$daemon\E is running/m, "$daemon is running" ) or diag $status;
    }
};

sub conf {
    my ($file) = @_;
    my $xml = do { local ( @ARGV, $/ ) = "/var/ossec/etc/$file"; <> } // q{};
    $xml =~ s{<!--.*?-->}{}gs;
    return $xml;
}

subtest 'configd makes ossec.conf, with the rule files of the package in its order, and the rules of the watchers last' => sub {
    my %includes;
    foreach my $file (qw{ossec.conf.d/00-original ossec.conf}) {
        my ($rules) = conf($file) =~ m{<rules>(.*?)</rules>}s;
        $includes{$file} = [ ( $rules // q{} ) =~ m{<include>([^<]+)</include>}g ];
    }
    ok( scalar @{ $includes{'ossec.conf.d/00-original'} }, 'the file of the package is the first fragment, with its list' ) or return;
    is_deeply( $includes{'ossec.conf'}, [ @{ $includes{'ossec.conf.d/00-original'} }, 'watchers_rules.xml' ], 'and the file that the manager reads has the same list, then the rules of the watchers' );

    my $dropins = `systemctl show ossec -p DropInPaths --value 2>&1`;
    like( $dropins, qr{configd}, 'configd makes it again each time the manager starts' ) or diag $dropins;

    my $check = `/var/ossec/bin/ossec-analysisd -t 2>&1`;
    is( $?, 0, 'and analysisd loads it' ) or diag $check;
};

subtest 'none of the defaults of the package that the fragment clears' => sub {
    my $conf = conf('ossec.conf');
    unlike( $conf, qr{<active-response>},            'no active response, which would block addresses in the firewall of the collector' );
    unlike( $conf, qr{<localfile>},                  'no log file of the example' );
    unlike( $conf, qr{<white_list>},                 'no whitelist of private addresses' );
    my @to = $conf =~ m{<email_to>([^<]*)</email_to>}g;
    is_deeply( \@to, ['[% admin_email %]'], 'and no mail to an example address, only to the admin' );

};

subtest 'the manager listens on loopback, where the collector sends' => sub {

    # Polls, because a postrun task restarts the manager.
    my $listening = q{};
    foreach ( 1 .. 30 ) {
        $listening = `ss -lnt 2>/dev/null`;
        last if $listening =~ m/^LISTEN\s+\S+\s+\S+\s+(?:\[::ffff:)?127\.0\.0\.1\]?:$port\b/m;
        sleep 2;
    }
    like( $listening, qr/^LISTEN\s+\S+\s+\S+\s+(?:\[::ffff:)?127\.0\.0\.1\]?:$port\b/m, "the manager reads the stream on 127.0.0.1:$port" )
      or diag $listening;

    my $conf = do { local ( @ARGV, $/ ) = glob('/etc/rsyslog.d/*logcollector.conf'); <> } // q{};
    like( $conf, qr/target="127\.0\.0\.1"\s+port="$port"[^)]*template="RSYSLOG_ForwardFormat"/s, 'and the collector copies the stream there as text' )
      or diag $conf;
};

subtest 'the manager listens for agents, and issues and revokes their keys' => sub {
    my $listening = `ss -lnu 2>&1`;
    like( $listening, qr/^UNCONN\s+\S+\s+\S+\s+\S+:1514\b/m, 'the manager listens for agents on 1514/udp' ) or diag $listening;

    my $agent = 'agent-probe.[% domain %]';
    my $line  = qr/^(\d+) \Q$agent\E any ([[:xdigit:]]+)$/;

    my $first = MIME::Base64::decode_base64( scalar `/usr/local/sbin/ossec-agent-key $agent` );
    like( $first, $line, 'ossec-agent-key prints the line of a new agent, in base64' ) or diag $first;
    my $second = MIME::Base64::decode_base64( scalar `/usr/local/sbin/ossec-agent-key $agent` );
    like( $second, $line, 'and a line again for the next build of the guest' ) or diag $second;
    my ($old_id) = $first  =~ $line;
    my ($new_id) = $second =~ $line;
    isnt( $new_id, $old_id, 'with a new agent, whose count of messages starts again' );

    my $maint = `/var/ossec/bin/agent_control -j -u $new_id -M status 2>&1`;
    like( $maint, qr/"fimMaintenance":"Maint\(pending-end\)"/, 'the new agent is in FIM maintenance until its first scan completes, so that scan raises no alert for each file' )
      or diag $maint;

    my $keys = do { local ( @ARGV, $/ ) = '/var/ossec/etc/client.keys'; <> } // q{};
    my @live = grep { m/^\d+ \Q$agent\E / } split m/\n/, $keys;
    is( scalar @live, 1, 'and the agent of the last build is the only one of that name' ) or diag $keys;

    system( '/usr/local/sbin/ossec-agent-revoke', $agent );
    is( $?, 0, 'ossec-agent-revoke succeeds' );
    $keys = do { local ( @ARGV, $/ ) = '/var/ossec/etc/client.keys'; <> } // q{};
    unlike( $keys, qr/^\d+ \Q$agent\E /m, 'and removes the agent' ) or diag $keys;
    ok( !-e "/var/ossec/queue/syscheck/.($agent) any.maint", 'and its FIM maintenance, which a scan never ended' );
};

# What segfaults.sh mailed: the line of a guest goes through the collector to
# the manager, which raises the alert of the rule of the watchers and hands its
# mail to the mail server on loopback.
subtest 'a segfault on a guest is an alert that goes to the admin by mail' => sub {
    my $conf = do { local ( @ARGV, $/ ) = glob('/etc/rsyslog.d/*logcollector.conf'); <> } // q{};
    my ($cport) = $conf =~ m/input\(type="imtcp"\s+port="(\d+)"/;
    ok( $cport, 'the collector says which TCP port it listens on' ) or return;

    my $guest = "ossec-segfault-$$-" . time() . '.test.test';
    push @fake_hosts, $guest;
    my $stamp = strftime( '%b %e %H:%M:%S', localtime );
    my $line  = "<4>$stamp $guest kernel: bogus[4242]: segfault at 0 ip 00005555d00d sp 00007ffd00d0 error 4 in bogus[555500000000+1000]\n";
    open( my $nc, '|-', 'nc', '-q1', '127.0.0.1', $cport ) or return fail("nc: $!");
    print {$nc} $line;
    close($nc);

    # alerts.log has the host and the rule of an alert on separate lines.
    my ( $alert, $mail ) = ( q{}, q{} );
    foreach ( 1 .. 24 ) {
        my $alerts = do { local ( @ARGV, $/ ) = '/var/ossec/logs/alerts/alerts.log'; <> } // q{};
        ($alert) = $alerts =~ m/^(\N*\Q$guest\E\N*\nRule:\s+\d+\N*)/m;
        my $log = `grep -h 'from=<ossec\@[% domain %]>' /var/log/mail.log 2>/dev/null`;
        $mail = $log if $alert;
        last if $alert && $log =~ m/nrcpts?=1/;
        sleep 5;
    }
    like( $alert // q{}, qr/Rule:\s+100100\b/, 'the rule of the watchers raises the alert' )
      or return diag `tail -n 20 /var/ossec/logs/alerts/alerts.log 2>&1`;
    like( $mail, qr/nrcpts?=1/, 'and the mail server takes its mail' )
      or diag $mail . `tail -n 5 /var/ossec/logs/ossec.log 2>&1` . `tail -n 5 /var/log/mail.log 2>&1`;
};

# Deletes the series of each host from every database of influxdb, when the
# collector has one, as the sender of a line and as the host of an alert.  Then
# deletes the log file that the collector keeps for it.  DROP needs a POST.
sub forget_hosts {
    my @hosts = @_;
    my $dbs   = eval { JSON::PP->new->decode(`curl -fsS -G $influx/query --data-urlencode 'q=SHOW DATABASES' 2>/dev/null`)->{results}[0]{series}[0]{values} } // [];
    foreach my $db ( grep { $_ ne '_internal' } map { $_->[0] } @$dbs ) {
        foreach my $host (@hosts) {
            foreach my $tag (qw{hostname ossec_host}) {
                my $q = qq{DROP SERIES WHERE "$tag" = '$host'};
                open( my $curl, '-|', 'curl', '-sS', '-XPOST', "$influx/query", '--data-urlencode', "db=$db", '--data-urlencode', "q=$q" ) or die "curl: $!";
                my $res = do { local $/; <$curl> } // q{};
                warn "$db: $q: $res\n" if $res =~ m/"error"/ || !close($curl);
            }
        }
    }
    unlink map { "/var/log/hosts/$_.log" } @hosts;
    return;
}

done_testing();
