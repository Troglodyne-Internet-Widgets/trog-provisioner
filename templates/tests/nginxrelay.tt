#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use IO::Socket::INET;
use IO::Select;
use MIME::Base64 ();

my $client = '[% script_dir %]/nginxrelay_client';
my $domain = 'relay-selftest.test.test';
# Long, because nginx refuses a map with a name longer than its bucket.
my $name = 'selftest-' . ( 'x' x 50 ) . '.relay.test.test';

my $check = `nginx -t 2>&1`;
like( $check, qr/test is successful/, 'nginx accepts the configuration' ) or diag $check;

# A listener that stands in for a guest, and the first lines that a connection
# to it sends, or nothing when none comes within ten seconds.
sub listener {
    my $listener = IO::Socket::INET->new( Listen => 1, LocalAddr => '127.0.0.1', LocalPort => 0, ReuseAddr => 1 );
    die "Cannot listen: $!\n" unless $listener;
    return $listener;
}

sub first_lines {
    my ($listener) = @_;
    return q{} unless IO::Select->new($listener)->can_read(10);
    my $conn = $listener->accept() or return q{};
    my $said = q{};
    while ( IO::Select->new($conn)->can_read(2) ) {
        my $got = sysread( $conn, my $buf, 4096 ) or last;
        $said .= $buf;
        last if $said =~ m/\r\n\r\n/ || $said =~ m/\APROXY [^\n]*\n/;
    }
    return $said;
}

# The status that curl gets for $name on $port of this guest, or 000 for none.
# The stream proxy is on [% tls_port %], because ufw forwards only a
# connection from outside from 443.
sub status {
    my ( $name, $port ) = @_;
    my $scheme = $port == [% tls_port %] ? 'https' : 'http';
    return `curl -sk --max-time 5 -o /dev/null -w '%{http_code}' --resolve '$name:$port:127.0.0.1' '$scheme://$name:$port/' 2>/dev/null` || '000';
}

# A reload starts new workers, which take a moment to answer.
sub settle { sleep 2; return }

my ( $tls, $http ) = ( listener(), listener() );
my $key = `$client register $domain 127.0.0.1:@{[ $tls->sockport ]} 127.0.0.1:@{[ $http->sockport ]} $name 2>&1`;
is( $?, 0, 'a guest registers a name' ) or diag $key;
like( $key, qr/\A[A-Za-z0-9+\/=]+\z/, 'and gets its key in base64 on one line' );
settle();

subtest 'a TLS connection goes by its SNI name, with the PROXY protocol' => sub {
    system("curl -sk --max-time 5 --resolve '$name:[% tls_port %]:127.0.0.1' 'https://$name:[% tls_port %]/' >/dev/null 2>&1 &");
    like( first_lines($tls), qr/\APROXY TCP4 127[.]0[.]0[.]1 /, 'the guest learns the address of the client' );
};

subtest 'a plain request goes by its Host header, with X-Forwarded-For' => sub {
    system("curl -s --max-time 5 --resolve '$name:80:127.0.0.1' 'http://$name/' -H 'X-Forwarded-For: 203.0.113.7' >/dev/null 2>&1 &");
    my $said = first_lines($http);
    like( $said, qr/^Host: \Q$name\E\r$/m,                'the guest gets the name' );
    like( $said, qr/^X-Forwarded-For: 127[.]0[.]0[.]1\r$/m, 'and the address that connected, not one that the client claims' );
};

is( status( 'nosuch.test.test', [% tls_port %] ), '000', 'a name that nobody registered gets no TLS handshake' );
is( status( 'nosuch.test.test', 80 ),  '000', 'and no reply on 80' );

# A rebuild puts the certificates back from the salvage, and nginx opens each
# one as www-data at the handshake.
foreach my $file ( glob '/etc/nginx/nginxrelay.d/media/*' ) {
    is( system( qw{runuser -u www-data -- test -r}, $file ), 0, "nginx can read $file, which it serves to readers" );
}

my $other = `$client register other-$domain 127.0.0.1:1 127.0.0.1:2 $name 2>&1`;
isnt( $?, 0, 'another domain cannot register the same name' );
like( $other, qr/\Q$name is registered to $domain\E/, 'and the refusal names the domain that holds it' );

# The key that the relay issued, as the guest of $domain holds it.  The test
# registered 127.0.0.1 as the address of that guest, so the key works from here.
my $keyfile = "/root/.nginxrelay-selftest.key";
{
    open( my $fh, '>', $keyfile ) or die "Cannot write $keyfile: $!\n";
    chmod 0600, $keyfile;
    print {$fh} MIME::Base64::decode_base64($key);
    close $fh or die "Cannot write $keyfile: $!\n";
}
sub as_guest {
    my ($request) = @_;
    my $said = `ssh -n -i $keyfile -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root\@127.0.0.1 '$request' 2>&1`;
    return ( $? >> 8, $said );
}
sub banned { return system("ipset test [% ban_set %] '$_[0]' >/dev/null 2>&1") == 0 }

# An address from the documentation ranges, which no client has.
my $abuser = '192.0.2.77';

subtest 'the key of a guest sends bans, and nothing else' => sub {
    my ( $rc, $said ) = as_guest("ban $abuser 600");
    is( $rc, 0, 'a guest bans an address' ) or diag $said;
    ok( banned($abuser), 'and the address is in the set' );

    my $rules = `iptables -S trog-[% ban_set %] 2>&1`;
    like( $rules, qr/--dports 80,[% tls_port %] .*--match-set [% ban_set %] src -j DROP/, 'whose members are dropped on the ports that the relay proxies' ) or diag $rules;

    system('ufw reload >/dev/null 2>&1');
    my @jumps = `iptables -S INPUT` =~ m/^-A INPUT -j trog-[% ban_set %]$/mg;
    is( scalar @jumps, 1, 'INPUT enters the chain once after a reload' );
    ok( banned($abuser), 'and the ban is still there' );

    ( $rc, $said ) = as_guest("check $abuser");
    is( $rc, 0, 'a guest can ask whether an address is banned' ) or diag $said;

    ( $rc, $said ) = as_guest('id');
    is( $rc, 2, 'and the key runs nothing but relay_ban' ) or diag $said;

    ( $rc, $said ) = as_guest("unban $abuser");
    is( $rc, 0, 'a guest unbans an address' ) or diag $said;
    ok( !banned($abuser), 'and the address leaves the set' );
};

# A media name, which this guest serves and caches, from an origin that stands
# in for the HTTP port of the guest.  The origin logs the request line of each
# request, and whether it had a cookie.  The name is short, because openssl
# refuses a common name of more than 64 characters.
my $media  = 'media.relay-selftest.test.test';
my $origin = listener();
my $origin_log = '/root/.nginxrelay-media-origin.log';
unlink $origin_log;
my $origin_pid = fork() // die "Cannot fork: $!\n";
if ( !$origin_pid ) {
    # prove reads the output of this test until every copy of it closes, so
    # the origin must not hold one.  It also gives up by itself.
    open( STDOUT, '>', '/dev/null' ) or die "Cannot close the output: $!\n";
    open( STDERR, '>', '/dev/null' ) or die "Cannot close the errors: $!\n";
    alarm 600;
    open( my $log, '>>', $origin_log ) or die "Cannot write $origin_log: $!\n";
    $log->autoflush(1);
    while ( my $conn = $origin->accept() ) {
        my $request = q{};
        while ( IO::Select->new($conn)->can_read(5) ) {
            sysread( $conn, my $buf, 4096 ) or last;
            $request .= $buf;
            last if $request =~ m/\r\n\r\n/;
        }
        my ($line) = $request =~ m/\A([^\r\n]*)/;
        print {$log} $line, ( $request =~ m/^Cookie:/mi ? ' cookie' : q{} ), "\n";
        my $body = "media probe\n";
        print {$conn} "HTTP/1.1 200 OK\r\nContent-Length: " . length($body) . "\r\nSet-Cookie: origin=1\r\nConnection: close\r\n\r\n$body";
        close $conn;
    }
    exit 0;
}
END {
    if ($origin_pid) {
        kill 'TERM', $origin_pid;
        waitpid( $origin_pid, 0 );
    }
}
sub origin_saw {
    my ($line) = @_;
    open( my $log, '<', $origin_log ) or return 0;
    return scalar grep { index( $_, $line ) == 0 } <$log>;
}

# What curl gets for a request to $media: the status, the headers and the body.
sub media_get {
    my ( $path, @curl ) = @_;
    my $out = `curl -sk --max-time 10 -D - --resolve '$media:[% tls_port %]:127.0.0.1' @curl 'https://$media:[% tls_port %]$path' 2>/dev/null`;
    my ($code) = $out =~ m{\AHTTP/\S+ (\d+)};
    return ( $code // '000', $out );
}

subtest 'a media name is served and cached here' => sub {
    my $said = `$client register $domain 127.0.0.1:@{[ $tls->sockport ]} 127.0.0.1:@{[ $origin->sockport ]} $name --media $media 2>&1`;
    is( $?, 0, 'a guest registers a media name' ) or diag $said;
    settle();
    is( ( media_get('/assets/probe.jpg') )[0], '000', 'before its certificate arrives, a TLS connection for it fails' );

    my $media_key = `$client media-key $domain 127.0.0.1 2>&1`;
    is( $?, 0, 'the guest gets a key for its certificates' ) or diag $media_key;
    my $keyfile = '/root/.nginxrelay-media.key';
    my $pem     = '/root/.nginxrelay-media.pem';
    open( my $fh, '>', $keyfile ) or die "Cannot write $keyfile: $!\n";
    chmod 0600, $keyfile;
    print {$fh} MIME::Base64::decode_base64($media_key);
    close $fh or die "Cannot write $keyfile: $!\n";
    my $made = `openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=$media -addext subjectAltName=DNS:$media -keyout $pem.key -out $pem.crt 2>&1 && cat $pem.crt $pem.key > $pem`;
    is( $?, 0, 'the test makes a certificate for the media name' ) or return diag $made;

    my $ssh = "ssh -i $keyfile -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root\@127.0.0.1";
    $said = `$ssh 'install $media' < $pem 2>&1`;
    is( $?, 0, 'and sends it with that key' ) or diag $said;
    $said = `$ssh 'install $name' < $pem 2>&1`;
    isnt( $?, 0, 'but the key cannot install a certificate for a name that passes through' );
    $said = `ssh -n -i $keyfile -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root\@127.0.0.1 id 2>&1`;
    unlike( $said, qr/uid=/, 'and it runs nothing else' );
    unlink $keyfile, $pem, "$pem.key", "$pem.crt";
    settle();

    my ( $code, $out ) = media_get( '/assets/probe.jpg', q{-H 'Cookie: session=1'} );
    is( $code, 200, 'a reader gets a file' ) or diag $out;
    like( $out, qr/^X-Relay-Cache: MISS\r$/mi, 'which the cache did not hold yet' );
    unlike( $out, qr/^Set-Cookie:/mi, 'without the cookie of the origin' );
    ( $code, $out ) = media_get('/assets/probe.jpg');
    like( $out, qr/^X-Relay-Cache: HIT\r$/mi, 'and the second time, the cache answers' );
    is( origin_saw('GET /assets/probe.jpg'), 1, 'so the origin saw one request' );
    unlike( do { open( my $log, '<', $origin_log ) or die "Cannot read $origin_log: $!\n"; local $/ = undef; <$log> }, qr/cookie/, 'and no cookie of a reader' );

    is( ( media_get('/assets/private/probe.jpg') )[0], 404, 'a private file gets 404' );
    is( origin_saw('GET /assets/private/'), 0, 'and the origin never sees the request' );
    is( ( media_get( '/assets/probe.jpg', '-X POST' ) )[0], 403, 'a POST is refused' );
    is( ( media_get( '/assets/probe.jpg', q{-H 'Host: other.test.test'} ) )[0], 421, 'and so is a Host that is not the name of the certificate' );

    my $redirect = `curl -s --max-time 5 -o /dev/null -w '%{http_code} %{redirect_url}' --resolve '$media:80:127.0.0.1' 'http://$media/assets/probe.jpg' 2>/dev/null`;
    is( $redirect, "301 https://$media/assets/probe.jpg", 'on 80, a media name goes to HTTPS' );
};
kill 'TERM', $origin_pid;
waitpid( $origin_pid, 0 );
$origin_pid = 0;
unlink $origin_log;

my $released = `$client release $domain 2>&1`;
is( $?, 0, 'a guest releases its names' ) or diag $released;
settle();
is( status( $name, 80 ), '000', 'and the name gets no reply after that' );
ok( !-e "/etc/nginx/nginxrelay.d/$domain.ban.pub", 'and its key is gone' );
ok( !-e "/etc/nginx/nginxrelay.d/media/$media.key", 'and so is the key of its media name' );
my ( $rc, $said ) = as_guest("check $abuser");
is( $rc, 255, 'and the key logs in no more' ) or diag $said;
unlink $keyfile;

done_testing();
