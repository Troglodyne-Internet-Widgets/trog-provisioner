#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

# A DN with anything but ASCII in it arrives base64 encoded, on both sides of
# the comparison at the bottom of this file.
use MIME::Base64 qw{decode_base64};

my $status = `systemctl is-active slapd 2>/dev/null`;
chomp $status;
is($status, 'active', 'slapd is running');

ok(-f '/etc/ldap/slapd.d/cn=config.ldif', 'slapd OLC config exists');

# Verify LDAPS port is listening
my $ldaps = `ss -tlnp 2>/dev/null | grep ':636'`;
ok($ldaps, 'LDAPS port 636 is listening');

# Verify base DN is accessible
my $search = `ldapsearch -x -H ldap:///  -b "[% base_dn %]" -s base 2>/dev/null`;
like($search, qr/dn:\s*[% base_dn %]/i, 'base DN is searchable');

# A package name that does not exist in the archive is not an error anywhere:
# it is simply never installed.  libldap-2.5-0 was in this list, and on Ubuntu
# 24.04 the archive has libldap2.
foreach my $pkg (qw{slapd ldap-utils libldap2}) {
    # dpkg -s rather than dpkg-query -f: a ${Status} format string is a Perl
    # variable inside backticks long before dpkg ever sees it.
    my $installed = `dpkg -s $pkg 2>/dev/null`;
    like($installed, qr/Status: install ok installed/, "$pkg is installed");
}

# LDAPS, against the certificate every guest has.  The TLS modify used to name
# dehydrated's output directly, which does not exist until letsencrypt has
# succeeded -- so on a fresh guest slapd refused it with error 80 and the build
# stopped there.
# Unfolded first: LDIF wraps at 78 columns and continues with a leading space,
# so a path this long arrives split across two lines and matches nothing.
my $tls = `ldapsearch -Y EXTERNAL -H ldapi:/// -b cn=config -LLL olcTLSCertificateFile 2>/dev/null`;
$tls =~ s/\n //g;
like($tls, qr{olcTLSCertificateFile:\s*/etc/ssl/certs/\Q[% domain %]\E\.pem},
    'slapd is configured with the certificate the ssl target links') or diag $tls;

ok(-e '/etc/ssl/certs/[% domain %].pem',    'and that certificate is there');

# No CA file is configured: on a fresh guest the only certificate is the
# self-signed pair the ssl target makes, which carries no basicConstraints and
# is not a CA -- and slapd refuses a server certificate offered as one.
my $ca = `ldapsearch -Y EXTERNAL -H ldapi:/// -b cn=config -LLL olcTLSCACertificateFile 2>/dev/null`;
$ca =~ s/\n //g;
unlike($ca, qr{olcTLSCACertificateFile:\s*/etc/ssl/certs/}, 'the server certificate is not offered as a CA')
    or diag $ca;
ok(-e '/etc/ssl/private/[% domain %].pem',  'along with its key');

# slapd has to be able to read the key, which it does as the openldap group.
my @stat = stat('/etc/ssl/private/[% domain %].pem');
is(scalar getgrgid($stat[5] // -1), 'openldap', 'the key is group openldap');

# AppArmor is what actually decides whether slapd may open the key.  It confines
# the executable rather than the account, and resolves the symlink out of
# /etc/ssl into /etc/letsencrypt before deciding -- so checking the file as the
# openldap user says nothing about it.  Four correct permission fixes went in
# ahead of this one and none of them was the reason.
ok(-s '/etc/apparmor.d/local/usr.sbin.slapd', 'the AppArmor override for slapd is installed');
my $aa = do { local (@ARGV, $/) = '/etc/apparmor.d/local/usr.sbin.slapd'; <> } // '';
like($aa, qr{/etc/letsencrypt/live/\*\* r}, 'and lets slapd read the certificate directory');

# Nothing denied since boot, which is the only place this failure is recorded.
my $denials = `grep -a 'apparmor="DENIED"' /var/log/audit/audit.log 2>/dev/null | grep -ac slapd`;
chomp $denials;
is($denials + 0, 0, 'and AppArmor has denied slapd nothing') or diag `grep -a 'apparmor="DENIED"' /var/log/audit/audit.log 2>/dev/null | grep -a slapd | tail -3`;

# Owning the file is not the same as reaching it: /etc/ssl/private is
# 0710 root:ssl-cert, so openldap has to be in that group to traverse it.  When
# it could not, the TLS modify failed with error 80 and said nothing about why.
# The group that makes /etc/ssl/private traversable at all.  It comes from the
# ssl-cert package, and without that package it does not exist -- `adduser
# openldap ssl-cert` then fails with "The group `ssl-cert' does not exist" and
# takes the target with it.
my $groups = `id -nG openldap 2>/dev/null`;
like($groups, qr/\bssl-cert\b/, 'openldap is in the ssl-cert group') or diag $groups;

# And the running slapd is in it too.  Group membership applies to a process
# started after the change, so a slapd restarted before joining the group is one
# that still cannot read the key -- the same error 80, from a process whose
# account has the right group and whose process does not.
my ($pid) = `systemctl show -p MainPID --value slapd 2>/dev/null` =~ m/(\d+)/;
SKIP: {
    skip 'slapd is not running', 1 unless $pid;
    my $procgroups = do { local (@ARGV, $/) = "/proc/$pid/status"; <> } // '';
    my ($gids) = $procgroups =~ m/^Groups:\s*(.*)$/m;
    my $sslcert = getgrnam('ssl-cert');
    ok(defined $sslcert && defined $gids && grep({ $_ == $sslcert } split ' ', $gids),
        'and so is the running slapd process') or diag "slapd groups: $gids";
}

foreach my $f ('/etc/ssl/certs/[% domain %].pem', '/etc/ssl/private/[% domain %].pem') {
    my $rc = system("sudo -u openldap test -r '$f'");
    is($rc, 0, "openldap can read $f");
}

my $services = `grep -oP '^SLAPD_SERVICES=.*' /etc/default/slapd 2>/dev/null`;
like($services, qr/ldaps:/, 'slapd is listening for ldaps') or diag $services;

# What a rebuild will be rebuilt from.
#
# The directory is the one thing here nothing regenerates: the seed knows the
# accounts as users.yaml describes them and knows nothing about the password
# somebody changed or the SSH key they added afterwards.  /var/lib/ldap is
# 0700 openldap:openldap and the fetch is sftp as the admin user with no sudo,
# so what has to exist is an export the admin user can read.
my $export_dir = '/var/backups/ldap';
ok(-d $export_dir, 'the directory is exported to somewhere the fetch can reach');

my @dstat = stat($export_dir);
is(scalar getpwuid($dstat[4] // -1), '[% admin_user %]',
    'the export belongs to the admin user, who is the one who fetches it');
is(($dstat[2] // 0) & 07777, 0700, 'and nobody else on the guest can read it')
    or diag sprintf('mode %04o', ($dstat[2] // 0) & 07777);

foreach my $ldif (qw{data.ldif config.ldif}) {
    ok(-s "$export_dir/$ldif", "$ldif was exported and is not an empty file");

    # Exactly what the fetch does: sftp as the admin user, no sudo, and no
    # error anywhere when it turns out it cannot read the thing it came for.
    my $rc = system("sudo -u [% admin_user %] test -r '$export_dir/$ldif'");
    is($rc, 0, "and the admin user can read $ldif");
}

# LDIF wraps at 78 columns and continues with a leading space, so a DN longer
# than that arrives split across two lines and matches nothing.
sub unwrapped {
    my ($path) = @_;
    my $body = do { local (@ARGV, $/) = $path; <> } // '';
    $body =~ s/\n //g;
    return $body;
}

my $exported = unwrapped("$export_dir/data.ldif");
like($exported, qr/^dn:\s*\Q[% base_dn %]\E$/mi, 'the data export is this domain and not an empty database');

[% FOR u IN users %]
like($exported, qr/^dn:\s*uid=\Q[% u.name %]\E,ou=People/mi, 'the export caught [% u.name %]');
[% END %]

my $exported_config = unwrapped("$export_dir/config.ldif");
like($exported_config, qr/^dn:\s*cn=config$/mi, 'and the configuration database is exported beside it');

ok(-x '/usr/local/sbin/ldap-export.sh', 'the exporter is installed');
ok(-x '/usr/local/sbin/ldap-reload.sh', 'and so is the reloader the next guest runs');

# Hourly, because an hour is what a rebuild is allowed to lose.  An export that
# only ever ran during the provision would age into a directory as it was on
# build day, which is the failure this whole arrangement exists to prevent.
my $export_cron = do { local (@ARGV, $/) = '/etc/cron.d/ldap-export'; <> } // '';
like($export_cron, qr{^\S+ \S+ \S+ \S+ \S+ +root +/usr/local/sbin/ldap-export\.sh}m,
    'and it is run on a cron rather than only at provision time') or diag $export_cron;

# And the other end of it: what came off the last guest is in the directory this
# one is serving.  slapcat rather than ldapsearch on both sides -- it reads the
# database as root, so no ACL hides an entry from the comparison and no
# olcSizeLimit truncates it into a false pass.
sub dns_of {
    my ($body) = @_;
    my @dns;
    foreach my $line (split m/\n/, $body) {
        push @dns, $1                if $line =~ m/^dn:\s+(.*)$/;
        push @dns, decode_base64($1) if $line =~ m/^dn::\s+(.*)$/;
    }

    # A DN is case-insensitive and the space after a comma is not part of it.
    return map { my $d = lc $_; $d =~ s/,\s+/,/g; $d } @dns;
}

my $reloaded = '/var/backups/ldap-reloaded.ldif';
SKIP: {
    skip 'this guest had nothing salvaged to reload, so it seeded its directory instead', 1
        unless -s $reloaded;

    my %live = map { $_ => 1 } dns_of(`slapcat -F /etc/ldap/slapd.d -b '[% base_dn %]' 2>/dev/null`);
    my @lost = grep { !$live{$_} } dns_of(unwrapped($reloaded));

    is(scalar @lost, 0, 'every entry the previous guest had is in the directory this one serves')
        or diag "missing: " . join(', ', splice(@lost, 0, 10));
}

done_testing();
