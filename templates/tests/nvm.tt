#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $user = '[% user %]';
my $home = "/home/$user";

ok(-d "$home/.nvm", 'nvm directory exists');

my $node_version = `su - $user -s /bin/bash -c '. ~/.nvm/nvm.sh && node --version' 2>/dev/null`;
chomp $node_version;
ok($node_version =~ /^v\d+/, "node is installed via nvm ($node_version)");

my $bashrc = do { local $/; open my $fh, '<', "$home/.bashrc" or die $!; <$fh> };
ok($bashrc =~ /nvm use node/, '.bashrc includes "nvm use node"');

done_testing();
