#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;

my $user = '[% user %]';

# Ask passwd, not /home/$user.  A service user's home is the domain directory,
# and the admin user's home is under /home.  This recipe serves both.
chomp(my $home = `getent passwd $user | cut -d: -f6`);
ok($home, "$user has a home directory") or BAIL_OUT("no home for $user");

ok(-d "$home/.nvm", 'nvm directory exists');

# The home must also have a profile that loads nvm.  The nvm installer refuses
# to write its loader when it finds no profile: "Profile not found. Tried
# ~/.bashrc ...".  useradd makes the home of a service user with no skeleton,
# so that home has no profile.
my $bashrc = do { local (@ARGV, $/) = "$home/.bashrc"; <> } // '';
like($bashrc, qr/NVM_DIR/, "$home/.bashrc loads nvm") or diag $bashrc;
like($bashrc, qr{nvm\.sh}, 'by sourcing nvm.sh');

# .bashrc returns early in a non-interactive shell, so each command needs -i
# to get nvm.  Quote the command: `bash -c which node` runs which with no
# arguments, and node becomes $0.
chomp( my $system_node = `command -v node 2>/dev/null` );
chomp( my $user_node   = `sudo -u $user /bin/bash -ic 'command -v node' 2>/dev/null` );

ok( $user_node, "$user has a node on PATH" ) or diag 'nvm did not reach the login shell';
isnt( $user_node, $system_node, 'and it is nvm\'s rather than the system one' );

# Run node, not only find it.  The node builds that nvm downloads link against
# libatomic.so.1, and `command -v node` gives a path even when node cannot
# start.
my $node_version = `sudo -u $user /bin/bash -ic 'node --version' 2>&1`;
like( $node_version, qr/^v\d+\.\d+\.\d+$/m, 'and it runs' ) or diag $node_version;

chomp( my $node_path = `sudo -u $user /bin/bash -ic 'echo \$NODE_PATH' 2>/dev/null` );

# Read both streams and pick the path out of them.  An interactive shell writes
# job-control messages and profile output to stderr, and npm adds its own
# notices.  The diag below prints all of it when the comparison fails.
my $npm_raw = `sudo -u $user /bin/bash -ic 'npm root -g' 2>&1`;
my ($npm_root) = grep { m{^/} } split m/\n/, ( $npm_raw // '' );
$npm_root //= '';

like( $node_path, qr{/lib/node_modules$}, 'NODE_PATH set to a global node_modules dir' );
ok( -d $node_path, "NODE_PATH ($node_path) exists" );
SKIP: {
    # npm redacts anything that looks like a classic auth token in its output,
    # and a classic npm token is a UUID.  So on a guest whose domain is a UUID,
    # the path comes back with *** in place of the domain.  The recipe is not
    # wrong, but nothing is left to compare.
    skip 'npm redacted the path (the domain is shaped like an npm token)', 1
        if $npm_root =~ m/\Q***\E/;

    is( $node_path, $npm_root, 'NODE_PATH matches the active node install global module root' )
        or diag "npm root -g said:\n$npm_raw";
}

done_testing();
