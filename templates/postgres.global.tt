yes | /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh
# Determine version: use configured value or detect latest available from PGDG
[% IF version -%]
PG_VERSION=[% version %]
[% ELSE -%]
PG_VERSION=$$(apt-cache search '^postgresql-[0-9]' | awk '{print $$1}' | grep -oP '[0-9]+$$' | sort -rn | head -1)
[% END -%]
# $$ throughout: these are shell expansions in a make recipe, and make eats a
# single $ before the shell sees it.  With PG_VERSION empty this asked apt for
# `postgresql-client-`, and a trailing - is how apt spells "remove" -- so this
# uninstalled postgres rather than installing it.  server-dev was pinned to 18
# while everything beside it followed the detected version.
[% packager_invocation | mark_raw %] postgresql-client-$${PG_VERSION} postgresql-$${PG_VERSION} postgresql-server-dev-$${PG_VERSION} postgresql-plperl-$${PG_VERSION}
systemctl enable postgresql
[% script_dir %]/queue_postrun_task systemctl restart postgresql
# Allow local TCP connections with md5 auth
# $$f, not $f: this is a make recipe line, and make eats a single $ before the
# shell ever sees it -- which left `grep ... ""` and appended to nothing.
for f in /etc/postgresql/*/main/pg_hba.conf; do grep -qF 'host all all 127.0.0.1/32 md5' "$$f" || echo 'host all all 127.0.0.1/32 md5' >> "$$f"; done
