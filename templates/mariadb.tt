mkdir -p /opt/mysql; /bin/true
mv mariadb.service /opt/mysql
mv my.cnf /opt/mysql
ln -sfn /opt/mysql /opt/mariadb
# Install global schema for the recipe
id -u mysql >/dev/null 2>&1 || useradd -s /usr/sbin/nologin -d /opt/mariadb mysql
[%# Quoted, so a variable that renders empty stays an argument.  Unquoted, an
    empty user shifted every argument left: the script read the version as its
    client and the dump path as its version, and asked archive.mariadb.org for
    mariadb-/opt/domains/<domain>/dump.sql. -%]
[% script_dir %]/install_mariadb.sh "[% user %]" "[% version %]" "[% install_dir %]/[% domain %]/[% dumpfile %]"
# Secure the mysql install (run once - root_pw is baked into the sql file)
[ -f /opt/mysql/.secured ] || (mv secure_installation.sql /opt/mysql && mysql --defaults-file=/opt/mariadb/my.cnf -sfu root < /opt/mysql/secure_installation.sql && touch /opt/mysql/.secured)
rm -f secure_installation.sql /opt/mysql/secure_installation.sql
# Install nightly logical backup script and cron job
install -m 0750 mariadb-backup.sh /usr/local/sbin/mariadb-backup.sh
install -m 0644 mariadb-backup.cron /etc/cron.d/mariadb-backup
mkdir -p /var/backups/mysql
