# Install nvm for [% user %] with the official install script.  It is safe to run again.
# PROFILE=/dev/null keeps it out of every profile, because bashrc_d loads nvm.
su - [% user %] -s /bin/bash -c \
    "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/[% nvm_version %]/install.sh | PROFILE=/dev/null bash"

# Install the latest Node.js and make it the default alias
su - [% user %] -s /bin/bash -c \
    ". ~/.nvm/nvm.sh && nvm install node && nvm alias default node"

# The loader, nvm use node and NODE_PATH, in ~/.bashrc.d of the user.
[% script_dir %]/bashrc_d [% user %] 20-nvm nvm.bashrc
