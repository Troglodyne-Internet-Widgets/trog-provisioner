# Create torrent storage directory - readable by nginx (www-data)
mkdir -p [% install_dir %]/[% domain %]/torrents
chown debian-deluged:www-data [% install_dir %]/[% domain %]/torrents
chmod 0750 [% install_dir %]/[% domain %]/torrents
# Deploy deluged core config before first start so download_location is set
mkdir -p /var/lib/deluged/config
if [ ! -f /var/lib/deluged/config/core.conf ]; then \
    mv deluged_core.conf /var/lib/deluged/config/core.conf; \
    chown root:debian-deluged /var/lib/deluged/config/core.conf; \
    chmod 0640 /var/lib/deluged/config/core.conf; \
fi
[%# The torrent state off the last guest, put back before the daemon starts.
    Provisioner::Recipe::deluged, "What survives a rebuild", says what is in
    there and why the rest of the config directory is not.

    The directory is made here because deluged has not started yet to make it,
    and because restore_state fills an existing empty directory rather than
    nesting the copy inside it.  A destination that already has torrents in it
    is a guest that is still running, and it keeps what it has. -%]
mkdir -p /var/lib/deluged/config/state
chown -R debian-deluged:debian-deluged /var/lib/deluged/config
[%# And now open the path down to the state to the admin user, because the
    salvage that preserves it is an sftp session as that user with no sudo: a
    tree owned debian-deluged:debian-deluged is one it can neither list nor
    walk into, and what comes back is an empty directory and no complaint.  The
    group stops at the state -- core.conf holds this domain configuration and
    nothing off the guest needs to read it. -%]
chown debian-deluged:[% admin_user %] /var/lib/deluged /var/lib/deluged/config
chmod 0750 /var/lib/deluged /var/lib/deluged/config
chown -R debian-deluged:[% admin_user %] /var/lib/deluged/config/state
[%# Spelled out per type rather than with u=rwX,g=rX.  A capital X sets execute
    on a directory, or on anything that already has it -- and the data target
    lands the whole domain directory 0750, so every restored file arrives with
    the bit set and keeps it, and torrent state comes back executable.  A first
    build never shows this, since what deluged writes itself has no execute bit
    for X to preserve. -%]
find /var/lib/deluged/config/state -type d -exec chmod 0750 {} +
find /var/lib/deluged/config/state -type f -exec chmod 0640 {} +
# Enable and queue service starts
systemctl enable deluged
systemctl enable deluge-web
[% script_dir %]/queue_postrun_task systemctl start deluged
[% script_dir %]/queue_postrun_task systemctl start deluge-web
# UFW application profile for BitTorrent ports
mv deluged_ufw.conf /etc/ufw/applications.d/deluged
chown root:root /etc/ufw/applications.d/deluged
chmod 0644 /etc/ufw/applications.d/deluged
