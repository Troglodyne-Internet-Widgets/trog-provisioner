# Not recursive, because the target of each domain keeps its own mail store
# under /mail closed.
install -d -m 0775 -o dovecot -g dovecot /mail /mail/scripts
install -m 0775 -o dovecot -g dovecot [% script_dir %]/dovecot_overquota /mail/scripts/
[%# Compiled here as root, because dovecot cannot write the binary into /etc
    when it delivers. -%]
[%# The amavis configuration of the guest.  Each domain adds its own file after
    it.  50-user is what a domain used to write: it assigned the list of local
    domains, after this file empties it, so it must not stay. -%]
install -m 0644 -o root -g root amavis.global /etc/amavis/conf.d/40-trog-mail
rm -f /etc/amavis/conf.d/50-user
[%# SpamAssassin.  The scores of the Validity lists and, where this guest has
    a resolver of its own, the address that SpamAssassin asks.  The file is in
    /etc/spamassassin, which amavis reads when it starts, and the restart of
    amavis is queued by the target of each domain.  Provisioner::Recipe::mail
    has the whole account, under Spam. -%]
install -m 0644 -o root -g root mail_spamassassin.cf /etc/spamassassin/60-trog-mail.cf
[%# The recursive resolver, first, so that it answers before anything asks it.
    The file always goes in, because it names the one interface that unbound
    listens on.  Off, unbound stops, so that it holds no port. -%]
install -d -m 0755 -o root -g root /etc/unbound/unbound.conf.d
install -m 0644 -o root -g root mail_unbound.conf /etc/unbound/unbound.conf.d/trog-mail.conf
[% IF local_resolver -%]
unbound-checkconf
systemctl enable unbound
systemctl restart unbound
[% ELSE -%]
systemctl disable --now unbound; /bin/true
[% END -%]
[%# The rules, every day.  The timer is the one that the package ships and
    leaves off.  amavis loads the rules only when it starts, so the drop-in
    restarts it after an update that changed one.  The update runs once here as
    well, so that a new guest does not score with the rules of the package for
    a day.  sa-update exits 0 when it updated and 1 when there was nothing to
    update; any other status is a failure.  Egress is port 80, 443 and 53, which
    the APT profile of ufw opens for every guest. -%]
install -d -m 0755 -o root -g root /etc/systemd/system/spamassassin-maintenance.service.d
install -m 0644 -o root -g root mail_spamassassin_update.conf /etc/systemd/system/spamassassin-maintenance.service.d/trog-mail.conf
systemctl daemon-reload
systemctl enable --now spamassassin-maintenance.timer
sa-update || test $$? -eq 1
install -d -m 0755 -o root -g root /etc/dovecot/sieve
install -m 0644 -o root -g root junk.sieve /etc/dovecot/sieve/junk.sieve
sievec /etc/dovecot/sieve/junk.sieve
# The half of the mail configuration that is about this guest, not about a
# domain.  It goes into the fragment directories that configd makes the files
# of postfix and opendkim from.  It is said once, here, because configd joins
# list parameters across fragments.  If two domains each name opendkim in
# smtpd_milters, postfix signs every message two times.
#
# This target makes the directories too, with the modes that `configd adopt`
# gives them.  The makefile does not set which of the two runs first.
install -d -m 0755 -o root -g root /etc/postfix/main.cf.d
install -d -m 0755 -o root -g root /etc/postfix/master.cf.d
install -d -m 0755 -o root -g root /etc/opendkim.conf.d
# The dovecot account exists only on the guest, so its uid goes in here and
# not in the rendered template.
sed -i "s/%DOVECOT_UID%/$$(id -u dovecot)/g" main.cf.global
install -m 0644 -o root -g root main.cf.global /etc/postfix/main.cf.d/40-mail
install -m 0600 -o root -g root master.cf /etc/postfix/master.cf.d/40-mail
[%# The firewall of the ports where a mail relay passes the mail clients.
    Provisioner::Recipe::mail has the whole account, under Sending through a
    mail relay. -%]
install -d -m 0755 -o root -g root /etc/mail-proxy-from.d
install -d -o root -g root -m 0750 /etc/ufw/after.init.d
install -o root -g root -m 0750 mail_proxy_from /etc/ufw/after.init.d/mail-proxy-from
# 0600 root:root, not the opendkim account.  configd reads the fragments as
# root from ExecStartPre, and the daemon never reads them.
install -m 0600 -o root -g root opendkim.conf /etc/opendkim.conf.d/40-mail
[% INCLUDE "files/milter_client.tt" %]
