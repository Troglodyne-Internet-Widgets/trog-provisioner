mkdir -p /mail/scripts
cp [% script_dir %]/dovecot_overquota /mail/scripts
chown -R dovecot:dovecot /mail
chmod -R 0775 /mail
# The half of the mail configuration that is about this guest, not about a
# domain.  It goes into the fragment directories that configd makes the files
# of postfix and opendkim from.  It is said once, here, because configd joins
# list parameters across fragments.  If two domains each name opendkim in
# smtpd_milters, postfix signs every message two times.
#
# This target makes the directories too, with the modes that `configd adopt`
# gives them.  The makefile does not set which of the two runs first.
install -d -m 0755 -o root -g root /etc/postfix/main.cf.d
install -d -m 0755 -o root -g root /etc/postfix/master.cf.d
install -d -m 0755 -o root -g root /etc/opendkim.conf.d
# The dovecot account exists only on the guest, so its uid goes in here and
# not in the rendered template.
sed -i "s/%DOVECOT_UID%/$$(id -u dovecot)/g" main.cf.global
install -m 0644 -o root -g root main.cf.global /etc/postfix/main.cf.d/40-mail
install -m 0600 -o root -g root master.cf /etc/postfix/master.cf.d/40-mail
# 0600 root:root, not the opendkim account.  configd reads the fragments as
# root from ExecStartPre, and the daemon never reads them.
install -m 0600 -o root -g root opendkim.conf /etc/opendkim.conf.d/40-mail
