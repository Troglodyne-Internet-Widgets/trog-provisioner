mkdir -p /mail/scripts
cp [% script_dir %]/dovecot_overquota /mail/scripts
chown -R dovecot:dovecot /mail
chmod -R 0775 /mail
# The half of the mail stack's configuration that is about this guest rather
# than about a domain, dropped into the fragment directories configd generates
# postfix's and opendkim's files from.  Said once, here, because configd joins
# list parameters across fragments -- and two domains each naming opendkim in
# smtpd_milters would have postfix sign every message twice.
#
# The directories are made here as well as by `configd adopt`, with the modes
# adopt would give them, because the makefile does not promise which of us runs
# first.
install -d -m 0755 -o root -g root /etc/postfix/main.cf.d
install -d -m 0755 -o root -g root /etc/postfix/master.cf.d
install -d -m 0755 -o root -g root /etc/opendkim.conf.d
# The dovecot account only exists on the guest, so its uid goes in here rather
# than in the rendered template.
sed -i "s/%DOVECOT_UID%/$$(id -u dovecot)/g" main.cf.global
install -m 0644 -o root -g root main.cf.global /etc/postfix/main.cf.d/40-mail
install -m 0600 -o root -g root master.cf /etc/postfix/master.cf.d/40-mail
# 0600 root:root, not opendkim's own: the fragments are read by configd running
# as root out of ExecStartPre, and never by the daemon.
install -m 0600 -o root -g root opendkim.conf /etc/opendkim.conf.d/40-mail
