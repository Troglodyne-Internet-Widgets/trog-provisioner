# App::Clod.  Provisioner::Recipe::clod describes the layout on the guest.

# Clone or refresh the checkout.  Each command sets HOME, because atd starts
# the makefile without one.
if [ ! -d '[% install_dir %]/[% domain %]/App-Clod/.git' ]; then \
    HOME='[% install_dir %]/[% domain %]' git clone --branch '[% repo_branch %]' '[% repo_url %]' '[% install_dir %]/[% domain %]/App-Clod'; \
else \
    cd '[% install_dir %]/[% domain %]/App-Clod' \
        && HOME='[% install_dir %]/[% domain %]' git fetch origin \
        && HOME='[% install_dir %]/[% domain %]' git reset --hard 'origin/[% repo_branch %]'; \
fi
HOME='[% install_dir %]/[% domain %]' git config --global --get-all safe.directory 2>/dev/null | grep -qFx '[% install_dir %]/[% domain %]/App-Clod' \
    || HOME='[% install_dir %]/[% domain %]' git config --global --add safe.directory '[% install_dir %]/[% domain %]/App-Clod'

# The database and the workspace belong to the service user.  run/ is setgid
# www-data, so the socket takes that group, and nginx can connect to it.
install -d -o '[% user %]' -g '[% admin_user %]' -m 0750 '[% install_dir %]/[% domain %]/clod-state'
install -d -o '[% user %]' -g '[% admin_user %]' -m 0750 '[% local_lib %]'
[%# The tools of the agent, which it may read and not change.  The group of
    the admin, because the agent account does not exist yet: clod-share.sh
    gives it to the agent.  THE AGENT LIB in Provisioner::Recipe::clod. -%]
install -d -o '[% user %]' -g '[% admin_user %]' -m 2750 '[% agent_lib %]'
[% IF agent_user -%]
[%# clod-share.sh shares the workspace with the agent account, in the postrun,
    before the restart below.  The script says why it waits. -%]
install -o root -g root -m 0700 clod-share.sh '[% install_dir %]/[% domain %]/clod-share.sh'
[%# The token waits here, for root alone, until clod-share.sh gives it to the
    agent.  The wrapper is for every account to run, and for none to change. -%]
install -o root -g root -m 0600 clod-agent.token '[% install_dir %]/[% domain %]/clod-agent.token'
install -o root -g root -m 0755 clod-claude.sh '[% install_dir %]/[% domain %]/clod-claude.sh'
[% script_dir %]/queue_postrun_task '[% install_dir %]/[% domain %]/clod-share.sh'
[% ELSE -%]
install -d -o '[% user %]' -g '[% admin_user %]' -m 0750 '[% install_dir %]/[% domain %]/workspace'
[% END -%]
# visudo first, because sudo refuses to run at all while a file in
# sudoers.d does not parse.
visudo -cf clod.sudoers
install -m 0440 -o root -g root clod.sudoers '/etc/sudoers.d/clod-[% user %]'
install -d -o '[% user %]' -g www-data -m 2750 '[% install_dir %]/[% domain %]/run'
chown -R '[% user %]:[% admin_user %]' '[% install_dir %]/[% domain %]/App-Clod'
chown '[% user %]:[% admin_user %]' '[% install_dir %]/[% domain %]/.gitconfig'

# The service user reads its configuration and secrets, and cannot change them.
install -o root -g '[% user %]' -m 0640 clod.conf '[% install_dir %]/[% domain %]/clod.conf'
install -o root -g '[% user %]' -m 0640 clod.env  '[% install_dir %]/[% domain %]/clod.env'
install -o root -g root -m 0700 clod-salvage.sh '[% install_dir %]/[% domain %]/clod-salvage.sh'
[%# Root owns it, every account may run it, and none may change it.  servicesudo lets
    the service user run it as root.  THE SYSTEM PACKAGES in
    Provisioner::Recipe::clod. -%]
install -o root -g root -m 0755 clod-install-packages '[% installer %]'

install -o root -g root -m 0644 clod.service        '/etc/systemd/system/clod-[% domain %].service'
install -o root -g root -m 0644 clod-worker.service '/etc/systemd/system/clod-worker-[% domain %].service'
systemctl daemon-reload
systemctl enable 'clod-[% domain %].service' 'clod-worker-[% domain %].service'

# Fill the local lib, and then start the units, after the perl target has
# installed what the checkout needs, so that clod deps can run.  restart, so
# that a provision of a running guest loads the new checkout.
install -o root -g root -m 0755 clod-deps.sh '[% install_dir %]/[% domain %]/clod-deps.sh'
[% script_dir %]/queue_postrun_task '[% install_dir %]/[% domain %]/clod-deps.sh'
[% script_dir %]/queue_postrun_task systemctl restart 'clod-[% domain %].service' 'clod-worker-[% domain %].service'
