mv backupdestination.logrotate /etc/logrotate.d/backups
[%# Same rule the cron.d file has to keep: logrotate passes over a config it does
    not find owned by root, or that anyone else can write, and says so nowhere
    but its own --debug output.  A file moved out of the payload keeps the
    ownership recorded in the tarball, which is whoever generated it -- so the
    backup log grew without ever being rotated. -%]
chown root:root /etc/logrotate.d/backups
chmod 0644 /etc/logrotate.d/backups
mkdir -p /var/log/backups; /bin/true
