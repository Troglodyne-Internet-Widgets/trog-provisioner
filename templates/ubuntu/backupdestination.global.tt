mv backupdestination.logrotate /etc/logrotate.d/backups
[%# Owned by root and mode 0644, or logrotate skips the file and reports it
    only in its --debug output.  A file moved out of the payload keeps the
    owner recorded in the tarball, which is the user who built it. -%]
chown root:root /etc/logrotate.d/backups
chmod 0644 /etc/logrotate.d/backups
mkdir -p /var/log/backups; /bin/true
