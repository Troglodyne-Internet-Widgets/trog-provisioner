# Install PerlNavigator LSP server globally via npm
npm install -g perlnavigator-server

# Install vim-lsp plugin family into admin user's native vim pack directory.
# vim 8+ loads packages from ~/.vim/pack/*/start/ automatically - no plugin manager needed.
mkdir -p /home/[% admin_user %]/.vim/pack/lsp/start

[%# Each as the tarball of its pinned commit, through the fetch cache when there
    is one, into a directory emptied first: a clone into one that already
    existed failed every re-provision, and a tarball unpacked over an older one
    would leave the files the newer commit deleted.  The ref is written beside
    it so that the guest test can say which commit is there. -%]
[% FOR plugin IN plugins -%]
[% script_dir %]/fetch 'https://codeload.github.com/[% plugin.repo %]/tar.gz/[% plugin.ref %]' 'perllsp.[% plugin.dir %].tar.gz'
rm -rf '/home/[% admin_user %]/.vim/pack/lsp/start/[% plugin.dir %]'
mkdir -p '/home/[% admin_user %]/.vim/pack/lsp/start/[% plugin.dir %]'
tar -xzf 'perllsp.[% plugin.dir %].tar.gz' --strip-components=1 -C '/home/[% admin_user %]/.vim/pack/lsp/start/[% plugin.dir %]'
echo '[% plugin.ref %]' > '/home/[% admin_user %]/.vim/pack/lsp/start/[% plugin.dir %]/.trog-ref'
[% END -%]

chown -R [% admin_user %]:[% admin_user %] /home/[% admin_user %]/.vim

# Drop the perllsp vimrc snippet into ~/.vim/ and source it from ~/.vimrc
install -m 0644 -o [% admin_user %] -g [% admin_user %] perllsp.vim /home/[% admin_user %]/.vim/perllsp.vim

[%# Only if it is not already sourced.  Unconditional, this added another
    identical source line to the vimrc on every re-provision. -%]
grep -qF 'source ~/.vim/perllsp.vim' /home/[% admin_user %]/.vimrc 2>/dev/null \
    || echo "source ~/.vim/perllsp.vim" >> /home/[% admin_user %]/.vimrc
chown [% admin_user %]:[% admin_user %] /home/[% admin_user %]/.vimrc
