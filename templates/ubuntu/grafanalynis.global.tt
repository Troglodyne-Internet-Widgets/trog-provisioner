[%# One processor and one dashboard for the machine, so all of it is in the
    global half.  Provisioner::Recipe::grafanalynis has what the processor adds.

    The targets of grafana and telegraf come below this one, because this
    recipe requires grafanasyslog, so root owns these files, as in
    grafanasyslog.global.tt. -%]
install -d -m 0755 /etc/telegraf/telegraf.d
install -o root -g root -m 0644 grafanalynis_telegraf.conf /etc/telegraf/telegraf.d/62-lynis.conf
install -o root -g root -m 0644 grafanalynis_findings.star /etc/telegraf/lynis_findings.star
install -d -m 0755 /var/lib/grafana/dashboards
install -o root -g root -m 0644 grafanalynis_dashboard.json /var/lib/grafana/dashboards/lynis.json
[% script_dir %]/queue_postrun_task systemctl restart telegraf
echo 'grafanalynis: telegraf reads the Lynis summaries and findings out of the syslog stream, and the Lynis audits dashboard draws them.'
