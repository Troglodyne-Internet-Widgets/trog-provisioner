[%# One manager for the machine, so all of it is in the global half.
    Provisioner::Recipe::ossec has the path that a message takes.

    The package comes in at first boot, so the manager is here.  Telegraf and
    grafana come in with the targets below this one, which is why root owns
    their files, as in grafanasyslog.global.tt. -%]
[%# configd makes ossec.conf from the file of the package and this fragment.
    It adopts the file in the configd target, which comes after this one, and
    the manager must not run the defaults of the package until then: they open
    the listener of the agents and block addresses in the firewall.  So it
    stops here, and the checks and the start wait for the end of the build. -%]
install -d -m 0750 -o root -g ossec /var/ossec/etc/ossec.conf.d
install -m 0640 -o root -g ossec ossec.conf /var/ossec/etc/ossec.conf.d/50-ossec
install -m 0640 -o root -g ossec watchers_rules.xml /var/ossec/rules/watchers_rules.xml
systemctl stop ossec
[%# ossec-control starts only the daemons in its process list, and the daemon
    that sends the alerts is not in it until this line adds it. -%]
/var/ossec/bin/ossec-control enable client-syslog
[%# Each daemon checks the configuration that configd made, so a mistake
    stops the build and not the manager later. -%]
[% script_dir %]/queue_postrun_task /var/ossec/bin/ossec-analysisd -t
[% script_dir %]/queue_postrun_task /var/ossec/bin/ossec-remoted -t
[% script_dir %]/queue_postrun_task /var/ossec/bin/ossec-csyslogd -t
[% script_dir %]/queue_postrun_task systemctl enable ossec
[% script_dir %]/queue_postrun_task systemctl restart ossec
install -d -m 0755 /etc/telegraf/telegraf.d
install -o root -g root -m 0644 ossec_telegraf.conf /etc/telegraf/telegraf.d/61-ossec.conf
install -o root -g root -m 0644 ossec_alerts.star /etc/telegraf/ossec_alerts.star
install -d -m 0755 /var/lib/grafana/dashboards
install -o root -g root -m 0644 ossec_dashboard.json /var/lib/grafana/dashboards/ossec.json
[% script_dir %]/queue_postrun_task systemctl restart telegraf
echo 'ossec: the manager reads the collector stream on 127.0.0.1:[% port %], and its alerts are drawn on the OSSEC alerts dashboard.'
