[%# The spool is outside install_dir on purpose.  On every provision, the data
    target applies chown and chmod recursively to install_dir/domain, and this
    is a few million files.  See perldoc Provisioner::Recipe::aptmirror. -%]
mkdir -p '[% spool %]'
chown apt-mirror:apt-mirror '[% spool %]'
[%# Made as their owner, not made as root and then given a chown.  A chown -R
    here walks the whole mirror, which is the cost that the spool avoids by
    being outside install_dir. -%]
runuser -u apt-mirror -- mkdir -p '[% mirror_root %]' '[% spool %]/skel' '[% spool %]/var'
[%# A dpkg conffile.  The packaged copy holds only commented-out defaults.  This
    copy survives a package upgrade, because the apt command in
    Provisioner::Recipe::ubuntu passes --force-confold. -%]
install -o root -g root -m 0644 aptmirror.mirror.list /etc/apt/mirror.list
install -o apt-mirror -g apt-mirror -m 0755 aptmirror.postmirror.sh '[% spool %]/var/postmirror.sh'
install -o root -g root -m 0644 aptmirror.service /etc/systemd/system/apt-mirror.service
[%# Root-owned, or cron ignores it.  A file moved out of the payload keeps the
    transfer user as its owner, and cron applies owner rules to cron.d.  This
    replaces the packaged file, so only one file says when a sync happens.  The
    packaged file is all comments and schedules nothing. -%]
install -o root -g root -m 0644 aptmirror.cron /etc/cron.d/apt-mirror
systemctl daemon-reload
install -o root -g root -m 0644 aptmirror.nginx.conf /etc/nginx/sites-enabled/[% domain %]-aptmirror.conf
[%# Deferred for the reason that nginxdirindex gives.  nginx is a dependency of
    this recipe, so its target runs after this one.  The global configuration
    of nginx is not in place until then. -%]
[% script_dir %]/queue_postrun_task systemctl restart nginx
[%# Started without a wait.  A first sync takes hours and hundreds of gigabytes,
    and bin/provision waits at most ninety minutes for the build.  This returns
    when systemd queues the job, and the unit continues after the build. -%]
systemctl start --no-block apt-mirror.service
echo 'aptmirror: the first sync runs in the background and takes hours.'
echo 'aptmirror: watch it with "journalctl -u apt-mirror -f" here,'
echo 'aptmirror: or ask from anywhere with "curl http://[% domain %]/mirror-status".'
