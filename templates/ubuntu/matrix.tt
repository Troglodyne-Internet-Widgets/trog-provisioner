# matrix-synapse-py3 comes from the matrix.org repository, not from Ubuntu.  It
# is not in deps, because cloud-init installs deps at first boot, before this
# repository is configured.
install -d -m 0755 /usr/share/keyrings
curl -fsSL https://packages.matrix.org/debian/matrix-org-archive-keyring.gpg -o /usr/share/keyrings/matrix-org-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/matrix-org-archive-keyring.gpg] https://packages.matrix.org/debian/ $$(. /etc/os-release; echo $$VERSION_CODENAME) main" > /etc/apt/sources.list.d/matrix-org.list
apt-get update
# Preseed the answers.  Otherwise the install stops at a debconf prompt for the
# server name, and a make recipe has no terminal to answer it.
echo "matrix-synapse-py3 matrix-synapse/server-name string matrix.[% domain %]" | debconf-set-selections
echo "matrix-synapse-py3 matrix-synapse/report-stats boolean false" | debconf-set-selections
[%# matrix-synapse-py3 only.  The repository has only that package and its
    keyring.  The package carries its own Python dependencies, and its Depends
    are system libraries and python3.  So txredisapi, which synapse uses for
    redis, is inside the package, and no repository has it separately. -%]
DEBIAN_FRONTEND=noninteractive apt-get install -y matrix-synapse-py3
# The data target already put the salvaged homeserver back, before this recipe
# runs.  See restores in Provisioner::Recipe::matrix.  The chown -R and chmod -R
# below cover the restored tree.
mkdir -p [% install_dir %]/matrix.[% domain %]
mkdir -p [% install_dir %]/matrix.[% domain %]/media
mkdir -p [% install_dir %]/admin.matrix.[% domain %]
mkdir -p /etc/matrix-synapse
mkdir -p /var/log/matrix-synapse
chown -R matrix-synapse:[% admin_user %] [% install_dir %]/matrix.[% domain %]
chmod -R 0750 [% install_dir %]/matrix.[% domain %]
chown -R matrix-synapse:matrix-synapse /var/log/matrix-synapse
cp homeserver.yaml /etc/matrix-synapse/
cp log.yaml /etc/matrix-synapse/
cp matrix-synapse.service /etc/systemd/system/
chown root:root /etc/matrix-synapse/homeserver.yaml
chown root:root /etc/matrix-synapse/log.yaml
chmod 0644 /etc/matrix-synapse/homeserver.yaml
chmod 0644 /etc/matrix-synapse/log.yaml
[%# Never make the signing key here.  It is the federation identity of this
    server, and a new key makes this homeserver a stranger to every server
    that knew it.  bin/provision puts the key on the guest from the secret
    store before this makefile starts.  See guest_secrets in
    Provisioner::Recipe.  So a missing key means that the store was not
    reachable.  Stop, and say so. -%]
test -s /etc/matrix-synapse/homeserver.signing.key \
    || { echo "matrix: no signing key at /etc/matrix-synapse/homeserver.signing.key" >&2; \
         echo "bin/provision places it from the secret store; synapse must not be started without it." >&2; \
         exit 1; }
[%# The owner changes here, because bin/provision places these files before
    the package install above makes the matrix-synapse account.  Only synapse
    reads them.  A rebuild gets them from the store, not from this guest. -%]
chown matrix-synapse:matrix-synapse /etc/matrix-synapse/homeserver.signing.key /etc/matrix-synapse/registration.shared.secret
chmod 0600 /etc/matrix-synapse/homeserver.signing.key /etc/matrix-synapse/registration.shared.secret
[% script_dir %]/matrix.download-admin.sh [% install_dir %]/admin.matrix.[% domain %]
chown -R www-data:[% admin_user %] [% install_dir %]/admin.matrix.[% domain %]
chmod -R 0750 [% install_dir %]/admin.matrix.[% domain %]
mkdir -p /etc/nginx/sites-enabled
# Only the admin vhost.  The vhost of the domain belongs to nginxproxy, which
# this recipe requires, and it already has the _matrix nocache prefix.
cp matrix-admin.nginx.conf /etc/nginx/sites-enabled/admin.matrix.[% domain %].conf
chown root:root /etc/nginx/sites-enabled/admin.matrix.[% domain %].conf
chmod 0644 /etc/nginx/sites-enabled/*.conf
install -m 0755 -o [% user %] -g www-data -d [% install_dir %]/[% domain %]/www
install -m 0755 -o [% user %] -g www-data matrix.index.html [% install_dir %]/[% domain %]/www
# Enable synapse now, and start it in postrun.
systemctl daemon-reload
systemctl enable matrix-synapse
[% script_dir %]/queue_postrun_task systemctl start matrix-synapse
[% script_dir %]/queue_postrun_task systemctl reload nginx
# The admin user is registered in postrun, after synapse starts.
install -m 0750 matrix_register_admin.sh [% script_dir %]/matrix_register_admin.sh
chmod +x [% script_dir %]/matrix_register_admin.sh
[% script_dir %]/queue_postrun_task [% script_dir %]/matrix_register_admin.sh
