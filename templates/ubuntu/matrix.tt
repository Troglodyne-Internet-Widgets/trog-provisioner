# cloud-init installs matrix-synapse-py3 at first boot, from the archive that
# Provisioner::Recipe::Ubuntu::matrix names.
# The data target already put the salvaged homeserver back, before this recipe
# runs.  See restores in Provisioner::Recipe::matrix.  The chown -R and chmod -R
# below cover the restored tree.
mkdir -p [% install_dir %]/matrix.[% domain %]
mkdir -p [% install_dir %]/matrix.[% domain %]/media
mkdir -p [% install_dir %]/admin.matrix.[% domain %]
mkdir -p [% install_dir %]/element.matrix.[% domain %]
mkdir -p /etc/matrix-synapse
mkdir -p /var/log/matrix-synapse
chown -R matrix-synapse:[% admin_user %] [% install_dir %]/matrix.[% domain %]
chmod -R 0750 [% install_dir %]/matrix.[% domain %]
chown -R matrix-synapse:matrix-synapse /var/log/matrix-synapse
[%# The package enables its own unit, and the boot after the install starts it.
    That unit has no check of the key, and restarts until synapse has a
    configuration.  So stop it before homeserver.yaml names server_name, and
    load the unit of this recipe, which checks the key before every start. -%]
systemctl stop matrix-synapse
install -o root -g root -m 0755 [% script_dir %]/matrix_check_signing_key /usr/local/sbin/matrix_check_signing_key
cp matrix-synapse.service /etc/systemd/system/
systemctl daemon-reload
cp homeserver.yaml /etc/matrix-synapse/
cp log.yaml /etc/matrix-synapse/
chown root:root /etc/matrix-synapse/homeserver.yaml
chown root:root /etc/matrix-synapse/log.yaml
chmod 0644 /etc/matrix-synapse/homeserver.yaml
chmod 0644 /etc/matrix-synapse/log.yaml
[%# Never make the signing key here.  It is the federation identity of this
    server, and a new key makes this homeserver a stranger to every server
    that knew it.  bin/provision puts the key on the guest from the secret
    store before this makefile starts.  See guest_secrets in
    Provisioner::Recipe.  So a missing key means that the store was not
    reachable.  Stop, and say so. -%]
@test -s /etc/matrix-synapse/homeserver.signing.key \
    || { echo "matrix: no signing key at /etc/matrix-synapse/homeserver.signing.key" >&2; \
         echo "bin/provision places it from the secret store; synapse must not be started without it." >&2; \
         exit 1; }
[%# The owner changes here, because bin/provision places these files as root,
    and can place them before the package install makes the matrix-synapse
    account.  Only synapse
    reads them.  A rebuild gets them from the store, not from this guest. -%]
chown matrix-synapse:matrix-synapse /etc/matrix-synapse/homeserver.signing.key /etc/matrix-synapse/registration.shared.secret
chmod 0600 /etc/matrix-synapse/homeserver.signing.key /etc/matrix-synapse/registration.shared.secret
[%# A synapse that starts on a restored database with a new key publishes the
    new key under the old name.  See Taking over a homeserver in
    Provisioner::Recipe::matrix.  The unit runs this check before every start.
    The build runs it too, to stop with a message that says what to do.  As
    the user of the unit, for the reason that the unit gives. -%]
@runuser -u matrix-synapse -- [% INCLUDE "files/matrix.check_signing_key.tt" %] \
    || { echo "matrix: the signing key in secret:matrix/[% domain %]-signing-key/password is not the key of this homeserver." >&2; \
         echo "Put the key of the old server there with bin/add_secret, and build again.  synapse is stopped, and its unit does not start it with this key." >&2; \
         exit 1; }
[% script_dir %]/matrix.download-admin.sh [% install_dir %]/admin.matrix.[% domain %]
chown -R www-data:[% admin_user %] [% install_dir %]/admin.matrix.[% domain %]
chmod -R 0750 [% install_dir %]/admin.matrix.[% domain %]
[% script_dir %]/matrix.download-element.sh [% install_dir %]/element.matrix.[% domain %]
install -m 0644 element.config.json [% install_dir %]/element.matrix.[% domain %]/config.json
chown -R www-data:[% admin_user %] [% install_dir %]/element.matrix.[% domain %]
chmod -R 0750 [% install_dir %]/element.matrix.[% domain %]
mkdir -p /etc/nginx/sites-enabled
# The vhosts of the homeserver, of the admin interface and of Element.  The
# vhost of the domain belongs to nginxproxy, which this recipe requires, and
# serves the page below from www.
install -o root -g root -m 0644 matrix.nginx.conf /etc/nginx/sites-enabled/matrix.[% domain %].conf
install -o root -g root -m 0644 matrix-admin.nginx.conf /etc/nginx/sites-enabled/admin.matrix.[% domain %].conf
install -o root -g root -m 0644 matrix-element.nginx.conf /etc/nginx/sites-enabled/element.matrix.[% domain %].conf
chmod 0644 /etc/nginx/sites-enabled/*.conf
install -o root -g root -m 0644 matrix_ufw.conf /etc/ufw/applications.d/matrix-homeserver
install -m 0755 -o [% user %] -g www-data -d [% install_dir %]/[% domain %]/www
install -m 0644 -o [% user %] -g www-data matrix.index.html [% install_dir %]/[% domain %]/www/index.html
[%# Where an older version of this recipe put the page, which nothing served. -%]
rm -f [% install_dir %]/[% domain %]/www/matrix.index.html
# Enable synapse now, and start it in postrun.
systemctl enable matrix-synapse
[% script_dir %]/queue_postrun_task systemctl start matrix-synapse
[% script_dir %]/queue_postrun_task systemctl reload nginx
# The admin user is registered in postrun, after synapse starts.
install -m 0750 matrix_register_admin.sh [% script_dir %]/matrix_register_admin.sh
chmod +x [% script_dir %]/matrix_register_admin.sh
[% script_dir %]/queue_postrun_task [% script_dir %]/matrix_register_admin.sh
