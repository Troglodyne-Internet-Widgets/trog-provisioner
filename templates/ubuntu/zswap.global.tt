# Set zswap at run time, so it is on now and grubconf keeps the kernel command
# line.  Provisioner::Recipe::zswap says why.
install -m 0644 -o root -g root zswap.tmpfiles.conf /etc/tmpfiles.d/zswap.conf
systemd-tmpfiles --create /etc/tmpfiles.d/zswap.conf
# Before the unit starts, because the unit needs a file with a swap signature.
[% script_dir %]/make_swapfile /swapfile '[% swap_size %]'
install -m 0644 -o root -g root swapfile.swap /etc/systemd/system/swapfile.swap
install -D -m 0644 -o root -g root zswap-oomd-swap.conf /etc/systemd/system/-.slice.d/60-zswap.conf
[% FOR slice IN kill_on_pressure -%]
install -D -m 0644 -o root -g root zswap-oomd-pressure.conf '/etc/systemd/system/[% slice %].d/60-zswap.conf'
[% END -%]
[% FOR unit IN protect -%]
install -D -m 0644 -o root -g root zswap-protect.conf '/etc/systemd/system/[% unit %].d/60-zswap.conf'
[% END -%]
systemctl daemon-reload
systemctl enable --now swapfile.swap
systemctl enable --now systemd-oomd.service
[% FOR unit IN protect -%]
# A running process takes OOMScoreAdjust only when it starts, and a restart of
# dbus breaks every session.  So set the score of the running process.
pid=$$(systemctl show -p MainPID --value '[% unit %]'); [ "$${pid:-0}" = 0 ] || choom -p "$$pid" -n -900
[% END -%]
