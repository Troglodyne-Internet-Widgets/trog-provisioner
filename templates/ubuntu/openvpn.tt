	# Set up easy-rsa PKI
	mkdir -p /etc/openvpn/easy-rsa
	cp -r /usr/share/easy-rsa/* /etc/openvpn/easy-rsa/
	# The data target already put back the PKI of the last guest.  The guards
	# below protect only a PKI that is on the disk.  Provisioner::Recipe::openvpn
	# has the whole account.
	#
	# --batch on every call.  Without it, easyrsa prompts for a Common Name, and
	# a make recipe has no terminal to answer from.
	#
	# Each step has a guard on the file that it makes.  In batch mode, init-pki
	# erases an existing PKI without a prompt, and every client certificate
	# stops working.
	if [ ! -f /etc/openvpn/easy-rsa/pki/ca.crt ]; then \
	    cd /etc/openvpn/easy-rsa && \
	    ./easyrsa --batch init-pki && \
	    EASYRSA_REQ_CN="[% domain %]" ./easyrsa --batch build-ca nopass; \
	fi
	if [ ! -f /etc/openvpn/easy-rsa/pki/issued/server.crt ]; then \
	    cd /etc/openvpn/easy-rsa && \
	    ./easyrsa --batch gen-req server nopass && \
	    ./easyrsa --batch sign-req server server; \
	fi
	if [ ! -f /etc/openvpn/easy-rsa/pki/dh.pem ]; then \
	    cd /etc/openvpn/easy-rsa && ./easyrsa --batch gen-dh; \
	fi
	if [ ! -f /etc/openvpn/easy-rsa/pki/ta.key ]; then \
	    cd /etc/openvpn/easy-rsa && openvpn --genkey secret pki/ta.key; \
	fi
	# A restored PKI arrives at 0750, the mode of the data directory.  easyrsa
	# makes its own at 0700 with the keys at 0600.  Set both to the second.
	#
	# One mode for each type, not u=rwX.  X keeps execute on a file that already
	# has it, and every restored file has it.
	find /etc/openvpn/easy-rsa/pki -type d -exec chmod 0700 {} +
	find /etc/openvpn/easy-rsa/pki -type f -exec chmod 0600 {} +
	# Copy PKI files into place
	cp /etc/openvpn/easy-rsa/pki/ca.crt              /etc/openvpn/server/
	cp /etc/openvpn/easy-rsa/pki/issued/server.crt   /etc/openvpn/server/
	cp /etc/openvpn/easy-rsa/pki/private/server.key  /etc/openvpn/server/
	cp /etc/openvpn/easy-rsa/pki/dh.pem              /etc/openvpn/server/
	cp /etc/openvpn/easy-rsa/pki/ta.key              /etc/openvpn/server/
	# All five, not only the keys: cp gives a new file the mode of its source.
	chmod 0600 /etc/openvpn/server/ca.crt /etc/openvpn/server/server.crt /etc/openvpn/server/server.key /etc/openvpn/server/dh.pem /etc/openvpn/server/ta.key
	# Stage the copy that remote_files names.  Provisioner::Recipe::openvpn
	# says why it is a copy, and what it costs.
	#
	# Made again on each run, so that a certificate revoked since the last run
	# does not stay here and look current.
	rm -rf /etc/openvpn/pki-salvage
	mkdir -p /etc/openvpn/pki-salvage
	cp -a /etc/openvpn/easy-rsa/pki/. /etc/openvpn/pki-salvage/
	chown -R [% admin_user %]:[% admin_user %] /etc/openvpn/pki-salvage
	find /etc/openvpn/pki-salvage -type d -exec chmod 0700 {} +
	find /etc/openvpn/pki-salvage -type f -exec chmod 0600 {} +
	# Deploy server configuration
	# The firewall profile for this port and protocol.  ufw does not get them,
	# so this recipe renders it.
	install -m 0644 -o root -g root openvpn_ufw.conf /etc/ufw/applications.d/openvpn-server
	cp server.conf /etc/openvpn/server/server.conf
	chown root:root /etc/openvpn/server/server.conf
	chmod 0640 /etc/openvpn/server/server.conf
	# Enable IP forwarding
	echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-openvpn.conf
	sysctl -p /etc/sysctl.d/99-openvpn.conf
	# Forwarding and NAT for VPN clients.  setup-masquerade lets the VPN subnet
	# through the filter FORWARD chain, and masquerades it out of the egress
	# interface of the guest.  Both are necessary, because the FORWARD chain
	# comes before nat POSTROUTING and ufw drops there.  Like
	# setup-port-forwards, it edits /etc/ufw/before.rules, so the rules survive
	# a reboot without iptables-persistent.
	#
	# Always, and the interface is optional.  Without these rules, a client of
	# this VPN loses the internet.  If no interface is named, setup-masquerade
	# asks the guest which interface carries its default route.
	#
	# Queued for after the makefile, because the ufw target starts with a
	# `ufw reset`.  That reset puts back the packaged before.rules and removes
	# these rules.  The ufw target queues its `systemctl restart ufw` after this
	# task, so ufw reads the file with the rules in it.
	[% script_dir %]/queue_postrun_task [% script_dir %]/setup-masquerade '[% subnet %]/[% cidr %][% IF interface %]=[% interface %][% END %]'
	# Enable and start the service
	systemctl daemon-reload
	systemctl enable openvpn-server@server
	[% script_dir %]/queue_postrun_task systemctl start openvpn-server@server
	touch $@
