[%# The directory and the unit are named for the domain, so two tunnels on one
    guest do not collide.  Provisioner::Recipe::openvpnclient has the whole
    account. -%]
mkdir -p /etc/openvpn/client/[% domain %]
[% IF issue_from -%]
# Split the configuration that [% issue_from %] issued, which bin/provision put
# here before the makefile started, into the files that client.conf names
umask 077 && base64 -d /etc/openvpn/client/[% domain %]/issued.ovpn.b64 | awk -v dir=/etc/openvpn/client/[% domain %] 'BEGIN { name["ca"] = "ca.crt"; name["cert"] = "client.crt"; name["key"] = "client.key"; name["tls-auth"] = "ta.key" } /^<[a-z-]+>$$/ { file = dir "/" name[substr($$0, 2, length($$0) - 2)]; next } /^<\// { file = ""; next } file != "" { print > file }'
[% ELSE -%]
# Fetch the client certificates with rsync
rsync -av -e 'ssh -p[% transfer_port %]' [% transfer_user %]@[% transfer_ip %]::cert_dir.[% domain %]/ /etc/openvpn/client/[% domain %]/
[% END -%]
chmod 0600 /etc/openvpn/client/[% domain %]/client.key /etc/openvpn/client/[% domain %]/ta.key
chown root:root /etc/openvpn/client/[% domain %]/client.key /etc/openvpn/client/[% domain %]/ta.key
[%# openvpn-client@NAME reads /etc/openvpn/client/NAME.conf, so the
    configuration must land here. -%]
# Deploy client configuration
cp client.conf /etc/openvpn/client/[% domain %].conf
chown root:root /etc/openvpn/client/[% domain %].conf
chmod 0640 /etc/openvpn/client/[% domain %].conf
[%# Nothing is salvaged off this guest.  Provisioner::Recipe::openvpnclient
    says why. -%]
# Start the tunnel now, so it is up for the targets that run after this one
systemctl daemon-reload
systemctl enable openvpn-client@[% domain %]
systemctl start openvpn-client@[% domain %]
# Wait at most 30 seconds for the tunnel interface to come up
[% script_dir %]/wait_for_iface [% device %] 30
touch $@
