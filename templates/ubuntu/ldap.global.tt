# Give debconf the slapd answers before dpkg-reconfigure
DEBIAN_FRONTEND=noninteractive debconf-set-selections slapd.debconf
rm -f slapd.debconf
DEBIAN_FRONTEND=noninteractive dpkg-reconfigure slapd

[%# The empty host part makes ldaps://:port/ bind every interface, the same
    as a bare ldaps:///. -%]
# Enable LDAPS on the configured port
sed -i 's|^SLAPD_SERVICES=.*|SLAPD_SERVICES="ldap:/// ldaps://:[% port %]/ ldapi:///"|' /etc/default/slapd
systemctl restart slapd

# Configure TLS for LDAPS with the certificate that the ssl target links.
#
# Ubuntu ships /etc/ssl/private as 0710 root:ssl-cert.  If openldap is not in
# that group, the modify below fails with only this error:
#   ldap_modify: Other (e.g., implementation specific) error (80)
[%# AppArmor first.  templates/files/ldap.apparmor.tt says why slapd needs the
    override to read the key. -%]
install -m 0644 -o root -g root slapd.apparmor /etc/apparmor.d/local/usr.sbin.slapd
apparmor_parser -r /etc/apparmor.d/usr.sbin.slapd; /bin/true
adduser openldap ssl-cert
# chown and chmod follow the symlink to the key itself.
chown root:openldap /etc/ssl/private/[% domain %].pem
chmod 0640 /etc/ssl/private/[% domain %].pem
[%# Restart after adduser and before the modify.  A process gets its groups
    when it starts, and the slapd started above is not in ssl-cert. -%]
systemctl restart slapd
ldapmodify -Y EXTERNAL -H ldapi:/// -f tls.ldif
rm -f tls.ldif
systemctl restart slapd

[%# templates/files/ldap.ufw.conf.tt says why this is a profile and not a
    rule. -%]
# Declare the firewall profile for LDAPS
install -o root -g root -m 0644 ldap_ufw.conf /etc/ufw/applications.d/ldap

# Load the directory that this domain had before the rebuild, if there is one.
# This must come before the seed, which only fills in what is missing.
[%# The data target already put any salvage in /var/backups/ldap: see restores()
    in Provisioner::Recipe::ldap.  mkdir is for a guest with no salvage, so that
    the chmod has a directory. -%]
mkdir -p /var/backups/ldap
# Group and other, not a mode.  A recursive 0600 removes the execute bit, and
# then the owner cannot enter its own directory.
chmod -R go-rwx /var/backups/ldap
install -m 0750 -o root -g root ldap-reload.sh /usr/local/sbin/ldap-reload.sh
/usr/local/sbin/ldap-reload.sh

# Seed base tree and users
[%# -c, because without it ldapadd stops at the first entry that already
    exists.  On a reloaded directory, that is the base entry, so no new user
    gets added.  A failure stops the build only when the base DN is not
    searchable afterwards.

    -y and not -w, because ps shows argv to every user on the guest.  printf is
    a shell builtin, so the password never reaches argv.  The @ keeps make from
    printing a failure message that did not happen into the setup log. -%]
install -m 0600 /dev/null ldap.admin_password
printf '%s' '[% admin_password %]' > ldap.admin_password
@ldapadd -c -x -D "cn=admin,[% base_dn %]" -y ldap.admin_password -f seed.ldif || { ldapsearch -x -b '[% base_dn %]' -s base >/dev/null 2>&1 || { echo "ldap: could not seed [% base_dn %]; the directory is empty" >&2; exit 1; }; }
rm -f seed.ldif ldap.admin_password

# Export the directory as LDIF each hour, for the next rebuild.
# templates/files/ldap.export.sh.tt says why.
install -m 0750 -o root -g root ldap-export.sh /usr/local/sbin/ldap-export.sh
install -m 0644 -o root -g root ldap-export.cron /etc/cron.d/ldap-export
# Once now, so that a rebuild within the first hour has an export to load.
/usr/local/sbin/ldap-export.sh

[% script_dir %]/queue_postrun_task systemctl enable slapd
[% script_dir %]/queue_postrun_task systemctl restart slapd
