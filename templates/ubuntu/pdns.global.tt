# Grab up to date pdns.  Regrettably key servers are flaky, gotta retry over n over
retry -t 10 -d 10 apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys CBC8B383
retry -t 10 -d 10 apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys FD380FBB
retry -t 10 -d 10 apt-key adv --refresh-keys --keyserver hkp://keyserver.ubuntu.com:80
# A release train, not auth-master: master is PowerDNS's development branch and
# it put 5.1.0~alpha1+master.380 on the guest.
apt-add-repository http://repo.powerdns.com/ubuntu -p [% repo_branch %]
apt-get update
apt-get install -y pdns-server
[%# /var/tmp, which is where ubuntu.setup.sh untars the payload.  These two
    said /tmp and so found nothing, every run, on every guest -- and the
    "; /bin/true" after them meant the error was printed and then discarded, so
    lexicon went unpatched and only failed later, deep in a dehydrated hook,
    with a MissingSchema on the socket path it cannot use unpatched.

    Applied only when it is not already in: one of these went upstream, so a
    lexicon that already has it is the expected case rather than a fault, and
    "git apply" of an applied patch fails.  A patch that neither applies nor
    reverses is a real problem and says so, but does not stop the build: the
    guest test asks lexicon whether it can reach the socket, which is the thing
    actually needed, and it will fail there if this went wrong. -%]
[% FOR patch IN ['lexicon-pdns-af-unix', 'lexicon-arbitrary-record-types'] -%]
cd / && { git apply --reverse --check /var/tmp/domainsetup_[% domain %]/[% patch %].patch >/dev/null 2>&1 && echo "[% patch %]: already applied"; } || git apply /var/tmp/domainsetup_[% domain %]/[% patch %].patch || echo "[% patch %]: WOULD NOT APPLY -- lexicon may be missing it; see templates/files/patches" >&2
[% END -%]
# Run on port 2500 so the recursor can run
mv pdns-global.conf /etc/powerdns/pdns.d/00-global.conf
[%# forward-zones-file, which is how the recursor takes a list of zones that
    many things contribute to: one zone per line, zone=address:port.  Each
    domain appends its own line in the per-domain target. -%]
touch /etc/powerdns/forward-zones
chown root:pdns /etc/powerdns/forward-zones; /bin/true
chmod 0644 /etc/powerdns/forward-zones
grep -q '^forward-zones-file=' /etc/powerdns/recursor.conf || echo 'forward-zones-file=/etc/powerdns/forward-zones' >> /etc/powerdns/recursor.conf
[%# And whatever zones the recipe was configured with, in the same file. -%]
[% FOR zone IN forward_zones.keys().sort() %]
grep -qxF '[% zone %]=[% forward_zones.$zone %]' /etc/powerdns/forward-zones || echo '[% zone %]=[% forward_zones.$zone %]' >> /etc/powerdns/forward-zones
[% END -%]
[%# The recursor validates DNSSEC, and an internal zone under a reserved TLD has
    no chain to validate against -- so it answered SERVFAIL for the very zone it
    was forwarding, while resolving the public internet perfectly well.  Nothing
    said so: the failure surfaced as an ACME challenge that could not be seen.

    A negative trust anchor turns validation off for that zone and nothing else.
    Measured on a guest: the zone answers NOERROR afterwards and
    dnssec-failed.org still SERVFAILs, which is the point of doing it per zone
    rather than with dnssec=process-no-validate. -%]
touch /etc/powerdns/recursor.lua
chown root:pdns /etc/powerdns/recursor.lua; /bin/true
chmod 0644 /etc/powerdns/recursor.lua
grep -q '^lua-config-file=' /etc/powerdns/recursor.conf || echo 'lua-config-file=/etc/powerdns/recursor.lua' >> /etc/powerdns/recursor.conf
[% FOR zone IN forward_zones.keys().sort() %]
grep -qF 'addNTA("[% zone %]"' /etc/powerdns/recursor.lua || echo 'addNTA("[% zone %]", "forwarded to [% forward_zones.$zone %]")' >> /etc/powerdns/recursor.lua
[% END -%]
# Configure the zone to be loaded into pdns
mv pdns-domain.conf /etc/powerdns/pdns.d/sqlite.conf
# Set up the API so we can use lexicon
mv pdns-api.conf /etc/powerdns/pdns.d/api.conf
[%# Readable by pdns, which is not who the payload arrives owned by.  A file
    moved out of it keeps the transfer user and its 0600, so pdns could not read
    a line of its own configuration: it fell back to the packaged defaults,
    bound 0.0.0.0:53 where the recursor already was, and exited on every
    provision, unable to bind to the UDP socket.  api.conf carries the API key,
    hence the group rather than the world. -%]
chown root:pdns /etc/powerdns/pdns.d/00-global.conf /etc/powerdns/pdns.d/sqlite.conf /etc/powerdns/pdns.d/api.conf
chmod 0640 /etc/powerdns/pdns.d/00-global.conf /etc/powerdns/pdns.d/sqlite.conf /etc/powerdns/pdns.d/api.conf
mv synczones.conf /etc/synczones.conf
chown root:root /etc/synczones.conf
chmod 0600 /etc/synczones.conf
[%# The zone database belongs to the guest rather than to any one domain: a
    single zones.db under /var/spool/powerdns holds every zone the machine
    answers for, and each domain salvages that same host-wide tree.  So the
    restore is done here, once, and not in the per-domain half -- where it could
    never fire anyway, because by then the schema below has put a zones.db in
    the destination and restore_state declines in front of content.
    Which is also why it goes ahead of the schema rather than after it. -%]
[%# Apply the schema, unless what came back already has one.  Unconditional was
    right against a spool the package left empty and is an error against a
    restored database: sqlite3 stops on the first table it is told to create
    twice, and takes the target down with it. -%]
# Apply schema, to a database that does not already have one
sqlite3 /var/spool/powerdns/zones.db 'SELECT 1 FROM domains LIMIT 1' >/dev/null 2>&1 || sqlite3 /var/spool/powerdns/zones.db < /usr/share/pdns-backend-sqlite3/schema/schema.sqlite3.sql
# Don't need no bind
mkdir -p /etc/powerdns/config-available
mv /etc/powerdns/pdns.d/bind.conf /etc/powerdns/config-available/bind.conf
# Fix broken service configuration
[% script_dir %]/configure_pdns
mkdir -p /var/spool/powerdns/run/pdns/; /bin/true
chown -R pdns:pdns /var/spool/powerdns/run
mv 10-powerdns.conf /etc/rsyslog.d/10-powerdns.conf
[% script_dir %]/queue_postrun_task systemctl daemon-reload
[% script_dir %]/queue_postrun_task systemctl restart rsyslog
[% script_dir %]/queue_postrun_task systemctl enable pdns
[% script_dir %]/queue_postrun_task systemctl enable pdns-recursor
