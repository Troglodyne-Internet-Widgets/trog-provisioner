[%# cloud-init installs pdns-server at first boot, from the release train that
    Provisioner::Recipe::Ubuntu::pdns names. -%]
# Run on port 2500, because the recursor uses port 53
mv pdns-global.conf /etc/powerdns/pdns.d/00-global.conf
[%# forward-zones-file is how the recursor takes a list of zones from many
    sources: one zone per line, zone=address:port.  Each domain appends its own
    line in the per-domain target. -%]
touch /etc/powerdns/forward-zones
chown root:pdns /etc/powerdns/forward-zones; /bin/true
chmod 0644 /etc/powerdns/forward-zones
grep -q '^forward-zones-file=' /etc/powerdns/recursor.conf || echo 'forward-zones-file=/etc/powerdns/forward-zones' >> /etc/powerdns/recursor.conf
[%# The forward_zones of the recipe go in the same file. -%]
[% FOR zone IN forward_zones.keys().sort() %]
grep -qxF '[% zone %]=[% forward_zones.$zone %]' /etc/powerdns/forward-zones || echo '[% zone %]=[% forward_zones.$zone %]' >> /etc/powerdns/forward-zones
[% END -%]
[%# The recursor validates DNSSEC, and an internal zone under a reserved TLD
    has no chain to validate against.  So without an anchor, the recursor
    answers SERVFAIL for the zone that it forwards.

    A negative trust anchor turns off validation for that zone only.  This is
    per zone, not dnssec=process-no-validate, so dnssec-failed.org still gets
    SERVFAIL. -%]
touch /etc/powerdns/recursor.lua
chown root:pdns /etc/powerdns/recursor.lua; /bin/true
chmod 0644 /etc/powerdns/recursor.lua
grep -q '^lua-config-file=' /etc/powerdns/recursor.conf || echo 'lua-config-file=/etc/powerdns/recursor.lua' >> /etc/powerdns/recursor.conf
[% FOR zone IN forward_zones.keys().sort() %]
grep -qF 'addNTA("[% zone %]"' /etc/powerdns/recursor.lua || echo 'addNTA("[% zone %]", "forwarded to [% forward_zones.$zone %]")' >> /etc/powerdns/recursor.lua
[% END -%]
# The sqlite backend, which holds the zones
mv pdns-domain.conf /etc/powerdns/pdns.d/sqlite.conf
# The API, which lexicon and synczones use
mv pdns-api.conf /etc/powerdns/pdns.d/api.conf
[%# pdns must read these files, and a file moved out of the payload keeps the
    transfer user and mode 0600.  If pdns cannot read them, it uses the
    packaged defaults, binds 0.0.0.0:53 where the recursor is, and exits.
    api.conf holds the API key, so the group can read, not everybody. -%]
chown root:pdns /etc/powerdns/pdns.d/00-global.conf /etc/powerdns/pdns.d/sqlite.conf /etc/powerdns/pdns.d/api.conf
chmod 0640 /etc/powerdns/pdns.d/00-global.conf /etc/powerdns/pdns.d/sqlite.conf /etc/powerdns/pdns.d/api.conf
mv synczones.conf /etc/synczones.conf
chown root:root /etc/synczones.conf
chmod 0600 /etc/synczones.conf
[%# The data target restores the zones.db of the previous guest before this
    runs.  See restores() in Provisioner::Recipe::pdns.  sqlite3 stops on a
    table that already exists, and the target fails with it. -%]
# Apply schema, to a database that does not already have one
sqlite3 /var/spool/powerdns/zones.db 'SELECT 1 FROM domains LIMIT 1' >/dev/null 2>&1 || sqlite3 /var/spool/powerdns/zones.db < /usr/share/pdns-backend-sqlite3/schema/schema.sqlite3.sql
# Move the bind backend out of the way, because this recipe uses sqlite
mkdir -p /etc/powerdns/config-available
mv /etc/powerdns/pdns.d/bind.conf /etc/powerdns/config-available/bind.conf
# Make the pdns unit run in its chroot
[% script_dir %]/configure_pdns
mkdir -p /var/spool/powerdns/run/pdns/; /bin/true
chown -R pdns:pdns /var/spool/powerdns/run
mv 10-powerdns.conf /etc/rsyslog.d/10-powerdns.conf
[%# Here, not in the postrun queue.  post_install runs its queue one task at a
    time, and the letsencrypt certificate fetcher that needs pdns is ahead in
    it.  configure_pdns rewrote the unit above, so the reload goes with it.
    rsyslog stays queued, because nothing in the build reads its drop-in. -%]
systemctl daemon-reload
systemctl enable pdns
systemctl enable pdns-recursor
[% script_dir %]/queue_postrun_task systemctl restart rsyslog
