mkdir -p /etc/redis
mkdir -p /var/log/redis
chown redis:redis /var/log/redis
chmod 0750 /var/log/redis
# redis has an `include` but no conf.d.  The including file must name each
# included file, and a glob is a fatal error.  So configd makes redis.conf from
# /etc/redis/redis.conf.d.  A fragment, not a whole file, also keeps the
# redis.conf of the distribution as 00-original.  Each setting that the
# provisioner does not set keeps the value from the package.
#
# `configd adopt` also makes this directory, with this mode.  The makefile does
# not set which of the two runs first.
install -d -m 0750 -o root -g redis /etc/redis/redis.conf.d
# 0600 root:root, because the fragment can hold requirepass.  Only configd
# reads it, as root, from the ExecStartPre of the unit.
install -m 0600 -o root -g root redis.conf /etc/redis/redis.conf.d/50-provisioner
[%# The firewall profile for the configured redis port.  It is a profile
    because setup-ufw-rules allows each profile that `ufw app list` shows.
    templates/files/redis.ufw.conf.tt says why its name is redis-server. -%]
install -m 0644 -o root -g root redis_ufw.conf /etc/ufw/applications.d/redis-server
[%# The RDB and the AOF live in /var/lib/redis.  They are what redis holds
    beyond a cache.  The package makes the directory redis:redis 0750.  The
    fetch reads it as root, so it needs no other owner or mode.

    restore_state leaves what it moves owned by the user that ran the fetch.
    rsync sets the owner only when the receiving end is root, and the local end
    of a fetch is not.  So the chown below gives the files back to redis.

    The restore has an order problem that the other recipes do not have.
    cloud-init installs the package, and the install starts redis.  So redis
    runs before this fragment.  redis reads an RDB only when it starts, but it
    writes one at any time.  So redis ignores a file put under it while it
    runs, and later overwrites it.  For this reason the fragment stops redis
    first.

    If snapshot points are set, the stop also writes a snapshot.  That empty
    dump.rdb makes restore_state decline, because the destination then has
    content.  So the fragment asks whether the directory has content while
    redis still runs.  It deletes the snapshot from the stop only if the
    directory was empty before.  A guest with real state keeps it, and
    restore_state declines correctly.  A rebuilt guest gets its keyspace back.

    One redis serves the whole guest.  So this is the global fragment, and it
    runs once, for the first domain provisioned into the guest.  The salvage
    travels in the directory of that domain. -%]
mkdir -p /var/lib/redis
if [ -n "$$(find /var/lib/redis -mindepth 1 -print -quit 2>/dev/null)" ]; then HAD_STATE=1; else HAD_STATE=; fi; \
systemctl stop redis-server || /bin/true; \
if [ -z "$$HAD_STATE" ]; then rm -rf /var/lib/redis/*; fi
[% script_dir %]/restore_state '[% install_dir %]/[% domain %]/redis' /var/lib/redis
chown -R redis:redis /var/lib/redis
[%# Start redis here, not only at the end with the other deferred work.
    cloud-init starts redis, so later parts of the makefile expect it to run.
    This start closes the gap that the stop above opened, and here redis reads
    the restored keyspace.  The queued restart below loads the configuration
    that configd merged. -%]
systemctl start redis-server
[% script_dir %]/queue_postrun_task systemctl daemon-reload
[% script_dir %]/queue_postrun_task systemctl enable redis-server
[% script_dir %]/queue_postrun_task systemctl restart redis-server
