command -v claude >/dev/null 2>&1 || HOME='[% install_dir %]/[% domain %]' npm install -g --silent @anthropic-ai/claude-code
install -m 0755 -o [% user %] -g [% admin_user %] -d [% install_dir %]/[% domain %]/.claude
mv claude.settings.json [% install_dir %]/[% domain %]/.claude/settings.json
[%# The auto mode configuration of the operator, from the data directory of the
    domain, if it has one.  After the mv, because every provision replaces the
    settings file with one that knows nothing of it. -%]
[% script_dir %]/claude_settings auto-mode '[% install_dir %]/[% domain %]/claude.auto-mode.json' '[% install_dir %]/[% domain %]/.claude/settings.json'
[%# The hook and the status line that the settings name, and the badge that
    tmux draws from the hook.  See TMUX in Provisioner::Recipe::claude.  tmux
    reads /etc/tmux.conf before ~/.tmux.conf, so the dotfiles of the admin
    keep the last word. -%]
install -m 0755 claude-tmux-state /usr/local/bin/claude-tmux-state
install -m 0755 claude-statusline /usr/local/bin/claude-statusline
install -m 0644 -D claude.tmux.conf /etc/tmux.conf.d/claude.conf
grep -qxF "source-file -q '/etc/tmux.conf.d/*.conf'" /etc/tmux.conf 2>/dev/null || echo "source-file -q '/etc/tmux.conf.d/*.conf'" >> /etc/tmux.conf
[%# rtk, from the .deb its release publishes: one binary in /usr/bin that every
    account can run, and a version dpkg can be asked about.

    The version check is what makes this re-entrant.  dpkg-query says nothing
    and exits non-zero when the package is absent, so || is the install. -%]
[ "$$(dpkg-query -W -f='$${Version}' rtk 2>/dev/null)" = "[% rtk_version.replace('^v', '') %]-1" ] \
    || { curl -fsSL "https://github.com/rtk-ai/rtk/releases/download/[% rtk_version %]/rtk_[% rtk_version.replace('^v', '') %]-1_$$(dpkg --print-architecture).deb" -o /tmp/rtk.deb \
        && DEBIAN_FRONTEND="noninteractive" apt-get install -y -q /tmp/rtk.deb \
        && rm -f /tmp/rtk.deb; }
[%# After the settings file, because this edits it: the hook goes into the JSON
    that is already there.  --auto-patch answers the two questions the
    interactive form asks, which a makefile has nobody to answer.

    Re-entrant: a second run says the hook is already present. -%]
HOME='[% install_dir %]/[% domain %]' rtk init -g --auto-patch
[%# The settings only enable the plugins.  See DESCRIPTION in
    Provisioner::Recipe::claude for why each is installed here. -%]
[% FOREACH plugin IN plugins -%]
HOME='[% install_dir %]/[% domain %]' claude plugin install '[% plugin.name %]' --marketplace '[% plugin.repo %]'
[% END -%]
[%# The instructions of the operator, from the data directory of the domain,
    if it has one.  After rtk init, which writes the CLAUDE.md that imports
    them. -%]
[% script_dir %]/claude_settings instructions '[% install_dir %]/[% domain %]/claude.CLAUDE.md' '[% install_dir %]/[% domain %]/.claude/CLAUDE.md'
[%# Make runs as root, so everything above lands in the home of the agent as
    root: RTK.md, a CLAUDE.md that references it and a backup of the settings
    in .claude, the cache of npm in .npm, the filters and history of rtk under
    .config and .local, and the .claude.json that the plugin install writes.
    The service user runs the agent, so it owns them, and the group of the
    admin can read them.  A path that is not there, such as .npm where claude
    was already installed, is skipped. -%]
cd '[% install_dir %]/[% domain %]' && for p in .claude .claude.json .npm .config .local; do test ! -e "$$p" || chown -R '[% user %]:[% admin_user %]' "$$p" || exit 1; done
[% IF restricted_user -%]
[%# The account that a program runs claude as, and its home.  See A
    RESTRICTED AGENT in Provisioner::Recipe::claude.  rtk edits the settings,
    so it runs after the mv, as above. -%]
getent passwd '[% restricted_user %]' > /dev/null || useradd --system --user-group -s /usr/sbin/nologin -d '[% restricted_home %]' '[% restricted_user %]'
install -d -o root -g root -m 0755 '[% install_dir %]/[% domain %]/agents'
setfacl -m 'u:[% restricted_user %]:x' '[% install_dir %]/[% domain %]'
install -d -o '[% restricted_user %]' -g '[% restricted_user %]' -m 0750 '[% restricted_home %]' '[% restricted_home %]/.claude'
mv claude.restricted.settings.json '[% restricted_home %]/.claude/settings.json'
HOME='[% restricted_home %]' rtk init -g --auto-patch
[% FOREACH plugin IN plugins -%]
HOME='[% restricted_home %]' claude plugin install '[% plugin.name %]' --marketplace '[% plugin.repo %]'
[% END -%]
[% script_dir %]/claude_settings instructions '[% install_dir %]/[% domain %]/claude.CLAUDE.md' '[% restricted_home %]/.claude/CLAUDE.md'
HOME='[% restricted_home %]' git config --global --replace-all safe.directory '*'
chown -R '[% restricted_user %]:[% restricted_user %]' '[% restricted_home %]'
[% END -%]
