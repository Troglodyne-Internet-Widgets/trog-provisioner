# 99- so that this rule sorts last.  Any rule that sorts later can overrule it,
# and this file must decide.  Provisioner::Recipe::diskqueue says who decides
# without it.
install -m 0644 -o root -g root diskqueue.rules /etc/udev/rules.d/99-diskqueue.rules
udevadm control --reload-rules
# The rule fires on add and change, and the disks were added before this file
# existed.  The trigger applies it to the running guest, not only at the next
# boot.
udevadm trigger --subsystem-match=block --action=change
udevadm settle
# A value that udev applied is not always a value that the kernel took.  The
# script reports the difference.
[% script_dir %]/verify_disk_queue '[% scheduler %]' '[% read_ahead_kb %]' [% FOR device IN devices %]/sys/block/[% device %]/queue [% END %]
