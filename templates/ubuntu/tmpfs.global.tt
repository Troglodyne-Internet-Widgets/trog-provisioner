# Debian and Ubuntu ship tmp.mount turned off, in /usr/share/systemd.  Ours goes
# where systemd looks.  Provisioner::Recipe::tmpfs explains why.
install -m 0644 -o root -g root tmp.mount /etc/systemd/system/tmp.mount
systemctl daemon-reload
# Mount it now, in this target, and not in a postrun task.  The next restart of
# a service mounts an enabled tmp.mount anyway.  Provisioner::Recipe::tmpfs has
# the whole account.
systemctl enable --now tmp.mount
