# Housekeeping.
#
# 2750, dovecot:dovecot, before dovecot uses the directory.  dovecot copies the
# mode and the group of the nearest parent onto every maildir and message file
# that it makes.  Provisioner::Recipe::mail has the whole account.
install -d -m 2750 -o dovecot -g dovecot /mail/[% domain %]
# opendkim
mkdir -p /etc/opendkim/keys/[% domain %]
[%# opendkim reads one file for each table, for the whole guest.  So each
    domain keeps its rows in a directory of its own, and the files that opendkim
    reads are all of those rows, joined.  The host lists are sorted and made
    unique, because each domain names the guest too.  The order of the signing
    rows does not matter, because each names only its own domain. -%]
install -d -m 0755 /etc/opendkim/tables.d/[% domain %]
mv TrustedHosts SigningTable KeyTable InternalHosts RemoveARFrom /etc/opendkim/tables.d/[% domain %]/
cat /etc/opendkim/tables.d/*/SigningTable > /etc/opendkim/SigningTable
cat /etc/opendkim/tables.d/*/KeyTable > /etc/opendkim/KeyTable
sort -u /etc/opendkim/tables.d/*/TrustedHosts > /etc/opendkim/TrustedHosts
sort -u /etc/opendkim/tables.d/*/InternalHosts > /etc/opendkim/InternalHosts
sort -u /etc/opendkim/tables.d/*/RemoveARFrom > /etc/opendkim/RemoveARFrom
# The signing key that the last guest used, or a new one.  The data target
# restores the key of this domain before this target runs.  If there is no
# key, make one.
[ ! -f /etc/opendkim/keys/[% domain %]/default.private ] && opendkim-genkey -D /etc/opendkim/keys/[% domain %] -d [% domain %] -s default; /bin/true
chown -R opendkim:opendkim /etc/opendkim/
chmod -R 0755 /etc/opendkim
[%# Every key on the guest, not only the key of this domain, because the chmod
    above opened all of them.  opendkim refuses a key that others can read,
    and then tempfails every message of that domain. -%]
find /etc/opendkim/keys -type f -exec chmod 0600 {} +
# Put a copy in /mail for the fetch to read.  remote_files names this copy,
# not /etc/opendkim/keys.  Provisioner::Recipe::mail says why.
#
# The trailing dot is necessary.  If /mail/keys exists, `cp -r
# /etc/opendkim/keys /mail/keys` copies the directory into /mail/keys/keys.
# restores() takes the key back from /mail/keys/<domain>.
mkdir -p /mail/keys
cp -r /etc/opendkim/keys/. /mail/keys/
chown -R root:root /mail/keys
# 0700 and 0600, because this is a private key outside the daemon that owns
# it.  The fetch also copies it into the data directory of the provisioner.
find /mail/keys -type d -exec chmod 0700 {} +
find /mail/keys -type f -exec chmod 0600 {} +
mkdir -p /var/spool/postfix/opendkim
chown opendkim:postfix /var/spool/postfix/opendkim
chmod 0770 /var/spool/postfix/opendkim
[% script_dir %]/queue_postrun_task systemctl restart opendkim
# opendmarc.  AuthservID and the failure report addresses name the domain.  So
# its configuration goes in as the fragment of this domain, and does not
# replace the file.
mkdir -p /etc/opendmarc
mv ignore.hosts /etc/opendmarc
chown -R opendmarc:opendmarc /etc/opendmarc/
install -d -m 0755 -o root -g root /etc/opendmarc.conf.d
install -m 0600 -o root -g root opendmarc.conf /etc/opendmarc.conf.d/50-[% domain %]
mkdir -p /var/spool/postfix/opendmarc
chown opendmarc:postfix /var/spool/postfix/opendmarc
chmod 0770 /var/spool/postfix/opendmarc
[% script_dir %]/queue_postrun_task systemctl restart opendmarc
# Update the DNS records, if this guest runs a DNS server.
[% script_dir %]/queue_postrun_task [% script_dir %]/install_dkim_records [% domain %]
# dovecot
# First, move the packaged conf.d out of the way, once.  The target of a second
# domain on this guest must not move the conf.d that the first one wrote.
test -d /etc/dovecot/conf-available || mv /etc/dovecot/conf.d /etc/dovecot/conf-available
mkdir -p /etc/dovecot/conf.d
[%# Readable by all, as the packaged configuration is.  A mv keeps 0600 and the
    account that shipped the payload, and then dovecot-lda, which the quota
    warning runs as dovecot, cannot read its configuration. -%]
install -m 0644 -o root -g root dovecot.conf /etc/dovecot/conf.d/00-dovecot.conf
install -m 0644 -o root -g root dovecot.domain.conf /etc/dovecot/conf.d/10-[% domain %].conf
# The accounts come from the recipe, so keep the salvaged passwd file as
# passwd.old.  The data target restored the mailboxes before this target ran.
# TODO make the old one take precedence via configuration
test -f /mail/[% domain %]/passwd && mv /mail/[% domain %]/passwd /mail/[% domain %]/passwd.old; /bin/true
sed -i "s/%REPLACEME%/$$(id -u dovecot)/gm" mailpasswd
mv mailpasswd /mail/[% domain %]/passwd
[%# Give the file to dovecot here, not only in the sweep at the end of this
    target.  It arrives as 0600, owned by the account that shipped it.
    dovecot auth reads it as the dovecot account, and doveadm below does a
    lookup. -%]
chown dovecot:dovecot /mail/[% domain %]/passwd
chmod 0640 /mail/[% domain %]/passwd
[% script_dir %]/queue_postrun_task systemctl restart dovecot
# amavisd-new
[%# Readable by all, as the packaged files beside it are.  amavis reads its
    configuration as the amavis account, and a file that it cannot read changes
    nothing.  No dot in the name, because run-parts skips such a name, and
    amavis lists its files with run-parts. -%]
install -m 0644 -o root -g root amavis.domain /etc/amavis/conf.d/50-[% domain.replace('[.]', '_') %]
[% script_dir %]/queue_postrun_task systemctl restart amavis
# postfix
mv aliases /etc/aliases
chown root:root /etc/aliases
chown root:root /etc/aliases.db
newaliases
# The lookup tables of this domain, in a directory of their own.  main.cf
# names them for each domain, and postfix searches the list in order.  So a
# second domain adds tables and does not replace them.
install -d -m 0755 -o root -g root /etc/postfix/domains
install -d -m 0755 -o root -g root /etc/postfix/domains/[% domain %]
install -m 0600 -o root -g root virtual_maps    /etc/postfix/domains/[% domain %]/virtual_maps
install -m 0600 -o root -g root virtual_aliases /etc/postfix/domains/[% domain %]/virtual_aliases
install -m 0600 -o root -g root transport_maps  /etc/postfix/domains/[% domain %]/transport_maps
install -m 0600 -o root -g root sdd_relay_maps  /etc/postfix/domains/[% domain %]/sdd_relay_maps
install -m 0600 -o root -g root sender_login    /etc/postfix/domains/[% domain %]/sender_login
install -m 0600 -o root -g root header_checks   /etc/postfix/domains/[% domain %]/header_checks
# header_checks is regexp:, which postfix reads as text; the rest are hash:.
postmap /etc/postfix/domains/[% domain %]/virtual_maps
postmap /etc/postfix/domains/[% domain %]/virtual_aliases
postmap /etc/postfix/domains/[% domain %]/transport_maps
postmap /etc/postfix/domains/[% domain %]/sdd_relay_maps
postmap /etc/postfix/domains/[% domain %]/sender_login
[% IF mailrelay_login -%]
[%# The password that the mail relay issued, as the login of this domain for
    each of its senders.  Provisioner::Recipe::mail has the whole account,
    under Sending through a mail relay. -%]
umask 077 && printf '@%s %s:%s\n' '[% domain %]' '[% domain %]' "$$(cat '[% mailrelay_login.password %]')" > /etc/postfix/domains/[% domain %]/sasl_passwd
install -m 0600 -o root -g root mailrelay_tls_policy /etc/postfix/domains/[% domain %]/mailrelay_tls_policy
postmap /etc/postfix/domains/[% domain %]/sasl_passwd
postmap /etc/postfix/domains/[% domain %]/mailrelay_tls_policy
install -o root -g root -m 0644 mail_mailrelay_ufw.conf /etc/ufw/applications.d/mail-mailrelay
[% END -%]
[%# The mail relay passes the mail clients of this domain to the ports of
    proxied_ports.  The firewall opens them, and dovecot believes the PROXY
    header, only from the relays of the domains on this guest, which each
    domain writes into /etc/mail-proxy-from.d.  The jails ban through the relay
    and never ban the relay itself.  Provisioner::Recipe::mail has the whole
    account, under Sending through a mail relay. -%]
install -d -m 0755 -o root -g root /etc/mail-proxy-from.d
rm -f /etc/mail-proxy-from.d/[% domain %] /etc/fail2ban/jail.d/[% domain %]-mailrelay.conf /etc/fail2ban/action.d/mailrelay-[% domain %].conf
[% IF mailrelay_login -%]
printf '%s\n' '[% mailrelay_login.address %]' > /etc/mail-proxy-from.d/[% domain %]
[% INCLUDE "files/relay.client.tt" WITH action_file = 'mail_relay.action' %]
install -o root -g root -m 0644 mail_mailrelay.jail /etc/fail2ban/jail.d/[% domain %]-mailrelay.conf
fail2ban-client -t
[% END -%]
printf 'haproxy_trusted_networks = %s\n' "$$(cat /etc/mail-proxy-from.d/* 2>/dev/null | tr '\n' ' ')" > /etc/dovecot/proxy_from.conf
# main.cf, as the fragment of this domain, not as a run of `postconf -e`.
# postconf sets a parameter and cannot add to one.  configd merges the
# fragments, so list parameters stay lists.  The global fragment writes 40-mail,
# the half of main.cf that is about the guest.
install -d -m 0755 -o root -g root /etc/postfix/main.cf.d
install -m 0644 -o root -g root main.cf.domain /etc/postfix/main.cf.d/50-[% domain %]
# postmap makes the .db as restrictive as the source it read, and the daemons
# that open these are not root.  The smtp client reads the passwords as root,
# before it drops its privileges, so they stay 0600.
chmod 0644 /etc/postfix/domains/[% domain %]/*.db
[% IF mailrelay_login -%]
chmod 0600 /etc/postfix/domains/[% domain %]/sasl_passwd.db
[% END -%]
# Give the postfix chroot the real resolv.conf.  Its own copy gets the broken
# default configuration from systemd-resolved.
[% script_dir %]/queue_postrun_task "cat /etc/resolv.conf > /var/spool/postfix/resolv.conf"
[% script_dir %]/queue_postrun_task systemctl restart postfix
# Set up the autodiscover URIs.
mkdir -p '[% install_dir %]/autodiscover.[% domain %]/autodiscover'; /bin/true
mv autodiscover.xml '[% install_dir %]/autodiscover.[% domain %]/autodiscover/'
chown -R www-data:www-data  '[% install_dir %]/autodiscover.[% domain %]'
chmod -R 0770 '[% install_dir %]/autodiscover.[% domain %]'
mv autodiscover_vhost /etc/nginx/sites-enabled/autodiscover.[% domain %].conf
[% script_dir %]/queue_postrun_task systemctl reload nginx
# Set up the mailboxes and sieve scripts for each user.
[%# doveadm takes the full address, <local part>@<domain>, because the
    passwd-file userdb uses it as its key. -%]
[%# doveadm does not read the configuration.  It asks the running auth
    process, which started with the packaged configuration.  The queued restart
    runs after this loop, so restart dovecot here too. -%]
systemctl restart dovecot
[% FOR name IN names.keys() %]
test -f "/mail/[% domain %]/[% name %]/[% name %].sieve" && ln -s "/mail/[% domain %]/[% name %]/[% name %].sieve" "/mail/[% domain %]/[% name %]/.dovecot.sieve"; /bin/true
test -f "/mail/[% domain %]/[% name %]/[% name %].sieve" && sudo -u dovecot sievec "/mail/[% domain %]/[% name %]/.dovecot.sieve"; /bin/true
[% FOR box IN names.$name.mailboxes %]
[%# Make the mailbox only if it is not there.  A rebuild restores the maildirs
    of this account first, and a second create fails with exit 65. -%]
doveadm mailbox status -u [% name %]@[% domain %] messages [% box %] > /dev/null 2>&1 || doveadm mailbox create -u [% name %]@[% domain %] [% box %]
[% END -%]
[% END -%]
# The same modes as the housekeeping at the top, again, because doveadm made
# more of the store since then.
chown -R dovecot:dovecot /mail/[% domain %]
find /mail/[% domain %] -type d -exec chmod 2750 {} +
find /mail/[% domain %] -type f -exec chmod 0640 {} +
