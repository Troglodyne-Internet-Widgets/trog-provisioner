[%# The data target puts back the registrations of the guests behind this
    one.  Provisioner::Recipe::edge says why. -%]
install -d -o root -g root -m 0755 /etc/nginx/edge.d
rm -f /etc/nginx/sites-enabled/default
install -o root -g root -m 0644 edge.stream.conf /etc/nginx/modules-enabled/99-edge-stream.conf
install -o root -g root -m 0644 edge.http.conf /etc/nginx/conf.d/edge.conf
install -o root -g root -m 0644 edge_ufw.conf /etc/ufw/applications.d/edge
[%# The host key comes from the secret store, so the guests that pinned it
    still trust this edge after a rebuild.  bin/provision placed it. -%]
ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key > /etc/ssh/ssh_host_ed25519_key.pub
install -o root -g root -m 0644 edge.sshd.conf /etc/ssh/sshd_config.d/edge-bans.conf
[% script_dir %]/check_sshd_config
[% script_dir %]/queue_postrun_task systemctl try-reload-or-restart ssh
install -d -o root -g root -m 0700 /var/lib/edge-bans
install -d -o root -g root -m 0750 /etc/ufw/after.init.d
install -o root -g root -m 0750 edge.bans /etc/ufw/after.init.d/edge-bans
[%# The relay for the mail of the guests.  configd makes main.cf and
    master.cf from these fragments.  Provisioner::Recipe::edge has the whole
    account, under Mail out. -%]
install -d -m 0755 -o root -g root /etc/postfix/main.cf.d /etc/postfix/master.cf.d
install -m 0644 -o root -g root edge.postfix.main /etc/postfix/main.cf.d/30-edge
install -m 0600 -o root -g root edge.postfix.master /etc/postfix/master.cf.d/30-edge
install -m 0644 -o root -g root edge.dovecot.conf /etc/dovecot/dovecot.conf
install -m 0644 -o root -g root edge.policyd_spf /etc/postfix-policyd-spf-python/policyd-spf.conf
[%# The milters of port 25, in the chroot of postfix, as the mail recipe has
    them.  configd makes opendkim.conf and opendmarc.conf from the fragments. -%]
install -d -m 0755 -o root -g root /etc/opendkim.conf.d /etc/opendmarc.conf.d
install -m 0600 -o root -g root edge.opendkim.conf /etc/opendkim.conf.d/30-edge
install -m 0600 -o root -g root edge.opendmarc.conf /etc/opendmarc.conf.d/30-edge
install -d -m 0770 -o opendkim -g postfix /var/spool/postfix/opendkim
install -d -m 0770 -o opendmarc -g postfix /var/spool/postfix/opendmarc
[% script_dir %]/queue_postrun_task systemctl restart opendkim
[% script_dir %]/queue_postrun_task systemctl restart opendmarc
[% INCLUDE "files/milter_client.tt" %]
test -e /etc/nginx/edge.d/mail.passwd || install -m 0640 -o root -g dovecot /dev/null /etc/nginx/edge.d/mail.passwd
[% FOR table IN ['senders', 'relay_domains', 'transport', 'recipients'] -%]
test -e /etc/nginx/edge.d/mail.[% table %] || install -m 0644 -o root -g root /dev/null /etc/nginx/edge.d/mail.[% table %]
[% END -%]
doveconf -n > /dev/null
[%# Where the guest test of mail sends its message, so that a build sends
    nothing to the internet. -%]
grep -q '^relay-selftest:' /etc/aliases || printf '%s\n' 'relay-selftest: /dev/null' >> /etc/aliases
newaliases
[% script_dir %]/queue_postrun_task systemctl restart dovecot
[% script_dir %]/queue_postrun_task systemctl restart postfix
[% script_dir %]/queue_postrun_task systemctl reload nginx
