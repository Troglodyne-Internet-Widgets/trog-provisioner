[%# One collector, one stream, one dashboard over it, so this is the global half
    and runs once for the machine.

    Everything installed here belongs to software the grafana recipe puts on the
    guest -- telegraf reads the fragment, grafana reads the dashboard -- and
    nothing here installs a package of its own.

    This target runs BEFORE that one.  A dependency is ordered after the last
    thing that dragged it in, so requiring grafana puts its target below this in
    the makefile rather than above it.  Neither the telegraf account nor the
    grafana account exists yet, which is why every path below is created and
    owned by root: install -o telegraf against a user that is not there fails,
    and takes the build with it.  Both services only ever read these files, so
    root owning them costs nothing, and the grafana target chowns the dashboard
    directory when it gets there. -%]
install -d -m 0755 /etc/telegraf/telegraf.d
install -o root -g root -m 0644 grafanasyslog_telegraf.conf /etc/telegraf/telegraf.d/60-grafanasyslog.conf
install -d -m 0755 /var/lib/grafana/dashboards
install -o root -g root -m 0644 grafanasyslog_dashboard.json /var/lib/grafana/dashboards/syslog.json
[%# Telegraf has to be restarted to open the listener, and grafana does not,
    because its dashboard provider rescans on the interval the grafana recipe
    set.  Queued rather than run here for the same ordering reason: telegraf is
    not installed until the target below this one. -%]
[% script_dir %]/queue_postrun_task systemctl restart telegraf
echo 'grafanasyslog: the collector stream is parsed on 127.0.0.1:[% port %] and drawn on the Syslog dashboard.'
