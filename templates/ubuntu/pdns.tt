[%# One line in forward-zones-file, not a fragment in recursor.d.  The
    recursor refuses a file in recursor.d that uses `forward-zones+=`, and says
    it "could not be parsed". -%]
# Forward this domain to the authoritative server, through the forward zones file
grep -qxF '[% domain %]=127.0.0.1:2500' /etc/powerdns/forward-zones 2>/dev/null     || cat pdns-recursor-domain.conf >> /etc/powerdns/forward-zones
rm -f pdns-recursor-domain.conf
[%# The negative trust anchor for this domain.  See the global fragment. -%]
grep -qF 'addNTA("[% domain %]"' /etc/powerdns/recursor.lua 2>/dev/null || cat pdns-recursor-domain.lua >> /etc/powerdns/recursor.lua
rm -f pdns-recursor-domain.lua
# Build the zone database
mkdir -p /var/spool/powerdns/[% domain %]; /bin/true
# TODO do this via lexicon instead
cp zonefile /var/spool/powerdns/[% domain %]/bind.zone
zone2sql --gsqlite --zone=zonefile --zone-name=[% domain %] > /var/spool/powerdns/[% domain %]/zone.sql
[%# Load the zone only into a database that does not answer for it yet.  The
    data target restores the zones.db of the previous guest before this runs,
    and it holds the live zone.  A reload of the zonefile replaces every record
    that lexicon, DCV or a person added after the last provision.  Also, zone2sql
    emits a plain insert into domains,
    which the unique index on name refuses, so the target fails.  Use lexicon
    to change a zone that is already there. -%]
sqlite3 /var/spool/powerdns/zones.db "SELECT id FROM domains WHERE name='[% domain %]'" | grep -q . || sqlite3 /var/spool/powerdns/zones.db < /var/spool/powerdns/[% domain %]/zone.sql
[%# And the zones that it holds for accounts of the registrar, the same way. -%]
bash pdns-held-zones.sh
rm -f pdns-held-zones.sh
[%# The recursor forwards every zone in the database: the zone of the domain,
    the zones above, and the zones of other guests that a build before this one
    made.  Before the restart of the recursor below.  See pdns_client. -%]
[% script_dir %]/pdns_client forwards
chown -R pdns:pdns /var/spool/powerdns
chmod -R 0775 /var/spool/powerdns
[%# pdns binds its control socket and its API socket as root, before it
    chroots and drops to setuid.  The unit does not grant CAP_DAC_OVERRIDE, so
    root cannot write into a directory that pdns owns with no access for
    other.  So root owns these directories, and pdns gets access through the
    group. -%]
chown root:pdns /var/spool/powerdns /var/spool/powerdns/run /var/spool/powerdns/run/pdns
chmod 0775 /var/spool/powerdns /var/spool/powerdns/run /var/spool/powerdns/run/pdns
[%# The proxy that other guests reach the API through.  See "The API proxy" in
    Provisioner::Recipe::pdns.  pdns owns the database of tokens, because the
    proxy runs as pdns to reach the API socket.  The key of the API is in env,
    which only root and pdns can read. -%]
install -d -o pdns -g pdns -m 0750 /var/lib/pdns-acl
install -d -o root -g root -m 0755 /etc/pdns-acl
install -o root -g root -m 0644 pdns-acl.psgi /etc/pdns-acl/app.psgi
install -o root -g pdns -m 0640 pdns-acl.env /etc/pdns-acl/env
install -o root -g root -m 0644 pdns-acl.service /etc/systemd/system/pdns-acl.service
[%# The umask with which pdns creates its API socket, so that the proxy, in the
    group pdns, can write to it.  Before the restart below. -%]
install -d -o root -g root -m 0755 /etc/systemd/system/pdns.service.d
install -o root -g root -m 0644 pdns-acl.dropin.conf /etc/systemd/system/pdns.service.d/pdns-acl.conf
systemctl daemon-reload
mkdir -p /etc/nginx/sites-enabled
install -o root -g root -m 0644 pdns-acl.nginx.conf /etc/nginx/sites-enabled/dnsapi.[% domain %].conf
[%# In the postrun, because the perl target runs after this fragment, and it
    installs Starman and the proxy. -%]
[% script_dir %]/queue_postrun_task systemctl enable pdns-acl
[% script_dir %]/queue_postrun_task systemctl restart pdns-acl
[% script_dir %]/queue_postrun_task systemctl reload nginx
rm -f pdns-acl.env
[%# Restart here, not in the postrun queue, for the reason in the global
    fragment.  A pdns that does not start then fails its own target. -%]
systemctl restart pdns
systemctl restart pdns-recursor
