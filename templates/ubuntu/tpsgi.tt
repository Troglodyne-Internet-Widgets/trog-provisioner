mkdir -p '[% install_dir %]/[% domain %]/www';  /bin/true
mkdir -p '[% install_dir %]/[% domain %]/run';  /bin/true
cd '[% install_dir %]/[% domain %]' && git clone --no-checkout https://github.com/Troglodyne-Internet-Widgets/tPSGI.git repo && mv repo/.git .git && rmdir repo
HOME='[% install_dir %]/[% domain %]' git config --global --add safe.directory '[% install_dir %]/[% domain %]'
cd '[% install_dir %]/[% domain %]' && HOME='[% install_dir %]/[% domain %]' git reset --hard HEAD
mv tpsgi.ini '[% install_dir %]/[% domain %]/.tpsgi.ini'
[%# The checkout is in the domain directory itself, beside what data and the
    other recipes put there.  So chown what git checked out, and not the
    domain directory: data owns that, and admincode owns its basedir.  www-data
    reaches www and run because nginxproxy sets o+x on the domain directory.
    pipefail, so that a git that refuses stops the target, and does not leave
    xargs with nothing to chown. -%]
set -o pipefail; cd '[% install_dir %]/[% domain %]' && HOME='[% install_dir %]/[% domain %]' git ls-tree --name-only -z HEAD | xargs -0 -r chown -R [% user %]:[% admin_user %] --
chown -R [% user %]:[% admin_user %] '[% install_dir %]/[% domain %]/.git' '[% install_dir %]/[% domain %]/.tpsgi.ini'
chown [% user %]:[% admin_user %] '[% install_dir %]/[% domain %]/.gitconfig'
chown -R [% user %]:www-data '[% install_dir %]/[% domain %]/www'
chown -R [% user %]:www-data '[% install_dir %]/[% domain %]/run'
ln -s [% install_dir %]/[% domain %]/service/tpsgi.service /usr/lib/systemd/system/[% domain %].service
[%# PATH gets the perl that the perl recipe built, for starman, and the
    checkout, for build_service.  The task finds that perl when it runs,
    because the perl does not exist yet when this line is queued.  The
    backslash keeps the substitution out of the shell that queues the line. -%]
[% script_dir %]/queue_postrun_task "PATH=\$$(ls -d /opt/perl5/*/bin 2>/dev/null | tail -n1):[% install_dir %]/[% domain %]/bin:$$PATH build_service [% domain %]"
[% script_dir %]/queue_postrun_task systemctl daemon-reload
[% script_dir %]/queue_postrun_task systemctl enable [% domain %]
[% script_dir %]/queue_postrun_task systemctl start [% domain %]
