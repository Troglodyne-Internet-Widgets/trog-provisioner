[%# Nothing for a domain whose zone nothing here writes, which keeps its
    self-signed certificate.  See Provisioner::Recipe::letsencrypt. -%]
[% IF unmanaged -%]
rm -f dehydrated.domain domains.txt domain.hook get_cert
[% ELSE -%]
mv dehydrated.domain /etc/dehydrated/domains.d/[% domain %].conf
mv domains.txt /etc/dehydrated/sans/[% domain %].txt
mv domain.hook /etc/dehydrated/hooks/[% domain %].sh
chown root:root /etc/dehydrated/domains.d/[% domain %].conf
chown root:root /etc/dehydrated/hooks/[% domain %].sh
chown root:root /etc/dehydrated/sans/[% domain %].txt
# The hook holds the DNS credentials and stays on the guest, so only root can read it.
# TODO: watch this file for all accesses via auditd
chmod 0700 /etc/dehydrated/hooks/[% domain %].sh
# The data target already put back the salvaged certificates of this domain.
# See restores in Provisioner::Recipe::letsencrypt.
# Install the script that gets the certificate, and queue it for the postrun.
mv get_cert /etc/letsencrypt/fetchers/[% domain %]
chown root:root /etc/letsencrypt/fetchers/[% domain %]
chmod +x /etc/letsencrypt/fetchers/[% domain %]
[%# The script reloads the services that read the certificate.  See
    Provisioner::Recipe::letsencrypt. -%]
[% script_dir %]/queue_postrun_task /etc/letsencrypt/fetchers/[% domain %]
[% END -%]
