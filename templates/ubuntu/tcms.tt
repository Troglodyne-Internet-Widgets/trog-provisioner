[%# Clone only when nothing is there, which means a domain that never existed.
    A checkout that came down from the last guest is the live site, so it only
    moves to the tip of its branch when nobody changed it.  Before the chown,
    because git as root writes files that root owns.  See
    Provisioner::Recipe::tcms. -%]
[ -e '[% install_dir %]/[% domain %]/tCMS' ] || git clone --branch '[% repo_branch %]' '[% repo_url %]' '[% install_dir %]/[% domain %]/tCMS'
[% script_dir %]/fast_forward_checkout '[% install_dir %]/[% domain %]/tCMS' '[% repo_url %]' '[% repo_branch %]'
[%# www/ has the group of nginx, which serves the files that tPSGI links out of
    it, and others get nothing.  See Provisioner::Recipe::tcms. -%]
chown -R [% user %]: '[% install_dir %]/[% domain %]/tCMS'
chown -R [% user %]:www-data '[% install_dir %]/[% domain %]/tCMS/www'
chmod -R o-rwx '[% install_dir %]/[% domain %]/tCMS'
[%# The directories that tCMS needs and does not track, data/ among them.  It
    makes only what is missing.  See Provisioner::Recipe::tcms. -%]
sudo -u [% user %] HOME='[% install_dir %]/[% domain %]' make -C '[% install_dir %]/[% domain %]/tCMS' -f Installer.mk install
[%# The front-end files that tCMS serves, which Installer.mk fetches only when
    they are missing.  See Provisioner::Recipe::tcms. -%]
sudo -u [% user %] HOME='[% install_dir %]/[% domain %]' make -C '[% install_dir %]/[% domain %]/tCMS' -f Installer.mk prereq-frontend
HOME='[% install_dir %]/[% domain %]' git config --global --add safe.directory '[% install_dir %]/[% domain %]/tCMS'
[%# The hostname, the secure host and the media base, which tCMS writes
    itself, once the perl target has built what it loads.  An empty value
    clears one.  See THE HOSTS OF TCMS in Provisioner::Recipe::tcms. -%]
[% script_dir %]/queue_postrun_task "cd '[% install_dir %]/[% domain %]/tCMS' && sudo -u [% user %] HOME='[% install_dir %]/[% domain %]' /opt/perl5/current/bin/perl bin/tcms-hostname --secure '[% secure_host %]' --media '[% media_base %]' '[% domain %]'"
[%# The worker of the job queue.  reenable, so that a guest built before the
    service of tPSGI wanted the worker loses its old link.  restart, so that a
    provision of a running guest loads the new checkout, after the perl target
    has built what the worker loads.  See THE JOB WORKER in
    Provisioner::Recipe::tcms. -%]
install -o root -g root -m 0644 tcms-worker.service '/etc/systemd/system/tcms-worker-[% domain %].service'
systemctl daemon-reload
systemctl reenable 'tcms-worker-[% domain %].service'
[% script_dir %]/queue_postrun_task systemctl daemon-reload
[% script_dir %]/queue_postrun_task systemctl restart 'tcms-worker-[% domain %].service'
[%# Holds a reboot while the worker transcodes.  See Reboot checks in
    Provisioner::Recipe. -%]
install -D -o root -g root -m 0755 tcms-reboot-check /etc/provisioner/reboot-checks.d/tcms-[% domain %]
