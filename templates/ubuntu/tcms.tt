[%# Clone only when nothing is there, which means a domain that never existed.
    A checkout that came down from the last guest is the live site, and this
    recipe leaves it alone.  See Provisioner::Recipe::tcms. -%]
[ -e '[% install_dir %]/[% domain %]/tCMS' ] || git clone https://github.com/Troglodyne-Internet-Widgets/tCMS.git '[% install_dir %]/[% domain %]/tCMS'
chown -R [% user %]:[% admin_user %] '[% install_dir %]/[% domain %]/tCMS'
HOME='[% install_dir %]/[% domain %]' git config --global --add safe.directory '[% install_dir %]/[% domain %]/tCMS'
