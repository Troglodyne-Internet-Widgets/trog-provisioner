# Configure dehydrated
mkdir -p /etc/dehydrated/domains.d
mkdir -p /etc/dehydrated/conf.d
mkdir -p /etc/dehydrated/hooks
# SAN = Subject Alternate Name
mkdir -p /etc/dehydrated/sans
mv dehydrated.conf /etc/dehydrated/config
chown root:root /etc/dehydrated/sans
chown root:root /etc/dehydrated/config
mkdir -p /var/lib/dehydrated/certs
mkdir -p /etc/dehydrated/certs
mkdir -p /etc/dehydrated/accounts
rm -rf /var/lib/dehydrated/accounts
ln -s /etc/dehydrated/accounts /var/lib/dehydrated/accounts
mkdir -p /etc/letsencrypt/fetchers/
# Setup dehydrated logrotate
mv dehydrated.logrotate /etc/logrotate.d/dehydrated
# The ACME account from the last guest, back in place before dehydrated is
# asked to register a new one.
#
# Losing the account key loses the registration: certificates issued under it
# stay valid but nothing can revoke them, and the guest starts over as a
# stranger to the CA.  This is here rather than in the per-domain fragment
# because that runs after this one, by which point --register has left an
# account sitting in the destination and restore_state would -- rightly --
# decline to write over it.  There is one account per guest, so restoring it
# once, here, is the right scope as well as the only workable order.
# Setup LE
dehydrated --register --accept-terms; /bin/true
# And left where the next fetch can read it.  That fetch reads the guest as
# root now (issue #76), so dehydrated's own 0600 root on the account key is
# already enough; issue #98 took back the admin group and the wider mode this
# used to be given when the fetch had neither.
chown -R root:root /etc/dehydrated/accounts
find /etc/dehydrated/accounts -type d -exec chmod 0700 {} +
find /etc/dehydrated/accounts -type f -exec chmod 0600 {} +
