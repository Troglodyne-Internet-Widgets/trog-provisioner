[%# cloud-init installs plexmediaserver at first boot, from the archive that
    Provisioner::Recipe::Ubuntu::plexmediaserver names. -%]
# Make sure that the plex service user exists.  The package makes it, but guard anyway.
id plex > /dev/null 2>&1 || useradd -r -s /usr/sbin/nologin -d /var/lib/plexmediaserver plex
[%# Stop Plex before anything below touches the library or the preferences.
    The package install starts Plex.  A running Plex keeps Preferences.xml in
    memory and writes its own copy back over the changes below.  The postrun
    tasks at the end start Plex again. -%]
systemctl stop plexmediaserver; /bin/true
[%# Put back the library from the last guest before Plex starts again.
    Provisioner::Recipe::plexmediaserver says what the library holds.

    The package install started Plex, and Plex makes its directory skeleton
    within seconds.  restore_state finds content in the destination and
    declines.  So remove the skeleton first, but only when this guest has
    nothing under Metadata.  A guest with metadata has a library worth more than
    the copy fetched off it. -%]
PMS='/var/lib/plexmediaserver/Library/Application Support/Plex Media Server'; \
if [ -n "$$(find '[% install_dir %]/[% domain %]/plexmediaserver' -mindepth 1 -print -quit 2>/dev/null)" ] \
    && [ -z "$$(find "$$PMS/Metadata" -mindepth 1 -print -quit 2>/dev/null)" ]; then \
    rm -rf /var/lib/plexmediaserver; \
fi
[% script_dir %]/restore_state '[% install_dir %]/[% domain %]/plexmediaserver' /var/lib/plexmediaserver
[%# plex:plex, for a restored library and for a new install alike. -%]
# Plex data directory
mkdir -p '/var/lib/plexmediaserver/Library/Application Support'
chown -R plex:plex /var/lib/plexmediaserver
chmod -R 0750 /var/lib/plexmediaserver
[% IF claim_token %]
# Write the claim token that links the server the first time.  Plex uses it on first start.
[%# sed takes out the old line, and echo adds the new one.  echo is a shell
    builtin, so the token never reaches argv, where ps shows it to every user. -%]
test ! -f /etc/default/plexmediaserver || sed -i '/^PLEX_CLAIM=/d' /etc/default/plexmediaserver
echo 'PLEX_CLAIM=[% claim_token %]' >> /etc/default/plexmediaserver
[% END %]
[% FOR dir IN media_dirs %]
# Set up media directory [% dir %]
mkdir -p '[% dir %]'
chown plex:[% admin_user %] '[% dir %]'
chmod 0750 '[% dir %]'
[% END %]
# Configure Plex Preferences.xml with the SSL certificate and the account.
#
# One logical line, and one line of python.  Make runs each recipe line in its
# own shell, so a variable set on one line is empty on the next.  A "-c" string
# over several lines without continuations gives the shell a quote that never
# closes.
[%# Read and change the file, do not write a new one.  A restored library keeps
    its MachineIdentifier and claim token that way.  Only the three settings
    that this recipe owns change.  Provisioner::Recipe::plexmediaserver has the
    whole account. -%]
PREFS_DIR='/var/lib/plexmediaserver/Library/Application Support/Plex Media Server'; \
mkdir -p "$$PREFS_DIR"; \
PLEX_CERT='/etc/ssl/certs/[% domain %].pem' \
PLEX_USER='[% plex_login_name %]' \
PLEX_MAIL='[% admin_mail %]' \
PREFS_PATH="$$PREFS_DIR/Preferences.xml" \
python3 -c "import xml.etree.ElementTree as ET, os; p = os.environ['PREFS_PATH']; root = ET.parse(p).getroot() if os.path.exists(p) else ET.Element('Preferences'); root.set('customCertificatePath', os.environ['PLEX_CERT']); root.set('PlexOnlineUsername', os.environ['PLEX_USER']); root.set('PlexOnlineMail', os.environ['PLEX_MAIL']); ET.ElementTree(root).write(p, encoding='unicode', xml_declaration=True)"; \
chown -R plex:plex "$$PREFS_DIR"; \
chmod 0640 "$$PREFS_DIR/Preferences.xml"
[% script_dir %]/queue_postrun_task systemctl daemon-reload
[% script_dir %]/queue_postrun_task systemctl enable plexmediaserver
[%# restart, not start.  If Plex is still running, start does nothing and Plex
    keeps the preferences it has in memory. -%]
[% script_dir %]/queue_postrun_task systemctl restart plexmediaserver
