[%# The machine has one grafana, one influxd and one telegraf.  So all of this
    is the global half, and it runs once for all the domains on the guest.

    cloud-init installs the three packages at first boot.
    Provisioner::Recipe::Ubuntu::grafana names the archives. -%]
install -o root -g grafana -m 0640 grafana.ini /etc/grafana/grafana.ini
install -d -o root -g grafana -m 0750 /etc/grafana/provisioning/datasources
install -d -o root -g grafana -m 0750 /etc/grafana/provisioning/dashboards
install -o root -g grafana -m 0640 grafana_datasource.yaml /etc/grafana/provisioning/datasources/influxdb.yaml
install -o root -g grafana -m 0640 grafana_dashboards.yaml /etc/grafana/provisioning/dashboards/provisioner.yaml
[%# The dashboards provider reads from here.  Owned by grafana, not root,
    because a recipe that adds a dashboard writes it here and grafana rescans. -%]
install -d -o grafana -g grafana -m 0755 /var/lib/grafana/dashboards
[%# This file keeps influxd off every interface.  See
    grafana.influxdb.env.tt. -%]
install -o root -g root -m 0644 grafana_influxdb.env /etc/default/influxdb
install -o root -g telegraf -m 0640 grafana_telegraf.conf /etc/telegraf/telegraf.d/50-provisioner.conf
install -m 0755 grafana_influx_setup.sh [% script_dir %]/grafana_influx_setup.sh
[%# Restart influxd here as well as in postrun.  Cloud-init started it with the
    package, so it listens on every interface until it reads
    /etc/default/influxdb again. -%]
systemctl restart influxdb
[% script_dir %]/queue_postrun_task systemctl daemon-reload
[% script_dir %]/queue_postrun_task systemctl enable influxdb
[% script_dir %]/queue_postrun_task systemctl restart influxdb
[%# Before the telegraf restart, so the database exists with a retention when
    telegraf writes to it.  The telegraf install started telegraf, which can
    make the database first.  So the script alters as well as creates. -%]
[% script_dir %]/queue_postrun_task [% script_dir %]/grafana_influx_setup.sh
[% script_dir %]/queue_postrun_task systemctl enable telegraf
[% script_dir %]/queue_postrun_task systemctl restart telegraf
[% script_dir %]/queue_postrun_task systemctl enable grafana-server
[% script_dir %]/queue_postrun_task systemctl restart grafana-server
[% script_dir %]/queue_postrun_task systemctl reload nginx
echo 'grafana: [% domain %] answers through nginx, over influxdb keeping [% retention %] of measurements.'
