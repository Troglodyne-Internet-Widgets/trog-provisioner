[%# pdns owns the database of tokens, because the proxy runs as pdns to reach
    the API socket.  The key of the API is in env, which only root and pdns
    can read. -%]
install -d -o pdns -g pdns -m 0750 /var/lib/pdns-acl
install -d -o root -g root -m 0755 /etc/pdns-acl
install -o root -g root -m 0644 pdnsacl.psgi /etc/pdns-acl/app.psgi
install -o root -g pdns -m 0640 pdnsacl.env /etc/pdns-acl/env
rm -f pdnsacl.env
install -o root -g root -m 0644 pdnsacl.service /etc/systemd/system/pdns-acl.service
[%# The umask with which pdns creates its API socket, so that the proxy, in the
    group pdns, can write to it.  Reloaded now and not in the postrun, because
    the fragment of pdns runs after this one and restarts pdns. -%]
install -d -o root -g root -m 0755 /etc/systemd/system/pdns.service.d
install -o root -g root -m 0644 pdnsacl.pdns-dropin.conf /etc/systemd/system/pdns.service.d/pdnsacl.conf
systemctl daemon-reload
mkdir -p /etc/nginx/sites-enabled
install -o root -g root -m 0644 pdnsacl.nginx.conf /etc/nginx/sites-enabled/dnsapi.[% domain %].conf
[%# In the postrun, because the perl target runs after this fragment, and it
    installs Starman and the proxy. -%]
[% script_dir %]/queue_postrun_task systemctl daemon-reload
[% script_dir %]/queue_postrun_task systemctl enable pdns-acl
[% script_dir %]/queue_postrun_task systemctl restart pdns-acl
[% script_dir %]/queue_postrun_task systemctl reload nginx
