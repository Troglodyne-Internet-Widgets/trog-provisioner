[%# Owned by syslog, because that is who rsyslog becomes: Ubuntu ships
    PrivDropToUser syslog, so a root-owned directory here means rsyslog cannot
    create a single file in it and says so once, to its own log, as
    "open error: Permission denied".  Group adm and 0750 to match what the
    distribution does with /var/log/syslog -- every other guest whole log stream
    is not something the rest of this one reads. -%]
install -d -o syslog -g adm -m 0750 '[% log_dir %]'
install -o root -g root -m 0644 logcollector.conf /etc/rsyslog.d/09-logcollector.conf
[%# Root-owned, or logrotate ignores it: a file moved out of the payload keeps
    the transfer user as its owner, and logrotate applies owner restrictions to
    what it will read.  templates/ubuntu/backupdestination.tt has the account. -%]
install -o root -g root -m 0644 logcollector.logrotate /etc/logrotate.d/logcollector
install -o root -g root -m 0644 logcollector_ufw.conf /etc/ufw/applications.d/logcollector
[% script_dir %]/queue_postrun_task systemctl restart rsyslog
echo 'logcollector: listening on [% port %]/[% protocol %], one file per sender under [% log_dir %].'
