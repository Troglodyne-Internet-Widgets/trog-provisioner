[%# The data target puts back the registrations of the guests behind this
    one.  configd makes main.cf and master.cf from these fragments.
    Provisioner::Recipe::mailrelay has the whole account, under Mail out. -%]
install -d -o root -g root -m 0755 /etc/postfix/mailrelay.d
install -o root -g root -m 0644 mailrelay_ufw.conf /etc/ufw/applications.d/mailrelay
[% INCLUDE "files/relay.install.tt" %]
install -o root -g root -m 0644 mailrelay.stream /etc/nginx/relay-stream.d/mailrelay.conf
[% script_dir %]/queue_postrun_task systemctl reload nginx
install -d -m 0755 -o root -g root /etc/postfix/main.cf.d /etc/postfix/master.cf.d
install -m 0644 -o root -g root mailrelay.postfix.main /etc/postfix/main.cf.d/30-mailrelay
install -m 0600 -o root -g root mailrelay.postfix.master /etc/postfix/master.cf.d/30-mailrelay
install -m 0644 -o root -g root mailrelay.dovecot.conf /etc/dovecot/dovecot.conf
install -m 0644 -o root -g root mailrelay.policyd_spf /etc/postfix-policyd-spf-python/policyd-spf.conf
[%# The milters of port 25, in the chroot of postfix, as the mail recipe has
    them.  configd makes opendkim.conf and opendmarc.conf from the fragments. -%]
install -d -m 0755 -o root -g root /etc/opendkim.conf.d /etc/opendmarc.conf.d
install -m 0600 -o root -g root mailrelay.opendkim.conf /etc/opendkim.conf.d/30-mailrelay
install -m 0600 -o root -g root mailrelay.opendmarc.conf /etc/opendmarc.conf.d/30-mailrelay
install -d -m 0770 -o opendkim -g postfix /var/spool/postfix/opendkim
install -d -m 0770 -o opendmarc -g postfix /var/spool/postfix/opendmarc
[% script_dir %]/queue_postrun_task systemctl restart opendkim
[% script_dir %]/queue_postrun_task systemctl restart opendmarc
[% INCLUDE "files/milter_client.tt" %]
test -e /etc/postfix/mailrelay.d/mail.passwd || install -m 0640 -o root -g dovecot /dev/null /etc/postfix/mailrelay.d/mail.passwd
[% FOR table IN ['senders', 'relay_domains', 'transport', 'recipients'] -%]
test -e /etc/postfix/mailrelay.d/mail.[% table %] || install -m 0644 -o root -g root /dev/null /etc/postfix/mailrelay.d/mail.[% table %]
[% END -%]
doveconf -n > /dev/null
[%# Where the guest test of mail sends its message, so that a build sends
    nothing to the internet. -%]
grep -q '^relay-selftest:' /etc/aliases || printf '%s\n' 'relay-selftest: /dev/null' >> /etc/aliases
newaliases
[% script_dir %]/queue_postrun_task systemctl restart dovecot
[% script_dir %]/queue_postrun_task systemctl restart postfix
