[%# The filter file of the jail that this recipe used to write itself.  The
    jails of the recipes carry their filters now. -%]
rm -f /etc/fail2ban/filter.d/[% domain %].conf
mv jail.cfg /etc/fail2ban/jail.d/[% domain %].conf
[%# Restarted after the ufw target, whose ufw reset drops any ban that
    fail2ban inserted.  fail2ban puts its bans back when it starts. -%]
[% script_dir %]/queue_postrun_task systemctl restart fail2ban
