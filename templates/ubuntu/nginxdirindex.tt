# Install the dirindex vhost.
mv nginxdirindex.domain.conf /etc/nginx/sites-enabled/[% domain %].conf
# Queued, as in nginxproxy.  nginx is a dependency of this recipe, and a
# dependency runs after the recipe that needs it.  So conf.d/global.conf is not
# there yet.
[% script_dir %]/queue_postrun_task systemctl restart nginx
# Make the root directory, and let nginx browse it.
mkdir -p [% install_dir %]/[% domain %]; /bin/true
chown root:www-data [% install_dir %]/[% domain %]
chmod 0755 [% install_dir %]/[% domain %]
