[%# Owned by syslog, because Ubuntu ships PrivDropToUser syslog and rsyslog runs
    as that user.  If root owns this directory, rsyslog cannot create files in
    it.  It reports "open error: Permission denied" once, to its own log.

    Group adm and mode 0750 match /var/log/syslog on the distribution.  Other
    users on this guest must not read the logs of the fleet. -%]
install -d -o syslog -g adm -m 0750 '[% log_dir %]'
install -o root -g root -m 0644 logcollector.conf /etc/rsyslog.d/09-logcollector.conf
[%# Owned by root, or logrotate ignores it.  A file moved out of the payload keeps
    the transfer user as its owner (see templates/ubuntu/backupdestination.tt). -%]
install -o root -g root -m 0644 logcollector.logrotate /etc/logrotate.d/logcollector
install -o root -g root -m 0644 logcollector_ufw.conf /etc/ufw/applications.d/logcollector
[% script_dir %]/queue_postrun_task systemctl restart rsyslog
echo 'logcollector: listening on [% port %]/[% protocol %], one file per sender under [% log_dir %].'
