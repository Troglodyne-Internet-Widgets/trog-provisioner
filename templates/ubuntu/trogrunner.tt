[%# trog-provisioner, on a guest that can run it.

    A makefile fragment.  Each line runs in its own shell.  Write `$$` for what
    the shell expands, `\` on every continued line, and no heredocs.  See
    Provisioner::Recipe.

    No apostrophes in an Xslate comment.  The lexer reads one as the start of
    a string, and takes the template up to the next quote into it.

    Layout, under the domain directory:
      etc/trog-provisioner/   recipes.yaml, ips.db
      the checkout dir        if there is one
      .ssh/id_ed25519         the key a hypervisor trusts, linked into the home
    /etc/trog-provisioner is a symlink to the first of these. -%]

# The configuration directory, and a link to it from /etc.
#
# A symlink, so that ips.db is under install_dir.  The next rebuild salvages
# it, and the user that assigns addresses can write it.  See datadirs in
# Provisioner::Recipe::trogrunner.
#
# -n on ln, or the second run puts the link inside the directory that the
# first run made.
install -d -o '[% user %]' -g '[% admin_user %]' -m 0750 '[% install_dir %]/[% domain %]/etc/trog-provisioner'
ln -sfn '[% install_dir %]/[% domain %]/etc/trog-provisioner' /etc/trog-provisioner

install -o '[% user %]' -g '[% admin_user %]' -m 0640 trogrunner.recipes.yaml '[% install_dir %]/[% domain %]/etc/trog-provisioner/recipes.yaml'
install -o '[% user %]' -g '[% admin_user %]' -m 0640 trogrunner.admin_authorized_keys '[% install_dir %]/[% domain %]/etc/trog-provisioner/admin_authorized_keys'
# Always, because every block names the resolvers of its guests, and a runner
# that is its own hypervisor gets a block for this guest.
install -o '[% user %]' -g '[% admin_user %]' -m 0640 trogrunner.hypervisors.conf '[% install_dir %]/[% domain %]/etc/trog-provisioner/hypervisors.conf'
[% IF store %]
# The secret store of the runner, from the data directory of this domain.
# Nothing generates it, because a new keepass database has new passwords.
# Every guest that the runner built uses the old ones.
install -o '[% user %]' -g '[% user %]' -m 0600 '[% install_dir %]/[% domain %]/[% store %]' '[% install_dir %]/[% domain %]/etc/trog-provisioner/secrets.kdbx'
[% END %]
# /etc/profile.d, not a dotfile in the domain directory.  That directory is a
# home only if the domain names a service user, and a runner does not have to.
# Every login shell sources this, so each user gets the checkout on the PATH.
install -o root -g root -m 0644 trogrunner.profile /etc/profile.d/trogrunner.sh

# The sandbox of every guest fetch needs bwrap to make a user namespace, and
# AppArmor refuses that without this profile.  See deps in
# Provisioner::Recipe::Ubuntu::trogrunner.
install -o root -g root -m 0644 trogrunner.bwrap.apparmor /etc/apparmor.d/bwrap
apparmor_parser -r /etc/apparmor.d/bwrap

[% IF hypervisor_access != 'none' %]
# Where bin/provision put the key that a hypervisor is asked to trust, before
# this makefile started.  trogrunner-owner.sh gives the key to the account.
install -d -o '[% user %]' -g '[% user %]' -m 0700 '[% install_dir %]/[% domain %]/.ssh'
[% END %]
# trogrunner-owner.sh gives the configuration, and the key, to the account that
# runs bin/provision.  In the postrun, because a recipe whose target runs after
# this one can make that account.  See THE PROVISIONING ACCOUNT in
# Provisioner::Recipe::trogrunner.
install -o root -g root -m 0700 trogrunner-owner.sh '[% install_dir %]/[% domain %]/trogrunner-owner.sh'
[% script_dir %]/queue_postrun_task '[% install_dir %]/[% domain %]/trogrunner-owner.sh'
[% IF checkout %]
# The checkout, only if nothing is there.  A checkout salvaged from the
# replaced guest holds work, and a clone over it loses that work.  koan.tt has
# the same guard.
#
# A subdirectory, not the domain directory, because service_user made that
# first, and git clone refuses a target that is not empty.
#
# HOME= on every git, because atd gives no environment, and git as root with
# no HOME does more than warn.
[ -e '[% install_dir %]/[% domain %]/[% checkout_dir %]/.git' ] || HOME='[% install_dir %]/[% domain %]' git clone --branch '[% repo_branch %]' '[% repo_url %]' '[% install_dir %]/[% domain %]/[% checkout_dir %]'
chown -R '[% user %]:[% admin_user %]' '[% install_dir %]/[% domain %]/[% checkout_dir %]'
HOME='[% install_dir %]/[% domain %]' git config --global --get-all safe.directory 2>/dev/null | grep -qFx '[% install_dir %]/[% domain %]/[% checkout_dir %]' || HOME='[% install_dir %]/[% domain %]' git config --global --add safe.directory '[% install_dir %]/[% domain %]/[% checkout_dir %]'
[% END %]
[%# This recipe hands its CPAN modules to the perl recipe.  Its target installs
    them after this fragment makes the checkout: Sys::Virt pinned, and what the
    checkout needs.  See required_recipes in Provisioner::Recipe::trogrunner. -%]
