[%# trog-provisioner, on a guest that can run it.

    A makefile fragment.  Each line runs in its own shell.  Write `$$` for what
    the shell expands, `\` on every continued line, and no heredocs.  See
    Provisioner::Recipe.

    No apostrophes in an Xslate comment.  The lexer reads one as the start of
    a string, and takes the template up to the next quote into it.

    Layout, under the domain directory:
      etc/trog-provisioner/   recipes.yaml, ips.db
      the checkout dir        if there is one
      .ssh/id_ed25519         the key a hypervisor trusts, linked into the home
    /etc/trog-provisioner is a symlink to the first of these. -%]

# The configuration directory, and a link to it from /etc.
#
# A symlink, so that ips.db is under install_dir.  The next rebuild salvages
# it, and the user that assigns addresses can write it.  See datadirs in
# Provisioner::Recipe::trogrunner.
#
# -n on ln, or the second run puts the link inside the directory that the
# first run made.
install -d -o '[% user %]' -g '[% admin_user %]' -m 0750 '[% install_dir %]/[% domain %]/etc/trog-provisioner'
ln -sfn '[% install_dir %]/[% domain %]/etc/trog-provisioner' /etc/trog-provisioner

# Each of these only when it is missing, because the configuration belongs to
# the operator once it exists.  A rebuild restores the salvaged copy first, and
# a configuration directory that is a share of the hypervisor already has one.
# THE CONFIGURATION in Provisioner::Recipe::trogrunner says more.
[ -e '[% install_dir %]/[% domain %]/etc/trog-provisioner/recipes.yaml' ] || install -o '[% user %]' -g '[% admin_user %]' -m 0640 trogrunner.recipes.yaml '[% install_dir %]/[% domain %]/etc/trog-provisioner/recipes.yaml'
[ -e '[% install_dir %]/[% domain %]/etc/trog-provisioner/admin_authorized_keys' ] || install -o '[% user %]' -g '[% admin_user %]' -m 0640 trogrunner.admin_authorized_keys '[% install_dir %]/[% domain %]/etc/trog-provisioner/admin_authorized_keys'
[ -e '[% install_dir %]/[% domain %]/etc/trog-provisioner/hypervisors.conf' ] || install -o '[% user %]' -g '[% admin_user %]' -m 0640 trogrunner.hypervisors.conf '[% install_dir %]/[% domain %]/etc/trog-provisioner/hypervisors.conf'
[% IF cache_authority %]
[ -e '[% install_dir %]/[% domain %]/etc/trog-provisioner/fetchcache-ca.crt' ] || install -o '[% user %]' -g '[% admin_user %]' -m 0644 trogrunner.fetchcache-ca.crt '[% install_dir %]/[% domain %]/etc/trog-provisioner/fetchcache-ca.crt'
[% END %]
[% IF store %]
# The secret store of the runner, from the data directory of this domain.
# Nothing generates it, because a new keepass database has new passwords.
# Every guest that the runner built uses the old ones.
[ -e '[% install_dir %]/[% domain %]/etc/trog-provisioner/secrets.kdbx' ] || install -o '[% user %]' -g '[% user %]' -m 0600 '[% install_dir %]/[% domain %]/[% store %]' '[% install_dir %]/[% domain %]/etc/trog-provisioner/secrets.kdbx'
[% END %]
# /etc/profile.d, not a dotfile in the domain directory.  That directory is a
# home only if the domain names a service user, and a runner does not have to.
# Every login shell sources this, so each user gets the checkout on the PATH.
install -o root -g root -m 0644 trogrunner.profile /etc/profile.d/trogrunner.sh

# The sandbox of every guest fetch needs bwrap to make a user namespace, and
# AppArmor refuses that without this profile.  See deps in
# Provisioner::Recipe::Ubuntu::trogrunner.
install -o root -g root -m 0644 trogrunner.bwrap.apparmor /etc/apparmor.d/bwrap
apparmor_parser -r /etc/apparmor.d/bwrap

[% IF hypervisor_access != 'none' %]
# Where bin/provision put the key that a hypervisor is asked to trust, before
# this makefile started.  trogrunner-owner.sh gives the key to the account.
install -d -o '[% user %]' -g '[% user %]' -m 0700 '[% install_dir %]/[% domain %]/.ssh'
[% END %]
# trogrunner-owner.sh gives the configuration, and the key, to the account that
# runs bin/provision.  In the postrun, because a recipe whose target runs after
# this one can make that account.  See THE PROVISIONING ACCOUNT in
# Provisioner::Recipe::trogrunner.
install -o root -g root -m 0700 trogrunner-owner.sh '[% install_dir %]/[% domain %]/trogrunner-owner.sh'
[% script_dir %]/queue_postrun_task '[% install_dir %]/[% domain %]/trogrunner-owner.sh'

# Guests that the runner builds fetch from it as the transfer account, with keys
# that the provisioning account lets in.  After the owner script, because the
# accounts must exist.  See THE TRANSFER ACCOUNT in
# Provisioner::Recipe::trogrunner.
[% script_dir %]/queue_postrun_task [% script_dir %]/setup_transfer_user [% IF transfer_account == user %]--give-shell [% END %]'[% transfer_account %]' '[% provision_user %]'
[% IF checkout %]
# The checkout.  A checkout salvaged from the replaced guest can hold work, so
# it only fast-forwards, and a pull that cannot fast-forward stops the build.
# Without the pull, the guest runs the code of the guest that it replaced.
#
# safe.directory on the command line, because root runs the pull in a checkout
# that the service user owns, and the global entry comes after.
#
# A subdirectory, not the domain directory, because service_user made that
# first, and git clone refuses a target that is not empty.
#
# HOME= on every git, because atd gives no environment, and git as root with
# no HOME does more than warn.
if [ -e '[% install_dir %]/[% domain %]/[% checkout_dir %]/.git' ]; then \
    HOME='[% install_dir %]/[% domain %]' git -c safe.directory='[% install_dir %]/[% domain %]/[% checkout_dir %]' -C '[% install_dir %]/[% domain %]/[% checkout_dir %]' pull --ff-only; \
else \
    HOME='[% install_dir %]/[% domain %]' git clone --branch '[% repo_branch %]' '[% repo_url %]' '[% install_dir %]/[% domain %]/[% checkout_dir %]'; \
fi
chown -R '[% user %]:[% admin_user %]' '[% install_dir %]/[% domain %]/[% checkout_dir %]'

# Tab completion of a domain, for bin/new_config, bin/provision and bin/destroy.
#
# A link, so that a pull in the checkout updates it.  Without a checkout, the
# copy that the ELSE branch installs.
#
# One link serves the checkout.  The script finds bin/domains beside the
# command that is completed, which type -P finds through the PATH that
# /etc/profile.d/trogrunner.sh sets.  See TAB COMPLETION in
# Provisioner::Recipe::trogrunner.
#
# -n on ln, as for the other link.
install -d -o root -g root -m 0755 /etc/bash_completion.d
ln -sfn '[% install_dir %]/[% domain %]/[% checkout_dir %]/completions/trog-provisioner.bash' /etc/bash_completion.d/trog-provisioner
HOME='[% install_dir %]/[% domain %]' git config --global --get-all safe.directory 2>/dev/null | grep -qFx '[% install_dir %]/[% domain %]/[% checkout_dir %]' || HOME='[% install_dir %]/[% domain %]' git config --global --add safe.directory '[% install_dir %]/[% domain %]/[% checkout_dir %]'
[% ELSE %]
# Tab completion of a domain, as a copy, because this recipe does not know
# which checkout holds the code.  See TAB COMPLETION in
# Provisioner::Recipe::trogrunner.
#
# install replaces a link that a run with a checkout left there.  It does not
# write through the link into that checkout.
install -d -o root -g root -m 0755 /etc/bash_completion.d
install -o root -g root -m 0644 trogrunner.completion.bash /etc/bash_completion.d/trog-provisioner
[% END %]
[%# This recipe hands its CPAN modules to the perl recipe.  Its target installs
    them after this fragment makes the checkout: Sys::Virt pinned, and what the
    checkout needs.  See required_recipes in Provisioner::Recipe::trogrunner. -%]
