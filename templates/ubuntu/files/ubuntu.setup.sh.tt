#!/bin/bash

# ATD script to actually do what we need to get set up.
#
# Rendered by Provisioner::Recipe::ubuntu and carried onto the guest inside
# cloud-init's write_files, which is why it is not in the payload it fetches.

# Wait until clown-init is done
cloud-init status --wait

# Make sure we can SSH to whoever is holding this guest's payload
cat > /root/.ssh/config << EOF
Host *
Compression yes
ForwardAgent yes

Host [% transfer_ip %]
StrictHostKeyChecking no
UserKnownHostsFile=/dev/null
User root
EOF
chmod 0600 /root/.ssh/config

# Transfer over the data.
#
# /var/tmp, not /tmp.  A recipe may put /tmp on a tmpfs while this is running --
# that is what the tmpfs recipe does -- and mounting over /tmp would take the
# payload and this script's own working directory with it: make carries on,
# because its cwd is a directory it already holds open, but the tarball and the
# build tree are then unreachable by path and the rm below silently removes
# nothing.  /var/tmp is where the FHS puts a working directory that has to
# outlive that sort of thing anyway.
scp -P [% transfer_port %] -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null [% transfer_user %]\@[% transfer_ip %]:[% payload_dir %]/[% domain %]/data.tar.gz /var/tmp

cd /var/tmp
mkdir domainsetup_[% domain %]
tar -zxf data.tar.gz -C /var/tmp/domainsetup_[% domain %]

cd /var/tmp/domainsetup_[% domain %]

# Run the makefile
make 2>&1 | tee /var/log/[% domain %].setup.log

cd /
rm -rf /var/tmp/domainsetup_[% domain %] /var/tmp/data.tar.gz
