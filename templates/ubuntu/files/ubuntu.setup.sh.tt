#!/bin/bash

# atd runs this script to set up the guest.
#
# Provisioner::Recipe::ubuntu renders it, and cloud-init carries it onto the
# guest in write_files.  So it is not in the payload that it fetches.

cloud-init status --wait

# Let root connect with SSH to the host that holds the payload of this guest.
cat > /root/.ssh/config << EOF
Host *
Compression yes
ForwardAgent yes

Host [% transfer_ip %]
StrictHostKeyChecking no
UserKnownHostsFile=/dev/null
User root
EOF
chmod 0600 /root/.ssh/config

# Copy the payload into /var/tmp, not /tmp.  The tmpfs recipe mounts a tmpfs
# over /tmp while this script runs, and the mount hides the tarball and the
# build tree.  make continues in the directory it holds open, but the rm below
# then removes nothing.
scp -P [% transfer_port %] -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null [% transfer_user %]\@[% transfer_ip %]:[% payload_dir %]/[% domain %]/data.tar.gz /var/tmp

cd /var/tmp
mkdir domainsetup_[% domain %]
tar -zxf data.tar.gz -C /var/tmp/domainsetup_[% domain %]

cd /var/tmp/domainsetup_[% domain %]

# Run the makefile.  The pipeline exits with the status of tee, which is
# always 0, so the braces record the status of make.  PIPESTATUS does not work
# here, because at(1) runs this script under dash.
#
# One job for each processor.  The order-only prerequisites in the makefile
# keep the order that matters.  -Otarget writes the output of each target in
# one piece when it finishes, so the log still reads target by target.
rm -f /var/log/[% domain %].setup.status
{ make -j"$(nproc)" -Otarget 2>&1; echo $? > /var/log/[% domain %].setup.status; } | tee /var/log/[% domain %].setup.log

cd /
rm -rf /var/tmp/domainsetup_[% domain %] /var/tmp/data.tar.gz
