[%# cloud-init user-data for a guest, rendered by Provisioner::Recipe::ubuntu.

    This template holds the structure of the document.  Every value that is not
    a fixed literal goes through the yaml filter, so YAML::XS does the quoting.
    The values carry account names, GECOS fields and a contact address.  One
    that holds an unquoted colon or apostrophe makes a file that cloud-init
    rejects, and the guest never boots.

    No apostrophes in an Xslate comment.  The lexer reads one as the start of a
    string and swallows the template as far as the next quote. -%]
#cloud-config
fqdn: [% domain | yaml %]
manage_etc_hosts: localhost
final_message: Boot configuration complete.

package_update: true
package_upgrade: true
packages:
[% packages | yaml %]

[%# A configured mirror comes first and the archive after it, so a guest still
    builds when the mirror is behind, incomplete or down.  The mirrorlist below
    sets that order.

    With no mirror configured, none of this is emitted.  The guest then uses the
    sources in the image, which point at a regional archive that cloud-init
    picked.  A list of only the main archive adds nothing and loses that choice.

    conf must stay outside the condition.  apt with no keys under it is an empty
    mapping, which is a different document. -%]
apt:
[% IF mirror_uri -%]
  primary:
    - arches:
        - default
      uri: "mirror+file:/etc/apt/mirrorlist"
  security:
    - arches:
        - default
      uri: "mirror+file:/etc/apt/mirrorlist"
[% END -%]
  conf: |
    Acquire {
        Retries "12";
        Force-IPv4: true;
[% IF mirror_insecure -%]
        AllowInsecureRepositories: true;
[% END -%]
    }
    APT {
        Get {
            Assume-Yes "true";
            Fix-Broken "true";
        }
    }

users:
[% users | yaml %]

[%# Everything here is deferred except the mirrorlist.  apt needs it before it
    installs the packages above.  It is only written when a mirror is configured. -%]
write_files:
  - path: /root/.ssh/id_rsa
    owner: root:root
    permissions: '0600'
    defer: true
    content: |
[% guest_key.private | indent %]
  - path: /root/.ssh/id_rsa.pub
    owner: root:root
    permissions: '0600'
    defer: true
    content: |
[% guest_key.public | indent %]
  - path: /root/setup.sh
    owner: root:root
    permissions: '0775'
    defer: true
    content: |
[% setup_script | indent %]
[% IF mirror_uri -%]
[%# Tabs, not spaces: the apt mirror+file format separates fields with tabs. -%]
  - path: /etc/apt/mirrorlist
    owner: root:root
    permissions: '0644'
    defer: false
    content: |
      [% mirror_uri | mark_raw %]	priority:1
      http://archive.ubuntu.com/ubuntu	priority:2
      http://security.ubuntu.com/ubuntu	priority:3
[% END -%]

[%# Last, and in this order.  Root mail must have a destination before the setup
    script runs anything that can fail and report it. -%]
runcmd:
[% runcmd | yaml %]
