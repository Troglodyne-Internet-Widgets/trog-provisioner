[%# The patches are in /var/tmp, where ubuntu.setup.sh untars the payload.

    A patch is applied only when it is not already in.  One of these patches is
    upstream now, so a lexicon that already has it is normal.  "git apply" of an
    applied patch fails.

    A patch that does not apply or reverse prints a message and does not stop
    the build.  The guest test asks lexicon if it can reach the socket, and that
    is what matters. -%]
[% FOR patch IN ['lexicon-pdns-af-unix', 'lexicon-arbitrary-record-types'] -%]
@cd / && { git apply --reverse --check /var/tmp/domainsetup_[% domain %]/[% patch %].patch >/dev/null 2>&1 && echo "[% patch %]: already applied"; } || git apply /var/tmp/domainsetup_[% domain %]/[% patch %].patch || echo "[% patch %]: WOULD NOT APPLY -- lexicon may be missing it; see templates/files/patches" >&2
[% END -%]
