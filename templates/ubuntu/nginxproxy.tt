# Set up the vhost for the domain and its aliases
mv nginx.domain.conf /etc/nginx/sites-enabled/[% domain %].conf
# Queued, not immediate.  The nginx recipe is a dependency of this one, and a
# dependency runs after the recipe that requires it.  So conf.d/global.conf is
# not installed yet, and its map defines the $connection_upgrade this vhost uses.
# A restart here fails with `unknown "connection_upgrade" variable`.
[% script_dir %]/queue_postrun_task systemctl restart nginx
[%# The document root of every vhost that declares a static_dir.  nginx does
    not create a root, and it starts without one.  It then serves 404 for
    everything, which looks like a fault in the application. -%]
[% FOR vhost IN vhosts.keys().sort() %]
[% IF !vhosts.$vhost.ssl_redirect AND vhosts.$vhost.static_dir %]
mkdir -p '[% install_dir %]/[% domain %]/[% vhosts.$vhost.static_dir %]'
[%# Recursive, because data already rsynced the files of the domain as
    user:admin_user, at every depth.  Only the group changes.  data already set
    the mode. -%]
chown -R [% user %]:www-data '[% install_dir %]/[% domain %]/[% vhosts.$vhost.static_dir %]'
[%# Setgid on every directory in the tree, so that files the application adds
    later also get the www-data group.  redis and mail do the same.  Directories
    only, because setgid on a file means something else. -%]
find '[% install_dir %]/[% domain %]/[% vhosts.$vhost.static_dir %]' -type d -exec chmod g+s {} +
[% END -%]
[% END -%]
[%# The data recipe leaves the domain directory 0750 user:admin_user, and
    www-data is not that user or in that group.  Without o+x, every request for
    a static file fails stat() and falls through try_files to the proxy.  o+x
    lets www-data descend, but not list or read.  The makefile builds targets in
    lexical order, so this runs after the data target and its chmod. -%]
[% IF serves_static %]
chmod o+x '[% install_dir %]/[% domain %]'
[% END -%]
[%# Also every directory between the domain root and a static_dir.  If the
    domain has content, data rsyncs www with mode 0750, the same as the domain
    root. -%]
[% FOR dir IN traverse_dirs %]
chmod o+x '[% install_dir %]/[% domain %]/[% dir %]'
[% END -%]
# Get ready for ACME
[%# .well-known, with a hyphen, as RFC 8615 and every ACME client spell it. -%]
mkdir -p [% install_dir %]/[% domain %]/www/.well-known; /bin/true
chown [% user %]:www-data [% install_dir %]/[% domain %]/www/.well-known
chmod 0755 [% install_dir %]/[% domain %]/www/.well-known
[%# Remove the misspelled .well_known that older guests have.  rmdir, not
    rm -rf: this recipe only made it empty, so files in it belong to someone
    else. -%]
rmdir [% install_dir %]/[% domain %]/www/.well_known 2>/dev/null; /bin/true
