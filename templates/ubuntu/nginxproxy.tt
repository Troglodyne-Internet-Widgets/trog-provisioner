# Setup the domain and its aliases
mv nginx.domain.conf /etc/nginx/sites-enabled/[% domain %].conf
# Queued, not immediate.  The nginx recipe is a dependency of this one, and a
# dependency is ordered after the thing that dragged it in -- so at this point
# conf.d/global.conf is not installed yet, and this vhost's proxy block refers
# to $connection_upgrade, which that file's map defines.  Restarting here fails
# on `unknown "connection_upgrade" variable` every time.
[% script_dir %]/queue_postrun_task systemctl restart nginx
[%# The document root of every vhost that has one.  nginx does not create a root
    and does not refuse to start without one -- it serves 404 for everything
    under it, which looks like an application fault rather than a missing
    directory.

    Only the ones a recipe declared: a vhost with no static_dir serves no files,
    so making it a www/ to serve them out of invented a directory for every
    reverse proxy on the fleet and told nginx to stat it. -%]
[% FOR vhost IN vhosts.keys().sort() %]
[% IF !vhosts.$vhost.ssl_redirect AND vhosts.$vhost.static_dir %]
mkdir -p '[% install_dir %]/[% domain %]/[% vhosts.$vhost.static_dir %]'
[%# Recursive, and this is the one place in this fragment that reaches inside
    the directory instead of just retagging it.  data already rsynced whatever
    the domain has to serve and left it 0750 user:admin_user, so the entries
    under static_dir carry that group -- not www-data -- however far down they
    go, and a non-recursive chown only ever retags the directory entry itself.
    Only the group changes here; data already set the mode this recipe wants
    group-read to mean. -%]
chown -R [% user %]:www-data '[% install_dir %]/[% domain %]/[% vhosts.$vhost.static_dir %]'
[%# And on every directory in the tree, so a file the running application adds
    after this recipe lands in the www-data group too, the way redis and mail
    keep their own later writes in the group they were handed here.  Directories
    only -- the setgid bit on a file means something else entirely, and there is
    no reason for one of these to carry it. -%]
find '[% install_dir %]/[% domain %]/[% vhosts.$vhost.static_dir %]' -type d -exec chmod g+s {} +
[% END -%]
[% END -%]
[%# The data recipe leaves the domain directory 0750 user:admin_user, and
    www-data is neither -- so it cannot traverse down to a docroot it has
    otherwise been let into, and every request for a static file fails stat()
    with permission denied and falls through the try_files chain to the proxy.
    o+x only: descend, not list or read, so the directory stays as closed to
    everyone else as the data recipe left it.  Runs after the data target
    (this recipe comes after it in the lexical order the makefile builds
    targets in), so the bit sticks rather than getting overwritten by the
    chmod data itself runs. -%]
[% IF serves_static %]
chmod o+x '[% install_dir %]/[% domain %]'
[% END -%]
[%# And every directory strictly between the domain root and a declared
    static_dir.  www/static is two levels deep, and www is not invented by
    this recipe -- data rsyncs it down already populated whenever the domain
    has content checked in, leaving it 0750 same as the domain root, which
    shuts www-data out one level further in than the chmod above reaches. -%]
[% FOR dir IN traverse_dirs %]
chmod o+x '[% install_dir %]/[% domain %]/[% dir %]'
[% END -%]
# Get ready for ACME
[%# .well-known, with a hyphen.  RFC 8615 spells it that way and so does every
    ACME client; an underscore is a directory nothing will ever fetch out of. -%]
mkdir -p [% install_dir %]/[% domain %]/www/.well-known; /bin/true
chown [% user %]:www-data [% install_dir %]/[% domain %]/www/.well-known
chmod 0755 [% install_dir %]/[% domain %]/www/.well-known
[%# The misspelled one off a guest that was built before this.  rmdir and not
    rm -rf: it is only ever made empty, so one with anything in it is somebody
    else.s and not ours to remove. -%]
rmdir [% install_dir %]/[% domain %]/www/.well_known 2>/dev/null; /bin/true
