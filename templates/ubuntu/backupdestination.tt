mv backupdestination.cron /etc/cron.d/[% domain %]-backups
# Owned by root, or cron does not read it.  A file moved out of the payload
# keeps the owner recorded in the tarball, which is the user who built it.
chown root:root /etc/cron.d/[% domain %]-backups
chmod 0644 /etc/cron.d/[% domain %]-backups
chmod 0600 "[% install_dir %]/[% domain %]/[% key_file %]"
