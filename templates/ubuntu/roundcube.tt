mkdir -p [% install_dir %]/webmail.[% domain %]
mkdir -p [% install_dir %]/webmail.[% domain %]_data
wget -O [% install_dir %]/webmail.[% domain %]/roundcube.tar.gz https://github.com/roundcube/roundcubemail/releases/download/[% version %]/roundcubemail-[% version %]-complete.tar.gz
cd [% install_dir %]/webmail.[% domain %] && tar --strip-components=1 -zxvf roundcube.tar.gz
[%# php-fpm includes only pool.d/*.conf, so the pool must be a .conf.  The rm
    takes away a .ini pool that an older version of this recipe installed. -%]
install -m 0644 fpm.ini /etc/php/$(PHP_VER)/fpm/pool.d/roundcube-[% domain %].conf
rm -f /etc/php/$(PHP_VER)/fpm/pool.d/roundcube-[% domain %].ini
install config.inc.php [% install_dir %]/webmail.[% domain %]/config/config.inc.php
[% script_dir %]/queue_postrun_task systemctl restart php$(PHP_VER)-fpm
[%# Roundcube does not create its own schema, so this loads it.  On a rebuild,
    the data target runs first and restores the salvaged database.  test -s
    then skips the load, because sqlite3 stops on a table that already exists.
    See Provisioner::Recipe::roundcube. -%]
test -s [% install_dir %]/webmail.[% domain %]_data/roundcube.db || sqlite3 [% install_dir %]/webmail.[% domain %]_data/roundcube.db < [% install_dir %]/webmail.[% domain %]/SQL/sqlite.initial.sql
[%# The pool runs as the service user of this domain, not as www-data.  That
    user must write the database, its journal, and the logs and temp
    directories under the docroot.  nginx needs only the www-data group to
    serve the static files. -%]
chown -R [% user %]:www-data [% install_dir %]/webmail.[% domain %]_data
chown -R [% user %]:www-data [% install_dir %]/webmail.[% domain %]
# Set up the vhost
mkdir -p /etc/nginx/sites-enabled; /bin/true
mv webmail_nginx.conf /etc/nginx/sites-enabled/webmail.[% domain %].conf
chown root:root /etc/nginx/sites-enabled/webmail.[% domain %].conf
[% script_dir %]/queue_postrun_task systemctl reload nginx
# Clean up
rm [% install_dir %]/webmail.[% domain %]/roundcube.tar.gz
