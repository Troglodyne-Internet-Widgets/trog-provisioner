[%# A guest whose registrar names an authority.  See the POD of
    Provisioner::Recipe::registrar. -%]
[%# The resolver target installs the drop-in for the authority.  See
    resolver_files in Provisioner::Recipe. -%]
[% IF authority -%]
[% IF fleet_anchor -%]
[%# The authority that the API of the pdns guest chains to, at the path where
    acmeca installs the same one. -%]
install -o root -g root -m 0644 registrar-anchor.crt /usr/local/share/ca-certificates/trog-acmeca.crt
update-ca-certificates >/dev/null
[% END -%]
[% END -%]
[% IF upstream -%]
[%# The registrar of the zone above, where the NS record of the zone of this
    domain goes, and the glue of a nameserver inside the zone.  In slot 0 of
    the postrun, before the fetcher of letsencrypt, because the CA validates
    through the zone above.  Provisioner::Recipe::registrar says why. -%]
install -d -o root -g root -m 0700 /opt/lexicon/upstream
install -o root -g root -m 0700 registrar-upstream.sh /opt/lexicon/upstream/[% domain %]
POSTRUN_SLOT=0 [% script_dir %]/queue_postrun_task [% script_dir %]/publish_dns_records --delegate --shortcut /opt/lexicon/upstream/[% domain %] [% domain %] [% nameserver %][% IF glue %] [% glue %][% END %]
[% END -%]
bash registrar-zones.sh
rm -f registrar-resolved.conf registrar-upstream.sh registrar-zones.sh
[% INCLUDE "files/registrar.publish.tt" %]
