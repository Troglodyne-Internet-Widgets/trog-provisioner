[%# The data target copies the whole domain directory, so the private half of
    the backup key arrives here.  It must not stay.  -f, so that a second
    provision does not fail when the key is already gone. -%]
rm -f [% install_dir %]/[% domain %]/[% key_file %]
[%# /etc, not /root: some builds of rsync do not read a configuration from
    /root.  Provisioner::Recipe::backup has the whole account. -%]
mv rsyncd.conf /etc/rsyncd.[% domain %].conf
[%# Owned by root, because otherwise the owner is the user who built the payload tarball. -%]
chown root:root /etc/rsyncd.[% domain %].conf
chmod 0644 /etc/rsyncd.[% domain %].conf
[%# Removes the configuration from the old location on an older guest. -%]
rm -f /root/rsyncd.[% domain %].conf
mkdir -p /root/.ssh; chmod 0700 /root/.ssh
touch /root/.ssh/authorized_keys; chmod 0600 /root/.ssh/authorized_keys
[%# Delete every line for this key, then write the current one, so the key
    appears once and with the current forced command. -%]
sed -i '\|[% pubkey %]|d' /root/.ssh/authorized_keys
echo "command=\"rsync --daemon --server --config=/etc/rsyncd.[% domain %].conf .\",no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding [% pubkey %]" >> /root/.ssh/authorized_keys
