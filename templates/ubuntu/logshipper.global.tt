[%# A guest that is its own destination installs nothing, and its generated
    file is empty.  See Provisioner::Recipe::logshipper. -%]
[% IF target -%]
install -o root -g root -m 0644 logshipper.conf /etc/rsyslog.d/10-logshipper.conf
[%# The outbound hole.  These guests deny outgoing traffic by default, and
    setup-ufw-rules issues an allow out for every profile it finds. -%]
install -o root -g root -m 0644 logshipper_ufw.conf /etc/ufw/applications.d/logshipper
[%# Queued, because nothing in the build reads the drop-in back.  post_install
    runs before the guest tests, so rsyslog restarts before a test asks if the
    destination is reachable. -%]
[% script_dir %]/queue_postrun_task systemctl restart rsyslog
echo 'logshipper: forwarding [% selector %] to [% target %]:[% port %] over [% protocol %].'
[% ELSE -%]
echo 'logshipper: this guest is its own log destination, so it keeps its logs.'
[% END -%]
