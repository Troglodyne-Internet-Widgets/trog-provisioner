mkdir -p [% install_dir %]/[% domain %]
# The key of the guest reaches only the rsync modules that bin/new_config
# wrote for it.  See Provisioner::Recipe::data.
rsync -av -e 'ssh -p[% transfer_port %]' [% transfer_user %]@[% transfer_ip %]::data.[% domain %]/ [% install_dir %]/[% domain %]/
chown -R [% user %]:[% admin_user %] [% install_dir %]/[% domain %]
chmod -R 0750 [% install_dir %]/[% domain %]
[%# Put back the state that the recipes salvaged.  This is one loop, not a call
    in the fragment of each recipe.  The restores() of each recipe fills in the
    map.  See Provisioner::Recipe::restores.

    This comes after the rsync above, because the rsync brings the salvage onto
    the guest.  It comes before every recipe target, so that each recipe finds
    its state already in place.

    restore_state does nothing when nothing was salvaged, when the salvage is
    empty, or when the destination already has state.  So this loop does no
    checks of its own. -%]
[% FOR dest IN restores.keys().sort() %]
[% script_dir %]/restore_state '[% restores.$dest.from %]' '[% dest %]'[% IF restores.$dest.owner %] '[% restores.$dest.owner %]'[% ELSE %] ''[% END %][% IF restores.$dest.mode %] '[% restores.$dest.mode %]'[% END %]
[% END -%]
