[%# Every argument is quoted, so one that renders empty stays an argument and
    does not shift the others.  The last is where the salvaged dumps landed.
    The installer reads it only to skip the seed schema when a dump exists. -%]
[% script_dir %]/install_mariadb.sh "[% version %]" "mariadb-provisioner.cnf" "secure_installation.sql" "[% install_dir %]/[% domain %]/[% dumpfile %]" "[% install_dir %]/[% domain %]/mysql"
# The other half of the round trip for remote_files.  Installed as well as run,
# so that an operator can run the restore again by hand, against any dump.
install -m 0750 mariadb-restore.sh /usr/local/sbin/mariadb-restore.sh
/usr/local/sbin/mariadb-restore.sh "[% install_dir %]/[% domain %]/mysql"
# Home directories come from getent, not ~name.  The home of the service user
# is the domain directory, not /home.  Provisioner::Recipe::mariadb explains the
# files.
install -m 0600 -o root -g root mariadb-client.cnf /root/.my.cnf
install -m 0600 -o [% admin_user %] -g "$$(id -gn [% admin_user %])" mariadb-client.cnf "$$(getent passwd [% admin_user %] | cut -d: -f6)/.my.cnf"
[% IF user != admin_user -%]
install -m 0600 -o [% user %] -g "$$(id -gn [% user %])" mariadb-client-service.cnf "$$(getent passwd [% user %] | cut -d: -f6)/.my.cnf"
[% END -%]
install -m 0750 mariadb-backup.sh /usr/local/sbin/mariadb-backup.sh
install -m 0644 mariadb-backup.cron /etc/cron.d/mariadb-backup
mkdir -p /var/backups/mysql
