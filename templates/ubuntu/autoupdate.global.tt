mv autoupdate_cron /etc/cron.d/autoupdate
# Owned by root, or cron does not read it.  A file moved out of the payload
# keeps the owner recorded in the tarball, which is the user who built it.
# cron applies owner and mode rules to all of cron.d unless it runs with -p.
chown root:root /etc/cron.d/autoupdate
chmod 0644 /etc/cron.d/autoupdate
