[%# The server_name of the vhost that serves the domain, which that vhost
    includes.  Provisioner::Recipe::nginx decides the names, under The names
    that each vhost answers for. -%]
rm -f /etc/nginx/names/[% domain %].conf
[% IF domain_names -%]
mkdir -p /etc/nginx/names
printf 'server_name %s;\n' '[% domain_names.join(' ') %]' > /etc/nginx/names/[% domain %].conf
[% END -%]
[%# What each vhost that a public name names adds to its server blocks on 443
    and 80 for a proxy: a listener, and the names that it answers for there.
    The proxy says who the client is in a PROXY header on 8443, and in
    X-Forwarded-For on 8080.  A vhost includes the file of its name if there is one.
    Provisioner::Recipe::nginx has the whole account. -%]
rm -rf /etc/nginx/proxied
mkdir -p /etc/nginx/proxied
[% IF proxied_http -%]
install -o root -g root -m 0644 nginx_proxy_ufw.conf /etc/ufw/applications.d/nginx-proxy
[% FOR vhost IN proxied_http.keys().sort() -%]
[% IF proxied.$vhost.defined() -%]
printf '%s\n' 'listen 8443 ssl proxy_protocol;'[% IF proxied.$vhost.size() %] 'server_name [% proxied.$vhost.join(' ') %];'[% END %] > /etc/nginx/proxied/[% vhost %].443.conf
[% END -%]
printf '%s\n' 'listen 8080;' 'real_ip_header X-Forwarded-For;'[% IF proxied_http.$vhost.size() %] 'server_name [% proxied_http.$vhost.join(' ') %];'[% END %] > /etc/nginx/proxied/[% vhost %].80.conf
[% END -%]
[% END -%]
[% script_dir %]/queue_postrun_task systemctl reload nginx
[%# The ban action that sends each ban of the jails of nginx to the relay.
    Provisioner::Recipe::nginx has the whole account. -%]
rm -f /etc/fail2ban/jail.d/[% domain %]-relay.conf /etc/fail2ban/action.d/nginxrelay-[% domain %].conf
[% IF ban_relay -%]
[% INCLUDE "files/relay.client.tt" WITH action_file = 'nginx_relay.action' %]
install -o root -g root -m 0644 nginx_relay.jail /etc/fail2ban/jail.d/[% domain %]-relay.conf
[%# Here, because fail2ban runs no jail at all while one action does not
    parse, and the restart in the postrun would fail with no reason. -%]
fail2ban-client -t
[% END -%]
[%# The command that sends the certificate of each media name to the relay,
    which letsencrypt runs after each run of dehydrated.  It runs here too,
    because the target of letsencrypt ran get_cert before this command was in
    place.  Provisioner::Recipe::nginx has the whole account, under Media
    names. -%]
rm -f /etc/dehydrated/deployers/nginxrelay-[% domain %]
[% IF relay_cert -%]
umask 077 && base64 -d [% relay_cert.key_b64 %] > [% relay_cert.key %]
install -d -o root -g root -m 0700 /etc/dehydrated/deployers
install -o root -g root -m 0700 nginx_relay_cert [% relay_cert.deployer %]
[% FOR name IN relay_cert.names -%]
[% relay_cert.deployer %] [% name %] /var/lib/dehydrated/certs/[% name %]/privkey.pem /var/lib/dehydrated/certs/[% name %]/fullchain.pem
[% END -%]
[% END -%]
