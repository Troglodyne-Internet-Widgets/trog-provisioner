[%# The server_name of the vhost that serves the domain, which that vhost
    includes.  Provisioner::Recipe::nginx decides the names, under The names
    that each vhost answers for. -%]
rm -f /etc/nginx/names/[% domain %].conf
[% IF domain_names -%]
mkdir -p /etc/nginx/names
printf 'server_name %s;\n' '[% domain_names.join(' ') %]' > /etc/nginx/names/[% domain %].conf
[% END -%]
[%# What the vhost of the domain adds to its server blocks on 443 and 80 for a
    proxy: a listener with the PROXY protocol, and the networks whose header it
    believes.  Empty without public_names, because the vhost includes it either
    way.  Provisioner::Recipe::nginx has the whole account. -%]
mkdir -p /etc/nginx/proxied
[% IF public_names.size() -%]
install -o root -g root -m 0644 nginx_proxy_ufw.conf /etc/ufw/applications.d/nginx-proxy
printf '%s\n' 'listen 8443 ssl proxy_protocol;'[% FOR net IN proxy_from %] 'set_real_ip_from [% net %];'[% END %] 'real_ip_header proxy_protocol;' > /etc/nginx/proxied/[% domain %].443.conf
printf '%s\n' 'listen 8080 proxy_protocol;'[% FOR net IN proxy_from %] 'set_real_ip_from [% net %];'[% END %] 'real_ip_header proxy_protocol;' > /etc/nginx/proxied/[% domain %].80.conf
[% ELSE -%]
: > /etc/nginx/proxied/[% domain %].443.conf
: > /etc/nginx/proxied/[% domain %].80.conf
[% END -%]
[% script_dir %]/queue_postrun_task systemctl reload nginx
