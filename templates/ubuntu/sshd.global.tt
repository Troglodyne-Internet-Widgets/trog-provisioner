[%# bin/provision placed the private key from the secret store before this
    ran.  The public key that cloud-init wrote belongs to the key that it
    replaced, so derive it again.  100-security.conf is where the makefile kept
    the policy before this recipe, on a guest provisioned in place.
    Provisioner::Recipe::sshd has the whole account. -%]
ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key > /etc/ssh/ssh_host_ed25519_key.pub
install -o root -g root -m 0644 sshd.conf /etc/ssh/sshd_config.d/10-provisioner.conf
rm -f /etc/ssh/sshd_config.d/100-security.conf
[% script_dir %]/check_sshd_config
[% script_dir %]/queue_postrun_task systemctl try-reload-or-restart ssh
