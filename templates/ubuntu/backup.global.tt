[%# rsyncd opens its log before it chroots, so the directory has to be out
    here rather than inside the path of some module.  One for the guest, since
    every domain logs into it. -%]
mkdir -p /var/log/rsyncd
mv backup.logrotate /etc/logrotate.d/rsyncd-backup
[%# Owned by root and mode 0644, or logrotate skips the file and reports it
    only in its --debug output.  A file moved out of the payload keeps the
    owner recorded in the tarball, which is the user who built it. -%]
chown root:root /etc/logrotate.d/rsyncd-backup
chmod 0644 /etc/logrotate.d/rsyncd-backup
