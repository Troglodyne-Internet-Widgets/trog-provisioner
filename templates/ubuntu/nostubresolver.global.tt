mkdir /etc/systemd/resolved.conf.d/; /bin/true
cp 10-disable-stub-resolver.conf /etc/systemd/resolved.conf.d/
chown -R systemd-resolve:systemd-resolve /etc/systemd/resolved.conf.d/
chmod 0660 /etc/systemd/resolved.conf.d/10-disable-stub-resolver.conf
[%# Here, not queued.  post_install runs its queue in order, and letsencrypt
    queues its certificate fetcher first.  That fetcher needs this resolver.

    pdns and tmpfs do the same.  A service that a later step reads back starts
    in the target that configures it.  If it does not start, its own target
    fails. -%]
systemctl restart systemd-resolved
