# Koan, the autonomous coding bot.  Provisioner::Recipe::koan describes the
# layout on the guest.

# Clone or refresh koan in KOAN_ROOT.  It is a subdirectory because service_user
# already made the parent, and git clone needs a directory that is empty.
# Each command sets HOME, because atd starts the makefile without one.  It is
# the home of the service user, so global git configuration goes where the bot
# reads it.
if [ ! -d '[% install_dir %]/[% domain %]/koan/.git' ]; then \
    HOME='[% install_dir %]/[% domain %]' git clone --branch '[% repo_branch %]' '[% repo_url %]' '[% install_dir %]/[% domain %]/koan'; \
else \
    cd '[% install_dir %]/[% domain %]/koan' \
        && HOME='[% install_dir %]/[% domain %]' git fetch origin \
        && HOME='[% install_dir %]/[% domain %]' git reset --hard 'origin/[% repo_branch %]'; \
fi
HOME='[% install_dir %]/[% domain %]' git config --global --get-all safe.directory 2>/dev/null | grep -qFx '[% install_dir %]/[% domain %]/koan' \
    || HOME='[% install_dir %]/[% domain %]' git config --global --add safe.directory '[% install_dir %]/[% domain %]/koan'

# Copy instance.example into the gitignored instance/ tree, but keep each file
# that is already there.  The `-e "$f"` test stops a copy of a literal '*'.
mkdir -p '[% install_dir %]/[% domain %]/koan/instance'
mkdir -p '[% install_dir %]/[% domain %]/koan/logs'
for f in '[% install_dir %]/[% domain %]/koan/instance.example/'*; do \
    [ -e "$$f" ] || continue; \
    name="$$(basename "$$f")"; \
    [ -e "[% install_dir %]/[% domain %]/koan/instance/$$name" ] || cp -r "$$f" "[% install_dir %]/[% domain %]/koan/instance/$$name"; \
done

# Install the rendered configurations in KOAN_ROOT, where python-dotenv and
# koan look for them.
install -o '[% user %]' -g '[% user %]' -m 0640 koan.env         '[% install_dir %]/[% domain %]/koan/.env'
install -o '[% user %]' -g '[% user %]' -m 0640 koan.config.yaml '[% install_dir %]/[% domain %]/koan/instance/config.yaml'
# Keep a projects.yaml that was salvaged from an earlier guest.
test ! -f '[% install_dir %]/[% domain %]/koan/projects.yaml' && install -o '[% user %]' -g '[% user %]' -m 0640 koan.projects.yaml   '[% install_dir %]/[% domain %]/koan/projects.yaml'

# Build the virtualenv as the service user, outside KOAN_ROOT so that
# `git reset --hard` does not remove it.
runuser -u '[% user %]' -- python3 -m venv '[% install_dir %]/[% domain %]/.venv'
runuser -u '[% user %]' -- '[% install_dir %]/[% domain %]/.venv/bin/pip' install --quiet --upgrade pip
runuser -u '[% user %]' -- '[% install_dir %]/[% domain %]/.venv/bin/pip' install --quiet -r '[% install_dir %]/[% domain %]/koan/koan/requirements.txt'

[% IF cli_provider == 'claude' %]
# Seed ~/.claude.json so that Claude Code skips its onboarding.  The
# CLAUDE_CODE_OAUTH_TOKEN in .env does the authentication.  Without
# hasCompletedOnboarding, Claude tries a browser login that a service cannot do.
# Keep a file that is there, because remote_files restores the full account state.
if [ ! -f '[% install_dir %]/[% domain %]/.claude.json' ]; then \
    printf '{"hasCompletedOnboarding":true}\n' > '[% install_dir %]/[% domain %]/.claude.json'; \
    chown '[% user %]:[% user %]' '[% install_dir %]/[% domain %]/.claude.json'; \
    chmod 0600 '[% install_dir %]/[% domain %]/.claude.json'; \
fi
[% END %]

[% IF messaging_provider == 'matrix' && matrix_e2ee && matrix_password && !matrix_access_token %]
# Matrix E2EE bootstrap.  It mints a new device for the bot, because a reused
# device_id breaks Megolm with no error.  It writes the access token and the
# device to instance/matrix/credentials.env.  The systemd units load that file
# with a second EnvironmentFile=.  A later provision skips this while the file exists.
if [ ! -f '[% install_dir %]/[% domain %]/koan/instance/matrix/credentials.env' ]; then \
    install -d -o '[% user %]' -g '[% user %]' -m 0700 '[% install_dir %]/[% domain %]/koan/instance/matrix'; \
    KOAN_ROOT='[% install_dir %]/[% domain %]/koan' \
    KOAN_MATRIX_HOMESERVER='[% matrix_homeserver %]' \
    KOAN_MATRIX_USER_ID='[% matrix_user_id %]' \
    KOAN_MATRIX_PASSWORD='[% matrix_password %]' \
    KOAN_MATRIX_PICKLE_KEY='[% matrix_pickle_key %]' \
    PYTHONPATH='[% install_dir %]/[% domain %]/koan/koan' \
    runuser -u '[% user %]' -- '[% install_dir %]/[% domain %]/.venv/bin/python' -m app.matrix_login; \
fi
[% END %]

# Give the checkout, the virtualenv and the git configuration to the service
# user.  Not the whole domain directory, because data owns that, and admincode
# owns its basedir.  Then .env and config.yaml become 0640 root:[% user %], so
# the bot can read them but not change them.
chown -R '[% user %]:[% admin_user %]' '[% install_dir %]/[% domain %]/koan' '[% install_dir %]/[% domain %]/.venv'
chown '[% user %]:[% admin_user %]' '[% install_dir %]/[% domain %]/.gitconfig'
chown root:'[% user %]' '[% install_dir %]/[% domain %]/koan/.env' '[% install_dir %]/[% domain %]/koan/instance/config.yaml'
chmod 0640 '[% install_dir %]/[% domain %]/koan/.env' '[% install_dir %]/[% domain %]/koan/instance/config.yaml'
find '[% install_dir %]/[% domain %]/.venv' -type d -exec chmod 0750 {} +

# systemd units
install -o root -g root -m 0644 koan.service       /etc/systemd/system/koan.service
install -o root -g root -m 0644 koan-awake.service /etc/systemd/system/koan-awake.service
systemctl daemon-reload
systemctl enable koan-awake.service
systemctl enable koan.service

[% IF messaging_provider == 'matrix' %]
# Install the ufw profile for matrix federation.  koan.ufw.conf.tt says why.
install -o root -g root -m 0644 koan_ufw.conf /etc/ufw/applications.d/koan
[% END %]

# The clones need the login state and the ssh key of the bot, and
# Provisioner::Recipe::github writes those in its own target, which runs after
# this one.  So the clones go in the postrun queue, ahead of the line below
# that starts the bot.
install -o root -g '[% user %]' -m 0750 koan-clone-projects.sh '[% install_dir %]/[% domain %]/koan-clone-projects.sh'
[% script_dir %]/queue_postrun_task '[% install_dir %]/[% domain %]/koan-clone-projects.sh'

# Start koan after every other target has run.
[% script_dir %]/queue_postrun_task systemctl start koan.service
