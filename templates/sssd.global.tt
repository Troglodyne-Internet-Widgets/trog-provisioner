# Install SSSD configuration
install -m 0600 sssd.conf /etc/sssd/sssd.conf
chown root:root /etc/sssd/sssd.conf

# Wire NSS and PAM to use SSSD.  pam-auth-update is the Debian-family way and
# does the whole job; authselect used to be called here as well, which is a
# Fedora tool whose profiles rewrite the same files in a different style.  It is
# not in this recipe's packages either, so all it ever produced was a "command
# not found" swallowed by the /bin/true after it.
pam-auth-update --enable sss

# Enable automatic home directory creation on first login
pam-auth-update --enable mkhomedir; /bin/true

[% script_dir %]/queue_postrun_task systemctl enable sssd
[% script_dir %]/queue_postrun_task systemctl restart sssd
