# User and password database
userdb {
    driver = passwd-file
    args = /mail/[% domain %]/passwd
    result_failure = continue
    result_internalfail = continue
}
passdb {
    driver = passwd-file
    args = /mail/[% domain %]/passwd
}
[% IF default_realm %]
# A name with no domain is an account of this domain, the domain of the machine.
auth_default_realm = [% domain %]
[% END %]

# SNI
local_name [% domain %] {
  ssl_cert = </etc/ssl/certs/[% domain %].pem
  ssl_key = </etc/ssl/private/[% domain %].pem
}

[% FOREACH alias IN domain_aliases.sort() %]
local_name [% alias %] {
  ssl_cert = </etc/ssl/certs/[% domain %].pem
  ssl_key = </etc/ssl/private/[% domain %].pem
}
[% END %]


