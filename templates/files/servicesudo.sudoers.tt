# Generated by Provisioner::Recipe::servicesudo.  The service user runs these
# as root with no password, and nothing else.
[%# mark_raw, because Xslate escapes for HTML, and a command that takes no
    arguments ends in two double quotes.  The schema refuses only plain
    mistakes.  check_sudoers_grant refuses a file that sudo reads as more
    than the commands, before it is installed.  See
    Provisioner::Recipe::servicesudo. -%]
[% IF user != admin_user -%]
Defaults:[% user %] !mail_badpass, !mail_no_perms
[% FOR command IN commands -%]
[% user %] ALL=(root) NOPASSWD: [% command | mark_raw %]
[% END -%]
[% END -%]
