# Generated by Provisioner::Recipe::servicesudo.  The service user runs these
# as root with no password, and nothing else.
[%# mark_raw, because Xslate escapes for HTML, and a command that takes no
    arguments ends in two double quotes.  The schema of the recipe refuses
    everything in a command that sudoers reads as syntax. -%]
[% FOR command IN commands -%]
[% user %] ALL=(root) NOPASSWD: [% command | mark_raw %]
[% END -%]
