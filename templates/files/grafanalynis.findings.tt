# Generated by Provisioner::Recipe::grafanalynis.  scripts/lynis_audit sends
# three kinds of message with the appname lynis:
#
#   hardening_index=67 warnings=3 suggestions=48
#   warning KRNL-5830: Reboot of system is most likely needed
#   suggestion PKGS-7394: Install package apt-show-versions for patch management purposes
#
# InfluxQL has no function that takes a part of a string, so this puts the
# numbers into fields, and the kind and test of a finding into tags, for the
# Lynis dashboard to read.  The Starlark of telegraf has no regex module, so it
# splits the message.

SUMMARY = ["hardening_index", "warnings", "suggestions"]
FINDINGS = ["warning", "suggestion"]

def apply(metric):
    message = metric.fields.get("message")
    if type(message) != "string":
        return metric
    message = message.strip()

    if message.startswith("hardening_index="):
        for pair in message.split(" "):
            key, _, value = pair.partition("=")
            if key in SUMMARY and value.isdigit():
                metric.fields["lynis_" + key] = int(value)

        # The time of the report as a number, because InfluxQL cannot subtract
        # the time of a point, and the dashboard works out the age of the
        # report from it.  The syslog input keeps the time of the message in
        # timestamp, and gives the point the time that it arrived, which is
        # later when a shipper held the message while the collector was down.
        stamp = metric.fields.get("timestamp")
        if type(stamp) != "int":
            stamp = metric.time
        metric.fields["lynis_reported"] = stamp // 1000000000
        return metric

    kind, _, rest = message.partition(" ")
    test, separator, text = rest.partition(": ")
    if kind in FINDINGS and separator and test:
        metric.tags["lynis_finding"] = kind
        metric.tags["lynis_test"] = test
        metric.fields["lynis_text"] = text
    return metric
