#!/bin/bash

# Put a salvaged PostgreSQL dump into a cluster that was just built.  If there is
# nothing to put back, load the seed dumps that the recipe was configured with.
#
#     postgres-restore.sh <salvaged dump directory> [seed dump ...]
#
# The directory is what remote_files fetched: /var/backups/postgres from the
# guest that this one replaces.  postgres-backup.sh lays it out as <timestamp>/,
# with globals.sql.gz and a directory-format dump for each database.
#
# The salvage is what this guest actually had.  The seeds are for a domain that
# never had a database.  The salvage wins, and neither goes over a database that
# is already there.  So a rebuilt cluster gets all of it, and a live cluster gets
# nothing.  Provisioner::Recipe::postgres has the whole account.
set -euo pipefail
shopt -s nullglob

SALVAGED="${1:?usage: postgres-restore.sh <salvaged dump directory> [seed dump ...]}"
shift

# Everything that talks to the cluster runs as postgres, because the socket uses
# peer authentication.  This script reads the dumps and pipes them in, because
# the domain directory is 0750 to the admin group, and postgres is not in it.
psql_super() { sudo -u postgres psql --quiet --no-psqlrc "$@"; }

# The name comes from a directory in the salvage, so a quote in it is doubled
# before it goes into the string literal.
database_exists() {
    [ -n "$(psql_super -tAc "SELECT 1 FROM pg_database WHERE datname='${1//\'/\'\'}'")" ]
}

user_databases() {
    psql_super -tAc "SELECT datname FROM pg_database WHERE datistemplate=false AND datname<>'postgres'"
}

# The last thing postgres-backup.sh writes is `complete`.  A directory without it
# is a backup that stopped before the end, so it is skipped.  A database restored
# from half a dump is never written over later.  If you know that a dump is whole,
# touch the file.  The glob sorts the timestamps oldest first, so the loop walks
# back from the end.
newest_finished_dump() {
    local dumps=( "$SALVAGED"/*/ )
    local i
    for (( i = ${#dumps[@]} - 1; i >= 0; i-- )); do
        if [ -f "${dumps[$i]}complete" ]; then
            printf '%s\n' "${dumps[$i]%/}"
            return 0
        fi
    done
    return 1
}

restored=0
if DUMP="$(newest_finished_dump)"; then
    pending=()
    for dbdir in "$DUMP"/*/; do
        db="$(basename "$dbdir")"
        if database_exists "$db"; then
            echo "postgres-restore.sh: $db is already in this cluster, keeping what it has"
            continue
        fi
        pending+=( "$db" )
    done

    if [ "${#pending[@]}" -gt 0 ]; then

        # Roles come first, because the databases and grants name them.  Errors
        # are not fatal: initdb made the postgres role, and the dump creates it
        # again.
        if [ -f "$DUMP/globals.sql.gz" ]; then
            echo "postgres-restore.sh: restoring roles from $DUMP/globals.sql.gz"
            pigz -dc "$DUMP/globals.sql.gz" | psql_super -d postgres || true
        fi

        for db in "${pending[@]}"; do
            echo "postgres-restore.sh: restoring $db from $DUMP"

            # --file=- writes the dump as SQL on stdout, because this script
            # cannot connect to the cluster as itself.  --create puts the
            # CREATE DATABASE and its \connect into that SQL.
            pg_restore --create --file=- "$DUMP/$db" \
                | psql_super --set ON_ERROR_STOP=1 -d postgres
            restored=$(( restored + 1 ))
        done
    fi
fi

if [ "$restored" -gt 0 ]; then
    echo "postgres-restore.sh: restored $restored database(s) from $DUMP"
    exit 0
fi

if [ -n "$(user_databases)" ]; then
    echo "postgres-restore.sh: this cluster already has databases of its own; the seed dumps are not loaded over them"
    exit 0
fi

for seed in "$@"; do
    echo "postgres-restore.sh: loading the seed dump $seed"
    psql_super < "$seed"
done
