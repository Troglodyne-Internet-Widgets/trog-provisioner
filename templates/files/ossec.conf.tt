<!-- Generated by Provisioner::Recipe::ossec, which says why each part is here. -->
<ossec_config>
  <global>
    <email_notification>no</email_notification>
    <jsonout_output>yes</jsonout_output>
  </global>

  <!-- ossec_package_rules puts the rule list of the package here, in its
       order, because a rule can name rules in the files before it. -->
  <rules>
  </rules>

  <!-- The copy of the fleet's stream, from logcollector, as text. -->
  <remote>
    <connection>syslog</connection>
    <protocol>tcp</protocol>
    <port>[% port %]</port>
    <local_ip>127.0.0.1</local_ip>
    <allowed-ips>127.0.0.1</allowed-ips>
  </remote>

  <!-- Every alert, as JSON, to the syslog input of telegraf. -->
  <syslog_output>
    <server>127.0.0.1</server>
    <port>[% alerts_port %]</port>
    <format>json</format>
  </syslog_output>

  <!-- The agents do these.  The manager reads logs only. -->
  <syscheck>
    <disabled>yes</disabled>
  </syscheck>
  <rootcheck>
    <disabled>yes</disabled>
  </rootcheck>

  <alerts>
    <log_alert_level>1</log_alert_level>
  </alerts>
</ossec_config>
