<!-- configd merges this over the ossec.conf of the package, which it keeps as
     00-original, with its rule list in its order.  An empty element clears
     what the package put in that list.  Provisioner::Recipe::ossec says why
     each part is here. -->
<ossec_config>
  <!-- Mail goes only for the rules that mark their alerts alert_by_email,
       which are the rules of watchers_rules.xml.  No alert reaches the
       level. -->
  <global>
    <email_notification>yes</email_notification>
    <email_to/>
    <email_to>[% admin_email %]</email_to>
    <email_from>ossec@[% domain %]</email_from>
    <smtp_server>127.0.0.1</smtp_server>
    <white_list/>
  </global>
  <alerts>
    <email_alert_level>16</email_alert_level>
  </alerts>

  <!-- After the rule files of the package, because each of its rules is a
       child of rules in those files. -->
  <rules>
    <include>watchers_rules.xml</include>
  </rules>

  <!-- The copy of the fleet's stream, from logcollector, as text, and the
       agents of the guests.  The package's listeners are cleared first. -->
  <remote/>
  <remote>
    <connection>syslog</connection>
    <protocol>tcp</protocol>
    <port>[% port %]</port>
    <local_ip>127.0.0.1</local_ip>
    <allowed-ips>127.0.0.1</allowed-ips>
  </remote>
  <remote>
    <connection>secure</connection>
    <protocol>udp</protocol>
    <port>1514</port>
  </remote>

  <!-- No active response, and none of the log files of the example. -->
  <command/>
  <active-response/>
  <localfile/>

  <!-- The agents do these.  The manager reads logs only.  alert_new_files
       is for the agents: analysisd raises an alert for a file that syscheck
       sees for the first time only when it is on. -->
  <syscheck>
    <disabled>yes</disabled>
    <alert_new_files>yes</alert_new_files>
  </syscheck>
  <rootcheck>
    <disabled>yes</disabled>
  </rootcheck>
</ossec_config>
