<!-- configd merges this over the ossec.conf of the package, which it keeps as
     00-original, with its rule list in its order.  An empty element clears
     what the package put in that list.  Provisioner::Recipe::ossec says why
     each part is here. -->
<ossec_config>
  <global>
    <email_notification>no</email_notification>
    <email_to/>
    <jsonout_output>yes</jsonout_output>
    <white_list/>
  </global>

  <!-- The copy of the fleet's stream, from logcollector, as text, and not the
       listener of the agents that the package configures. -->
  <remote/>
  <remote>
    <connection>syslog</connection>
    <protocol>tcp</protocol>
    <port>[% port %]</port>
    <local_ip>127.0.0.1</local_ip>
    <allowed-ips>127.0.0.1</allowed-ips>
  </remote>

  <!-- Every alert, as JSON, to the syslog input of telegraf. -->
  <syslog_output>
    <server>127.0.0.1</server>
    <port>[% alerts_port %]</port>
    <format>json</format>
  </syslog_output>

  <!-- No active response, and none of the log files of the example. -->
  <command/>
  <active-response/>
  <localfile/>

  <!-- The agents do these.  The manager reads logs only. -->
  <syscheck>
    <disabled>yes</disabled>
  </syscheck>
  <rootcheck>
    <disabled>yes</disabled>
  </rootcheck>
</ossec_config>
