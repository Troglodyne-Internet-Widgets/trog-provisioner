# Troglodyne perlcritic policy
# Maximum severity, to make agents comply.  It is meant to hold the same
# policies as the .perlcriticrc of trog-provisioner, without the allow lists and
# stop words that only describe that repository.
severity  = 1
only      = 1
force     = 0
verbose   = 1
#theme     =
#include   =
#exclude   =
criticism-fatal = 1
color     = 1
allow-unsafe = 1
# Usability
[Modules::RequirePerlVersion]
[Documentation::RequirePod]
# Security
[ValuesAndExpressions::PreventSQLInjection]
; [CodeLayout::RequireASCII] is left out on purpose.  Code that declares
; use 5.041 gets source::encoding "ascii", and then a non-ASCII character is a
; compile error.  That is stricter than the policy, and nothing can skip it.
[RegularExpressions::RequireDefault]
strict = 1
# PEBCAK catches
[BuiltinFunctions::ProhibitDeleteOnArrays]
[Subroutines::ProhibitAmbiguousFunctionCalls]
[ValuesAndExpressions::ProhibitSingleArgArraySlice]
[Bangs::ProhibitUselessRegexModifiers]
[Bangs::ProhibitCommentedOutCode]
[Tics::ProhibitUseBase]
[ProhibitLeadingZeros]
[RegularExpressions::ProhibitEmptyAlternatives]
[ValuesAndExpressions::UnexpandedSpecialLiteral]
[CodeLayout::ProhibitIfIfSameLine]
[ValuesAndExpressions::ConstantBeforeLt]
[ValuesAndExpressions::ProhibitDuplicateHashKeys]
# A file test before an access is a race between the check and the use.
[ValuesAndExpressions::ProhibitFiletest_f]
[ValuesAndExpressions::ProhibitFiletest_rwxRWX]
# Bikeshed
[CognitiveComplexity::ProhibitExcessCognitiveComplexity]
warn_level = 40
info_level = 30
[Variables::ProhibitUselessInitialization]
[PreferredModules]
config = .preferred_modules.ini
[PreferredBinaries]
config = .preferred_binaries.ini
[logicLAB::RequireSheBang]
formats = #!/usr/bin/env perl
# Performance
[logicLAB::ProhibitShellDispatch]
[ProhibitPipeOpen]
[ProhibitRegexForSimpleSubstring]
[ProhibitUseLib]
[ProhibitUsageSubs]
[RequireQwForLiteralLists]
[ProhibitNoWarningsRedefine]
[RequireFatalWarnings]
[ProhibitUnusedImports]
# use re '/aasx' is a pragma, not an import that code calls.
allow = re
[ProhibitUnusedDefinitions]
[ProhibitPrintSTDERR]
# The policies of Perl::Critic itself.  only = 1 loads only the policies named
# here, so each one must be named.
;
; These are left out on purpose.  The policy on the right does the job better:
;   CodeLayout::ProhibitQuotedWordLists         RequireQwForLiteralLists
;   ControlStructures::ProhibitCascadingIfElse  CognitiveComplexity.  It scores
;   ControlStructures::ProhibitDeepNests          nesting and each break in the
;   Subroutines::ProhibitExcessComplexity         flow.  These count branches only.
;   InputOutput::ProhibitBacktickOperators      logicLAB::ProhibitShellDispatch
;   Modules::ProhibitEvilModules                PreferredModules
;   Subroutines::ProhibitUnusedPrivateSubroutines  ProhibitUnusedDefinitions
;   TestingAndDebugging::RequireUseWarnings     RequireFatalWarnings
;   ValuesAndExpressions::ProhibitLeadingZeros  ProhibitLeadingZeros
;   Modules::RequireVersionVar                  [PkgVersion], which Dist::Zilla runs at build
;   ErrorHandling::RequireCarping               die with context, and Carp::Always
;                                                 for the trace
;
; These are also left out.  Under use 5.041, perl does not compile the code
; they report.  The last one asks for a line that perl no longer needs:
;   InputOutput::ProhibitBarewordDirHandles     no feature "bareword_filehandles"
;   InputOutput::ProhibitBarewordFileHandles
;   Objects::ProhibitIndirectSyntax             no feature "indirect"
;   TestingAndDebugging::RequireUseStrict       strict, which use 5.012 and later
;                                                 turn on
;   Variables::ProhibitPerl4PackageNames        no apostrophe as package separator
;   Modules::RequireEndWithOne                  feature "module_true"
;
; Documentation::RequirePodSections is also left out.  Pod::Weaver writes the
; sections it asks for at build.
[BuiltinFunctions::ProhibitBooleanGrep]
[BuiltinFunctions::ProhibitLvalueSubstr]
[BuiltinFunctions::ProhibitReverseSortBlock]
[BuiltinFunctions::ProhibitShiftRef]
[BuiltinFunctions::ProhibitSleepViaSelect]
[BuiltinFunctions::ProhibitStringyEval]
[BuiltinFunctions::ProhibitStringySplit]
[BuiltinFunctions::ProhibitUniversalCan]
[BuiltinFunctions::ProhibitUniversalIsa]
[BuiltinFunctions::ProhibitVoidGrep]
[BuiltinFunctions::ProhibitVoidMap]
[BuiltinFunctions::RequireBlockGrep]
[BuiltinFunctions::RequireBlockMap]
[BuiltinFunctions::RequireGlobFunction]
[BuiltinFunctions::RequireSimpleSortBlock]
[ClassHierarchies::ProhibitAutoloading]
[ClassHierarchies::ProhibitExplicitISA]
[ClassHierarchies::ProhibitOneArgBless]
[CodeLayout::ProhibitHardTabs]
[CodeLayout::ProhibitTrailingWhitespace]
[CodeLayout::RequireConsistentNewlines]
[CodeLayout::RequireTidyCode]
[CodeLayout::RequireTrailingCommas]
[ControlStructures::ProhibitLabelsWithSpecialBlockNames]
[ControlStructures::ProhibitMutatingListFunctions]
[ControlStructures::ProhibitNegativeExpressionsInUnlessAndUntilConditions]
[ControlStructures::ProhibitUnreachableCode]
[ControlStructures::ProhibitUntilBlocks]
[ControlStructures::ProhibitYadaOperator]
[Documentation::PodSpelling]
spell_command = aspell --lang=en_US list
[Documentation::RequirePackageMatchesPodName]
[ErrorHandling::RequireCheckingReturnValueOfEval]
[InputOutput::ProhibitExplicitStdin]
[InputOutput::ProhibitInteractiveTest]
[InputOutput::ProhibitJoinedReadline]
[InputOutput::ProhibitOneArgSelect]
[InputOutput::ProhibitReadlineInForLoop]
[InputOutput::ProhibitTwoArgOpen]
[InputOutput::RequireBracedFileHandleWithPrint]
[InputOutput::RequireBriefOpen]
[InputOutput::RequireCheckedOpen]
[InputOutput::RequireCheckedSyscalls]
exclude_functions = print
[InputOutput::RequireEncodingWithUTF8Layer]
[Miscellanea::ProhibitFormats]
[Miscellanea::ProhibitTies]
[Miscellanea::ProhibitUnrestrictedNoCritic]
[Miscellanea::ProhibitUselessNoCritic]
[Modules::ProhibitAutomaticExportation]
[Modules::ProhibitConditionalUseStatements]
[Modules::RequireBarewordIncludes]
[Modules::RequireFilenameMatchesPackage]
[Modules::RequireNoMatchVarsWithUseEnglish]
[NamingConventions::Capitalization]
[RegularExpressions::ProhibitCaptureWithoutTest]
[RegularExpressions::ProhibitComplexRegexes]
[RegularExpressions::ProhibitEnumeratedClasses]
[RegularExpressions::ProhibitFixedStringMatches]
[RegularExpressions::ProhibitSingleCharAlternation]
[RegularExpressions::ProhibitUnusedCapture]
[RegularExpressions::RequireBracesForMultiline]
[RegularExpressions::RequireDotMatchAnything]
[RegularExpressions::RequireExtendedFormatting]
[Subroutines::ProhibitAmpersandSigils]
[Subroutines::ProhibitBuiltinHomonyms]
[Subroutines::ProhibitManyArgs]
[Subroutines::ProhibitNestedSubs]
[Subroutines::ProhibitReturnSort]
[Subroutines::ProhibitSubroutinePrototypes]
[Subroutines::ProtectPrivateSubs]
[Subroutines::RequireArgUnpacking]
[Subroutines::RequireFinalReturn]
[TestingAndDebugging::ProhibitProlongedStrictureOverride]
[TestingAndDebugging::RequireTestLabels]
[ValuesAndExpressions::ProhibitCommaSeparatedStatements]
[ValuesAndExpressions::ProhibitComplexVersion]
[ValuesAndExpressions::ProhibitEscapedCharacters]
[ValuesAndExpressions::ProhibitLongChainsOfMethodCalls]
[ValuesAndExpressions::ProhibitMismatchedOperators]
[ValuesAndExpressions::ProhibitMixedBooleanOperators]
[ValuesAndExpressions::ProhibitQuotesAsQuotelikeOperatorDelimiters]
[ValuesAndExpressions::ProhibitSpecialLiteralHeredocTerminator]
[ValuesAndExpressions::ProhibitVersionStrings]
[ValuesAndExpressions::RequireConstantVersion]
[ValuesAndExpressions::RequireQuotedHeredocTerminator]
[ValuesAndExpressions::RequireUpperCaseHeredocTerminator]
[Variables::ProhibitAugmentedAssignmentInDeclaration]
[Variables::ProhibitConditionalDeclarations]
; Variables::ProhibitEvilVariables is not listed.  It does not load until it
; gets a list of variables to prohibit.
[Variables::ProhibitLocalVars]
[Variables::ProhibitMatchVars]
[Variables::ProhibitReusedNames]
[Variables::ProhibitUnusedVariables]
[Variables::ProtectPrivateVars]
[Variables::RequireLexicalLoopIterators]
[Variables::RequireLocalizedPunctuationVars]
[Variables::RequireNegativeIndices]
# Extensions to perl -c
[CompileTime]
# Good idea, but the module does not install, because its test suite fails.
# To use it, we must fork it.
#[Dynamic::ValidateAgainstSymbolTable]
#at_inc_suffix=lib
#inspect_required_modules=1
#inspect_autoloaders=1
#max_recursion=2
