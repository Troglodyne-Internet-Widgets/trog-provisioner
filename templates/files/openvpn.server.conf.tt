port [% port %]
proto [% proto %]
dev tun

ca   /etc/openvpn/server/ca.crt
cert /etc/openvpn/server/server.crt
key  /etc/openvpn/server/server.key
dh   /etc/openvpn/server/dh.pem

tls-auth /etc/openvpn/server/ta.key 0
tls-version-min 1.2

cipher [% cipher %]
auth SHA256

server [% subnet %] [% netmask %]
ifconfig-pool-persist /var/log/openvpn/ipp.txt

[%# Set explicitly, because without it OpenVPN uses net30.  net30 uses a /30
    for each client, and upstream deprecates it. -%]
topology subnet

[% IF dns.size() -%]
[% FOR d IN dns -%]
push "dhcp-option DNS [% d %]"
[% END -%]
[% END -%]
[%# Off unless the domain asks for it.  The client gets this at connect time,
    so a change reaches every deployed client.  Provisioner::Recipe::openvpn has
    the whole account. -%]
[% IF redirect_gateway -%]
# Route all client traffic through the VPN gateway.
# bypass-dhcp keeps local DHCP traffic on the real gateway.
push "redirect-gateway def1 bypass-dhcp"
[% END -%]

keepalive 10 120
persist-key
persist-tun

status      /var/log/openvpn/openvpn-status.log
log-append  /var/log/openvpn/openvpn.log
verb 3
