# Generated by Provisioner::Recipe::koan.
# The projects of the bot, from the koan block of recipes.yaml.  A provision
# does not install this file over a projects.yaml that is already on the guest.

defaults:
  git_auto_merge:
    enabled: false
    base_branch: "main"
    strategy: "squash"

projects:
[% FOR name IN projects.keys().sort() %]
[% p = projects.$name %]
  [% name %]:
    path: "[% p.path %]"
[% IF p.cli_provider %]
    cli_provider: "[% p.cli_provider %]"
[% END %]
[% IF p.github_url %]
    github_url: "[% p.github_url %]"
[% END %]
[% IF p.base_branch %]
    git_auto_merge:
      base_branch: "[% p.base_branch %]"
[% END %]
[% END %]
