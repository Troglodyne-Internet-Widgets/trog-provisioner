# Refresh the mirror.
#
# This starts the unit and does not run apt-mirror directly.  If a refresh
# starts during a long sync, systemd queues it.  The makefile, this file and an
# operator all start the same unit.
#
# Failures go to the journal, not to cron mail: journalctl -u apt-mirror.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

[% refresh %] root systemctl start --no-block apt-mirror.service
