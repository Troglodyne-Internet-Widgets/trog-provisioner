{
  "enabledPlugins": {
[% FOREACH plugin IN plugins %]
    "[% plugin.name %]@[% plugin.marketplace %]": true[% UNLESS loop.last %],[% END %]
[% END %]
  },
  "extraKnownMarketplaces": {
[% FOREACH plugin IN plugins %]
    "[% plugin.marketplace %]": {
      "source": {
        "source": "github",
        "repo": "[% plugin.repo %]"
      }
    }[% UNLESS loop.last %],[% END %]
[% END %]
  },
  "env": {
[%# A guest is used over ssh, and has no clipboard for the copy of the
    fullscreen interface, so the terminal keeps the mouse to select text. -%]
    "CLAUDE_CODE_DISABLE_MOUSE": "1"[% IF github_user && !restricted %],
    "GH_CONFIG_DIR": "[% gh_config_dir %]",
    "GIT_AUTHOR_NAME": "[% github_user %]",
    "GIT_AUTHOR_EMAIL": "[% git_email %]",
    "GIT_COMMITTER_NAME": "[% github_user %]",
    "GIT_COMMITTER_EMAIL": "[% git_email %]",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_0": "git@github.com:"[% END %][% IF pr_assignee && !restricted %],
    "PERL_SLOP_ASSIGNEE": "[% pr_assignee %]"[% END %]
  },
  "tui": "fullscreen",
  "theme": "dark"
}
