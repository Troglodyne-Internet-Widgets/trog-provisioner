{
  "enabledPlugins": {
[% IF modules.grep('perllsp').size() %]
    "perlnavigator@claude-code-perlnavigator": true,
[% END -%]
[% IF modules.grep('^perl$').size() %]
    "perl-development@perigrin-marketplace": true,
[% END %]
    "perl-slop@troglodyne-marketplace": true,
    "simple-english@simple-english": true
  },
  "extraKnownMarketplaces": {
[% IF modules.grep('perllsp').size() %]
    "claude-code-perlnavigator": {
      "source": {
        "source": "github",
        "repo": "yuji-hatakeyama/claude-code-perlnavigator"
      }
    },
[% END -%]
[% IF modules.grep('^perl$').size() %]
    "perigrin-marketplace": {
      "source": {
        "source": "github",
        "repo": "perigrin/claude-plugins-marketplace"
      }
    },
[% END %]
    "troglodyne-marketplace": {
      "source": {
        "source": "github",
        "repo": "Troglodyne-Internet-Widgets/claude-plugins-marketplace"
      }
    },
    "simple-english": {
      "source": {
        "source": "github",
        "repo": "AminBlg/SimpleEnglish"
      }
    }
  },
[% IF github_user || pr_assignee %]
  "env": {
[% IF github_user %]
    "GH_CONFIG_DIR": "[% gh_config_dir %]",
    "GIT_AUTHOR_NAME": "[% github_user %]",
    "GIT_AUTHOR_EMAIL": "[% git_email %]",
    "GIT_COMMITTER_NAME": "[% github_user %]",
    "GIT_COMMITTER_EMAIL": "[% git_email %]",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_0": "git@github.com:"[% IF pr_assignee %],[% END %]
[% END %]
[% IF pr_assignee %]
    "PERL_SLOP_ASSIGNEE": "[% pr_assignee %]"
[% END %]
  },
[% END %]
  "tui": "fullscreen",
  "theme": "dark"
}
