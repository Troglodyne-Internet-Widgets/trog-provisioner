{
  "enabledPlugins": {
[% FOREACH plugin IN plugins %]
    "[% plugin.name %]@[% plugin.marketplace %]": true[% UNLESS loop.last %],[% END %]
[% END %]
  },
  "extraKnownMarketplaces": {
[% FOREACH plugin IN plugins %]
    "[% plugin.marketplace %]": {
      "source": {
        "source": "github",
        "repo": "[% plugin.repo %]"
      }
    }[% UNLESS loop.last %],[% END %]
[% END %]
  },
  "env": {
[%# A guest is used over ssh, and has no clipboard for a copy that Claude
    Code makes, so the terminal keeps the mouse to select text. -%]
[%# mark_raw on git_email, because Xslate escapes for HTML, and an address can
    hold an &, which would reach this file as &amp;.  The pattern of git_email
    refuses a quote, a backslash, white space and a control character, so the
    address cannot end the JSON string or break it. -%]
    "CLAUDE_CODE_DISABLE_MOUSE": "1"[% IF github_user && !restricted %],
    "GH_CONFIG_DIR": "[% gh_config_dir %]",
    "GIT_AUTHOR_NAME": "[% github_user %]",
    "GIT_AUTHOR_EMAIL": "[% git_email | mark_raw %]",
    "GIT_COMMITTER_NAME": "[% github_user %]",
    "GIT_COMMITTER_EMAIL": "[% git_email | mark_raw %]",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_0": "git@github.com:"[% END %][% IF pr_assignee && !restricted %],
    "PERL_SLOP_ASSIGNEE": "[% pr_assignee %]"[% END %]
  },
[% UNLESS restricted -%]
[%# The state of each session goes into its tmux window.  See TMUX in
    Provisioner::Recipe::claude for which event sends which state.  rtk init
    adds its own PreToolUse entry after this one. -%]
[% tmux_hooks = [
    [ 'SessionStart',      '',                'idle' ],
    [ 'UserPromptSubmit',  '',                'working' ],
    [ 'PermissionRequest', '',                'blocked' ],
    [ 'PreToolUse',        'AskUserQuestion', 'blocked' ],
    [ 'PostToolUse',       '*',               'resume' ],
    [ 'Stop',              '',                'done' ],
    [ 'SessionEnd',        '',                'clear' ],
] -%]
  "hooks": {
[% FOREACH hook IN tmux_hooks %]
    "[% hook.0 %]": [
      {[% IF hook.1 %]
        "matcher": "[% hook.1 %]",[% END %]
        "hooks": [ { "type": "command", "command": "/usr/local/bin/claude-tmux-state [% hook.2 %]" } ]
      }
    ][% UNLESS loop.last %],[% END %]
[% END %]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/local/bin/claude-statusline",
    "refreshInterval": 30
  },
[% END -%]
  "tui": "[% tui %]",
  "theme": "dark"
}
