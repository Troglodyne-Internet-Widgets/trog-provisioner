#!/bin/sh
# Generated by Provisioner::Recipe::grafana.  remote_prepare runs this before a
# salvage.  A copy of the files of a running influxd can take a shard halfway
# through a compaction, and a backup through influxd cannot.
#
# The backup goes to a new directory first, so a backup that fails halfway
# leaves the last good one where the fetch reads it.
set -e
out='[% install_dir %]/[% domain %]/.grafana-salvage'
install -d -o root -g root -m 0700 "$out"
rm -rf "$out/influxdb.new"
influxd backup -portable -host 127.0.0.1:8088 -db '[% influx_database %]' "$out/influxdb.new"
rm -rf "$out/influxdb"
mv "$out/influxdb.new" "$out/influxdb"
