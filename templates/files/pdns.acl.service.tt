[Unit]
Description=Per-token access to the PowerDNS API
After=network-online.target pdns.service
Wants=network-online.target

[Service]
Type=simple
User=pdns
Group=pdns
EnvironmentFile=/etc/pdns-acl/env
[%# The directory and the socket are for nginx to reach, so they are open to
    every user.  Every request still needs a token. -%]
RuntimeDirectory=pdns-acl
RuntimeDirectoryMode=0755
UMask=0000
ExecStart=/opt/perl5/current/bin/starman --listen /run/pdns-acl/proxy.sock --workers 2 /etc/pdns-acl/app.psgi
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
