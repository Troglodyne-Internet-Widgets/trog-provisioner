# AppArmor overrides for slapd, included by /etc/apparmor.d/usr.sbin.slapd.
#
# slapd reads /etc/ssl/certs/<domain>.pem and /etc/ssl/private/<domain>.pem.
# The profile allows both through abstractions/ssl_certs and ssl_keys.  But
# both are symlinks, and AppArmor checks the real path, for example
# /etc/letsencrypt/live/<domain>/privkey.pem.  The profile does not name it.
#
# slapd reports the denial only as "Other (e.g., implementation specific) error
# (80)", with no reason.  A read test as the openldap user succeeds, because
# AppArmor confines the slapd executable, not the user.  Only the audit log,
# which auditd owns on these guests, records the denial.
/etc/letsencrypt/live/** r,
/etc/letsencrypt/archive/** r,

# The fetcher points the symlinks here when dehydrated has a real certificate.
/var/lib/dehydrated/certs/** r,
