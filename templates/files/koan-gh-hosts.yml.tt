# Generated by Provisioner::Recipe::koan.  This file gives gh its login
# state, so `gh repo clone` and `gh api` work without `gh auth login`, which
# is interactive.  The token is the same as GH_TOKEN in the rendered .env.
github.com:
    git_protocol: [% github_ssh_identity ? 'ssh' : 'https' %]
    user: [% github_user %]
    oauth_token: [% github_token %]
