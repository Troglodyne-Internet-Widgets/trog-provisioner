[%# The fleet of hypervisors on which the runner builds guests.

    Always rendered and installed.  A runner that names no hypervisor is its own,
    and gets one block for the libvirt of this guest, with the resolvers of this
    guest, which its guests reach through its NAT, and no pool.  A block must
    name the resolvers of its guests, see configured_resolvers in Trog::HV, and
    names their pool and gateway, see guest_pool there.

    pool_name with pool_path, and partition, are the only two limits on a
    guest.  See QUOTAS in Provisioner::Recipe::trogrunner. -%]
[% FOR name IN hypervisors.keys().sort() -%]
[% SET hv = hypervisors.$name -%]
[[% name %]]
libvirt_uri    = [% hv.libvirt_uri %]
resolvers      = [% hv.resolvers.join(', ') %]
[% IF hv.gateway %]gateway        = [% hv.gateway %]
[% END -%]
[% IF hv.pool_cidr.size() %]pool_cidr      = [% hv.pool_cidr.join(', ') %]
[% END -%]
[% IF hv.pool_addresses.size() %]pool_addresses = [% hv.pool_addresses.join(', ') %]
[% END -%]
[% IF hv.pool_path %]pool_path      = [% hv.pool_path %]
[% END -%]
[% IF hv.pool_name %]pool_name      = [% hv.pool_name %]
[% END -%]
[% IF hv.partition %]partition      = [% hv.partition %]
[% END -%]
[% IF hv.domain_dir %]domain_dir     = [% hv.domain_dir %]
[% END -%]
[% IF hv.bridge_device %]bridge_device  = [% hv.bridge_device %]
[% END -%]
[% IF hv.virbr_device %]virbr_device   = [% hv.virbr_device %]
[% END -%]
[% IF hv.reserve_memory %]reserve_memory = [% hv.reserve_memory %]
[% END -%]
[% IF hv.reserve_cpus %]reserve_cpus   = [% hv.reserve_cpus %]
[% END -%]
[% IF hv.reserve_disk %]reserve_disk   = [% hv.reserve_disk %]
[% END -%]
[% IF hv.cpu_overcommit %]cpu_overcommit = [% hv.cpu_overcommit %]
[% END -%]
[% IF hv.max_guests %]max_guests     = [% hv.max_guests %]
[% END -%]
[% IF hv.max_memory %]max_memory     = [% hv.max_memory %]
[% END -%]

[% END -%]
[% IF !hypervisors.keys().size() -%]
[local]
libvirt_uri    = qemu:///system
resolvers      = [% resolvers.join(', ') %]
[% END -%]
