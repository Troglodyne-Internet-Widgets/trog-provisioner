#!/bin/bash

[% IF dns_preference == 'pdns' -%]
# Wait for the server that answers the challenge before asking for one.
#
# A backstop, not the fix: pdns starts in its own target and nostubresolver
# restarts the resolver in its own, so this should fall through on the first
# pass.  It used to be neither -- the restarts were queued in the postrun behind
# this task, and post_install runs its queue one task at a time, so waiting here
# could only ever time out.
#
# Three checks, and the third is the one this used to be missing.  The socket
# and the @127.0.0.1 SOA say the server is up and holds the zone.  The bare SOA
# says the *system* resolver can see it -- which is the resolver lexicon walks
# the zone with for --resolve-zone-name, and the one step-ca validates dns-01
# through.  Measured on a guest: the first two passed while systemd's stub knew
# nothing of a reserved TLD, so the walk fell all the way to the root, lexicon
# asked pdns for zones/. and got a 404, and every challenge failed.
for _ in $(seq 1 60); do
    [ -S /var/spool/powerdns/api.sock ] \
      && dig +short @127.0.0.1 [% domain %] SOA 2>/dev/null | grep -q . \
      && dig +short [% domain %] SOA 2>/dev/null | grep -q . \
      && break
    sleep 2
done
[% END -%]
# Register with the CA this domain is configured for, if this guest has not
# already.  The global fragment registers as well, but it runs before any
# recipe's target -- so on a guest whose CA is one of its own recipes, that
# happened while there was nothing listening yet.  dehydrated will not run
# --cron for an account it never made, and registering twice is a no-op.
dehydrated --config /etc/dehydrated/domains.d/[% domain %].conf --register --accept-terms; /bin/true

#XXX it is VERY VERY BAD that the DOMAINS_D field does NOTHING WHATSOEVER!
dehydrated --config /etc/dehydrated/domains.d/[% domain %].conf --cron
fetched=$?

# Only touch the symlinks if dehydrated actually produced something to point
# them at.
#
# This used to rm the existing pair and relink unconditionally.  When dehydrated
# fails -- no route to ACME, a rate limit, DNS that is not ready, or a domain
# that was never going to validate -- that deleted the working self-signed cert
# the ssl target made and left two dangling symlinks, and nginx will not start
# without a certificate it can read.  A cert we could not renew is still better
# than no cert at all.
live=/var/lib/dehydrated/certs/[% domain %]
if [ -s "$live/fullchain.pem" ] && [ -s "$live/privkey.pem" ]; then
    echo "Fixing Symlinks to certs for [% domain %]..."
    ln -sf "$live/fullchain.pem" /etc/ssl/certs/[% domain %].pem
    ln -sf "$live/privkey.pem"   /etc/ssl/private/[% domain %].pem
else
    echo "dehydrated left no certificate for [% domain %]; keeping the one already in place." >&2
fi

# Fix ownership and put the private material back where it belongs.
#
# The fetch reads the guest as root now (issue #76), so nothing here needs to be
# readable by the admin account any more: issue #98 took that back out. A guest
# rebuilt with certificates it has no keys for still re-issues from scratch,
# spending rate limit and, if the account key went too, the registration -- that
# risk is why this runs at all, not who could read the result.
#
# Certificates are public and stay world readable. The private keys and the
# account key are back to 0600 root: readable by root, and by nobody else. The
# keys were 0770 here once, which handed the group write on them for no reason
# anybody needed.
echo "Fixing cert/account ownership...";
sudo chown -R root:root /etc/dehydrated/certs /etc/dehydrated/accounts /var/lib/dehydrated/certs
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type d -exec chmod 0755 {} +
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type f -exec chmod 0644 {} +
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type f -name 'priv*' -exec chmod 0600 {} +
sudo find /etc/dehydrated/accounts -type d -exec chmod 0700 {} +
sudo find /etc/dehydrated/accounts -type f -exec chmod 0600 {} +

echo "Done."
exit "$fetched"
