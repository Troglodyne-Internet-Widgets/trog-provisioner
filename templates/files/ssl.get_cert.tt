#!/bin/bash

[% IF dns_preference == 'pdns' -%]
# Wait for the server that answers the challenge before asking for one.
#
# This is a backstop.  pdns starts in its own target, and nostubresolver
# restarts the resolver in its own target.  So the loop usually ends on the
# first pass.
#
# The socket and the SOA from @127.0.0.1 say that the server is up and holds
# the zone.  The bare SOA says that the system resolver can see the zone.
# lexicon walks the zone with that resolver for --resolve-zone-name, and
# step-ca validates dns-01 through it.  If that resolver cannot see the zone,
# lexicon asks pdns for zones/. and every challenge fails.
for _ in $(seq 1 60); do
    [ -S [% lexicon_socket %] ] \
      && dig +short @127.0.0.1 [% domain %] SOA 2>/dev/null | grep -q . \
      && dig +short [% domain %] SOA 2>/dev/null | grep -q . \
      && break
    sleep 2
done
[% END -%]
# Register with the CA of this domain.  The global fragment registers too, but
# it runs before the target of each recipe.  If the CA is a recipe on this
# guest, nothing listens at that time.  dehydrated does not run --cron without
# an account, and a second registration does nothing.
dehydrated --config /etc/dehydrated/domains.d/[% domain %].conf --register --accept-terms; /bin/true

#XXX The DOMAINS_D field in the configuration has no effect.
dehydrated --config /etc/dehydrated/domains.d/[% domain %].conf --cron
fetched=$?

# Change the symlinks only if dehydrated made a certificate.  If dehydrated
# fails, keep the certificate that is in place, because nginx does not start
# without a certificate that it can read.
live=/var/lib/dehydrated/certs/[% domain %]
if [ -s "$live/fullchain.pem" ] && [ -s "$live/privkey.pem" ]; then
    echo "Fixing Symlinks to certs for [% domain %]..."
    ln -sf "$live/fullchain.pem" /etc/ssl/certs/[% domain %].pem
    ln -sf "$live/privkey.pem"   /etc/ssl/private/[% domain %].pem
else
    echo "dehydrated left no certificate for [% domain %]; keeping the one already in place." >&2
fi

# Set the ownership and the modes of the certificates and the account.
# Certificates are public and stay world readable.  The private keys and the
# account key are 0600 root.  Provisioner::Recipe::letsencrypt says why.
echo "Fixing cert/account ownership...";
sudo chown -R root:root /etc/dehydrated/certs /etc/dehydrated/accounts /var/lib/dehydrated/certs
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type d -exec chmod 0755 {} +
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type f -exec chmod 0644 {} +
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type f -name 'priv*' -exec chmod 0600 {} +
sudo find /etc/dehydrated/accounts -type d -exec chmod 0700 {} +
sudo find /etc/dehydrated/accounts -type f -exec chmod 0600 {} +

echo "Done."
exit "$fetched"
