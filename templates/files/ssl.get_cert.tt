#!/bin/bash

[% IF prefer_local_dns -%]
# Wait for the server that answers the challenge before asking for one.
#
# The postrun queue is in fragment order, and this recipe's fragment runs before
# pdns's -- so the restarts that put the API socket and the zone in place are
# queued after this task.  Measured on a guest: lexicon found no socket, so the
# af-unix patch left the endpoint unmangled and requests refused it outright,
# and --resolve-zone-name resolved to nothing, so the zone came out empty and
# pdns answered 404 for zones/.
for _ in $(seq 1 60); do
    [ -S /var/spool/powerdns/api.sock ] && dig +short @127.0.0.1 [% domain %] SOA 2>/dev/null | grep -q . && break
    sleep 2
done
[% END -%]
# Register with the CA this domain is configured for, if this guest has not
# already.  The global fragment registers as well, but it runs before any
# recipe's target -- so on a guest whose CA is one of its own recipes, that
# happened while there was nothing listening yet.  dehydrated will not run
# --cron for an account it never made, and registering twice is a no-op.
dehydrated --config /etc/dehydrated/domains.d/[% domain %].conf --register --accept-terms; /bin/true

#XXX it is VERY VERY BAD that the DOMAINS_D field does NOTHING WHATSOEVER!
dehydrated --config /etc/dehydrated/domains.d/[% domain %].conf --cron
fetched=$?

# Only touch the symlinks if dehydrated actually produced something to point
# them at.
#
# This used to rm the existing pair and relink unconditionally.  When dehydrated
# fails -- no route to ACME, a rate limit, DNS that is not ready, or a domain
# that was never going to validate -- that deleted the working self-signed cert
# the ssl target made and left two dangling symlinks, and nginx will not start
# without a certificate it can read.  A cert we could not renew is still better
# than no cert at all.
live=/var/lib/dehydrated/certs/[% domain %]
if [ -s "$live/fullchain.pem" ] && [ -s "$live/privkey.pem" ]; then
    echo "Fixing Symlinks to certs for [% domain %]..."
    ln -sf "$live/fullchain.pem" /etc/ssl/certs/[% domain %].pem
    ln -sf "$live/privkey.pem"   /etc/ssl/private/[% domain %].pem
else
    echo "dehydrated left no certificate for [% domain %]; keeping the one already in place." >&2
fi

# Fix ownership so that the admin can schlep certs
#
# The salvage is an sftp session as [% admin_user %] with no sudo, so anything
# it cannot read comes back empty and silent -- and a guest rebuilt with
# certificates it has no keys for re-issues from scratch, spending rate limit
# and, if the account key went too, the registration.
#
# Certificates are public and stay world readable.  The private keys and the
# account key are 0640 root:[% admin_user %]: readable by the account that
# fetches them, by root, and by nobody else.  The keys were 0770 here, which
# also handed the group write on them for no reason anybody needs.
echo "Fixing cert/account ownership...";
sudo chown -R root:[% admin_user %] /etc/dehydrated/certs /etc/dehydrated/accounts /var/lib/dehydrated/certs
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type d -exec chmod 0755 {} +
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type f -exec chmod 0644 {} +
sudo find /etc/dehydrated/certs /var/lib/dehydrated/certs -type f -name 'priv*' -exec chmod 0640 {} +
sudo find /etc/dehydrated/accounts -type d -exec chmod 0750 {} +
sudo find /etc/dehydrated/accounts -type f -exec chmod 0640 {} +

echo "Done."
exit "$fetched"
