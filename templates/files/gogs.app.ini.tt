RUN_USER = [% gogs_admin %]
RUN_MODE = prod

[database]
; TYPE, not DB_TYPE.  gogs renamed this key, and an unrecognised one is simply
; ignored -- so it fell through to its own defaults, which are postgres, and
; every start died on
;   failed to connect to `host=127.0.0.1 user=gogs database=gogs`
; while the configuration plainly said sqlite3.
TYPE = sqlite3
PATH    = [% install_dir %]/git.[% domain %]/data/gogs.db

[repository]
ROOT = [% install_dir %]/git.[% domain %]/repos

[server]
DOMAIN       = git.[% domain %]
HTTP_PORT    = 3000
HTTP_ADDR    = 127.0.0.1
ROOT_URL     = https://git.[% domain %]/
OFFLINE_MODE = true

[mailer]
ENABLED = false

[service]
REGISTER_EMAIL_CONFIRM = false
ENABLE_NOTIFY_MAIL     = false
DISABLE_REGISTRATION   = false
ENABLE_CAPTCHA         = false
REQUIRE_SIGNIN_VIEW    = false

[session]
PROVIDER_CONFIG = [% install_dir %]/git.[% domain %]/data/sessions

[log]
ROOT_PATH = [% install_dir %]/git.[% domain %]/log
; console as well as file, so that systemd gets it.  On file alone a gogs that
; refuses to start says so only inside its own log directory: the journal shows
; "Main process exited, code=exited, status=1/FAILURE" and nothing else, which
; is not enough to act on.
MODE      = console, file
LEVEL     = Info

[security]
INSTALL_LOCK = true
SECRET_KEY   = [% secret_key %]
