RUN_USER = [% gogs_admin %]
RUN_MODE = prod

[database]
; TYPE, not DB_TYPE.  gogs ignores DB_TYPE and falls back to its default,
; postgres.  Then every start fails with
;   failed to connect to `host=127.0.0.1 user=gogs database=gogs`
TYPE = sqlite3
PATH    = [% install_dir %]/git.[% domain %]/data/gogs.db

[repository]
ROOT = [% install_dir %]/git.[% domain %]/repos

[server]
; The domain itself, not git.<domain>.  The nginxproxy vhost for this domain
; answers on the domain and its aliases, and not on git.<domain>.  Every clone
; URL, login redirect and webhook that gogs makes names this host.
DOMAIN       = [% domain %]
HTTP_PORT    = 3000
HTTP_ADDR    = 127.0.0.1
ROOT_URL     = https://[% domain %]/
OFFLINE_MODE = true

[mailer]
ENABLED = false

[service]
REGISTER_EMAIL_CONFIRM = false
ENABLE_NOTIFY_MAIL     = false
DISABLE_REGISTRATION   = false
ENABLE_CAPTCHA         = false
REQUIRE_SIGNIN_VIEW    = false

[session]
PROVIDER_CONFIG = [% install_dir %]/git.[% domain %]/data/sessions

[log]
ROOT_PATH = [% install_dir %]/git.[% domain %]/log
; console as well as file, so that the journal shows why gogs does not start.
; With file alone, the reason is only in the log directory, and the journal
; shows only "Main process exited, code=exited, status=1/FAILURE".
MODE      = console, file
LEVEL     = Info

[security]
INSTALL_LOCK = true
; Empty unless recipes.yaml sets one.  The fragment fills in the key that the
; guest already has.  A new key on each provision makes every session invalid
; and every 2FA enrolment unreadable.
SECRET_KEY   = [% secret_key %]
