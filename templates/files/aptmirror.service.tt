[Unit]
Description=Mirror [% upstream %]
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=apt-mirror
Group=apt-mirror
ExecStart=/usr/bin/apt-mirror
# Without this, systemd stops the sync at DefaultTimeoutStartSec, which is
# ninety seconds.  nginx then serves the half-written spool as a mirror.  apt
# gets a 404 for each missing package and uses the archive, so the fault stays
# hidden.
TimeoutStartSec=0
# A sync uses hours of disk and network, and nothing waits for it.
Nice=10
IOSchedulingClass=idle
