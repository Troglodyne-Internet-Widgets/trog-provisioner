#!/bin/bash
# Load the salvaged directory into a guest that was just built.
#
# ldap-export.sh wrote the LDIF on the old guest, and bin/new_config fetched it.
# The data target put it in /var/backups/ldap on this guest.  This script loads
# it into slapd before the seed runs.
#
# Only the data is loaded, not the configuration database.  An old cn=config
# can stop the new slapd from starting.  Provisioner::Recipe::ldap, under
# SURVIVING A REBUILD, has the full account.

set -euo pipefail

BASE_DN='[% base_dn %]'
SALVAGED=/var/backups/ldap/data.ldif

# A record of what this guest was built from.  It is outside /var/backups/ldap,
# so the next export does not overwrite it and the next fetch does not take it.
LOADED=/var/backups/ldap-reloaded.ldif

if [ ! -s "$SALVAGED" ]; then
    echo "ldap-reload: nothing salvaged at $SALVAGED, the seed is the directory"
    exit 0
fi

# Do not load over a live directory.  On a guest that already runs, the salvage
# is a fetch from minutes ago, and it can be partial.  If the database has any
# entry that the package did not make, the guest keeps its own directory.
#
# The package makes only the suffix and the admin entry below it, from the
# debconf answers.  The seed has not run yet at this point.
UNEXPECTED=$(slapcat -F /etc/ldap/slapd.d -b "$BASE_DN" 2>/dev/null |
    grep '^dn:' |
    grep -vxF "dn: $BASE_DN" |
    grep -vxF "dn: cn=admin,$BASE_DN" || true)

if [ -n "$UNEXPECTED" ]; then
    echo "ldap-reload: $BASE_DN already has entries of its own, keeping them; $SALVAGED left where it is"
    exit 0
fi

systemctl stop slapd

# Move the packaged database aside, do not delete it.  slapadd can fail on one
# bad entry, and then this puts the packaged database back.
STASH=/var/lib/ldap.packaged
rm -rf "$STASH"
mv /var/lib/ldap "$STASH"
install -d -o openldap -g openldap -m 0700 /var/lib/ldap

if ! slapadd -q -F /etc/ldap/slapd.d -b "$BASE_DN" -l "$SALVAGED"; then
    rm -rf /var/lib/ldap
    mv "$STASH" /var/lib/ldap
    systemctl start slapd
    echo "ldap-reload: slapadd refused $SALVAGED; the packaged database is back and the directory was not restored" >&2
    exit 1
fi

# slapadd wrote those files as root, and slapd does not run as root.
chown -R openldap:openldap /var/lib/ldap
rm -rf "$STASH"

install -o root -g root -m 0600 "$SALVAGED" "$LOADED"

systemctl start slapd
echo "ldap-reload: loaded $SALVAGED into $BASE_DN"
