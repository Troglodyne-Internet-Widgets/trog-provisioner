[%# Where telegraf sends what it collects.  The packaged telegraf.conf has no
    active output, because each [[outputs.*]] in it is a comment.  Without this
    fragment, telegraf collects the host metrics that its sample turns on and
    discards all of them.

    A fragment in telegraf.d, not an edit of telegraf.conf, because the package
    owns and replaces telegraf.conf. -%]
[[outputs.influxdb]]
  urls = ["http://127.0.0.1:8086"]
  database = "[% influx_database %]"
[%# grafana_influx_setup.sh creates the database with a retention.  A database
    that telegraf creates never expires anything. -%]
  skip_database_creation = true
