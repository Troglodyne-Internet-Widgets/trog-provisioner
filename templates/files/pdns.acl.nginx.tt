server {
    listen 443 ssl;
[% IF api_ipv6 %]    listen [::]:443 ssl;
[% END -%]
    server_name dnsapi.[% domain %];
[%# The listener for a proxy, when a public name names this vhost.  See
    Provisioner::Recipe::nginx. -%]
    include /etc/nginx/proxied/dnsapi.[% domain %].443.conf*;
    server_tokens off;

    ssl_certificate     /etc/ssl/certs/[% domain %].pem;
    ssl_certificate_key /etc/ssl/private/[% domain %].pem;

[%# The guests of this installation, this machine and the guest itself.
    Each request still needs a token: see Provisioner::Recipe::pdns. -%]
[% FOR address IN api_allowed -%]
    allow [% address %];
[% END -%]
    deny all;

    location /api/ {
        proxy_pass http://unix:/run/pdns-acl/proxy.sock:;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

[%# The CA of this guest, for the guests that name it as their authority.
    See Provisioner::Recipe::acmeca.  Its listener names localhost, which
    nginx does not check. -%]
[% IF acme_port -%]
    location /acme/ {
        proxy_pass https://127.0.0.1:[% acme_port %];
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

[% END -%]
    location / {
        return 404;
    }
}

server {
    listen 80;
[% IF api_ipv6 %]    listen [::]:80;
[% END -%]
    server_name dnsapi.[% domain %];
    include /etc/nginx/proxied/dnsapi.[% domain %].80.conf*;
    return 301 https://$host$request_uri;
}
