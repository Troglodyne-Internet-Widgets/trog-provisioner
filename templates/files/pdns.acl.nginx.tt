server {
    listen 443 ssl;
[% IF api_ipv6 %]    listen [::]:443 ssl;
[% END -%]
    server_name dnsapi.[% domain %];
    server_tokens off;

    ssl_certificate     /etc/ssl/certs/[% domain %].pem;
    ssl_certificate_key /etc/ssl/private/[% domain %].pem;

[%# The guests of this installation, this machine and the guest itself.
    Each request still needs a token: see Provisioner::Recipe::pdns. -%]
[% FOR address IN api_allowed -%]
    allow [% address %];
[% END -%]
    deny all;

    location /api/ {
        proxy_pass http://unix:/run/pdns-acl/proxy.sock:;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
[% IF api_ipv6 %]    listen [::]:80;
[% END -%]
    server_name dnsapi.[% domain %];
    return 301 https://$host$request_uri;
}
