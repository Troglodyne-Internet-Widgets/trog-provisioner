[%# A message given to one milter as a client would give it, through
    milterprobe, and what the milter did with it.  Included by the guest tests
    of mail and mailrelay. -%]
# milter_probe(socket => ..., ip => ..., from => ..., ar => ...) gives the
# milter at socket a message from the client at ip, with sender and From from,
# and an Authentication-Results of ar if there is one.  Answers what milterprobe
# printed: each change that the milter asked for, one to a line, then its
# verdict.  Dies when milterprobe gets no verdict, so that a test which asserts
# a line is absent cannot pass on no output.  files/milter_client.tt installed
# milterprobe.
sub milter_probe {
    my (%probe) = @_;
    my @args = (
        '--socket',      "unix:$probe{socket}",
        '--client-ip',   $probe{ip},
        '--client-host', 'client.test.test',
        '--macro',       'connect:j=probe.test.test',
        '--from',        $probe{from},
        '--rcpt',        $probe{from},
        ( defined $probe{ar} ? ( '--header', "Authentication-Results: $probe{ar}" ) : () ),
        '--header',      "From: $probe{from}",
        '--body',        "A probe.\n",
    );
    open( my $out, '-|', '/usr/bin/perl', '/usr/local/bin/milterprobe', @args ) or die "Cannot run milterprobe: $!\n";
    my $said = do { local $/; <$out> } // q{};
    close $out or die 'milterprobe exited ' . ( $? >> 8 ) . " for $probe{socket}, after: $said\n";
    return $said;
}
