server {
    listen 443 ssl[% IF backlog %] backlog=[% backlog %][% END %];
[% IF ipv6 %]    listen [::]:443 ssl[% IF backlog %] backlog=[% backlog %][% END %];
[% END -%]

    server_name www.[% domain %];
    include /etc/nginx/names/[% domain %].conf;
[%# The listener for a proxy.  See Provisioner::Recipe::nginx. -%]
    include /etc/nginx/proxied/[% domain %].443.conf;

    ssl_certificate     /etc/ssl/certs/[% domain %].pem;
    ssl_certificate_key /etc/ssl/private/[% domain %].pem;

    root [% install_dir %]/[% domain %];

    location / {
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
    }
}

server {
    listen 80[% IF backlog %] backlog=[% backlog %][% END %];
[% IF ipv6 %]    listen [::]:80[% IF backlog %] backlog=[% backlog %][% END %];
[% END -%]

    server_name www.[% domain %];
    include /etc/nginx/names/[% domain %].conf;
    include /etc/nginx/proxied/[% domain %].80.conf;

    root [% install_dir %]/[% domain %];

    location / {
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
    }
}
