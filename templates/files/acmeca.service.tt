[Unit]
Description=Internal ACME certificate authority for this guest
After=network-online.target pdns-recursor.service
Wants=network-online.target

[Service]
Type=simple
User=step-ca
Group=step-ca
Environment=STEPPATH=[% steppath %]
[%# No --password-file.  The intermediate key is a plain PEM, like the key of
    the fetch cache authority.  A passphrase next to the key that it unlocks
    protects nothing. -%]
ExecStart=/usr/local/bin/step-ca [% steppath %]/config/ca.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
