[Unit]
Description=Synapse Matrix homeserver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matrix-synapse
Group=matrix-synapse
WorkingDirectory=/etc/matrix-synapse
# The python in the virtualenv of matrix-synapse-py3, not the system one.  The
# package installs synapse into that virtualenv, so /usr/bin/python3 fails with:
#   /usr/bin/python3: Error while finding module specification for
#   'synapse.app.homeserver' (ModuleNotFoundError: No module named 'synapse')
# With Restart=always, that is an exit 1 every five seconds, and synapse never
# starts.
#
# No ExecStartPre with --generate-keys, unlike the packaged unit.  The signing key
# comes from the secret store, and a key that synapse makes for itself is a new
# identity.  If the key is missing, the fragment stops instead.
ExecStart=/opt/venvs/matrix-synapse/bin/python -m synapse.app.homeserver --config-path /etc/matrix-synapse/homeserver.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target