# > file 2>&1, not &>.  cron runs a job with /bin/sh, which is dash here.
# dash reads &> as a background & and a redirection, so the job runs detached,
# logs nothing and reports success to cron at once.
0 0 * * * root command apt-get update && apt-get upgrade -y && apt-get autoremove -y > /var/log/autoupdate.log 2>&1
