[%# The sshd configuration of every guest.  sshd takes the first value that
    it reads for most options, and it reads the drop-ins in lexical order, so
    this file is 10- to come before the 50- and 60- files of cloud-init and the
    cloud image.  HostKey is the exception: sshd adds up HostKey lines, and with
    one it loads only the keys that the lines name.
    Provisioner::Recipe::sshd has the whole account. -%]
# Generated by Provisioner::Recipe::sshd.

# The key from the secret store, so a rebuild keeps it, and no other.
HostKey /etc/ssh/ssh_host_ed25519_key

# No password logins, so set up users and their keys in recipes.yaml and in
# the users.yaml of the data directory.  root logs in with a key only.
PermitRootLogin prohibit-password
PasswordAuthentication no
