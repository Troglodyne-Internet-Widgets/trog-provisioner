[%# What fail2ban runs on this guest for each ban and unban of a jail that
    reads the traffic of a relay: relay_ban on the relay, with the key that the
    relay issued to this domain, against the host key that it pinned.
    Provisioner::RelayRecipe has the whole account, under Bans. -%]
[% IF ban_relay -%]
[Definition]
actionban = <relay_ssh> ban <ip> <bantime>
actionunban = <relay_ssh> unban <ip>

[Init]
relay_ssh = ssh -n -i [% ban_relay.key %] -o BatchMode=yes -o IdentitiesOnly=yes -o HostKeyAlgorithms=ssh-ed25519 -o UserKnownHostsFile=[% ban_relay.known_hosts %] -o StrictHostKeyChecking=yes -o ConnectTimeout=10 root@[% ban_relay.address %]
[% END -%]
