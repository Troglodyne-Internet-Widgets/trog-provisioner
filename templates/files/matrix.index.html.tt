<!DOCTYPE html>
[%# The page of the domain and its aliases: a link to Element, which starts at
    the homeserver.  Provisioner::Recipe::matrix, under The names of the guest.
    Xslate escapes each value for HTML. -%]
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>[% server_name %] chat</title>
        <style>
            body { font-family: sans-serif; line-height: 1.5; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; }
        </style>
    </head>
    <body>
        <p><a href="https://element.matrix.[% domain %]/">Open [% server_name %] chat in Element</a></p>
    </body>
</html>
