[%# The section is redis-server, not redis.  ufw skips a profile whose section
    name is also a service name in /etc/services, where redis is 6379/tcp.  It
    says so only as a warning on stderr:

        WARN: Skipping .redis.: also in /etc/services

    The profile is then absent from `ufw app list`.  ufw makes no rule from it,
    and nothing fails.

    This recipe renders the profile, not ufw, because only this recipe knows the
    port.  A recipe gives ufw its rate_limits and nothing else. -%]
[redis-server]
title=Redis
description=Redis in-memory data store, on the port this guest configured
ports=[% port %]/tcp
