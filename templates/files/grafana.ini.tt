[%# grafana.ini overrides the defaults.ini of the package, so only what differs
    goes here.  Everything else keeps the packaged value.
    Provisioner::Recipe::grafana explains the loopback listener. -%]
[paths]
[%# Named, not inherited, because this recipe writes the dashboards and the
    datasource under here.  If the package moves its default, grafana never
    reads them. -%]
provisioning = /etc/grafana/provisioning

[server]
protocol = http
[%# Loopback only.  nginx is in front, and any other address puts an
    unauthenticated grafana on the network before the vhost exists. -%]
http_addr = 127.0.0.1
http_port = [% port %]
domain = [% domain %]
[%# Grafana builds links and redirects from this.  Without it, each one names
    127.0.0.1 and the browser follows it off the site. -%]
root_url = https://[% domain %]/

[security]
admin_user = [% grafana_admin %]
admin_password = [% admin_password %]
[%# nginx terminates TLS, so the session cookie can be marked secure. -%]
cookie_secure = true

[users]
[%# A dashboard host on a public vhost: nobody signs themselves up. -%]
allow_sign_up = false

[analytics]
reporting_enabled = false
check_for_updates = false
