# main.cf for [% domain %], as a fragment.
#
# One domain's half of main.cf.  configd merges every file in
# /etc/postfix/main.cf.d when postfix starts or reloads: 00-original is what the
# guest arrived with, 40-mail is the guest's own mail stack, and this is what
# this domain adds.  The list parameters here -- mydestination,
# virtual_mailbox_domains, masquerade_domains, header_checks -- are joined
# across fragments rather than replaced, which is what lets a second domain be
# provisioned onto this guest without the first one's mail quietly stopping
# being delivered.
#
# These comments stay in this file.  They do not reach the generated main.cf,
# because a comment describes the setting under it and once several fragments
# have merged there may no longer be one.
mydomain = [% domain %]
myhostname = mail.[% domain %]
myorigin = $mydomain
masquerade_domains = [% domain %][% FOREACH alias IN full_aliases.sort() %] [% alias %][% END %]

# Only the domain itself, and nothing added to mydestination.
#
# www. and mail. used to be in both mydestination and virtual_mailbox_domains,
# which postfix's own VIRTUAL_README says never to do: "NEVER list a virtual
# MAILBOX domain name as a mydestination domain!"  A domain in two address
# classes has no defined answer to "who are the valid recipients here", and the
# check_recipient_access table that used to be in smtpd_recipient_restrictions
# existed to paper over it -- at the cost of being one file two domains fought
# over.  With the overlap gone postfix rejects mail to an alias name by itself,
# and mail for a name this guest does not host never reaches the question.
virtual_mailbox_domains = [% domain %]

# This domain's lookup tables.  Each of these parameters is a list postfix
# searches in order and configd joins across fragments, so every domain names
# its own file and none of them overwrite each other -- which is what the shared
# /etc/postfix/virtual/maps used to do every time a second domain was built.
virtual_mailbox_maps = hash:/etc/postfix/domains/[% domain %]/virtual_maps
virtual_alias_maps = hash:/etc/postfix/domains/[% domain %]/virtual_aliases
transport_maps = hash:/etc/postfix/domains/[% domain %]/transport_maps
sender_dependent_relayhost_maps = hash:/etc/postfix/domains/[% domain %]/sdd_relay_maps
smtpd_sender_login_maps = hash:/etc/postfix/domains/[% domain %]/sender_login
header_checks = regexp:/etc/postfix/domains/[% domain %]/header_checks

# Sometimes when you are behind NAT this can trip you up -- not all routers are
# created equal.  Generally you will want to set this on if in a DC.  That's
# because you don't get put on RBLs for sending from multiple IPs.
[% IF bind_mainip %]
smtp_bind_address = [% main_ip %]
[% END %]
# SSL.  Not a list: a second domain provisioned onto this guest replaces these
# rather than adding to them, because postfix has one certificate for the
# smtpd it answers on and cannot have two.
smtpd_tls_cert_file = /etc/ssl/certs/[% domain %].pem
smtpd_tls_key_file = /etc/ssl/private/[% domain %].pem
