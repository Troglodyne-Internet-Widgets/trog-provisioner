# main.cf for [% domain %], as a fragment.
#
# The half of main.cf for one domain.  configd merges every file in
# /etc/postfix/main.cf.d when postfix starts or reloads.  00-original is what
# the guest arrived with, 40-mail is the mail stack of the guest, and this file
# is what this domain adds.  configd joins the list parameters here
# (virtual_mailbox_domains, masquerade_domains and the table parameters) across
# fragments.  So a second domain on this guest does not stop the mail of the
# first.
#
# These comments do not go into the generated main.cf.  After a merge, the
# setting under a comment can be a different one.
mydomain = [% domain %]
myorigin = $mydomain
masquerade_domains = [% domain %][% FOREACH alias IN domain_aliases.sort() %] [% alias %][% END %]

# Only the domain itself, and nothing added to mydestination.  A domain must
# not be in two address classes.  Provisioner::Recipe::mail has the whole
# account.
virtual_mailbox_domains = [% domain %]

# The lookup tables of this domain.  postfix searches each of these lists in
# order, and configd joins them across fragments.  So each domain names its
# own files.
virtual_mailbox_maps = hash:/etc/postfix/domains/[% domain %]/virtual_maps
virtual_alias_maps = hash:/etc/postfix/domains/[% domain %]/virtual_aliases
transport_maps = hash:/etc/postfix/domains/[% domain %]/transport_maps
sender_dependent_relayhost_maps = hash:/etc/postfix/domains/[% domain %]/sdd_relay_maps
smtpd_sender_login_maps = hash:/etc/postfix/domains/[% domain %]/sender_login
header_checks = regexp:/etc/postfix/domains/[% domain %]/header_checks
[% IF edge_relay %]

# The login of this domain on the relay of its edge, which sdd_relay_maps sends
# every sender of this domain to.  Provisioner::Recipe::mail has the whole
# account, under Sending through an edge guest.
smtp_sasl_auth_enable = yes
smtp_sender_dependent_authentication = yes
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
smtp_sasl_password_maps = hash:/etc/postfix/domains/[% domain %]/sasl_passwd
smtp_tls_policy_maps = hash:/etc/postfix/domains/[% domain %]/edge_tls_policy

# The edge relays here the mail that comes in for this domain, after it made
# the checks of the client, which only it can make.  So the guest trusts it as
# it trusts itself.  configd joins mynetworks across fragments.
mynetworks = [% edge_relay.address %]/32
[% END %]

# Behind NAT, this setting can cause problems, because routers differ.  In a
# data center, set it, so that mail from more than one IP does not put you on
# an RBL.
[% IF bind_mainip %]
smtp_bind_address = [% main_ip %]
[% END %]
# SSL.  These are not lists.  A second domain on this guest replaces them,
# because postfix has one certificate for its smtpd.
smtpd_tls_cert_file = /etc/ssl/certs/[% domain %].pem
smtpd_tls_key_file = /etc/ssl/private/[% domain %].pem
