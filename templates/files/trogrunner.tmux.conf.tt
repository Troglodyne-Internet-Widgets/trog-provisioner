# Generated by Provisioner::Recipe::trogrunner.  Do not edit by hand.
# The badge of a build that bin/provision runs in the foreground of a pane.
# Trog::Tmux sets the window option @provision_state, and this file draws it.
# /etc/tmux.conf sources this file, and tmux reads ~/.tmux.conf after it, so a
# setting there wins.

# Flag a window whose pane rings the bell, as a build does when it asks or ends.
setw -g monitor-bell on
set -g bell-action other
set -g visual-bell off
setw -g window-status-bell-style 'fg=black,bg=yellow,bold'

# The badge: a blue gear while building, a white ? on red while it asks, and a
# green check or a red cross when it ended and is not yet seen.  256-colour
# codes, because terminal themes remap the named ANSI colours.  The symbols are
# \u escapes, which tmux reads only in double quotes.
set -g @provision_badge "#{?#{==:#{@provision_state},building},#[fg=colour39] \u2699 #[default],#{?#{==:#{@provision_state},asking},#[fg=colour231#,bg=colour196#,bold] ? #[default],#{?#{==:#{@provision_state},ok},#[fg=colour46] \u2713 #[default],#{?#{==:#{@provision_state},failed},#[fg=colour196#,bold] \u2717 #[default],}}}}"

# The badge of Claude Code too, which claude.conf of Provisioner::Recipe::claude
# sets the same, so that either file draws both.  A badge that nothing defines
# draws nothing.
setw -g window-status-format '#I:#W#{?window_flags,#{window_flags}, }#{E:@claude_badge}#{E:@provision_badge}'
setw -g window-status-current-format '#I:#W#{?window_flags,#{window_flags}, }#{E:@claude_badge}#{E:@provision_badge}'

# Looking at a window whose build ended marks it seen.  Index 1, because a
# hook set without an index replaces every index, and claude.conf sets index 0.
set-hook -g 'session-window-changed[1]' 'if -F "#{||:#{==:#{@provision_state},ok},#{==:#{@provision_state},failed}}" "set -wu @provision_state"'
