[%# Perl, which Mojolicious::Plugin::Config evaluates.  Each value between
    single quotes is held by the schema of Provisioner::Recipe::clod to
    characters that are safe there.  Free text goes through perl_string
    instead.  perldoc App::Clod::Config has every key. -%]
[% home = install_dir _ '/' _ domain -%]
# Generated by Provisioner::Recipe::clod.  Do not edit by hand.
{
    bot              => '[% bot %]',
[% IF bot_email -%]
    bot_email        => '[% bot_email %]',
[% END -%]
    workspace        => '[% home %]/workspace',
    minion           => 'sqlite:[% home %]/clod-state/minion.db',
    spokes           => [ [% FOR s IN spokes %]'[% s %]', [% END %]],
    spoke_orgs       => [ [% FOR o IN spoke_orgs %]'[% o %]', [% END %]],
    tool_spokes      => [ [% FOR s IN tool_spokes %]'[% s %]', [% END %]],
    authorized_users => [ [% FOR u IN authorized_users %]'[% u %]', [% END %]],
    owners           => [ [% FOR o IN owners %]'[% o %]', [% END %]],
    auth             => { user => '[% dashboard_user %]', password_sha256 => '[% dashboard_password_sha256 %]' },
    claude           => { extra_tools => [ [% FOR t IN extra_tools %][% perl_string(t) %], [% END %]] },
[% IF spoke_prompt.defined() -%]
    spoke_prompt     => [% perl_string(spoke_prompt) %],
[% END -%]
[% IF poll_interval -%]
    poll_interval    => [% poll_interval %],
[% END -%]
};
