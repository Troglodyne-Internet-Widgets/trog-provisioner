[%# Inbound, the relay for the guests, which postfix binds only to the
    address where they reach this guest.  Outbound, port 25, where the relay
    delivers to the internet.  setup-ufw-rules opens each port of a profile
    both ways. -%]
[mailrelay]
title=Mail relay
description=The relay that the guests behind this one send their mail through
ports=[% relay_port %]/tcp

[mailrelay-smtp]
title=Mail relay SMTP
description=Where the relay delivers mail
ports=25/tcp

[%# Inbound, the ports of the mail clients, which nginx passes to the guests.
    Outbound, where the guests listen for them, which are the proxied_ports of
    Provisioner::Recipe::mail. -%]
[mailrelay-clients]
title=Mail relay clients
description=The ports of the mail clients that the relay passes to the guests
ports=[% client_ports.values().sort().join(',') %]/tcp

[mailrelay-upstream]
title=Mail relay upstreams
description=The ports where the guests behind this relay take their mail clients
ports=[% upstream_ports.join(',') %]/tcp
