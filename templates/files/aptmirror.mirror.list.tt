[%# Configuration for apt-mirror, from Provisioner::Recipe::aptmirror.

    base_path is set here and not left to the packaged default.  Thus nothing
    here depends on a file that this tree does not read.

    run_postmirror is already the default.  It is set here because
    postmirror.sh depends on it.  That script runs clean.sh, and it says why. -%]
set base_path    [% spool %]
set nthreads     [% nthreads %]
set _tilde       0
set run_postmirror 1

[% FOR suite IN suites -%]
[% FOR arch IN arches -%]
deb-[% arch %] [% upstream %] [% suite %] [% components.join(' ') %]
[% END -%]
[% IF sources -%]
deb-src [% upstream %] [% suite %] [% components.join(' ') %]
[% END -%]
[% END -%]

clean [% upstream %]
