[%# The provider that loads each dashboard JSON that a recipe puts in
    /var/lib/grafana/dashboards.  One provider serves all of them, so a recipe
    that adds a dashboard writes a file there and this file does not change. -%]
apiVersion: 1

providers:
  - name: provisioner
    orgId: 1
    folder: ""
    type: file
    disableDeletion: false
[%# Grafana rescans while it runs, so a dashboard that a later target writes
    appears without a restart. -%]
    updateIntervalSeconds: 30
[%# Grafana does not write browser edits back to the file, and replaces them
    when the file changes.  The file is the source of truth. -%]
    allowUiUpdates: false
    options:
      path: /var/lib/grafana/dashboards
      foldersFromFilesStructure: false
