# The PSGI application of the API proxy of the pdns recipe.  The key of the API comes from
# the environment, which the unit reads from a file only root and pdns can read.
use strict;
use warnings;
use PowerDNS::API::ACL::Proxy;

PowerDNS::API::ACL::Proxy->new(
    db       => '/var/lib/pdns-acl/acl.db',
    upstream => '[% api_socket %]',
    api_key  => $ENV{PDNS_API_KEY},
)->to_app;
