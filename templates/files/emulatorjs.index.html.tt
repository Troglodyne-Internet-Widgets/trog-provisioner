<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>[% (game_title || rom) | js_string %]</title>
<style>
    html, body { margin: 0; height: 100%; background: #000; }
    #game { width: 100%; height: 100%; }
</style>
</head>
<body>
<div id="game"></div>
<script>
    EJS_player = '#game';
    EJS_core = '[% core %]';
    EJS_pathtodata = '/engine/data/';
    EJS_gameUrl = '/roms/[% rom %]';
[% IF game_title %]    EJS_gameName = '[% game_title %]';
[% END -%]
</script>
<script src="/engine/data/loader.js"></script>
</body>
</html>
