#!/bin/bash
# Creates the metrics database and holds it to a retention.
#
# Telegraf creates a database that it does not find, and that database never
# expires anything.  On a collector that takes the syslog stream of the whole
# fleet, the disk fills and nothing says why.  Provisioner::Recipe::grafana has
# the account.
#
# Run as a postrun task, not from the makefile, because influxd starts in the
# same build and this script must wait for it.

set -euo pipefail

db='[% influx_database %]'
retention='[% retention %]'
influx='http://127.0.0.1:8086'

# Polled, not a fixed sleep, because influxd answers after a few seconds on a
# fresh guest and much later on a loaded one.
ready=''
for _attempt in $(seq 1 120); do
    if curl -fsS "$influx/ping" >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done

if [ -z "$ready" ]; then
    echo "grafana: influxd never answered on $influx, so $db was not created" >&2
    exit 1
fi

# Two statements, not CREATE DATABASE ... WITH DURATION, which fails on a
# database that exists with a different policy.  This pair gives the same result
# on a fresh guest and on a rebuilt one.
curl -fsS -XPOST "$influx/query" \
    --data-urlencode "q=CREATE DATABASE \"$db\"" >/dev/null

curl -fsS -XPOST "$influx/query" \
    --data-urlencode "q=ALTER RETENTION POLICY autogen ON \"$db\" DURATION $retention" >/dev/null

echo "grafana: $db keeps measurements for $retention."
