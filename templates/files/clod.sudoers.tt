[%# The grant that lets the worker run claude as agent_user.  THE AGENT
    ACCOUNT in Provisioner::Recipe::clod has the reasons.  Without
    agent_user, the file holds no grant, so that a provision takes back the
    grant of an earlier one.  sudo implies SETENV for ALL, and it is written
    out because App::Clod needs it for --preserve-env whatever the command. -%]
# Generated by Provisioner::Recipe::clod.  Do not edit by hand.
[% IF agent_user -%]
Defaults>[% agent_user %] umask=0007
[% user %] ALL=([% agent_user %]) NOPASSWD:SETENV: ALL
[% END -%]
