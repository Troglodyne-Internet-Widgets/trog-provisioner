-- Run once, as root over the unix socket, after the package is installed.
--
-- Both auth methods, on purpose.  unix_socket is how root connects from this
-- machine: the backup cron, the schema load, and everything the provisioner
-- runs.  Without it, all of those are locked out.  The password is for a
-- client that authenticates as root without being root.
--
-- mark_raw, because this is SQL and Xslate escapes for HTML.  enrich does the
-- quoting and backslash escaping that a single-quoted literal needs.
ALTER USER 'root'@'localhost' IDENTIFIED VIA unix_socket OR mysql_native_password USING PASSWORD('[% root_pw_sql | mark_raw %]');

-- Anonymous users, and root anywhere but here.
DELETE FROM mysql.global_priv WHERE User='';
DELETE FROM mysql.global_priv WHERE User='root' AND Host NOT IN ('localhost', '127.0.0.1', '::1');

-- The test database, and any lingering grants on it.
DROP DATABASE IF EXISTS test;
DELETE FROM mysql.db WHERE Db='test' OR Db='test\\_%';

FLUSH PRIVILEGES;
