# main.cf for this guest's mail stack, as a fragment.
#
# The half of main.cf that is about the machine rather than about a domain:
# where mailboxes live, which maps and milters postfix runs, what it will and
# will not accept.  It is installed once per guest by the global half of the
# mail recipe, and every domain's own fragment sits beside it as 50-<domain>.
#
# The split is not tidiness.  configd joins the list parameters across fragments
# instead of replacing them, which is what lets two domains both be in
# mydestination -- and that is exactly wrong for smtpd_milters, where two
# domains each naming opendkim would have postfix run it twice and sign every
# message twice over.  Anything that is a fact about the guest is said once,
# here.
#
# What the guest arrived with is 00-original and still applies wherever nothing
# here has an opinion.
[% UNLESS ipv6 %]
inet_protocols = ipv4
[% END %]
# What is always local, whatever domains this guest ends up hosting -- and
# nothing else, which is what the empty line above it is for.
#
# The guest's hostname is the domain it hosts (bin/provision sets local-hostname
# to it), so the postfix package's own main.cf puts that domain in mydestination.
# It has to be a virtual mailbox domain instead: postfix refuses to have a domain
# in both address classes, local delivery wins the tie, and mail for the domain
# stops being delivered to anybody's mailbox.  An empty value resets what
# 00-original had rather than adding to it -- accumulation can otherwise only
# grow a parameter, and this one arrives wrong rather than short.
mydestination =
mydestination = $myhostname, localhost

# Allow ez-tracing
debugger_command = PATH=/bin:/usr/bin:/usr/local/bin; (strace -f -p $process_id 2>&1 | logger -p mail.info) & sleep 5

# vmailboxen.  %DOVECOT_UID% is filled in by the makefile fragment, because the
# account only exists on the guest.  The group gets the same value, which is
# what the mail passwd file this pairs with uses too.
#
# The tables themselves are named per domain, not here: postfix searches a list
# of lookup tables in order, and configd joins the parameters that name them, so
# each domain owns its own file under /etc/postfix/domains/<domain>/ and nobody
# overwrites anybody.
virtual_mailbox_base = /mail
virtual_uid_maps = static:%DOVECOT_UID%
virtual_gid_maps = static:%DOVECOT_UID%

# We are not a relay.  Reset first for the same reason: the package names the
# same three, and joined onto them this reads as six.
mynetworks =
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128

# Prevent SMTP smuggling
smtpd_forbid_bare_newline = normalize

# The restriction lists.  configd deliberately does not join these across
# fragments even though they are lists: the order is the meaning, and a permit_
# landing ahead of a check that was supposed to run first is an open relay.
# They are the guest's policy rather than a domain's, so they live here where
# there is only one of them.
#
# Don't even talk to people we can't resolve or that are on RBLs
smtpd_client_restrictions = permit_mynetworks, reject_unknown_reverse_client_hostname, reject_unknown_client_hostname, reject_rbl_client zen.spamhaus.org, reject_rbl_client bl.spamcop.net, permit
# Prevent abusive behavior w/data
smtpd_data_restrictions = reject_unauth_pipelining, permit
# Reject bad HELO
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname, permit
# Don't accept mail that is FROM obviously bogus addrs when incoming.
#
# reject_authenticated_sender_login_mismatch is ahead of permit_sasl_authenticated
# on purpose: a restriction list stops at the first permit, so behind it the
# check would never run and one authenticated user could send as another.  It
# fires only for clients that authenticated -- an unauthenticated sender on port
# 25 is claiming to be anybody and that is DMARC's problem, not this list's.
smtpd_sender_restrictions = permit_mynetworks, reject_authenticated_sender_login_mismatch, permit_sasl_authenticated, reject_non_fqdn_sender, reject_unknown_sender_domain, reject_invalid_hostname, reject_unknown_reverse_client_hostname, permit
# Don't accept mail which is TO things that are either bogus or not on here when incoming.
# No check_recipient_access table here any more.  It held a per-domain DUNNO and
# a catch-all 550, which meant the second domain provisioned onto a guest
# overwrote the first one's and took its inbound mail with it.  It was only ever
# needed because the alias domains were in two address classes at once; with
# that fixed postfix makes the same check itself, rejecting a recipient absent
# from virtual_mailbox_maps with "User unknown in virtual mailbox table".
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination, reject_non_fqdn_recipient, reject_unknown_recipient_domain, permit

# milters, ldas etc
mailbox_transport = lmtp:unix:private/dovecot-lmtp
virtual_transport = lmtp:unix:private/dovecot-lmtp
content_filter = smtp-amavis:[127.0.0.1]:10024, spamassassin
milter_default_action = accept
smtpd_milters = local:opendkim/opendkim.sock, local:opendmarc/opendmarc.sock
non_smtpd_milters = $smtpd_milters

# SASL
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
