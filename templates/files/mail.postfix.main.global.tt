# main.cf for the mail stack of this guest, as a fragment.
#
# The half of main.cf that is about the machine, not about a domain: where
# mailboxes live, which maps and milters postfix runs, and what it accepts.
# The global half of the mail recipe installs it once for each guest.  The
# fragment of each domain is beside it as 50-<domain>.
#
# The split is necessary.  configd joins list parameters across fragments, so
# two domains can both be in virtual_mailbox_domains.  For smtpd_milters that
# is wrong.  If two domains each name opendkim, postfix signs every message two
# times.  So a fact about the guest is said once, here.
#
# 00-original is the main.cf that the guest arrived with.  It still applies
# where this file does not set a parameter.
[% UNLESS ipv6 %]
inet_protocols = ipv4
[% END %]
# What is always local, whatever domains this guest hosts, and nothing else.
# The empty line resets the value from 00-original, because configd otherwise
# adds to it.
#
# The hostname of the guest is the domain it hosts (bin/provision sets
# local-hostname to it).  So the main.cf of the postfix package puts that
# domain in mydestination.  It must be a virtual mailbox domain instead.  If a
# domain is in both address classes, local delivery wins, and its mail reaches
# no mailbox.
mydestination =
mydestination = $myhostname, localhost

# The command postfix runs for a daemon started with -D: strace it to the log.
debugger_command = PATH=/bin:/usr/bin:/usr/local/bin; (strace -f -p $process_id 2>&1 | logger -p mail.info) & sleep 5

# Virtual mailboxes.  The makefile fragment fills in %DOVECOT_UID%, because
# the account exists only on the guest.  The group gets the same value, as in
# the mail passwd file.
#
# The fragment of each domain names its own lookup tables, under
# /etc/postfix/domains/<domain>/.
virtual_mailbox_base = /mail
virtual_uid_maps = static:%DOVECOT_UID%
virtual_gid_maps = static:%DOVECOT_UID%

# This guest is not a relay.  Reset first, because the package names the same
# three networks, and configd adds these to them.
mynetworks =
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128

# Prevent SMTP smuggling.
smtpd_forbid_bare_newline = normalize

# The restriction lists.  configd does not join these across fragments,
# because their order is their meaning.  A permit_ before a check that must run
# first makes an open relay.  They are the policy of the guest, so they are here.
#
# Refuse clients that do not resolve or that are on an RBL.
smtpd_client_restrictions = permit_mynetworks, reject_unknown_reverse_client_hostname, reject_unknown_client_hostname, reject_rbl_client zen.spamhaus.org, reject_rbl_client bl.spamcop.net, permit
# Refuse abusive use of DATA.
smtpd_data_restrictions = reject_unauth_pipelining, permit
# Reject a bad HELO.
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname, permit
# Refuse incoming mail FROM addresses that are clearly bogus.
#
# reject_authenticated_sender_login_mismatch comes before
# permit_sasl_authenticated, because a restriction list stops at the first
# permit.  It applies only to authenticated clients.  DMARC deals with the
# others.
smtpd_sender_restrictions = permit_mynetworks, reject_authenticated_sender_login_mismatch, permit_sasl_authenticated, reject_non_fqdn_sender, reject_unknown_sender_domain, reject_invalid_hostname, reject_unknown_reverse_client_hostname, permit
# Refuse incoming mail TO addresses that are bogus or not hosted here.  postfix
# rejects a recipient that is not in virtual_mailbox_maps by itself, with "User
# unknown in virtual mailbox table".
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination, reject_non_fqdn_recipient, reject_unknown_recipient_domain, permit

# Delivery, the content filter and the milters.
mailbox_transport = lmtp:unix:private/dovecot-lmtp
virtual_transport = lmtp:unix:private/dovecot-lmtp
content_filter = smtp-amavis:[127.0.0.1]:10024, spamassassin
milter_default_action = accept
smtpd_milters = local:opendkim/opendkim.sock, local:opendmarc/opendmarc.sock
non_smtpd_milters = $smtpd_milters

# SASL
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
