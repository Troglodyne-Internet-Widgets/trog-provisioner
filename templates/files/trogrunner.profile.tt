[%# Every login shell on the guest sources this from /etc/profile.d.

    TROG_PROVISIONER_CONFIG is a second guard.  /etc/trog-provisioner is a
    symlink to the same directory, and the tools read it when nothing says
    otherwise.  With this variable, a checkout in an unusual place still reads
    the correct configuration.

    No apostrophes in an Xslate comment. -%]
export TROG_PROVISIONER_CONFIG='[% install_dir %]/[% domain %]/etc/trog-provisioner'
[% IF checkout -%]
export PATH="[% install_dir %]/[% domain %]/[% checkout_dir %]/bin:$PATH"
[% END -%]
