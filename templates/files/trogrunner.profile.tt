[%# Sourced by every login shell on the guest, out of /etc/profile.d.

    TROG_PROVISIONER_CONFIG is belt and braces: /etc/trog-provisioner is a
    symlink to the same directory, which is what the tools read when nothing
    says otherwise.  It is here so that a shell which has this and a checkout
    somewhere unexpected still reads the right configuration.

    No apostrophes in an Xslate comment. -%]
export TROG_PROVISIONER_CONFIG='[% install_dir %]/[% domain %]/etc/trog-provisioner'
[% IF checkout -%]
export PATH="[% install_dir %]/[% domain %]/[% checkout_dir %]/bin:$PATH"
[% END -%]
