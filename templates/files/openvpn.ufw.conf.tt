[%# This recipe renders this profile, not ufw.  ufw gets only rate_limits, so
    it does not know the port or the protocol.

    The section name is OpenVPN.  ufw skips a profile whose name is in
    /etc/services, and /etc/services has openvpn in lower case.  The test is
    case sensitive, so ufw accepts this name. -%]
[OpenVPN]
title=OpenVPN
description=OpenVPN server, on the port and protocol this domain configured
ports=[% port %]/[% proto %]
