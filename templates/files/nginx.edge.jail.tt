[%# The jails of nginx ban through the edge as well as through ufw, and never
    ban the edge itself.  fail2ban merges these sections into the jails of the
    domain. -%]
[% FOR jail IN edge_jails -%]
[[% jail %]]
action = %(action_)s
         edge-[% domain %]
ignoreip = 127.0.0.1/8 ::1 [% edge_address %]

[% END -%]
