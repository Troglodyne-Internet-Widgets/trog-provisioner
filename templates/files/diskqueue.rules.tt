# Tells the block layer of the guest what it actually talks to.
#
# ENV{DEVTYPE}=="disk" keeps this off the partitions.  vda1 has no queue/ of its
# own, and a write to a missing queue is a udev error that nobody reads.
#
# add|change, not add alone, so that `udevadm trigger --action=change` can apply
# this to disks that were added before the rule existed.  The first time this
# recipe runs, that is every disk on the guest.
[% FOR device IN devices -%]
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="[% device %]", ATTR{queue/scheduler}="[% scheduler %]", ATTR{queue/read_ahead_kb}="[% read_ahead_kb %]"
[% END -%]
