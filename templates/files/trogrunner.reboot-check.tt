#!/bin/sh
# Hold the reboot while bin/provision builds a guest.  A reboot cuts the build
# off and leaves a half-built guest.  Generated by
# Provisioner::Recipe::trogrunner.  Do not edit by hand.  The pattern asks for
# perl, so an editor open on bin/provision holds nothing.
count=$(pgrep -fc -- '^[^ ]*perl[^ ]* ([^ ]*/)?bin/provision( |$)')
[ "$count" -eq 0 ] && exit 0
echo "provisions running: $count"
exit 1
