[%# The fetch cache.  It answers over TLS as the hosts that recipes download
    from, fetches each file once and keeps it.  perldoc
    Provisioner::Recipe::fetchcache says why each setting is as it is.

    Everything above the server block is in the http context, because nginx
    includes the files in sites-enabled from inside it.

    Do not put an apostrophe in an Xslate comment.  The lexer reads it as the
    start of a string and consumes the template up to the next quote. -%]
proxy_cache_path [% store %] levels=1:2 keys_zone=fetchcache:64m max_size=[% max_size_gb %]g[% IF min_free_gb %] min_free=[% min_free_gb %]g[% END %] inactive=[% inactive %] use_temp_path=off;

log_format fetchcache '$remote_addr [$time_local] $host "$request" $status $body_bytes_sent $upstream_cache_status $request_time "$upstream_addr"';

[%# Whether a request is for a host that this cache fetches from.  On most
    guests this is the only server on 443, so it is the default for every name.
    Without this map, the cache fetches a request for any other host from that
    host. -%]
map $host $fetchcache_allowed {
    "~^(?:[% allow_re %])$" 1;
    default 0;
}

[%# The kind of URL, which sets how long a copy stays fresh.  The map reads the
    host and the path together, as the guest sent them.  The first regex that
    matches wins.  Thus what is never kept comes first, then the most specific
    kinds. -%]
map "$host$request_uri" $fetchcache_class {
    "~^(?:[% passthrough %])" pass;
[% FOR class IN classes -%]
[% IF class.pattern -%]
    "~^(?:[% class.pattern %])" [% class.name %];
[% END -%]
[% END -%]
    default default;
}

[%# Port 80 as well as 443, with the same locations.  A guest pointed here by
    name can ask on either port, and cpanm asks CPAN over plain http.  Upstream
    is fetched over https in both cases.  No backlog on either port, because a
    mirror on 80 sets it there and nginx takes it once for each port. -%]
server {
    listen 80;
    listen 443 ssl;
[% IF ipv6 -%]
    listen [::]:80;
    listen [::]:443 ssl;
[% END -%]
    server_name [% allow.join(' ') %];

    ssl_certificate     /etc/ssl/certs/fetchcache.pem;
    ssl_certificate_key /etc/ssl/private/fetchcache.pem;

    access_log /var/log/nginx/fetchcache.log fetchcache;

    if ($fetchcache_allowed = 0) {
        return 421;
    }

[%# The host that a relative redirect is on.  At first it is the host that the
    guest asked for.  After a redirect, it is the host of that redirect. -%]
    set $fetchcache_via $host;

[%# A variable in proxy_pass makes nginx look the upstream up when it fetches.
    It uses real DNS, not the /etc/hosts of a guest.  IPv4 only, as apt is told
    on every guest.  The servers are the ones that enrich kept, see
    Provisioner::Recipe::fetchcache. -%]
    resolver [% resolvers.join(' ') %] ipv6=off;
    resolver_timeout 10s;

    proxy_cache fetchcache;
[%# The key is the URL that the guest asked for, with the host.  A followed
    redirect is kept under the same key, because the rewrites and internal
    redirects below change neither $host nor $request_uri. -%]
    proxy_cache_key $host$request_uri;
    proxy_cache_lock on;
    proxy_cache_revalidate on;
    proxy_cache_use_stale error timeout invalid_header updating http_403 http_404 http_429 http_500 http_502 http_503 http_504;
    proxy_connect_timeout 10s;

[%# Upstream marks release assets private and no-cache, so the cache ignores
    those headers and uses only the TTLs below.  It also ignores X-Accel-*, so
    that an upstream cannot control this nginx. -%]
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary X-Accel-Expires X-Accel-Redirect X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
    proxy_hide_header Set-Cookie;

[%# Nothing that is kept is fetched as a particular user.  No Range, so the
    cache keeps the whole file and serves ranges from it.  No Accept-Encoding,
    so the cache keeps the file and not one encoding of it. -%]
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Range "";
    proxy_set_header If-Range "";
    proxy_set_header Accept-Encoding "";
    proxy_http_version 1.1;
    proxy_set_header Connection "";

[%# Room for the response headers.  github.com sends five kilobytes of them,
    and its content-security-policy alone is three and a half.  With the
    default buffer of one page, that is a 502 before nginx reads the redirect.
    The buffers must be at least as large, or nginx refuses the configuration. -%]
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;

    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 4;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    proxy_intercept_errors on;
    recursive_error_pages on;

    add_header X-Cache-Status $upstream_cache_status always;

    location = /fetchcache-status {
        default_type text/plain;
        return 200 "ok\n";
    }

[%# Every request goes out through the location for its kind.  A rewrite sends
    it there, because a location matches only the path, and the kind also
    depends on the host.  Upstream gets $request_uri, which a rewrite does not
    change.  The cache keeps only GET and HEAD, whatever the URL. -%]
    location / {
        if ($request_method !~ "^(?:GET|HEAD)$") {
            rewrite ^ /.fetchcache/pass last;
        }
        rewrite ^ /.fetchcache/$fetchcache_class last;
    }

[% FOR class IN classes -%]
    location = /.fetchcache/[% class.name %] {
        internal;
        proxy_cache_valid 200 [% class.fresh %];
[% IF class.no_stale -%]
[%# Never stale, because an apt index from a different moment than its pair
    is a hash-sum mismatch.  See Provisioner::Recipe::fetchcache. -%]
        proxy_cache_use_stale off;
[% END -%]
        error_page 301 302 303 307 308 = @follow_[% class.name %];
        proxy_pass https://$host$request_uri;
    }

[%# Follow a redirect here, not on the guest, and only to an allowed upstream.
    Always use https.  www.cpan.org gives an http:// Location when it adds the
    slash to a directory, and perlbrew lists its perls through one.  A Location
    with no host is on the host that sent it, which HTTP allows.

    Read the Location before the proxy_pass replaces the upstream that sent it.
    recursive_error_pages lets a second redirect through. -%]
    location @follow_[% class.name %] {
[% IF class.no_stale -%]
        proxy_cache_use_stale off;
[% END -%]
        set $fetchcache_location $upstream_http_location;
        if ($fetchcache_location ~ "^http://(.*)$") {
            set $fetchcache_location "https://$1";
        }
        if ($fetchcache_location ~ "^//") {
            set $fetchcache_location "https:$fetchcache_location";
        }
        if ($fetchcache_location ~ "^/") {
            set $fetchcache_location "https://$fetchcache_via$fetchcache_location";
        }
        set $fetchcache_next "";
        if ($fetchcache_location ~ "^https://((?:[% allow_re %]))/") {
            set $fetchcache_next $1;
        }
        if ($fetchcache_next = "") {
            return 502;
        }
        set $fetchcache_via $fetchcache_next;
        proxy_cache_valid 200 [% class.fresh %];
        error_page 301 302 303 307 308 = @follow_[% class.name %];
        proxy_pass $fetchcache_location;
    }

[% END -%]
[%# Never kept.  The request goes upstream as it came, with its credentials,
    and the answer comes back as it came, with its redirects.  This location
    has its own proxy_set_header list, because one here drops every one that
    the server block names. -%]
    location = /.fetchcache/pass {
        internal;
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_pass https://$host$request_uri;
    }
}
