[%# The fetch cache: the hosts recipes download from, answered here under their
    own names over TLS, fetched once and kept.  perldoc
    Provisioner::Recipe::fetchcache has the account of why each of these is
    set; this is what nginx has to be told.

    Everything above the server block is http context: files in sites-enabled
    are included from inside it.

    No apostrophes in an Xslate comment: the lexer reads one as opening a
    string and swallows the template as far as the next quote. -%]
proxy_cache_path [% store %] levels=1:2 keys_zone=fetchcache:64m max_size=[% max_size_gb %]g[% IF min_free_gb %] min_free=[% min_free_gb %]g[% END %] inactive=[% inactive %] use_temp_path=off;

log_format fetchcache '$remote_addr [$time_local] $host "$request" $status $body_bytes_sent $upstream_cache_status $request_time "$upstream_addr"';

[%# Whether a request is for a host this fetches from.  On most guests this is
    the only server on 443, and so the default for any name at all: without
    this a request naming some other host would be fetched from that host. -%]
map $host $fetchcache_allowed {
    "~^(?:[% allow_re %])$" 1;
    default 0;
}

[%# What kind of URL a request is, which decides how long a copy is kept: the
    host and the path together, as the guest sent them.  The first regex that
    matches wins, so what is never kept comes first and the rest most specific
    first. -%]
map "$host$request_uri" $fetchcache_class {
    "~^(?:[% passthrough %])" pass;
[% FOR class IN classes -%]
[% IF class.shape -%]
    "~^(?:[% class.shape %])" [% class.name %];
[% END -%]
[% END -%]
    default default;
}

server {
    listen 443 ssl;
[% IF ipv6 -%]
    listen [::]:443 ssl;
[% END -%]
    server_name [% allow.join(' ') %];

    ssl_certificate     /etc/ssl/certs/fetchcache.pem;
    ssl_certificate_key /etc/ssl/private/fetchcache.pem;

    access_log /var/log/nginx/fetchcache.log fetchcache;

    if ($fetchcache_allowed = 0) {
        return 421;
    }

[%# Upstreams are looked up when they are fetched, which is what a variable in
    proxy_pass means -- through real DNS, not the /etc/hosts of any guest.
    IPv4 only, as apt is told on every guest, and only the servers enrich
    kept: see Provisioner::Recipe::fetchcache. -%]
    resolver [% resolvers.join(' ') %] ipv6=off;
    resolver_timeout 10s;

    proxy_cache fetchcache;
[%# The URL the guest asked for, host and all, which is also the key a followed
    redirect is kept under: neither $host nor $request_uri changes across the
    rewrites and internal redirects below. -%]
    proxy_cache_key $host$request_uri;
    proxy_cache_lock on;
    proxy_cache_revalidate on;
    proxy_cache_use_stale error timeout invalid_header updating http_403 http_404 http_429 http_500 http_502 http_503 http_504;
    proxy_connect_timeout 10s;

[%# Upstream says private and no-cache about release assets, so its opinion is
    ignored and the TTLs below are the only ones.  X-Accel-* too, which would
    otherwise let an upstream steer this nginx. -%]
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary X-Accel-Expires X-Accel-Redirect X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
    proxy_hide_header Set-Cookie;

[%# Nothing kept is fetched as anybody in particular.  No Range, so what is
    kept is always the whole file, and ranges are served out of it; no
    Accept-Encoding, so what is kept is the file and not one encoding of it. -%]
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Range "";
    proxy_set_header If-Range "";
    proxy_set_header Accept-Encoding "";
    proxy_http_version 1.1;
    proxy_set_header Connection "";

[%# Room for the response headers.  github.com sends five kilobytes of them, a
    content-security-policy alone of three and a half, and the default buffer
    of one page makes that a 502 before the redirect in it is ever read.  The
    buffers have to be at least as large, or nginx refuses the arithmetic. -%]
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;

    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 4;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    proxy_intercept_errors on;
    recursive_error_pages on;

    add_header X-Cache-Status $upstream_cache_status always;

    location = /fetchcache-status {
        default_type text/plain;
        return 200 "ok\n";
    }

[%# Every request goes out through the location for its kind.  Rewritten there
    rather than matched, because a location sees only the path and a kind is a
    fact about the host as well; what is sent upstream is $request_uri, which a
    rewrite leaves as the guest sent it.  Nothing but GET and HEAD is kept,
    whatever its URL. -%]
    location / {
        if ($request_method !~ "^(?:GET|HEAD)$") {
            rewrite ^ /.fetchcache/pass last;
        }
        rewrite ^ /.fetchcache/$fetchcache_class last;
    }

[% FOR class IN classes -%]
    location = /.fetchcache/[% class.name %] {
        internal;
        proxy_cache_valid 200 [% class.fresh %];
        error_page 301 302 303 307 308 = @follow_[% class.name %];
        proxy_pass https://$host$request_uri;
    }

[%# A redirect, followed here rather than handed to the guest, and only to an
    allowed upstream over https.  Set before the proxy_pass that replaces the
    upstream it was read from; recursive_error_pages lets a second hop through. -%]
    location @follow_[% class.name %] {
        set $fetchcache_location $upstream_http_location;
        if ($fetchcache_location !~ "^https://(?:[% allow_re %])/") {
            return 502;
        }
        proxy_cache_valid 200 [% class.fresh %];
        error_page 301 302 303 307 308 = @follow_[% class.name %];
        proxy_pass $fetchcache_location;
    }

[% END -%]
[%# Never kept: passed upstream as it came, credentials and all, and its answer
    passed back as it came, redirects included.  Its own proxy_set_header list,
    since naming one here drops every one the server named. -%]
    location = /.fetchcache/pass {
        internal;
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_pass https://$host$request_uri;
    }
}
