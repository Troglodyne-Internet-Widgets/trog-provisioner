[Unit]
Description=Garage S3-compatible object storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garage
Group=garage
ExecStart=/usr/local/bin/garage -c /etc/garage.toml server
Restart=on-failure
RestartSec=5
LimitNOFILE=[% nofile_limit %]
# 0027 rather than the 0022 systemd would otherwise use, so what garage writes
# under its data and metadata directories is readable by the garage group and by
# nobody else -- narrower than the default regardless of who else can read it.
UMask=0027

[Install]
WantedBy=multi-user.target
