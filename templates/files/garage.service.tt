[Unit]
Description=Garage S3-compatible object storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garage
Group=garage
ExecStart=/usr/local/bin/garage -c /etc/garage.toml server
Restart=on-failure
RestartSec=5
LimitNOFILE=[% nofile_limit %]
# 0027 rather than the 0022 systemd would otherwise use, so what garage writes
# under its data and metadata directories is readable by the group and by nobody
# else.  templates/garage.tt hands that group to the admin user, because
# bin/new_config salvages both directories over sftp as that user with no sudo
# and cannot read a thing it is not in the group for.
UMask=0027

[Install]
WantedBy=multi-user.target
