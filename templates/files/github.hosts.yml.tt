[%# Generated by Provisioner::Recipe::github.  This is the login state of gh,
    so `gh repo clone` and `gh api` work without `gh auth login`, which wants
    a terminal.  The fragment installs it 0600 in the home of the account.

    git_protocol is what gh clones with.  ssh only where the account has a
    key to push with, which Provisioner::Recipe::git gives it. -%]
github.com:
    git_protocol: [% git_protocol %]
    user: [% github_user %]
    oauth_token: [% github_token %]
