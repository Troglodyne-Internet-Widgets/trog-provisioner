# opendmarc on the relay sees the client that connects, which the guests behind
# it do not.  It checks SPF itself, and writes its verdicts under the name of
# this guest, which those guests trust.  It sends no reports, and keeps no
# history.  Provisioner::Recipe::mailrelay has the whole account, under SPF.
AuthservID [% domain %]
TrustedAuthservIDs [% domain %]
SPFSelfValidate true
RejectFailures true
FailureReports false
IgnoreAuthenticatedClients true
UMask 000
UserID opendmarc:postfix
PidFile /run/opendmarc/opendmarc.pid
Socket local:/var/spool/postfix/opendmarc/opendmarc.sock
Syslog true
SyslogFacility mail
PublicSuffixList /usr/share/publicsuffix/effective_tld_names.dat
