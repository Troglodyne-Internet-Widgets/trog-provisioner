[%# The checks of the records that Provisioner::Recipe::registrar publishes,
    included in its guest test.  Asked of the provider rather than of
    a resolver, because a resolver answers out of its cache. -%]
[% IF publish_records -%]
subtest 'the records of the domain are published to the zone that holds it' => sub {
    my $shortcut = '/opt/lexicon/[% domain %]';
    ok(-x $shortcut, 'the lexicon shortcut, which holds the credential, is installed') or return;

    # stdout alone, so that a warning cannot spoil the JSON.  stderr is asked
    # for again only to explain a failure.
    my $listed = sub {
        my ($type) = @_;
        my $out  = `$shortcut list $type --output=JSON 2>/dev/null`;
        my $ok   = $? == 0;
        my $list = eval { JSON::PP->new->utf8->decode($out) };
        return ($ok && ref $list eq 'ARRAY') ? $list : undef;
    };
    my $why = sub { my ($type) = @_; return scalar `$shortcut list $type --output=JSON 2>&1` };

    my $a_records = $listed->('A');
    ok($a_records, 'the provider answered with a list of A records') or diag $why->('A');
    ok((grep { ($_->{content} // '') eq '[% address %]' } @{ $a_records // [] }), 'holding the address of this domain')
        or diag explain $a_records;
[% IF own_nameserver -%]
    # The zone itself answers for its nameserver, and a resolver that asks it
    # must get the address that the glue in the zone above gives.
    my ($ns) = grep { lc($_->{name} // '') =~ m/\A\Q[% own_nameserver %]\E[.]?\z/ } @{ $a_records // [] };
    is(($ns // {})->{content}, '[% address %]', '[% own_nameserver %] is at that address too')
        or diag explain $a_records;
[% END -%]
[% FOREACH name IN address_names -%]
    {
        # The target of an MX or an SRV, which must not be a CNAME.
        my ($held) = grep { lc($_->{name} // '') =~ m/\A\Q[% name %]\E[.]?\z/ } @{ $a_records // [] };
        is(($held // {})->{content}, '[% address %]', '[% name %] holds the address as an A record')
            or diag explain $a_records;
    }
[% END -%]

    my $cnames = $listed->('CNAME');
    ok($cnames, 'and with a list of CNAMEs') or diag $why->('CNAME');
    my %cname = map { ($_->{name} // '') => 1 } @{ $cnames // [] };
[% FOREACH alias IN domain_aliases.sort() -%]
    ok($cname{'[% alias %]'}, '[% alias %] is published under exactly that name') or diag explain $cnames;
[% END -%]

    # The records of the recipes other than names.  A TXT record can come back
    # in quotes, and a name or target with its trailing dot.
    my $plain = sub { my ($text) = @_; $text = lc($text // ''); $text =~ s/\A"(.*)"\z/$1/s; $text =~ s/[.]\z//; return $text };
    my %of;
[% FOREACH record IN zone_records -%]
    {
        my $rows = $of{'[% record.type %]'} //= $listed->('[% record.type %]');
        my $want = $plain->(q{[% record.content | mark_raw %]});
        ok((grep { $plain->($_->{name}) eq $plain->('[% record.name %]') && $plain->($_->{content}) eq $want } @{ $rows // [] }),
            '[% record.type %] [% record.name %] holds [% record.content | mark_raw %]') or diag explain $rows;
    }
[% END -%]
};
[% FOREACH zone IN zone_access.keys().sort() -%]

subtest 'the names in [% zone %] are published there, through its own shortcut' => sub {
    my $shortcut = '/opt/lexicon/zones/[% zone %]';
    ok(-x $shortcut, 'the shortcut of the zone is installed') or return;
    is((stat $shortcut)[2] & 07777, 0700, 'and nobody but root can read the credential in it');

    my %held;
    foreach my $type (qw{A CNAME}) {
        my $out  = `$shortcut list $type --output=JSON 2>&1`;
        my $list = eval { JSON::PP->new->utf8->decode($out) };
        ok(ref $list eq 'ARRAY', "the provider of the zone answered with a list of $type records") or diag $out;
        $held{$type} = { map { lc(($_->{name} // '') =~ s/[.]\z//r) => lc(($_->{content} // '') =~ s/[.]\z//r) } @{ ref $list eq 'ARRAY' ? $list : [] } };
    }
[% FOREACH apex IN zone_apexes -%]
[% IF apex == zone -%]
    is($held{A}{'[% zone %]'}, '[% address %]', 'the apex of [% zone %] is at the address of this domain') or diag explain \%held;
[% END -%]
[% END -%]
[% FOREACH name IN zone_cnames[zone].sort() -%]
    is($held{CNAME}{'[% name %]'}, '[% domain %]', '[% name %] is a CNAME of this domain') or diag explain \%held;
[% END -%]
};
[% END -%]
[% ELSE -%]
# The hypervisor allocates the address, and there was none when the makefile
# was written.
pass('this recipe publishes nothing for this domain');
[% END -%]
