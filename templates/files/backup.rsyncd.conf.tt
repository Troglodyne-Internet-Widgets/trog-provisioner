port = 40404
[%# Without a log file, rsyncd sends its messages down the ssh connection and
    keeps none here.  Provisioner::Recipe::backup has the whole account. -%]
log file = /var/log/rsyncd/[% domain %].log
[% FOR target IN targets.keys().sort() %]
[[% target %]]
use chroot = yes
open noatime = yes 
list = no
path = [% targets.$target %]
uid = root
gid = root
[%# exclude, singular.  rsyncd silently ignores an unknown parameter such as
    excludes, so the patterns under it have no effect. -%]
[% IF excludes.$target %]
exclude = [% excludes.$target %]
[% END -%]
[% END %]
