#!/bin/sh
[%# The claude of App::Clod, as claude.bin of clod.conf.  sudo runs it as
    agent_user, with HOME the home of that account.  THE AGENT ACCOUNT in
    Provisioner::Recipe::clod says why the token is in a file.

    No apostrophes in an Xslate comment. -%]
# Runs claude with the Claude token of [% agent_user %], which only that
# account can read.  Generated by Provisioner::Recipe::clod.  Do not edit by hand.
CLAUDE_CODE_OAUTH_TOKEN="$(cat '[% agent_home %]/.claude-token')" || exit 1
export CLAUDE_CODE_OAUTH_TOKEN
exec claude "$@"
