#!/bin/bash

[%# Rendered from Provisioner::DNSRecipe/lexicon_credentials, so this shortcut,
    the dehydrated hook and the synczones upstream section cannot come to
    different answers about how lexicon reaches the server holding this zone.

    lexicon derives an environment variable from the provider name plus the
    option name, so --pdns-server is PDNS_SERVER here with the provider
    prefixed around it.  The shorter spelling resolved to nothing, and this
    shortcut had therefore never been pointed at the socket at all. -%]
export LEXICON_[% lexicon.type.upper() %]_AUTH_TOKEN="[% lexicon.key %]"
[% IF lexicon.user -%]
export LEXICON_[% lexicon.type.upper() %]_AUTH_USERNAME="[% lexicon.user %]"
[% END -%]
[% FOREACH lv IN lexicon.extra -%]
export LEXICON_[% lexicon.type.upper() %]_[% lv.key %]="[% lv.value %]"
[% END -%]

COMMAND=$1;
shift;

lexicon [% lexicon.opts %] [% lexicon.type %] $COMMAND [% domain %] $@
