# Client credentials with full access to the database, for root and the admin.
#
# One section for each client that reads this file, and each names the socket.
# Recipes outside this repository point --defaults-file here.  That option
# replaces the defaults, so the file must hold everything a client needs.
[client]
socket = /run/mysqld/mysqld.sock
user = root
password = "[% root_pw_cnf | mark_raw %]"

[mysqlcheck]
socket = /run/mysqld/mysqld.sock
user = root
password = "[% root_pw_cnf | mark_raw %]"

[mariadb-dump]
socket = /run/mysqld/mysqld.sock
user = root
password = "[% root_pw_cnf | mark_raw %]"

[mariabackup]
socket = /run/mysqld/mysqld.sock
user = root
password = "[% root_pw_cnf | mark_raw %]"
