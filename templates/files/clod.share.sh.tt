#!/bin/sh
# Shares the workspace of [% domain %] with [% agent_user %], which claude runs
# as.  It runs in the postrun, because the claude recipe makes the account, and
# its target runs after the one of clod.  THE AGENT ACCOUNT in
# Provisioner::Recipe::clod says why each line is there.
# Generated by Provisioner::Recipe::clod.  Do not edit by hand.
set -e
workspace='[% install_dir %]/[% domain %]/workspace'
usermod -a -G '[% agent_user %]' '[% user %]'
install -d -o '[% user %]' -g '[% agent_user %]' -m 2770 "$workspace"
chgrp -R '[% agent_user %]' "$workspace"
chmod -R g+rwX "$workspace"
find "$workspace" -type d -exec chmod g+s {} +

# The agent lib, before clod-deps.sh fills it, so what it installs takes the
# group of the agent.  See THE AGENT LIB in Provisioner::Recipe::clod.
install -d -o '[% user %]' -g '[% agent_user %]' -m 2750 '[% agent_lib %]'

# The Claude token of the agent, which only the agent reads.  See THE AGENT
# ACCOUNT in Provisioner::Recipe::clod.
install -o '[% agent_user %]' -g '[% agent_user %]' -m 0400 '[% install_dir %]/[% domain %]/clod-agent.token' '[% agent_home %]/.claude-token'
rm -f '[% install_dir %]/[% domain %]/clod-agent.token'
