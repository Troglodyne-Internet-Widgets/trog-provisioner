#!/bin/sh
# Generated by Provisioner::Recipe::claude.  Do not edit by hand.
# A hook of Claude Code.  It records the state of the session in the tmux
# window option @claude_state, which /etc/tmux.conf.d/claude.conf draws as a
# badge.  Provisioner::Recipe::claude says which event sends which state.
# Usage: claude-tmux-state idle|working|blocked|resume|done|clear
[ -n "$TMUX_PANE" ] || exit 0
t() { tmux "$@" 2>/dev/null; }
w() { t display -p -t "$TMUX_PANE" "$1"; }
state=$1
case $state in
    resume) [ "$(w '#{@claude_state}')" = blocked ] || exit 0; state=working ;;
    clear) t set -wu -t "$TMUX_PANE" @claude_state; t set -wu -t "$TMUX_PANE" @claude_since; exit 0 ;;
esac
# A turn that ends in the window you are watching is already seen.
[ "$state" = done ] && [ "$(w '#{&&:#{window_active},#{session_attached}}')" = 1 ] && state=idle
t set -w -t "$TMUX_PANE" @claude_state "$state"
t set -w -t "$TMUX_PANE" @claude_since "$(date +%H:%M)"
# The bell too, so the window also gets the bell flag of tmux.
case $state in blocked|done) tty=$(w '#{pane_tty}') && printf '\a' > "$tty" ;; esac
exit 0
