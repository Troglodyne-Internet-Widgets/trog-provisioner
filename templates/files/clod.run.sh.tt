#!/bin/sh
# Runs the clod command that its arguments name, such as deps install, as
# [% user %], who owns the local lib [% local_lib %] and reads clod.conf.  The
# postrun runs it.  THE LOCAL LIB in Provisioner::Recipe::clod says why.
# Generated by Provisioner::Recipe::clod.  Do not edit by hand.
set -e
home='[% install_dir %]/[% domain %]'
exec runuser -u '[% user %]' -- env HOME="$home" CLOD_CONFIG="$home/clod.conf" \
    PERL5LIB='[% local_lib %]/lib/perl5' PATH='[% local_lib %]/bin:/opt/perl5/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
    /opt/perl5/current/bin/perl -I"$home/App-Clod/lib" "$home/App-Clod/script/clod" "$@"
