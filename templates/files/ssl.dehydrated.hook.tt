#!/usr/bin/env bash
#
# Answer a DNS challenge with lexicon.
# Based almost entirely on:
# https://raw.githubusercontent.com/dns-lexicon/dns-lexicon/HEAD/examples/dehydrated.default.sh

set -e
set -u
set -o pipefail

export PROVIDER_UPDATE_DELAY=${PROVIDER_UPDATE_DELAY:-"30"}
[%# The same credential, with the same name and format, as the shortcut that
    templates/files/lexicon.shortcut.sh.tt exports.  Both come from
    Provisioner::Recipe::registrar/credentials_for. -%]
[% IF lexicon.type -%]
export PROVIDER="[% lexicon.type %]"
[% IF lexicon.user -%]
export LEXICON_[% lexicon.type.upper() %]_AUTH_USERNAME="[% lexicon.user %]"
[% END -%]
[% IF lexicon.key_file -%]
export LEXICON_[% lexicon.type.upper() %]_AUTH_TOKEN="$(cat [% lexicon.key_file %])"
[% ELSIF lexicon.key -%]
export LEXICON_[% lexicon.type.upper() %]_AUTH_TOKEN="[% lexicon.key %]"
[% END -%]
[% FOREACH lv IN lexicon.extra -%]
export LEXICON_[% lexicon.type.upper() %]_[% lv.key %]="[% lv.value %]"
[% END -%]
[% END -%]
[%# The shortcut of the zone of a registrar account that holds a name, or nothing
    for a name that the lexicon above answers for.  The zone of the domain
    first, and then the longer zones first, as zone_of in
    Provisioner::Recipe::registrar decides. -%]
function shortcut_of {
    case "${1}" in
        [% domain %]|*.[% domain %]) ;;
[% FOREACH zone IN challenge_zones -%]
        [% zone %]|*.[% zone %]) echo /opt/lexicon/zones/[% zone %] ;;
[% END -%]
    esac
}

function deploy_challenge {
    local chain=($@)
    for ((i=0; i < $#; i+=3)); do
        local DOMAIN="${chain[i]}" TOKEN_FILENAME="${chain[i+1]}" TOKEN_VALUE="${chain[i+2]}"

        echo "deploy_challenge called: ${DOMAIN}, ${TOKEN_FILENAME}, ${TOKEN_VALUE}"

        local shortcut
        shortcut="$(shortcut_of "${DOMAIN}")"
        if [ -n "${shortcut}" ]; then
            "${shortcut}" create TXT --name="_acme-challenge.${DOMAIN}." --content="${TOKEN_VALUE}"
        else
            lexicon [% IF lexicon.opts %][% lexicon.opts %] [% END %]$PROVIDER create [% lexicon.zone || '${DOMAIN}' %] TXT --name="_acme-challenge.${DOMAIN}." \
            --content="${TOKEN_VALUE}"
        fi
    done

    local DELAY_COUNTDOWN=$PROVIDER_UPDATE_DELAY
    while [ $DELAY_COUNTDOWN -gt 0 ]; do
        echo -ne "${DELAY_COUNTDOWN}\033[0K\r"
        sleep 1
        : $((DELAY_COUNTDOWN--))
    done

    # dehydrated calls this hook once for each domain chain to validate,
    # including the alternative names.
    #
    # Parameters:
    # - DOMAIN
    #   The domain name (CN or subject alternative name) to validate.
    # - TOKEN_FILENAME
    #   The name of the file that holds the token for HTTP validation. The
    #   web server serves it as /.well-known/acme-challenge/${TOKEN_FILENAME}.
    # - TOKEN_VALUE
    #   The token value for validation. For DNS validation, this goes in the
    #   _acme-challenge TXT record. For HTTP validation, it is the content of
    #   the $TOKEN_FILENAME file.
}

function clean_challenge {
    local chain=($@)
    for ((i=0; i < $#; i+=3)); do
        local DOMAIN="${chain[i]}" TOKEN_FILENAME="${chain[i+1]}" TOKEN_VALUE="${chain[i+2]}"

        echo "clean_challenge called: ${DOMAIN}, ${TOKEN_FILENAME}, ${TOKEN_VALUE}"

        local shortcut
        shortcut="$(shortcut_of "${DOMAIN}")"
        if [ -n "${shortcut}" ]; then
            "${shortcut}" delete TXT --name="_acme-challenge.${DOMAIN}." --content="${TOKEN_VALUE}"
        else
            lexicon [% IF lexicon.opts %][% lexicon.opts %] [% END %]$PROVIDER delete [% lexicon.zone || '${DOMAIN}' %] TXT --name="_acme-challenge.${DOMAIN}." \
            --content="${TOKEN_VALUE}"
        fi
    done

    # dehydrated calls this hook after it tries to validate each domain
    # chain, whether or not the validation succeeded. It removes the TXT
    # records that deploy_challenge added.
    #
    # The parameters are the same as for deploy_challenge.
}

function invalid_challenge() {
    local DOMAIN="${1}" RESPONSE="${2}"

    echo "invalid_challenge called: ${DOMAIN}, ${RESPONSE}"

    # dehydrated calls this hook if the challenge response failed.
    #
    # Parameters:
    # - DOMAIN
    #   The primary domain name, i.e. the certificate common
    #   name (CN).
    # - RESPONSE
    #   The response that the verification server returned
}

function deploy_cert {
    local DOMAIN="${1}" KEYFILE="${2}" CERTFILE="${3}" FULLCHAINFILE="${4}" CHAINFILE="${5}"

    echo "deploy_cert called: ${DOMAIN}, ${KEYFILE}, ${CERTFILE}, ${FULLCHAINFILE}, ${CHAINFILE}"

    # dehydrated calls this hook once for each new certificate.
    #
    # Parameters:
    # - DOMAIN
    #   The primary domain name, i.e. the certificate common
    #   name (CN).
    # - KEYFILE
    #   The path of the file containing the private key.
    # - CERTFILE
    #   The path of the file containing the signed certificate.
    # - FULLCHAINFILE
    #   The path of the file containing the full certificate chain.
    # - CHAINFILE
    #   The path of the file containing the intermediate certificate(s).
[% IF certificate_readers.size() %]

    # The nightly renewal ends here, and a service reads the certificate only
    # when it starts or reloads.
    systemctl try-reload-or-restart [% certificate_readers.join(' ') %]
[% END -%]
}

function unchanged_cert {
    local DOMAIN="${1}" KEYFILE="${2}" CERTFILE="${3}" FULLCHAINFILE="${4}" CHAINFILE="${5}"

    echo "unchanged_cert called: ${DOMAIN}, ${KEYFILE}, ${CERTFILE}, ${FULLCHAINFILE}, ${CHAINFILE}"

    # dehydrated calls this hook once for each certificate that is still
    # valid, and so was not issued again.
    #
    # Parameters:
    # - DOMAIN
    #   The primary domain name, i.e. the certificate common
    #   name (CN).
    # - KEYFILE
    #   The path of the file containing the private key.
    # - CERTFILE
    #   The path of the file containing the signed certificate.
    # - FULLCHAINFILE
    #   The path of the file containing the full certificate chain.
    # - CHAINFILE
    #   The path of the file containing the intermediate certificate(s).
}

exit_hook() {
  # dehydrated calls this hook at the end of each command, including the
  # nightly renewal, which does not run get_cert.  It sets the ownership and
  # the modes of the certificate store.  Directories keep their execute bit,
  # or nobody can enter the tree.  Provisioner::Recipe::letsencrypt says why.
  chown -R root:root /var/lib/dehydrated
  find /var/lib/dehydrated -type d -exec chmod 0755 {} +
  find /var/lib/dehydrated -type f -exec chmod 0644 {} +
  find /var/lib/dehydrated -type f -name 'priv*' -exec chgrp ssl-cert {} + -exec chmod 0640 {} +
  :
}

startup_hook() {
  # dehydrated calls this hook before each command.

  :
}

HANDLER=$1; shift;
if [ -n "$(type -t $HANDLER)" ] && [ "$(type -t $HANDLER)" = function ]; then
  $HANDLER "$@"
fi
