# Generated by Provisioner::Recipe::admincode.  Do not edit by hand.
# claude gets --add-dir for each checkout, because only that flag loads its
# skills.  Provisioner::Recipe::admincode has the whole account.
case " ${ADMINCODE_BASEDIRS[*]} " in
    *" [% install_dir %]/[% domain %]/[% basedir %] "*) ;;
    *) ADMINCODE_BASEDIRS+=( '[% install_dir %]/[% domain %]/[% basedir %]' ) ;;
esac

claude() {
    local args=() base dir
    for base in "${ADMINCODE_BASEDIRS[@]}"; do
        for dir in "$base"/*/ "$base"/.[!.]*/; do
            [ -e "$dir.git" ] && args+=( --add-dir "${dir%/}" )
        done
    done
    command claude "${args[@]}" "$@"
}
