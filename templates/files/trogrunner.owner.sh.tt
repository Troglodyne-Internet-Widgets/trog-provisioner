#!/bin/sh
[%# Rendered into trogrunner-owner.sh, which the postrun runs.  THE
    PROVISIONING ACCOUNT in Provisioner::Recipe::trogrunner says why it is in
    the postrun, and why each grant is there.

    No apostrophes in an Xslate comment. -%]
# Gives the configuration of the runner of [% domain %], and the key that its
# hypervisors trust, to [% provision_user %], the account that runs bin/provision.
# Generated by Provisioner::Recipe::trogrunner.  Do not edit by hand.
set -e
who='[% provision_user %]'
dir='[% install_dir %]/[% domain %]'

home="$(getent passwd "$who" | cut -d: -f6)"
if [ -z "$home" ]; then echo "trogrunner: no home directory for $who" >&2; exit 1; fi

# The account writes ips.db here, the first time that it assigns an address.
chown -R "$who:[% admin_user %]" "$dir/etc/trog-provisioner"
[% IF provision_user != user -%]

# Only the right to pass through, so that the account reaches the directory
# above and the key, and lists nothing on the way.
setfacl -m "u:$who:x" "$dir" "$dir/etc"
[% END -%]

# Net::OpenSSH::More does not start if the ssh config mode is wider than 0600.
# It says "[FATAL] Permissions on ... are not correct: got=0775,
# expected=0600".  The dotfiles that adminconfig installs ship one with mode
# 0775.  Only the mode changes, because the content belongs to whoever wrote
# the dotfiles.
install -d -o "$who" -g "$who" -m 0700 "$home/.ssh"
if [ -f "$home/.ssh/config" ]; then chmod 0600 "$home/.ssh/config"; fi
[% IF hypervisor_access != 'none' -%]

# bin/provision put the key here from the secret store, owned by root, as
# guest_secrets says.  The data target changes the modes in this tree, and ssh
# refuses a key wider than 0600.
key="$dir/.ssh/id_ed25519"
if [ ! -f "$key" ]; then echo 'trogrunner: no hypervisor key was placed; bin/provision is what puts it here' >&2; exit 1; fi
chown "$who:$who" "$key"
chmod 0600 "$key"
[% IF provision_user != user -%]
setfacl -m "u:$who:x" "$dir/.ssh"
[% END -%]

# A link in the home, because ssh looks in ~/.ssh, and nothing in a libvirt
# qemu+ssh URI can point it elsewhere.  The key in the domain directory is the
# main copy, which remote_skip keeps out of the salvage.  The link is the
# account own too, because nothing in its home belongs to another user.
if [ "$home" != "$dir" ]; then ln -sfn "$key" "$home/.ssh/id_ed25519"; chown -h "$who:$who" "$home/.ssh/id_ed25519"; fi
[% FOR name IN hypervisors.keys().sort() -%]
[% SET hv = hypervisors.$name -%]
[% IF hv.ssh_host -%]

# The host keys of [% name %].  The qemu+ssh transport checks host keys, and
# Net::OpenSSH::More does not, so with an empty known_hosts the hypervisor
# refuses on first contact, although plain ssh to it works.
runuser -u "$who" -- ssh-keygen -F '[% hv.ssh_host %]' >/dev/null 2>&1 || runuser -u "$who" -- sh -c "ssh-keyscan -p '[% hv.ssh_port %]' '[% hv.ssh_host %]' >> '$home/.ssh/known_hosts'"
[% END -%]
[% END -%]
[% END -%]
