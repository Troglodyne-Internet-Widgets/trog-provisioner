$ORIGIN [% domain %].
$TTL    300

@       IN      SOA     ns1.[% domain %]. [% admin_email | email_for_dns %]. (
                        [% serial %]      ; Serial (unix timestamp)
                        300               ; Refresh
                        300               ; Retry
                        1209600           ; Expire
                        10800 )           ; Minimum

; This guest is the nameserver that the zone is delegated to.
@ 300 IN NS ns1.[% domain %].

; The other nameservers in the cluster, if there are any.
[% FOREACH ns IN nameservers.values().sort() %]
@        300      IN NS   [% ns %].
[% END -%]

[% FOREACH subdo IN ipmap.keys().sort() %]
[% NEXT IF subdo != domain %]
@       IN A    [% ipmap.$subdo %]
ns1     IN A    [% ipmap.$subdo %]
;[% ipmap.$subdo | reverse_ip %] IN PTR  [% subdo %]
[% END -%]

[%# Absolute, with the trailing dot.  An alias is spelled out in full in the
    configuration -- bin/new_config appends www and mail to the domain, and
    ipmap.cfg names the rest in full -- and a name written relative here has
    $ORIGIN put on it again.  That is how www.<domain> came to answer only as
    www.<domain>.<domain>, on every guest that serves its own zone. -%]
[% FOREACH sub IN aliases.keys().sort() %]
[% NEXT IF sub != domain %]
[% FOREACH alias IN aliases.$sub.sort() %]
[% alias %]. IN CNAME @
[% END -%]
[% END -%]

[%# Only where the guest serves mail.  Every one of these names mail.<domain> or
    autoconfig.<domain>, and those are the mail recipe to declare -- so on a
    domain that runs no mail they are an MX and five SRVs pointing at a host
    with no record at all.  They resolved before only because every domain in
    the map was given a mail. CNAME whether it served any or not.

    This is a rule about which service records the zone carries, not about which
    names exist: the names are declared, and bin/new_config puts them in the
    aliases above.  A record that points at one still has to know whether the
    thing it points at is there. -%]
[% IF modules.grep('mail').size() %]
; Mail
[%# Absolute, as the SRV targets below are.  Written relative it resolves to
    mail.<domain>.<domain>, which is nowhere. -%]
@       IN MX 10 mail.[% domain %].

; Autodiscover TXT record
@ IN TXT "mailconf=https://autoconfig.[% domain %]/autoconfig/autoconfig.xml"

; DKIM and DMARC placeholders.  If the guest runs mail, a lexicon script
; replaces them.
default._domainkey IN TXT  "o=-"
mail._domainkey    IN TXT  "o=-"
_dmarc             IN TXT  "v=DMARC1; p=none"
@                  IN TXT  "v=spf1 +a +mx -all"

_imaps._tcp        IN SRV 0 0 993 mail.[% domain %].
_pop3s._tcp        IN SRV 0 0 995 mail.[% domain %].
_smtps._tcp        IN SRV 0 0 465 mail.[% domain %].
_submission._tcp   IN SRV 0 0 587 mail.[% domain %].
_autodiscover._tcp IN SRV 0 0 80  mail.[% domain %].
[% END -%]

; The extra_records from the configuration follow, for example a DKIM key,
; or ACME, CAA or GSV records.
[% IF extra_records %]
[% extra_records | mark_raw %]
[% END %]
