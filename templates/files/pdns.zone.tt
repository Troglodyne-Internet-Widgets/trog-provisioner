$ORIGIN [% domain %].
$TTL    300

@       IN      SOA     ns1.[% domain %]. [% admin_email | email_for_dns %]. (
                        [% serial %]      ; Serial (unix timestamp)
                        300               ; Refresh
                        300               ; Retry
                        1209600           ; Expire
                        10800 )           ; Minimum

; This guest is the nameserver that the zone is delegated to.
@ 300 IN NS ns1.[% domain %].

; The other nameservers in the cluster, if there are any.
[% FOREACH ns IN nameservers.values().sort() %]
@        300      IN NS   [% ns %].
[% END -%]

[% FOREACH subdo IN ipmap.keys().sort() %]
[% NEXT IF subdo != domain %]
@       IN A    [% ipmap.$subdo %]
ns1     IN A    [% public_address // ipmap.$subdo %]
;[% ipmap.$subdo | reverse_ip %] IN PTR  [% subdo %]
[% END -%]

[%# Absolute, with the trailing dot.  Each alias is a whole name, and a name
    written relative here has $ORIGIN put on it again.  That is how
    www.<domain> came to answer only as www.<domain>.<domain>, on every guest
    that serves its own zone. -%]
[% FOREACH alias IN domain_aliases.sort() %]
[% alias %]. IN CNAME @
[% END -%]

[%# The target of an MX or an SRV must not be a CNAME.  See addressed_names in
    Provisioner::Recipe. -%]
[% FOREACH name IN address_names %]
[% name %]. IN A [% ipmap.$domain %]
[% END -%]

[%# The records of the recipes other than names, such as the MX of mail.  See
    zone_records in Provisioner::Recipe::registrar.  Raw, because the content
    of a TXT record is text, not HTML. -%]
[% FOREACH record IN zone_records %]
[% record.name %]. IN [% record.type %] [% IF record.type == 'TXT' %]"[% record.content | mark_raw %]"[% ELSE %][% record.content | mark_raw %][% END %]
[% END -%]

; The extra_records from the configuration follow, for example a DKIM key,
; or ACME, CAA or GSV records.
[% IF extra_records %]
[% extra_records | mark_raw %]
[% END %]
