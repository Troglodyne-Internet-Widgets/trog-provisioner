#!/bin/bash

[%# One shortcut for the recipe that holds this zone, rendered from what
    Provisioner::DNSRecipe/lexicon_credentials returns.  pdns and the registrar
    give lexicon the same things: a provider, a credential, and sometimes an
    endpoint.  So one template serves both.

    lexicon makes the name of an environment variable from the provider name and
    the option name.  So the option --pdns-server is PDNS_SERVER here, with the
    LEXICON_ and provider prefix added. -%]
export LEXICON_[% lexicon.type.upper() %]_AUTH_TOKEN="[% lexicon.key %]"
[% IF lexicon.user -%]
export LEXICON_[% lexicon.type.upper() %]_AUTH_USERNAME="[% lexicon.user %]"
[% END -%]
[% FOREACH lv IN lexicon.extra -%]
export LEXICON_[% lexicon.type.upper() %]_[% lv.key %]="[% lv.value %]"
[% END -%]

COMMAND=$1;
shift;

lexicon [% IF lexicon.opts %][% lexicon.opts %] [% END %][% lexicon.type %] $COMMAND [% domain %] $@
