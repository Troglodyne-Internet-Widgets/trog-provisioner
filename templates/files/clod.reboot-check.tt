#!/bin/sh
# Hold the reboot while the worker of App::Clod runs a job.  A job can be a
# claude run of an hour, and a reboot fails it.  Generated by
# Provisioner::Recipe::clod.  Do not edit by hand.
minion_active() { '[% install_dir %]/[% domain %]/clod-run.sh' minion job -S active; }
[% INCLUDE "files/minion.reboot-check.tt" -%]
