# Generated by Provisioner::Recipe::claude -- pre-seeds gh's auth state, so this
# guest can use gh without an interactive `gh auth login`, which has nowhere to
# happen on a provisioned box.
#
# This file is what decides whose name a review reply or a pull request edit
# appears under.  It is a live credential: 0600, owned by the account claude
# runs as.
github.com:
    git_protocol: https
    user: [% github_user %]
    oauth_token: [% github_token %]
