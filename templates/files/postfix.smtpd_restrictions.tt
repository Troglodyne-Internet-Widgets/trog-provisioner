[%# The checks of a client that delivers mail from the internet, which a mail
    guest makes on its port 25, and a mail relay on its own before it relays
    the mail to the guest, and what port 25 tells that client.  One file, so
    that the two cannot drift apart.  The trusted_clients of the recipe skip
    the checks of the client, but not the checks of the recipient. -%]
[% SET trust = trusted_clients.size() ? ' check_client_access inline:{' ~ trusted_clients.join('=OK, ') ~ '=OK},' : '' -%]
# The restriction lists.  configd does not join these across fragments,
# because their order is their meaning.  A permit_ before a check that must run
# first makes an open relay.  They are the policy of the guest, and of a mail
# relay in front of it.
#
# Refuse clients that do not resolve or that are on an RBL.  An OK of
# check_client_access ends only this list and the sender list, so a trusted
# client still cannot relay.
smtpd_client_restrictions = permit_mynetworks,[% trust %] reject_unknown_reverse_client_hostname, reject_unknown_client_hostname, reject_rbl_client zen.spamhaus.org, reject_rbl_client bl.spamcop.net, permit
# Refuse abusive use of DATA.
smtpd_data_restrictions = reject_unauth_pipelining, permit
# Reject a bad HELO.
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname, permit
# Refuse incoming mail FROM addresses that are clearly bogus.
#
# reject_authenticated_sender_login_mismatch comes before
# permit_sasl_authenticated, because a restriction list stops at the first
# permit.  It applies only to authenticated clients.  DMARC deals with the
# others.
smtpd_sender_restrictions = permit_mynetworks, reject_authenticated_sender_login_mismatch, permit_sasl_authenticated,[% trust %] reject_non_fqdn_sender, reject_unknown_sender_domain, reject_invalid_hostname, reject_unknown_reverse_client_hostname, permit
# Refuse incoming mail TO addresses that are bogus or not hosted here.  postfix
# rejects a recipient that is not in virtual_mailbox_maps by itself, with "User
# unknown in virtual mailbox table".  With spf_policy, which the mail relay sets, the
# SPF policy service judges the client after the destination is known to be
# ours, and records what it found.
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination,[% IF spf_policy %] check_policy_service unix:private/policyd-spf,[% END %] reject_non_fqdn_recipient, reject_unknown_recipient_domain, permit

# The greeting names the host and no software.  The package adds
# "$mail_name (Ubuntu)", which tells a client what to attack.
smtpd_banner = $myhostname ESMTP
# VRFY tells a client whether an address exists, with no message sent.
disable_vrfy_command = yes

