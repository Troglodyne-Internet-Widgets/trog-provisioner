# Generated by Provisioner::Recipe::koan.
# Behavior settings.  The secrets are in ../.env.

max_runs_per_day: [% max_runs_per_day %]
interval_seconds: [% interval_seconds %]

# Start paused, so that the bot waits for /resume before it does anything.
# This helps with scheduled launches and with provisions after the first.
start_on_pause: [% start_on_pause ? 'true' : 'false' %]

# Focus mode: when true, the bot runs only the missions in its queue and does
# not explore on its own.  It is off by default.
focus: [% focus ? 'true' : 'false' %]

messaging:
  provider: "[% messaging_provider %]"
[% IF messaging_provider == 'matrix' %]
  matrix:
    homeserver:   "[% matrix_homeserver %]"
    user_id:      "[% matrix_user_id %]"
    room_id:      "[% matrix_room_id %]"
[% IF matrix_e2ee %]
    e2ee:         true
[% ELSE %]
    e2ee:         false
[% END %]
[% IF matrix_access_token %]
    access_token: "[% matrix_access_token %]"
[% IF matrix_device_id %]
    device_id:    "[% matrix_device_id %]"
[% END %]
[% END %]
    # For the bootstrap (matrix_password), access_token and device_id come
    # from instance/matrix/credentials.env when the bot runs.
[% END %]

github:
  nickname: "[% github_nickname %]"
  commands_enabled: true
[% IF github_authorized_users.size() %]
  authorized_users:
[% FOR u IN github_authorized_users %]
    - "[% u %]"
[% END %]
[% END %]

[% IF smtp_host %]
email:
  enabled: true
  max_per_day: 5
[% END %]
