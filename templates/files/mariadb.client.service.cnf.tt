# Client credentials for [% user %], the account the application runs as.
#
# No password.  The dump or another recipe decides what this account can do and
# how it authenticates.  This file holds what this recipe knows: the socket, and
# the account to connect as.
[client]
socket = /run/mysqld/mysqld.sock
user = [% user %]

[mariadb-dump]
socket = /run/mysqld/mysqld.sock
user = [% user %]
