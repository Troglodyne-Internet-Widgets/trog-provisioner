[%# Not named syslog.  ufw skips a profile whose section name is also a service
    name in /etc/services, and syslog is 514/udp there.  ufw writes only a
    warning to stderr.  The profile is then absent from `ufw app list`, no rule
    comes from it, and nothing fails. -%]
[logcollector]
title=Log collector
description=Syslog collection for the fleet, on the port this guest configured
[% IF protocol == 'both' -%]
ports=[% port %]/tcp|[% port %]/udp
[% ELSE -%]
ports=[% port %]/[% protocol %]
[% END -%]
