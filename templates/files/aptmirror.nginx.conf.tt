[%# The mirror, over plain HTTP on port 80.

    Port 80 and no TLS, on purpose.  The certificate of this guest is
    self-signed, and apt does not fetch through one.  This is safe because the
    spool is an exact copy of the archive, with the signed indices.  Thus apt
    checks the signature of the distribution and does not trust this host.

    server_name holds the address as well as the names.  A guest that fetches
    packages runs cloud-init before it has a resolver, so it uses the address.
    Without the address here, nginx does not match that Host.  It then gives
    the request to the default server. -%]
server {
    listen 80[% IF backlog %] backlog=[% backlog %][% END %];
[% IF ipv6 -%]
    listen [::]:80[% IF backlog %] backlog=[% backlog %][% END %];
[% END -%]
    server_name [% domain %] [% main_ip %][% FOR alias IN full_aliases %] [% alias %][% END %];

    access_log off;

    location [% path %]/ {
        alias [% mirror_root %]/;
        autoindex on;
        autoindex_exact_size off;
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
    }

[%# The time that the last sync finished, so a client can see if the mirror is
    ready.  404 until the first sync finishes. -%]
    location = /mirror-status {
        alias [% spool %]/var/last_sync;
        default_type text/plain;
        add_header Cache-Control no-store;
    }
}
