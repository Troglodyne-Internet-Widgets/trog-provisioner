# Mail cron jobs for [% domain %]
[%# Trains the Bayes database of amavis, which scores the mail, from the Junk
    and the INBOX of every account.  scripts/sa_train_amavis says which mail
    counts as spam and which as ham. -%]
[% IF names.keys().size() %]
21 2 * * * root [% script_dir %]/sa_train_amavis[% FOR user IN names.keys().sort() %] /mail/[% domain %]/[% user %]/Maildir[% END %]
[% END %]
