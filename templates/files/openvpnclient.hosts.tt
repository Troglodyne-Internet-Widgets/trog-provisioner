[%# The guests of this installation, as the ip pool assigns them, for a guest
    that reaches them through the VPN.  Provisioner::Recipe::openvpnclient has
    the whole account. -%]
# BEGIN trog openvpnclient [% domain %]
[% FOR name IN pool_hosts.keys().sort() -%]
[% pool_hosts.$name %] [% name %]
[% END -%]
# END trog openvpnclient [% domain %]
