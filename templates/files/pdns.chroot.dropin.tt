[%# What the packaged unit of pdns must change to run pdns in the chroot that
    its configuration names.  The packaged unit stays as the package left it.

    A list setting in a drop-in adds to the list of the unit, so each list
    below starts with an empty assignment, which clears what the unit set.
    Without it, systemd refuses a second ExecStart, and a capability or a
    group of system calls that the unit names stays in its set. -%]
[Service]
[%# Type=notify does not work with a chroot, because the notify socket is
    outside it.  pdns refuses to chroot, and says:
    "Unable to chroot when running from systemd."
    "Please disable chroot= or set the Type for this service to simple" -%]
Type=simple
[%# Root, because chroot(2) needs CAP_SYS_CHROOT and the packaged unit uses
    User=pdns.  If pdns_server starts as pdns, it cannot enter the chroot.  It
    then looks for /zones.db and /api.sock in the real root and exits with no
    clear cause.  After it enters the chroot, pdns drops to the user and group
    that pdns.global.tt names. -%]
User=root
Group=root
WorkingDirectory=/var/spool/powerdns
[%# --chroot must name the directory.  pdns names the sqlite database, the API
    socket and the control socket relative to this root.  So on the host they
    are under /var/spool/powerdns, where the rest of the recipe expects them. -%]
ExecStart=
ExecStart=/usr/sbin/pdns_server --guardian=no --daemon=no --logging-facility=1 --log-timestamp=yes --write-pid=no --chroot=/var/spool/powerdns
[%# The packaged bounding set is CAP_NET_BIND_SERVICE and CAP_CHOWN, which
    leaves root without CAP_SYS_CHROOT, with the result above.  CAP_SETUID and
    CAP_SETGID let pdns drop its privileges after it enters the chroot.

    The ambient set decides the capabilities that the process starts with, so
    it gets the same set.  Without it, pdns cannot drop its privileges, and
    logs this each second:
    "Unable to set effective user id to 109: Operation not permitted" -%]
CapabilityBoundingSet=
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID
AmbientCapabilities=
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID
[%# chroot(2) is in the @mount group of systemd, and the packaged unit denies
    that group.  seccomp then kills the call, and the service says only
    "signal=SYS".  This list is the packaged one without @mount. -%]
SystemCallFilter=
SystemCallFilter=~@clock @debug @module @raw-io @reboot @swap @cpu-emulation @obsolete
