[%# The rsyslog forwarder for this guest.  Provisioner::Recipe::logshipper
    explains how the destination is chosen, and why the guest test opens a
    socket to it.

    target is empty for a guest that is its own destination.  Then this file
    renders empty, and the guest does not forward to its own listener. -%]
[% IF target -%]
[%# The collector files messages under the name that the sender puts in them.
    rsyslog sends its short hostname unless told otherwise.  Without this line,
    staging.example.test and staging.example.org both go into staging.log, and
    neither file is complete. -%]
global(preserveFQDN="on")
[% selector %]  action(type="omfwd" target="[% target %]" port="[% port %]" protocol="[% protocol %]"
            action.resumeRetryCount="[% retry %]"
            queue.type="linkedList" queue.size="[% queue_size %]")
[% END -%]
