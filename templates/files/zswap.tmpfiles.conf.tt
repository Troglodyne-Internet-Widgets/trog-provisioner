# Written by the zswap recipe.  systemd-tmpfiles applies it at each boot.
# A w line writes only to a parameter that exists, so a kernel without zpool
# skips that line.  The pool settings come before enabled, so the first pool
# is made with them.
w /sys/module/zswap/parameters/compressor - - - - [% compressor %]
w /sys/module/zswap/parameters/zpool - - - - [% zpool %]
w /sys/module/zswap/parameters/max_pool_percent - - - - [% max_pool_percent %]
w /sys/module/zswap/parameters/enabled - - - - Y
