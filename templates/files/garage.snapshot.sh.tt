#!/bin/bash

# Take a snapshot of the garage metadata that the fetch can carry off the guest.
#
# The objects under [% data_dir %] are ordinary files, and the fetch copies them
# as they are.  The metadata is an LMDB database.  A copy of a live LMDB
# database has torn pages, and it restores as if it were good.
#
# So this script asks garage for a snapshot with `meta snapshot`, and
# remote_files names the snapshots.  garage writes them under
# [% metadata_dir %]/snapshots, and this script then sets their owner and mode.
#
# The script keeps only the newest few.  A snapshot is as large as the
# metadata.  More than one is kept because the newest one can come from the
# time when the problem occurred.

set -euo pipefail

SNAPDIR='[% metadata_dir %]/snapshots'
KEEP=3

# Not --all, which asks every node in the cluster.  This guest keeps only its
# own metadata.
/usr/local/bin/garage meta snapshot

# If garage wrote no snapshot, stop here and prune nothing.
if [ ! -d "$SNAPDIR" ]; then
    echo "garage-snapshot.sh: garage wrote no snapshot under $SNAPDIR" >&2
    exit 1
fi

# Only garage can read these.  The metadata says what every object in the store
# is and who can read it.  The fetch runs as root and needs no group here.
chown -R garage:garage "$SNAPDIR"
find "$SNAPDIR" -type d -exec chmod 0750 {} +
find "$SNAPDIR" -type f -exec chmod 0640 {} +

ls -1dt "$SNAPDIR"/*/ 2>/dev/null | tail -n "+$(( KEEP + 1 ))" | xargs -r rm -rf

echo "garage-snapshot.sh: snapshot taken, $(ls -1d "$SNAPDIR"/*/ 2>/dev/null | wc -l) kept"
