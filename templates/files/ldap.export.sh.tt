#!/bin/bash
# Write the directory as LDIF to /var/backups/ldap, where the next provision
# fetches it.
#
# Nothing else on this guest can make the directory again.  An MDB database is
# tied to the slapd that wrote it, but any version of OpenLDAP reads LDIF.
# Provisioner::Recipe::ldap, under SURVIVING A REBUILD, has the full account.

set -euo pipefail

BASE_DN='[% base_dn %]'
DEST=/var/backups/ldap
OWNER='[% admin_user %]'

# Dump to a staging directory, then move the files in.  A fetch can arrive
# during a dump.  A rename is atomic, but a write into the destination is not.
STAGING=$(mktemp -d /var/backups/.ldap-export.XXXXXX)
trap 'rm -rf "$STAGING"' EXIT

install -d -o "$OWNER" -g "$OWNER" -m 0700 "$DEST"

# slapcat reads the database files directly, so it needs no bind and no
# password.  MDB gives it a consistent snapshot while slapd runs.
# -n 0 is the configuration database: schema, ACLs and overlays.
# The data uses -b, because its database number depends on the configuration,
# but its suffix does not.
slapcat -F /etc/ldap/slapd.d -n 0 -l "$STAGING/config.ldif"
slapcat -F /etc/ldap/slapd.d -b "$BASE_DN" -l "$STAGING/data.ldif"

# An empty dump means that slapcat found nothing.  Do not write it over the
# last good export, which is the only copy off this machine.
if [ ! -s "$STAGING/data.ldif" ]; then
    echo "ldap-export: slapcat produced nothing for $BASE_DN; keeping the last export" >&2
    exit 1
fi

chown "$OWNER:$OWNER" "$STAGING"/*.ldif
chmod 0600 "$STAGING"/*.ldif
mv "$STAGING/config.ldif" "$DEST/config.ldif"
mv "$STAGING/data.ldif" "$DEST/data.ldif"

echo "ldap-export: wrote $DEST/data.ldif and $DEST/config.ldif"
