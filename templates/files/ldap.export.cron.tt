# Export the directory as LDIF each hour.
#
# A rebuild puts back only what the last export has.  So a rebuilt guest can
# lose the changes of up to one hour.  slapcat takes less than a second here, so
# the interval limits log noise, not load.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
17 * * * * root /usr/local/sbin/ldap-export.sh > /var/log/ldap-export.log 2>&1
