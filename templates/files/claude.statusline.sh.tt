#!/bin/bash
# Generated by Provisioner::Recipe::claude.  Do not edit by hand.
# The status line of Claude Code.  Claude Code gives the state of the session
# as JSON on standard input, and shows the two lines that this prints.

# Each is ZONE=LABEL.  statusline_clocks in the claude recipe names them.
CLOCKS=([% FOREACH clock IN statusline_clocks %] '[% clock.zone %]=[% clock.label %]'[% END %] )
# Warn when the context reaches this many tokens.  0 never warns.
COMPACT_WARN_TOKENS=[% compact_warn_at %]

# One jq for every field, as shell assignments.
eval "$(jq -r '
    (.context_window.current_usage // {}) as $use
    | @sh "MODEL=\(.model.display_name // "?")",
      @sh "DIR=\(.workspace.current_dir // "")",
      @sh "PCT=\(.context_window.used_percentage // 0 | floor)",
      @sh "COST=\(.cost.total_cost_usd // 0)",
      @sh "DURATION_MS=\(.cost.total_duration_ms // 0 | floor)",
      @sh "FIVE_H=\(.rate_limits.five_hour.used_percentage // "")",
      @sh "SEVEN_D=\(.rate_limits.seven_day.used_percentage // "")",
      @sh "FIVE_H_RESET=\(.rate_limits.five_hour.resets_at // "")",
      @sh "SEVEN_D_RESET=\(.rate_limits.seven_day.resets_at // "")",
      @sh "CACHE_READ=\($use.cache_read_input_tokens // 0)",
      @sh "TOTAL_IN=\(.context_window.total_input_tokens // 0)",
      @sh "CTX_TOKENS=\(($use.input_tokens // 0) + ($use.cache_read_input_tokens // 0) + ($use.cache_creation_input_tokens // 0))",
      @sh "EFFORT=\(.effort.level // "")",
      @sh "SESSION_NAME=\(.session_name // "")",
      @sh "AGENT_NAME=\(.agent.name // "")",
      @sh "WORKTREE=\(.workspace.git_worktree // "")",
      @sh "SESSION_ID=\(.session_id // "default")"
')"
DIR="${DIR/#$HOME/~}"
DIRNAME="${DIR##*/}"
PCT=${PCT:-0}

CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
MAGENTA='\033[35m'
BLUE='\033[34m'
GRAY='\033[90m'
BOLD='\033[1m'
RESET='\033[0m'

case "$MODEL" in
    *Opus*) MODEL_COLOR="$MAGENTA" ;;
    *Haiku*) MODEL_COLOR="$GREEN" ;;
    *) MODEL_COLOR="$CYAN" ;;
esac

# The context, as a bar 12 characters wide.  The blocks are U+2588 and U+2591
# in UTF-8, because the template is ASCII.
FULL=$'\xe2\x96\x88'
LIGHT=$'\xe2\x96\x91'
BAR_WIDTH=12
FILLED=$((PCT * BAR_WIDTH / 100))
EMPTY=$((BAR_WIDTH - FILLED))
BAR=""
if [ "$FILLED" -gt 0 ]; then printf -v FILL "%${FILLED}s"; BAR="${FILL// /$FULL}"; fi
if [ "$EMPTY" -gt 0 ]; then printf -v PAD "%${EMPTY}s"; BAR="${BAR}${PAD// /$LIGHT}"; fi
if [ "$PCT" -ge 90 ]; then BAR_COLOR="$RED"
elif [ "$PCT" -ge 70 ]; then BAR_COLOR="$YELLOW"
else BAR_COLOR="$GREEN"
fi

# Green under 50%, yellow under 80%, red from 80%.
rate_color() {
    local val
    val=$(printf '%.0f' "$1")
    if [ "$val" -ge 80 ]; then printf '%s' "$RED"
    elif [ "$val" -ge 50 ]; then printf '%s' "$YELLOW"
    else printf '%s' "$GREEN"
    fi
}

# Seconds until a reset, in the largest two units.
fmt_until() {
    local delta=$1
    [ "$delta" -lt 0 ] && delta=0
    local d=$((delta / 86400)) h=$(((delta % 86400) / 3600)) m=$(((delta % 3600) / 60)) s=$((delta % 60))
    if [ "$d" -gt 0 ]; then printf '%dd%dh' "$d" "$h"
    elif [ "$h" -gt 0 ]; then printf '%dh%dm' "$h" "$m"
    elif [ "$m" -gt 0 ]; then printf '%dm%ds' "$m" "$s"
    else printf '%ds' "$s"
    fi
}

# The state of git, cached per session for 5 seconds, because Claude Code runs
# this after every message.
CACHE_FILE="${TMPDIR:-/tmp}/claude-statusline-git-${SESSION_ID}"
if [ ! -f "$CACHE_FILE" ] || [ $(( $(date +%s) - $(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0) )) -gt 5 ]; then
    if git rev-parse --git-dir > /dev/null 2>&1; then
        printf '%s|%s|%s' "$(git branch --show-current 2>/dev/null)" \
            "$(git diff --cached --numstat 2>/dev/null | wc -l)" \
            "$(git diff --numstat 2>/dev/null | wc -l)" > "$CACHE_FILE"
    else
        printf '||' > "$CACHE_FILE"
    fi
fi
IFS='|' read -r BRANCH STAGED MODIFIED < "$CACHE_FILE"
GIT_STR=""
if [ -n "$BRANCH" ]; then
    GIT_STR=" ${GRAY}on${RESET} ${GREEN}${BRANCH}${RESET}"
    [ "${STAGED:-0}" -gt 0 ] && GIT_STR="${GIT_STR} ${GREEN}+${STAGED}${RESET}"
    [ "${MODIFIED:-0}" -gt 0 ] && GIT_STR="${GIT_STR} ${YELLOW}~${MODIFIED}${RESET}"
fi

WT_STR=""
[ -n "$WORKTREE" ] && WT_STR=" ${MAGENTA}[wt:${WORKTREE}]${RESET}"

LABEL_STR=""
if [ -n "$AGENT_NAME" ]; then LABEL_STR=" ${MAGENTA}@${AGENT_NAME}${RESET}"
elif [ -n "$SESSION_NAME" ]; then LABEL_STR=" ${GRAY}(${SESSION_NAME})${RESET}"
fi

# Medium is the default, so it shows nothing.
EFFORT_STR=""
case "$EFFORT" in
    low) EFFORT_STR=" ${GRAY}[low]${RESET}" ;;
    high) EFFORT_STR=" ${YELLOW}[high]${RESET}" ;;
    xhigh) EFFORT_STR=" ${RED}[xhigh]${RESET}" ;;
    max) EFFORT_STR=" ${BOLD}${RED}[MAX]${RESET}" ;;
esac

NOW=$(date +%s)
CLOCK_STR=""
for pair in "${CLOCKS[@]}"; do
    CLOCK_STR="${CLOCK_STR:+$CLOCK_STR | }${pair#*=} $(TZ="${pair%%=*}" date "+%H:%M")"
done
[ -n "$CLOCK_STR" ] && CLOCK_STR=" ${GRAY}$(date "+%a %b %d,") ${CLOCK_STR}${RESET}"

COST_FMT=$(printf '$%.2f' "$COST")
DURATION_SEC=$((DURATION_MS / 1000))

CACHE_STR=""
if [ "${TOTAL_IN:-0}" -gt 0 ] && [ "${CACHE_READ:-0}" -gt 0 ]; then
    CACHE_PCT=$((CACHE_READ * 100 / TOTAL_IN))
    if [ "$CACHE_PCT" -ge 80 ]; then CC="$GREEN"
    elif [ "$CACHE_PCT" -ge 50 ]; then CC="$YELLOW"
    else CC="$RED"
    fi
    CACHE_STR=" ${CC}cache:${CACHE_PCT}%${RESET}"
fi

# Line 1: who and where.
printf '%b\n' "${MODEL_COLOR}${MODEL}${RESET}${EFFORT_STR} ${BLUE}${DIRNAME}${RESET}${GIT_STR}${WT_STR}${LABEL_STR}${CLOCK_STR}"

# Line 2: what it costs.
COMPACT_WARN=""
if [ "$COMPACT_WARN_TOKENS" -gt 0 ] && [ "${CTX_TOKENS:-0}" -ge "$COMPACT_WARN_TOKENS" ]; then
    COMPACT_WARN="${BOLD}${RED}>> compact soon - you're at $((CTX_TOKENS / 1000))k tokens <<${RESET} "
fi
METRICS="${COMPACT_WARN}${BAR_COLOR}${BAR}${RESET} ${PCT}%"
if [ -n "$FIVE_H" ]; then
    METRICS="${METRICS} $(rate_color "$FIVE_H")5h:$(printf '%.0f' "$FIVE_H")%${RESET}"
    [ -n "$FIVE_H_RESET" ] && METRICS="${METRICS}${GRAY}(-$(fmt_until $((FIVE_H_RESET - NOW))))${RESET}"
fi
if [ -n "$SEVEN_D" ]; then
    METRICS="${METRICS} $(rate_color "$SEVEN_D")7d:$(printf '%.0f' "$SEVEN_D")%${RESET}"
    [ -n "$SEVEN_D_RESET" ] && METRICS="${METRICS}${GRAY}(-$(fmt_until $((SEVEN_D_RESET - NOW))))${RESET}"
fi
METRICS="${METRICS} ${YELLOW}${COST_FMT}${RESET} ${GRAY}$((DURATION_SEC / 60))m$((DURATION_SEC % 60))s${RESET}${CACHE_STR}"
printf '%b\n' "$METRICS"
