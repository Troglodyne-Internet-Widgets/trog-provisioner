[%# The records of this domain, included in the fragment of the registrar.
    See publication in Provisioner::Recipe::registrar.

    Queued rather than run here: the provider is reached over the network, and
    the shortcut that holds the credential comes from the lexicon recipe, which
    runs after this one.  The postrun runs after every target, so both are
    settled by the time this goes. -%]
[% IF publish_records -%]
[% script_dir %]/queue_postrun_task [% script_dir %]/publish_dns_records [% IF own_nameserver %]--nameserver [% own_nameserver %] [% END %][% domain %] [% address %][% FOREACH alias IN domain_aliases.sort() %] [% alias %][% END %]
[% END -%]
