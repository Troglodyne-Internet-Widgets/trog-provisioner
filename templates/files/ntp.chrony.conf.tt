# The provisioner generates chrony.conf.  Do not edit it by hand.
[% FOR server IN servers %]
pool [% server %] iburst
[% END -%]

# Step the clock at startup, instead of slewing it, when the offset is large
makestep [% makestep %]

# The file that records how fast the system clock gains or loses time
driftfile /var/lib/chrony/chrony.drift

# The directory for the log files of chrony
logdir /var/log/chrony

# Let the kernel copy the system time to the real-time clock (RTC)
rtcsync

# Ignore a source whose root distance is more than 1.5 seconds
maxdistance 1.5

# Client only: do not serve NTP to other hosts
port 0

# Read the conf.d and sources.d directories that the chrony package ships.
# They exist on chrony 4.0 and newer, and chrony ignores them without these
# two lines.  Put a time source or a setting there, not in this file.
#
# These lines come last, so that a fragment can override the lines above.
confdir /etc/chrony/conf.d
sourcedir /etc/chrony/sources.d
