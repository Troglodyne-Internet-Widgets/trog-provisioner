[%# The collector forwards a copy of each message it receives to this port, and
    this input reads it.  Provisioner::Recipe::grafanasyslog tells why the
    stream comes over a port and not from the files that the collector writes.

    Telegraf uses the two settings below by default.  They are written here
    because they are the contract with the other end.  logcollector sends
    RSYSLOG_SyslogProtocol23Format, which is RFC5424, with octet-counted framing.
    If either one does not match, telegraf logs parse errors that do not name
    the format. -%]
[[inputs.syslog]]
  server = "tcp://127.0.0.1:[% port %]"
  syslog_standard = "RFC5424"
  framing = "octet-counting"
