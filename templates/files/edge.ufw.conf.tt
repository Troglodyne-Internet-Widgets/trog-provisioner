[%# Inbound, the port of the stream proxy, where ufw forwards 443.
    Provisioner::Recipe::edge says why it is not 443 itself. -%]
[edge]
title=Edge
description=The stream proxy, where 443 is forwarded
ports=[% tls_port %]/tcp

[%# Outbound: the guests deny outgoing traffic by default, and
    setup-ufw-rules issues "allow out" for every profile.  Without it, nginx
    cannot reach the ports where a guest listens for this one.  Those are the
    proxy_ports of Provisioner::Recipe::nginx.  The profile also opens the
    ports inbound, where nothing listens. -%]
[edge-upstream]
title=Edge upstreams
description=The ports of the guests behind this edge
ports=8080,8443/tcp

[%# Inbound, the relay for the guests, which postfix binds only to the address
    where they reach this guest.  Outbound, port 25, where the relay delivers
    to the internet.  setup-ufw-rules opens each port of a profile both ways. -%]
[edge-relay]
title=Edge relay
description=The relay that the guests behind this edge send their mail through
ports=[% relay_port %]/tcp

[edge-smtp]
title=Edge SMTP
description=Where the relay delivers mail
ports=25/tcp
