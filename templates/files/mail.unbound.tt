[%# A recursive resolver for SpamAssassin, on an address of its own.  The stub of
    systemd-resolved listens on 127.0.0.53 and 127.0.0.54, and pdns on
    127.0.0.1, so 127.0.0.2 clashes with neither.  The packaged unbound listens
    on 127.0.0.1, so this file names its interface and takes that away.  See
    Asking blocklists from this guest in the POD. -%]
server:
    interface: 127.0.0.2
    port: 53
    access-control: 127.0.0.0/8 allow
    hide-identity: yes
    hide-version: yes
    qname-minimisation: yes
    prefetch: yes
