[%# The ipmap.cfg of the runner: its network, and who administers the guests
    it builds.

    Config::Simple reads this, so the format is fixed.  Each [section] header
    has key=value lines with no quotes.  Config::Simple reads a value with
    commas as a list, so resolvers is written that way.

    No apostrophes in an Xslate comment.  The lexer reads one as the start of
    a string, and takes the template up to the next quote into it. -%]
[ip_pool]
addresses=[% config.addresses %]
cidr=[% config.cidr %]

[ips]
[% FOR name IN config.ips.keys().sort() -%]
[% name %]=[% config.ips.$name %]
[% END -%]

[aliases]
[% FOR name IN config.aliases.keys().sort() -%]
[% name %]=[% config.aliases.$name %]
[% END -%]

[nameservers]
[% FOR name IN config.nameservers.keys().sort() -%]
[% name %]=[% config.nameservers.$name %]
[% END -%]

[global]
basedir=[% config.basedir %]
admin_user=[% config.admin_user %]
admin_email=[% config.admin_email %]
admin_gecos=[% config.admin_gecos %]
gateway=[% config.gateway %]
resolvers=[% config.resolvers %]
dhcp_devname=[% config.dhcp_devname %]
bridge_devname=[% config.bridge_devname %]
ip=[% config.ip %]
[% IF config.transfer_user %]transfer_user=[% config.transfer_user %]
[% END -%]
[% IF config.transfer_ip %]transfer_ip=[% config.transfer_ip %]
[% END -%]
[% IF config.transfer_port %]transfer_port=[% config.transfer_port %]
[% END -%]
