# OpenDMARC configuration
AuthservID mail.[% domain %]
[%# The mail relay in front of this guest writes its SPF verdict under its
    own name, because only the relay saw the client.
    Provisioner::Recipe::mailrelay has the whole account, under SPF. -%]
TrustedAuthservIDs mail.[% domain %][% IF mailrelay %], [% mailrelay %][% END %]

# XXX Do not change UMask or UserID.  With a chrooted postfix, only a 0777
# socket works, and only when opendmarc runs as the opendmarc user.
UMask 000
UserID opendmarc:postfix
PidFile /run/opendmarc/opendmarc.pid
Socket local:/var/spool/postfix/opendmarc/opendmarc.sock
AutoRestart true

RejectFailures true
FailureReports true
Syslog true
SyslogFacility mail

FailureReportsSentBy postmaster@[% domain %]
FailureReportsBcc postmaster@[% domain %]

IgnoreHosts /etc/opendmarc/ignore.hosts

# Check SPF here when no trusted result for it is in the message, which is
# every message from a client that connects here.  Without it, nothing on the
# guest checks SPF, and DMARC passes only on DKIM.
SPFSelfValidate true

PublicSuffixList /usr/share/publicsuffix/effective_tld_names.dat
