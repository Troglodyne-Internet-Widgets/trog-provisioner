# Mail passwd for [% domain %]

[%- FOR user IN names.keys().sort() -%]
[% user %]@[% domain %]:[% names.$user.password | dovecot_password_hash %]:%REPLACEME%:%REPLACEME%:[% names.$user.gecos %]:/mail/[% domain %]/[% user %]:/usr/sbin/noshell

[%- END -%]
catchall@[% domain %]:::::/mail/[% domain %]/catchall:/usr/sbin/noshell
