# The SPF policy service of the mail relay.  It rejects a message whose sender
# fails SPF, and adds nothing to the message: the verdict that the guests behind
# the relay read is the one that opendmarc writes.
# Provisioner::Recipe::mailrelay has the whole account, under SPF.
debugLevel = 1
HELO_reject = Fail
Mail_From_reject = Fail
PermError_reject = False
TempError_Defer = False
skip_addresses = 127.0.0.0/8,::ffff:127.0.0.0/104,::1
Header_Type = None
