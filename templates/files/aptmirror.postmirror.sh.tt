#!/bin/sh
# apt-mirror runs this at the end of a successful sync, because mirror.list
# sets run_postmirror 1.

# apt-mirror writes clean.sh on each run but never runs it, and it ships no
# postmirror.sh.  Without this line, the spool keeps every package that upstream
# ever removed.
[ -x '[% spool %]/var/clean.sh' ] && '[% spool %]/var/clean.sh'

# nginx serves this file as /mirror-status.  It is written last, so it records
# only a sync that finished.
date -Is > '[% spool %]/var/last_sync'
