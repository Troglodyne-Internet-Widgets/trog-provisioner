[%# The ports of the vhost of the homeserver that no profile of the nginx
    package names: federation, and behind a relay the port where the relay
    passes it through.  ntp.ufw.conf.tt says why a recipe opens a port with a
    profile and not with a rule. -%]
[matrix-homeserver]
title=Matrix homeserver
description=Federation and the client API of synapse, through nginx
ports=[% federation_port %][% IF relayed %],[% passthrough_port %][% END %]/tcp
