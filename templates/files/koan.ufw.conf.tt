[%# `default deny outgoing` from the ufw recipe blocks 8448.  A profile
    opens it, because setup-ufw-rules allows every profile that it finds, out
    and in.

    Always rendered.  The fragment installs it only when this bot talks to a
    matrix homeserver. -%]
[koan-matrix]
title=Matrix federation
description=Homeserver federation port koan reaches out to
ports=8448/tcp
