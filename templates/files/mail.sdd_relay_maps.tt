[% IF relay.host %]
[% FOR user IN names.keys().sort() %]
[% user %]@[% domain %]    [[% relay.host %]]:[% relay.port %]
[%- END %]
opendmarc@[% domain %] [[% relay.host %]]:[% relay.port %]
root@[% domain %] [[% relay.host %]]:[% relay.port %]
[% END %]
[% IF edge_relay %]
@[% domain %] [[% edge_relay.address %]]:[% edge_relay.port %]
[% END %]
