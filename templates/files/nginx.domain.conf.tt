[%# nginx reaches a unix socket through an upstream, never through proxy_pass
    directly.  The socket form of proxy_pass needs a URI part, and nginx refuses
    one inside a named location.  There is one block per socket, at http level,
    before any server block that names it. -%]
[% FOR upstream IN upstreams.keys().sort() %]
upstream [% upstream %] {
    server unix:[% upstreams.$upstream %];
}
[% END -%]
[% FOR vhost in vhosts.keys() %]
[% ssl = vhosts.$vhost.ssl ? 'ssl' : '' -%]
[%# ssl_redirect is set per vhost and wins over ssl.  A redirect vhost only
    redirects, whatever else it sets. -%]
[% IF vhosts.$vhost.ssl_redirect %]
server {
    listen [% vhost %][% IF backlog %] backlog=[% backlog %][% END %];
    [% IF vhosts.$vhost.ipv6 %]
    listen [::]:[% vhost %][% IF backlog %] backlog=[% backlog %][% END %];
    [% END -%]
    server_tokens off;

[%# server_name is a list separated by spaces.  It has no www of its own,
    because new_config adds www and mail to the aliases of every domain. -%]
    server_name [% domain %] [% full_aliases.join(' ') %];
    return 301 https://$host$request_uri;
}
[% ELSE -%]
[% auth_statics = vhosts.$vhost.auth_statics -%]
[% auth_uri     = vhosts.$vhost.auth_uri -%]
[% proxy_uri    = vhosts.$vhost.proxy_uri -%]
[%# Relative, because every use below is under install_dir/domain.  There is
    no default.  A vhost serves files only if its recipe says where they are. -%]
[% static_dir   = vhosts.$vhost.static_dir -%]
[% public_dir   = vhosts.$vhost.public_dir %]
[% nocache_prefix = vhosts.$vhost.nocache_prefix -%]
server {
    listen [% vhost %] [% ssl %][% IF backlog %] backlog=[% backlog %][% END %];
    [% IF vhosts.$vhost.ipv6 %]
    listen [::]:[% vhost %] [% ssl %][% IF backlog %] backlog=[% backlog %][% END %];
    [% END -%]

[%# Spaces and no www, as in the redirect vhost above. -%]
    server_name [% domain %] [% full_aliases.join(' ') %];

    ssl_certificate     /etc/ssl/certs/[% domain %].pem;
    ssl_certificate_key /etc/ssl/private/[% domain %].pem;

[% IF static_dir %]
    location / {
        gzip on;
        etag on;
        expires 1d;
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
        root [% install_dir %]/[% domain %]/[% static_dir %];
        try_files $uri $uri.html $uri/index.html @default;
    }
    [% END -%]

    [% IF public_dir %]
    location /[% public_dir %] {
        alias [% install_dir %]/[% domain %]/[% public_dir %];
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
    }
    [% END -%]

    [% IF auth_statics AND auth_uri AND static_dir %]
    location /[% auth_statics %] {
        auth_request [% auth_uri %];
        etag on;
        expires 1d;
        sendfile on;
        tcp_nopush on;
        sendfile_max_chunk 1m;
        root [% install_dir %]/[% domain %]/[% static_dir %];
    }
    location = [% auth_uri %] {
        internal;
        proxy_pass              [% proxy_uri %];
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        X-Original-URI  $request_uri;
        proxy_set_header        X-Forwarded-For $remote_addr;
        proxy_set_header        X-Forwarded-Proto $scheme;
    }
    [% END -%]

    [% IF nocache_prefix AND static_dir %]
    location [% nocache_prefix %] {
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
        root [% install_dir %]/[% domain %]/[% static_dir %];
        try_files $uri @default;
    }
    [% END -%]

[%# Named only when a try_files chain falls back to it.  Without static_dir,
    it is the only location on the vhost.  The upstreams at the top of this file
    say why a socket does not go into proxy_pass here. -%]
    location [% IF static_dir %]@default[% ELSE %]/[% END %] {
        proxy_pass [% proxy_uri %];
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
[% END -%]
[% END -%]
