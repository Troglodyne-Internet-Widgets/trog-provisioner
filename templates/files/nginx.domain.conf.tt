[%# A unix socket reaches nginx through an upstream, never through proxy_pass
    directly: nginx refuses a proxy_pass with a URI part inside a named
    location, and the socket form requires one.  One block per socket, at http
    level, before any server block that names it. -%]
[% FOR upstream IN upstreams.keys().sort() %]
upstream [% upstream %] {
    server unix:[% upstreams.$upstream %];
}
[% END -%]
[% FOR vhost in vhosts.keys() %]
[% ssl = vhosts.$vhost.ssl ? 'ssl' : '' -%]
[%# Per vhost, and ahead of ssl: a redirect vhost is a redirect vhost whatever
    else it says.  This read ssl_redirect from the top level, where callers do
    not put it -- they set it on the vhost, as deluged does for port 80. -%]
[% IF vhosts.$vhost.ssl_redirect %]
server {
    listen [% vhost %][% IF backlog %] backlog=[% backlog %][% END %];
    [% IF ipv6 %]
    listen [::]:[% vhost %][% IF backlog %] backlog=[% backlog %][% END %];
    [% END -%]
    server_tokens off;

[%# Space separated, and no www of its own: server_name is a space separated
    list, so joining with a comma made a server name with a comma stuck to it
    that matches nothing, and new_config already appends www and mail to
    the aliases of every domain -- so naming www here as well made nginx report a
    conflicting server name and ignore the second one. -%]
    server_name [% domain %] [% full_aliases.join(' ') %];
    return 301 https://$host$request_uri;
}
[% ELSE -%]
[% auth_statics = vhosts.$vhost.auth_statics -%]
[% auth_uri     = vhosts.$vhost.auth_uri -%]
[% proxy_uri    = vhosts.$vhost.proxy_uri -%]
[%# Relative: every use below is under install_dir/domain already.  No default:
    a vhost serves files only if the recipe behind it said where they are.  It
    used to fall back to www/, which is where a tpsgi application keeps them and
    nowhere a gogs or a synapse has anything at all -- so a pure proxy got a root
    that did not exist, and nginx logged stat() ... failed (13: Permission
    denied) on it for every request it went on to proxy correctly anyway. -%]
[% static_dir   = vhosts.$vhost.static_dir -%]
[% public_dir   = vhosts.$vhost.public_dir %]
[% nocache_prefix = vhosts.$vhost.nocache_prefix -%]
server {
    listen [% $vhost %] [% ssl %][% IF backlog %] backlog=[% backlog %][% END %];
    [% IF ipv6 %]
    listen [::]:[% vhost %] [% ssl %][% IF backlog %] backlog=[% backlog %][% END %];
    [% END -%]

[%# Space separated, and no www of its own: server_name is a space separated
    list, so joining with a comma made a server name with a comma stuck to it
    that matches nothing, and new_config already appends www and mail to
    the aliases of every domain -- so naming www here as well made nginx report a
    conflicting server name and ignore the second one. -%]
    server_name [% domain %] [% full_aliases.join(' ') %];

    ssl_certificate     /etc/ssl/certs/[% domain %].pem;
    ssl_certificate_key /etc/ssl/private/[% domain %].pem;

[% IF static_dir %]
    location / {
        gzip on;
        etag on;
        expires 1d;
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
        root [% install_dir %]/[% domain %]/[% static_dir %];
        try_files $uri $uri.html $uri/index.html @default;
    }
    [% END -%]

    [% IF public_dir %]
    location /[% public_dir %] {
        alias [% install_dir %]/[% domain %]/[% public_dir %];
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
    }
    [% END -%]

    [% IF auth_statics AND auth_uri AND static_dir %]
    location /[% auth_statics %] {
        auth_request [% auth_uri %];
        etag on;
        expires 1d;
        sendfile on;
        tcp_nopush on;
        sendfile_max_chunk 1m;
        root [% install_dir %]/[% domain %]/[% static_dir %];
    }
    location = [% auth_uri %] {
        internal;
        proxy_pass              [% proxy_uri %];
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        X-Original-URI  $request_uri;
        proxy_set_header        X-Forwarded-For $remote_addr;
        proxy_set_header        X-Forwarded-Proto $scheme;
    }
    [% END -%]

    [% IF nocache_prefix AND static_dir %]
    location [% nocache_prefix %] {
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
        root [% install_dir %]/[% domain %]/[% static_dir %];
        try_files $uri @default;
    }
    [% END -%]

[%# Named only when something falls back to it.  With no statics there is
    nothing to fall through from, so this becomes the only location on the vhost
    rather than the end of a try_files chain -- and nginx refuses a proxy_pass
    with a URI part in a named location, which is why the socket form goes
    through an upstream either way. -%]
    location [% IF static_dir %]@default[% ELSE %]/[% END %] {
        proxy_pass [% proxy_uri %];
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
[% END -%]
[% END -%]
