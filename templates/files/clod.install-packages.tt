#!/usr/bin/perl
[%# Root runs this, for the service user, through sudo with any arguments.
    So the check of the names is all that keeps it narrow.  THE SYSTEM
    PACKAGES in Provisioner::Recipe::clod has the reasons.  perl_string
    quotes each value, so that nothing in it is perl.  The system perl,
    because the perl of the bot is the thing that its packages can change. -%]
# Installs the [% packager %] packages that it is given, and nothing else.
# Generated by Provisioner::Recipe::clod.  Do not edit by hand.
use strict;
use warnings;

# What a plain package name is, from Dist::Conformance, so that this refuses
# what the declaration of a repository may not hold.
our $NAME = [% perl_string(package_name) %];

our @INSTALL = ( [% FOR word IN install_command %][% perl_string(word) %], [% END %]);

sub main {
    my @names = @_;
    my @bad   = grep { !m/$NAME/ } @names;
    if ( !@names || @bad ) {
        print STDERR @names
          ? 'clod-install-packages: not a plain [% packager %] package name: ' . join( ', ', map { "'$_'" } @bad ) . "\n"
          : "clod-install-packages: name the [% packager %] packages to install\n";
        print STDERR "clod-install-packages: installed nothing\n";
        return 2;
    }

    open( STDIN, '<', '/dev/null' ) or die "clod-install-packages: /dev/null: $!\n";
    system { $INSTALL[0] } @INSTALL, @names;
    if ( $? == -1 ) {
        print STDERR "clod-install-packages: could not run $INSTALL[0]: $!\n";
        return 127;
    }
    return $? & 127 ? 128 + ( $? & 127 ) : $? >> 8;
}

exit main(@ARGV) unless caller;
1;
