#!/usr/bin/perl
[%# Root runs this, for the service user, through sudo with any arguments,
    and the service user writes the file of sources.  So the checks here are
    all that keep it narrow.  THE SYSTEM PACKAGES in Provisioner::Recipe::clod
    has the reasons.  perl_string quotes each value, so that nothing in it is
    perl.  The system perl, because the perl of the bot is the thing that its
    packages can change. -%]
# Installs the [% packager %] packages that it is given, from the archives
# that the guest trusts and the sources that it is given, and nothing else.
# Generated by Provisioner::Recipe::clod.  Do not edit by hand.
use strict;
use warnings;

# The apt-get of serial_apt first, so that an install waits for any other apt of
# the guest.  scripts/serial_apt in trog-provisioner says why.
$ENV{PATH} = [% perl_string(script_dir _ '/serial-apt:/usr/sbin:/usr/bin:/sbin:/bin') %];

use File::Temp();
use HTTP::Tiny();
use JSON::PP();

# What a plain package name is, from Dist::Conformance, so that this refuses
# what the declaration of a repository may not hold.
our $NAME = [% perl_string(package_name) %];

our @INSTALL = ( [% FOR word IN install_command %][% perl_string(word) %], [% END %]);

# {sources} in a word stands for the file of the one source to refresh.
our @UPDATE = ( [% FOR word IN update_command %][% perl_string(word) %], [% END %]);

# The files of a source are those that Provisioner::Packager::Deb writes at
# first boot, under this directory.
our $APT   = '/etc/apt';
our @GPG   = ('/usr/bin/gpg');
our $FETCH = sub { return HTTP::Tiny->new( timeout => 30, verify_SSL => 1 )->get( $_[0] ) };

my $ME = 'clod-install-packages';

# One word of printable ASCII, so that nothing ends a line of a file of apt.
my $WORD = qr/\A[!-~]+\z/;
my $URL  = qr{\Ahttps?://[^/\s]+[!-~]*\z};

sub refuse {
    my @why = @_;
    print STDERR map { "$ME: $_\n" } @why, 'installed nothing';
    return 2;
}

my sub words {
    my ( $value, $least, $pattern ) = @_;
    return ref $value eq 'ARRAY' && @$value >= $least && !grep { ref $_ || !defined $_ || $_ !~ $pattern } @$value;
}

# What is wrong with a source, as the source of Provisioner::Packager::Deb
# and the declaration of Dist::Conformance say, or nothing.
sub source_errors {
    my ($source) = @_;
    return 'it is not an object' unless ref $source eq 'HASH';
    my %field = (
        name          => sub { !ref $_[0] && $_[0] =~ m/\A[a-z0-9][a-z0-9.-]*\z/ },
        uri           => sub { !ref $_[0] && $_[0] =~ $URL },
        key           => sub { !ref $_[0] && $_[0] =~ $URL },
        fingerprint   => sub { !ref $_[0] && $_[0] =~ m/\A[0-9A-Fa-f]{40}\z/ },
        suites        => sub { words( $_[0], 1, $WORD ) },
        components    => sub { words( $_[0], 0, $WORD ) },
        architectures => sub { words( $_[0], 0, qr/\A[a-z0-9]+\z/ ) },
        pin           => sub {
            my ($pin) = @_;
            return
                 ref $pin eq 'HASH'
              && !grep( { !m/\A(?:priority|packages)\z/ } keys %$pin )
              && defined $pin->{priority}
              && !ref $pin->{priority}
              && $pin->{priority} =~ m/\A-?[0-9]{1,5}\z/
              && ( !exists $pin->{packages} || ( !ref $pin->{packages} && $pin->{packages} =~ m/\A[!-~]+(?: [!-~]+)*\z/ ) );
        },
    );
    my @errors = map { "it has $_, which a source does not" } grep { !$field{$_} } sort keys %$source;
    push @errors, map { "it has no $_" } grep { !defined $source->{$_} } qw{name uri suites components key fingerprint};
    push @errors, map { "its $_ is not one" } grep { defined $source->{$_} && $field{$_} && !$field{$_}->( $source->{$_} ) } sort keys %$source;
    return @errors;
}

# The primary fingerprints of the keys in $file, as gpg reads them.
sub fingerprints {
    my ($file) = @_;
    my $home = File::Temp->newdir;
    open( my $fh, '-|', @GPG, '--homedir', "$home", qw{--batch --no-tty --with-colons --show-keys}, $file ) or return;
    my ( @fingerprints, $primary );
    while ( my $line = <$fh> ) {
        my @f = split m/:/, $line;
        $primary = 1, next if $f[0] eq 'pub';
        $primary = 0, next if $f[0] eq 'sub';
        push @fingerprints, uc $f[9] if $f[0] eq 'fpr' && $primary;
    }
    close $fh or return;
    return @fingerprints;
}

# The files of a source, as Provisioner::Packager::Deb writes them, with the
# key that $FETCH brought, or what is wrong with the key.
sub source_files {
    my ($source) = @_;
    my $name = $source->{name};
    my $res  = $FETCH->( $source->{key} );
    return "the key of $name, $source->{key}, answered $res->{status}" unless $res->{success};
    my $key     = $res->{content} // '';
    my $armored = $key =~ m/\A\s*-----BEGIN PGP PUBLIC KEY BLOCK-----/;
    return "what $source->{key} answered for $name is not a PGP key" unless $armored || ( length $key && ord($key) & 0x80 );

    my $tmp = File::Temp->new;
    print {$tmp} $key;
    close $tmp or return "$ME could not keep the key of $name: $!";
    my @found = fingerprints("$tmp");
    return "the key of $name at $source->{key} is " . ( @found ? join( ' and ', @found ) : 'none that gpg reads' ) . ", not " . uc $source->{fingerprint}
      unless @found == 1 && $found[0] eq uc $source->{fingerprint};

    my $keyring = "/etc/apt/keyrings/$name." . ( $armored ? 'asc' : 'gpg' );
    my @lines   = (
        'Types: deb',
        "URIs: $source->{uri}",
        'Suites: ' . join( ' ', @{ $source->{suites} } ),
        'Components: ' . join( ' ', @{ $source->{components} } ),
        ( $source->{architectures} ? 'Architectures: ' . join( ' ', @{ $source->{architectures} } ) : () ),
        "Signed-By: $keyring",
    );
    my %files = ( $keyring => $key, "/etc/apt/sources.list.d/$name.sources" => join( "\n", @lines ) . "\n" );
    if ( my $pin = $source->{pin} ) {
        my ($host) = $source->{uri} =~ m{\Ahttps?://(?:[^/\@]*\@)?([^/:]+)};
        $files{"/etc/apt/preferences.d/$name.pref"} = 'Package: ' . ( $pin->{packages} // '*' ) . "\nPin: origin \L$host\E\nPin-Priority: $pin->{priority}\n";
    }
    return \%files;
}

# The exit of a command, as a shell gives it.
sub run {
    my @command = @_;
    system { $command[0] } @command;
    if ( $? == -1 ) {
        print STDERR "$ME: could not run $command[0]: $!\n";
        return 127;
    }
    return $? & 127 ? 128 + ( $? & 127 ) : $? >> 8;
}

sub main {
    my @names = @_;
    my $sources_file;
    if ( @names && $names[0] eq '--sources-file' ) {
        ( undef, $sources_file, @names ) = @names;
        return refuse('--sources-file names no file') unless defined $sources_file;
    }

    my @bad = grep { !m/$NAME/ } @names;
    return refuse("not a plain [% packager %] package name: " . join( ', ', map { "'$_'" } @bad )) if @bad;
    return refuse('name the [% packager %] packages to install') unless @names;

    my @sources;
    if ( defined $sources_file ) {
        open( my $fh, '<', $sources_file ) or return refuse("cannot read $sources_file: $!");
        return refuse("$sources_file is not a file") unless -f $fh;
        my %named;
        while ( my $line = <$fh> ) {
            next unless $line =~ m/\S/;
            my $source = eval { JSON::PP->new->decode($line) };
            my @why    = defined $source ? source_errors($source) : ('it is not JSON');
            return refuse( map { "the source on line $. of $sources_file: $_" } @why ) if @why;
            return refuse("the source on line $. of $sources_file is the second named $source->{name}") if $named{ $source->{name} }++;
            push @sources, $source;
        }
        close $fh;
    }

    # Every key is checked, and every file compared, before anything changes.
    my ( %write, @why );
    foreach my $source (@sources) {
        my $files = source_files($source);
        push( @why, $files ), next unless ref $files;
        foreach my $path ( sort keys %$files ) {
            my $at = $APT . substr( $path, length '/etc/apt' );
            next unless -e $at;
            my $was = do { local $/; my $in; open( $in, '<', $at ) ? <$in> : undef };
            push @why, "$path is there already, and is not what the source $source->{name} would write" unless defined $was && $was eq $files->{$path};
        }
        %write = ( %write, %$files );
    }
    return refuse(@why) if @why;

    foreach my $path ( sort keys %write ) {
        my $at  = $APT . substr( $path, length '/etc/apt' );
        my ($dir) = $at =~ m{\A(.*)/};
        -d $dir or mkdir( $dir, 0755 ) or die "$ME: could not make $dir: $!\n";
        my $tmp = File::Temp->new( DIR => $dir, UNLINK => 0 );
        print {$tmp} $write{$path};
        close $tmp or die "$ME: could not write $at: $!\n";
        chmod 0644, "$tmp" or die "$ME: could not chmod $at: $!\n";
        rename "$tmp", $at or die "$ME: could not write $at: $!\n";
    }
    foreach my $source (@sources) {
        my $file   = "$APT/sources.list.d/$source->{name}.sources";
        my $status = run( map { s/\{sources\}/$file/gr } @UPDATE );
        return $status if $status;
    }

    open( STDIN, '<', '/dev/null' ) or die "$ME: /dev/null: $!\n";
    return run( @INSTALL, @names );
}

exit main(@ARGV) unless caller;
1;
