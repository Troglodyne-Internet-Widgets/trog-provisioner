# Generated by Provisioner::Recipe::ossec.  The manager sends each alert as
# JSON in the message of a syslog point.  This makes the level, the rule, the
# rule groups and the guest into tags, and the rest into fields, so that a
# dashboard can group by them.

load("json.star", "json")

def apply(metric):
    raw = metric.fields.get("message")
    if type(raw) != "string" or not raw.startswith("{"):
        return metric
    alert = json.decode(raw)
    if type(alert) != "dict":
        return metric

    # crit is the level of the rule, from 0 to 15.
    if "crit" in alert:
        metric.tags["ossec_level"] = str(alert["crit"])
    if "id" in alert:
        metric.tags["ossec_rule"] = str(alert["id"])

    # " syslog,sshd,authentication_success," with the spaces and the empty
    # names taken out.
    groups = [g.strip() for g in str(alert.get("classification", "")).split(",")]
    groups = [g for g in groups if g]
    if groups:
        metric.tags["ossec_groups"] = ",".join(groups)

    # "guest->127.0.0.1": the guest that logged the line, then where the
    # manager read it.  The hostname tag of the point is the collector.
    component = alert.get("component")
    if type(component) == "string":
        metric.tags["ossec_host"] = component.split("->")[0]

    for k in ["description", "src_ip", "acct"]:
        v = alert.get(k)
        if type(v) == "string":
            metric.fields["ossec_" + k] = v
    if type(alert.get("message")) == "string":
        metric.fields["ossec_log"] = alert["message"]
    return metric
