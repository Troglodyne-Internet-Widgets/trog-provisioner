# >> file 2>&1, not &>>.  cron runs a job with /bin/sh, which is dash here,
# and dash reads &>> as a background & followed by a redirection -- so the
# backup ran detached with nothing captured, and cron recorded a success the
# instant it was started rather than when it finished, or failed.
[% FOREACH backuphost IN hosts %]
# Backup at midnight every day.
0 0 * * * root command [% script_dir %]/backup.sh [% backuphost %] "[% base_dir %]" "[% install_dir %]/[% domain %]/[% key_file %]" [% host_port_map.$backuphost %] [% targets.join(' ') %] >> /var/log/backups/[% backuphost %].log 2>&1
# Run the retention script every friday at noon.
0 12 * * 5 root command [% script_dir %]/retention.sh [% backuphost %] "[% base_dir %]" >> /var/log/backups/[% backuphost %].log 2>&1
[% END %]
