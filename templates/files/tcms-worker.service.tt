[%# The Minion worker of tCMS, which transcodes the videos that users upload.
    Provisioner::Recipe::tcms says why it starts after the service of tPSGI. -%]
[% home = install_dir _ '/' _ domain -%]
[Unit]
Description=tCMS job worker ([% domain %])
After=network-online.target [% domain %].service
Wants=network-online.target [% domain %].service

[Service]
Type=simple
User=[% user %]
Group=[% user %]
# The paths of tCMS are relative to its install root.
WorkingDirectory=[% home %]/tCMS
Environment=HOME=[% home %]
Environment=PATH=/opt/perl5/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/perl5/current/bin/perl bin/tcms-jobs minion worker -j [% worker_jobs %]
# On TERM the worker takes no new job and stops when its jobs finish.  A
# transcode can run for hours, and a job that is killed fails.  mixed sends the
# TERM to the worker alone, where the default sends it to every job.
KillMode=mixed
TimeoutStopSec=300
Restart=on-failure
RestartSec=10

[Install]
# tPSGI pulls the worker in when it starts.  See THE JOB WORKER in
# Provisioner::Recipe::tcms.
WantedBy=[% domain %].service
