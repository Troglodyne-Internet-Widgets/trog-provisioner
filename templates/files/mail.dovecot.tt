[% UNLESS ipv6 %]listen = *
[% END -%]mail_home = /mail/%Ld/%Ln
mail_location = maildir:/mail/%Ld/%Ln/Maildir:UTF-8
postmaster_address = postmaster@mail.[% domain %]

first_valid_uid=1
first_valid_gid=1

mail_uid=dovecot
mail_gid=dovecot

# Enable Maildir++ quota support.
mail_plugins = $mail_plugins quota

# Take the quota limits from the maildirsize file.  If the file does not
# exist, do not enforce a quota.
plugin {
  quota = maildir:User quota
  quota_grace = 0
}

plugin {
    quota_warning  = storage=95%% quota-warning %u
}

service quota-warning {
    executable = script /mail/scripts/dovecot_overquota
    user = dovecot
    unix_listener quota-warning {
        user = dovecot
    }
}

# Junk, for every account, with the special use that mail clients look for
# (RFC 6154).  The sieve below files spam there.
namespace inbox {
  inbox = yes
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
}

# Sieve.  The spam filter runs before the sieve of each user.
plugin {
  sieve_before = /etc/dovecot/sieve/junk.sieve
}
protocol lda {
  mail_plugins = $mail_plugins sieve
}
protocol lmtp {
  mail_plugins = $mail_plugins sieve
}

# SSL for the whole server
ssl_cert = </etc/ssl/certs/[% domain %].pem
ssl_key =  </etc/ssl/private/[% domain %].pem
ssl = required
disable_plaintext_auth = yes

# LMTPD
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
     user = postfix
     group = postfix
     mode = 0600
  }
}

# SASL
service auth {
    unix_listener /var/spool/postfix/private/auth {
        mode = 0660
        user = postfix
        group = postfix
    }   
}
auth_mechanisms = plain login
