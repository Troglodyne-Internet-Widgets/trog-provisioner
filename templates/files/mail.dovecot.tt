[% UNLESS ipv6 %]listen = *
[% END -%]mail_home = /mail/%Ld/%Ln
mail_location = maildir:/mail/%Ld/%Ln/Maildir:UTF-8
postmaster_address = postmaster@mail.[% domain %]

first_valid_uid=1
first_valid_gid=1

mail_uid=dovecot
mail_gid=dovecot

# Enable Maildir++ quota support, and the aliases of folders (see below).
mail_plugins = $mail_plugins quota mailbox_alias

# Take the quota limits from the maildirsize file.  If the file does not
# exist, do not enforce a quota.
plugin {
  quota = maildir:User quota
  quota_grace = 0
}

plugin {
    quota_warning  = storage=95%% quota-warning %u
}

service quota-warning {
    executable = script /mail/scripts/dovecot_overquota
    user = dovecot
    unix_listener quota-warning {
        user = dovecot
    }
}

# The folders for sent mail, deleted mail, spam and drafts, named as classic
# Outlook names them, each with the special use that other clients look for
# (RFC 6154).  Most clients use the folder that has the special use, whatever
# its name.  Outlook ignores the use and uses its own names.  So with these
# names, every client uses the same four folders.  Every account has them,
# subscribed.  The sieve below files spam into Junk Email.
#
# scripts/sa_train_amavis reads these uses from dovecot, and learns neither
# Sent Items, Deleted Items nor Drafts as ham.  So a folder that is renamed
# changes its name here and nowhere else.
namespace inbox {
  inbox = yes
  mailbox "Sent Items" {
    special_use = \Sent
    auto = subscribe
  }
  mailbox "Deleted Items" {
    special_use = \Trash
    auto = subscribe
  }
  mailbox "Junk Email" {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
}

# The names that other clients make are aliases of the folders above, so that a
# client with its own name reaches the same messages.  The plugin makes its
# "new" name a link to its "old" name, which is the real folder, and keeps one
# index for the two.  So the real folder is the "old" name here, and the alias
# is the "new" one.  A link that is made by hand shows the messages under two
# sets of UIDs.  The plugin can alias only a name that is not a real folder, so
# the build first moves the messages of a real folder under an alias name into
# its target.
[%# mark_raw, because Xslate escapes for HTML, and a folder named Spam & Ham
    would reach this file as Spam &amp; Ham.  The schema of mailbox_aliases
    refuses a quote, a percent sign, a dollar sign, a backslash, a slash, a dot
    and a line break, so what is left is safe in this file. -%]
plugin {
[% FOR alias IN mailbox_aliases.keys().sort() -%]
  mailbox_alias_old[% loop.count == 1 ? '' : loop.count %] = [% mailbox_aliases.$alias | mark_raw %]
  mailbox_alias_new[% loop.count == 1 ? '' : loop.count %] = [% alias | mark_raw %]
[% END -%]
}

# Sieve.  The spam filter runs before the sieve of each user.  The scripts of a
# user are in ~/sieve, where ManageSieve keeps them, and ~/.dovecot.sieve is a
# link to the active one.
plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
  sieve_before = /etc/dovecot/sieve/junk.sieve
}
protocol lda {
  mail_plugins = $mail_plugins sieve
}
protocol lmtp {
  mail_plugins = $mail_plugins sieve
}

# ManageSieve, with which Roundcube edits the scripts of a user.  On loopback
# only, because Roundcube is on this guest and nothing outside needs it.
service managesieve-login {
  inet_listener sieve {
    address = 127.0.0.1[% IF ipv6 %], ::1[% END %]
    port = 4190
  }
}

# SSL for the whole server
ssl_cert = </etc/ssl/certs/[% domain %].pem
ssl_key =  </etc/ssl/private/[% domain %].pem
ssl = required
disable_plaintext_auth = yes

# IMAP and POP3 over TLS as a mail relay passes them, with the PROXY protocol,
# so that dovecot sees the real client.  It believes the header only from the
# networks in proxy_from.conf, which the fragment of each domain behind a relay
# writes.  Provisioner::Recipe::mail has the whole account, under Sending
# through a mail relay.
service imap-login {
  inet_listener imaps_proxy {
    port = [% proxied_ports.imaps %]
    ssl = yes
    haproxy = yes
  }
}
service pop3-login {
  inet_listener pop3s_proxy {
    port = [% proxied_ports.pop3s %]
    ssl = yes
    haproxy = yes
  }
}
!include_try /etc/dovecot/proxy_from.conf

# LMTPD
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
     user = postfix
     group = postfix
     mode = 0600
  }
}

# SASL
service auth {
    unix_listener /var/spool/postfix/private/auth {
        mode = 0660
        user = postfix
        group = postfix
    }   
}
auth_mechanisms = plain login
# Log why a login fails, never the password.
auth_verbose = yes
