[%# Read by influxdb.service, which carries EnvironmentFile=-/etc/default/influxdb.
    The package ships no such file, so this one is ours rather than an edit of
    somebody else configuration.

    INFLUXDB_ variables override the matching setting in influxdb.conf, which
    means the 19KB packaged config is left exactly as it came.  Measured against
    influxd itself: with nothing set it reports bind-address = ":8086", every
    interface, and with this set it reports 127.0.0.1:8086. -%]
INFLUXDB_HTTP_BIND_ADDRESS=127.0.0.1:8086
