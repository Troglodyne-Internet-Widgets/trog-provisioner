# Generated by Provisioner::Recipe::grafanaotel.  The OTLP input stores the
# attributes of an event as one JSON string, which InfluxQL cannot look into.
# This makes each attribute a field, or a tag for the ones that a dashboard
# groups by, and moves the details into a point of their own, which expires
# first.  See "The details expire first" in that module.

load("json.star", "json")

DETAIL = [[% FOR f IN detail_fields %]"[% f %]", [% END %]]
TAGS = [[% FOR f IN tag_fields %]"[% f %]", [% END %]]
COPIED = [[% FOR f IN copied_fields %]"[% f %]", [% END %]]
SCALAR = ["string", "int", "float", "bool"]

def value(v):
    if type(v) in SCALAR:
        return v
    return json.encode(v)

def apply(metric):
    raw = metric.fields.get("attributes")
    if type(raw) != "string":
        return metric
    attrs = json.decode(raw)
    if type(attrs) != "dict":
        return metric
    metric.fields.pop("attributes")

    details = {}
    for k, v in attrs.items():
        if v == None:
            continue
        if k in DETAIL:
            details[k] = value(v)
        elif k in TAGS:
            metric.tags[k] = str(v)
        else:
            metric.fields[k] = value(v)
    if not details:
        return metric

    detail = Metric("logs_detail")
    for k, v in metric.tags.items():
        detail.tags[k] = v
    for k in COPIED:
        if k in metric.fields:
            detail.fields[k] = metric.fields[k]
    for k, v in details.items():
        detail.fields[k] = v

    # The output of the grafana recipe reads this tag, and does not store it.
    detail.tags["influxdb_retention_policy"] = "details"
    detail.time = metric.time
    return [metric, detail]
