[%# In the main context, because a stream block cannot be inside http.  The
    file goes into modules-enabled, the one directory that nginx.conf includes
    there, after the module that it needs.  Provisioner::Recipe::nginxrelay has
    the whole account. -%]
stream {
    # 64 is too small for a long name.  See nginxrelay.http.conf.
    map_hash_bucket_size 256;

    map $ssl_preread_server_name $relay_tls {
        include /etc/nginx/nginxrelay.d/*.tls.map;
    }

    server {
        listen [% tls_port %];
        ssl_preread on;
        proxy_protocol on;
        proxy_pass $relay_tls;
    }
}
