#!/bin/bash
# Give a single-node Garage cluster its layout, and create the configured
# buckets.  You can run it more than one time.  It changes only what is missing.

set -euo pipefail

GARAGE=/usr/local/bin/garage

wait_for_garage() {
    local retries=30
    echo "Waiting for Garage to become ready..."
    while ! $GARAGE node id -q >/dev/null 2>&1; do
        retries=$((retries - 1))
        if [ "$retries" -le 0 ]; then
            echo "ERROR: Garage failed to start within 60 seconds" >&2
            exit 1
        fi
        sleep 2
    done
    echo "Garage is up."
}

wait_for_garage

# If the layout does not show the zone yet, assign this node to it.
if ! $GARAGE layout show 2>/dev/null | grep -qF '[% zone %]'; then
    # `node id -q` prints <id>@<host>:<port>.  `layout assign` wants only the
    # id, and answers "0 nodes match" when it gets the whole string.
    NODE_ID=$($GARAGE node id -q 2>/dev/null | head -n1 | cut -d@ -f1)
    echo "Assigning node $NODE_ID to zone [% zone %] with capacity [% capacity %]"
    $GARAGE layout assign -z '[% zone %]' -c '[% capacity %]' "$NODE_ID"
    $GARAGE layout apply --version 1
    echo "Layout applied."
else
    echo "Layout already configured for zone [% zone %]."
fi

# Create each configured bucket that does not exist.
[% FOR bucket IN buckets %]
if $GARAGE bucket info '[% bucket %]' 2>/dev/null | grep -q 'Bucket:'; then
    echo "Bucket [% bucket %] already exists."
else
    $GARAGE bucket create '[% bucket %]'
    echo "Bucket [% bucket %] created."
fi
[% END %]

echo "Garage initialisation complete."
