Subject: [PATCH] Allow lexicon providers to define their acceptable record types

The parser took only the types A, AAAA, CNAME, MX, NS, SOA, TXT, SRV and
LOC, for every provider.  PowerDNS takes any type, as RFC 3597 describes.
So the parser takes any type, and each provider names the types that it
takes in VALID_TYPES, which defaults to the same list.  The powerdns
provider sets an empty list, which takes any type, on its own class, so
that every other provider keeps its list.

This is dns-lexicon/dns-lexicon#54, as reworked for review.

---
--- a/usr/lib/python3/dist-packages/lexicon/_private/parser.py
+++ b/usr/lib/python3/dist-packages/lexicon/_private/parser.py
@@ -27,7 +27,6 @@
         "type",
         help="specify the entry type",
         default="TXT",
-        choices=["A", "AAAA", "CNAME", "MX", "NS", "SOA", "TXT", "SRV", "LOC"],
     )
 
     parser.add_argument("--name", help="specify the record name")
--- a/usr/lib/python3/dist-packages/lexicon/interfaces.py
+++ b/usr/lib/python3/dist-packages/lexicon/interfaces.py
@@ -65,6 +65,27 @@
         self.domain = str(self.config.resolve("lexicon:domain"))
         self.domain_id = None
 
+        # Check the type is valid for the given provider.
+        rtype = self._get_lexicon_option("type")
+        if rtype and self.VALID_TYPES and rtype not in self.VALID_TYPES:
+            raise ValueError(
+                f"{rtype} records are not supported by {self.provider_name}"
+            )
+
+    # The record types that the provider takes.  A provider overrides it in its
+    # own class, and an empty list takes any type.
+    VALID_TYPES: list[str] = [
+        "A",
+        "AAAA",
+        "CNAME",
+        "MX",
+        "NS",
+        "SOA",
+        "TXT",
+        "SRV",
+        "LOC",
+    ]
+
     # Provider API: instance methods
 
     @abstractmethod
--- a/usr/lib/python3/dist-packages/lexicon/_private/providers/powerdns.py
+++ b/usr/lib/python3/dist-packages/lexicon/_private/providers/powerdns.py
@@ -43,6 +43,9 @@
 class Provider(BaseProvider):
     """Provider class for PowerDNS"""
 
+    # PowerDNS takes any type of record, as RFC 3597 describes.
+    VALID_TYPES: list[str] = []
+
     @staticmethod
     def get_nameservers() -> List[str]:
         return []
