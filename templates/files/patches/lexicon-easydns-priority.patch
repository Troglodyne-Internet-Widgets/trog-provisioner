Subject: [PATCH] Send the priority of an easyDNS MX or SRV record in prio

easyDNS keeps the priority of an MX or SRV record in a field of its own,
"prio".  lexicon always sent a prio of 0, and sent the whole content as the
rdata, so "10 mail.example.com." went up as an rdata that easyDNS does not
take, and --priority went nowhere.

The priority now comes from --priority, or else from the front of the
content, which then holds the whole RDATA as it does for the powerdns
provider.  The rdata of an MX is its target alone.  The rdata of an SRV is
its whole RDATA, priority included, as the easyDNS console writes it.  An
SRV whose rdata lacks its priority is malformed, and easyDNS then publishes
no change to the zone at all.  A record that easyDNS lists gets the priority
of an MX in front of its content again, so that a list matches what was
created.  This is the convention of dns-lexicon/dns-lexicon#102 for porkbun.

---
--- a/usr/lib/python3/dist-packages/lexicon/_private/providers/easydns.py
+++ b/usr/lib/python3/dist-packages/lexicon/_private/providers/easydns.py
@@ -51,12 +51,13 @@ class Provider(BaseProvider):
     # Create record. If record already exists with the same content, do nothing'
 
     def create_record(self, rtype, name, content):
+        priority, content = self._split_priority(rtype, content)
         record = {
             "type": rtype,
             "domain": self.domain_id,
             "host": self._relative_name(name),
             "ttl": self._get_lexicon_option("ttl"),
-            "prio": 0,
+            "prio": priority,
             "rdata": content,
         }
         try:
@@ -84,7 +85,7 @@ class Provider(BaseProvider):
                 "type": record["type"],
                 "name": f"{record['host']}.{record['domain']}",
                 "ttl": record["ttl"],
-                "content": record["rdata"],
+                "content": self._join_priority(record),
                 "id": record["id"],
             }
             records.append(processed_record)
@@ -109,7 +110,9 @@ class Provider(BaseProvider):
         if name:
             data["host"] = self._relative_name(name)
         if content:
-            data["rdata"] = content
+            priority, data["rdata"] = self._split_priority(rtype, content)
+            if rtype in ("MX", "SRV"):
+                data["prio"] = priority
 
         self._post(f"/zones/records/{identifier}", data)
 
@@ -137,6 +140,32 @@ class Provider(BaseProvider):
 
     # Helpers
 
+    # easyDNS keeps the priority of an MX or SRV record in "prio".  The content
+    # of such a record is its whole RDATA, with the priority in front, as in
+    # "10 mail.example.com.", unless --priority gives the priority.  The rdata
+    # of an MX is its target alone, but the rdata of an SRV is its whole RDATA,
+    # priority included, as the easyDNS console writes it.
+    def _split_priority(self, rtype, content):
+        priority = self._get_lexicon_option("priority")
+        if rtype == "SRV" and content:
+            if priority is not None:
+                return int(priority), f"{priority} {content}"
+            first = content.partition(" ")[0]
+            return int(first) if first.isdigit() else 0, content
+        if priority is None and rtype == "MX" and content:
+            first, _, rest = content.partition(" ")
+            if rest and first.isdigit():
+                return int(first), rest
+        return int(priority) if priority else 0, content
+
+    # The content of a record that easyDNS lists, with the priority of an MX
+    # in front again, so that the content reads as it was given.  The rdata of
+    # an SRV holds its priority already.
+    def _join_priority(self, record):
+        if record["type"] == "MX" and record.get("prio") is not None:
+            return f"{record['prio']} {record['rdata']}"
+        return record["rdata"]
+
     def _request(self, action="GET", url="/", data=None, query_params=None):
         if data is None:
             data = {}
