# io_uring, and which processes can ask the kernel for one.
#
# 0 lets every process create io_uring instances, which is the kernel default.
# 1 refuses unprivileged processes outside the group below.  2 refuses all
# processes, CAP_SYS_ADMIN included.
#
# The group has an effect only at 1.  The kernel ignores it at 0 and 2.  It is
# here anyway, so a change of mode is a one-line edit.
#
# The makefile fragment fills in %IO_URING_GID%.  This setting takes a gid, not
# a name, and the gid is known only on the guest.
kernel.io_uring_disabled = [% mode %]
kernel.io_uring_group = %IO_URING_GID%
