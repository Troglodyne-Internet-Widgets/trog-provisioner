#!/bin/sh
# Generated by Provisioner::Recipe::clod.  remote_prepare runs this before a
# salvage.  The worker writes the database all the time, so a plain copy can
# take half of a transaction, and .backup does not.
set -e
install -d -o root -g root -m 0700 '[% install_dir %]/[% domain %]/.clod-salvage'
sqlite3 '[% install_dir %]/[% domain %]/clod-state/minion.db' ".backup '[% install_dir %]/[% domain %]/.clod-salvage/minion.db'"
