[%# An application profile, not a `ufw allow`.  The ufw target runs after
    this one and starts with a `ufw reset`.  setup-ufw-rules then allows each
    profile that `ufw app list` shows, in and out.

    The section is slapd, not ldap.  ufw skips a profile whose name is also in
    /etc/services, and only prints a warning on stderr:

        WARN: Skipping .ldap.: also in /etc/services

    The file is still called ldap, because the slapd package owns
    /etc/ufw/applications.d/slapd for its own two profiles. -%]
[slapd]
title=LDAP directory
description=OpenLDAP directory server, on the port this domain configured
ports=[% port %]/tcp
