# Generated by Provisioner::Recipe::claude.  Do not edit by hand.
# The bell and the state badge of Claude Code.  /etc/tmux.conf sources this
# file, and tmux reads ~/.tmux.conf after it, so a setting there wins.

# Flag a window whose pane rings the bell, as claude-tmux-state does when a
# session is blocked or done.
setw -g monitor-bell on
set -g bell-action other
set -g visual-bell off
setw -g window-status-bell-style 'fg=black,bg=yellow,bold'

# The badge, from the window option @claude_state: a red dot while working, a
# white ! on red while blocked, a yellow check when done and not yet seen.
# 256-colour codes, because terminal themes remap the named ANSI colours.  The
# dot and the check are \u escapes, which tmux reads only in double quotes.
set -g @claude_badge "#{?#{==:#{@claude_state},working},#[fg=colour196] \u25CF #[default],#{?#{==:#{@claude_state},blocked},#[fg=colour231#,bg=colour196#,bold] ! #[default],#{?#{==:#{@claude_state},done},#[fg=colour226] \u2713 #[default],}}}"
setw -g window-status-format '#I:#W#{?window_flags,#{window_flags}, }#{E:@claude_badge}'
setw -g window-status-current-format '#I:#W#{?window_flags,#{window_flags}, }#{E:@claude_badge}'

# Looking at a finished window marks it seen.
set-hook -g session-window-changed 'if -F "#{==:#{@claude_state},done}" "set -w @claude_state idle"'

# prefix+O: every window with its Claude state and since when.  Enter jumps.
bind O choose-tree -Zw -F '#{?window_format,#{p8:#{?@claude_state,#{@claude_state},-}} #{p6:#{@claude_since}} #{pane_title},}'
