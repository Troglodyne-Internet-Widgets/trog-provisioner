#!/bin/bash
# PostgreSQL logical backup.  Cron runs it every night, and it keeps the seven
# newest dumps.  It dumps the global objects (roles and tablespaces) once.  Then
# it dumps each database in parallel with pg_dump --format=directory, which also
# works in parallel across tables.
set -euo pipefail

DUMP_BASE=/var/backups/postgres
DATE=$(date +%Y%m%d-%H%M%S)
DEST="$DUMP_BASE/$DATE"
JOBS=$(nproc)

# Owned by postgres, because pg_dump runs as postgres and writes into it.  0755,
# because a rebuild reads it back as the admin user over sftp, with no sudo.
# The chmod at the end does the same for what pg_dump makes.
install -d -m 0755 -o postgres -g postgres "$DEST"

# Global objects: roles, tablespaces, passwords
sudo -u postgres pg_dumpall --globals-only | pigz > "$DEST/globals.sql.gz"

dump_db() {
    local db="$1"
    # Directory format writes one file per table, so pg_restore --table works.
    sudo -u postgres pg_dump --format=directory --jobs="$JOBS" \
        --file="$DEST/$db" "$db"
}

export -f dump_db
export DEST JOBS

# All user databases: not the templates, and not the postgres database
DBS=$(sudo -u postgres psql -tAc \
    "SELECT datname FROM pg_database WHERE datistemplate=false AND datname NOT IN ('postgres')")

echo "$DBS" | xargs -P "$JOBS" -I{} bash -c 'dump_db "$@"' _ {}

# pg_dump makes a directory-format dump 0700.  bin/new_config fetches it over
# sftp as the admin user, with no sudo.  If only postgres can read the dump, the
# rebuild comes up empty.
chmod -R a+rX "$DEST"

# Written last, so it exists only if everything above worked.  It tells
# postgres-restore.sh that the dump is whole.  The restore never writes over a
# database that exists, so a database restored from half a dump stays half.
: > "$DEST/complete"

# Keep only the 7 newest dated backup directories
ls -1dt "$DUMP_BASE"/[0-9]* 2>/dev/null | tail -n +8 | xargs -r rm -rf

echo "PostgreSQL backup complete: $DEST"
