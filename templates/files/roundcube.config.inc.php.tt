<?php
$config = [];
$config['log_driver'] = 'syslog';
$config['db_dsnw'] = 'sqlite:///[% install_dir -%]/webmail.[% domain -%]_data/roundcube.db?mode=0640';
// Roundcube reaches dovecot and postfix on this guest, not through the public
// name.  Behind a relay, mail.[% domain %] is the relay, which passes 993 and 465
// and nothing on 143, 587 or 4190.  The certificate names mail.[% domain %] and
// not localhost, so the peer name is given for the check.  ManageSieve listens
// on loopback only.
$config['imap_host'] = 'tls://localhost:143';
$config['smtp_host'] = 'tls://localhost:587';
$config['managesieve_host'] = 'tls://localhost:4190';
$tls_options = [
    'ssl' => [
        'verify_peer'      => true,
        'verify_peer_name' => true,
        'peer_name'        => 'mail.[% domain %]',
    ],
];
$config['imap_conn_options'] = $tls_options;
$config['smtp_conn_options'] = $tls_options;
$config['managesieve_conn_options'] = $tls_options;
$config['smtp_user'] = '%u';
$config['smtp_pass'] = '%p';
$config['support_url'] = 'https://mail.[% domain %]/support';
$config['product_name'] = 'Roundcube Webmail';
$config['des_key'] = '[% des_key -%]';
$config['skin'] = 'elastic';
$config['plugins'] = [
    'archive',
    'managesieve',
    'zipdownload',
];
?>
