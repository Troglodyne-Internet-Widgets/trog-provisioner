[%# The vhost of the homeserver.  Provisioner::Recipe::matrix says which names
    it answers for.  Behind a relay, server_name comes in the file of the proxy
    that it includes, so homeserver_names leaves it out. -%]
[% IF relayed -%]
[%# A name that no vhost answers for on the port of the relay gets no
    handshake, as on 8443.  See Provisioner::Recipe::nginx. -%]
server {
    listen [% passthrough_port %] ssl proxy_protocol default_server;
    ssl_reject_handshake on;
}

[% END -%]
server {
    listen 443 ssl;
    listen [% federation_port %] ssl;
[% IF ipv6 %]    listen [::]:443 ssl;
    listen [::]:[% federation_port %] ssl;
[% END -%]
[% IF relayed %]    listen [% passthrough_port %] ssl proxy_protocol;
[% END -%]
    server_name [% homeserver_names.join(' ') %];
    include /etc/nginx/proxied/matrix.[% domain %].443.conf*;
    server_tokens off;

    ssl_certificate     /etc/ssl/certs/[% domain %].pem;
    ssl_certificate_key /etc/ssl/private/[% domain %].pem;

[%# The max_upload_size of synapse, which is 50M unless it says otherwise.
    nginx refuses a body over 1m by default. -%]
    client_max_body_size 50m;

    location = /.well-known/matrix/server {
        default_type application/json;
        return 200 '{"m.server": "[% server_name %]:[% federation_port %]"}';
    }

[%# Web clients read this from another origin. -%]
    location = /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        return 200 '{"m.homeserver": {"base_url": "https://[% server_name %]:[% federation_port %]"}}';
    }

    location / {
        proxy_pass http://127.0.0.1:8008;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
[% IF ipv6 %]    listen [::]:80;
[% END -%]
    server_name [% homeserver_names.join(' ') %];
    include /etc/nginx/proxied/matrix.[% domain %].80.conf*;
    return 301 https://$host$request_uri;
}
