#!/bin/bash

# Put a salvaged MariaDB dump into a server that was just built.
#
#     mariadb-restore.sh <salvaged dump directory>
#
# The directory is what remote_files fetched: /var/backups/mysql from the guest
# that this one replaces.  mariadb-backup.sh lays it out as
# <timestamp>/<database>/<table>.sql.gz, with the views, routines and grants
# beside the tables.
#
# This script creates a database that is not there, and never writes into one
# that is.  scripts/restore_state follows the same rule for files.  See
# "Naming a path is not enough" in Provisioner::Recipe.  A rebuilt server has
# none of the databases and gets all of them.  A live server has all of them and
# gets nothing.
set -euo pipefail
shopt -s nullglob

SALVAGED="${1:?usage: mariadb-restore.sh <salvaged dump directory>}"

# The accounts that this server made for itself.  The accounts of the last
# guest do not replace them.  install_mariadb.sh set the root password from
# root_pw, and the .my.cnf files for root and the admin hold it.  A salvaged
# GRANT for root puts the old hash back, and those files stop working.
OURS='root|mariadb\.sys|mysql'

# The system databases, and the copy of the privilege tables from the last
# guest.  The application accounts come back from grants.sql.gz below.  Restoring
# the global_priv of another machine over this one leaves a root password that
# nobody knows.
SKIP='mysql|information_schema|performance_schema|sys'

# The last thing mariadb-backup.sh writes is `complete`.  A directory without it
# is a backup that nobody knows to be whole.  Half a database restored is worse
# than none.  The server then holds data, and so the next provision does not try
# again.  If an operator knows that a dump is whole, they touch the file.
newest_finished_dump() {
    local dumps=( "$SALVAGED"/*/ )
    local i
    for (( i = ${#dumps[@]} - 1; i >= 0; i-- )); do
        if [ -f "${dumps[$i]}complete" ]; then
            printf '%s\n' "${dumps[$i]%/}"
            return 0
        fi
    done
    return 1
}

# information_schema, not SHOW DATABASES LIKE.  An underscore is a LIKE
# wildcard, and many of these names contain one.
database_exists() {
    [ -n "$(mariadb -sN -e "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$1'")" ]
}

DUMP=$(newest_finished_dump) || {
    echo "mariadb-restore.sh: no finished dump under $SALVAGED, leaving this server as it is"
    exit 0
}

restored=0
for dbdir in "$DUMP"/*/; do
    db="$(basename "$dbdir")"
    if printf '%s' "$db" | grep -qxE "$SKIP"; then
        continue
    fi

    if database_exists "$db"; then
        echo "mariadb-restore.sh: $db is already on this server, keeping what it has"
        continue
    fi

    echo "mariadb-restore.sh: restoring $db from $DUMP"
    mariadb -e "CREATE DATABASE \`$db\`"

    # Tables first, then the views that select from them, then the routines that
    # call both.  One table at a time is safe, because each file from
    # mariadb-dump sets FOREIGN_KEY_CHECKS=0 itself.
    for table in "$dbdir"*.sql.gz; do
        case "${table##*/}" in
            views.sql.gz | routines.sql.gz | grants.sql.gz ) continue ;;
        esac
        pigz -dc "$table" | mariadb "$db"
    done
    for extra in views routines; do
        if [ -f "$dbdir$extra.sql.gz" ]; then
            pigz -dc "$dbdir$extra.sql.gz" | mariadb "$db"
        fi
    done

    restored=$(( restored + 1 ))
done

if [ "$restored" -eq 0 ]; then
    echo "mariadb-restore.sh: every database in $DUMP is already here; nothing restored"
    exit 0
fi

# The accounts go last, because a grant names a database that must exist.
# mariadb-dump --system=users writes every account, whatever database it dumps.
# So each per-database copy holds the same list, and one file is enough.  The
# file also holds that database, so only the account statements are taken.
# Each statement is on one line, so a line filter is sufficient.  A grep that
# matches nothing exits 1, and no accounts to restore is not a failure.
GRANTS="$(find "$DUMP" -mindepth 2 -maxdepth 2 -name grants.sql.gz -print -quit)"
if [ -n "$GRANTS" ]; then
    echo "mariadb-restore.sh: restoring the accounts out of $GRANTS"
    pigz -dc "$GRANTS" \
        | { grep -E '^(CREATE USER|ALTER USER|GRANT|REVOKE|SET DEFAULT ROLE|SET PASSWORD) ' || true; } \
        | { grep -vE "[\`']($OURS)[\`']@" || true; } \
        | mariadb
fi

echo "mariadb-restore.sh: restored $restored database(s) from $DUMP"
