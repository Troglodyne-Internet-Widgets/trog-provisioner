#!/bin/sh
# /etc/ufw/after.init runs this after ufw loads its rules, and again when it
# unloads them.  Provisioner::Recipe::ufw has the whole account.
case "$1" in
start | stop | flush-all)
    /usr/local/sbin/ssh-fastlane firewall "$1" \
        || echo "after.init: ssh-fastlane firewall $1 failed" >&2
    ;;
esac
exit 0
