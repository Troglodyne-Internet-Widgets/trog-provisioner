#!/bin/sh
# Hold the reboot while the worker of tCMS transcodes.  A transcode can run for
# hours, and a reboot fails it.  Generated by Provisioner::Recipe::tcms.  Do not
# edit by hand.
minion_active() {
    cd '[% install_dir %]/[% domain %]/tCMS' && runuser -u '[% user %]' -- env HOME='[% install_dir %]/[% domain %]' \
        /opt/perl5/current/bin/perl bin/tcms-jobs minion job -S active
}
[% INCLUDE "files/minion.reboot-check.tt" -%]
