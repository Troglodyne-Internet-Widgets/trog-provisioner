[%# /etc/profile.d/sshagentshare.sh sources this in every interactive login
    bash.  tmux starts each pane as a login shell, so a pane gets it too.  That
    file also names this one in BASH_ENV, so every non-interactive bash under
    such a login reads it as well.
    perldoc Provisioner::Recipe::sshagentshare says what it does and why.

    Nothing here is interpolated.  No apostrophes in an Xslate comment. -%]
# The ssh agents of every login of this user, shared by all of their shells.
# Written by the sshagentshare recipe of trog-provisioner.

_sshagentshare_dir="$HOME/.ssh/agents"
_sshagentshare_link="$HOME/.ssh/agent.sock"

# Whether an agent answers on the socket in $1.  ssh-add -l exits 2 when it
# reaches no agent, and 1 when the agent holds no keys.
_sshagentshare_live() {
    [[ -S $1 ]] || return 1
    SSH_AUTH_SOCK=$1 ssh-add -l >/dev/null 2>&1
    (($? != 2))
}

# Point the link at the socket in $1.  mv replaces the link in one step, so no
# other shell finds it missing.
_sshagentshare_point() {
    local tmp="$_sshagentshare_link.$$"
    ln -sfn "$1" "$tmp" && mv -Tf "$tmp" "$_sshagentshare_link"
}

# Remember the socket in $1, and point the link at it.
_sshagentshare_add() {
    mkdir -p -m 0700 "$HOME/.ssh" "$_sshagentshare_dir" || return
    ln -sfn "$1" "$_sshagentshare_dir/${1//\//%}"
    _sshagentshare_point "$1"
}

# Point the link at the newest live agent that is not $1, and forget the dead.
# BASH_ENV runs this before a script, under any set -u that the script asks
# for on its first line, so every variable here has a value.
_sshagentshare_pick() {
    local entry best=
    for entry in "$_sshagentshare_dir"/*; do
        [[ -L $entry ]] || continue
        [[ $(readlink "$entry") == "${1-}" ]] && continue
        if ! _sshagentshare_live "$entry"; then
            rm -f "$entry"
            continue
        fi
        [[ -z $best || $entry -nt $best ]] && best=$entry
    done
    [[ -n $best ]] && _sshagentshare_point "$(readlink "$best")"
    return 0
}

# Whether something still listens where the link leads.  -S alone is true of a
# socket file that sshd left behind after the login went away.  The kernel
# lists each bound unix socket by its path in /proc/net/unix.  read is a
# builtin, so this costs one readlink, and no round trip to an agent that may
# be forwarded from across the network, as ssh-add -l would.  When the list
# cannot be read, the -S has to do.
_sshagentshare_listening() {
    [[ -S $_sshagentshare_link ]] || return 1
    local target sockets=
    target=$(readlink "$_sshagentshare_link")
    read -r -d '' sockets </proc/net/unix 2>/dev/null
    [[ -z $sockets || $sockets == *" $target"$'\n'* ]]
}

# Move the link when its agent has gone.
_sshagentshare_repair() {
    _sshagentshare_listening || _sshagentshare_pick
}

# At each prompt.
_sshagentshare_prompt() {
    if [[ -n $SSH_AUTH_SOCK && $SSH_AUTH_SOCK != "$_sshagentshare_link" ]]; then
        _sshagentshare_live "$SSH_AUTH_SOCK" && _sshagentshare_add "$SSH_AUTH_SOCK"
    fi
    _sshagentshare_repair
    [[ -S $_sshagentshare_link ]] && export SSH_AUTH_SOCK="$_sshagentshare_link"
    return 0
}

# /etc/bash.bash_logout calls this.  Bash runs that file only on exit or
# logout, not when a hangup or a kill ends the shell.  The prompt of any other
# shell then finds the link dead and picks again.
_sshagentshare_logout() {
    [[ -n $_sshagentshare_own ]] || return 0
    rm -f "$_sshagentshare_dir/${_sshagentshare_own//\//%}"
    [[ $(readlink "$_sshagentshare_link") == "$_sshagentshare_own" ]] &&
        _sshagentshare_pick "$_sshagentshare_own"
    return 0
}

# A non-interactive bash, through BASH_ENV: a bash -c or a script under an
# interactive login, such as a tool of a program in its foreground.  No prompt
# runs there, and the login that the link leads to can end with a hangup that
# skips the logout hook, so nothing else would move a dead link.  This shell
# only repairs the link.  It does not add its own agent, because a bash -c of
# ssh host cmd has an agent that goes away with the command.  The || : keeps a
# set -e of the script from ending it when the repair fails.
if [[ $- != *i* ]]; then
    [[ ${SSH_AUTH_SOCK-} == "$_sshagentshare_link" ]] && { _sshagentshare_repair || :; }
    return 0
fi

# The socket that sshd made for this login, which goes away with it.  A tmux
# pane has the same SSH_AUTH_SOCK, but its parent is tmux, and its exit must not
# drop a socket that the login still holds.
_sshagentshare_own=
if [[ -n $SSH_AUTH_SOCK && $SSH_AUTH_SOCK != "$_sshagentshare_link" ]]; then
    read -r _sshagentshare_parent </proc/$PPID/comm 2>/dev/null
    [[ $_sshagentshare_parent == sshd* ]] && _sshagentshare_own=$SSH_AUTH_SOCK
    unset _sshagentshare_parent
fi

# Before ~/.bashrc, so that a dotfile that starts an agent when none answers
# finds the shared one.
_sshagentshare_prompt
[[ $PROMPT_COMMAND == *_sshagentshare_prompt* ]] ||
    PROMPT_COMMAND="_sshagentshare_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
