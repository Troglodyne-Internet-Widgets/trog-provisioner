[%# The same certificate nginx uses.  The ssl target makes these two links on
    every guest -- self-signed to begin with -- and the letsencrypt fetcher
    relinks them when it has a real certificate, so they are correct at every
    point in a guest's life.  This used to name dehydrated's output directly,
    which does not exist until letsencrypt has succeeded: on a guest where it
    had not, slapd refused the whole modify with error 80 and took the build
    down with it, while the chown and chmod on the same file two lines earlier
    were written to tolerate its absence. -%]
dn: cn=config
changetype: modify
replace: olcTLSCACertificateFile
olcTLSCACertificateFile: /etc/ssl/certs/[% domain %].pem
-
replace: olcTLSCertificateFile
olcTLSCertificateFile: /etc/ssl/certs/[% domain %].pem
-
replace: olcTLSCertificateKeyFile
olcTLSCertificateKeyFile: /etc/ssl/private/[% domain %].pem
