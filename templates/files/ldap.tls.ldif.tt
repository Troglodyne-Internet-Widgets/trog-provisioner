[%# The same certificate that nginx uses.  The ssl target makes these two
    links on every guest, first to a self-signed pair.  The letsencrypt fetcher
    links them again when it has a real certificate. -%]
[%# No olcTLSCACertificateFile.  The self-signed pair is not a CA, and slapd
    refuses a server certificate given as one, with error 80.  LDAPS does not
    need it, because clients use their own trust store. -%]
dn: cn=config
changetype: modify
replace: olcTLSCertificateFile
olcTLSCertificateFile: /etc/ssl/certs/[% domain %].pem
-
replace: olcTLSCertificateKeyFile
olcTLSCertificateKeyFile: /etc/ssl/private/[% domain %].pem
