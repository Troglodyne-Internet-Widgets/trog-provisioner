#!/bin/bash
# A logical backup of MariaDB.  Cron runs it each night, and it keeps the seven
# newest dumps.  Each database gets one file per table, plus its views, routines
# and grants, all compressed with pigz.  The databases dump in parallel.
set -euo pipefail

# No --defaults-file, because this runs as root and root authenticates over the
# unix socket.  The mysql-* names are symlinks from a package that this recipe
# does not install.
MYSQL="mariadb"
MYSQLDUMP="mariadb-dump --single-transaction=true --lock-tables=false"
DUMP_BASE=/var/backups/mysql
DATE=$(date +%Y%m%d-%H%M%S)
DEST="$DUMP_BASE/$DATE"
JOBS=$(nproc)

# System databases hold no user data, and a plain dump of them does not import.
SKIP_RE='^(information_schema|performance_schema|sys)$'

mkdir -p "$DEST"

dump_db() {
    local db="$1"
    local dbdir="$DEST/$db"
    mkdir -p "$dbdir"

    # The data and schema of each table.  --skip-routines, because mariadb-dump
    # has no --no-routines and exits 2 with no output for it.
    $MYSQL -sN -e "SHOW TABLES IN \`$db\`" | while read -r table; do
        $MYSQLDUMP --skip-triggers --skip-routines "$db" "$table" \
            | pigz > "$dbdir/$table.sql.gz"
    done

    # The views, as structure only.
    $MYSQL -sN -e \
        "SELECT TABLE_NAME FROM information_schema.VIEWS WHERE TABLE_SCHEMA='$db'" \
        | while read -r view; do
            $MYSQLDUMP --no-data --skip-triggers --skip-routines "$db" "$view" \
                | pigz >> "$dbdir/views.sql.gz"
        done

    # The stored procedures and functions.
    $MYSQLDUMP --no-data --no-create-info --no-create-db \
        --skip-triggers --routines "$db" \
        | pigz > "$dbdir/routines.sql.gz"

    # The accounts.  This step can fail and the backup continues, because
    # MariaDB 11.4 answers --system=users with "Illegal mix of collations".  The
    # table data is what a rebuild cannot do without.  Remove the partial file,
    # so that the restore does not read part of the accounts as all of them.
    # The error goes to stderr, and cron mails it.
    if ! $MYSQLDUMP --system=users --insert-ignore "$db" | pigz > "$dbdir/grants.sql.gz"; then
        echo "mariadb-backup.sh: could not dump the accounts for $db; its data is still here" >&2
        rm -f "$dbdir/grants.sql.gz"
    fi
}

export -f dump_db
export MYSQL MYSQLDUMP DEST

DBS=$($MYSQL -sN -e "SHOW DATABASES" | grep -Evx "$SKIP_RE")

# Set the options again inside the shell that xargs starts.  bash -c does not
# inherit them, and without them a failed dump_db returns 0.
echo "$DBS" | xargs -P "$JOBS" -I{} bash -c 'set -euo pipefail; dump_db "$@"' _ {}

# Written last, so it exists only if everything above worked.  It tells
# mariadb-restore.sh that the dump is whole.  mariadb-restore.sh explains why
# it refuses a dump without it.
: > "$DEST/complete"

# Keep only the seven newest dump directories.
ls -1dt "$DUMP_BASE"/[0-9]* 2>/dev/null | tail -n +8 | xargs -r rm -rf

echo "MariaDB backup complete: $DEST"
