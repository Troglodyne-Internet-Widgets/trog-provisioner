#!/bin/bash
# MariaDB logical backup script - run nightly, keeps 7 days of dumps.
# Dumps each database per-table (data+schema), grants, views, and routines.
# All dumps are pigz-compressed.  Per-table and per-database jobs run in parallel.
set -euo pipefail

# No --defaults-file: this runs as root out of cron, and root authenticates over
# the unix socket.  The mariadb-* names rather than the mysql-* ones, which are
# compatibility symlinks from a package this recipe does not install.
MYSQL="mariadb"
MYSQLDUMP="mariadb-dump --single-transaction=true --lock-tables=false"
DUMP_BASE=/var/backups/mysql
DATE=$(date +%Y%m%d-%H%M%S)
DEST="$DUMP_BASE/$DATE"
JOBS=$(nproc)

# System databases contain no user data and cannot be imported with plain mysqldump
SKIP_RE='^(information_schema|performance_schema|sys)$'

mkdir -p "$DEST"

dump_db() {
    local db="$1"
    local dbdir="$DEST/$db"
    mkdir -p "$dbdir"

    # Per-table data + schema (excluding triggers/routines handled separately)
    $MYSQL -sN -e "SHOW TABLES IN \`$db\`" | while read -r table; do
        $MYSQLDUMP --skip-triggers --skip-routines "$db" "$table" \
            | pigz > "$dbdir/$table.sql.gz"
    done

    # Views only - dump structure, filter to view objects
    $MYSQL -sN -e \
        "SELECT TABLE_NAME FROM information_schema.VIEWS WHERE TABLE_SCHEMA='$db'" \
        | while read -r view; do
            $MYSQLDUMP --no-data --skip-triggers --skip-routines "$db" "$view" \
                | pigz >> "$dbdir/views.sql.gz"
        done

    # Stored procedures and functions
    $MYSQLDUMP --no-data --no-create-info --no-create-db \
        --skip-triggers --routines "$db" \
        | pigz > "$dbdir/routines.sql.gz"

    # Grants for users that have explicit privileges on this database.
    #
    # Allowed to fail without taking the backup with it: --system=users asks
    # mysql.user a question that MariaDB 11.4 answers with "Illegal mix of
    # collations", and the table data is what a rebuild cannot do without.  The
    # empty file is removed rather than left, so the restore does not read half
    # a list of accounts as the whole of it, and the failure is on stderr where
    # the cron mails it.
    if ! $MYSQLDUMP --system=users --insert-ignore "$db" | pigz > "$dbdir/grants.sql.gz"; then
        echo "mariadb-backup.sh: could not dump the accounts for $db; its data is still here" >&2
        rm -f "$dbdir/grants.sql.gz"
    fi
}

# --skip-routines, not --no-routines: mariadb-dump has no such option, exits 2
# and writes nothing, so every per-table and per-view file was a 20-byte gzip of
# an empty stream -- a dump directory of the right shape with no data in it.
export -f dump_db
export MYSQL MYSQLDUMP DEST

DBS=$($MYSQL -sN -e "SHOW DATABASES" | grep -Evx "$SKIP_RE")

# set -e again inside the shell xargs starts: these options are not inherited
# across bash -c, so a dump_db that failed returned 0 to xargs and the backup
# reported success having written nothing.
echo "$DBS" | xargs -P "$JOBS" -I{} bash -c 'set -euo pipefail; dump_db "$@"' _ {}

# Written last, and only reached because everything above worked: this is what
# tells mariadb-restore.sh the dump is whole.  A rebuilt guest imports the newest
# dump that has one, and half a database restored is worse than none -- it leaves
# the server holding data, which is what stops the next provision from trying
# again.
: > "$DEST/complete"

# Prune: keep only the 7 most recent dated backup directories
ls -1dt "$DUMP_BASE"/[0-9]* 2>/dev/null | tail -n +8 | xargs -r rm -rf

echo "MariaDB backup complete: $DEST"
