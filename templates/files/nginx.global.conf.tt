# The default of 64 is too small for a long domain.  nginx sizes this
# hash by its longest server_name, and a vhost carries the domain and every
# name its recipes declare.  With 64, nginx does not start, and only `nginx -t`
# shows why:
#   could not build server_names_hash, you should increase
#   server_names_hash_bucket_size: 64
server_names_hash_bucket_size [% server_names_hash_bucket_size %];

# WebSocket upgrades.  Every proxy vhost uses $connection_upgrade.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
[% IF syslog -%]

[%# Beside the files that /etc/nginx/nginx.conf names, not in place of them.
    The jails of fail2ban read those.  A tag takes letters, digits and
    underscores only.  nohostname, because journald reads the first word after
    the timestamp as the program, and with a host name there the tag is lost. -%]
access_log syslog:server=unix:/dev/log,nohostname,tag=nginx_access combined;
error_log  syslog:server=unix:/dev/log,nohostname,tag=nginx_error warn;
[% END -%]
[% IF proxied -%]

[%# The address in a PROXY header, believed only from proxy_from.  A
    connection without the header keeps its own address.  A name that no vhost
    answers for on the ports of the proxy gets no certificate and no page.  See
    Provisioner::Recipe::nginx. -%]
[% FOR net IN proxy_from -%]
set_real_ip_from [% net %];
[% END -%]
real_ip_header proxy_protocol;

server {
    listen 8443 ssl proxy_protocol default_server;
    ssl_reject_handshake on;
}

server {
    listen 8080 proxy_protocol default_server;
    return 444;
}
[% END -%]
