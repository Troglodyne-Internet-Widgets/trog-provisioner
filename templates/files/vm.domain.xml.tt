[%# The libvirt domain for a guest, rendered by Provisioner::Recipe::vm.

    Everything conditional here was decided in that recipe by enrich(), against
    what the libvirt and qemu on this hypervisor said they would take -- so this
    writes what it is given and works nothing out.

    No apostrophes in an Xslate comment: the lexer reads one as opening a
    string, and swallows the template as far as the next quote. -%]
<domain type='kvm'>
  <name>[% domain %]</name>
  <memory unit='MiB'>[% memory %]</memory>
  <currentMemory unit='MiB'>[% memory %]</currentMemory>
  <vcpu placement='static'>[% cpus %]</vcpu>
[% IF tuning.iothreads -%]
[%# Threads qemu processes virtio-blk requests on: without any, submission
      runs on the main loop in qemu, serialised against everything else that
      loop is doing. -%]
  <iothreads>[% tuning.iothreads %]</iothreads>
[% END -%]

  <!-- i440fx, not q35: every guest on these hypervisors is i440fx, and the
       machine type decides the PCI topology a guest's kernel already knows.
       `pc` is the alias for the host qemu's newest i440fx, so this does not
       pin a version the next hypervisor may not have. -->
  <os>
    <type arch='x86_64' machine='pc'>hvm</type>
  </os>

  <features>
    <acpi/>
    <pae/>
  </features>

  <!-- host-passthrough by default, so the guest sees the real CPU including
       AVX and friends.  Anything that probes cpuid for vector extensions
       needs it; migratability is what you trade for that. -->
  <cpu mode='[% cpu_mode %]'/>
  <clock offset='utc'/>

  <!-- virtiofs needs shared memory, and memfd is how you get it without
       hugepages.  Without this block every filesystem below fails to start. -->
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <devices>
[% FOR disk IN disks -%]
[%# The disk belonging to the guest is named by volume rather than by
        path, so the domain does not hardcode where the pool happens to live.
        The backing store is baked into the qcow2 at creation; libvirt reports
        it back but we do not declare it. -%]
    <disk type='[% disk.type %]' device='disk'>
      <driver name='qemu' type='[% disk.format %]'[% IF tuning.cache %] cache='[% tuning.cache %]'[% END %][% IF tuning.io %] io='[% tuning.io %]'[% END %][% IF tuning.discard %] discard='unmap'[% END %][% IF tuning.detect_zeroes %] detect_zeroes='[% tuning.detect_zeroes %]'[% END %][% IF tuning.queues %] queues='[% tuning.queues %]'[% END %][% IF disk.discard_no_unref %] discard_no_unref='on'[% END %][% IF disk.iothread %] iothread='[% disk.iothread %]'[% END %][% IF disk.metadata_cache || disk.iothread_ids.size() %]>
[% IF disk.metadata_cache -%]
        <metadata_cache><max_size unit='bytes'>[% disk.metadata_cache %]</max_size></metadata_cache>
[% END -%]
[% IF disk.iothread_ids.size() -%]
        <iothreads>
[% FOR id IN disk.iothread_ids -%]
          <iothread id='[% id %]'/>
[% END -%]
        </iothreads>
[% END -%]
      </driver>[% ELSE %]/>[% END %]
[% IF disk.type == 'volume' -%]
      <source pool='[% pool_name %]' volume='[% disk_volume %]'/>
[% ELSIF disk.type == 'block' -%]
      <source dev='[% disk.source %]'/>
[% ELSE -%]
      <source file='[% disk.source %]'/>
[% END -%]
      <target dev='[% disk.dev %]' bus='virtio'/>
[% IF tuning.blockio -%]
      <blockio logical_block_size='[% tuning.blockio.logical %]' physical_block_size='[% tuning.blockio.physical %]'/>
[% END -%]
[% IF tuning.iotune -%]
      <iotune>
[% FOR limit IN tuning.iotune -%]
        <[% limit.name %]>[% limit.value %]</[% limit.name %]>
[% END -%]
      </iotune>
[% END -%]
      <boot order='[% disk.boot %]'/>
    </disk>
[% END -%]

    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='[% cloudinit %]'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>

    <!-- Two interfaces: the libvirt NAT for the hypervisor to reach it by
         lease, and the outbound bridge for its real address.

         Both the PCI slot and the MAC are pinned rather than left to libvirt.
         The slot is what the guest's interface name is derived from, because
         systemd names a PCI NIC after its hotplug slot, so leaving it to
         allocation order means the names move whenever the device list does.
         Trog::HV::nic_slots is where they are decided, and nic_names is what
         the guest is told to expect.  The MAC is derived from the domain name,
         so it is the same on every rebuild: the DHCP lease stays put, and the
         network configuration can match on it rather than on a name. -->
    <interface type='network'>
      <mac address='[% nat_mac %]'/>
      <source network='default'/>
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='[% nat_slot %]' function='0x0'/>
    </interface>
    <interface type='bridge'>
      <mac address='[% bridge_mac %]'/>
      <source bridge='[% bridge_device %]'/>
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='[% bridge_slot %]' function='0x0'/>
    </interface>

[% FOR fs IN filesystems -%]
[%# virtiofs-better is `virtiofsd --inode-file-handles=mandatory`, without
        which a busy share runs the daemon out of file handles.  The terraform
        config asked for an open_files max here too and it never did anything:
        libvirt has no such element, accepts the domain, and drops it. -%]
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs' queue='1024'/>
      <binary path='/usr/libexec/virtiofs-better'/>
      <source dir='[% fs.source %]'/>
      <target dir='[% fs.target %]'/>
    </filesystem>
[% END -%]
[% IF tpm -%]
[%# tpm-crb rather than tpm-tis: crb is the interface a TPM 2.0 is meant to
        present, and what a current guest kernel looks for first. -%]
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>
[% END -%]
    <!-- Cloud images expect a console and sulk without one:
         https://bugs.launchpad.net/cloud-images/+bug/1573095 -->
    <serial type='pty'><target port='0'/></serial>
    <console type='pty'><target type='serial' port='0'/></console>
    <console type='pty'><target type='virtio' port='1'/></console>

    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video><model type='cirrus' vram='16384' heads='1' primary='yes'/></video>
    <!-- stats period is what makes `virsh dommemstat` say anything; the
         existing guests have it. -->
    <memballoon model='virtio'>
      <stats period='5'/>
    </memballoon>
  </devices>
</domain>
