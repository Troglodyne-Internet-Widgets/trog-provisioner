# The redis.conf fragment for this guest.
#
# configd merges every file in /etc/redis/redis.conf.d into redis.conf when
# redis-server starts or reloads.  The file from the package is 00-original.  It
# still applies wherever this file sets nothing.  So this file sets only what
# the provisioner decided.
#
# These comments stay in this file and do not go into the generated redis.conf.
# There they describe settings that a later file can replace.
#
# This is a second bind line, not a replacement.  configd keeps each occurrence
# of a directive that redis accepts more than once, and bind is one of them.
# redis reads them in order and each one replaces the last.  This file sorts
# after 00-original, so its bind line is the one that counts.
bind [% bind %]
port [% port %]
daemonize no
supervised systemd
loglevel notice
logfile /var/log/redis/redis-server.log
dir /var/lib/redis
[% IF save %]
# These snapshot points add to the ones the package chose.  redis uses every
# save line, and configd keeps them all, but two identical lines become one.  So
# redis takes snapshots more often than the distribution set, never less often.
save 900 1
save 300 10
save 60 10000
[% ELSE %]
# An empty save clears every snapshot point before it.  This file sorts after
# 00-original, so it clears all of them and turns RDB persistence off.
save ""
[% END %]
[% IF requirepass %]
requirepass [% requirepass %]
[% END %]
[% IF maxmemory %]
maxmemory [% maxmemory %]
[% END %]
[% IF maxmemory_policy %]
maxmemory-policy [% maxmemory_policy %]
[% ELSE %]
maxmemory-policy noeviction
[% END %]
