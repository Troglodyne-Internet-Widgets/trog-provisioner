[%# Every name the guest answers for: the aliases configured for the domain,
    and the names that the recipes on it hand over.  See
    served_names in Provisioner::Recipe.  Nothing is named here.  Each name of
    own_certificates is on a line of its own, so it gets a key of its own,
    with an alias where the name is the domain.
    Provisioner::Recipe::letsencrypt says why. -%]
[% domain %] [% FOR alias IN domain_aliases %] [% alias %][% END %]
[% FOR own IN own_lines -%]
[% own.name %][% IF own.dir != own.name %] > [% own.dir %][% END %]
[% END -%]
