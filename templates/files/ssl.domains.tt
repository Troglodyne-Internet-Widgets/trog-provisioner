[%# The domain and its aliases, which is every name the guest answers for: a
    recipe declares what it serves and bin/new_config adds it here.  This used
    to name the matrix pair itself, as a second copy of the rule in
    pdns.zone.tt -- so a certificate could cover a name the zone did not, or the
    other way about. -%]
[% domain %] [% FOR alias IN full_aliases %] [% alias %][% END %]
