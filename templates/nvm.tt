# Install nvm for [% user %] via the official install script (idempotent)
su - [% user %] -s /bin/bash -c \
    "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/[% nvm_version %]/install.sh | bash"

# Install latest Node.js and set it as the default alias
su - [% user %] -s /bin/bash -c \
    ". ~/.nvm/nvm.sh && nvm install node && nvm alias default node"

# Both of these go in the .bashrc the user actually reads, which is the one in
# the home directory passwd gives them.
#
# This used to write to install_dir/domain/.bashrc on the grounds that the
# user's home is the domain directory.  That is true of a service user, which
# the service_user target creates with -d there, and false of the admin user --
# and user defaults to admin_user.  So nvm went into ~/.nvm, courtesy of the
# `su -` above, and the lines that make it usable went somewhere that shell
# never looks.
NVM_HOME=$$(getent passwd '[% user %]' | cut -d: -f6); \
test -n "$$NVM_HOME" || { echo "no home directory for [% user %]" >&2; exit 1; }; \
grep -qF 'nvm use node &>/dev/null' "$$NVM_HOME/.bashrc" 2>/dev/null \
    || echo 'nvm use node &>/dev/null' >> "$$NVM_HOME/.bashrc"; \
grep -qF 'export NODE_PATH=' "$$NVM_HOME/.bashrc" 2>/dev/null \
    || echo '[ -n "$$NVM_BIN" ] && export NODE_PATH="$${NVM_BIN%/bin}/lib/node_modules"; /bin/true' >> "$$NVM_HOME/.bashrc"; \
chown '[% user %]' "$$NVM_HOME/.bashrc"
