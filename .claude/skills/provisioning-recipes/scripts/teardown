#!/usr/bin/env perl

package Trog::Skill::Teardown;

#ABSTRACT: Take the throwaway guest and the throwaway configuration back out again.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use File::Basename();
use Getopt::Long qw{GetOptionsFromArray};
use IPC::Run3();
use Pod::Usage qw{pod2usage};

use Trog::Config();

=head1 NAME

teardown - take the throwaway guest and the throwaway configuration back out again

=head1 SYNOPSIS

    teardown vm.test
    teardown --keep-config vm.test

and for what a run that ended without one left behind, which is C<bin/destroy>'s:

    bin/destroy --orphans --dryrun

=head1 DESCRIPTION

Destroys the guest through C<bin/destroy --purge>, which purges its domain
directory, takes its data directory out of the data source on both sides as
well, and takes the domain out of the scratch configuration -- the configuration
itself with the last domain in it.  One scratch configuration often builds
several guests at once, a cache and the guest that uses it, and tearing one down
must not take the secret store and the address pool the others are still built
from.

Run it even when the provision failed -- especially then.  A half-built guest
still holds an address out of the pool, a disk in the storage pool and a
definition in libvirt, and the next run will collide with all three.  Collect
the artifacts first; they are gone after this.

=head2 The data directory

That is the one that gets forgotten, because nothing collides with it and
nothing stops working when it is left.  C<new_config> makes
C<$data_source/$domain> for whatever datadirs the recipes ask for, writes
anything fetched off the last guest into it, and ships the whole thing to the
hypervisor for the guest to pull its payload out of.  Neither copy belongs to
anyone once the guest is gone.

They are not empty either: a guest built with the C<backup> recipe leaves the
private half of its backup key in there, which is the one file that recipe goes
out of its way to delete from the guest itself.

So teardown asks C<bin/destroy> for C<--purge-data> too, C<--keep-data> to
keep it.  Only when the configuration in play is a scratch one: a real domain's
data directory is where its backups are restored from, and deciding that it is
not one is this script's to do, not C<bin/destroy>'s.

=head1 OPTIONS

=over 4

=item B<--keep-config>

Leave the scratch configuration alone, this domain's file in it included.  For
when the next run should reuse the same throwaway secret store rather than
building another.  It is left anyway while another domain in it remains.

=item B<--keep-data>

Leave the domain's data directory where it is, here and on the hypervisor.  For
when the next run should start from what this one produced.

=item B<--hypervisor> NAME, B<--hvconf> FILE

Passed through to C<bin/destroy>.

=item B<--dryrun>

Say what would go without any of it going.

=back

=cut

# scratch_config's marker.  Its presence is what says the configuration in play
# describes throwaway guests, and so what makes their data ours to remove.
our $MARKER = '.trog-scratch-config';

sub main {
    my @args = @_;

    my ( $keep_config, $keep_data, $hv_name, $hvconf, $dryrun, $help );
    GetOptionsFromArray(
        \@args,
        'keep-config'  => \$keep_config,
        'keep-data'    => \$keep_data,
        'hypervisor=s' => \$hv_name,
        'hvconf=s'     => \$hvconf,
        'dryrun'       => \$dryrun,
        'help'         => \$help,
    );
    pod2usage( -exitval => 0, -verbose => 2, -input => __FILE__ ) if $help;

    my $domain = shift @args;
    pod2usage( -exitval => 2, -verbose => 1, -input => __FILE__, -message => 'No domain passed' )
      unless $domain;

    my $purge_data = !$keep_data && is_scratch();
    my $rc         = destroy_guest( $domain, $hv_name, $hvconf, $dryrun, $purge_data );

    $rc ||= remove_config( $domain, $dryrun ) unless $keep_config;

    return $rc;
}

sub destroy_guest {
    my ( $domain, $hv_name, $hvconf, $dryrun, $purge_data ) = @_;

    # Progress for whoever is standing here, so STDERR rather than warn: warn
    # stamps every line with a file and a line number from inside this script,
    # which is not the part they need.  Nothing parses this one's STDOUT either
    # -- bin/destroy inherits the terminal below and writes its own.
    ## no critic (ProhibitPrintSTDERR)

    my $destroy = File::Basename::dirname(__FILE__) . '/../../../../bin/destroy';

    my @cmd = ( $^X, $destroy, '--purge' );

    # A hypervisor whose credential is in the store is asked through it, and a
    # scratch configuration's store opens with the password scratch_config
    # made.  Without it, bin/destroy cannot ask that hypervisor and will not
    # guess that the guest is not there.
    my $credentials = defined $ENV{TROG_SCRATCH_PASS} ? "keepass: $ENV{TROG_SCRATCH_PASS}\n\n" : undef;
    push @cmd, '--credentials' if defined $credentials;
    push @cmd, '--purge-data' if $purge_data;
    push @cmd, '--hypervisor', $hv_name if $hv_name;
    push @cmd, '--hvconf',     $hvconf  if $hvconf;
    push @cmd, '--dryrun' if $dryrun;
    push @cmd, $domain;

    print {*STDERR} "Destroying $domain\n";
    IPC::Run3::run3( \@cmd, defined $credentials ? \$credentials : \undef, undef, undef );
    my $rc = $? >> 8;

    # Worth saying rather than swallowing: what is left behind is a disk and a
    # lease that the next run will trip over.
    print {*STDERR} "\nbin/destroy exited $rc; $domain may still be on the hypervisor.\n" . "Check with: virsh -c \$URI list --all\n" if $rc;

    return $rc;
}

=head1 SUBROUTINES

=head2 is_scratch()

Whether the configuration in play is one C<scratch_config> built, and so one
whose domains' data is throwaway.  Says why not, when it is not.

=cut

sub is_scratch {
    my $cfg = Trog::Config->dir;

    ## no critic (ValuesAndExpressions::ProhibitFiletest_f)
    return 1 if -f "$cfg/$MARKER";

    print {*STDERR} "$cfg is not a scratch configuration, so the data directory stays.\n" . "A real domain's is where its backups are restored from.\n";    ## no critic (ProhibitPrintSTDERR) -- as in destroy_guest: said to a person, and warn would decorate it with a source location
    return 0;
}

=head2 remove_config($domain, $dryrun)

Take the domain out of the scratch configuration: its file in C<recipes.d>, and
the whole directory once that was the last one.

Nothing at all unless the directory carries scratch_config's marker, which is
what stops an unset or mistaken C<TROG_PROVISIONER_CONFIG> costing a real
domain its configuration.

=cut

sub remove_config {
    my ( $domain, $dryrun ) = @_;

    # As in destroy_guest: what this says is said to a person, and warn would
    # decorate each line with a source location they have no use for.
    ## no critic (ProhibitPrintSTDERR)

    my $dir = $ENV{TROG_PROVISIONER_CONFIG};
    if ( !defined $dir || $dir eq q{} ) {
        print {*STDERR} "TROG_PROVISIONER_CONFIG is not set, so there is no scratch config to remove.\n";
        return 0;
    }

    ## no critic (ValuesAndExpressions::ProhibitFiletest_f)
    unless ( -f "$dir/$MARKER" ) {
        print {*STDERR} "$dir is not a scratch configuration, so nothing in it is removed.\n";
        return 1;
    }

    # Another domain in it may still have a guest, built out of this same
    # secret store and address pool.
    my @others = sort grep { $_ ne $domain } map { File::Basename::basename( $_, '.yaml' ) } glob("$dir/recipes.d/*.yaml");
    if (@others) {
        my $mine = "$dir/recipes.d/$domain.yaml";
        if ($dryrun) {
            print {*STDERR} "Would remove $mine, and keep the scratch config at $dir for " . join( ', ', @others ) . "\n";
            return 0;
        }
        unlink $mine;
        print {*STDERR} "Kept the scratch config at $dir, which still configures " . join( ', ', @others ) . "\n";
        return 0;
    }

    # scratch_config knows its own; it refuses anything that is not one.
    my $scratch = File::Basename::dirname(__FILE__) . '/scratch_config';

    if ($dryrun) {
        print {*STDERR} "Would remove the scratch config at $dir\n";
        return 0;
    }

    IPC::Run3::run3( [ $^X, $scratch, '--remove', $dir ], \undef, undef, undef );
    return $? >> 8;
}

exit main(@ARGV) unless caller;

1;
