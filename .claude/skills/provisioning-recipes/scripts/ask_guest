#!/usr/bin/env perl

package Trog::Skill::AskGuest;

#ABSTRACT: Run a command on a guest that is still up, and print what it said.

use 5.041;

use strict;
use warnings FATAL => 'all';
use re '/aasx';

use FindBin::libs;

use Cwd();
use File::Basename();
use Getopt::Long();

use Trog::Hypervisors();

# For the check of the configuration in play, which teardown owns.
BEGIN { require( Cwd::abs_path( File::Basename::dirname(__FILE__) ) . q{/teardown} ) }

=head1 NAME

ask_guest - ask a live guest a question, rather than reasoning about it

=head1 SYNOPSIS

    ask_guest vm.test 'postconf -h mydestination'
    ask_guest vm.test 'configd status postfix'
    ask_guest --config /path/to/scratch vm.test 'ss -lnt'
    ask_guest --agent vm.test 'ss -lnt'

=head1 DESCRIPTION

C<collect_artifacts> fetches the four logs and then the guest is usually torn
down.  This is for the part in between, where the guest is still up and the
question is one only it can answer: what postfix made of its configuration, what
is actually in a generated file, whether a port answers.

Runs as root, because everything worth asking here is.

It logs in with the key of the guest, out of the store, so the password of the
store goes on standard input.  With B<--agent>, it logs in with the keys of
your ssh agent instead, and needs no store for the key.  The admin of a guest
trusts the keys of F<admin_authorized_keys>.

It reaches the guest at the address that its hypervisor reports, which is the
guest itself, also for a domain behind a relay.

=cut

exit main(@ARGV) unless caller;

sub main {
    my @args = @_;
    # Only options before the domain, so that the command keeps its own.
    my $agent;
    my $options = Getopt::Long::Parser->new( config => [qw{require_order pass_through}] );
    $options->getoptionsfromarray( \@args, 'config=s' => sub { $ENV{TROG_PROVISIONER_CONFIG} = $_[1] }, 'agent' => \$agent );
    my ( $domain, @command ) = @args;
    die "Usage: ask_guest [--agent] DOMAIN COMMAND...\n" unless $domain && @command;
    Trog::Skill::Teardown::require_config();

    my $guest = ( $agent ? Trog::Hypervisors->guest_of_with_agent($domain) : Trog::Hypervisors->guest_of($domain) )
      or die "No hypervisor in the fleet runs $domain at an address, so there is nothing to ask.\n";

    # The command is one argument of sh -c, so a command containing an awk
    # program reaches the guest as it was typed.
    print $guest->capture_sudo( qw{sh -c}, join( q{ }, @command ) ) // q{};

    return 0;
}

1;
