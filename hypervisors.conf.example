; hypervisors.conf -- the machines we can build guests on.
;
; Copy this to /etc/trog-provisioner/hypervisors.conf and edit.  While it does
; not exist there is no fleet: the hypervisor is this machine, or whatever
; --connect names, exactly as it was before.
;
; One [block] per hypervisor.  The name is yours to pick; it shows up in
; placement messages, so make it one you would recognise at 3am.  A block header is required -- keys outside one are an
; error rather than a hypervisor called "default".
;
; Nothing here is per-guest.  A guest's provision.conf says how much memory and
; disk it wants; this file says which machines have any to give.

; No value here has to be written out.  Any of them can be
; secret:GROUP/ENTRY/FIELD, which names an entry in secrets.kdbx, as a value in
; recipes.yaml can -- so a credential such as a Linode token lives in the store
; rather than in this file.  A reference is resolved when something reads that
; value, so a run that never touches this hypervisor is never asked for the
; store's passphrase.

[hv1]
; The only required key.  A remote hypervisor has to use an ssh transport,
; because we need its filesystem as well as its libvirt.
libvirt_uri    = qemu+ssh://root@hv1.example.net/system

; Skip autodetection when `brctl show | tail -n1` guesses wrong.
bridge_device  = br0
virbr_device   = virbr0

;
; Where the storage pool lives on that machine, and what it is called.  The
; defaults are tf_disks at /opt/terraform/disks -- historical, from when
; terraform put it there.
;
; Name both or neither.  libvirt looks a pool up by name, so a pool_path given
; beside the name of a pool that already exists somewhere else is ignored and
; every volume lands in the existing one.
;
; This is also the only quota a guest can be held to.  Nothing in libvirt
; counts what a user has allocated, and on the system URI every guest runs as
; libvirt-qemu whoever defined it, so there is no UID for a disk quota to
; attach to.  What does work is a pool of its own on a filesystem with a limit
; -- `zfs create -o quota=500G tank/vm-disks/somebody` and point pool_path at
; it -- after which the kernel enforces it and `zfs list` accounts for it.
pool_path      = /opt/terraform/disks
pool_name      = tf_disks

; The cgroup partition guests built here are placed in.  Unset means libvirt's
; own /machine, along with every other VM on the box.  Naming one, say
; /machine/somebody, puts them all in machine-somebody.slice, which is then a
; single thing to cap:
;
;     systemctl set-property machine-somebody.slice CPUQuota=400%
;
; This sets no limit by itself -- it makes there be something to set one on.
; Memory is the exception: a MemoryMax on a slice full of VMs kills one rather
; than refusing the next, so leave memory to reserve_memory below, which is the
; knob that actually refuses.
;partition      = /machine/somebody

; What to keep back from guests.  Memory in MB, disk in bytes.  Memory is
; counted as committed rather than used: a guest promised 8G is holding 8G
; against this machine even while it idles.
reserve_memory = 4096
reserve_cpus   = 2
reserve_disk   = 53687091200

; vCPUs per physical CPU that is considered acceptable.  Default 4.
cpu_overcommit = 4

; Refuse to place beyond this many guests.  0, the default, means no cap.
max_guests     = 20

[hv2]
libvirt_uri    = qemu+ssh://root@hv2.example.net/system
reserve_memory = 8192

; ---------------------------------------------------------------------------
; A cloud, rather than a machine.
;
; A block is one kind of hypervisor, and which one is decided by what is in it:
; libvirt_uri above, cloud here, or linode_token or solusvm below.  A block
; naming two, or
; none, is an error naming the block -- a block naming none would otherwise
; fall through to libvirt's default connection, which is this machine, and that
; is the one placement nobody writing this file meant.
;
; Each kind is talked to through its own client, and each client is installed
; where a fleet has that kind of hypervisor in it: Sys::Virt for libvirt,
; OpenStack::MetaAPI for a cloud, Linode::API for Linode, SolusVM::Client for a
; SolusVM node.  A fleet of clouds
; needs no Sys::Virt, which cannot be built without a libvirt-dev to build it
; against.  `bin/preflight` reads this file and says which block wants which,
; and what installs it.
;
; Nothing here is a path or a device, because there is no filesystem to reach
; and no bridge to detect.  A guest gets a flavor rather than a memory figure
; and a disk size, and what flavors exist is the cloud's to say -- ask it, with
; `openstack flavor list` or Horizon, rather than guessing.

[cloud1]
; Which entry in clouds.yaml to authenticate with.  The only required key.
; See Trog::OpenStack::Config for where clouds.yaml is looked for.
cloud             = openstack

; No flavor: what size a guest is is the guest's to say.  It names one in its
; _global, as openstack_flavor, and a guest that names none is not built on a
; cloud at all -- which is how a guest is kept off one on purpose.
;
;     somedomain:
;         _global:
;             openstack_flavor: m1.medium
;
; No image: a guest's distro recipe decides what it boots, on every kind of
; hypervisor.  Here that is the newest active image whose os_distro and
; os_version properties name the distro's release -- ubuntu and 24.04 -- which
; bin/preflight checks the cloud has.

; The tenant network the guest gets an address on, and the external network a
; floating IP is taken from.  Without floating_network a guest comes up with
; only a fixed address, which routes nowhere we can reach -- so provisioning
; will stop and tell you to set this.
network           = internal
floating_network  = public

; Optional.  security_group defaults to 'default', which every project has.
availability_zone = nova
security_group    = default
keypair           = buildkey

; The limits mean the same as they do for a machine, and are read the same way,
; because placement is shared.  For a cloud they are held back from the
; project's quota rather than from a host's hardware: a quota is already what
; you may run, so cpu_overcommit is 1 and setting it higher only invents
; headroom the cloud will refuse.  max_guests defaults to the instance quota.
reserve_memory    = 4096
reserve_cpus      = 2

; ---------------------------------------------------------------------------
; A Linode account, where every guest is a Linode bought by the month.
;
; Placement puts a guest on the cheapest hypervisor that has room, and a machine
; above costs nothing more for one more guest.  So a guest only lands here when
; no machine can take it, or when its provision.conf pins it here with
; hypervisor=linode1.

[linode1]
; The API token, as a reference into the secret store and never written out.
; Put it there with `bin/add_secret --group linode --title api`.  It needs
; read_write on linodes and images.
linode_token   = secret:linode/api/password

; Where to build.  Ask Linode what regions exist with `linode-cli regions list`.
;
; No type: what size a guest is is the guest's to say.  It names one in its
; _global, as linode_type, and a guest that names none is not built on Linode
; at all -- which is how a guest is kept off it, and off the bill.
;
;     somedomain:
;         _global:
;             linode_type: g6-standard-2
;
; `linode-cli linodes types` lists them, with what each costs -- or let the
; provisioner tell you: a guest that fits nowhere else is offered the cheapest
; type that holds it, and accepting one writes it into the guest's own file.
;
; No image: a guest's distro recipe decides what it boots, and here that is the
; Linode image named for the distro's release, such as linode/ubuntu24.04.  The
; region has to run the metadata service and the image has to read cloud-init
; from it, which bin/preflight checks.
region         = us-east

; What the whole account may cost a month, every Linode on it counted, whatever
; built it.  A guest that would take it over does not fit.  Unset, nothing caps
; it.
monthly_budget = 200

; Optional.  A Cloud Firewall to put new guests behind, by id, and an address on
; Linode's private network for each.
;firewall_id    = 12345
;private_ip     = 1

; Where a guest here reaches this machine for its payload, which is somewhere
; else than a guest on a machine of ours reaches it: across the internet, at
; the gateway's address, on a port the gateway forwards to this machine's sshd.
; Any block can set these, and they win over transfer_ip and transfer_port in
; the _global of recipes.yaml for the guests built on it.
transfer_ip    = 192.0.2.10
transfer_port  = 2222

; ---------------------------------------------------------------------------
; A SolusVM management node.
;
; The node owns the hypervisors and decides which of them a guest lands on, so
; what is named here is a project and a location -- never a host.  Half its API
; answers only for an account that administers the node, and this talks to the
; half that answers for one that merely uses it.

[solus1]
; The management node's hostname.  The only required key besides the token.
solusvm          = solus.example.test

; The API token, as a reference into the secret store and never written out.
; Put it there with `bin/add_secret --group solusvm --title api`.  Make the
; token in the panel under Account; it does not expire, and a node with an
; identity provider in front of it has no password to offer instead, so this is
; the whole credential.
solusvm_token    = secret:solusvm/api/password

; Where to build.  A name or an id; the node lists them.
solusvm_location = qa

; Which project to build in.  Only needed where the account has more than one;
; where it has exactly one, that is the one.
;solusvm_project  = 34

; No plan: what size a guest is is the guest's to say.  It names one in its
; _global, as solusvm_plan, and a guest that names none is not built here at
; all -- which is how a guest is kept off this node.
;
;     somedomain:
;         _global:
;             solusvm_plan: c2.d40.r4096 - Shared LVM
;
; A plan may be named or given by id.  A guest that fits nowhere else is
; offered the cheapest plan that holds it, and accepting one writes it into the
; guest's own file.
;
; No image: a guest's distro recipe decides what it boots, and here that is an
; OS image *version* -- Debian is an image, Debian 13 is the version, and only
; the version has the id the API takes.  The backend asks the node for it.
