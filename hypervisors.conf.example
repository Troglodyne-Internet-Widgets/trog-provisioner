; hypervisors.conf -- the machines we can build guests on.
;
; Copy this to /etc/trog-provisioner/hypervisors.conf and edit.  While it does
; not exist there is no fleet: the hypervisor is this machine, or whatever
; --connect names, exactly as it was before.
;
; One [block] per hypervisor.  The name is yours to pick; it shows up in
; placement messages, so make it one you would recognise at 3am.  A block header is required -- keys outside one are an
; error rather than a hypervisor called "default".
;
; Nothing here is per-guest.  A guest's provision.conf says how much memory and
; disk it wants; this file says which machines have any to give.

[hv1]
; The only required key.  A remote hypervisor has to use an ssh transport,
; because we need its filesystem as well as its libvirt.
libvirt_uri    = qemu+ssh://root@hv1.example.net/system

; Skip autodetection when `brctl show | tail -n1` guesses wrong.
bridge_device  = br0
virbr_device   = virbr0

;
; Where the storage pool lives on that machine, and what it is called.  The
; defaults are tf_disks at /opt/terraform/disks -- historical, from when
; terraform put it there.
;
; Name both or neither.  libvirt looks a pool up by name, so a pool_path given
; beside the name of a pool that already exists somewhere else is ignored and
; every volume lands in the existing one.
;
; This is also the only quota a guest can be held to.  Nothing in libvirt
; counts what a user has allocated, and on the system URI every guest runs as
; libvirt-qemu whoever defined it, so there is no UID for a disk quota to
; attach to.  What does work is a pool of its own on a filesystem with a limit
; -- `zfs create -o quota=500G tank/vm-disks/somebody` and point pool_path at
; it -- after which the kernel enforces it and `zfs list` accounts for it.
pool_path      = /opt/terraform/disks
pool_name      = tf_disks

; The cgroup partition guests built here are placed in.  Unset means libvirt's
; own /machine, along with every other VM on the box.  Naming one, say
; /machine/somebody, puts them all in machine-somebody.slice, which is then a
; single thing to cap:
;
;     systemctl set-property machine-somebody.slice CPUQuota=400%
;
; This sets no limit by itself -- it makes there be something to set one on.
; Memory is the exception: a MemoryMax on a slice full of VMs kills one rather
; than refusing the next, so leave memory to reserve_memory below, which is the
; knob that actually refuses.
;partition      = /machine/somebody

; What to keep back from guests.  Memory in MB, disk in bytes.  Memory is
; counted as committed rather than used: a guest promised 8G is holding 8G
; against this machine even while it idles.
reserve_memory = 4096
reserve_cpus   = 2
reserve_disk   = 53687091200

; vCPUs per physical CPU that is considered acceptable.  Default 4.
cpu_overcommit = 4

; Refuse to place beyond this many guests.  0, the default, means no cap.
max_guests     = 20

[hv2]
libvirt_uri    = qemu+ssh://root@hv2.example.net/system
reserve_memory = 8192
